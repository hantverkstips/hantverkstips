---
/**
 * Produkttest eller granskning. En produkt, ett omdöme, egna siffror.
 * Ingen poängskala, inga stjärnor. Formen är artikelmallens: huvudet med
 * byline, sidospalten från 1024 px och Läs vidare som band.
 * Se docs/SPEC-SIDMALLAR.md avsnitt 4.4, docs/DESIGN.md 5.7 och
 * docs/briefer/spec-designlyft-d-2026-10-02.md avsnitt 2.
 */
import { getEntry, render } from 'astro:content';
import Bas from '../../layouts/Bas.astro';
import { delningsbild } from '../../lib/delningsbild';
import { formateraDatum, formateraSpecVarde, isoDatum } from '../../lib/format';
import { arPublicerad, kategoriUrl, lasminuter, publicerade, slugify, testUrl, typEtikett } from '../../lib/innehall';
import { tillKortArtikel, type KortData } from '../../lib/kort';
import { nivaEtikett } from '../../lib/niva';
import {
  billigasteErbjudande,
  hamtaButik,
  hamtaProdukt,
  lagerlage,
  lokalBild,
  produktNamn,
  varnaSaknadProdukt,
} from '../../lib/produkter';
import { produkt as produktData } from '../../lib/strukturdata';
import Artikelrutnat from '../../components/ui/Artikelrutnat.astro';
import Brodsmulor from '../../components/ui/Brodsmulor.astro';
import Byline from '../../components/ui/Byline.astro';
import Faktaruta from '../../components/ui/Faktaruta.astro';
import Faq from '../../components/ui/Faq.astro';
import Illustration from '../../components/ui/Illustration.astro';
import Innehallsforteckning from '../../components/ui/Innehallsforteckning.astro';
import Jamforelsetabell from '../../components/ui/Jamforelsetabell.astro';
import Kalkylator from '../../components/ui/Kalkylator.astro';
import Kallor from '../../components/ui/Kallor.astro';
import Kopknapp from '../../components/ui/Kopknapp.astro';
import Kortsvarstext from '../../components/ui/Kortsvarstext.astro';
import Markering from '../../components/ui/Markering.astro';
import Pennstreck from '../../components/ui/Pennstreck.astro';
import Produktkort from '../../components/ui/Produktkort.astro';
import Rubrikrad from '../../components/ui/Rubrikrad.astro';
import Sidospalt from '../../components/ui/Sidospalt.astro';
import StrukturData from '../../components/ui/StrukturData.astro';
import Varning from '../../components/ui/Varning.astro';
import Verktygskort from '../../components/ui/Verktygskort.astro';

export async function getStaticPaths() {
  const tester = await publicerade('tester');
  return tester.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

Astro.locals.sidtyp = 'test';

const { entry } = Astro.props;
const d = entry.data;
const arTest = d.etikett === 'test';

const { Content, headings } = await render(entry);

const produkt = await hamtaProdukt(d.produkt);
if (!produkt) varnaSaknadProdukt(d.produkt, Astro.url.pathname);

// Brödsmulan går via kategorisidan, så den får bara länkas om den byggs.
const kategoriPost = await getEntry('kategorier', d.kategori);
const kategori = kategoriPost && arPublicerad(kategoriPost) ? kategoriPost : undefined;
const butik = await hamtaButik();
const erbjudande = produkt ? billigasteErbjudande(produkt) : null;
const bild = produkt ? lokalBild(produkt) : null;
const namn = produkt ? produktNamn(produkt) : d.produkt;

const forfattare = await getEntry('forfattare', d.forfattare);
const forfattareNamn = forfattare?.data.namn ?? 'Christian';

// Valets etikett för varje produkt i kategorifilens val. Valen är likställda.
// Se spec-designlyft-d-2026-10-02.md avsnitt 7 punkt 1.
const valEtikett = kategori?.data.val.find((v) => v.produkt === d.produkt)?.etikett;

const alternativ = d.alternativ;

const specs = kategori?.data.specs ?? [];

/**
 * Omdömestabellens andra värdekolumn. Rubriken kommer från mätningarnas `kalla`,
 * så att en granskning med värden ur butikens produktsida inte skriver
 * "Tillverkaren uppger" över dem. Utan fältet står rubriken kvar som förut.
 * Se docs/DESIGN.md avsnitt 5.7.
 */
const KALLRUBRIK = {
  tillverkaren: 'Tillverkaren uppger',
  butiken: 'Butiken uppger',
  'tredje part': 'Tredje part mätte',
} as const;

const matningsKallor = new Set(d.matningar.map((m) => m.kalla ?? 'tillverkaren'));
if (matningsKallor.size > 1) {
  console.warn(
    `[test] ${entry.id}: mätningarna har olika kalla (${[...matningsKallor].join(', ')}). ` +
      'Kolumnen har en rubrik, så den tas från den första mätningen med kalla. ' +
      'Dela upp mätningarna eller skriv källan i texten.',
  );
}
const kallRubrik = KALLRUBRIK[d.matningar.find((m) => m.kalla)?.kalla ?? 'tillverkaren'];

/**
 * `markera` gäller ett värde per rad: det vi mätt när vi mätt, annars uppgiften.
 * Gul markering i en tabell finns bara här, se docs/DESIGN.md avsnitt 6.
 */
function markerar(m: (typeof d.matningar)[number], kolumn: 'vi' | 'tillverkaren'): boolean {
  if (!m.markera) return false;
  const viFinns = arTest && m.vi !== undefined;
  return kolumn === 'vi' ? viFinns : !viFinns;
}

// Standardavsnittet om metoden utgår när innehållet har en egen H2 om den.
// Se spec-designlyft-d-2026-10-02.md avsnitt 6 punkt 2.
const EGEN_RUBRIK_SA_TESTADE = headings.some(
  (h) => h.depth === 2 && /^(så\s+(testade|granskade)\s+(vi|jag)|underlaget\b)/i.test(h.text),
);

// Ordet test står aldrig om en granskning (SEO avsnitt 13): rubriken över
// metoden har en egen nyckel för granskningen.
const METOD_RUBRIK = arTest ? 'Så testade vi' : 'Så granskade jag'; // granskning.metod.rubrik

const rubriker = [
  ...headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text })),
  ...(alternativ.length > 0 ? [{ slug: slugify('Alternativ'), text: 'Alternativ' }] : []),
  { slug: slugify('Specifikationer'), text: 'Specifikationer' },
  ...(EGEN_RUBRIK_SA_TESTADE ? [] : [{ slug: slugify(METOD_RUBRIK), text: METOD_RUBRIK }]),
];

/**
 * Verktygskortet i spalten: kategorins räknare, när den inte redan står
 * inbäddad eller som kort i brödtexten. En sida har aldrig två.
 */
const kropp = entry.body ?? '';
const raknare = kategori?.data.kalkylator;
const visaRaknare =
  raknare !== undefined &&
  !kropp.includes(`<Kalkylator namn="${raknare}"`) &&
  !kropp.includes(`<Verktygskort kalkylator="${raknare}"`);

// Sidospaltens lista: produkten själv och alternativen. Bara alternativen har
// ett kort på sidan att hoppa till.
const sidoprodukter = [
  { slug: d.produkt, ankare: false },
  ...alternativ.map((a) => ({ slug: a.produkt, etikett: a.etikett, forVem: a.varfor, ankare: true })),
];

// Läs vidare: guider och kunskap i samma kategori, de senaste först, högst tre.
// Etiketten är bara typen. Färre än två: bandet utgår, som i artikelmallen.
const utanNiva = ({ niva: _niva, ...k }: KortData): KortData => k;
const lasVidare: KortData[] = [...(await publicerade('guider')), ...(await publicerade('kunskap'))]
  .filter((e) => e.data.kategori === d.kategori)
  .sort((a, b) => b.data.publicerad.getTime() - a.data.publicerad.getTime())
  .slice(0, 3)
  .map((e) => utanNiva(tillKortArtikel(e)));
const visaLasVidare = lasVidare.length >= 2;

const brodsmulor = [
  { namn: 'Hantverkstips', href: '/' },
  ...(kategori ? [{ namn: kategori.data.namn, href: kategoriUrl(d.kategori) }] : []),
  { namn: d.title },
];

/**
 * Delningsbilden i 1200 × 630, ritad ur titeln och sidans första illustration
 * (scripts/generera-delningsbilder.mjs). Produktbilden är leverantörens och går
 * aldrig ut som og:image. Saknas filen tar Bas sajtens standardbild.
 */
const ogBild = delningsbild('tester', entry.id);

const strukturdata = produkt
  ? produktData({
      produkt,
      url: testUrl(entry),
      etikett: d.etikett,
      omdome: d.omdome,
      forfattareNamn,
      publicerad: d.publicerad,
    })
  : null;
---

<Bas
  title={d.seoTitle ?? d.title}
  description={d.description}
  ogBild={ogBild}
  ogTyp="article"
  reklam={true}
  butikNamn={butik?.namn}
  brodsmulor={brodsmulor}
  brodsmulorIVy={true}
  galleri={true}
>
  {strukturdata && <StrukturData slot="head" data={strukturdata} />}

  <div class:list={['sidram pt-8', !visaLasVidare && 'pb-16 lg:pb-24']}>
    <div class="tvaspalt">
      <Brodsmulor lista={brodsmulor} />

      <p class="etikett mt-6 text-penna">
        {typEtikett('test', d.etikett)} · {nivaEtikett(d.niva)}{kategoriPost && ` · ${kategoriPost.data.namn}`}
      </p>
      <h1 class="m-0 mt-3.5 max-w-3xl font-serif text-h1 lg:text-h1-lg">{d.title}</h1>
      <div class="mt-3.5">
        <Byline forfattare={d.forfattare} publicerad={d.publicerad} uppdaterad={d.uppdaterad} minuter={lasminuter(kropp)} />
        {
          arTest && d.testad && (
            <p class="m-0 mt-2 text-liten text-blyerts-2">
              Testad <time datetime={isoDatum(d.testad)}>{formateraDatum(d.testad)}</time>
            </p>
          )
        }
      </div>

      <div class="tvaspalt-rad mt-7">
        <div class="min-w-0">
          {d.kortSvar && <Kortsvarstext text={d.kortSvar} plats={testUrl(entry)} />}

          <section class:list={['kort p-5.5 lg:p-6', d.kortSvar && 'mt-7']}>
            <div class="lg:flex lg:gap-6">
              <div class="lg:w-2/5 shrink-0">
                {
                  bild ? (
                    <div class="bg-vit border border-linje rounded-sm p-2">
                      <img
                        src={bild}
                        alt={namn}
                        width="400"
                        height="300"
                        decoding="async"
                        class="block w-full aspect-4/3 h-auto object-contain"
                      />
                    </div>
                  ) : (
                    <div class="bg-papper-2 border border-linje rounded-sm w-full aspect-4/3 flex flex-col items-center justify-center gap-1 p-2 text-center">
                      <span class="text-etikett uppercase text-blyerts-2">{produkt?.marke ?? namn}</span>
                      {!produkt && <span class="text-liten text-blyerts-2">Produktdata saknas i bygget</span>}
                    </div>
                  )
                }
              </div>

              <div class="mt-4 lg:mt-0 min-w-0 flex-1">
                {valEtikett && <p class="chip-gul m-0 mb-2.5">{valEtikett}</p>}
                <p class="m-0 text-ingress lg:text-ingress-lg">{d.omdome}</p>

                {
                  d.matningar.length > 0 && (
                    <table class="ramtabell mt-4">
                      <caption class="sr-only">{arTest ? `Mätvärden för ${namn}` : `Tillverkarens uppgifter för ${namn}`}</caption>
                      <thead class="[&_th]:text-etikett [&_th]:uppercase [&_th]:text-blyerts-2">
                        <tr>
                          <th scope="col">Egenskap</th>
                          {arTest && <th scope="col">Jag mätte</th>}
                          <th scope="col">{kallRubrik}</th>
                        </tr>
                      </thead>
                      <tbody class="[&_th]:font-normal [&_th]:text-blyerts-2 [&_td]:text-blyerts">
                        {d.matningar.map((m) => (
                          <tr>
                            <th scope="row">
                              {m.etikett}
                              {m.enhet ? `, ${m.enhet}` : ''}
                            </th>
                            {arTest && (
                              <td>
                                {m.vi === undefined ? (
                                  <span class="text-blyerts-2">ej mätt</span>
                                ) : markerar(m, 'vi') ? (
                                  <Markering>{m.vi}</Markering>
                                ) : (
                                  m.vi
                                )}
                              </td>
                            )}
                            <td>
                              {m.tillverkaren === undefined ? (
                                <span class="text-blyerts-2">ej angivet</span>
                              ) : markerar(m, 'tillverkaren') ? (
                                <Markering>{m.tillverkaren}</Markering>
                              ) : (
                                m.tillverkaren
                              )}
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  )
                }
              </div>
            </div>

            <div class="yta mt-6 grid gap-4 p-4 lg:grid-cols-2 lg:gap-6 lg:p-5">
              <div>
                <p class="etikett mb-1 text-blyerts">Köp om</p>
                <p class="m-0 text-brod">{d.kopOm}</p>
              </div>
              <div>
                <p class="etikett mb-1 text-blyerts">Köp inte om</p>
                <p class="m-0 text-brod">{d.kopInteOm}</p>
              </div>
            </div>

            {
              produkt && (
                <div class="mt-6">
                  <Kopknapp
                    produkt={produkt.slug}
                    modul="kort_full"
                    bredd="full"
                    pris={erbjudande?.pris ?? null}
                    prisDatum={erbjudande?.uppdaterad ?? null}
                    butikNamn={erbjudande?.butikNamn}
                    lager={lagerlage(erbjudande)}
                  />
                </div>
              )
            }
          </section>

          <Innehallsforteckning rubriker={rubriker} variant="hopfallbar" />

          <div class="prosa mt-7">
            <Content
              components={{
                h2: Pennstreck,
                Faktaruta,
                Illustration,
                Varning,
                Verktygskort,
                Kalkylator,
                Markering,
                Kopknapp,
                Produktkort,
                Jamforelsetabell,
                Faq,
              }}
            />
          </div>

          {
            alternativ.length > 0 && (
              <section>
                <Pennstreck id={slugify('Alternativ')}>Alternativ</Pennstreck>
                <div class="grid gap-4">
                  {alternativ.map((a) => (
                    <Produktkort
                      produkt={a.produkt}
                      etikett={a.etikett ?? a.varfor}
                      forVem={a.etikett ? a.varfor : undefined}
                      modul="kort_kompakt"
                    />
                  ))}
                </div>
              </section>
            )
          }

          <section>
            <Pennstreck id={slugify('Specifikationer')}>Specifikationer</Pennstreck>
            <table class="ramtabell">
              <caption class="sr-only">Specifikationer för {namn}</caption>
              <tbody class="[&_th]:font-normal [&_th]:text-blyerts-2 [&_td]:text-blyerts">
                {
                  specs.map((s) => (
                    <tr>
                      <th scope="row">
                        {s.etikett}
                        {s.enhet ? `, ${s.enhet}` : ''}
                      </th>
                      <td>
                        {produkt && produkt.specs[s.nyckel] !== undefined && produkt.specs[s.nyckel] !== null ? (
                          formateraSpecVarde(produkt.specs[s.nyckel])
                        ) : (
                          <span class="text-blyerts-2">ej angivet</span>
                        )}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </section>

          {
            !EGEN_RUBRIK_SA_TESTADE && (
              <section>
                <Pennstreck id={slugify(METOD_RUBRIK)}>{METOD_RUBRIK}</Pennstreck>
                <p class="m-0 text-brod lg:text-brod-lg">
                  Metoden i sin helhet står på sidan{' '}
                  <a href="/om/sa-testar-vi/" class="lank">
                    Så testar jag
                  </a>
                  .
                </p>
              </section>
            )
          }

          <Kallor kallor={d.kallor} />

          {
            produkt && (
              <div class="mt-12">
                <Kopknapp
                  produkt={produkt.slug}
                  modul="avslut"
                  pris={erbjudande?.pris ?? null}
                  prisDatum={erbjudande?.uppdaterad ?? null}
                  butikNamn={erbjudande?.butikNamn}
                  lager={lagerlage(erbjudande)}
                />
              </div>
            )
          }
        </div>

        <Sidospalt
          rubriker={rubriker}
          produkter={sidoprodukter}
          kalkylator={visaRaknare ? raknare : undefined}
        />
      </div>
    </div>
  </div>

  {
    visaLasVidare && (
      <section class="band mt-14">
        <div class="sidram py-12 lg:py-14">
          <Rubrikrad id="las-vidare" rubrik="Läs vidare" />
          <Artikelrutnat kort={lasVidare} visaBeskrivning={false} visaMeta={false} />
        </div>
      </section>
    )
  }
</Bas>
