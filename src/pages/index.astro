---
/**
 * Startsidan är en uppslagen anteckningsbok, inte en landningssida. Ingen
 * bakgrundsbild, inga köpknappar, inget reklamband.
 *
 * Blocken följer docs/DESIGN.md avsnitt 5.1: heron (H1, stycket och husskissen),
 * ämnesraden, rutnätet med guider och tester (där "Just nu" är det stora
 * kortet), Bäst i test just nu, Räkna själv och Så jobbar vi. "Just nu" och
 * "Senaste" är ett och samma rutnät: två block med samma sorts innehåll blev
 * två gånger samma bild. Ämnesraden ersatte "Börja här" 2026-09-16: läsaren såg
 * inget att klicka på ovanför vecket och hittade inte till ämnena från
 * startsidan. Säsongsblocket togs bort 2026-09-16: övre halvan sa fyra saker
 * samtidigt. Säsongen styr i stället "Just nu" och rutnätet.
 */
import { getEntry, render } from 'astro:content';
import Bas from '../layouts/Bas.astro';
// Sidans LCP-bild. Egen skiss i ordmärkets stil, dekorativ: H1 bär meningen.
import heroBild from '../assets/illustrationer/start/hus-tumstock.svg';
import { formateraPris } from '../lib/format';
import { arPublicerad, publicerade, slugify } from '../lib/innehall';
import { KALKYLATORER } from '../lib/kalkyl/register';
import {
  allaKort,
  kategoriVal,
  pelareForKategori,
  tillKortArtikel,
  tillKortJamforelse,
  tillKortTest,
  type KortData,
} from '../lib/kort';
import { organisation } from '../lib/strukturdata';
import Amnesrad from '../components/ui/Amnesrad.astro';
import Artikelrutnat from '../components/ui/Artikelrutnat.astro';
import Markering from '../components/ui/Markering.astro';
import Pennstreck from '../components/ui/Pennstreck.astro';
import StrukturData from '../components/ui/StrukturData.astro';
import Verktygskort from '../components/ui/Verktygskort.astro';

const startsida = await getEntry('sidor', 'startsida');
if (!startsida) throw new Error('src/content/sidor/startsida.mdx saknas');
const { Content } = await render(startsida);

// Just nu: chefredaktörens val. Utkast länkas aldrig från en publicerad sida.
const justNuRef = startsida.data.justNu;
let justNu: KortData | null = null;
if (justNuRef) {
  if (justNuRef.samling === 'tester') {
    const e = await getEntry('tester', justNuRef.id);
    if (e && arPublicerad(e)) justNu = tillKortTest(e, await pelareForKategori(e.data.kategori));
  } else if (justNuRef.samling === 'jamforelser') {
    const e = await getEntry('jamforelser', justNuRef.id);
    if (e && arPublicerad(e)) justNu = tillKortJamforelse(e, await pelareForKategori(e.data.kategori));
  } else if (justNuRef.samling === 'guider') {
    const e = await getEntry('guider', justNuRef.id);
    if (e && arPublicerad(e)) justNu = tillKortArtikel(e);
  } else {
    const e = await getEntry('kunskap', justNuRef.id);
    if (e && arPublicerad(e)) justNu = tillKortArtikel(e);
  }
}

// Rutnätet: det stora kortet först, sedan de fyra senaste med justNu bortfiltrerad.
// Ett stort plus fyra fyller två rader exakt på desktop.
const ovriga = (await allaKort()).filter((k) => k.href !== justNu?.href).slice(0, justNu ? 4 : 5);
const rutnat = justNu ? [justNu, ...ovriga] : ovriga;

// Bäst i test just nu: en rad per kategori med kategorifilens första val.
const bastITest = await Promise.all((await publicerade('kategorier')).map(kategoriVal));

/**
 * Title säger samma sak som H1: två sanningar om samma sida håller inte i
 * längden. Meningen skrivs ut här i stället för att byggas av H1, eftersom H1
 * har ett komma som titeln inte ska ha. `seoTitle` i frontmatter vinner, och
 * byter chefredaktören H1 byts den här raden med den.
 */
const h1 = startsida.data.title;
const sidtitel = startsida.data.seoTitle ?? 'Hantverkstips, kunskap om huset från källaren till taket';
---

<Bas title={sidtitel} description={startsida.data.description} bred={true}>
  <StrukturData slot="head" data={organisation()} />

  {/*
    Heron i sidbredd. Desktop: texten 6/12 till vänster, skissen 6/12 till
    höger, lodrätt centrerade med 48 px emellan. Mobil: H1, stycket, sedan
    skissen i full bredd. Bilden är dekorativ och står utan ram och bildtext:
    H1 bär meningen, och skissen har genomskinlig bakgrund, så en ram hade
    bara lagt ännu en kant i övre halvan. Det är sidans LCP-bild.
  */}
  <section class="grid grid-cols-1 items-center gap-6 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-6">
      <h1 class="m-0 font-serif text-h1 lg:text-h1-lg">{h1}</h1>
      <div class="prosa mt-4 text-ingress lg:text-ingress-lg">
        <Content components={{ Markering }} />
      </div>
    </div>

    <div class="lg:col-span-6">
      <img
        src={heroBild.src}
        alt=""
        width={heroBild.width}
        height={heroBild.height}
        fetchpriority="high"
        decoding="async"
        class="block h-auto w-full"
      />
    </div>
  </section>

  {/*
    Ämnesraden. Åtta ämneskort i sidbredd direkt under öppningen: sajtens karta
    och sidans enda navigering ovanför vecket.
  */}
  <Amnesrad />

  {
    rutnat.length > 0 && (
      <section>
        <div class="flex flex-wrap items-baseline justify-between gap-x-6">
          <Pennstreck id={slugify('Guider och tester')}>Guider och tester</Pennstreck>
          <a
            href="/guider/"
            class="huvudmeny inline-flex min-h-11 items-center text-penna underline decoration-1 underline-offset-2 hover:decoration-2"
          >
            Alla guider och tester
          </a>
        </div>
        <Artikelrutnat kort={rutnat} storForsta={true} kompaktPaMobil={true} prioriteraForsta={false} />
      </section>
    )
  }

  {
    bastITest.length > 0 && (
      <section>
        <Pennstreck id={slugify('Bäst i test just nu')}>Bäst i test just nu</Pennstreck>
        <ul class="m-0 grid list-none grid-cols-1 gap-x-12 p-0 lg:grid-cols-2">
          {bastITest.map((b) => (
            <li class="border-t border-linje py-4">
              <h3 class="m-0 font-sans text-h3 lg:text-h3-lg">
                <a href={b.href} class="text-blyerts underline decoration-1 underline-offset-2 hover:decoration-2">
                  {b.namn}
                </a>
              </h3>
              {b.produktNamn && (
                <p class="m-0 mt-1 text-brod text-blyerts-2">
                  <span class="text-etikett uppercase text-blyerts">Mitt val</span> {b.produktNamn}
                  {b.pris !== null && <> · {formateraPris(b.pris)}</>}
                  {b.antal > 0 && <> · {b.antal} granskade</>}
                </p>
              )}
              <p class="m-0 mt-1">
                <a
                  href={b.href}
                  class="inline-flex min-h-11 items-center text-penna underline decoration-1 underline-offset-2 hover:decoration-2"
                >
                  Alla jag granskat
                </a>
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    /* Alla kalkylatorer, från den första. Blocket är enda stället på startsidan
       där verktygen syns sedan säsongsblocket togs bort 2026-09-16. */
    KALKYLATORER.length > 0 && (
      <section>
        <Pennstreck id={slugify('Räkna själv')}>Räkna själv</Pennstreck>
        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
          {KALKYLATORER.map((k) => (
            <Verktygskort kalkylator={k.slug} iRutnat={true} />
          ))}
        </div>
      </section>
    )
  }

  <section class="max-w-lasbredd">
    <Pennstreck id={slugify('Så jobbar jag')}>Så jobbar jag</Pennstreck>
    <p class="m-0 text-brod lg:text-brod-lg">
      Jag mäter själv när jag kan och läser tillverkarnas datablad när jag inte kan.{' '}
      <a href="/om/sa-testar-vi/" class="text-penna underline decoration-1 underline-offset-2 hover:decoration-2">
        Så testar jag
      </a>
      . Sajten finansieras av annonslänkar, och hur det påverkar det jag skriver står på{' '}
      <a
        href="/om/sa-tjanar-vi-pengar/"
        class="text-penna underline decoration-1 underline-offset-2 hover:decoration-2"
      >
        Så tjänar jag pengar
      </a>
      .
    </p>
  </section>
</Bas>
