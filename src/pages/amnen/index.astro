---
/**
 * Alla ämnen, /amnen/. Kartan över sajten, ordnad som människor tänker: ämne
 * först, sedan vad som finns i ämnet. En sektion per publicerad pelare i
 * PELARE-ordning; opublicerade pelare visas inte, en karta med tomma rum är
 * sämre än en mindre karta.
 *
 * Inget rutnät av artikelkort här. Kartan ska vara tät och skanningsbar, och med
 * femhundra artiklar måste den vara en lista. Korten finns för kategorier och
 * kalkylatorer, som är få. Se docs/DESIGN.md avsnitt 5.9.
 */
import Bas from '../../layouts/Bas.astro';
import {
  artikelUrl,
  jamforelseUrl,
  pelareUrl,
  publicerade,
  testUrl,
  typEtikett,
} from '../../lib/innehall';
import { KALKYLATORER } from '../../lib/kalkyl/register';
import { tillKortKategori } from '../../lib/kort';
import { nivaEtikett, type Niva } from '../../lib/niva';
import { PELARE } from '../../lib/pelare';
import { lista } from '../../lib/strukturdata';
import Artikelkort from '../../components/ui/Artikelkort.astro';
import Ikon from '../../components/ui/Ikon.astro';
import Pennstreck from '../../components/ui/Pennstreck.astro';
import StrukturData from '../../components/ui/StrukturData.astro';
import Verktygskort from '../../components/ui/Verktygskort.astro';

const TITEL = 'Alla ämnen';
const INGRESS =
  'Sajten är ordnad efter husets problem, inte efter butikens hyllor. Två ämnen är i gång, resten är på väg och listas utan länk tills de har något att visa.';
const BESKRIVNING =
  'Alla ämnen på Hantverkstips, från fukt inomhus till väggar i gips, med bäst i test-sidor och kalkylatorer. Två i gång, sex på väg.';
const PA_VAG = 'På väg. Altan i februari, Verktyg i mars.';

/** Typordningen i spalten Guider. Tester listas under kategorin, inte här. */
const TYPORDNING = [
  { typ: 'problemguide', rubrik: 'Problemguider' },
  { typ: 'kunskap', rubrik: 'Kunskap' },
  { typ: 'kopguide', rubrik: 'Köpguider' },
  { typ: 'projektguide', rubrik: 'Projektguider' },
] as const;

const hubbar = await publicerade('pelare');
const guider = await publicerade('guider');
const kunskap = await publicerade('kunskap');
const kategorier = await publicerade('kategorier');
const tester = await publicerade('tester');
const jamforelser = await publicerade('jamforelser');

const amnen = await Promise.all(
  PELARE.flatMap((pelare) => {
    const entry = hubbar.find((h) => h.id === pelare.slug);
    return entry ? [{ pelare, entry }] : [];
  }).map(async ({ pelare, entry }) => {
    const artiklar = [...guider, ...kunskap].filter((e) => e.data.pelare === pelare.slug);

    interface Rad {
      titel: string;
      href: string;
      niva: Niva;
    }
    const typgrupper: { rubrik: string; rader: Rad[] }[] = TYPORDNING.map((t) => ({
      rubrik: t.rubrik as string,
      rader: artiklar
        .filter((e) => e.data.typ === t.typ)
        .sort((a, b) => b.data.publicerad.getTime() - a.data.publicerad.getTime())
        .map((e) => ({ titel: e.data.title, href: artikelUrl(e), niva: e.data.niva })),
    })).filter((g) => g.rader.length > 0);

    const iPelaren = kategorier.filter((k) => (k.data.pelare as readonly string[]).includes(pelare.slug));
    const kategoriSlugs = iPelaren.map((k) => k.id);

    const jamforelseRader = jamforelser
      .filter((j) => kategoriSlugs.includes(j.data.kategori))
      .map((j) => ({ titel: j.data.title, href: jamforelseUrl(j), niva: j.data.niva }));
    if (jamforelseRader.length > 0) typgrupper.push({ rubrik: 'Jämförelser', rader: jamforelseRader });

    const kategoriBlock = await Promise.all(
      iPelaren.map(async (k) => ({
        kort: await tillKortKategori(k),
        tester: tester
          .filter((t) => t.data.kategori === k.id)
          .map((t) => ({
            titel: t.data.title,
            href: testUrl(t),
            etikett: typEtikett('test', t.data.etikett),
          })),
      })),
    );

    const verktyg = KALKYLATORER.filter((k) => k.kategori && kategoriSlugs.includes(k.kategori));

    return { pelare, entry, typgrupper, kategoriBlock, verktyg };
  }),
);

const strukturdata = lista({
  url: '/amnen/',
  namn: TITEL,
  poster: amnen.map((a) => ({ namn: a.pelare.namn, url: pelareUrl(a.pelare.slug) })),
});
---

<Bas
  title={`${TITEL} · Hantverkstips`}
  description={BESKRIVNING}
  brodsmulor={[{ namn: 'Hantverkstips', href: '/' }, { namn: TITEL }]}
  bred={true}
>
  <StrukturData slot="head" data={strukturdata} />

  <div class="max-w-lasbredd">
    <h1 class="m-0 font-serif text-h1 lg:text-h1-lg">{TITEL}</h1>
    <p class="m-0 mt-4 text-ingress lg:text-ingress-lg text-blyerts-2">{INGRESS}</p>
  </div>

  {
    amnen.map((a, i) => (
      <section class:list={[i > 0 && 'border-t border-linje']}>
        <div class="mt-12 flex items-center gap-3 lg:mt-16">
          <Ikon namn={a.pelare.ikon} storlek={32} class="text-blyerts" />
          <Pennstreck id={a.pelare.slug} utanLuft={true}>
            <a href={pelareUrl(a.pelare.slug)} class="text-blyerts no-underline hover:underline hover:decoration-penna">
              {a.pelare.namn}
            </a>
          </Pennstreck>
        </div>
        <p class="m-0 max-w-lasbredd text-brod lg:text-brod-lg text-blyerts-2">{a.entry.data.ingress}</p>

        <div class="mt-6 grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12">
          <div class="lg:col-span-6">
            {a.typgrupper.map((g) => (
              <div class="mt-4 first:mt-0">
                <p class="m-0 text-etikett uppercase text-blyerts-2">{g.rubrik}</p>
                <ul class="m-0 list-none p-0">
                  {g.rader.map((r) => (
                    <li class="flex items-baseline justify-between gap-x-4 border-t border-linje">
                      <a
                        href={r.href}
                        class="flex min-h-11 min-w-0 flex-1 items-center text-penna underline decoration-1 underline-offset-2 hover:decoration-2"
                      >
                        {r.titel}
                      </a>
                      <span class="shrink-0 text-etikett uppercase text-blyerts-2">{nivaEtikett(r.niva)}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
            {a.typgrupper.length === 0 && (
              <p class="m-0 text-brod text-blyerts-2">Första sidorna i ämnet skrivs nu.</p>
            )}
          </div>

          {a.kategoriBlock.length > 0 && (
            <div class="lg:col-span-3">
              <p class="m-0 mb-2 text-etikett uppercase text-blyerts-2">Bäst i test</p>
              {a.kategoriBlock.map((b) => (
                <div class="mb-4">
                  <Artikelkort
                    etikett={b.kort.etikett}
                    rubrik={b.kort.rubrik}
                    beskrivning={b.kort.beskrivning}
                    pelare={b.kort.pelare}
                    meta={b.kort.meta}
                    href={b.kort.href}
                    bladfakta={b.kort.bladfakta}
                    visaPelare={false}
                  />
                  {b.tester.length > 0 && (
                    <ul class="m-0 mt-2 list-none p-0">
                      {b.tester.map((t) => (
                        <li class="border-t border-linje">
                          <a
                            href={t.href}
                            class="inline-flex min-h-11 items-center text-penna underline decoration-1 underline-offset-2 hover:decoration-2"
                          >
                            {t.titel}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              ))}
            </div>
          )}

          {a.verktyg.length > 0 && (
            <div class="lg:col-span-3">
              <p class="m-0 mb-2 text-etikett uppercase text-blyerts-2">Räkna</p>
              {a.verktyg.map((k) => (
                <div class="mb-4">
                  <Verktygskort kalkylator={k.slug} iRutnat={true} />
                </div>
              ))}
            </div>
          )}
        </div>
      </section>
    ))
  }

  <p class="m-0 mt-12 max-w-lasbredd border-t border-linje pt-6 text-brod text-blyerts-2 lg:mt-16">{PA_VAG}</p>
</Bas>
