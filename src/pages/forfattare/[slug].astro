---
/**
 * Författarsida. Person-markup och alla publicerade sidor personen skrivit.
 */
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Bas from '../../layouts/Bas.astro';
import { artikelUrl, jamforelseUrl, publicerade, slugify, testUrl, typEtikett } from '../../lib/innehall';
import { person as personData } from '../../lib/strukturdata';
import Pennstreck from '../../components/ui/Pennstreck.astro';
import StrukturData from '../../components/ui/StrukturData.astro';

export async function getStaticPaths() {
  const forfattare = await publicerade('forfattare');
  return forfattare.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const guider = (await publicerade('guider')).filter((e) => e.data.forfattare === entry.id);
const kunskap = (await publicerade('kunskap')).filter((e) => e.data.forfattare === entry.id);
const tester = (await publicerade('tester')).filter((e) => e.data.forfattare === entry.id);
const jamforelser = (await publicerade('jamforelser')).filter((e) => e.data.forfattare === entry.id);

const sidor = [
  ...guider.map((e) => ({ etikett: typEtikett(e.data.typ), namn: e.data.title, href: artikelUrl(e), datum: e.data.publicerad })),
  ...kunskap.map((e) => ({ etikett: typEtikett(e.data.typ), namn: e.data.title, href: artikelUrl(e), datum: e.data.publicerad })),
  ...tester.map((e) => ({
    etikett: typEtikett('test', e.data.etikett),
    namn: e.data.title,
    href: testUrl(e),
    datum: e.data.publicerad,
  })),
  ...jamforelser.map((e) => ({
    etikett: 'Jämförelse',
    namn: e.data.title,
    href: jamforelseUrl(e),
    datum: e.data.publicerad,
  })),
].sort((a, b) => b.datum.getTime() - a.datum.getTime());

const rad = d.sedan ? `${d.yrke} sedan ${d.sedan}` : d.yrke;

const strukturdata = personData({
  slug: entry.id,
  namn: d.namn,
  yrke: d.yrke,
  presentation: d.presentation,
  bildUrl: d.bild?.src,
});
---

<Bas
  title={d.namn}
  description={d.presentation}
  brodsmulor={[{ namn: 'Hantverkstips', href: '/' }, { namn: 'Författare' }, { namn: d.namn }]}
>
  <StrukturData slot="head" data={strukturdata} />

  {d.bild && <Image src={d.bild} alt={d.namn} width={160} height={160} class="rounded-sm" />}

  <h1 class="m-0 mt-4 font-serif text-h1 lg:text-h1-lg">{d.namn}</h1>
  <p class="m-0 mt-2 text-brod lg:text-brod-lg text-blyerts-2">{rad}</p>

  <div class="prosa mt-6">
    <Content />
  </div>

  <section>
    <Pennstreck id={slugify(`Sidor av ${d.namn}`)}>Sidor av {d.namn}</Pennstreck>
    {
      sidor.length > 0 ? (
        <ul class="m-0 p-0 list-none">
          {sidor.map((s) => (
            <li class="border-t border-linje py-3">
              <p class="m-0 text-etikett uppercase text-blyerts">{s.etikett}</p>
              <a
                href={s.href}
                class="inline-flex min-h-11 items-center text-penna underline decoration-1 underline-offset-2 hover:decoration-2"
              >
                {s.namn}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="m-0 text-brod text-blyerts-2">Inga publicerade sidor än.</p>
      )
    }
  </section>
</Bas>
