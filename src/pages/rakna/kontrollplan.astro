---
/**
 * Kontrollplansgeneratorn: läsaren väljer upp till tre åtgärder och får ett
 * förslag till kontrollplan att skriva ut. Formuläret skickas som GET till
 * samma sida och planen ställs upp på servern, så sidan fungerar utan ett enda
 * byte klient-JS. Se docs/SPEC-SIDMALLAR.md avsnitt 4.7 och
 * docs/briefer/spec-kalkyl-kontrollplan-2026-09-28.md.
 *
 * Katalogen, lagrummen och all text som modulen äger ligger i
 * src/lib/kalkyl/kontrollplan.ts. Sidan väljer ingenting själv.
 *
 * Utskriften: allt utom planen har print:hidden, och utskriftsreglerna står i
 * blocket "Kontrollplanen" i src/styles/global.css. Ingen skriv ut-knapp;
 * webbläsarens egen utskrift gör samma sak utan skript (specen 5.3).
 *
 * Verktyget visar inga produkter, så sidan har varken produktkort eller
 * reklamband.
 */
export const prerender = false;

import { artikelUrl, publicerade } from '../../lib/innehall';
import { tillKortArtikel, type KortData } from '../../lib/kort';
import { hittaKalkylator } from '../../lib/kalkyl/register';
import { arPelare } from '../../lib/pelare';
import {
  ANSVAR_LAGRUM,
  ANTAGANDEN,
  cssStrang,
  delbarQuery,
  genereraKontrollplan,
  GOR_INTE_LAGRUM,
  KA_LAGRUM,
  KALLOR_FORFATTNINGAR,
  medLagrum,
  medTal,
  regelLagrum,
  TEXT,
  tolkaQuery,
  type KallaRef,
  type KaStatus,
  type RegelNyckel,
  type TextNyckel,
} from '../../lib/kalkyl/kontrollplan';
import { LANK_KLASS } from '../../lib/kalkyl/stil';
import { verktygsillustration } from '../../lib/verktygsbild';
import KontrollplanForm from '../../components/kalkyl/KontrollplanForm.astro';
import KontrollplanPlan from '../../components/kalkyl/KontrollplanPlan.astro';
import Artikelrutnat from '../../components/ui/Artikelrutnat.astro';
import Faq from '../../components/ui/Faq.astro';
import Illustration from '../../components/ui/Illustration.astro';
import Pennstreck from '../../components/ui/Pennstreck.astro';
import Svarstal from '../../components/ui/Svarstal.astro';
import Tabellyta from '../../components/ui/Tabellyta.astro';
import Raknarsida from '../../components/vyer/Raknarsida.astro';

Astro.locals.sidtyp = 'verktyg';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

/** Slug, namn och beskrivning på ett ställe: brödsmulan, og:image och WebApplication läser samma. */
const SLUG = 'kontrollplan';
/* Visas i brödsmulan och i WebApplication. */
const VERKTYGSNAMN = 'Kontrollplan för ditt bygge';
/* Meta description och WebApplication. */
const BESKRIVNING =
  'En mall för kontrollplan som fylls i efter vad du bygger, enligt reglerna från 1 juli 2026. Skriv ut den eller spara som PDF, gratis och utan e-post.';
/* <title>. */
const titel = 'Kontrollplan mall, ifylld efter ditt bygge';

/* Sidans egen text, skrivs av hantverkaren. */
/* H1, överst. */
const H1 = 'Kontrollplan som fylls i efter det du ska bygga';
/* Ingressen under H1. */
const INGRESS =
  'Byggnadsnämnden vill ha ett förslag till kontrollplan innan du får startbesked, och många mallar på nätet hänvisar fortfarande till Boverkets gamla byggregler, BBR, som inte gäller i nya ärenden. Kryssa i vad du ska bygga eller ändra, så ställer jag upp kontrollerna med krav, metod och vem som gör dem, efter reglerna från 1 juli 2026. Bygger du till behövs dessutom som huvudregel en kontrollansvarig, en certifierad person som hjälper dig med planen och ser till att den följs. Planen är gratis att skriva ut, och ingen e-post behövs.';
/* Knappen i det fulla formuläret. */
const KNAPP = 'Visa kontrollplanen';
/*
 * Stegen under "Så räknar jag", ett per steg i specen 2.7 steg 3 till 10:
 * raderna per åtgärd, de delade raderna, numreringen och kravet, KA och
 * beskedet, regelverksraden, anmälningarna, arbetsplatsbesöken, avfallet.
 */
const STEG = [
  'För varje sak du kryssat i hämtar jag kontrollerna för just den åtgärden, i den ordning man bygger. Ett skärmtak på altanen lägger till tre kontroller av taket, och en befintlig skorsten tar bort de tre som bara gäller en ny.',
  'Kontroller som två åtgärder har gemensamt står bara en gång. Väljer du både tillbyggnad och ventilation mäts luftflödena en gång, efter injusteringen, och kontrollen av att allt stämmer med beslutet står alltid sist.',
  'Varje kontroll får paragrafen som ställer kravet. För energin i en tillbyggnad hänger paragrafen på när ansökan kom in.',
  'Behovet av kontrollansvarig bedömer jag efter den åtgärd som kräver mest, så i en plan med både altan och tillbyggnad väger tillbyggnaden tyngst.',
  'Överst i planen står vilka lagar och föreskrifter kontrollerna hänvisar till, med plan- och bygglagen först.',
  'Begäran om slutbesked står alltid bland anmälningarna. Med eldstad kommer protokollet från skorstensfejarmästaren till, och med ventilation protokollet från funktionskontrollen.',
  'Arbetsplatsbesök föreslår jag bara när det finns en kontrollansvarig. Annars lämnar jag frågan till nämnden.',
  'Avfallshanteringsplanen står sist, med rutan för när den uppenbart inte behövs. Vid rivning får varje del sex tomma rader att skriva på, annars tre.',
];
/*
 * Varv 3, K19 (D5): rubrikerna på avsnittet om hur planen ställs upp och på
 * antagandetabellen under det. Spaltens länk läser STALLS_UPP_RUBRIK.
 */
const STALLS_UPP_RUBRIK = 'Hur jag ställer upp planen';
const BYGGER_PA_RUBRIK = 'Det planen bygger på';
/*
 * Varv 3, K18 (D4, SEO A1): två sektioner efter "Gör inte det här", i alla
 * tillstånd. Vad som ändrades 1 juli 2026, och när ingen kontrollplan behövs.
 * Ett stycke per rad.
 */
const ANDRAT_RUBRIK = 'Nya regler för kontrollplanen från 1 juli 2026';
const ANDRAT_STYCKEN = [
  'Den 1 juli 2026 ändrades plan- och bygglagen, och ändringarna gäller alla ärenden där ansökan eller anmälan kom in den dagen eller senare. Kontrollplanen ska nu också säga vilka krav varje kontroll avser och hur kontrollen görs. Därför har planen här en kolumn för kravet och en för metoden. Ändringarna kom med lag (2026:712), och reglerna om kontrollplanen står i lagens tionde kapitel.',
  'Sedan 1 juli 2026 har avfallet en egen plan, avfallshanteringsplanen, som inte längre är en del av kontrollplanen. Avfallshanteringsplanen ska tala om vilka byggprodukter som kan återanvändas, vilket avfall det blir och hur det tas om hand, och den lämnas in tillsammans med kontrollplanen. När den inte behövs står i nästa avsnitt.',
  'Med lagen kom också byggbedömare, certifierade företag som ska kunna kontrollera en ny byggnad i stället för en kontrollplan. Ännu går det inte att anlita någon, eftersom Boverket räknar med att ha sina föreskrifter om dem klara först hösten 2027. För en altan, en eldstad eller en tillbyggnad blir de aldrig aktuella.',
  'Samma dag slutade Boverkets gamla byggregler BBR och konstruktionsreglerna EKS att gälla i nya ärenden. Kraven står i stället i Boverkets nya föreskrifter, till exempel BFS 2024:6 för bärförmåga och BFS 2024:7 för brandskydd, och raderna i planen hänvisar till dem. För energikraven gäller BBR till och med 30 september 2026 och en egen föreskrift, BFS 2026:9, från den 1 oktober 2026.',
];
const INGEN_PLAN_RUBRIK = 'Kontrollplan behövs inte alltid';
const INGEN_PLAN_STYCKEN = [
  'Planen behövs bara när det du gör kräver bygglov, rivningslov eller anmälan. En altan som får byggas utan lov behöver ingen plan.',
  'Byggnadsnämnden får också besluta att en enklare åtgärd klarar sig utan kontrollplan, till exempel en mur, ett plank eller en ändring av fasaden. Nämnden beslutar om det i varje ärende för sig, så räkna med att planen behövs tills nämnden har sagt något annat.',
  'Avfallshanteringsplanen behövs inte när det är uppenbart att det inte finns något behov av den (10 kap. 8 a § andra st.). Det bedömer du som byggherre, och nämnden prövar bedömningen. Därför har utskriften en ruta för det, men den kryssar jag aldrig i åt dig, för bedömningen är din.',
];
/* Kolumnrubrikerna i antagandetabellen: vad, värde eller beslut, källa eller antagande. */
const ANTAGANDE_KOLUMNER = ['Vad det gäller', 'Så gör planen', 'Källa eller antagande'];
/* Skissen (uppdrag B) finns inte än. Alt och bildtext när den kommer. */
const SKISS_ALT =
  'Altan i genomskärning med kontrollplanens numrerade kontroller vid husväggen, plinten, bärlinan, räcket och trappan';
const SKISS_BILDTEXT =
  'Siffrorna är kontrollerna i planen för en altan utan tak vid huset: läget (1), plinten (2), bärlinan (3), räcket (5) och trappan (6). Golvet ligger 1,5 m över marken. Plinten och bärlinan kontrolleras mot BFS 2024:6, räcket och trappan mot BFS 2024:9. Plinten ska kontrolleras innan gropen fylls igen.';
/* "Läs vidare": verktyget för bygglov, kunskapssidan och värdartikeln när den är vald. */
const LAS_VIDARE = [
  { href: '/rakna/bygglov-altan/', text: 'Behöver altanen bygglov? Fyll i höjden och avståndet och få svar' },
  { href: '/altan/bygglov-altan/', text: 'Bygglov för altan, och när ett tak gör den till en tillbyggnad' },
  { href: '/grund/inreda-kallare/', text: 'Inreda källaren, med anmälan och startbesked för det du ändrar' },
  { href: '/rakna/grannemedgivande/', text: 'Se om grannen måste skriva under, och skriv ut medgivandet' },
];
/*
 * Faq, tre till fem frågor. Kandidater ur SERP-läsningen: vad skriver jag i
 * "mot vad" när BBR är borta, behövs avfallshanteringsplan, när behövs ingen
 * kontrollplan, kan jag skriva planen själv.
 */
const FRAGOR = [
  {
    fraga: 'Vad ska en kontrollplan för eldstad innehålla?',
    svar: medTal(
      'Planen ska ha kontroller av eldstadens och skorstenens dokumenterade egenskaper, av underlaget, avståndet till brännbart material, eldstadsplanen och förbränningsluften, och av att rökgaserna inte kommer tillbaka in. Sist kommer en täthetsprovning som skorstensfejarmästaren gör före första brasan. Med en ny skorsten tillkommer genomföringen i bjälklaget, att mynningen ligger minst {mynning} m över taktäckningen och takskyddet för sotaren. Installationen ska anmälas, och kaminen får inte användas förrän du fått slutbesked.',
    ),
  },
  {
    fraga: 'Vad skriver jag som krav nu när BBR inte gäller?',
    svar: 'Du skriver paragrafen i Boverkets nya föreskrifter som ställer kravet, till exempel BFS 2024:7 4 kap. 16 § för skorstenens mynning. Ritningen eller anvisningen du mäter mot hör hemma i kolumnen Hur och mot vad. I ärenden som kommit in den 1 juli 2026 eller senare hör BBR och EKS inte hemma i planen, med undantag för energikraven till och med 30 september 2026. Står det BBR i kommunens gamla mall byter du raden mot den nya paragrafen.',
  },
  {
    fraga: 'Kan jag skriva kontrollplanen själv?',
    svar: 'Ja. Utan kontrollansvarig tar du som byggherre fram förslaget själv, och Boverket skriver att planen kan se ut på olika sätt så länge uppgifterna finns med. Har kommunen en egen mall kan du föra över raderna till den. Krävs en kontrollansvarig hjälper hen dig med förslaget.',
  },
  {
    fraga: 'Vem skriver under kontrollplanen?',
    svar: 'Den som gör en kontroll signerar och daterar sin rad när kontrollen är gjord, och du som byggherre skriver under intygandet sist, när du begär slutbesked. Enligt Boverket ska dokumentationen styrkas med underskrift av den som kontrollerat. Vid det tekniska samrådet, mötet med nämnden innan bygget börjar, räcker det att kontrollanten står med sin roll. Inför slutsamrådet, när bygget är klart, ska namnet stå där.',
  },
  {
    fraga: 'Vad händer om en kontroll inte blir gjord?',
    svar: 'Då kan du inte visa att planen är följd, och det måste du kunna för att få slutbesked. Utan slutbesked får du inte börja använda det du byggt, om nämnden inte har beslutat annat. Har plintarna redan grävts igen är det bättre att säga det till nämnden och fråga hur du kan visa dem i efterhand än att signera något du inte har sett.',
  },
];

const { indata } = tolkaQuery(Astro.url.searchParams);
const resultat = genereraKontrollplan(indata);
const fel = resultat.status === 'ogiltig' ? resultat.fel : {};
/*
 * Beskedsräknare (specen för grannemedgivandet 12.8): vid ogiltigt värde visar
 * spalten bara varningen, ingen plan, inga regler och inga råd. Ingen annan
 * plan räknas då (varv 3, K1).
 */
const ogiltig = resultat.status === 'ogiltig';
const visat = resultat.status === 'ogiltig' ? null : resultat;
/**
 * Den delbara adressen till just den här planen, absolut, för sidfoten på
 * utskriften och fältet i spalten. Bara när det finns en plan (varv 3, K1, D10).
 */
const adress = resultat.status === 'ok' ? `${Astro.site}rakna/kontrollplan/?${delbarQuery(resultat.indata)}` : null;

const t = (k: string): string => medTal(TEXT[k as TextNyckel]);
const ka: KaStatus = visat?.status === 'ok' ? visat.ka : 'nej';
const lagrum = (n: RegelNyckel) => regelLagrum(n, ka, visat ? visat.indata.inkom : indata.inkom);
/**
 * Källorna under antagandetabellen, en gång var, i den ordning de först
 * förekommer: antagandenas källor och sedan författningarna och kommunexemplen,
 * som inte är rader i tabellen (specen 16.1 D6 och 16.6 punkt 4).
 */
const kallor: KallaRef[] = [];
for (const k of [...ANTAGANDEN.flatMap((a) => a.kallor), ...KALLOR_FORFATTNINGAR]) {
  if (!kallor.some((x) => x.url === k.url)) kallor.push(k);
}
/**
 * Etiketten till fastighetsraden i utskriftens marginal (global.css, @page
 * kontrollplan). Ett värde ur TEXT, ingen utskriftsregel, och därför inline
 * (specen 16.6 punkt 2). Bara när det finns en plan att skriva ut.
 */
const fastighetsvariabel = `:root{--kp-fastighet:${cssStrang(TEXT['utskrift.falt.fastighet'])}}`;

/** Skissen står i kortet Hur jag ställer upp planen. Huvudet har ingen bild sedan fas C (DESIGN.md 5.8). */
const illustration = verktygsillustration(SLUG);

/*
 * Svarsytan, fas C (spec-designlyft-c-2026-10-02 avsnitt 13): antalet
 * kontroller som det stora talet och beskedet; själva planen står i efter,
 * direkt efter resonemanget. Ny text är hantverkarens. Klartexten har
 * platshållarna {antal} (kontroller i planen) och {atgarder} (de valda
 * åtgärderna med planens namn, "Ny altan, Nybyggnad av komplementbyggnad",
 * små bokstäver efter den första).
 */
const KLARTEXT =
  'Planen har {antal} kontroller. Enligt plan- och bygglagen 10 kap. 6 § ska planen visa vad som kollas och av vem, anmälningarna och nämndens besök. Sedan den 1 juli 2026 har avfallet en egen plan.'; // kontrollplan.klartext
const klartext =
  visat?.status === 'ok'
    ? KLARTEXT.replace('{antal}', String(visat.punkter.length)).replace(
        '{atgarder}',
        visat.indata.atgarder
          .map((a, i) => {
            const namn = TEXT[`atgard.${a}.plan` as TextNyckel];
            return i === 0 ? namn : namn.charAt(0).toLowerCase() + namn.slice(1);
          })
          .join(', '),
      )
    : '';

/**
 * Läs vidare: artiklarna som artikelkort, räknarna med registrets namn som på
 * hubben, i den förra listans ordning.
 */
const artiklar = [...(await publicerade('guider')), ...(await publicerade('kunskap'))];
const lasVidare: KortData[] = [];
const lasVidareLankar: { href: string; text: string }[] = [];
for (const l of LAS_VIDARE) {
  const e = artiklar.find((a) => artikelUrl(a) === l.href);
  if (e) {
    const { niva: _niva, ...kort } = tillKortArtikel(e);
    lasVidare.push(kort);
    continue;
  }
  const k = hittaKalkylator(l.href.replace(/^\/rakna\/|\/$/g, ''));
  const pelare = k?.pelare?.[0];
  if (k && pelare && arPelare(pelare)) {
    lasVidare.push({
      etikett: 'Räkna själv',
      rubrik: k.namn,
      beskrivning: k.rad,
      pelare,
      href: l.href,
      // Artikelrutnat läser inte typen; kortet står varken i ett typfilter eller sorteras.
      typ: 'kunskap',
      sorteringsdatum: new Date(0),
    });
    continue;
  }
  lasVidareLankar.push(l);
}
/** Antagandetabellen, cellklasserna en gång på <table>. */
const TABELL_KLASS =
  'w-full border-collapse text-liten [&_th]:p-2 [&_td]:p-2 [&_th]:align-top [&_td]:align-top [&_th]:text-left [&_tbody_th]:[font-weight:inherit] [&_tr]:border-b [&_tr]:border-linje [&_th]:text-blyerts [&_td]:text-blyerts [&_thead_th]:text-etikett [&_thead_th]:uppercase [&_thead_th]:text-blyerts-2';
---

<Raknarsida
  slug={SLUG}
  namn={VERKTYGSNAMN}
  titel={titel}
  beskrivning={BESKRIVNING}
  rubrik={H1}
  delaUrl={adress ?? undefined}
  saRaknarRubrik={STALLS_UPP_RUBRIK}
  saRaknarId="sa-stalls-planen-upp"
  utskriftEfter
>
  {adress && <style is:inline slot="head" set:html={fastighetsvariabel} />}

  <p slot="ingress">{INGRESS}</p>

  <KontrollplanForm slot="formular" indata={indata} fel={fel} knappText={KNAPP} />

  <Fragment slot="svar">
    {/* Beskedsräknare: vid ogiltigt värde står bara varningen, ingen plan (specen 12.8, varv 3 K1). */}
    {ogiltig && <p class="text-liten text-varning">{TEXT['spalt.beskedsvarning']}</p>}
    {
      visat?.status === 'ok' && (
        <>
          <Svarstal tal={String(visat.punkter.length)} enhet={TEXT['spalt.enhet']} />
          <div class="text-brod">
            <p class="font-bold">{TEXT[`besked.${visat.besked}`]}</p>
            <p class="mt-1!">{medLagrum(TEXT['spalt.ansvar'], ANSVAR_LAGRUM)}</p>
          </div>
          <p class="text-liten text-blyerts-2">{medLagrum(TEXT[`ka.${visat.ka}`], KA_LAGRUM[visat.ka])}</p>
          <div>
            <p class="text-brod">{TEXT['spalt.pekrad']}</p>
            <p class="mt-2! text-liten text-blyerts-2">{TEXT['skarm.handskrift']}</p>
            <p class="mt-2! text-liten text-blyerts-2">{TEXT['spalt.utskrift']}</p>
            <p class="mt-1!">
              <a href="#planen" class:list={['inline-flex min-h-11 items-center', LANK_KLASS]}>Till planen</a>
            </p>
          </div>
          <p class="text-liten text-blyerts">{klartext}</p>
        </>
      )
    }
    {
      visat && visat.status !== 'ok' && (
        <>
          <p class="text-brod font-bold">{TEXT['besked.aldre-regler']}</p>
          {visat.regler.map((n) => (
            <p class="text-brod">{medLagrum(TEXT[`regel.${n}`], lagrum(n))}</p>
          ))}
          <p class="text-liten text-blyerts-2">{TEXT['spalt.utskrift']}</p>
        </>
      )
    }
  </Fragment>

  {
    visat?.status === 'ok' && (
      <Fragment slot="darfor">
        <Pennstreck id="darfor-blev-svaret-sa" utanLuft>
          Därför blev svaret så
        </Pennstreck>
        <div class="darfor">
          {visat.regler.map((n) => (
            <div>
              <span class="block text-etikett lg:text-etikett-lg uppercase text-blyerts-2">{lagrum(n)}</span>
              <p>{TEXT[`regel.${n}`]}</p>
            </div>
          ))}
        </div>
      </Fragment>
    )
  }

  {
    visat?.status === 'ok' && visat.gorInteDetHar.length > 0 && (
      <Fragment slot="gorInte">
        {/* Flera råd står i samma stycke efter "Gör inte det här.", vart och ett på egen rad. */}
        {visat.gorInteDetHar.map((g, i) => (
          <span class:list={[i > 0 && 'mt-3 block']}>{medLagrum(TEXT[`gorInte.${g}`], GOR_INTE_LAGRUM[g])}</span>
        ))}
      </Fragment>
    )
  }

  <Fragment slot="saRaknarJag">
    {
      illustration && (
        <div class="pappersruta">
          <Illustration namn="rakna/kontrollplan" alt={SKISS_ALT} bildtext={SKISS_BILDTEXT} class="my-0!" />
        </div>
      )
    }
    <ol class="m-0 mt-4 pl-6 list-decimal text-brod">
      {STEG.map((s) => <li class="mb-2">{s}</li>)}
    </ol>
  </Fragment>

  <Fragment slot="efter">
    {/*
      Planen, direkt efter resonemanget (spec-designlyft-c avsnitt 13), och det
      enda på sidan som skrivs ut. Allt annat i efter har print:hidden;
      huvudet, räknaren och resonemanget döljs av Raknarsida (utskriftEfter).
      Utskriftsreglerna står i blocket Kontrollplanen i global.css.
    */}
    {
      visat?.status === 'ok' && adress && (
        <section id="planen" class="kp-sektion">
          <Pennstreck class="print:hidden">{TEXT['utskrift.titel']}</Pennstreck>
          <KontrollplanPlan resultat={visat} adress={adress} />
        </section>
      )
    }

    {/* Antagandetabellen i läsbredd, ur kortet Hur jag ställer upp planen (spec-designlyft-c avsnitt 9). */}
    <section class="max-w-lasbredd print:hidden">
      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">{BYGGER_PA_RUBRIK}</h3>
      <Tabellyta kolumner={3} class="mt-4">
        <table class={TABELL_KLASS}>
          <thead>
            <tr>{ANTAGANDE_KOLUMNER.map((k) => <th scope="col">{k}</th>)}</tr>
          </thead>
          <tbody>
            {
              ANTAGANDEN.map((a) => (
                <tr>
                  <th scope="row">{t(`antagande.${a.nr}`)}</th>
                  <td>{t(`antagande.${a.nr}.varde`)}</td>
                  <td>
                    {a.typ}.{a.kallor.length > 0 && ` ${a.kallor.map((k) => k.titel).join('; ')}`}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </Tabellyta>
      {/* Länkklassen en gång på listan, inte per länk (specen 16.6 punkt 1). Samma utseende som LANK_KLASS. */}
      <ul class="m-0 mt-4 pl-6 text-liten [&_a]:text-penna [&_a]:underline [&_a]:decoration-1 [&_a]:underline-offset-2 [&_a:hover]:decoration-2">
        {
          kallor.map((k) => (
            <li>
              <a href={k.url} rel="nofollow">{k.titel}</a>, {k.last}
            </li>
          ))
        }
      </ul>
    </section>

    {/* Varv 3, K18: i alla tillstånd, också vid ogiltigt värde och äldre regler. */}
    <section class="max-w-lasbredd print:hidden">
      <Pennstreck id="andrat-1-juli-2026">{ANDRAT_RUBRIK}</Pennstreck>
      {ANDRAT_STYCKEN.map((p, i) => <p class:list={['m-0 text-brod lg:text-brod-lg', i > 0 && 'mt-4']}>{p}</p>)}
    </section>

    <section class="max-w-lasbredd print:hidden">
      <Pennstreck id="nar-behovs-ingen-kontrollplan">{INGEN_PLAN_RUBRIK}</Pennstreck>
      {INGEN_PLAN_STYCKEN.map((p, i) => <p class:list={['m-0 text-brod lg:text-brod-lg', i > 0 && 'mt-4']}>{p}</p>)}
    </section>

    <section class="print:hidden">
      <Pennstreck id="las-vidare">Läs vidare</Pennstreck>
      {lasVidare.length > 0 && (
        <Artikelrutnat kort={lasVidare} kolumner={4} visaBeskrivning={false} visaMeta={false} />
      )}
      {lasVidareLankar.length > 0 && (
        <ul class="m-0 mt-4 p-0 list-none max-w-lasbredd">
          {lasVidareLankar.map((l) => (
            <li class="border-t border-linje">
              <a href={l.href} class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
                {l.text}
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>

    <div class="max-w-lasbredd print:hidden">
      <Faq fragor={FRAGOR} />
    </div>
  </Fragment>
</Raknarsida>
