---
/**
 * Vad håller i gipsväggen? Formuläret skickas som GET till samma sida och
 * bedömningen sker på servern, så sidan fungerar utan ett enda byte klient-JS.
 * Kostnaden är en serverfunktion per anrop, och den hålls nere med CDN-cache.
 * Se docs/SPEC-SIDMALLAR.md avsnitt 4.7.
 *
 * Reglerna och alla tillverkarvärden ligger i src/lib/kalkyl/gipsplugg.ts.
 * Sidan bedömer ingenting själv, den visar beskedet och redovisar källan bakom
 * varje tal.
 *
 * Inga pluggar finns i produktdatabasen, så sidan har varken produktkort eller
 * reklamband. Talen är tillverkarnas rekommenderade last, inte brottlast, och
 * de byts mot våra egna den dag belastningsundersökningen är gjord.
 */
export const prerender = false;

import { formateraTal } from '../../lib/format';
import { artikelUrl, publicerade } from '../../lib/innehall';
import { tillKortArtikel, type KortData } from '../../lib/kort';
import {
  GRANS_REGEL_KG,
  MAXLAST_AVSTAND_MM,
  MIN_AVSTAND_MM,
  NORGIPS_SKIVAN_KG,
  raknaGipsplugg,
  SAK_TEXT,
  SKIVA_TEXT,
  STANDARD,
  SVANGARM_FAKTOR,
  TAK_MAX_KG,
  tolkaQuery,
  type GipspluggIndata,
  type GipspluggResultat,
} from '../../lib/kalkyl/gipsplugg';
import { CELL_KLASS, LANK_KLASS } from '../../lib/kalkyl/stil';
import { verktygsillustration } from '../../lib/verktygsbild';
import GipspluggForm from '../../components/kalkyl/GipspluggForm.astro';
import Artikelrutnat from '../../components/ui/Artikelrutnat.astro';
import Faq from '../../components/ui/Faq.astro';
import Pennstreck from '../../components/ui/Pennstreck.astro';
import Tabellyta from '../../components/ui/Tabellyta.astro';
import Illustration from '../../components/ui/Illustration.astro';
import Raknarsida from '../../components/vyer/Raknarsida.astro';

Astro.locals.sidtyp = 'verktyg';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

const q = Astro.url.searchParams;
const { indata } = tolkaQuery(q);
const resultat = raknaGipsplugg(indata);

const fel = resultat.status === 'ogiltig' ? resultat.fel : {};
// Vid ogiltig indata visas standardvärdenas svar, med en rad som säger det.
const visat: GipspluggResultat = resultat.status === 'ogiltig' ? raknaGipsplugg(STANDARD) : resultat;
const visatIndata: GipspluggIndata = resultat.status === 'ogiltig' ? STANDARD : indata;

const komma = (n: number) => String(n).replace('.', ',');
/** Tal i löptext: heltal utan decimal, annars en. "8 kg", "12,5 kg". */
const talText = (n: number) => formateraTal(n, Number.isInteger(n) ? 0 : 1);

/**
 * Fältens värden kommer från query-strängen som den skrevs, inte från de
 * tolkade talen: "tungt" eller "" blir NaN i tolkaQuery, och NaN i ett fält som
 * läsaren ska rätta är obrukbart.
 */
function faltVarde(nyckel: string, standardVarde: number): string {
  const ra = q.get(nyckel);
  if (ra !== null) return ra;
  return komma(standardVarde);
}

const varden = {
  vikt: faltVarde('vikt', STANDARD.viktKg),
  punkter: faltVarde('punkter', STANDARD.punkter),
};

/**
 * Delbar länk. Hela frågan ligger redan i query-strängen, så adressen är
 * svaret. Den byggs av de tolkade värdena, inte av strängen läsaren skrev.
 */
const delaQuery = new URLSearchParams({
  vikt: komma(visatIndata.viktKg),
  sak: visatIndata.sak,
  skiva: visatIndata.skiva,
  punkter: String(visatIndata.punkter),
  regel: visatIndata.regel,
});
const delaLank = new URL(`/rakna/gipsplugg/?${delaQuery.toString()}`, Astro.site ?? Astro.url).toString();

/** Källorna under tabellen, en gång var, i den ordning raderna står. */
const tabellKallor =
  visat.status === 'ok'
    ? visat.infastningar
        .map((rad) => ({ kalla: rad.kalla, url: rad.kallaUrl }))
        .filter((k, i, alla) => alla.findIndex((a) => a.kalla === k.kalla) === i)
    : [];

const REGEL_TEXT: Record<GipspluggIndata['regel'], string> = {
  ja: 'med en regel bakom',
  nej: 'utan regel bakom',
  'vet-inte': 'och du vet inte om det finns en regel bakom',
};

const punktText = (n: number) => (n === 1 ? 'en punkt' : `${n} punkter`);

/** Beskedet överst i spalten: vad du ska göra. */
const BESKED_RUBRIK = {
  krok: 'Häng saken i en X-krok eller på en klisterremsa.',
  plugg: 'Välj en plugg i tabellen som klarar lasten.',
  regel: 'Skruva fast saken i regeln med träskruv.',
  kortling: 'Öppna väggen och sätt in en kortling.',
} as const;

const titel = 'Pluggväljare för gipsvägg efter vikt';

/** Varje tal i verktyget med sin källa eller sitt antagande. */
const FISCHER_GK =
  'https://www.fischer-international.com/en/products/cavity-fixings/board-fixing/plasterboard-fixing-gk';
const FISCHER_DUOBLADE =
  'https://www.fischer-international.com/en/products/cavity-fixings/board-fixing/plasterboard-fixing-duoblade';
const GDS = 'https://gds.se/vagg/gipsvagg/varianter-av-gipspluggar';
const NORGIPS_VAGG = 'https://www.norgips.se/situation/hanga-saker/';
const NORGIPS_GIPSVAGG = 'https://www.norgips.se/kunskapsbank/nar-du-vill-kunna-hanga-saker-pa-vaggarna/';

const antaganden: { storhet: string; varde: string; grund: 'Källa' | 'Antagande'; stod: string; url?: string }[] = [
  {
    storhet: 'Självborrande gipsplugg',
    varde: '8 kg i ett lag, 7 kg i 9,5 mm',
    grund: 'Källa',
    stod: 'Infästningstillverkaren fischer, GK i nylon och GKM i metall. Inget värde anges för två lag',
    url: FISCHER_GK,
  },
  {
    storhet: 'Självborrande med utvikande blad',
    varde: '10 kg i ett lag, 20 kg i två',
    grund: 'Källa',
    stod: 'Infästningstillverkaren fischer, DuoBlade. Värdet för gipsfiberskiva hör inte hit och står inte med',
    url: FISCHER_DUOBLADE,
  },
  {
    storhet: 'Kilformat clips',
    varde: '10 kg i ett lag, 15 kg i två',
    grund: 'Källa',
    stod: 'Tidningen Gör Det Själv, varianter av gipspluggar',
    url: GDS,
  },
  {
    storhet: 'Hålrumsplugg ø 6 mm',
    varde: '18 kg i ett lag, 28 kg i två',
    grund: 'Källa',
    stod: 'Tidningen Gör Det Själv, som ovan',
    url: GDS,
  },
  {
    storhet: 'Gipsankare med utvikande fot',
    varde: '25 kg i ett lag, 40 kg i två',
    grund: 'Källa',
    stod: 'Tidningen Gör Det Själv, som ovan',
    url: GDS,
  },
  {
    storhet: 'Molly ø 10 mm med rosett',
    varde: '38 kg i ett lag, 70 kg i två',
    grund: 'Källa',
    stod: 'Tidningen Gör Det Själv, som ovan',
    url: GDS,
  },
  {
    storhet: 'Vipplugg med krok',
    varde: '25 kg, bara i tak',
    grund: 'Källa',
    stod: 'Tidningen Gör Det Själv, som ovan',
    url: GDS,
  },
  {
    storhet: 'X-krok med spik',
    varde: '5 kg',
    grund: 'Källa',
    stod: 'Beslagsbutiken BGA. Samma krok anges till mer i trä, och det värdet gäller inte gips',
    url: 'https://www.bga.se/Magazine/satta-upp-tavlor-pa-gipsvagg/',
  },
  {
    storhet: 'Klisterremsa för tavla',
    varde: '7 kg vid ram 60 × 90 cm',
    grund: 'Källa',
    stod: 'Tillverkaren 3M, Command. Mindre ram bär mindre, och remsorna fungerar inte på tapet',
    url: 'https://command.3msverige.se/3M/sv_SE/command-EU/how-to/how-to-hang-picture-without-nails/',
  },
  {
    storhet: 'Inslagen klokrok',
    varde: '7 kg',
    grund: 'Källa',
    stod: 'Tillverkaren 3M, Claw för gipsvägg',
    url: 'https://www.clasohlson.com/se/3M-Claw-tavelkrok-for-gipsvagg,-7-kg/p/41-4261',
  },
  {
    storhet: 'Gipskrok i stål',
    varde: '20 kg',
    grund: 'Källa',
    stod: 'Beslagstillverkaren Habo. Den tyngsta infästningen som fortfarande bara sitter i skivan',
    url: 'https://habo.com/se/sortiment/mobelbeslag/tavelhangare/gipskrok-19756',
  },
  {
    storhet: 'Skruv med plugg direkt i skivan',
    varde: '5 till 6 kg',
    grund: 'Källa',
    stod: 'Gipstillverkaren Norgips, hänga upp saker på väggen',
    url: NORGIPS_VAGG,
  },
  {
    storhet: 'Avståndet mellan två infästningar',
    varde: '50 mm, och 300 mm vid maxlast',
    grund: 'Källa',
    stod: 'Gipstillverkaren Norgips, hänga upp saker på gipsvägg',
    url: NORGIPS_GIPSVAGG,
  },
  {
    storhet: 'Infästning i tak',
    varde: 'högst cirka 20 kg per fästpunkt',
    grund: 'Källa',
    stod: 'Norgips, som också skriver att stift och X-krok inte fungerar i tak',
    url: NORGIPS_GIPSVAGG,
  },
  {
    storhet: 'Gränsen för regel eller kortling',
    varde: '20 kg',
    grund: 'Antagande',
    stod: 'Min gräns för hela gipsklustret. Norgips skriver "tyngre saker" utan tal, och jag sätter ett som är försiktigt mot mollyns 38 kg',
    url: '/inomhus/skruva-i-gipsvagg/',
  },
  {
    storhet: 'Svängarm och skåp med lucka',
    varde: 'alltid regel eller kortling',
    grund: 'Antagande',
    stod: 'Min regel. Norgips hänvisar ojämn last till tvärregel eller kortling utan att ange en vikt',
    url: NORGIPS_VAGG,
  },
  {
    storhet: 'Hävarmen på ett tv-fäste',
    varde: 'hela vikten gånger 1,5',
    grund: 'Antagande',
    stod: 'Min regel. Ingen tillverkare jag hittat anger hur mycket armen ökar lasten i den övre skruvraden',
  },
  {
    storhet: 'Hylla och skåp',
    varde: 'övre raden bär hela lasten',
    grund: 'Antagande',
    stod: 'Min regel. En hylla vrider sig ut från väggen, och jag räknar den övre raden som halva antalet punkter',
  },
  {
    storhet: 'Krokarna i tabellen',
    varde: 'bara tavla och spegel',
    grund: 'Antagande',
    stod: 'Mitt urval. En klisterremsa och en X-krok bär en tavla i en tråd, inte en konsol som skruvas fast',
  },
  {
    storhet: 'Infästningar i tak',
    varde: 'bara de som viker ut sig',
    grund: 'Antagande',
    stod: 'Mitt urval, utöver Norgips besked om stift och X-krok. I tak räknar jag inte med en plugg som bara gängar sig i skivan',
  },
  {
    storhet: 'Min egen mätning',
    varde: 'kommer i vinter',
    grund: 'Antagande',
    stod: 'Jag drar åtta pluggtyper till brott med hängvåg i en vägg med 13 mm skiva. Då ersätter mina uppmätta tal tillverkarnas, och tabellen skrivs om',
    url: '/om/sa-testar-vi/',
  },
];

/** Frågorna sist på sidan. Måtten läses ur samma konstanter som bedömningen. */
const FRAGOR = [
  {
    fraga: 'Hur mycket håller en plugg i gipsvägg?',
    svar: 'Det beror på vilken plugg det är och på hur många lag gips väggen har, och spannet är stort. En självborrande gipsplugg anges till 8 kilo i ett lag på 12,5 millimeter. En molly med rosett anges till 38 kilo i samma vägg, och till nästan det dubbla i två lag. Talen är tillverkarens rekommenderade last för en vikt som hänger stilla, inte brottlast. De gäller en plugg i taget med gott om hel skiva runt om.',
  },
  {
    fraga: 'När räcker inte pluggen, utan det måste sitta i regeln?',
    svar: `Väger saken mer än ${GRANS_REGEL_KG} kilo ska den sitta i regeln bakom gipset, eller i en kortling om du inte träffar någon regel där saken ska sitta. Samma sak gäller allt som belastas ojämnt, som ett skåp där lasten skiftar varje gång någon öppnar luckan, och varje tv-fäste med svängarm oavsett vad tv:n väger. Gränsen är min egen och medvetet försiktig. Den gäller tills jag har belastat pluggarna själv.`,
    lank: { text: 'Hela resonemanget står i guiden om att skruva i gipsvägg.', href: '/inomhus/skruva-i-gipsvagg/' },
  },
  {
    fraga: 'Hur nära varandra får två pluggar sitta?',
    svar: `Aldrig närmare än ${MIN_AVSTAND_MM} millimeter, och ska varje skruv bära sin maxlast vill Norgips att du går upp till ${MAXLAST_AVSTAND_MM} millimeter. Skälet är att pluggarna delar på samma gips. Sätter du fyra pluggar inom en handflata bryter de loss ett enda stycke skiva tillsammans, och då spelar det ingen roll vad var och en var märkt för. En tung sak i två punkter är alltså värre än en lättare sak i fyra.`,
  },
];

/** Slug, namn och beskrivning på ett ställe: brödsmulan, og:image och WebApplication läser samma. */
const SLUG = 'gipsplugg';
const VERKTYGSNAMN = 'Vad håller i gipsväggen';
const BESKRIVNING =
  'Fyll i vikten och skivans tjocklek, så säger verktyget om en plugg räcker i gipsväggen, om saken ska sitta i regeln eller om du behöver en kortling.';
/** Skissen står i kortet Så bedömer jag. Huvudet har ingen bild sedan fas C (DESIGN.md 5.8). */
const illustration = verktygsillustration(SLUG);

/*
 * Svarsytan, fas C (spec-designlyft-c-2026-10-02 avsnitt 12): svaret är ett
 * fäste i ord, som källarens diagnos. Ingen mätare: gränsen på 20 kg är
 * sajtens egen (GRANS_REGEL_KG, ANTAGANDE), och beskedet pekar inte ut ett
 * enda fäste vars last läsaren kan jämföra med; tabellen gör det rad för
 * rad. Ny text är hantverkarens. Klartexten har platshållarna {svar} (fästet i
 * ord, SVAR_RUBRIK), {vikt} (kg), {punkter} (antal), {last} (kg per bärande
 * punkt) och {skiva} (skivan i ord, SKIVA_TEXT).
 */
const KLARTEXT =
  'Med {last} kg per bärande punkt i {skiva} blir svaret ”{svar}”, räknat på att saken väger {vikt} kg och på fischers och 3M:s uppgifter om last per infästning, lästa 2026.'; // gipsplugg.klartext
const klartext =
  visat.status === 'ok'
    ? KLARTEXT.replace('{svar}', visat.svarRubrik)
        .replace('{vikt}', talText(visatIndata.viktKg))
        .replace('{punkter}', String(visatIndata.punkter))
        .replace('{last}', talText(visat.lastPerPunktKg))
        .replace('{skiva}', SKIVA_TEXT[visatIndata.skiva])
    : '';

/** Läs vidare som kort, i den förra listans ordning. */
const LAS_VIDARE = ['/inomhus/gipsplugg/', '/inomhus/skruva-i-gipsvagg/', '/inomhus/hanga-tavla-gipsvagg/', '/inomhus/gipsskruv/'];
const artiklar = [...(await publicerade('guider')), ...(await publicerade('kunskap'))];
const lasVidare: KortData[] = LAS_VIDARE.flatMap((href): KortData[] => {
  const e = artiklar.find((a) => artikelUrl(a) === href);
  if (!e) return [];
  const { niva: _niva, ...kort } = tillKortArtikel(e);
  return [kort];
});
---

<Raknarsida
  slug={SLUG}
  namn={VERKTYGSNAMN}
  titel={titel}
  beskrivning={BESKRIVNING}
  rubrik="Vad håller i gipsväggen? Välj plugg efter vikten"
  delaUrl={delaLank}
  saRaknarRubrik="Så bedömer jag"
  saRaknarId="sa-bedomer-vi"
>
  <p slot="ingress">
    En gipsvägg tål mer än folk tror, men det är vikten per skruv som räknas, inte vikten på saken. Fyll i
    vikten, vad det är och hur många punkter den hänger i, så säger jag om det räcker med en krok, en plugg i
    skivan, en skruv i regeln eller en kortling bakom gipset. En kortling är en träbit du sätter in vågrätt
    mellan två reglar. Över 20 kg går min gräns för vad som får hänga i skivan alls.
  </p>

  {/* Formuläret ligger i src/components/kalkyl/GipspluggForm.astro, så att
      <Kalkylator namn="gipsplugg" /> i artikeln visar exakt samma fält. */}
  <GipspluggForm slot="formular" indata={indata} varden={varden} fel={fel} />

  {
    visat.status === 'ok' && (
      <Fragment slot="svar">
        {resultat.status === 'ogiltig' && (
          <p class="text-liten text-varning">
            Ett av fälten gick inte att läsa, så jag visar standardvärdena tills du rättat det.
          </p>
        )}
        {/* Svaret är ett fäste i ord: det står i Zilla Slab i stället för det stora talet. */}
        <div>
          <p class="text-liten text-blyerts-2 first-letter:uppercase">
            {SAK_TEXT[visatIndata.sak]} på {talText(visatIndata.viktKg)} kg i {punktText(visatIndata.punkter)},{' '}
            {SKIVA_TEXT[visatIndata.skiva]} {REGEL_TEXT[visatIndata.regel]}
          </p>
          <p class="flex flex-wrap items-baseline gap-x-2 text-blyerts">
            <span class="font-serif text-h2">{visat.svarOrd}</span>
            <span class="text-brod">{visat.svarRest}</span>
          </p>
        </div>
        <p class="text-liten text-blyerts-2">Varje punkt som bär får {talText(visat.lastPerPunktKg)} kg på sig.</p>
        <p class="text-brod font-bold">{BESKED_RUBRIK[visat.svar]}</p>
        <p class="text-liten text-blyerts">{klartext}</p>
      </Fragment>
    )
  }

  {
    visat.status === 'ok' && (
      <Fragment slot="darfor">
        <Pennstreck id="darfor-blev-svaret-sa" utanLuft>
          Därför blev svaret så
        </Pennstreck>
        <div class="darfor">
          <div>
            <p>{visat.svarText}</p>
            <p>
              {visat.kraverRegel
                ? 'Gränsen på 20 kg och regeln om svängarm och skåp med lucka är mina. Norgips skriver bara ”tyngre saker” utan tal.'
                : 'Talen per infästning är tillverkarnas rekommenderade last, inte brottlast. Väger saken över 20 kg, eller är den en tv på svängarm eller ett skåp med lucka, ska den sitta i regeln. Den gränsen är min.'}
            </p>
          </div>
          <div>
            <p>{visat.lastText}</p>
            <p>Att den övre raden bär allt på en hylla, och faktorn 1,5 på en svängarm, är mina antaganden.</p>
          </div>
          <div>
            <p>
              Det jag inte vet är hur din vägg mår. Skivan kan vara skadad sedan förut, hålet kan redan vara
              urborrat, och det kan ligga en elkabel bakom. Borra aldrig rakt över eller rakt under ett uttag eller
              en strömbrytare, och kör en regelsökare över ytan innan borren går i.
            </p>
            <p>Det här har jag ingen källa på. Det är mitt eget råd.</p>
          </div>
        </div>

        {/* Tabellen: infästningarna som gäller för den här saken, enklast
            först. Det som inte räcker står kvar gråmarkerat, så att läsaren
            ser hur långt ifrån det är. Den är själva svaret och står kvar här
            som förut (spec-designlyft-c avsnitt 12). */}
        <h3 class="m-0 mt-6 font-sans text-h3 lg:text-h3-lg text-blyerts">
          Infästningar som klarar {talText(visat.lastPerPunktKg)} kg per punkt i {SKIVA_TEXT[visatIndata.skiva]}
        </h3>
        <Tabellyta kolumner={3} class="mt-4">
          <table class="w-full border-collapse text-liten tabular-nums">
            <caption class="sr-only">
              Infästningar som klarar {talText(visat.lastPerPunktKg)} kg per punkt, enklast först
            </caption>
            <thead>
              <tr class="border-b border-linje text-left">
                <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">
                  Infästning
                </th>
                <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2 whitespace-nowrap">
                  Bär, kg
                </th>
                <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2 whitespace-nowrap">
                  Räcker
                </th>
              </tr>
            </thead>
            <tbody>
              {visat.infastningar.map((rad) => (
                <tr class:list={[!rad.klarar && 'text-blyerts-2']}>
                  <th scope="row" class:list={[CELL_KLASS, 'text-left font-normal', !rad.klarar && 'text-blyerts-2']}>
                    {rad.namn}
                    {rad.anm && <span class="block text-blyerts-2">{rad.anm}</span>}
                  </th>
                  <td class:list={[CELL_KLASS, !rad.klarar && 'text-blyerts-2']}>{talText(rad.kapacitetKg ?? 0)}</td>
                  <td class:list={[CELL_KLASS, !rad.klarar && 'text-blyerts-2']}>{rad.klarar ? 'Ja' : 'Nej'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </Tabellyta>
        <p class="m-0 mt-2 text-liten text-blyerts-2">
          Talen är tillverkarens rekommenderade last per infästning, inte brottlast. Källor:{' '}
          {tabellKallor.map((k, i) => (
            <>
              {i > 0 && ', '}
              <a href={k.url} rel="nofollow" class={LANK_KLASS}>
                {k.kalla}
              </a>
            </>
          ))}
          .
        </p>
        {visat.ingenKlarar && (
          <p class="m-0 mt-4 text-varning">
            Ingen infästning i tabellen är märkt för din last per punkt. Fler infästningspunkter sänker lasten,
            men över min gräns hjälper inte det heller. Då ska saken i regeln eller i en kortling.
          </p>
        )}
        {visat.utelamnade && <p class="m-0 mt-4">{visat.utelamnade}</p>}
      </Fragment>
    )
  }

  {
    visat.status === 'ok' && visat.gorInteDetHar.length > 0 && (
      <Fragment slot="gorInte">
        {/* Flera råd står i samma stycke efter "Gör inte det här.", vart och ett på egen rad. */}
        {visat.gorInteDetHar.map((rad, i) => (
          <span class:list={[i > 0 && 'mt-3 block']}>{rad}</span>
        ))}
      </Fragment>
    )
  }

  <Fragment slot="saRaknarJag">
    {
      illustration && (
        <div class="pappersruta">
          <Illustration
            namn="rakna/gipsplugg"
            alt="Genomskärning av en gipsvägg med hålrum bakom, en plugg som viker ut sina armar mot skivans baksida och en vikt i skruven."
            bildtext="Skissen visar det verktyget bedömer: en skiva på 12,5 millimeter, vikten per infästning och pluggens armar som tar spjärn mot skivans baksida."
            class="my-0!"
          />
        </div>
      )
    }
    <ol class="m-0 mt-4 pl-6 list-decimal text-brod">
      <li class="mb-2">Lasten fördelas på de infästningspunkter som faktiskt bär den.</li>
      <li class="mb-2">
        En hylla och ett skåp får hela lasten på den övre raden, eftersom de vrider sig ut från väggen. Den övre
        raden räknas som halva antalet punkter, avrundat nedåt.
      </li>
      <li class="mb-2">
        På ett tv-fäste med svängarm multiplicerar jag dessutom vikten med {komma(SVANGARM_FAKTOR)} innan jag fördelar den.
        Jag har satt den faktorn själv, eftersom ingen tillverkare anger någon.
      </li>
      <li class="mb-2">
        Väger saken mer än {GRANS_REGEL_KG}&nbsp;kg blir svaret regel eller kortling, oavsett vad tabellen säger.
        Samma sak gäller allt som sitter på en arm eller skiftar, som svängarmen och skåpet med lucka.
      </li>
      <li class="mb-2">
        Sedan prövar jag lasten per punkt mot varje infästning som finns angiven för den skiva du valt. Raden som
        inte når upp står kvar i grått, så att du ser hur långt ifrån den är.
      </li>
      <li class="mb-2">
        Krokar och klisterremsor får bara vara med för en tavla eller en spegel. En hyllkonsol eller ett tv-fäste
        skruvas fast och kan inte hänga i en krok.
      </li>
      <li class="mb-2">
        I tak räknar jag bara infästningar som viker ut sig bakom skivan, och där kapar jag varje tillverkarvärde
        vid {TAK_MAX_KG}&nbsp;kg per fästpunkt enligt Norgips.
      </li>
      <li>
        Räcker ingen infästning i din skiva blir svaret kortling. Fler punkter sänker lasten per punkt, och det
        är ofta den enklaste vägen.
      </li>
    </ol>
  </Fragment>

  <Fragment slot="efter">
    {/* Antagandetabellen i läsbredd, ur kortet Så bedömer jag (spec-designlyft-c avsnitt 9). */}
    <section class="max-w-lasbredd">
      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">Vad siffrorna vilar på</h3>
      <Tabellyta kolumner={3} class="mt-4">
        <table class="w-full border-collapse text-liten tabular-nums">
          <caption class="sr-only">Tillverkarvärden, källor och antaganden i pluggväljaren för gipsvägg</caption>
          <thead>
            <tr class="border-b border-linje text-left">
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Infästning eller regel</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Jag räknar med</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Källa eller antagande</th>
            </tr>
          </thead>
          <tbody>
            {
              antaganden.map((a) => (
                <tr>
                  <th scope="row" class:list={[CELL_KLASS, 'text-left font-normal']}>
                    {a.storhet}
                  </th>
                  <td class={CELL_KLASS}>{a.varde}</td>
                  <td class={CELL_KLASS}>
                    {a.grund}.{' '}
                    {a.url ? (
                      <a href={a.url} rel={a.url.startsWith('/') ? undefined : 'nofollow'} class={LANK_KLASS}>
                        {a.stod}
                      </a>
                    ) : (
                      a.stod
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </Tabellyta>

      <p class="m-0 mt-6 text-brod lg:text-brod-lg">
        Talen i tabellen är tillverkarnas och leverantörernas rekommenderade last per infästning, inte brottlast.
        De gäller en plugg i taget, i en hel skiva, med en vikt som hänger stilla. Tidningen Gör Det Själv skriver
        själv att vikterna varierar mellan tillverkare och ska ses som vägledande. Står det ett annat tal på
        förpackningen i din hand är det förpackningen som gäller.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Tabellen skrivs om den dag jag dragit åtta pluggtyper till brott med hängvåg i en vägg med 13 mm skiva,
        och det är planerat till vintern. Då får du både brottlasten och den last där skivan börjar ge sig, i
        stället för tillverkarnas tal. Tills dess står ingen egen siffra i verktyget, och det står också på sidan{' '}
        <a href="/om/sa-testar-vi/" class={LANK_KLASS}>Så testar jag</a>.
      </p>
    </section>

    <section class="max-w-lasbredd">
      <Pennstreck id="plugg-i-gipsvagg">Hur mycket en plugg i gipsvägg håller innan 20 kilo blir för mycket</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        En gipsskiva bär mer än folk tror och mycket mindre än de hoppas. Det som avgör är sällan hur tung saken är,
        utan hur tung den är per skruv. En vägghylla på 80 cm väger några kilo tom, men fyll den med kokböcker och
        du ligger på 25 kg. Hänger den i fyra punkter blir det ändå drygt 6 kg på varje.
        Gipstillverkaren Norgips sätter gränsen för en skruv med plugg direkt i skivan vid som mest{' '}
        {NORGIPS_SKIVAN_KG}&nbsp;kg, så den hyllan är fortfarande inom vad väggen klarar per punkt.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Två avstånd följer med varje plugg. Två infästningar ska aldrig sitta tätare än {MIN_AVSTAND_MM}&nbsp;mm
        från varandra, och ska var och en bära sin maxlast vill Norgips att du går upp till{' '}
        {MAXLAST_AVSTAND_MM}&nbsp;mm. Skälet är att pluggarna delar på samma gips. Sätter du fyra pluggar inom en handflata bryter de
        loss ett enda stycke skiva tillsammans, oavsett vad var och en var märkt för.
      </p>

      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">Hänga tungt i gipsvägg utan att öppna den</h3>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Det andra skivlaget är värt mer än pluggen. Samma molly går från 38 till 70 kilo bara för att det finns
        dubbelt så mycket gips att ta spjärn mot, enligt tidningen Gör Det Själv. Det är därför verktyget frågar
        efter tjockleken innan det svarar. Det är också därför en plugg gjord för ett lag är fel i en dubbelgipsad
        vägg, för den når aldrig igenom och viker därför aldrig ut sig. Vet du inte hur tjock din vägg är skruvar
        du loss ett eluttag, med strömmen bruten, och mäter i kanten på hålet.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Min gräns går ändå vid {GRANS_REGEL_KG}&nbsp;kg. Över den ska saken sitta i regeln bakom gipset eller i en
        kortling. Regeln är den stående trä- eller stålbiten som skivan är skruvad fast i. Pluggarna i tabellen är
        märkta för mer än så, men tillverkarens tal gäller en vikt som hänger stilla i en hel skiva. Gränsen är
        min, den är medvetet försiktig, och den gäller tills jag har belastat pluggarna själv.
      </p>

      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">Varför armen på tv-fästet ändrar hela räkningen</h3>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Ska du montera tv på gipsvägg och den sitter platt mot väggen är vikten sällan det som avgör. Borra
        fästplattan så att skruvarna går in i två reglar, använd träskruv, och du är klar. Problemet är fästena
        med arm. Dra ut tv:n en halvmeter från väggen och vikten hänger inte längre rakt ner, den bänder. Den övre
        skruvraden dras utåt ur väggen medan den nedre pressas in, och det är den övre raden som ger sig först.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Ingen tillverkare jag hittat anger hur mycket armen ökar lasten i den övre raden. Verktyget räknar därför
        med mitt eget antagande, att den raden ensam får bära hela vikten gånger {komma(SVANGARM_FAKTOR)}, och
        talet står märkt som ett antagande i tabellen längre ner. Beskedet blir ändå detsamma vilken faktor jag
        väljer. Ett fäste med svängarm skruvas i regeln, aldrig i en plugg. Träffar du inte två reglar öppnar du
        väggen och sätter en kortling. En tv som faller framåt gör det över soffan.
      </p>
    </section>

    {
      lasVidare.length > 0 && (
        <section>
          <Pennstreck id="las-vidare">Läs vidare</Pennstreck>
          <Artikelrutnat kort={lasVidare} kolumner={4} visaBeskrivning={false} visaMeta={false} />
        </section>
      )
    }

    <div class="max-w-lasbredd">
      <Faq fragor={FRAGOR} />
    </div>
  </Fragment>
</Raknarsida>
