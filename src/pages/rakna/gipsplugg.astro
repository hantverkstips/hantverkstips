---
/**
 * Vad håller i gipsväggen? Formuläret skickas som GET till samma sida och
 * bedömningen sker på servern, så sidan fungerar utan ett enda byte klient-JS.
 * Kostnaden är en serverfunktion per anrop, och den hålls nere med CDN-cache.
 * Se docs/SPEC-SIDMALLAR.md avsnitt 4.7.
 *
 * Reglerna och alla tillverkarvärden ligger i src/lib/kalkyl/gipsplugg.ts.
 * Sidan bedömer ingenting själv, den visar beskedet och redovisar källan bakom
 * varje tal.
 *
 * Inga pluggar finns i produktdatabasen, så sidan har varken produktkort eller
 * reklamband. Talen är tillverkarnas rekommenderade last, inte brottlast, och
 * de byts mot våra egna den dag belastningsundersökningen är gjord.
 */
export const prerender = false;

import Bas from '../../layouts/Bas.astro';
import { formateraTal } from '../../lib/format';
import {
  GRANS_REGEL_KG,
  MAXLAST_AVSTAND_MM,
  MIN_AVSTAND_MM,
  NORGIPS_SKIVAN_KG,
  raknaGipsplugg,
  SAK_TEXT,
  SKIVA_TEXT,
  STANDARD,
  SVANGARM_FAKTOR,
  TAK_MAX_KG,
  tolkaQuery,
  XKROK_KG,
  type GipspluggIndata,
  type GipspluggResultat,
} from '../../lib/kalkyl/gipsplugg';
import { CELL_KLASS, ETIKETT_KLASS, FALT_KLASS, LANK_KLASS } from '../../lib/kalkyl/stil';
import { verktyg } from '../../lib/strukturdata';
import { verktygsDelningsbild, verktygsillustration, verktygsVarumarkesbild } from '../../lib/verktygsbild';
import GipspluggForm from '../../components/kalkyl/GipspluggForm.astro';
import Faktaruta from '../../components/ui/Faktaruta.astro';
import Faq from '../../components/ui/Faq.astro';
import Markering from '../../components/ui/Markering.astro';
import Pennstreck from '../../components/ui/Pennstreck.astro';
import StrukturData from '../../components/ui/StrukturData.astro';
import Tabellyta from '../../components/ui/Tabellyta.astro';
import Illustration from '../../components/ui/Illustration.astro';

Astro.locals.sidtyp = 'verktyg';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

const q = Astro.url.searchParams;
const { indata } = tolkaQuery(q);
const resultat = raknaGipsplugg(indata);

const fel = resultat.status === 'ogiltig' ? resultat.fel : {};
// Vid ogiltig indata visas standardvärdenas svar, med en rad som säger det.
const visat: GipspluggResultat = resultat.status === 'ogiltig' ? raknaGipsplugg(STANDARD) : resultat;
const visatIndata: GipspluggIndata = resultat.status === 'ogiltig' ? STANDARD : indata;

const komma = (n: number) => String(n).replace('.', ',');
/** Tal i löptext: heltal utan decimal, annars en. "8 kg", "12,5 kg". */
const talText = (n: number) => formateraTal(n, Number.isInteger(n) ? 0 : 1);

/**
 * Fältens värden kommer från query-strängen som den skrevs, inte från de
 * tolkade talen: "tungt" eller "" blir NaN i tolkaQuery, och NaN i ett fält som
 * läsaren ska rätta är obrukbart.
 */
function faltVarde(nyckel: string, standardVarde: number): string {
  const ra = q.get(nyckel);
  if (ra !== null) return ra;
  return komma(standardVarde);
}

const varden = {
  vikt: faltVarde('vikt', STANDARD.viktKg),
  punkter: faltVarde('punkter', STANDARD.punkter),
};

/**
 * Delbar länk. Hela frågan ligger redan i query-strängen, så adressen är
 * svaret. Den byggs av de tolkade värdena, inte av strängen läsaren skrev.
 */
const delaQuery = new URLSearchParams({
  vikt: komma(visatIndata.viktKg),
  sak: visatIndata.sak,
  skiva: visatIndata.skiva,
  punkter: String(visatIndata.punkter),
  regel: visatIndata.regel,
});
const delaLank = new URL(`/rakna/gipsplugg/?${delaQuery.toString()}`, Astro.site ?? Astro.url).toString();

/** Källorna under tabellen, en gång var, i den ordning raderna står. */
const tabellKallor =
  visat.status === 'ok'
    ? visat.infastningar
        .map((rad) => ({ kalla: rad.kalla, url: rad.kallaUrl }))
        .filter((k, i, alla) => alla.findIndex((a) => a.kalla === k.kalla) === i)
    : [];

const REGEL_TEXT: Record<GipspluggIndata['regel'], string> = {
  ja: 'regel bakom',
  nej: 'ingen regel bakom',
  'vet-inte': 'regeln okänd',
};

const punktText = (n: number) => (n === 1 ? '1 punkt' : `${n} punkter`);

const titel = 'Pluggväljare för gipsvägg, vad håller din vikt';

/** Varje tal i verktyget med sin källa eller sitt antagande. */
const FISCHER_GK =
  'https://www.fischer-international.com/en/products/cavity-fixings/board-fixing/plasterboard-fixing-gk';
const FISCHER_DUOBLADE =
  'https://www.fischer-international.com/en/products/cavity-fixings/board-fixing/plasterboard-fixing-duoblade';
const GDS = 'https://gds.se/vagg/gipsvagg/varianter-av-gipspluggar';
const NORGIPS_VAGG = 'https://www.norgips.se/situation/hanga-saker/';
const NORGIPS_GIPSVAGG = 'https://www.norgips.se/kunskapsbank/nar-du-vill-kunna-hanga-saker-pa-vaggarna/';

const antaganden: { storhet: string; varde: string; grund: 'Källa' | 'Antagande'; stod: string; url?: string }[] = [
  {
    storhet: 'Självborrande gipsplugg',
    varde: '8 kg i ett lag, 7 kg i 9,5 mm',
    grund: 'Källa',
    stod: 'Infästningstillverkaren fischer, GK i nylon och GKM i metall. Inget värde anges för två lag',
    url: FISCHER_GK,
  },
  {
    storhet: 'Självborrande med utvikande blad',
    varde: '10 kg i ett lag, 20 kg i två',
    grund: 'Källa',
    stod: 'Infästningstillverkaren fischer, DuoBlade. Värdet för gipsfiberskiva hör inte hit och står inte med',
    url: FISCHER_DUOBLADE,
  },
  {
    storhet: 'Kilformat clips',
    varde: '10 kg i ett lag, 15 kg i två',
    grund: 'Källa',
    stod: 'Tidningen Gör Det Själv, varianter av gipspluggar',
    url: GDS,
  },
  {
    storhet: 'Hålrumsplugg ø 6 mm',
    varde: '18 kg i ett lag, 28 kg i två',
    grund: 'Källa',
    stod: 'Tidningen Gör Det Själv, som ovan',
    url: GDS,
  },
  {
    storhet: 'Gipsankare med utvikande fot',
    varde: '25 kg i ett lag, 40 kg i två',
    grund: 'Källa',
    stod: 'Tidningen Gör Det Själv, som ovan',
    url: GDS,
  },
  {
    storhet: 'Molly ø 10 mm med rosett',
    varde: '38 kg i ett lag, 70 kg i två',
    grund: 'Källa',
    stod: 'Tidningen Gör Det Själv, som ovan. fischers egen tabell för HM ligger i en PDF vi inte kunnat läsa',
    url: GDS,
  },
  {
    storhet: 'Vipplugg med krok',
    varde: '25 kg, bara i tak',
    grund: 'Källa',
    stod: 'Tidningen Gör Det Själv, som ovan',
    url: GDS,
  },
  {
    storhet: 'X-krok med spik',
    varde: '5 kg',
    grund: 'Källa',
    stod: 'Beslagsbutiken BGA. Samma krok anges till mer i trä, och det värdet gäller inte gips',
    url: 'https://www.bga.se/Magazine/satta-upp-tavlor-pa-gipsvagg/',
  },
  {
    storhet: 'Klisterremsa för tavla',
    varde: '7 kg vid ram 60 × 90 cm',
    grund: 'Källa',
    stod: 'Tillverkaren 3M, Command. Mindre ram bär mindre, och remsorna fungerar inte på tapet',
    url: 'https://command.3msverige.se/3M/sv_SE/command-EU/how-to/how-to-hang-picture-without-nails/',
  },
  {
    storhet: 'Inslagen klokrok',
    varde: '7 kg',
    grund: 'Källa',
    stod: 'Tillverkaren 3M, Claw för gipsvägg',
    url: 'https://www.clasohlson.com/se/3M-Claw-tavelkrok-for-gipsvagg,-7-kg/p/41-4261',
  },
  {
    storhet: 'Gipskrok i stål',
    varde: '20 kg',
    grund: 'Källa',
    stod: 'Beslagstillverkaren Habo. Den tyngsta infästningen som fortfarande bara sitter i skivan',
    url: 'https://habo.com/se/sortiment/mobelbeslag/tavelhangare/gipskrok-19756',
  },
  {
    storhet: 'Skruv med plugg direkt i skivan',
    varde: '5 till 6 kg',
    grund: 'Källa',
    stod: 'Gipstillverkaren Norgips, hänga upp saker på väggen',
    url: NORGIPS_VAGG,
  },
  {
    storhet: 'Avstånd mellan två infästningar',
    varde: '50 mm, och 300 mm vid maxlast',
    grund: 'Källa',
    stod: 'Gipstillverkaren Norgips, hänga upp saker på gipsvägg',
    url: NORGIPS_GIPSVAGG,
  },
  {
    storhet: 'Infästning i tak',
    varde: 'högst cirka 20 kg per fästpunkt',
    grund: 'Källa',
    stod: 'Norgips, som också skriver att stift och X-krok inte fungerar i tak',
    url: NORGIPS_GIPSVAGG,
  },
  {
    storhet: 'Gränsen för regel eller kortling',
    varde: '20 kg',
    grund: 'Antagande',
    stod: 'Vår gräns för hela gipsklustret. Norgips skriver "tyngre saker" utan tal, och vi sätter ett som är konservativt mot mollyns 38 kg',
    url: '/inomhus/skruva-i-gipsvagg/',
  },
  {
    storhet: 'Svängarm och skåp med lucka',
    varde: 'alltid regel eller kortling',
    grund: 'Antagande',
    stod: 'Vår regel. Norgips hänvisar oregelbunden last till tvärregel eller kortling utan att ange en vikt',
    url: NORGIPS_VAGG,
  },
  {
    storhet: 'Hävarmen på ett tv-fäste',
    varde: 'hela vikten gånger 1,5',
    grund: 'Antagande',
    stod: 'Vår regel. Ingen tillverkare vi hittat anger hur mycket armen ökar lasten i den övre skruvraden',
  },
  {
    storhet: 'Hylla och skåp',
    varde: 'övre raden bär hela lasten',
    grund: 'Antagande',
    stod: 'Vår regel. En hylla vrider sig ut från väggen, och vi räknar den övre raden som halva antalet punkter',
  },
  {
    storhet: 'Krokarna i tabellen',
    varde: 'bara tavla och spegel',
    grund: 'Antagande',
    stod: 'Vårt urval. En klisterremsa och en X-krok bär en tavla i en tråd, inte en konsol som skruvas fast',
  },
  {
    storhet: 'Infästningar i tak',
    varde: 'bara de som viker ut sig',
    grund: 'Antagande',
    stod: 'Vårt urval, utöver Norgips besked om stift och X-krok. En plugg som bara gängar sig i skivan räknar vi inte i tak',
  },
  {
    storhet: 'Vår egen mätning',
    varde: 'kommer i vinter',
    grund: 'Antagande',
    stod: 'Vi drar åtta pluggtyper till brott med hängvåg i en vägg med 13 mm skiva. Då ersätter våra uppmätta tal tillverkarnas, och tabellen skrivs om',
    url: '/om/sa-testar-vi/',
  },
];

/** Frågorna sist på sidan. Måtten läses ur samma konstanter som bedömningen. */
const FRAGOR = [
  {
    fraga: 'Hur mycket håller en plugg i gipsvägg?',
    svar: 'Det beror på pluggen och på hur många lag gips väggen har, och spannet är stort. En självborrande gipsplugg anges till 8 kilo i ett lag på 12,5 millimeter. En molly med rosett anges till 38 kilo i samma vägg och till nästan det dubbla i två lag. Talen är tillverkarens rekommenderade last för en vikt som hänger stilla, inte brottlast, och de gäller en plugg i taget med gott om gips runt om.',
  },
  {
    fraga: 'När räcker inte pluggen, utan det måste sitta i regeln?',
    svar: `Väger saken mer än ${GRANS_REGEL_KG} kilo ska den sitta i regeln bakom gipset, eller i en kortling om du inte träffar någon regel. Samma sak gäller allt som belastas ojämnt, alltså ett skåp där lasten skiftar varje gång någon öppnar luckan, och varje tv-fäste med svängarm oavsett vad tv:n väger. Gränsen är vår egen och medvetet försiktig. Den gäller tills vi har belastat pluggarna själva.`,
    lank: { text: 'Hela resonemanget står i guiden om att skruva i gipsvägg.', href: '/inomhus/skruva-i-gipsvagg/' },
  },
  {
    fraga: 'Hur nära varandra får två pluggar sitta?',
    svar: `Aldrig närmare än ${MIN_AVSTAND_MM} millimeter, och ska varje skruv bära sin maxlast vill Norgips att du går upp till ${MAXLAST_AVSTAND_MM} millimeter. Skälet är att pluggarna delar på samma gips. Sätter du fyra pluggar inom en handflata bryter de loss ett enda stycke skiva tillsammans, och då spelar det ingen roll vad var och en var märkt för. En tung sak i två punkter är alltså värre än en lättare sak i fyra.`,
  },
];

/** Slug, namn och beskrivning på ett ställe: brödsmulan, og:image och WebApplication läser samma. */
const SLUG = 'gipsplugg';
const VERKTYGSNAMN = 'Vad håller i gipsväggen';
const BESKRIVNING =
  'Fyll i vikten, vad saken är och skivans tjocklek, så säger verktyget om plugg räcker, om det ska i regeln eller om väggen behöver en kortling.';
const illustration = verktygsillustration(SLUG);
/**
 * Varumärkesbilden i sidhuvudet, sedan 2026-09-19 (docs/DESIGN.md avsnitt 7).
 * Finns den står skissen i stället i "Så bedömer vi", där måtten förklarar
 * räkningen. Finns den inte visas skissen i sidhuvudet som förut.
 */
const varumarke = verktygsVarumarkesbild(SLUG);
const huvudbild = varumarke ?? illustration;
---

<Bas
  title={titel}
  description={BESKRIVNING}
  reklam={false}
  brodsmulor={[
    { namn: 'Hantverkstips', href: '/' },
    { namn: 'Räkna själv', href: '/rakna/' },
    { namn: VERKTYGSNAMN },
  ]}
  bred={true}
  ogBild={verktygsDelningsbild(SLUG)}
>
  <StrukturData
    slot="head"
    data={verktyg({ url: `/rakna/${SLUG}/`, namn: VERKTYGSNAMN, beskrivning: BESKRIVNING })}
  />

  <div class="mx-auto w-full max-w-lasbredd">
    {/*
      Sidhuvudet: rubrik och ingress till vänster i 7/12, bilden till höger i
      5/12 på desktop, under ingressen på mobil. Bilden är dekorativ, H1 bär
      betydelsen, därför tom alt. Den är sidans LCP-bild och laddas därför
      eagert med fetchpriority. Varumärkesbilden har transparent bakgrund och
      ligger som heron utan ram; skissen är ett urklipp och får ramen. Saknas
      båda visas ingen bild alls.
    */}
    <section class="grid grid-cols-1 items-center gap-6 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7">
        <h1 class="m-0 font-serif text-h1 lg:text-h1-lg">Vad håller i gipsväggen? Välj plugg efter vikten</h1>
        <p class="m-0 mt-4 text-ingress lg:text-ingress-lg">
          Vilken plugg en gipsvägg tål avgörs inte av hur tung saken är, utan av hur tung den är per infästning. Fyll i
          vikten, vad det är och hur många punkter den hänger i, så säger verktyget om det räcker med en krok, en plugg
          i skivan, en skruv i regeln eller en kortling bakom gipset. Varje gipsplugg står med den vikt tillverkaren
          anger för just din skiva, och det som inte räcker är gråmarkerat. Ska du hänga tungt i gipsvägg, eller sätta
          upp ett tv-fäste på gipsvägg med svängarm, går vår gräns vid 20 kg.
        </p>
      </div>

      {
        huvudbild && (
          <div class="lg:col-span-5">
            <img
              src={huvudbild.src}
              alt=""
              width={huvudbild.width}
              height={huvudbild.height}
              fetchpriority="high"
              decoding="async"
              class:list={['block h-auto w-full', !varumarke && 'rounded-sm border border-linje']}
            />
          </div>
        )
      }
    </section>

    <Faktaruta variant="kortsvar">
      <p class="m-0 leading-6">Väg saken och dela vikten på antalet infästningar.</p>
      <p class="m-0 leading-6">Under {XKROK_KG} kg per punkt räcker en X-krok eller en klisterremsa.</p>
      <p class="m-0 leading-6">Upp till 8 kg per punkt tar en självborrande plugg i skivan.</p>
      <p class="m-0 leading-6">
        Väger saken över <Markering>20 kg</Markering> ska den i regeln eller i en kortling.
      </p>
      <p class="m-0 leading-6">Ett fäste med svängarm och ett skåp med lucka ska alltid i regeln.</p>
    </Faktaruta>

    <div class="linjerat mt-8 lg:grid lg:grid-cols-2 lg:gap-8">
      {/* Formuläret ligger i src/components/kalkyl/GipspluggForm.astro, så att
          <Kalkylator namn="gipsplugg" /> i artikeln visar exakt samma fält. */}
      <GipspluggForm indata={indata} varden={varden} fel={fel} />

      <div class="mt-8 border-t border-linje pt-6 lg:mt-0 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8">
        {
          visat.status === 'ok' && (
            <>
              {resultat.status === 'ogiltig' && (
                <p class="m-0 mb-2 text-liten text-varning">Visar standardvärden tills indatan är rättad.</p>
              )}
              <p class="m-0 text-etikett lg:text-etikett-lg uppercase text-blyerts-2">
                {SAK_TEXT[visatIndata.sak]} på {talText(visatIndata.viktKg)} kg, {SKIVA_TEXT[visatIndata.skiva]}
              </p>
              <p class="m-0 mt-1 flex flex-wrap items-baseline gap-x-2">
                <span class="font-serif text-siffra lg:text-siffra-lg text-blyerts">
                  <Markering>{visat.svarOrd}</Markering>
                </span>
                <span class="text-ingress lg:text-ingress-lg">{visat.svarRest}</span>
              </p>
              <p class="m-0 mt-2 text-liten text-blyerts-2">
                {punktText(visatIndata.punkter)}, {REGEL_TEXT[visatIndata.regel]}
              </p>

              <div class="mt-4 border-t border-linje pt-4">
                <p class="m-0 text-etikett lg:text-etikett-lg uppercase text-blyerts-2">Last per infästningspunkt</p>
                <p class="m-0 mt-1 flex flex-wrap items-baseline gap-x-2">
                  <span class="font-serif text-h1 lg:text-h1-lg text-blyerts tabular-nums">
                    {talText(visat.lastPerPunktKg)}
                  </span>
                  <span class="text-ingress lg:text-ingress-lg">kg på varje punkt som bär</span>
                </p>
                <p class="m-0 mt-2 text-brod">{visat.lastText}</p>
              </div>

              <p class="m-0 mt-4 text-brod">{visat.svarText}</p>

              {/* Tabellen: infästningarna som gäller för den här saken, enklast
                  först. Det som inte räcker står kvar gråmarkerat, så att
                  läsaren ser hur långt ifrån det är. */}
              <p class="m-0 mt-6 text-etikett lg:text-etikett-lg uppercase text-blyerts-2">
                Infästningar i {SKIVA_TEXT[visatIndata.skiva]}
              </p>
              <Tabellyta kolumner={3} class="mt-2">
                <table class="w-full border-collapse text-liten tabular-nums">
                  <caption class="sr-only">
                    Infästningar som klarar {talText(visat.lastPerPunktKg)} kg per punkt, enklast först
                  </caption>
                  <thead>
                    <tr class="border-b border-linje text-left">
                      <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">
                        Infästning
                      </th>
                      <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2 whitespace-nowrap">
                        Last, kg
                      </th>
                      <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2 whitespace-nowrap">
                        Räcker
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    {visat.infastningar.map((rad) => (
                      <tr class:list={[!rad.klarar && 'text-blyerts-2']}>
                        <th scope="row" class:list={[CELL_KLASS, 'text-left font-normal', !rad.klarar && 'text-blyerts-2']}>
                          {rad.namn}
                          {rad.anm && <span class="block text-blyerts-2">{rad.anm}</span>}
                        </th>
                        <td class:list={[CELL_KLASS, !rad.klarar && 'text-blyerts-2']}>{talText(rad.kapacitetKg ?? 0)}</td>
                        <td class:list={[CELL_KLASS, !rad.klarar && 'text-blyerts-2']}>{rad.klarar ? 'Ja' : 'Nej'}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </Tabellyta>
              <p class="m-0 mt-2 text-liten text-blyerts-2">
                Tillverkarens rekommenderade last per infästning, inte brottlast. Källor:{' '}
                {tabellKallor.map((k, i) => (
                  <>
                    {i > 0 && ', '}
                    <a href={k.url} rel="nofollow" class={LANK_KLASS}>
                      {k.kalla}
                    </a>
                  </>
                ))}
                .
              </p>
              {visat.ingenKlarar && (
                <p class="m-0 mt-2 text-brod text-varning">
                  Ingen rad i tabellen är märkt för lasten per punkt. Fler infästningspunkter sänker lasten, men över
                  vår gräns hjälper det inte: då ska saken i regeln eller i en kortling.
                </p>
              )}
              {visat.utelamnade && <p class="m-0 mt-2 text-liten text-blyerts-2">{visat.utelamnade}</p>}

              {/* "Gör inte det här" står som eget H2 under verktyget.
                  Infästningstabellen är själva svaret och stannar i spalten. */}
              {visat.gorInteDetHar.length > 0 && (
                <p class="m-0 mt-4 text-liten text-blyerts-2">
                  Vad du inte ska göra{' '}
                  <a href="#gor-inte-det-har" class={LANK_KLASS}>står under verktyget</a>.
                </p>
              )}

              <p class="m-0 mt-4">
                <a href="#sa-bedomer-vi" class:list={['inline-flex min-h-11 items-center', LANK_KLASS]}>
                  Så bedömer vi
                </a>
              </p>

              {/* Dela. Svaret står i adressen, så ett skrivskyddat fält räcker:
                  markera och kopiera fungerar utan en rad JavaScript. */}
              <div class="mt-4 border-t border-linje pt-4">
                <label for="dela" class={ETIKETT_KLASS}>
                  Dela svaret
                </label>
                <input id="dela" type="text" readonly value={delaLank} class:list={[FALT_KLASS, 'border-blyerts-2']} />
                <p class="m-0 mt-1 text-liten text-blyerts-2">Adressen innehåller dina värden. Markera och kopiera.</p>
              </div>
            </>
          )
        }
      </div>
    </div>

    {/* Råden står i läsbredd direkt under verktyget, inte i spalten: en läsare
        som just fått ett besked läser svaret, inte motiveringarna bredvid
        formuläret. Se SPEC-SIDMALLAR.md 4.7. */}
    {
      visat.status === 'ok' && visat.gorInteDetHar.length > 0 && (
        <section>
          <Pennstreck id="gor-inte-det-har">Gör inte det här</Pennstreck>
          {visat.gorInteDetHar.map((rad, i) => (
            <p class:list={['m-0 text-brod lg:text-brod-lg', i > 0 && 'mt-4']}>{rad}</p>
          ))}
        </section>
      )
    }

    <section>
      <Pennstreck id="plugg-i-gipsvagg">Plugg i gipsvägg, vad gipspluggen bär och var gränsen går</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        En gipsskiva bär mer än folk tror och mycket mindre än de hoppas. Vad som avgör är sällan hur tung saken är,
        utan hur tung den är per skruv. En vägghylla på 80 cm väger några kilo tom. Fyll den med kokböcker och du ligger
        på 25 kg. Hänger den i fyra punkter blir det ändå drygt 6 kg på varje. Gipstillverkaren Norgips sätter gränsen
        för en skruv med plugg direkt i skivan vid som mest {NORGIPS_SKIVAN_KG}&nbsp;kg, och där är hyllan fortfarande
        inom vad väggen klarar.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Två avstånd följer med varje plugg. Två infästningar ska aldrig sitta tätare än {MIN_AVSTAND_MM}&nbsp;mm från
        varandra, och ska var och en bära sin maxlast vill Norgips att du går upp till {MAXLAST_AVSTAND_MM}&nbsp;mm.
        Skälet är att pluggarna delar på samma gips. Sätter du fyra pluggar inom en handflata bryter de loss ett enda
        stycke skiva tillsammans, oavsett vad var och en var märkt för.
      </p>

      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">Hänga tungt i gipsvägg utan att öppna väggen</h3>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Det andra skivlaget är värt mer än pluggen. Samma molly går från 38 till 70 kilo bara för att det finns dubbelt
        så mycket gips att ta spjärn mot, enligt tidningen Gör Det Själv. Det är därför verktyget frågar efter
        tjockleken innan det svarar, och det är därför en plugg gjord för ett lag är fel i en dubbelgipsad vägg: den når
        aldrig igenom och viker därför aldrig ut sig. Skruva loss ett eluttag, med strömmen bruten, och mät tjockleken i
        kanten på hålet.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Vår gräns går ändå vid {GRANS_REGEL_KG}&nbsp;kg. Över den ska saken sitta i regeln bakom gipset, alltså den
        lodräta trä- eller stålbiten som skivan är skruvad fast i, eller i en kortling, en kort träbit som sätts in
        vågrätt mellan två reglar. Pluggarna i tabellen är märkta för mer än så, men tillverkarens tal gäller en vikt
        som hänger stilla i en hel skiva. Gränsen är vår, den är medvetet försiktig, och den gäller tills vi har
        belastat pluggarna själva.
      </p>

      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">Tv-fäste på gipsvägg, armen ändrar räkningen</h3>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Sitter tv:n platt mot väggen är vikten sällan det som avgör. Borra fästplattan så att skruvarna går in i två
        reglar och använd träskruv, så är du klar. Problemet är fästena med arm. Dra ut tv:n en halvmeter från väggen
        och vikten hänger inte längre rakt ner, den bänder: den övre skruvraden dras utåt ur väggen medan den nedre
        pressas in.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Ingen tillverkare vi hittat anger hur mycket armen ökar lasten i den övre raden. Verktyget räknar därför med
        vårt eget antagande, att den raden ensam får bära hela vikten gånger {komma(SVANGARM_FAKTOR)}, och talet står
        märkt som ett antagande i tabellen längre ner. Beskedet blir ändå detsamma vilken faktor vi väljer: ett fäste
        med svängarm skruvas i regeln, aldrig i en plugg. Träffar du inte två reglar öppnar du väggen och sätter en
        kortling. Faller en tv framåt gör den det över soffan.
      </p>
    </section>

    <section>
      <Pennstreck id="sa-bedomer-vi">Så bedömer vi</Pennstreck>
      {
        varumarke && illustration && (
          <Illustration
            namn="rakna/gipsplugg"
            alt="Genomskärning av en gipsvägg på 12,5 millimeter med hålrum bakom, en plugg som viker ut sina armar mot skivans baksida och en vikt som hänger i skruven."
            bildtext="Det verktyget bedömer: skivans tjocklek, vikten per infästning och pluggens armar."
          />
        )
      }
      <ol class="m-0 mt-4 pl-6 list-decimal text-brod lg:text-brod-lg">
        <li class="mb-2">Vikten delas på de infästningspunkter som faktiskt bär lasten.</li>
        <li class="mb-2">
          En hylla och ett skåp får hela lasten på den övre raden, eftersom de vrider sig ut från väggen. Vi räknar den
          raden som halva antalet punkter, avrundat nedåt.
        </li>
        <li class="mb-2">
          Ett tv-fäste med svängarm multipliceras dessutom med {komma(SVANGARM_FAKTOR)} innan lasten delas. Det är vår
          hävarmsregel, inte en tillverkares.
        </li>
        <li class="mb-2">
          Väger saken mer än {GRANS_REGEL_KG}&nbsp;kg blir svaret regel eller kortling, oavsett vad tabellen säger.
          Samma sak gäller allt som sitter på en arm eller skiftar, alltså svängarmen och skåpet med lucka.
        </li>
        <li class="mb-2">
          Sedan prövas lasten per punkt mot varje infästning som finns angiven för den skiva du valt. Raden som inte når
          upp står kvar i grått, så att du ser hur långt ifrån den är.
        </li>
        <li class="mb-2">
          Krokar och klisterremsor gäller bara en tavla eller en spegel. En hyllkonsol eller ett tv-fäste skruvas fast
          och kan inte hänga i en krok.
        </li>
        <li class="mb-2">
          I tak räknar vi bara infästningar som viker ut sig bakom skivan, och varje tillverkarvärde kapas där vid{' '}
          {TAK_MAX_KG}&nbsp;kg per fästpunkt enligt Norgips.
        </li>
        <li>
          Räcker ingen infästning i din skiva blir svaret kortling. Fler punkter sänker lasten per punkt, och det är
          ofta den enklaste vägen.
        </li>
      </ol>

      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">Vad siffrorna vilar på</h3>
      <Tabellyta kolumner={3} class="mt-4">
        <table class="w-full border-collapse text-liten tabular-nums">
          <caption class="sr-only">Tillverkarvärden, källor och antaganden i pluggväljaren för gipsvägg</caption>
          <thead>
            <tr class="border-b border-linje text-left">
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Infästning eller regel</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Vi går på</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Källa eller antagande</th>
            </tr>
          </thead>
          <tbody>
            {
              antaganden.map((a) => (
                <tr>
                  <th scope="row" class:list={[CELL_KLASS, 'text-left font-normal']}>
                    {a.storhet}
                  </th>
                  <td class={CELL_KLASS}>{a.varde}</td>
                  <td class={CELL_KLASS}>
                    {a.grund}.{' '}
                    {a.url ? (
                      <a href={a.url} rel={a.url.startsWith('/') ? undefined : 'nofollow'} class={LANK_KLASS}>
                        {a.stod}
                      </a>
                    ) : (
                      a.stod
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </Tabellyta>

      <p class="m-0 mt-6 text-brod lg:text-brod-lg">
        Talen i tabellen är tillverkarnas och leverantörernas rekommenderade last per infästning, inte brottlast. De
        gäller en plugg i taget, i en hel skiva, med en vikt som hänger stilla. Tidningen Gör Det Själv skriver själv
        att vikterna varierar mellan tillverkare och ska ses som vägledande, och läser du något annat på förpackningen
        du håller i handen ska du tro på förpackningen.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Vi bygger en vägg med 13 mm skiva och drar åtta pluggtyper till brott med hängvåg i vinter. Då får du både
        brottlasten och den last där skivan börjar ge sig, och de talen ersätter tillverkarnas här. Tills dess står
        ingen egen siffra i verktyget. Metoden bakom våra siffror står på{' '}
        <a href="/om/sa-testar-vi/" class={LANK_KLASS}>Så testar vi</a>.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Verktyget kan inte se din vägg. Det vet inte om skivan är skadad sedan förut, om hålet redan är urborrat eller
        om det ligger en elkabel bakom. Borra aldrig rakt över eller rakt under ett uttag eller en strömbrytare, och kör
        en regelsökare över ytan innan borren går i.
      </p>
    </section>

    <section>
      <Pennstreck id="las-vidare">Läs vidare</Pennstreck>
      <ul class="m-0 p-0 list-none">
        <li class="border-t border-linje">
          <a href="/inomhus/skruva-i-gipsvagg/" class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
            Skruva i gipsvägg, så sitter hyllan, tv:n och skåpet kvar
          </a>
        </li>
        <li class="border-t border-linje">
          <a href="/inomhus/hanga-tavla-gipsvagg/" class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
            Hänga tavla på gipsvägg, rätt krok för vikten och rätt höjd
          </a>
        </li>
        <li class="border-t border-linje">
          <a href="/inomhus/gipsskruv/" class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
            Gipsskruv i rätt längd och gänga, mot trä och mot stål
          </a>
        </li>
      </ul>
    </section>

    <Faq fragor={FRAGOR} />
  </div>
</Bas>
