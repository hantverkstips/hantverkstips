---
/**
 * Rotavdrag: hur mycket drar du av, och vad betalar du efteråt?
 * Formuläret skickas som GET till samma sida och räkningen sker på servern, så
 * sidan fungerar utan ett enda byte klient-JS. Kostnaden är en serverfunktion
 * per anrop, och den hålls nere med CDN-cache. Se docs/SPEC-SIDMALLAR.md
 * avsnitt 4.7.
 *
 * Formeln, reglerna och alla antaganden ligger i src/lib/kalkyl/rotavdrag.ts,
 * och källan bakom varje konstant står i
 * docs/briefer/underlag-kalkyl-rotavdrag-2026-09-20.md. Sidan räknar ingenting
 * själv, den visar bara svaret och redovisar källan bakom varje regel.
 *
 * SIDAN DÖPS OM VARJE DECEMBER. Årtalet står i ARET i formelmodulen, och
 * VERKTYGSNAMN, titel och H1 nedan bär det. I december varje år byts alla fyra
 * i samma commit, efter att procentsatsen och takbeloppen lästs om hos
 * Skatteverket. Adressen /rakna/rotavdrag/ ändras aldrig, så inkommande länkar
 * överlever årsskiftet och ingen omdirigering behövs. Rutinen står också i
 * kommentaren vid ARET.
 *
 * Räkningen pekar inte ut någon produkt, den räknar på en faktura läsaren redan
 * har, så sidan har varken produktkort eller reklamband.
 */
export const prerender = false;

import Bas from '../../layouts/Bas.astro';
import {
  ANSOKAN_SENAST,
  ARET,
  EXEMPEL_ARBETE_KR,
  EXEMPEL_AVDRAG_KR,
  EXEMPEL_BETALA_KR,
  GEMENSAMT_TAK_KR,
  HOJNINGEN_FRAN,
  HOJNINGEN_TILL,
  kronor,
  NYBYGGT_SPARRAR_AR,
  raknaRotavdrag,
  ROT_PROCENT,
  ROT_PROCENT_HOJT,
  ROT_TAK_KR,
  SKATTEVERKET_FORETAG,
  SKATTEVERKET_GER_RATT,
  SKATTEVERKET_HOJNINGEN,
  SKATTEVERKET_RAKNA,
  SKATTEVERKET_ROT_OCH_RUT,
  SKATTEVERKET_ROTAVDRAGET,
  SKATTEVERKET_SKATTEN,
  SKV_EXEMPEL_ARBETE_EXKL_MOMS_KR,
  SKV_EXEMPEL_ARBETE_INKL_MOMS_KR,
  SKV_EXEMPEL_AVDRAG_KR,
  STANDARD,
  tolkaQuery,
  type RotavdragIndata,
  type RotavdragResultat,
  type Slag,
} from '../../lib/kalkyl/rotavdrag';
import { CELL_KLASS, ETIKETT_KLASS, FALT_KLASS, LANK_KLASS } from '../../lib/kalkyl/stil';
import { verktyg } from '../../lib/strukturdata';
import { verktygsDelningsbild, verktygsillustration, verktygsVarumarkesbild } from '../../lib/verktygsbild';
import RotavdragForm from '../../components/kalkyl/RotavdragForm.astro';
import Faktaruta from '../../components/ui/Faktaruta.astro';
import Faq from '../../components/ui/Faq.astro';
import Illustration from '../../components/ui/Illustration.astro';
import Markering from '../../components/ui/Markering.astro';
import Pennstreck from '../../components/ui/Pennstreck.astro';
import StrukturData from '../../components/ui/StrukturData.astro';
import Tabellyta from '../../components/ui/Tabellyta.astro';

Astro.locals.sidtyp = 'verktyg';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

const q = Astro.url.searchParams;
const { indata } = tolkaQuery(q);
const resultat = raknaRotavdrag(indata);

const fel = resultat.status === 'ogiltig' ? resultat.fel : {};
// Vid ogiltig indata visas standardvärdenas svar, med en rad som säger det.
const visat: RotavdragResultat = resultat.status === 'ogiltig' ? raknaRotavdrag(STANDARD) : resultat;
const visatIndata: RotavdragIndata = resultat.status === 'ogiltig' ? STANDARD : indata;

const komma = (n: number) => String(n).replace('.', ',');

/**
 * Fältens värden kommer från query-strängen som den skrevs, inte från de
 * tolkade talen: "mycket" blir NaN i tolkaQuery, och NaN i ett fält som
 * läsaren ska rätta är obrukbart.
 */
function faltVarde(nyckel: string, standardVarde: number): string {
  const ra = q.get(nyckel);
  if (ra !== null) return ra;
  return standardVarde === 0 ? '' : komma(standardVarde);
}

const varden = {
  arbete: faltVarde('arbete', STANDARD.arbetskostnadKr),
  material: faltVarde('material', STANDARD.materialkostnadKr),
  rot: faltVarde('rot', STANDARD.utnyttjatRotKr),
  rut: faltVarde('rut', STANDARD.utnyttjatRutKr),
  skatt: q.get('skatt') ?? (STANDARD.skattKr === null ? '' : komma(STANDARD.skattKr)),
};

/**
 * Delbar länk. Hela frågan ligger redan i query-strängen, så adressen är
 * svaret. Den byggs av de tolkade värdena, inte av strängen läsaren skrev,
 * och varje val skrivs ut, även de som kom från standardvalet.
 */
const delaQuery = new URLSearchParams({
  arbete: komma(visatIndata.arbetskostnadKr),
  material: komma(visatIndata.materialkostnadKr),
  agare: String(visatIndata.antalAgare),
  rot: komma(visatIndata.utnyttjatRotKr),
  rut: komma(visatIndata.utnyttjatRutKr),
  skatt: visatIndata.skattKr === null ? '' : komma(visatIndata.skattKr),
});
const delaLank = new URL(`/rakna/rotavdrag/?${delaQuery.toString()}`, Astro.site ?? Astro.url).toString();

/** Etiketten på varje rad i "Därför blev svaret så". */
const SLAG_ETIKETT: Record<Slag, string> = {
  arbete: 'Arbetet',
  procent: 'Procentsatsen',
  datum: 'Datumet',
  tak: 'Gränsen',
  skatt: 'Skatten',
};

const SLAG_RAM: Record<Slag, string> = {
  arbete: 'border-blyerts',
  procent: 'border-blyerts',
  datum: 'border-varning',
  tak: 'border-blyerts-2',
  skatt: 'border-blyerts-2',
};

/** Slug, namn och beskrivning på ett ställe: brödsmulan, og:image och WebApplication läser samma. */
const SLUG = 'rotavdrag';
const VERKTYGSNAMN = `Rotavdrag ${ARET}`;
const BESKRIVNING = `Fyll i vad arbetet kostar på fakturan, så ser du hur stort rotavdraget ${ARET} blir, vad du betalar efteråt och hur mycket av årets avdrag du har kvar.`;
const titel = `Rotavdrag ${ARET}, räkna ut avdraget och vad du betalar`;

const illustration = verktygsillustration(SLUG);
/**
 * Varumärkesbilden i sidhuvudet (docs/DESIGN.md avsnitt 7). Finns den står
 * skissen i stället i "Så räknar vi". Finns den inte visas skissen i
 * sidhuvudet, och saknas båda visas ingen bild alls.
 */
const varumarke = verktygsVarumarkesbild(SLUG);
const huvudbild = varumarke ?? illustration;

/** Källorna bakom antagandetabellen, samlade så att raderna inte glider isär. */
const antaganden: { storhet: string; varde: string; grund: 'Källa' | 'Antagande'; stod: string; url?: string }[] = [
  {
    storhet: 'Procentsats',
    varde: `${ROT_PROCENT} % av arbetskostnaden`,
    grund: 'Källa',
    stod: 'Skatteverket, så fungerar rotavdraget: företaget får dra av högst 30 procent av arbetskostnaden på fakturan',
    url: SKATTEVERKET_ROTAVDRAGET,
  },
  {
    storhet: 'Den tillfälligt höjda nivån',
    varde: `${ROT_PROCENT_HOJT} %`,
    grund: 'Källa',
    stod: `Skatteverket: höjningen gällde färdiga arbeten där kunden betalade fakturan mellan ${HOJNINGEN_FRAN} och ${HOJNINGEN_TILL}`,
    url: SKATTEVERKET_HOJNINGEN,
  },
  {
    storhet: 'Dagen som daterar avdraget',
    varde: 'Betalningsdagen',
    grund: 'Källa',
    stod: `Skatteverket skriver att din betalning styr vilket år avdraget hamnar på, inte fakturans datum. Arbetet ska vara klart, och företagets begäran om utbetalning ska vara inne senast den ${ANSOKAN_SENAST}`,
    url: SKATTEVERKET_ROTAVDRAGET,
  },
  {
    storhet: 'Momsen i räkneexemplen',
    varde: `${kronor(SKV_EXEMPEL_AVDRAG_KR)} kr hos Skatteverket, ${kronor(EXEMPEL_AVDRAG_KR)} kr i mitt exempel`,
    grund: 'Källa',
    stod: `Skatteverkets eget exempel står på företagssidan och utgår från ${kronor(SKV_EXEMPEL_ARBETE_EXKL_MOMS_KR)} kr utan moms, alltså ${kronor(SKV_EXEMPEL_ARBETE_INKL_MOMS_KR)} kr med moms. Fältet här vill ha beloppet med moms, så skriv in det större talet`,
    url: SKATTEVERKET_FORETAG,
  },
  {
    storhet: 'Nybyggt hus',
    varde: `${NYBYGGT_SPARRAR_AR} år`,
    grund: 'Källa',
    stod: 'Skatteverket: ombyggnad och tillbyggnad ger inget avdrag de första fem åren efter det år huset stod färdigt. Reparation och underhåll ger avdrag oavsett husets ålder',
    url: SKATTEVERKET_ROTAVDRAGET,
  },
  {
    storhet: 'Gräns per person och år',
    varde: `${kronor(ROT_TAK_KR)} kr`,
    grund: 'Källa',
    stod: 'Skatteverket: av de 75 000 kronorna får högst 50 000 kronor vara rotavdrag',
    url: SKATTEVERKET_ROTAVDRAGET,
  },
  {
    storhet: 'Gemensam gräns för rot och rut',
    varde: `${kronor(GEMENSAMT_TAK_KR)} kr`,
    grund: 'Källa',
    stod: 'Skatteverket: rot och rut räknas ihop och får tillsammans vara högst 75 000 kronor per person och år',
    url: SKATTEVERKET_ROT_OCH_RUT,
  },
  {
    storhet: 'Flera ägare',
    varde: 'En gräns var',
    grund: 'Källa',
    stod: 'Skatteverket: äger flera personer fastigheten kan de dela på avdraget, men aldrig så att det blir mer än procentsatsen på hela arbetskostnaden',
    url: SKATTEVERKET_ROTAVDRAGET,
  },
  {
    storhet: 'Skatten som gräns',
    varde: 'Årets skatt',
    grund: 'Källa',
    stod: 'Skatteverket: avdraget räknas av mot kommunal och statlig inkomstskatt, statlig fastighetsskatt och kommunal fastighetsavgift',
    url: SKATTEVERKET_SKATTEN,
  },
  {
    storhet: 'Material och resor',
    varde: 'Inget avdrag',
    grund: 'Källa',
    stod: 'Skatteverket: det är bara arbetskostnaden som ger rätt till rotavdrag',
    url: SKATTEVERKET_ROTAVDRAGET,
  },
  {
    storhet: 'Maskinell utrustning',
    varde: 'Inget avdrag',
    grund: 'Källa',
    stod: 'Skatteverket, ger arbetet rätt till rotavdrag: att betala för maskinell utrustning, till exempel grävmaskiner eller borraggregat, ger inget avdrag',
    url: SKATTEVERKET_GER_RATT,
  },
  {
    storhet: 'Krav på dig',
    varde: 'Äga och bo',
    grund: 'Källa',
    stod: 'Skatteverket: du ska äga bostaden medan arbetet görs, bo i den eller låta en förälder göra det, och betala med kort eller överföring',
    url: SKATTEVERKET_ROTAVDRAGET,
  },
  {
    storhet: 'Skattefältet',
    varde: 'En förenkling',
    grund: 'Antagande',
    stod: 'Skatteverkets gräns är den slutliga skatten efter jobbskatteavdrag, allmän pensionsavgift och underskott av kapital. Fältet frågar efter den preliminära skatten, för det är det tal du faktiskt har, och svaret blir därför något generöst. Ligger du nära gränsen, räkna i Skatteverkets e-tjänst',
    url: SKATTEVERKET_RAKNA,
  },
  {
    storhet: 'Antal ägare från början',
    varde: 'En ägare',
    grund: 'Antagande',
    stod: 'Mitt val, och det försiktiga. Två ägare får dra av dubbelt så mycket, och ett verktyg som antar två skulle visa ett avdrag den som äger ensam aldrig får',
  },
  {
    storhet: 'Det ni redan använt',
    varde: 'Summan för alla ägare',
    grund: 'Antagande',
    stod: 'Fälten frågar efter summan för dem som delar, eftersom gränsen i verktyget också räknas för dem tillsammans',
  },
  {
    storhet: 'Fältens gränser',
    varde: 'Fem miljoner kr, fyra ägare',
    grund: 'Antagande',
    stod: 'Ett stopp för skrivfel, inga regler. Skatteverket sätter ingen gräns för hur många som får äga',
  },
  {
    storhet: 'Din egen uträkning',
    varde: 'Skatteverkets e-tjänst',
    grund: 'Källa',
    stod: 'Skatteverket har en egen räknare, och det är den som gäller när ditt fall är ovanligt',
    url: SKATTEVERKET_RAKNA,
  },
];

/** Frågorna sist på sidan. Talen är desamma som i brödtexten och i tabellen. */
const FRAGOR = [
  {
    fraga: `Hur mycket är rotavdraget ${ARET}?`,
    svar: `Hantverkaren drar av ${ROT_PROCENT} procent av arbetskostnaden på fakturan, och du får högst ${kronor(ROT_TAK_KR)} kronor i rotavdrag per person och år. Rot och rut räknas ihop och får tillsammans inte gå över ${kronor(GEMENSAMT_TAK_KR)} kronor per person och år, så har ni haft städhjälp eller en flyttfirma med rutavdrag i år är det mindre kvar. Avdraget kan heller aldrig bli större än skatten du betalar in under året. Material, resor och maskinhyra ger ingenting, och är huset yngre än ${NYBYGGT_SPARRAR_AR} år ger ombyggnad inget avdrag alls.`,
  },
  {
    fraga: `Varför får jag inte ${ROT_PROCENT_HOJT} procent?`,
    svar: `Den nivån var tillfällig. ${ROT_PROCENT_HOJT} procent gällde färdiga arbeten där fakturan betalades mellan ${HOJNINGEN_FRAN} och ${HOJNINGEN_TILL}, och det är betalningen som räknas. En faktura som skrevs i december och betalades i januari får alltså den lägre procentsatsen, vad det än står för datum på pappret. Betalar du i dag gäller ${ROT_PROCENT} procent.`,
  },
  {
    fraga: 'Räknas material med i rotavdraget?',
    svar: 'Nej. Bara arbetet ger avdrag, och det är därför fakturan ska ha arbete och material på olika rader. Maskiner är dessutom undantagna med namn hos Skatteverket, alltså grävmaskiner, borraggregat och liknande. På ett markjobb kan maskinen vara en stor del av det som ser ut som arbete, och räknar du procentsatsen på hela den posten räknar du för högt.',
  },
  {
    fraga: 'Kan vi dela på rotavdraget när vi äger huset ihop?',
    svar: `Ja, och det är oftast så ett större jobb ryms på ett år. Varje ägare har en egen gräns på ${kronor(ROT_TAK_KR)} kronor, så två ägare får tillsammans dra av ${kronor(ROT_TAK_KR * 2)} kronor. Villkoret är att båda äger bostaden medan arbetet görs och att båda är med och betalar. Hur många ni än är kan avdraget aldrig bli mer än ${ROT_PROCENT} procent av hela arbetskostnaden.`,
  },
];
---

<Bas
  title={titel}
  description={BESKRIVNING}
  reklam={false}
  brodsmulor={[
    { namn: 'Hantverkstips', href: '/' },
    { namn: 'Räkna själv', href: '/rakna/' },
    { namn: VERKTYGSNAMN },
  ]}
  bred={true}
  ogBild={verktygsDelningsbild(SLUG)}
>
  <StrukturData
    slot="head"
    data={verktyg({ url: `/rakna/${SLUG}/`, namn: VERKTYGSNAMN, beskrivning: BESKRIVNING })}
  />

  <div class="mx-auto w-full max-w-lasbredd">
    {/*
      Sidhuvudet: rubrik och ingress till vänster i 7/12, bilden till höger i
      5/12 på desktop, under ingressen på mobil. Bilden är dekorativ, H1 bär
      betydelsen, därför tom alt. Den är sidans LCP-bild och laddas därför
      eagert med fetchpriority.
    */}
    <section class="grid grid-cols-1 items-center gap-6 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7">
        <h1 class="m-0 font-serif text-h1 lg:text-h1-lg">
          Rotavdrag {ARET}, så mycket drar hantverkaren av och så mycket betalar du
        </h1>
        <p class="m-0 mt-4 text-ingress lg:text-ingress-lg">
          Hantverkaren drar av {ROT_PROCENT} procent av det arbetet kostar, och bara av det. Sedan finns tre gränser
          som kan göra avdraget mindre: {kronor(ROT_TAK_KR)} kronor per person och år, den gemensamma gränsen för rot
          och rut, och skatten du själv betalar in under året. Fyll i fakturan, så ser du hur mycket du får tillbaka,
          vilken gräns som gäller dig och vad du får kvar att betala.
        </p>
      </div>

      {
        huvudbild && (
          <div class="lg:col-span-5">
            <img
              src={huvudbild.src}
              alt=""
              width={huvudbild.width}
              height={huvudbild.height}
              fetchpriority="high"
              decoding="async"
              class:list={['block h-auto w-full', !varumarke && 'rounded-sm border border-linje']}
            />
          </div>
        )
      }
    </section>

    <Faktaruta variant="kortsvar">
      <p class="m-0 leading-6">
        Hantverkaren drar av <Markering>{ROT_PROCENT} procent av arbetskostnaden</Markering> direkt på fakturan.
      </p>
      <p class="m-0 leading-6">Material, resor och maskinhyra ger inget avdrag alls.</p>
      <p class="m-0 leading-6">
        Du får högst {kronor(ROT_TAK_KR)} kr per person och år, och rot och rut får tillsammans inte gå över{' '}
        {kronor(GEMENSAMT_TAK_KR)} kr.
      </p>
      <p class="m-0 leading-6">Det är dagen du betalar som avgör vilken procentsats du får.</p>
    </Faktaruta>

    <div class="linjerat mt-8 lg:grid lg:grid-cols-2 lg:gap-8">
      {/* Formuläret ligger i src/components/kalkyl/RotavdragForm.astro, så att
          <Kalkylator namn="rotavdrag" /> i en artikel visar exakt samma fält. */}
      <RotavdragForm indata={indata} varden={varden} fel={fel} />

      <div class="mt-8 border-t border-linje pt-6 lg:mt-0 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8">
        {
          visat.status === 'ok' && (
            <>
              {resultat.status === 'ogiltig' && (
                <p class="m-0 mb-2 text-liten text-varning">Ett av fälten gick inte att läsa, så jag visar standardvärdena tills du rättat det.</p>
              )}
              {/* Spalten bär svaret: beskedet, talet och länkarna. Reglerna med
                  källa och "Gör inte det här" står som egna H2 under verktyget. */}
              <p class="m-0 font-sans text-h3 lg:text-h3-lg font-bold text-blyerts">{visat.beskedRubrik}</p>
              <p class="m-0 mt-1 text-brod">{visat.beskedRad}</p>

              <p class="m-0 mt-6 text-etikett lg:text-etikett-lg uppercase text-blyerts-2">Ditt rotavdrag</p>
              {/* Det stora talet är avdraget, med resten av svaret på samma
                  baslinje där enheten står på de andra kalkylatorerna. */}
              <p class="m-0 mt-1 flex flex-wrap items-baseline gap-x-2">
                <span class="font-serif text-siffra lg:text-siffra-lg text-blyerts">
                  <Markering>{kronor(visat.avdragKr)}</Markering>
                </span>
                <span class="text-ingress lg:text-ingress-lg">kr dras av på fakturan</span>
              </p>
              <p class="m-0 mt-2 text-liten text-blyerts-2">
                Räknat på {kronor(visatIndata.arbetskostnadKr)}&nbsp;kr i arbete och{' '}
                {visatIndata.antalAgare === 1 ? 'en ägare' : `${visatIndata.antalAgare} ägare`}.
              </p>

              <ul class="m-0 mt-4 p-0 list-none text-brod tabular-nums">
                <li class="border-t border-linje py-2">
                  Du betalar {kronor(visat.attBetalaKr)}&nbsp;kr av fakturans {kronor(visat.fakturaKr)}&nbsp;kr.
                </li>
                {visat.utanAvdragKr > 0 && (
                  <li class="border-t border-linje py-2">
                    Utanför avdraget ligger {kronor(visat.utanAvdragKr)}&nbsp;kr, alltså{' '}
                    {visat.andelUtanAvdragProcent} procent av fakturan.
                  </li>
                )}
                <li class="border-t border-linje py-2">
                  Av årets rotavdrag på {kronor(visat.rotTakTotaltKr)}&nbsp;kr har ni {kronor(visat.kvarRotTakKr)}
                  &nbsp;kr kvar.
                </li>
                <li class="border-t border-linje py-2">
                  Av den gemensamma gränsen för rot och rut har ni {kronor(visat.kvarGemensamtKr)}&nbsp;kr kvar.
                </li>
              </ul>

              <p class="m-0 mt-4 text-liten text-blyerts-2">
                Reglerna bakom svaret, med källa, och det du inte ska göra{' '}
                <a href="#darfor-blev-svaret-sa" class={LANK_KLASS}>står under verktyget</a>.
              </p>

              <p class="m-0 mt-4">
                <a href="#sa-raknar-vi" class:list={['inline-flex min-h-11 items-center', LANK_KLASS]}>
                  Så räknar jag
                </a>
              </p>

              {/* Dela. Svaret står i adressen, så ett skrivskyddat fält räcker:
                  markera och kopiera fungerar utan en rad JavaScript. */}
              <div class="mt-4 border-t border-linje pt-4">
                <label for="dela" class={ETIKETT_KLASS}>
                  Dela svaret
                </label>
                <input id="dela" type="text" readonly value={delaLank} class:list={[FALT_KLASS, 'border-blyerts-2']} />
                <p class="m-0 mt-1 text-liten text-blyerts-2">Dina värden ligger i adressen. Markera den och kopiera, så får den du skickar till samma svar.</p>
              </div>
            </>
          )
        }
      </div>
    </div>

    {
      visat.status === 'ok' && (
        <>
          <section>
            <Pennstreck id="darfor-blev-svaret-sa">Därför blev svaret så</Pennstreck>
            <p class="m-0 mb-4 text-brod lg:text-brod-lg">
              Varje rad här är en regel hos Skatteverket, och länken går till sidan där regeln står.
            </p>
            <ul class="m-0 p-0 list-none text-brod lg:text-brod-lg">
              {visat.regler.map((regel) => (
                <li class:list={['mb-4 border-l-2 pl-4', SLAG_RAM[regel.slag]]}>
                  <span class="block text-etikett lg:text-etikett-lg uppercase text-blyerts-2">
                    {SLAG_ETIKETT[regel.slag]}
                  </span>
                  <span class="block">{regel.text}</span>
                  <span class="block text-liten text-blyerts-2">
                    <a href={regel.url} rel="nofollow" class={LANK_KLASS}>
                      {regel.kalla}
                    </a>
                  </span>
                </li>
              ))}
            </ul>
          </section>

          <section>
            <Pennstreck id="gor-inte-det-har">Gör inte det här</Pennstreck>
            {visat.gorInteDetHar.map((rad, i) => (
              <p class:list={['m-0 text-brod lg:text-brod-lg', i > 0 && 'mt-4']}>{rad}</p>
            ))}
          </section>
        </>
      )
    }

    <section>
      <Pennstreck id="tre-tak">Tre gränser kan göra rotavdraget mindre än du räknat med</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        Själva procentsatsen är den lätta biten. Hantverkaren drar av {ROT_PROCENT} procent av arbetskostnaden på
        fakturan, du betalar resten, och företaget hämtar mellanskillnaden hos Skatteverket. Det kallas
        fakturamodellen, och det är därför du ser avdraget på notan och inte först i deklarationen.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Ett exempel med mina egna tal: kostar arbetet {kronor(EXEMPEL_ARBETE_KR)}&nbsp;kr med moms drar hantverkaren
        av {kronor(EXEMPEL_AVDRAG_KR)}&nbsp;kr, och du betalar {kronor(EXEMPEL_BETALA_KR)}&nbsp;kr. Så långt är det
        bara en procentsats. Det är de tre gränserna som gör att svaret ibland blir ett annat.
      </p>

      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">Så mycket får varje ägare dra av på ett år</h3>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Rotavdraget är högst {kronor(ROT_TAK_KR)}&nbsp;kr per person och år. Sedan räknas rot och rut ihop, och
        tillsammans får de inte gå över {kronor(GEMENSAMT_TAK_KR)}&nbsp;kr per person och år. Den andra gränsen är den
        som oftast blir fel. En av de stora sidorna om vad ett kök kostar att renovera anger{' '}
        {kronor(GEMENSAMT_TAK_KR)}&nbsp;kr som gränsen för rot, och för {ARET} stämmer det inte, för den summan är rot
        och rut tillsammans. Under 2024 fanns en tillfällig egen gräns för rot på just det beloppet, och jag gissar
        att det är därifrån talet lever kvar.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Skillnaden märks först när ni använt båda. Har ni haft städhjälp eller en flyttfirma med rutavdrag i år är
        det mindre kvar till hantverkaren, fast rotavdraget ser orört ut. Därför frågar verktyget efter de två
        beloppen var för sig. Det ni redan använt i rot räknas av från båda gränserna, medan rut bara räknas av från
        den gemensamma.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Äger ni bostaden tillsammans har ni en gräns var. Två ägare får alltså dra av {kronor(ROT_TAK_KR * 2)}
        &nbsp;kr i rot på ett år, och den skillnaden avgör ofta om ett större jobb ryms på ett år eller får delas på
        två. Villkoret är att båda äger bostaden medan arbetet görs och att båda är med och betalar.
      </p>

      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">Betalar du lite skatt blir avdraget litet</h3>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Rotavdraget är en skattereduktion. Det betyder att pengarna räknas av mot den skatt du betalar in under
        året, och finns det ingen skatt finns det inget att räkna av mot. Det som räknas är kommunal och statlig
        inkomstskatt, statlig fastighetsskatt och kommunal fastighetsavgift. Allmän pensionsavgift, begravningsavgift
        och kyrkoavgift räknas inte.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Skatteverket skriver själva att de inte kan säga exakt vilken inkomst som krävs för att få ut hela beloppet,
        eftersom det beror på vilken sorts inkomst du har, vad kommunalskatten är där du bor och om du har underskott
        av kapital. Därför är skattefältet i verktyget frivilligt, och därför står det i svaret att den gränsen inte
        är vägd när du lämnar fältet tomt. Är du pensionär, studerar eller är föräldraledig är det ofta skatten som
        stoppar först, inte gränsen per person.
      </p>

      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">
        Dagen du betalar avgör vilken procentsats du får
      </h3>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Under några månader var avdraget {ROT_PROCENT_HOJT} procent. Höjningen var tillfällig och gällde färdiga
        arbeten där kunden betalade fakturan mellan {HOJNINGEN_FRAN} och {HOJNINGEN_TILL}. Lägg märke till ordet
        betalade. Det är dagen pengarna går iväg som daterar avdraget, inte dagen fakturan skrevs. Arbetet ska
        dessutom vara klart, och företaget ska ha skickat in sin begäran om utbetalning senast den {ANSOKAN_SENAST}.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Samma regel gäller vid varje årsskifte, även när procentsatsen står still. Betalar du i januari hamnar
        avdraget på det nya årets gräns, betalar du i december på det gamla. Har du ett stort jobb på gång och nästan
        ingenting kvar av årets rotavdrag, fråga hantverkaren när fakturan förfaller innan ni sätter igång. Det är
        den enda planering i hela rotavdraget som faktiskt ger pengar.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Skatteverkets egen räknare finns i{' '}
        <a href={SKATTEVERKET_RAKNA} rel="nofollow" class={LANK_KLASS}>
          deras e-tjänst för rot och rut
        </a>
        . Är ditt fall ovanligt är det den som gäller, och då är det bra att förstå svaret här först.
      </p>
    </section>

    <section>
      <Pennstreck id="sa-raknar-vi">Så räknar jag</Pennstreck>
      {
        varumarke && illustration && (
          <Illustration
            namn="rakna/rotavdrag"
            alt="Skiss av en faktura med raderna arbete, material och maskinhyra, där bara arbetsraden är markerad som grund för avdraget"
            bildtext="Arbetsraden bär anteckningen 30 procent och ger avdraget. Material och maskinhyra är inringade med anteckningen räknas inte, och det är därför de ska stå på egna rader på fakturan."
          />
        )
      }
      <ol class="m-0 mt-4 pl-6 list-decimal text-brod lg:text-brod-lg">
        <li class="mb-2">
          Verktyget tar {ROT_PROCENT} procent av arbetskostnaden och avrundar till hel krona. Materialet rörs inte.
        </li>
        <li class="mb-2">
          Sedan räknar det ut hur mycket rotavdrag ni har kvar i år: {kronor(ROT_TAK_KR)} kr gånger antalet ägare,
          minus det ni redan använt i rot.
        </li>
        <li class="mb-2">
          Samma sak med den gemensamma gränsen: {kronor(GEMENSAMT_TAK_KR)} kr gånger antalet ägare, minus det ni
          använt i både rot och rut. Rutavdraget räknas alltså bara av här.
        </li>
        <li class="mb-2">
          Har du fyllt i skatten dras det ni redan använt bort från den också. Har du lämnat fältet tomt hoppar
          verktyget över steget och säger det i svaret.
        </li>
        <li class="mb-2">
          Avdraget blir det minsta av de fyra talen, och beskedet säger vilket av dem som satte stopp.
        </li>
        <li>Att betala är arbete plus material minus avdraget.</li>
      </ol>

      <p class="m-0 mt-6 text-brod lg:text-brod-lg">
        Alla tal om procentsats, gränser och datum kommer från Skatteverket, och varje rad i tabellen länkar till
        sidan där talet står. Det som är mitt eget är att verktyget börjar med en ägare, gränserna på fälten och
        förenklingen i skattefältet. De raderna är märkta Antagande.
      </p>

      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">Vad svaret vilar på</h3>
      <Tabellyta kolumner={3} class="mt-4">
        <table class="w-full border-collapse text-liten tabular-nums">
          <caption class="sr-only">Regler, gränser och antaganden i rotavdragskalkylatorn</caption>
          <thead>
            <tr class="border-b border-linje text-left">
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Vad</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Verktyget räknar med</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Källa eller antagande</th>
            </tr>
          </thead>
          <tbody>
            {
              antaganden.map((a) => (
                <tr>
                  <th scope="row" class:list={[CELL_KLASS, 'text-left font-normal']}>
                    {a.storhet}
                  </th>
                  <td class={CELL_KLASS}>{a.varde}</td>
                  <td class={CELL_KLASS}>
                    {a.grund}.{' '}
                    {a.url ? (
                      <a href={a.url} rel="nofollow" class={LANK_KLASS}>
                        {a.stod}
                      </a>
                    ) : (
                      a.stod
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
          <tfoot>
            <tr>
              <td colspan="3" class="p-2 text-liten text-blyerts-2">
                Procentsatsen och gränserna kan bytas varje år, och därför står årtalet i sidans rubrik. Raderna
                märkta Antagande är mina egna val, inte Skatteverkets regler.
              </td>
            </tr>
          </tfoot>
        </table>
      </Tabellyta>

      <p class="m-0 mt-6 text-brod lg:text-brod-lg">
        Två saker ser verktyget inte. Det ena är hur fakturan är uppdelad. Står maskinhyran inne i arbetsposten
        räknar verktyget på ett belopp som är för stort, och det är därför maskinen ska stå på en egen rad. Det
        andra är din slutskatt, som avgörs först i deklarationen. Svaret här är en uträkning och inget besked från
        Skatteverket.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Hur jag jobbar med tal och källor står på sidan{' '}
        <a href="/om/sa-testar-vi/" class={LANK_KLASS}>Så testar jag</a>.
      </p>
    </section>

    <section>
      <Pennstreck id="las-vidare">Läs vidare</Pennstreck>
      <ul class="m-0 p-0 list-none">
        <li class="border-t border-linje">
          <a href="/rakna/dranering/" class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
            Räkna på vad en dränering kostar, med maskinhyran på egen rad
          </a>
        </li>
        <li class="border-t border-linje">
          <a href="/grund/dranera-hus/" class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
            Så dränerar du om huset, från schakt till återställd tomt
          </a>
        </li>
        <li class="border-t border-linje">
          <a href="/golv/renovera-trappa/" class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
            Renovera trappan, tre vägar med timmar och kronor
          </a>
        </li>
        <li class="border-t border-linje">
          <a href="/el/tillaggsisolera-vind/" class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
            Tilläggsisolera vinden, vad det sparar och när det blir fel
          </a>
        </li>
        <li class="border-t border-linje">
          <a href="/golv/bygga-trappa/" class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
            Bygga trappa, måtten och formeln för inne och ute
          </a>
        </li>
        <li class="border-t border-linje">
          <a href="/rakna/kvadratmeter/" class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
            Räkna ut kvadratmeter och hur mycket material som går åt
          </a>
        </li>
      </ul>
    </section>

    <Faq fragor={FRAGOR} />
  </div>
</Bas>
