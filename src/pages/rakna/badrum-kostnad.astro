---
/**
 * Badrumsräknaren: vad badrummet kostar post för post, före och efter
 * rotavdraget. Formuläret skickas som GET till samma sida och räkningen sker
 * på servern, så sidan fungerar utan ett enda byte klient-JS.
 * Se docs/SPEC-SIDMALLAR.md avsnitt 4.7 och
 * docs/briefer/spec-kalkyl-badrum-kostnad-2026-09-29.md.
 *
 * Formeln, konstanterna och all text som modulen äger ligger i
 * src/lib/kalkyl/renovering.ts. Sidan räknar ingenting själv, den visar svaret
 * och redovisar källan bakom varje rad.
 *
 * Inga produkter och inget reklamband (checklistan 1 och 12, SOKORDSANALYS 8.6).
 *
 * Räknarmallen sedan fas C (spec-designlyft-c-2026-10-02 avsnitt 14).
 */
export const prerender = false;

import { artikelUrl, publicerade } from '../../lib/innehall';
import { tillKortArtikel, type KortData } from '../../lib/kort';
import { hittaKalkylator } from '../../lib/kalkyl/register';
import { arPelare } from '../../lib/pelare';
import {
  antagandenFor,
  beskedVarden,
  delbarQuery,
  KALLOR,
  krText,
  kvmText,
  raknaBadrumKostnad,
  regelKallor,
  rotavdragQuery,
  spannDelar,
  STANDARD,
  TEXT,
  tolkaQuery,
  type BadrumIndata,
  type KallaRef,
  type KallKod,
} from '../../lib/kalkyl/renovering.ts';
import { kallradEfterRegel } from '../../lib/kalkyl/kallrad';
import { LANK_KLASS } from '../../lib/kalkyl/stil';
import { verktygsillustration } from '../../lib/verktygsbild';
import BadrumKostnadForm from '../../components/kalkyl/BadrumKostnadForm.astro';
import Artikelrutnat from '../../components/ui/Artikelrutnat.astro';
import Faq from '../../components/ui/Faq.astro';
import Illustration from '../../components/ui/Illustration.astro';
import Pennstreck from '../../components/ui/Pennstreck.astro';
import Svarstal from '../../components/ui/Svarstal.astro';
import Tabellyta from '../../components/ui/Tabellyta.astro';
import Raknarsida from '../../components/vyer/Raknarsida.astro';

Astro.locals.sidtyp = 'verktyg';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

/** Slug, namn och beskrivning på ett ställe: brödsmulan, og:image och WebApplication läser samma. */
const SLUG = 'badrum-kostnad';
/* Utkast: sidan svarar 404 i produktion och noindex i dev tills värdartikeln
   /badrum/tatskikt-badrum/ publiceras och hantverkarens text finns. Sätts till
   false i publiceringscommiten, samtidigt som registerposten läggs till. */
const UTKAST = false;
const VERKTYGSNAMN = 'Räkna ut kostnaden för att renovera badrummet';
const BESKRIVNING = 'Fyll i golvytan och välj inredning, så får du kostnaden post för post med arbete och material för sig, och rotavdraget för en eller två ägare.'; // 120 till 155 tecken, checklistan 4
const titel = 'Renovera badrum, kostnad med rotavdrag'; // högst 44 tecken, checklistan 3
const H1 = 'Vad blir priset när du renoverar badrummet?'; // checklistan 5
const INGRESS =
  'Skriv in hur stort golvet är, vilken inredning du vill ha och vad du tänker göra själv. Du får se vad varje del av jobbet kostar i arbete och material, hur stort rotavdraget blir och vad som är kvar att betala.';

/* Rubrikerna till hantverkarens tre H2 (checklistans H2 1 till 3), i den ordningen. */
/* Vad som gör priset. */
const H2_PRISET = 'Vart pengarna går i ett badrum';
/* Vad du kan göra själv och vad det sparar. Bär "renovera badrum billigt". */
const H2_SJALV = 'Att renovera ett badrum billigt börjar med rivningen';
/* Rotavdraget för badrummet. */
const H2_ROT = 'Hur långt rotavdraget räcker';

/* Läs vidare: länktexterna skriver hantverkaren. */
const LAS_VIDARE = [
  { href: '/badrum/tatskikt-badrum/', text: 'Reglerna för tätskiktet och vad du får göra själv' },
  { href: '/rakna/rotavdrag/', text: 'Rotavdraget för alla arbeten ni köper i år' },
  { href: '/badrum/fogar-badrum/', text: 'Tvätta eller byt fogarna i badrummet' },
  { href: '/badrum/vatrumsmatta/', text: 'Vad golvet kostar med matta i stället för kakel' },
  { href: '/badrum/golvvarme-badrum/', text: 'Välj mellan el och vatten för golvvärmen' },
];

/* Tre till fem frågor. */
const FRAGOR = [
  {
    fraga: 'Varför skiljer sig offerterna för badrummet så mycket?',
    svar: 'Oftast beror det på att de inte innehåller samma saker. En offert har rivningen och containern med, en annan inte, och en tredje räknar med att du köper porslin och blandare själv. Timpriset skiljer sig också åt, och byggstädningen står ibland med och ibland inte. Be varje firma dela upp priset på samma poster som i räknaren. Då syns det direkt var skillnaden sitter.',
  },
  {
    fraga: `Är ${krText(STANDARD.timprisKr)} kr i timmen ett rimligt timpris i dag?`,
    svar: `För ett badrum ligger det i underkant. En byggfirma jag har jämfört med tar mer i timmen för badrum, el och VVS och mindre för snickeri, och timpriset här kommer från en kalkyl som inte är uppräknad till dagens nivå. Har du en offert är ditt eget timpris bättre än mitt, så skriv in det i fältet.`,
  },
  {
    fraga: 'Ingår byggstädningen i priset?',
    svar: 'Nej, den kommer till. Byggstädningen ger rotavdrag på samma sätt som resten av arbetet, så dra av rotavdraget för den också när du lägger den på summan.',
  },
];

/* Gränssnittstext, ordagrant ur skillen nytt-verktyg. */
const STANDARDVARNING = 'Ett av fälten gick inte att läsa, så jag visar standardvärdena tills du rättat det.';

/*
 * Utkastet svarar 404 i produktion (specen 4.1). Dev visar sidan med noindex,
 * så att den går att granska.
 */
if (UTKAST && import.meta.env.PROD) {
  return new Response(null, { status: 404, headers: { 'X-Robots-Tag': 'noindex' } });
}

const q = Astro.url.searchParams;
const { indata } = tolkaQuery(q);
const resultat = raknaBadrumKostnad(indata);
const fel = resultat.status === 'ogiltig' ? resultat.fel : {};
// Vid ogiltig indata visas standardvärdenas svar, med varningen överst.
const visatIndata: BadrumIndata = resultat.status === 'ogiltig' ? STANDARD : indata;
const visat = raknaBadrumKostnad(visatIndata);
if (visat.status !== 'ok') throw new Error('[badrum-kostnad] Standardvärdena ska alltid ge ett svar');

/**
 * Fältens värden kommer från adressen som den skrevs, inte från de tolkade
 * talen: "abc" blir NaN i tolkaQuery, och NaN i ett fält som läsaren ska rätta
 * är obrukbart.
 */
const varden = {
  yta: q.get('yta') ?? kvmText(STANDARD.ytaKvm),
  rot: q.get('rot') ?? (STANDARD.rotKr === 0 ? '' : String(STANDARD.rotKr)),
  timpris: q.get('timpris') ?? String(STANDARD.timprisKr),
};

/** Delbar länk, byggd av de tolkade värdena. */
const delaLank = new URL(`/rakna/${SLUG}/?${delbarQuery(visatIndata).toString()}`, Astro.site ?? Astro.url).toString();

const bv = beskedVarden(visat, visatIndata);
const besked = TEXT.besked[visat.utfall];

/**
 * Cellklasserna en gång på <table>, som på fasadyta. I posttabellen är talen
 * högerställda. Ett spann står som två <span>, det lägre talet och "till" med
 * det högre, och bara de får inte brytas: cellen bryts före "till" och aldrig
 * inne i ett tal, så att alla tre kolumnerna ryms på 375 px.
 */
const TABELL_KLASS =
  'w-full border-collapse text-liten tabular-nums [&_th]:p-2 [&_td]:p-2 [&_th]:align-top [&_td]:align-top [&_th]:text-left [&_tbody_th]:[font-weight:inherit] [&_tr]:border-b [&_tr]:border-linje [&_th]:text-blyerts [&_td]:text-blyerts [&_thead_th]:text-etikett [&_thead_th]:uppercase [&_thead_th]:text-blyerts-2';
const POST_TABELL_KLASS = `${TABELL_KLASS} [&_td]:text-right [&_td_span]:whitespace-nowrap [&_thead_th+th]:text-right [&_tfoot_th]:font-bold [&_tfoot_td]:font-bold`;
/** Länkarnas utseende en gång på föräldern, samma som LANK_KLASS. */
const LANKAR_KLASS = '[&_a]:text-penna [&_a]:underline [&_a]:decoration-1 [&_a]:underline-offset-2 [&_a:hover]:decoration-2';
const STYCKE_KLASS = 'm-0 mt-4 text-brod lg:text-brod-lg';
const SPALTRAD_KLASS = 'text-liten text-blyerts-2 tabular-nums';

const kalla = (k: KallKod): KallaRef => KALLOR[k];

/**
 * Posttabellens rader och summarad, med varje belopp som ett spann i två delar
 * (spannDelar). Den övre kanten för samma post är lika med den nedre upp till
 * 5 kvm. Arbetscellen vid egen insats är en sträng.
 */
type Cell = string | ReturnType<typeof spannDelar>;
const postRader: { namn: string; celler: Cell[] }[] =
  visat.utfall === 'utanfor'
    ? []
    : visat.poster.map((p, n) => {
        const h = visat.hog.poster[n] ?? p;
        return {
          namn: p.nyckel === 'container' ? `${TEXT.post[p.nyckel]} ${TEXT.postAntagande}` : TEXT.post[p.nyckel],
          celler: [
            p.egenInsats ? `0 ${TEXT.postEgen}` : spannDelar(p.arbeteKr, h.arbeteKr),
            spannDelar(p.materialKr, h.materialKr),
          ],
        };
      });
const summaRad =
  visat.utfall === 'utanfor'
    ? null
    : [
        spannDelar(visat.arbeteKr, visat.hog.arbeteKr),
        spannDelar(visat.materialKr + visat.containerKr, visat.hog.materialKr + visat.hog.containerKr),
      ];

/**
 * Antagandetabellen visar bara raderna svaret vilar på, och källorna står en
 * gång under tabellen i den ordning de först förekommer.
 */
const antaganden = antagandenFor(visat, visatIndata);
const kallor: KallaRef[] = [];
for (const a of antaganden) {
  for (const k of a.kallor) if (!kallor.some((x) => x.kod === k)) kallor.push(kalla(k));
}

/** Skissen står i kortet Så räknar jag. Huvudet har ingen bild sedan fas C (DESIGN.md 5.8). */
const illustration = verktygsillustration(SLUG);

/*
 * Klartexten i svarsytan (spec-designlyft-c avsnitt 0 och 14), hantverkarens.
 * Platshållare: {betala} (att betala efter rotavdraget, kr, ett tal eller "lågt
 * till högt"), {yta} (golvytan, kvm), {fore} (före rotavdraget, kr) och {rot}
 * (rotavdraget, kr). Utanför intervallet står bara {yta} ifylld.
 */
const KLARTEXT =
  'Ett badrum med {yta} kvm golv kostar {betala} kr efter rotavdraget och {fore} kr före, räknat med offertförmedlarnas och en byggfirmas priser.'; // badrum-kostnad.klartext
/* Utanför intervallet finns inget belopp, så meningen är en annan och bär bara {yta}. */
const KLARTEXT_UTANFOR =
  'Ett badrum på {yta} kvm ligger utanför de storlekar som offertförmedlarnas och en byggfirmas priser gäller för, så här ger jag inget belopp.';
const klartext = (visat.utfall === 'utanfor' ? KLARTEXT_UTANFOR : KLARTEXT).replace(
  '{betala}',
  visat.utfall === 'utanfor'
    ? ''
    : visat.spann
      ? `${krText(visat.attBetalaKr)} till ${krText(visat.hog.attBetalaKr)}`
      : krText(visat.attBetalaKr),
)
  .replace('{yta}', kvmText(visatIndata.ytaKvm))
  .replace('{fore}', bv.foreRot ?? '')
  .replace('{rot}', bv.rot ?? '');

/**
 * Läs vidare: artiklarna som artikelkort, räknarna med registrets namn som på
 * hubben, i den förra listans ordning.
 */
const artiklar = [...(await publicerade('guider')), ...(await publicerade('kunskap'))];
const lasVidare: KortData[] = [];
const lasVidareLankar: { href: string; text: string }[] = [];
for (const l of LAS_VIDARE) {
  const e = artiklar.find((a) => artikelUrl(a) === l.href);
  if (e) {
    const { niva: _niva, ...kort } = tillKortArtikel(e);
    lasVidare.push(kort);
    continue;
  }
  const k = l.href.startsWith('/rakna/') ? hittaKalkylator(l.href.replace(/^\/rakna\/|\/$/g, '')) : undefined;
  const pelare = k?.pelare?.[0];
  if (k && pelare && arPelare(pelare)) {
    lasVidare.push({
      etikett: 'Räkna själv',
      rubrik: k.namn,
      beskrivning: k.rad,
      pelare,
      href: l.href,
      // Artikelrutnat läser inte typen; kortet står varken i ett typfilter eller sorteras.
      typ: 'kunskap',
      sorteringsdatum: new Date(0),
    });
    continue;
  }
  lasVidareLankar.push(l);
}
---

<Raknarsida
  slug={SLUG}
  namn={VERKTYGSNAMN}
  titel={titel}
  beskrivning={BESKRIVNING}
  rubrik={H1}
  delaUrl={delaLank}
  saRaknarId="sa-raknar-jag"
>
  <p slot="ingress">{INGRESS}</p>

  <BadrumKostnadForm slot="formular" indata={indata} varden={varden} fel={fel} />

  <Fragment slot="svar">
    {resultat.status === 'ogiltig' && <p class="text-liten text-varning">{STANDARDVARNING}</p>}
    {
      visat.utfall !== 'utanfor' && (
        <Svarstal
          tal={
            visat.spann
              ? `${krText(visat.attBetalaKr)} till ${krText(visat.hog.attBetalaKr)}`
              : krText(visat.attBetalaKr)
          }
          enhet="kr"
          vad={TEXT.spalt['etikett-betala']}
        />
      )
    }
    <div class="text-brod">
      <p class="font-bold">{besked.rubrik(bv)}</p>
      <p class="mt-1!">{besked.rad(bv)}</p>
    </div>
    {
      visat.utfall !== 'utanfor' && (
        <div>
          <p class={SPALTRAD_KLASS}>{TEXT.spalt['rad-summa'](bv.foreRot ?? '', bv.rot ?? '')}</p>
          <p class:list={[SPALTRAD_KLASS, 'mt-1!']}>
            {TEXT.spalt['rad-delning'](bv.arbete ?? '', bv.material ?? '', bv.container ?? '')}
          </p>
          <p class="mt-1! text-liten text-blyerts-2">{TEXT.spalt['rad-kallor'](bv.hamtat)}</p>
        </div>
      )
    }
    {
      visat.utfall !== 'utanfor' && (
        <p>
          <a
            href={`/rakna/rotavdrag/?${rotavdragQuery(visat, visatIndata).toString()}`}
            class:list={['inline-flex min-h-11 items-center', LANK_KLASS]}
          >
            {TEXT.spalt['lank-rotavdrag']}
          </a>
        </p>
      )
    }
    <p class="text-liten text-blyerts">{klartext}</p>
  </Fragment>

  <Fragment slot="darfor">
    <Pennstreck id="darfor-blev-svaret-sa" utanLuft>
      Därför blev svaret så
    </Pennstreck>
    {
      visat.utfall !== 'utanfor' ? (
        <>
          <Tabellyta kolumner={3} class="mt-4">
            <table class={POST_TABELL_KLASS}>
              <thead>
                <tr>
                  <th scope="col">{TEXT.darfor['tabell-post']}</th>
                  <th scope="col">{TEXT.darfor['tabell-arbete']}</th>
                  <th scope="col">{TEXT.darfor['tabell-material']}</th>
                </tr>
              </thead>
              <tbody>
                {
                  postRader.map((r) => (
                    <tr>
                      <th scope="row">{r.namn}</th>
                      {r.celler.map((c) => (
                        <td>
                          {typeof c === 'string' ? (
                            c
                          ) : (
                            <>
                              <span>{c.lag}</span>
                              {c.hog !== null && (
                                <>
                                  {' '}
                                  <span>till {c.hog}</span>
                                </>
                              )}
                            </>
                          )}
                        </td>
                      ))}
                    </tr>
                  ))
                }
              </tbody>
              <tfoot>
                {
                  summaRad && (
                    <tr>
                      <th scope="row">{TEXT.darfor.summa}</th>
                      {summaRad.map((c) => (
                        <td>
                          <span>{c.lag}</span>
                          {c.hog !== null && (
                            <>
                              {' '}
                              <span>till {c.hog}</span>
                            </>
                          )}
                        </td>
                      ))}
                    </tr>
                  )
                }
              </tfoot>
            </table>
          </Tabellyta>
          <p class="m-0 mt-2 text-liten text-blyerts-2">
            <a href="#vad-siffrorna-vilar-pa" class={LANK_KLASS}>{TEXT.darfor.kallrad}</a>
          </p>
          <p class:list={[STYCKE_KLASS, 'tabular-nums']}>{TEXT.darfor.rot(bv)}</p>
          <p class:list={[STYCKE_KLASS, 'tabular-nums']}>{TEXT.darfor.betala(bv)}</p>
          <p class:list={[STYCKE_KLASS, 'tabular-nums']}>{TEXT.darfor['per-kvm'](bv)}</p>
        </>
      ) : (
        <p class={STYCKE_KLASS}>{TEXT.darfor.utanfor(bv)}</p>
      )
    }
    <div class:list={['darfor', LANKAR_KLASS]}>
      {
        (() => {
          /* Förmedlarna namnges bara i antagandetabellen (checklistans fälla).
             Hänvisningen dit står högst en gång på sidan: i stycket ovanför när svaret
             når intervallet, annars under den sista regeln som vilar på en förmedlare. */
          const kallor = visat.regler.map((nyckel) => regelKallor(nyckel));
          const sistaFormedlare = kallradEfterRegel(kallor, visat.utfall !== 'utanfor');
          return visat.regler.map((nyckel, r) => {
            const regel = TEXT.regel[nyckel];
            const namngivna = kallor[r] ?? [];
            return (
              <div>
                <p>{regel.text(bv)}</p>
                {namngivna.length > 0 ? (
                  <p>
                    {namngivna.map((k, i) => (
                      <>
                        {i > 0 && '; '}
                        <a href={k.url} rel="nofollow">{k.titel}</a>, {k.slag}, {k.datum}
                      </>
                    ))}
                  </p>
                ) : (
                  r === sistaFormedlare && (
                    <p>
                      <a href="#vad-siffrorna-vilar-pa">{TEXT.darfor.kallrad}</a>
                    </p>
                  )
                )}
              </div>
            );
          });
        })()
      }
    </div>
  </Fragment>

  {
    visat.gorInteDetHar.length > 0 && (
      <Fragment slot="gorInte">
        {/* Flera råd står i samma stycke efter "Gör inte det här.", vart och ett på egen rad. */}
        {visat.gorInteDetHar.map((g, i) => (
          <span class:list={[i > 0 && 'mt-3 block']}>{TEXT.gorInte[g]}</span>
        ))}
      </Fragment>
    )
  }

  <Fragment slot="saRaknarJag">
    {
      illustration && (
        <div class="pappersruta">
          <Illustration namn={`rakna/${SLUG}`} alt={TEXT.skissAlt} bildtext={TEXT.skissBildtext} class="my-0!" />
        </div>
      )
    }
    <ol class="m-0 mt-4 pl-6 list-decimal text-brod [&>li]:mb-2">
      {TEXT.steg.map((s) => <li>{s}</li>)}
    </ol>
  </Fragment>

  <Fragment slot="efter">
    {/* Antagandetabellen i läsbredd, ur kortet Så räknar jag (spec-designlyft-c avsnitt 9). */}
    <section class="max-w-lasbredd">
      <h3 id="vad-siffrorna-vilar-pa" class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">
        Vad siffrorna vilar på
      </h3>
      <Tabellyta kolumner={3} class="mt-4">
        <table class={TABELL_KLASS}>
          <thead>
            <tr>
              <th scope="col">Vad</th>
              <th scope="col">Värde</th>
              <th scope="col">Källa eller antagande</th>
            </tr>
          </thead>
          <tbody>
            {
              antaganden.map((a) => (
                <tr>
                  <th scope="row">{TEXT.antagande[a.nyckel]}</th>
                  <td>{a.varde}</td>
                  <td>
                    {a.typ}.{a.kallor.length > 0 && ` ${a.kallor.map((k) => kalla(k).titel).join('; ')}`}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </Tabellyta>
      <ul class:list={['m-0 mt-4 pl-6 text-liten', LANKAR_KLASS]}>
        {
          kallor.map((k) => (
            <li>
              {/* Kommat på samma rad som </a>, annars blir radbrytningen ett mellanslag före kommat. */}
              <a href={k.url} rel="nofollow">{k.titel}</a>, {k.slag}, {k.datum}
            </li>
          ))
        }
      </ul>
    </section>

    {/*
      Hantverkarens brödtext, checklistans H2 1 till 3. Länkarna skrivs som
      vanliga <a> utan klass; utseendet står en gång på <section>.
    */}
    <section class:list={['max-w-lasbredd', LANKAR_KLASS]}>
      {/* Vad som gör priset: posterna, vilka som är arbete och vilka som är material. */}
      <Pennstreck>{H2_PRISET}</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        Kostnaden för en badrumsrenovering ligger mest i förarbetena, tätskiktet och kaklet, både i timmar och i material, eftersom underlaget ska byggas upp, tätas och kaklas innan något annat kan monteras. Rivningen är nästan bara arbete. VVS och el är ungefär hälften arbete och hälften material.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Med inredningen är det tvärtom. Toaletten, handfatet, blandarna och möblerna kostar mycket mer att köpa än att sätta upp. Där väljer du själv hur dyrt det blir.
      </p>
    </section>

    <section class:list={['max-w-lasbredd', LANKAR_KLASS]}>
      {/*
        Vad du kan göra själv och vad det sparar. Bär "renovera badrum billigt".
        Länkar till /badrum/tatskikt-badrum/ (gränsen) och /badrum/fogar-badrum/
        (det billigaste sättet att fräscha upp).
      */}
      <Pennstreck>{H2_SJALV}</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        Det du kan ta på dig i räknaren är rivningen och att forsla bort det gamla. Jag har jobbat som rivare en kort period, och av allt i ett badrum är rivningen det jobb där dina egna timmar gör mest nytta. Du behöver mest verktyg för att bila, en rygg som håller och tid.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Rivningen ger rotavdrag när firman gör den, så det du sparar på att riva själv är arbetet minus avdraget. Bortforslingen kan du också ta på dig, men i räknaren sparar den ingenting.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Monteringen av inredningen går inte att välja, även om du får göra en del av den själv. Toalettstolen sitter fast i tätskiktet och <a href="/badrum/montera-duschvagg/">duschväggen skruvas ofta genom det</a>, och <a href="/badrum/tatskikt-badrum/">tabellen över vad du får göra själv i ett badrum</a> visar var gränsen går för varje arbete.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Vill du bara fräscha upp och inte renovera alls är fogarna det billigaste stället att börja på. Mögel på ytan går att tvätta bort, och <a href="/badrum/fogar-badrum/">en silikonfog som är slut kan bytas</a> utan att resten av badrummet rörs.
      </p>
    </section>

    <section class:list={['max-w-lasbredd', LANKAR_KLASS]}>
      {/*
        Rotavdraget för badrummet: två ägare, gräns som redan är använd, att
        material inte ger avdrag. Länkar till /rakna/rotavdrag/.
      */}
      <Pennstreck>{H2_ROT}</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        Med priserna här ryms rotavdraget för ett vanligt badrum inom en persons gräns. Gränsen nås när timpriset är högt, när badrummet är stort eller när du redan har anlitat hantverkare under året. Äger ni huset tillsammans kan ni dela avdraget, och då får var och en dra av upp till sin egen gräns, om ni båda står som ägare när jobbet görs, bor där och är med och betalar.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Rotavdrag som du redan har fått för något annat i år skriver du i fältet för det som redan är använt, så räknas bara det som finns kvar av gränsen. Rutavdrag och skatt ingår inte här. Har du haft rutavdrag i år, eller är du osäker på om skatten räcker till hela avdraget, väger <a href="/rakna/rotavdrag/">räknaren för rotavdrag</a> in båda.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Att köpa kaklet och porslinet själv ändrar inte avdraget. Materialet ger aldrig något avdrag, vem som än köper det.
      </p>
    </section>

    {
      (lasVidare.length > 0 || lasVidareLankar.length > 0) && (
        <section>
          <Pennstreck id="las-vidare">Läs vidare</Pennstreck>
          {lasVidare.length > 0 && (
            <Artikelrutnat
              kort={lasVidare}
              kolumner={lasVidare.length === 4 ? 4 : 3}
              visaBeskrivning={false}
              visaMeta={false}
            />
          )}
          {lasVidareLankar.length > 0 && (
            <ul class="m-0 mt-4 p-0 list-none max-w-lasbredd">
              {lasVidareLankar.map((l) => (
                <li class="border-t border-linje">
                  <a href={l.href} class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
                    {l.text}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </section>
      )
    }

    {
      FRAGOR.length > 0 && (
        <div class="max-w-lasbredd">
          <Faq fragor={FRAGOR} />
        </div>
      )
    }
  </Fragment>
</Raknarsida>
