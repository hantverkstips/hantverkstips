---
/**
 * Avfuktarkalkylatorn. Formuläret skickas som GET till samma sida och
 * beräkningen sker på servern, så sidan fungerar utan ett enda byte klient-JS.
 * Kostnaden är en serverfunktion per anrop, och den hålls nere med CDN-cache.
 * Se docs/SPEC-SIDMALLAR.md avsnitt 4.7.
 *
 * Formeln och alla antaganden ligger i src/lib/kalkyl/avfuktare.ts. Sidan räknar
 * ingenting själv, den visar bara resultatet och redovisar källorna.
 */
export const prerender = false;

import Bas from '../../layouts/Bas.astro';
import { formateraTal } from '../../lib/format';
import {
  fuktnivaEtikett,
  raknaAvfuktare,
  STANDARD,
  tolkaQuery,
  type AvfuktareResultat,
} from '../../lib/kalkyl/avfuktare';
import { CELL_KLASS, ETIKETT_KLASS, FALT_KLASS, LANK_KLASS } from '../../lib/kalkyl/stil';
import { hamtaButik, lagstaPris, produkterIKategori } from '../../lib/produkter';
import { verktyg } from '../../lib/strukturdata';
import { verktygsDelningsbild, verktygsillustration, verktygsVarumarkesbild } from '../../lib/verktygsbild';
import AvfuktareForm from '../../components/kalkyl/AvfuktareForm.astro';
import Faktaruta from '../../components/ui/Faktaruta.astro';
import Faq from '../../components/ui/Faq.astro';
import Markering from '../../components/ui/Markering.astro';
import Pennstreck from '../../components/ui/Pennstreck.astro';
import Produktkort from '../../components/ui/Produktkort.astro';
import StrukturData from '../../components/ui/StrukturData.astro';
import Tabellyta from '../../components/ui/Tabellyta.astro';
import Illustration from '../../components/ui/Illustration.astro';

Astro.locals.sidtyp = 'verktyg';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

const { indata } = tolkaQuery(Astro.url.searchParams);
const resultat = raknaAvfuktare(indata);

const fel = resultat.status === 'ogiltig' ? resultat.fel : {};
// Vid ogiltig indata visas standardvärdenas resultat, med en rad som säger det.
const visat: AvfuktareResultat = resultat.status === 'ogiltig' ? raknaAvfuktare(STANDARD) : resultat;
const visatIndata = resultat.status === 'ogiltig' ? STANDARD : indata;

/**
 * Fältens värden kommer från query-strängen som den skrevs, inte från de tolkade
 * talen: "tolv" eller "" blir NaN i tolkaQuery, och NaN i ett fält som läsaren
 * ska rätta är obrukbart.
 */
function faltVarde(nyckel: string, standard: number): string {
  const ra = Astro.url.searchParams.get(nyckel);
  if (ra !== null) return ra;
  return String(standard).replace('.', ',');
}
const ytaVarde = faltVarde('yta', STANDARD.ytaKvm);
const takhojdVarde = faltVarde('takhojd', STANDARD.takhojdM);

/**
 * Delbar länk. Hela tillståndet ligger redan i query-strängen, så adressen är
 * uträkningen. Den byggs av de tolkade värdena, inte av strängen läsaren skrev,
 * så att en delad länk alltid ger samma resultat som skärmen visar.
 */
const delaQuery = new URLSearchParams({
  yta: String(visatIndata.ytaKvm).replace('.', ','),
  takhojd: String(visatIndata.takhojdM).replace('.', ','),
  fukt: visatIndata.fuktniva,
  temp: visatIndata.temperatur,
});
const delaLank = new URL(`/rakna/avfuktare/?${delaQuery.toString()}`, Astro.site ?? Astro.url).toString();

const butik = await hamtaButik();

/**
 * Produkterna filtreras på typen vi rekommenderar och på märkt kapacitet.
 * Först de som klarar talet vi visar, sedan, om de är färre än tre, de som ligger
 * inom osäkerhetsintervallet. Aldrig en maskin under intervallets nedre kant.
 */
let traffar: string[] = [];
if (visat.status === 'ok') {
  const krav = visat.marktKapacitetLiter;
  const golv = visat.marktIntervall[0];
  const typ = visat.typ;

  const alla = await produkterIKategori('luftavfuktare');
  const kandidater = alla
    .filter((p) => String(p.specs['typ'] ?? '').toLowerCase().includes(typ))
    .map((p) => ({ slug: p.slug, kapacitet: Number(p.specs['kapacitet_liter_dygn']), pris: lagstaPris(p) ?? Infinity }))
    .filter((p) => Number.isFinite(p.kapacitet) && p.kapacitet >= golv)
    .sort((a, b) => a.pris - b.pris);

  traffar = [
    ...kandidater.filter((p) => p.kapacitet >= krav),
    ...kandidater.filter((p) => p.kapacitet < krav),
  ]
    .slice(0, 3)
    .map((p) => p.slug);
}

/**
 * Kolumner efter antal träffar, och aldrig bredare än läsbredden när de är få:
 * ett ensamt kort i en tredjedelsspalt (235 px) blir oläsligt, se
 * designgranskningen 2026-09-16 punkt 3.
 */
const kortSpalter =
  traffar.length >= 3
    ? 'lg:grid-cols-3'
    : traffar.length === 2
      ? 'lg:grid-cols-2'
      : 'lg:max-w-lasbredd';

/** Beskedet överst i spalten: vilken maskin du ska köpa, och varför just den typen. */
const beskedRubrik =
  visat.status === 'ok'
    ? `Köp en ${visat.typ === 'kondens' ? 'kondensavfuktare' : 'sorptionsavfuktare'} som är märkt minst ${visat.marktKapacitetLiter} liter per dygn.`
    : '';
const beskedRad =
  visat.status === 'ok' && visat.typ === 'kondens'
    ? 'En kondensavfuktare tar mest vatten för pengarna så länge utrymmet håller sig över 15 grader.'
    : 'En kondensavfuktare tappar farten under 15 grader och lägger till slut mer tid på att avfrosta sig själv än på att avfukta. Sorptionsmaskinen bryr sig inte om kylan.';

const titel = 'Räkna ut hur stor avfuktare du behöver';

/** Antagandena i tabellen under "Så räknar vi". Samma tal som konstanterna i kalkylen. */
const antaganden: { storhet: string; varde: string; grund: 'Källa' | 'Antagande'; stod: string; url?: string }[] = [
  {
    storhet: 'Hur mycket vatten luften rymmer, 9,38 g/m³ vid 10 °C och 12,80 vid 15 °C',
    varde: 'Magnus-formeln',
    grund: 'Källa',
    stod: 'Lawrence 2005, BAMS 86(2)',
    url: 'https://journals.ametsoc.org/view/journals/bams/86/2/bams-86-2-225.xml',
  },
  {
    storhet: 'Nivån maskinen ska hålla i utrymmet',
    varde: '55 % RF',
    grund: 'Källa',
    stod: 'BBR 6:52 via Boverket sätter 75 % som kritiskt fukttillstånd, och 55 ger marginal ner till det',
    url: 'https://www.boverket.se/sv/byggande/forebygg-fel-brister-skador/risker/risker-fuktskador/fuktrisker-for-grund/krypgrund/risk-med-fukt-fran-uteluft-i-krypgrund/',
  },
  {
    storhet: 'Vattnet i uteluften i augusti',
    varde: '10,0 g/m³',
    grund: 'Källa',
    stod: 'SMHI, 70 till 80 % RF i juli i inlandet',
    url: 'https://www.smhi.se/kunskapsbanken/meteorologi/luftfuktighet/olika-matt-pa-luftfuktighet',
  },
  {
    storhet: 'Hur ofta luften byts',
    varde: '0,5 oms/h',
    grund: 'Antagande',
    stod: 'FoHMFS 2014:18 ger 0,35 l/s per m² i bostad. Att en källare eller krypgrund ventileras lika mycket är min gissning',
    url: 'https://www.folkhalsomyndigheten.se/contentassets/641784832543443ea4eebe9b300c244e/fohmfs-2014-18.pdf',
  },
  {
    storhet: 'Fukt upp ur marken när det syns mögel',
    varde: '100 g per m² och dygn',
    grund: 'Källa',
    stod: 'Kurnitski 2001 mätte 86 till 137 g per m² och dygn från bar mark',
    url: 'https://www.sciencedirect.com/science/article/abs/pii/S0360132300000135',
  },
  {
    storhet: 'Fukt upp ur marken vid medel och hög fuktnivå',
    varde: '10 och 40 g per m² och dygn',
    grund: 'Antagande',
    stod: 'Min gissning för en tät respektive kapillärt fuktig betongplatta. Det är räkningens svagaste led',
  },
  {
    storhet: 'Temperaturen jag räknar på',
    varde: '15 °C uppvärmt, 10 °C ouppvärmt',
    grund: 'Antagande',
    stod: 'Mitt val, satt så att det stämmer med en svensk källare i augusti',
  },
  {
    storhet: 'Marginalen på summan',
    varde: '1,3',
    grund: 'Antagande',
    stod: 'Mitt val. LFS och Luftmiljöbutiken säger hellre för stor än för liten, utan att sätta en siffra',
    url: 'https://www.lfs-web.se/avfuktare-valj-ratt-for-bast-ekonomi-och-sakrast-avfuktning/',
  },
  {
    storhet: 'Kondensmaskin vid 15 °C, andel av det märkta talet',
    varde: '0,30 (0,25 till 0,35)',
    grund: 'Antagande',
    stod: 'Interpolerat mellan Meacos mätpunkter vid 20 och 10 °C, ingen har mätt vid 15',
    url: 'https://blog.meaco.com/my-dehumidifier-is-bigger-than-your-dehumidifier-no-its-not/',
  },
  {
    storhet: 'Sorptionsmaskin vid 10 °C, andel av det märkta talet',
    varde: '0,80 (0,75 till 1,0)',
    grund: 'Källa',
    stod: 'Corroventa CTR STD-TT ger 0,76 och Meaco DD8L 0,99 vid 10 °C',
    url: 'https://www.corroventa.se/produkter/krypgrundsavfuktare/krypgrundsavfuktare-ctr-std-tt/',
  },
];

/**
 * Frågorna sist på sidan. Samma tal som i "Så räknar vi", inga nya antaganden.
 */
const FRAGOR = [
  {
    fraga: 'Hur stor avfuktare behöver jag?',
    svar: 'Köp maskinen för det vatten som kommer in varje dygn, inte för luften som redan står i rummet. Jag räknar på augusti, som är den blötaste månaden, och lägger på en marginal så att maskinen klarar dygnets vatten på ungefär 18 timmar. Fyll i golvytan, takhöjden och hur fuktigt det är i dag, så får du ett tal i liter per dygn att leta efter i butiken. Och tveka mellan två storlekar ska du ta den större. En för liten maskin går dygnet runt och kommer ändå aldrig ner till 55 procent.',
  },
  {
    fraga: 'Varför stämmer inte kapaciteten på förpackningen?',
    svar: 'Tillverkarna mäter kondensmaskiner vid 30 grader och 80 procent luftfuktighet, och så varmt och blött blir det aldrig i en svensk källare. I ett svalt utrymme ger samma maskin därför bara ungefär en tredjedel av talet på lådan. En sorptionsmaskin torkar luften med ett fuktsugande hjul i stället för med kyla, och den tappar betydligt mindre. Verktyget räknar om åt dig och visar det märkta tal du ska leta efter.',
  },
  {
    fraga: 'Kondens eller sorption, vilken ska jag välja?',
    svar: 'Temperaturen i utrymmet avgör. En kondensavfuktare arbetar med kyla och tappar kraft när det blir svalt, så den hör hemma i en uppvärmd källare. En sorptionsavfuktare håller sin kapacitet ner mot nollan, och det är den som gäller i krypgrunden, det ouppvärmda garaget och sommarstugan.',
    lank: { text: 'Läs jämförelsen mellan sorption och kondens.', href: '/fukt/sorptionsavfuktare/' },
  },
];

/** Slug, namn och beskrivning på ett ställe: brödsmulan, og:image och WebApplication läser samma. */
const SLUG = 'avfuktare';
const VERKTYGSNAMN = 'Avfuktarkalkylator';
const BESKRIVNING =
  'Räkna ut hur många liter per dygn din avfuktare måste klara i just ditt utrymme, och se vilka maskiner som klarar det när källaren är sval.';
const illustration = verktygsillustration(SLUG);
/**
 * Varumärkesbilden i sidhuvudet, sedan 2026-09-19 (docs/DESIGN.md avsnitt 7).
 * Finns den står skissen i stället i "Så räknar vi", där måtten förklarar
 * räkningen. Finns den inte visas skissen i sidhuvudet som förut.
 */
const varumarke = verktygsVarumarkesbild(SLUG);
const huvudbild = varumarke ?? illustration;
---

<Bas
  title={titel}
  description={BESKRIVNING}
  reklam={true}
  butikNamn={butik?.namn}
  brodsmulor={[
    { namn: 'Hantverkstips', href: '/' },
    { namn: 'Räkna själv', href: '/rakna/' },
    { namn: VERKTYGSNAMN },
  ]}
  bred={true}
  ogBild={verktygsDelningsbild(SLUG)}
>
  <StrukturData
    slot="head"
    data={verktyg({ url: `/rakna/${SLUG}/`, namn: VERKTYGSNAMN, beskrivning: BESKRIVNING })}
  />

  <div class="mx-auto w-full max-w-lasbredd">
    {/*
      Sidhuvudet: rubrik och ingress till vänster i 7/12, bilden till höger i
      5/12 på desktop, under ingressen på mobil. Bilden är dekorativ, H1 bär
      betydelsen, därför tom alt. Den är sidans LCP-bild och laddas därför
      eagert med fetchpriority. Varumärkesbilden har transparent bakgrund och
      ligger som heron utan ram; skissen är ett urklipp och får ramen. Saknas
      båda visas ingen bild alls.
    */}
    <section class="grid grid-cols-1 items-center gap-6 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7">
        <h1 class="m-0 font-serif text-h1 lg:text-h1-lg">Hur stor avfuktare behöver du?</h1>
        <p class="m-0 mt-4 text-ingress lg:text-ingress-lg">
          Fyll i golvytan, takhöjden och hur fuktigt det är i dag, så får du veta hur många liter per dygn maskinen
          måste klara. Talet du får är det som ska stå på lådan, omräknat från en svensk källare i augusti. Ta det
          som ett minsta krav med marginal, för lådans siffra och verkligheten är två olika saker.
        </p>
      </div>

      {
        huvudbild && (
          <div class="lg:col-span-5">
            <img
              src={huvudbild.src}
              alt=""
              width={huvudbild.width}
              height={huvudbild.height}
              fetchpriority="high"
              decoding="async"
              class:list={['block h-auto w-full', !varumarke && 'rounded-sm border border-linje']}
            />
          </div>
        )
      }
    </section>

    <div class="linjerat mt-8 lg:grid lg:grid-cols-2 lg:gap-8">
      {/* Formuläret ligger i src/components/kalkyl/AvfuktareForm.astro, så att
          <Kalkylator namn="avfuktare" /> i en artikel visar exakt samma fält. */}
      <AvfuktareForm indata={indata} varden={{ yta: ytaVarde, takhojd: takhojdVarde }} fel={fel} />

      <div class="mt-8 border-t border-linje pt-6 lg:mt-0 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8">
        {
          resultat.status === 'utanfor' ? (
            /* Ingen rubrik: rutan står före sidans första H2 och en H3 här
               skulle ge fel rubrikordning. */
            <Faktaruta>
              <p class="m-0 leading-6">{resultat.text}</p>
              <p class="m-0 leading-6">
                <a href="/fukt/">Läs mer om fukt i huset</a>
              </p>
            </Faktaruta>
          ) : (
            visat.status === 'ok' && (
              <>
                {resultat.status === 'ogiltig' && (
                  <p class="m-0 mb-2 text-liten text-varning">
                    Ett av fälten gick inte att läsa, så jag visar standardvärdena tills du rättat det.
                  </p>
                )}
                {/* Beskedet står först: vilken maskin du ska köpa. Räkningen
                    bakom står under verktyget. */}
                <p class="m-0 font-sans text-h3 lg:text-h3-lg font-bold text-blyerts">{beskedRubrik}</p>
                <p class="m-0 mt-1 text-brod">{beskedRad}</p>

                <p class="m-0 mt-6 text-etikett lg:text-etikett-lg uppercase text-blyerts-2">Minst</p>
                {/* Enheten står på samma rad som talet, på talets baslinje
                    (DESIGN.md avsnitt 5.8). Radbryter på smal skärm. */}
                <p class="m-0 mt-1 flex flex-wrap items-baseline gap-x-2">
                  <span class="font-serif text-siffra lg:text-siffra-lg text-blyerts">
                    <Markering>{visat.marktKapacitetLiter}</Markering>
                  </span>
                  <span class="text-ingress lg:text-ingress-lg">liter per dygn</span>
                </p>
                <p class="m-0 mt-2 text-liten text-blyerts-2">
                  Det är talet på lådan, som tillverkaren mätt vid {visat.kapacitetVillkor}. I ditt utrymme vid{' '}
                  {visat.temperaturC} grader motsvarar det ungefär {visat.literPerDygnVerklig} liter om dygnet.
                </p>
                <p class="m-0 mt-1 text-liten text-blyerts-2">
                  Räknat på {formateraTal(visat.volymM3, 1)} m³ och {fuktnivaEtikett(visatIndata.fuktniva)}.
                </p>
                <p class="m-0 mt-4 text-brod">
                  Omräkningen från lådans siffra till din källare är det osäkraste i hela räkningen, så läs talet
                  som {visat.marktIntervall[0]} till {visat.marktIntervall[1]} liter.
                </p>
                <p class="m-0 mt-2">
                  <a href="#sa-raknar-vi" class:list={['inline-flex min-h-11 items-center', LANK_KLASS]}>
                    Så räknar jag
                  </a>
                </p>

                {/* Dela. Uträkningen står i adressen, så ett skrivskyddat fält
                    räcker: markera och kopiera fungerar utan en rad JavaScript.
                    En kopieringsknapp kan komma senare som React-ö. */}
                <div class="mt-4 border-t border-linje pt-4">
                  <label for="dela" class={ETIKETT_KLASS}>
                    Dela uträkningen
                  </label>
                  <input
                    id="dela"
                    type="text"
                    readonly
                    value={delaLank}
                    class:list={[FALT_KLASS, 'border-blyerts-2']}
                  />
                  <p class="m-0 mt-1 text-liten text-blyerts-2">
                    Dina värden ligger i adressen. Markera den och kopiera, så får den du skickar till samma svar.
                  </p>
                </div>
              </>
            )
          )
        }
      </div>
    </div>

    <section>
      <Pennstreck id="produkter-som-klarar-det">Produkter som klarar det</Pennstreck>
      {
        traffar.length > 0 ? (
          /* Kolumnerna följer antalet träffar. En ensam produkt i en
             tredjedelsspalt blir 235 px bred, och då skriver kortets etiketter
             över värdena. Ett kompakt kort får aldrig bli smalare än 20 rem.
             Designgranskningen 2026-09-16 punkt 3. */
          <div class:list={['grid gap-4', kortSpalter]}>
            {traffar.map((slug) => (
              <Produktkort produkt={slug} variant="kompakt" modul="kalkylator" />
            ))}
          </div>
        ) : (
          <Faktaruta>
            <p class="m-0 leading-6">
              Jag har inte granskat någon avfuktare i den storleken än.{' '}
              <a href="/luftavfuktare/">Här är alla jag granskat.</a>
            </p>
          </Faktaruta>
        )
      }
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Korten visar de billigaste maskinerna av rätt typ som klarar talet ovanför. Nästa fråga brukar vara vad en
        sådan maskin drar i el när den går större delen av dygnet, och det räknar du ut med{' '}
        <a href="/rakna/elkostnad/" class={LANK_KLASS}>elkostnadsräknaren</a>.
      </p>
      <p class="m-0 mt-4">
        <a href="/luftavfuktare/" class:list={['inline-flex min-h-11 items-center', LANK_KLASS]}>
          Alla avfuktare jag granskat
        </a>
      </p>
    </section>

    <section>
      <Pennstreck id="sa-raknar-vi">Så räknar jag om märkt kapacitet till verklig</Pennstreck>
      {
        varumarke && illustration && (
          <Illustration
            namn="rakna/avfuktare"
            alt="Källare i genomskärning med måttsatt takhöjd, droppar på väggen och en avfuktare på golvet."
            bildtext="Skissen visar det verktyget räknar på: rummets volym med 2,2 meter i tak, fukten som kommer in genom väggen och in med luften, och maskinen på golvet som ska ta bort den."
          />
        )
      }
      <p class="m-0 text-brod lg:text-brod-lg">
        Det första att förstå är att luften som redan står i rummet inte är problemet. En källare på 96 m³ vid 15
        grader och 75 procent luftfuktighet bär 0,9 liter vatten, och att ta ner den till 55 procent kostar
        maskinen ett kvarts glas. Det som avgör storleken är vattnet som kommer in varje dygn, genom väggen och med
        uteluften. Så jag räknar på augusti, som är den värsta månaden, och så här går det till.
      </p>
      <ol class="m-0 mt-4 pl-6 list-decimal text-brod lg:text-brod-lg">
        <li class="mb-2">
          Golvytan gånger takhöjden ger volymen. 40 kvm med 2,4 meter i tak blir 96 m³.
        </li>
        <li class="mb-2">
          Temperaturen du valde sätter vilken temperatur jag räknar på, 15 grader för ett uppvärmt utrymme och 10
          för ett ouppvärmt. Magnus-formeln säger hur mycket vatten luften rymmer vid den temperaturen, och målet är
          att ligga på 55 procent av det.
        </li>
        <li class="mb-2">
          Först tar jag ut det vatten som redan står i luften, alltså skillnaden mellan din fuktnivå och 55
          procent. Det är ett par deciliter och görs en gång.
        </li>
        <li class="mb-2">
          Sedan uteluften. Ett halvt luftbyte i timmen bär in augustiluft med 10 gram vatten per kubikmeter, och ju
          kallare utrymmet är, desto mer av det vattnet blir över när luften kylts. Det är därför ett kallt utrymme
          blir fuktigare av att du vädrar det på sommaren.
        </li>
        <li class="mb-2">
          Sedan marken. Varje kvadratmeter golv släpper upp 10, 40 eller 100 gram per dygn beroende på vilken
          fuktnivå du valde.
        </li>
        <li class="mb-2">
          De tre posterna lägger jag ihop och multiplicerar med 1,3, så att maskinen klarar dygnets vatten på
          ungefär 18 timmar och hygrostaten hinner stänga av den emellanåt.
        </li>
        <li>
          Till sist räknar jag om talet till det som står på lådan. Tillverkarna mäter en kondensmaskin vid 30
          grader och 80 procent luftfuktighet, och så är det aldrig i en svensk källare. Vid 15 grader ger en
          kondensmaskin ungefär 30 procent av sin märkta kapacitet. En sorptionsmaskin mäts vid 20 grader och 60
          procent, och den ger ungefär 80 procent av sin siffra vid 10 grader. Så när du väljer mellan sorption
          och kondens är det temperaturen i utrymmet du ska titta på.
        </li>
      </ol>

      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">Vad siffrorna vilar på</h3>
      <Tabellyta kolumner={3} class="mt-4">
        <table class="w-full border-collapse text-liten tabular-nums">
          <caption class="sr-only">Antaganden och källor i avfuktarkalkylatorn</caption>
          <thead>
            <tr class="border-b border-linje text-left">
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Vad</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Jag räknar med</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Källa eller antagande</th>
            </tr>
          </thead>
          <tbody>
            {
              antaganden.map((a) => (
                <tr>
                  <th scope="row" class:list={[CELL_KLASS, 'text-left font-normal']}>
                    {a.storhet}
                  </th>
                  <td class={CELL_KLASS}>{a.varde}</td>
                  <td class={CELL_KLASS}>
                    {a.grund}.{' '}
                    {a.url ? (
                      <a href={a.url} rel="nofollow" class={LANK_KLASS}>
                        {a.stod}
                      </a>
                    ) : (
                      a.stod
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </Tabellyta>

      <p class="m-0 mt-6 text-brod lg:text-brod-lg">
        Två av raderna är gissningar jag gärna vill byta mot mätningar: hur mycket fukt som kommer upp ur marken,
        och hur mycket en kondensmaskin tappar vid 15 grader. I höst ställer jag en avfuktare i en riktig källare
        och räknar liter i tanken, och då får formeln stå till svars.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Vad som är läst ur datablad och vad som är mätt står på sidan{' '}
        <a href="/om/sa-testar-vi/" class={LANK_KLASS}>Så testar vi</a>.
      </p>
    </section>

    <section>
      <Pennstreck id="las-vidare">Läs vidare</Pennstreck>
      <ul class="m-0 p-0 list-none">
        <li class="border-t border-linje">
          <a href="/luftavfuktare/" class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
            Alla luftavfuktare jag granskat, med tal ur databladen
          </a>
        </li>
        <li class="border-t border-linje">
          <a href="/fukt/avfuktare-kallare/" class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
            Så väljer du avfuktare till källaren
          </a>
        </li>
        <li class="border-t border-linje">
          <a href="/fukt/sorptionsavfuktare/" class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
            Därför tappar kondensavfuktaren farten när det blir kallt
          </a>
        </li>
      </ul>
    </section>

    <Faq fragor={FRAGOR} />
  </div>
</Bas>
