---
/**
 * Avfuktarkalkylatorn. Formuläret skickas som GET till samma sida och
 * beräkningen sker på servern, så sidan fungerar utan ett enda byte klient-JS.
 * Kostnaden är en serverfunktion per anrop, och den hålls nere med CDN-cache.
 * Se docs/SPEC-SIDMALLAR.md avsnitt 4.7.
 *
 * Formeln och alla antaganden ligger i src/lib/kalkyl/avfuktare.ts. Sidan räknar
 * ingenting själv, den visar bara resultatet och redovisar källorna.
 */
export const prerender = false;

import Bas from '../../layouts/Bas.astro';
import { formateraTal } from '../../lib/format';
import {
  fuktnivaEtikett,
  raknaAvfuktare,
  STANDARD,
  tolkaQuery,
  type AvfuktareResultat,
} from '../../lib/kalkyl/avfuktare';
import { CELL_KLASS, ETIKETT_KLASS, FALT_KLASS, LANK_KLASS } from '../../lib/kalkyl/stil';
import { hamtaButik, lagstaPris, produkterIKategori } from '../../lib/produkter';
import AvfuktareForm from '../../components/kalkyl/AvfuktareForm.astro';
import Faktaruta from '../../components/ui/Faktaruta.astro';
import Markering from '../../components/ui/Markering.astro';
import Pennstreck from '../../components/ui/Pennstreck.astro';
import Produktkort from '../../components/ui/Produktkort.astro';

Astro.locals.sidtyp = 'verktyg';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

const { indata } = tolkaQuery(Astro.url.searchParams);
const resultat = raknaAvfuktare(indata);

const fel = resultat.status === 'ogiltig' ? resultat.fel : {};
// Vid ogiltig indata visas standardvärdenas resultat, med en rad som säger det.
const visat: AvfuktareResultat = resultat.status === 'ogiltig' ? raknaAvfuktare(STANDARD) : resultat;
const visatIndata = resultat.status === 'ogiltig' ? STANDARD : indata;

/**
 * Fältens värden kommer från query-strängen som den skrevs, inte från de tolkade
 * talen: "tolv" eller "" blir NaN i tolkaQuery, och NaN i ett fält som läsaren
 * ska rätta är obrukbart.
 */
function faltVarde(nyckel: string, standard: number): string {
  const ra = Astro.url.searchParams.get(nyckel);
  if (ra !== null) return ra;
  return String(standard).replace('.', ',');
}
const ytaVarde = faltVarde('yta', STANDARD.ytaKvm);
const takhojdVarde = faltVarde('takhojd', STANDARD.takhojdM);

/**
 * Delbar länk. Hela tillståndet ligger redan i query-strängen, så adressen är
 * uträkningen. Den byggs av de tolkade värdena, inte av strängen läsaren skrev,
 * så att en delad länk alltid ger samma resultat som skärmen visar.
 */
const delaQuery = new URLSearchParams({
  yta: String(visatIndata.ytaKvm).replace('.', ','),
  takhojd: String(visatIndata.takhojdM).replace('.', ','),
  fukt: visatIndata.fuktniva,
  temp: visatIndata.temperatur,
});
const delaLank = new URL(`/rakna/avfuktare/?${delaQuery.toString()}`, Astro.site ?? Astro.url).toString();

const butik = await hamtaButik();

/**
 * Produkterna filtreras på typen vi rekommenderar och på märkt kapacitet.
 * Först de som klarar talet vi visar, sedan, om de är färre än tre, de som ligger
 * inom osäkerhetsintervallet. Aldrig en maskin under intervallets nedre kant.
 */
let traffar: string[] = [];
if (visat.status === 'ok') {
  const krav = visat.marktKapacitetLiter;
  const golv = visat.marktIntervall[0];
  const typ = visat.typ;

  const alla = await produkterIKategori('luftavfuktare');
  const kandidater = alla
    .filter((p) => String(p.specs['typ'] ?? '').toLowerCase().includes(typ))
    .map((p) => ({ slug: p.slug, kapacitet: Number(p.specs['kapacitet_liter_dygn']), pris: lagstaPris(p) ?? Infinity }))
    .filter((p) => Number.isFinite(p.kapacitet) && p.kapacitet >= golv)
    .sort((a, b) => a.pris - b.pris);

  traffar = [
    ...kandidater.filter((p) => p.kapacitet >= krav),
    ...kandidater.filter((p) => p.kapacitet < krav),
  ]
    .slice(0, 3)
    .map((p) => p.slug);
}

/**
 * Kolumner efter antal träffar, och aldrig bredare än läsbredden när de är få:
 * ett ensamt kort i en tredjedelsspalt (235 px) blir oläsligt, se
 * designgranskningen 2026-09-16 punkt 3.
 */
const kortSpalter =
  traffar.length >= 3
    ? 'lg:grid-cols-3'
    : traffar.length === 2
      ? 'lg:grid-cols-2'
      : 'lg:max-w-lasbredd';

const typtext =
  visat.status === 'ok' && visat.typ === 'kondens'
    ? 'Leta efter en kondensavfuktare. Den tar mest vatten per krona så länge utrymmet håller sig över 15 grader.'
    : 'Leta efter en sorptionsavfuktare. En kondensmaskin tappar fart under 15 grader och lägger till slut mer tid på att avfrosta än på att avfukta.';

/** Antagandena i tabellen under "Så räknar vi". Samma tal som konstanterna i kalkylen. */
const antaganden: { storhet: string; varde: string; grund: 'Källa' | 'Antagande'; stod: string; url?: string }[] = [
  {
    storhet: 'Mättnadsånghalt, 9,38 g/m³ vid 10 °C och 12,80 vid 15 °C',
    varde: 'Magnus-formeln',
    grund: 'Källa',
    stod: 'Lawrence 2005, BAMS 86(2)',
    url: 'https://journals.ametsoc.org/view/journals/bams/86/2/bams-86-2-225.xml',
  },
  {
    storhet: 'Målnivå i utrymmet',
    varde: '55 % RF',
    grund: 'Källa',
    stod: 'BBR 6:52 via Boverket sätter 75 % som kritiskt fukttillstånd',
    url: 'https://www.boverket.se/sv/byggande/forebygg-fel-brister-skador/risker/risker-fuktskador/fuktrisker-for-grund/krypgrund/risk-med-fukt-fran-uteluft-i-krypgrund/',
  },
  {
    storhet: 'Uteluftens ånghalt i augusti',
    varde: '10,0 g/m³',
    grund: 'Källa',
    stod: 'SMHI, 70 till 80 % RF i juli i inlandet',
    url: 'https://www.smhi.se/kunskapsbanken/meteorologi/luftfuktighet/olika-matt-pa-luftfuktighet',
  },
  {
    storhet: 'Luftomsättning',
    varde: '0,5 oms/h',
    grund: 'Antagande',
    stod: 'FoHMFS 2014:18 ger 0,35 l/s per m² i bostad. Att källare och krypgrund ventileras lika mycket är vår gissning',
    url: 'https://www.folkhalsomyndigheten.se/contentassets/641784832543443ea4eebe9b300c244e/fohmfs-2014-18.pdf',
  },
  {
    storhet: 'Fukt upp ur marken vid synligt mögel',
    varde: '100 g per m² och dygn',
    grund: 'Källa',
    stod: 'Kurnitski 2001 mätte 86 till 137 g per m² och dygn från bar mark',
    url: 'https://www.sciencedirect.com/science/article/abs/pii/S0360132300000135',
  },
  {
    storhet: 'Fukt upp ur marken vid medel och hög fukt',
    varde: '10 och 40 g per m² och dygn',
    grund: 'Antagande',
    stod: 'Vår gissning för en tät respektive kapillärt fuktig betongplatta. Kalkylatorns svagaste led',
  },
  {
    storhet: 'Dimensionerande temperatur',
    varde: '15 °C uppvärmt, 10 °C ouppvärmt',
    grund: 'Antagande',
    stod: 'Vårt val, satt så att det stämmer med en svensk källare i augusti',
  },
  {
    storhet: 'Marginal på summan',
    varde: '1,3',
    grund: 'Antagande',
    stod: 'Vårt val. LFS och Luftmiljöbutiken säger hellre för stor än för liten, utan siffra',
    url: 'https://www.lfs-web.se/avfuktare-valj-ratt-for-bast-ekonomi-och-sakrast-avfuktning/',
  },
  {
    storhet: 'Kondensmaskin vid 15 °C, andel av märkt kapacitet',
    varde: '0,30 (0,25 till 0,35)',
    grund: 'Antagande',
    stod: 'Interpolerat mellan Meacos mätpunkter vid 20 och 10 °C, ingen egen mätpunkt vid 15',
    url: 'https://blog.meaco.com/my-dehumidifier-is-bigger-than-your-dehumidifier-no-its-not/',
  },
  {
    storhet: 'Sorptionsmaskin vid 10 °C, andel av märkt kapacitet',
    varde: '0,80 (0,75 till 1,0)',
    grund: 'Källa',
    stod: 'Corroventa CTR STD-TT ger 0,76 och Meaco DD8L 0,99 vid 10 °C',
    url: 'https://www.corroventa.se/produkter/krypgrundsavfuktare/krypgrundsavfuktare-ctr-std-tt/',
  },
];
---

<Bas
  title="Avfuktarkalkylator: hur stor avfuktare behöver du?"
  description="Räkna ut hur många liter per dygn din avfuktare behöver klara utifrån yta, takhöjd och fuktnivå, och se maskinerna som klarar det."
  reklam={true}
  butikNamn={butik?.namn}
  brodsmulor={[
    { namn: 'Hantverkstips', href: '/' },
    { namn: 'Räkna själv', href: '/rakna/' },
    { namn: 'Avfuktarkalkylator' },
  ]}
  bred={true}
>
  <div class="mx-auto w-full max-w-lasbredd">
    <h1 class="m-0 font-serif text-h1 lg:text-h1-lg">Hur stor avfuktare behöver du?</h1>
    <p class="m-0 mt-4 text-ingress lg:text-ingress-lg">
      Fyll i ytan, takhöjden och hur fuktigt det är i dag, så får du hur många liter per dygn maskinen behöver klara.
      Resultatet är en marginal, inte ett exakt svar.
    </p>

    <div class="linjerat mt-8 lg:grid lg:grid-cols-2 lg:gap-8">
      {/* Formuläret ligger i src/components/kalkyl/AvfuktareForm.astro, så att
          <Kalkylator namn="avfuktare" /> i en artikel visar exakt samma fält. */}
      <AvfuktareForm indata={indata} varden={{ yta: ytaVarde, takhojd: takhojdVarde }} fel={fel} />

      <div class="mt-8 border-t border-linje pt-6 lg:mt-0 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8">
        {
          resultat.status === 'utanfor' ? (
            /* Ingen rubrik: rutan står före sidans första H2 och en H3 här
               skulle ge fel rubrikordning. */
            <Faktaruta>
              <p class="m-0 leading-6">{resultat.text}</p>
              <p class="m-0 leading-6">
                <a href="/fukt/">Läs mer om fukt i huset</a>
              </p>
            </Faktaruta>
          ) : (
            visat.status === 'ok' && (
              <>
                {resultat.status === 'ogiltig' && (
                  <p class="m-0 mb-2 text-liten text-varning">Visar standardvärden tills indatan är rättad.</p>
                )}
                <p class="m-0 text-etikett lg:text-etikett-lg uppercase text-blyerts-2">Minst</p>
                {/* Enheten står på samma rad som talet, på talets baslinje
                    (DESIGN.md avsnitt 5.8). Radbryter på smal skärm. */}
                <p class="m-0 mt-1 flex flex-wrap items-baseline gap-x-2">
                  <span class="font-serif text-siffra lg:text-siffra-lg text-blyerts">
                    <Markering>{visat.marktKapacitetLiter}</Markering>
                  </span>
                  <span class="text-ingress lg:text-ingress-lg">liter per dygn</span>
                </p>
                <p class="m-0 mt-2 text-liten text-blyerts-2">
                  märkt kapacitet, uppgiven vid {visat.kapacitetVillkor}, motsvarar cirka{' '}
                  {visat.literPerDygnVerklig} liter i din källare vid {visat.temperaturC} grader
                </p>
                <p class="m-0 mt-1 text-liten text-blyerts-2">
                  {formateraTal(visat.volymM3, 1)} m³, {fuktnivaEtikett(visatIndata.fuktniva)}
                </p>
                <p class="m-0 mt-4 text-brod">{typtext}</p>
                <p class="m-0 mt-2 text-brod">
                  Omräkningen mellan lådans siffra och verkligheten är det osäkraste i kalkylen, så läs talet som{' '}
                  {visat.marktIntervall[0]} till {visat.marktIntervall[1]} liter. Köp hellre en för stor maskin än en för
                  liten. En för liten går dygnet runt och håller ändå inte 55 procent.
                </p>
                <p class="m-0 mt-2">
                  <a href="#sa-raknar-vi" class:list={['inline-flex min-h-11 items-center', LANK_KLASS]}>
                    Så räknar vi
                  </a>
                </p>

                {/* Dela. Uträkningen står i adressen, så ett skrivskyddat fält
                    räcker: markera och kopiera fungerar utan en rad JavaScript.
                    En kopieringsknapp kan komma senare som React-ö. */}
                <div class="mt-4 border-t border-linje pt-4">
                  <label for="dela" class={ETIKETT_KLASS}>
                    Dela uträkningen
                  </label>
                  <input
                    id="dela"
                    type="text"
                    readonly
                    value={delaLank}
                    class:list={[FALT_KLASS, 'border-blyerts-2']}
                  />
                  <p class="m-0 mt-1 text-liten text-blyerts-2">
                    Adressen innehåller dina värden. Markera och kopiera.
                  </p>
                </div>
              </>
            )
          )
        }
      </div>
    </div>

    <section>
      <Pennstreck id="produkter-som-klarar-det">Produkter som klarar det</Pennstreck>
      {
        traffar.length > 0 ? (
          /* Kolumnerna följer antalet träffar. En ensam produkt i en
             tredjedelsspalt blir 235 px bred, och då skriver kortets etiketter
             över värdena. Ett kompakt kort får aldrig bli smalare än 20 rem.
             Designgranskningen 2026-09-16 punkt 3. */
          <div class:list={['grid gap-4', kortSpalter]}>
            {traffar.map((slug) => (
              <Produktkort produkt={slug} variant="kompakt" modul="kalkylator" />
            ))}
          </div>
        ) : (
          <Faktaruta>
            <p class="m-0 leading-6">
              Vi har inte granskat någon avfuktare i den storleken. <a href="/luftavfuktare/">Se alla vi granskat.</a>
            </p>
          </Faktaruta>
        )
      }
      <p class="m-0 mt-4">
        <a href="/luftavfuktare/" class:list={['inline-flex min-h-11 items-center', LANK_KLASS]}>
          Alla avfuktare vi granskat
        </a>
      </p>
    </section>

    <section>
      <Pennstreck id="sa-raknar-vi">Så räknar vi</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        Luften i rummet är inte problemet. En källare på 96 m³ vid 15 grader och 75 procent luftfuktighet bär 0,9 liter
        vatten, och att ta ner den till 55 procent kostar ett kvarts glas. Maskinen köps för det som kommer in varje
        dygn, och vi räknar på augusti, den värsta månaden.
      </p>
      <ol class="m-0 mt-4 pl-6 list-decimal text-brod lg:text-brod-lg">
        <li class="mb-2">
          Yta gånger takhöjd ger volymen. 40 kvm med 2,4 meter i tak blir 96 m³.
        </li>
        <li class="mb-2">
          Temperaturen du valt sätter den dimensionerande temperaturen, 15 grader för uppvärmt och 10 för ouppvärmt.
          Magnus-formeln ger hur mycket vatten luften rymmer vid den temperaturen, och 55 procent av det är målet.
        </li>
        <li class="mb-2">
          Vi tar först ut det vatten som redan står i luften, skillnaden mellan din fuktnivå och 55 procent. Det är ett
          par deciliter, en engångspost.
        </li>
        <li class="mb-2">
          Sedan uteluften. Ett halvt luftbyte i timmen bär in fuktig augustiluft på 10 g per m³, och ju kallare
          utrymmet är desto mer av den fukten blir över. Därför blir ett kallt utrymme fuktigare av att vädras.
        </li>
        <li class="mb-2">
          Sedan marken. Varje kvadratmeter golv avger 10, 40 eller 100 gram per dygn beroende på vilken fuktnivå du
          valde.
        </li>
        <li class="mb-2">
          De tre posterna läggs ihop och multipliceras med 1,3, så att maskinen klarar dygnet på ungefär 18 timmar och
          hygrostaten hinner stänga av.
        </li>
        <li>
          Till sist räknas talet om till den kapacitet som står på lådan. Tillverkarna mäter vid 30 grader och 80
          procent luftfuktighet, förhållanden som inte finns i en svensk källare, så en kondensmaskin ger ungefär 30
          procent av sin märkta kapacitet vid 15 grader. En sorptionsmaskin mäts vid 20 grader och 60 procent och ger
          ungefär 80 procent av den siffran vid 10 grader.
        </li>
      </ol>

      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">Vad siffrorna vilar på</h3>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full border-collapse text-liten tabular-nums">
          <caption class="sr-only">Antaganden och källor i avfuktarkalkylatorn</caption>
          <thead>
            <tr class="border-b border-linje text-left">
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Storhet</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Vi räknar med</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Källa eller antagande</th>
            </tr>
          </thead>
          <tbody>
            {
              antaganden.map((a) => (
                <tr>
                  <th scope="row" class:list={[CELL_KLASS, 'text-left font-normal']}>
                    {a.storhet}
                  </th>
                  <td class={CELL_KLASS}>{a.varde}</td>
                  <td class={CELL_KLASS}>
                    {a.grund}.{' '}
                    {a.url ? (
                      <a href={a.url} rel="nofollow" class={LANK_KLASS}>
                        {a.stod}
                      </a>
                    ) : (
                      a.stod
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="m-0 mt-6 text-brod lg:text-brod-lg">
        Vi verifierar formeln med egna mätningar under hösten.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Metoden bakom våra siffror står på{' '}
        <a href="/om/sa-testar-vi/" class={LANK_KLASS}>Så testar vi</a>.
      </p>
    </section>

    <section>
      <Pennstreck id="las-vidare">Läs vidare</Pennstreck>
      <ul class="m-0 p-0 list-none">
        <li class="border-t border-linje">
          <a href="/luftavfuktare/" class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
            Alla luftavfuktare vi granskat
          </a>
        </li>
        <li class="border-t border-linje">
          <a href="/fukt/avfuktare-kallare/" class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
            Rätt avfuktare till källaren
          </a>
        </li>
        <li class="border-t border-linje">
          <a href="/fukt/sorptionsavfuktare/" class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
            Sorption eller kondens, temperaturen avgör
          </a>
        </li>
      </ul>
    </section>
  </div>
</Bas>
