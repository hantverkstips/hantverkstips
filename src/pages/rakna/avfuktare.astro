---
/**
 * Avfuktarkalkylatorn. Formuläret skickas som GET till samma sida och
 * beräkningen sker på servern, så sidan fungerar utan ett enda byte klient-JS.
 * Kostnaden är en serverfunktion per anrop, och den hålls nere med CDN-cache.
 * Se docs/SPEC-SIDMALLAR.md avsnitt 4.7.
 */
export const prerender = false;

import Bas from '../../layouts/Bas.astro';
import { formateraTal } from '../../lib/format';
import {
  FUKTNIVAER,
  fuktnivaEtikett,
  raknaAvfuktare,
  STANDARD,
  tolkaQuery,
  type AvfuktareResultat,
} from '../../lib/kalkyl/avfuktare';
import { hamtaButik, lagstaPris, produkterIKategori } from '../../lib/produkter';
import Faktaruta from '../../components/ui/Faktaruta.astro';
import Markering from '../../components/ui/Markering.astro';
import Pennstreck from '../../components/ui/Pennstreck.astro';
import Produktkort from '../../components/ui/Produktkort.astro';

Astro.locals.sidtyp = 'verktyg';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

const { indata } = tolkaQuery(Astro.url.searchParams);
const resultat = raknaAvfuktare(indata);

const fel = resultat.status === 'ogiltig' ? resultat.fel : {};
// Vid ogiltig indata visas standardvärdenas resultat, med en rad som säger det.
const visat: AvfuktareResultat = resultat.status === 'ogiltig' ? raknaAvfuktare(STANDARD) : resultat;
const visatIndata = resultat.status === 'ogiltig' ? STANDARD : indata;

/**
 * Fältens värden kommer från query-strängen som den skrevs, inte från de tolkade
 * talen: "tolv" eller "" blir NaN i tolkaQuery, och NaN i ett fält som läsaren
 * ska rätta är obrukbart.
 */
function faltVarde(nyckel: string, standard: number): string {
  const ra = Astro.url.searchParams.get(nyckel);
  if (ra !== null) return ra;
  return String(standard).replace('.', ',');
}
const ytaVarde = faltVarde('yta', STANDARD.ytaKvm);
const takhojdVarde = faltVarde('takhojd', STANDARD.takhojdM);

const butik = await hamtaButik();

let traffar: string[] = [];
if (visat.status === 'ok') {
  const alla = await produkterIKategori('luftavfuktare');
  traffar = alla
    .filter((p) => {
      const kapacitet = Number(p.specs['kapacitet_liter_dygn']);
      if (!Number.isFinite(kapacitet) || kapacitet < visat.literPerDygn) return false;
      if (visat.typ === 'sorption' && String(p.specs['typ']).toLowerCase() !== 'sorption') return false;
      return true;
    })
    .sort((a, b) => (lagstaPris(a) ?? Infinity) - (lagstaPris(b) ?? Infinity))
    .slice(0, 3)
    .map((p) => p.slug);
}

const faltKlass =
  'w-full min-h-12 rounded-sm border bg-papper px-3 text-brod text-blyerts tabular-nums';
const etikettKlass = 'block mb-1 font-bold text-blyerts';
---

<Bas
  title="Avfuktarkalkylator: hur stor avfuktare behöver du? · Hantverkstips"
  description="Räkna ut hur många liter per dygn din avfuktare behöver klara utifrån yta, takhöjd och fuktnivå, och se maskinerna som klarar det."
  reklam={true}
  butikNamn={butik?.namn}
  brodsmulor={[
    { namn: 'Hantverkstips', href: '/' },
    { namn: 'Räkna själv', href: '/rakna/' },
    { namn: 'Avfuktarkalkylator' },
  ]}
  bred={true}
>
  <div class="mx-auto w-full max-w-lasbredd">
    <h1 class="m-0 font-serif text-h1 lg:text-h1-lg">Hur stor avfuktare behöver du?</h1>
    <p class="m-0 mt-4 text-ingress lg:text-ingress-lg">
      Platshållartext. Fyll i ytan, takhöjden och hur fuktigt det är i dag, så får du hur många liter per dygn maskinen
      behöver klara. Resultatet är en marginal, inte ett exakt svar.
    </p>

    <div class="linjerat mt-8 lg:grid lg:grid-cols-2 lg:gap-8">
      <form method="get" action="/rakna/avfuktare/">
        <div class="mb-4">
          <label for="yta" class={etikettKlass}>Yta</label>
          <div class="flex items-center gap-2">
            <input
              id="yta"
              name="yta"
              type="text"
              inputmode="decimal"
              value={ytaVarde}
              aria-describedby={fel.ytaKvm ? 'yta-fel' : undefined}
              class:list={[faltKlass, fel.ytaKvm ? 'border-varning' : 'border-blyerts-2']}
            />
            <span class="text-brod text-blyerts-2">kvm</span>
          </div>
          {fel.ytaKvm && <p id="yta-fel" class="m-0 mt-1 text-liten text-varning">{fel.ytaKvm}</p>}
        </div>

        <div class="mb-4">
          <label for="takhojd" class={etikettKlass}>Takhöjd</label>
          <div class="flex items-center gap-2">
            <input
              id="takhojd"
              name="takhojd"
              type="text"
              inputmode="decimal"
              value={takhojdVarde}
              aria-describedby={fel.takhojdM ? 'takhojd-fel' : undefined}
              class:list={[faltKlass, fel.takhojdM ? 'border-varning' : 'border-blyerts-2']}
            />
            <span class="text-brod text-blyerts-2">m</span>
          </div>
          {fel.takhojdM && <p id="takhojd-fel" class="m-0 mt-1 text-liten text-varning">{fel.takhojdM}</p>}
        </div>

        <fieldset class="m-0 mb-4 p-0 border-0">
          <legend class:list={[etikettKlass, 'p-0']}>Fuktnivå</legend>
          {
            FUKTNIVAER.map((f) => (
              <label class="flex min-h-11 items-center gap-2 text-brod">
                <input type="radio" name="fukt" value={f.varde} checked={indata.fuktniva === f.varde} />
                {f.etikett}
              </label>
            ))
          }
        </fieldset>

        <div class="mb-6">
          <label class="flex min-h-11 items-center gap-2 text-brod">
            <input type="checkbox" name="uppvarmt" value="1" checked={indata.uppvarmt} />
            <span class="font-bold">Uppvärmt</span>
            <span>Ja, över 15 grader</span>
          </label>
        </div>

        <button
          type="submit"
          class="inline-flex min-h-12 items-center rounded-md border-2 border-blyerts px-5 py-3 font-bold text-blyerts hover:bg-blyerts hover:text-papper"
        >
          Räkna ut
        </button>
      </form>

      <div class="mt-8 border-t border-linje pt-6 lg:mt-0 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8">
        {
          resultat.status === 'utanfor' ? (
            /* Ingen rubrik: rutan står före sidans första H2 och en H3 här
               skulle ge fel rubrikordning. */
            <Faktaruta>
              <p class="m-0 leading-6">{resultat.text}</p>
              <p class="m-0 leading-6">
                <a href="/fukt/">Läs mer om fukt i huset</a>
              </p>
            </Faktaruta>
          ) : (
            visat.status === 'ok' && (
              <>
                {resultat.status === 'ogiltig' && (
                  <p class="m-0 mb-2 text-liten text-varning">Visar standardvärden tills indatan är rättad.</p>
                )}
                <p class="m-0 text-etikett lg:text-etikett-lg uppercase text-blyerts-2">Minst</p>
                <p class="m-0 mt-1 font-serif text-siffra lg:text-siffra-lg text-blyerts">
                  <Markering>{visat.literPerDygn}</Markering>
                </p>
                <p class="m-0 mt-2 text-ingress lg:text-ingress-lg">liter per dygn</p>
                <p class="m-0 mt-2 text-liten text-blyerts-2">
                  vid 20 °C och 60 % RF, {formateraTal(visat.volymM3, 1)} m³, {fuktnivaEtikett(visatIndata.fuktniva)}
                </p>
                <p class="m-0 mt-4 text-brod">
                  Platshållartext. Kapaciteten på lådan mäts vid 30 grader och 80 procent luftfuktighet, förhållanden
                  som inte finns i en svensk källare. Räkna med ungefär hälften vid 20 grader.
                </p>
                <p class="m-0 mt-2 text-brod">
                  Rekommenderad typ: {visat.typ === 'sorption' ? 'sorption' : 'kondens'}
                </p>
                <p class="m-0 mt-2">
                  <a
                    href="#sa-raknar-vi"
                    class="inline-flex min-h-11 items-center text-penna underline decoration-1 underline-offset-2 hover:decoration-2"
                  >
                    Så räknar vi
                  </a>
                </p>
              </>
            )
          )
        }
      </div>
    </div>

    <section>
      <Pennstreck id="produkter-som-klarar-det">Produkter som klarar det</Pennstreck>
      {
        traffar.length > 0 ? (
          <div class="grid gap-4 lg:grid-cols-3">
            {traffar.map((slug) => (
              <Produktkort produkt={slug} variant="kompakt" modul="kalkylator" />
            ))}
          </div>
        ) : (
          <Faktaruta>
            <p class="m-0 leading-6">
              Vi har inte testat någon avfuktare i den storleken. <a href="/luftavfuktare/">Se alla vi testat.</a>
            </p>
          </Faktaruta>
        )
      }
      <p class="m-0 mt-4">
        <a
          href="/luftavfuktare/"
          class="inline-flex min-h-11 items-center text-penna underline decoration-1 underline-offset-2 hover:decoration-2"
        >
          Alla avfuktare vi testat
        </a>
      </p>
    </section>

    <section>
      <Pennstreck id="sa-raknar-vi">Så räknar vi</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        Platshållartext. Formeln är preliminär: den räknar volym gånger en faktor per fuktnivå, med ett påslag för
        ouppvärmda utrymmen. Produktexperten levererar den slutliga formeln med källa innan sidan publiceras, och tills
        dess ska du läsa siffran som en storleksordning.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Metoden bakom våra siffror står på{' '}
        <a href="/om/sa-testar-vi/" class="text-penna underline decoration-1 underline-offset-2 hover:decoration-2">
          Så testar vi
        </a>
        .
      </p>
    </section>

    <section>
      <Pennstreck id="las-vidare">Läs vidare</Pennstreck>
      <ul class="m-0 p-0 list-none">
        <li class="border-t border-linje">
          <a
            href="/luftavfuktare/"
            class="flex min-h-11 items-center py-2 text-penna underline decoration-1 underline-offset-2 hover:decoration-2"
          >
            Alla luftavfuktare vi granskat
          </a>
        </li>
        <li class="border-t border-linje">
          <a
            href="/fukt/avfuktare-kallare/"
            class="flex min-h-11 items-center py-2 text-penna underline decoration-1 underline-offset-2 hover:decoration-2"
          >
            Rätt avfuktare till källaren
          </a>
        </li>
        <li class="border-t border-linje">
          <a
            href="/fukt/sorptionsavfuktare/"
            class="flex min-h-11 items-center py-2 text-penna underline decoration-1 underline-offset-2 hover:decoration-2"
          >
            Sorption eller kondens, temperaturen avgör
          </a>
        </li>
      </ul>
    </section>
  </div>
</Bas>
