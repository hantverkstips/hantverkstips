---
/**
 * Grannemedgivande: krävs det, krävs det inte, eller blir det bygglov oavsett?
 * Och när det krävs, ett medgivande att skriva ut och låta grannen skriva
 * under. Formuläret skickas som GET till samma sida och svaret räknas på
 * servern, så sidan fungerar utan ett enda byte klient-JS.
 *
 * Reglerna, lagrummen och all text som modulen äger ligger i
 * src/lib/kalkyl/grannemedgivande.ts. Sidan bedömer ingenting själv.
 *
 * Adressen bär bara åtgärden, måtten, planen och vad som ligger på andra
 * sidan gränsen. Blanketten har tomma rader för namn, fastighetsbeteckningar
 * och adresser, så inga personuppgifter går genom webbläsaren eller loggarna
 * (specen beslut 1). Ett värde ur adressen skrivs aldrig ut utan att ha gått
 * genom tolkaQuery.
 *
 * Avvikelse från SPEC-SIDMALLAR 4.7, avsiktlig: blanketten är verktygets
 * andra halva och står direkt under svaret, före "Därför blev svaret så".
 *
 * Spec: docs/briefer/spec-kalkyl-grannemedgivande-2026-09-28.md avsnitt 4.
 * Ingen produkt, inget reklamband.
 */
export const prerender = false;

import { artikelUrl, publicerade } from '../../lib/innehall';
import { tillKortArtikel, type KortData } from '../../lib/kort';
import { hittaKalkylator } from '../../lib/kalkyl/register';
import { arPelare } from '../../lib/pelare';
import {
  altanraknarQuery,
  antagandeKallor,
  ANTAGANDEN,
  ATGARD_ORDNING,
  ATGARDSTABELL,
  avgorandeRegel,
  BOVERKET_NARA_GRANS_URL,
  bytAtgardQuery,
  delbarQuery,
  raknaGrannemedgivande,
  STANDARD,
  talText,
  TEXT,
  tolkaQuery,
  type Atgard,
  type GrannemedgivandeIndata,
  type TalNyckel,
} from '../../lib/kalkyl/grannemedgivande';
import { LANK_KLASS } from '../../lib/kalkyl/stil';
import { verktygsillustration } from '../../lib/verktygsbild';
import GrannemedgivandeBlankett from '../../components/kalkyl/GrannemedgivandeBlankett.astro';
import GrannemedgivandeForm from '../../components/kalkyl/GrannemedgivandeForm.astro';
import Artikelrutnat from '../../components/ui/Artikelrutnat.astro';
import Faq from '../../components/ui/Faq.astro';
import Illustration from '../../components/ui/Illustration.astro';
import Pennstreck from '../../components/ui/Pennstreck.astro';
import Statusrad from '../../components/ui/Statusrad.astro';
import Tabellyta from '../../components/ui/Tabellyta.astro';
import Raknarsida from '../../components/vyer/Raknarsida.astro';

Astro.locals.sidtyp = 'verktyg';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

/** Slug, namn och beskrivning på ett ställe: brödsmulan, og:image och WebApplication läser samma. */
const SLUG = 'grannemedgivande';
const VERKTYGSNAMN = 'Grannemedgivande';
/* 120 till 155 tecken, med ordet blankett (checklistan 4). */
const BESKRIVNING =
  'Se om bygget nära tomtgränsen kräver grannemedgivande enligt reglerna från 1 december 2025, och skriv ut en blankett utan att lämna e-post.';
/* Högst 44 tecken, börjar med Grannemedgivande, med mall eller blankett (checklistan 3). */
const titel = 'Grannemedgivande, gratis mall att skriva ut';

/* Gränssnittstext, ordagrant ur specen och skillen nytt-verktyg. */
/*
 * Beskedsräknare (specen 12.8): vid ogiltigt värde visar spalten bara den här
 * varningen och den delbara adressen, inget svar, inga regler och inga råd.
 * Varningen är likadan på alla beskedsräknare och säger att svaret kommer när
 * fältet är rättat.
 */
const BESKEDSVARNING = 'Ett av fälten gick inte att läsa. Rätta värdet där felet står, så visar jag svaret.';

const S = TEXT.sida;

const q = Astro.url.searchParams;
const { indata } = tolkaQuery(q);
const resultat = raknaGrannemedgivande(indata);
const fel = resultat.status === 'ogiltig' ? resultat.fel : {};
/*
 * Vid ogiltig indata räknas standardsvaret för samma åtgärd ändå, eftersom den
 * delbara adressen byggs av det. Det visas inte (specen 12.8).
 */
const ogiltig = resultat.status === 'ogiltig';
const visatIndata: GrannemedgivandeIndata =
  resultat.status === 'ogiltig' ? { ...STANDARD, atgard: fel.atgard ? STANDARD.atgard : indata.atgard } : indata;
const visat = raknaGrannemedgivande(visatIndata);
if (visat.status !== 'ok') throw new Error('[grannemedgivande] Standardvärdena ska alltid ge ett svar');

/*
 * Fältens värden: strängarna som de skrevs i adressen, bara för nycklar
 * verktyget känner. Saknas nyckeln visar formuläret talet ur indata.
 */
const TALNYCKLAR: (TalNyckel | 'grans')[] = [
  'grans', 'bya', 'nock', 'ovriga', 'area', 'ovrigatb', 'plankhojd', 'plankavstand', 'golv', 'altanavstand',
];
const varden: Partial<Record<TalNyckel | 'grans', string>> = {};
for (const k of TALNYCKLAR) {
  const ra = q.get(k);
  if (ra !== null) varden[k] = ra;
}

/** Åtgärdslänkarna, som bär de gemensamma värdena (specen 3.1). */
const atgardHref = Object.fromEntries(
  ATGARD_ORDNING.map((a) => [a, '/rakna/grannemedgivande/?' + bytAtgardQuery(indata, a).toString()]),
) as Record<Atgard, string>;

/** Delbar länk, byggd av de tolkade värdena. */
const delaLank = new URL(
  '/rakna/grannemedgivande/?' + delbarQuery(visatIndata).toString(),
  Astro.site ?? Astro.url,
).toString();

/** Blanketten visas bara när svaret är krävs och läsarens egna värden gick att läsa. */
const visaBlankett = resultat.status === 'ok' && visat.utfall === 'kravs';

/** Länken till altanräknaren för en altan utan tak. */
const altanQuery = altanraknarQuery(visatIndata);

/** Tabellen över åtgärder: verktyget körs på varje rad, så den kan aldrig säga något annat. */
const atgardsrader = ATGARDSTABELL.map((rad) => {
  const r = raknaGrannemedgivande(rad.indata);
  if (r.status !== 'ok') throw new Error(`[grannemedgivande] Tabellraden ${rad.nyckel} ska ge ett svar`);
  return { etikett: TEXT.tabell.rad[rad.nyckel], medgivande: TEXT.tabell.utfall[r.utfall], lagrum: avgorandeRegel(r).lagrum };
});

const kallor = antagandeKallor();

/** Samma klasser som u-värdets tabeller: cellklasserna en gång på <table>. */
const TABELL_KLASS =
  'w-full border-collapse text-liten tabular-nums [&_th]:p-2 [&_td]:p-2 [&_th]:align-top [&_td]:align-top [&_th]:text-left [&_tbody_th]:[font-weight:inherit] [&_tr]:border-b [&_tr]:border-linje [&_th]:text-blyerts [&_td]:text-blyerts [&_thead_th]:text-etikett [&_thead_th]:uppercase [&_thead_th]:text-blyerts-2';

/** Skissen står i kortet Så räknar jag. Huvudet har ingen bild sedan fas C (DESIGN.md 5.8). */
const illustration = verktygsillustration(SLUG);

/*
 * Svarsytan, fas C (spec-designlyft-c-2026-10-02 avsnitt 13): svaret i ord som
 * på bygglovsräknaren, med statusraden (ok när inget medgivande krävs) och
 * paragrafen bakom svaret. Ny text är hantverkarens. Klartexten har
 * platshållarna {svar} (ordet och resten, "Ja, medgivande krävs"), {atgard}
 * (raden över svaret, "Komplementbyggnad, 12 m², 2 m från gränsen" och så
 * vidare), {grans} (avståndet till gränsen, m) och {lagrum} (paragrafen).
 */
const lagrumSvar = avgorandeRegel(visat).lagrum;
const KLARTEXT =
  'För ”{atgard}” blir svaret ”{svar}”. Plan- och bygglagen kräver grannens skriftliga medgivande för lovfria byggen närmare tomtgränsen än 4,5 m. Det står i 9 kap. 34 och 35 §§.'; // grannemedgivande.klartext
const klartext = KLARTEXT.replace(
  '{svar}',
  // Bygglovsfallet är en mening, ”Bygglov krävs för det här bygget”, och får inget komma.
  `${TEXT.utfall[visat.utfall].ord}${visat.utfall === 'bygglov' ? ' ' : ', '}${TEXT.utfall[visat.utfall].rest}`,
)
  .replace('{atgard}', TEXT.meta[visatIndata.atgard](visatIndata))
  .replace('{grans}', talText(visatIndata.gransM))
  .replace('{lagrum}', lagrumSvar);

const LAS_VIDARE = [
  { href: '/altan/bygglov-altan/', text: S['las-vidare']['altan-bygglov-altan'] },
  { href: '/rakna/bygglov-altan/', text: S['las-vidare']['rakna-bygglov-altan'] },
  { href: '/altan/bygga-altan/', text: S['las-vidare']['altan-bygga-altan'] },
  { href: BOVERKET_NARA_GRANS_URL, text: S['las-vidare'].boverket },
];
/**
 * Läs vidare: artiklarna som artikelkort, räknarna med registrets namn som på
 * hubben. Boverkets sida står kvar som länk under korten, med listans text.
 */
const artiklar = [...(await publicerade('guider')), ...(await publicerade('kunskap'))];
const lasVidare: KortData[] = [];
const lasVidareLankar: { href: string; text: string }[] = [];
for (const l of LAS_VIDARE) {
  const e = artiklar.find((a) => artikelUrl(a) === l.href);
  if (e) {
    const { niva: _niva, ...kort } = tillKortArtikel(e);
    lasVidare.push(kort);
    continue;
  }
  const k = l.href.startsWith('/rakna/') ? hittaKalkylator(l.href.replace(/^\/rakna\/|\/$/g, '')) : undefined;
  const pelare = k?.pelare?.[0];
  if (k && pelare && arPelare(pelare)) {
    lasVidare.push({
      etikett: 'Räkna själv',
      rubrik: k.namn,
      beskrivning: k.rad,
      pelare,
      href: l.href,
      // Artikelrutnat läser inte typen; kortet står varken i ett typfilter eller sorteras.
      typ: 'kunskap',
      sorteringsdatum: new Date(0),
    });
    continue;
  }
  lasVidareLankar.push(l);
}
---

<Raknarsida
  slug={SLUG}
  namn={VERKTYGSNAMN}
  titel={titel}
  beskrivning={BESKRIVNING}
  rubrik={S.h1}
  delaUrl={ogiltig ? undefined : delaLank}
  saRaknarId="sa-raknar-jag"
>
  <p slot="ingress">{S.ingress}</p>

  {/* Formuläret ligger i src/components/kalkyl/GrannemedgivandeForm.astro, så att
      <Kalkylator namn="grannemedgivande" /> i artikeln visar samma fält. */}
  <GrannemedgivandeForm slot="formular" indata={indata} varden={varden} fel={fel} atgardHref={atgardHref} />

  <Fragment slot="svar">
    {/* Beskedsräknare: vid ogiltigt värde står bara varningen, inget svar (specen 12.8). */}
    {ogiltig && <p class="text-liten text-varning">{BESKEDSVARNING}</p>}
    {
      !ogiltig && (
        <>
          {/* Svaret är ett ord: det står i Zilla Slab i stället för det stora talet. */}
          <div>
            <p class="text-liten text-blyerts-2">{TEXT.meta[visatIndata.atgard](visatIndata)}</p>
            <p class="flex flex-wrap items-baseline gap-x-2 text-blyerts">
              <span class="font-serif text-h2">{TEXT.utfall[visat.utfall].ord}</span>
              <span class="text-brod">{TEXT.utfall[visat.utfall].rest}</span>
            </p>
          </div>
          <div class="text-brod">
            <Statusrad
              ton={visat.utfall === 'kravs-inte' ? 'ok' : 'varning'}
              text={TEXT.utfall[visat.utfall].besked}
            />
            <p class="mt-1! text-liten text-blyerts-2">{lagrumSvar}</p>
          </div>
          {visat.utfall === 'kravs' && (
            <div>
              <ul class="m-0 p-0 list-none text-brod">
                {visat.mottagare.map((m) => (
                  <li class="border-t border-linje py-2">{TEXT.mottagare[m]}</li>
                ))}
              </ul>
              {visaBlankett && (
                <p class="mt-1!">
                  <a href="#medgivandet" class:list={['inline-flex min-h-11 items-center', LANK_KLASS]}>
                    {TEXT.spalt['lank-blankett']}
                  </a>
                </p>
              )}
            </div>
          )}
          <p class="text-liten text-blyerts">{klartext}</p>
        </>
      )
    }
  </Fragment>

  {
    !ogiltig && (
      <Fragment slot="darfor">
        <Pennstreck id="darfor-blev-svaret-sa" utanLuft>
          Därför blev svaret så
        </Pennstreck>
        <div class="darfor">
          {visat.regler.map((r) => (
            <div>
              <span class="block text-etikett lg:text-etikett-lg uppercase text-blyerts-2">{TEXT.slag[r.slag]}</span>
              <p>{TEXT.regel[r.nyckel](visatIndata)}</p>
              <p>{r.lagrum}</p>
            </div>
          ))}
        </div>
        {altanQuery && (
          <p class="m-0 mt-2">
            <a
              href={'/rakna/bygglov-altan/?' + altanQuery.toString()}
              class:list={['inline-flex min-h-11 items-center', LANK_KLASS]}
            >
              {S['lank-altanraknaren']}
            </a>
          </p>
        )}
      </Fragment>
    )
  }

  {
    !ogiltig && visat.gorInteDetHar.length > 0 && (
      <Fragment slot="gorInte">
        {/* Flera råd står i samma stycke efter "Gör inte det här.", vart och ett på egen rad. */}
        {visat.gorInteDetHar.map((g, i) => (
          <span class:list={[i > 0 && 'mt-3 block']}>{TEXT.gorInte[g]}</span>
        ))}
      </Fragment>
    )
  }

  <Fragment slot="saRaknarJag">
    {
      illustration && (
        <div class="pappersruta">
          <Illustration
            namn="rakna/grannemedgivande"
            alt={S['skiss-alt']}
            bildtext={S['skiss-bildtext']}
            class="my-0!"
          />
        </div>
      )
    }
    <ol class="m-0 mt-4 pl-6 list-decimal text-brod">
      {S.steg.map((s) => <li class="mb-2">{s}</li>)}
    </ol>
  </Fragment>

  <Fragment slot="efter">
    {/*
      Blanketten, direkt efter resonemanget (spec-designlyft-c avsnitt 13), bara
      vid krävs och när läsarens värden gick att läsa: annars skulle den
      förtrycka mått läsaren inte skrivit. En per mottagare. Utskriften styrs av
      [data-utskrift] i global.css.
    */}
    {
      visaBlankett && (
        <section>
          <Pennstreck id="medgivandet">{S['h2-medgivandet']}</Pennstreck>
          <p class="m-0 mb-6 max-w-lasbredd text-brod lg:text-brod-lg">{S.ledtext(visat.mottagare)}</p>
          {visat.mottagare.map((m, n) => (
            <GrannemedgivandeBlankett indata={visatIndata} mottagare={m} nyttBlad={n > 0} />
          ))}
        </section>
      )
    }

    {/* Antagandetabellen i läsbredd, ur kortet Så räknar jag (spec-designlyft-c avsnitt 9). */}
    <section class="max-w-lasbredd">
      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">Vad siffrorna vilar på</h3>
      <Tabellyta kolumner={3} class="mt-4">
        <table class={TABELL_KLASS}>
          <thead>
            <tr>
              <th scope="col">Vad</th>
              <th scope="col">Värde</th>
              <th scope="col">Källa eller antagande</th>
            </tr>
          </thead>
          <tbody>
            {
              ANTAGANDEN.map((a) => (
                <tr>
                  <th scope="row">{TEXT.antagande[a.nyckel]}</th>
                  <td>{a.varde}</td>
                  <td>
                    {a.typ}.{a.lagrum && ` ${a.lagrum}.`}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </Tabellyta>
      <ul class="m-0 mt-4 pl-6 text-liten">
        {
          kallor.map((k) => (
            <li>
              {/* Kommat på samma rad som </a>, annars blir radbrytningen ett mellanslag före kommat. */}
              <a href={k.url} rel="nofollow" class={LANK_KLASS}>{k.titel}</a>, {k.last}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="max-w-lasbredd">
      <Pennstreck id="vilka-atgarder">{S['h2-atgarder']}</Pennstreck>
      {S['atgarder-stycken'].map((t, i) => <p class:list={['m-0 text-brod lg:text-brod-lg', i > 0 && 'mt-4']}>{t}</p>)}
      <Tabellyta kolumner={3} class="mt-4">
        <table class={TABELL_KLASS}>
          <caption class="sr-only">{TEXT.tabell.caption}</caption>
          <thead>
            <tr>
              <th scope="col">{TEXT.tabell.atgard}</th>
              <th scope="col">{TEXT.tabell.medgivande}</th>
              <th scope="col">{TEXT.tabell.lagrum}</th>
            </tr>
          </thead>
          <tbody>
            {
              atgardsrader.map((r) => (
                <tr>
                  <th scope="row">{r.etikett}</th>
                  <td>{r.medgivande}</td>
                  <td>{r.lagrum}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </Tabellyta>
    </section>

    <section class="max-w-lasbredd">
      <Pennstreck id="vad-som-andrades">{S['h2-andrades']}</Pennstreck>
      {S['andrades-stycken'].map((t, i) => <p class:list={['m-0 text-brod lg:text-brod-lg', i > 0 && 'mt-4']}>{t}</p>)}
    </section>

    <section class="max-w-lasbredd">
      <Pennstreck id="vem-ar-granne">{S['h2-granne']}</Pennstreck>
      {S['granne-stycken'].map((t, i) => <p class:list={['m-0 text-brod lg:text-brod-lg', i > 0 && 'mt-4']}>{t}</p>)}
    </section>

    <section class="max-w-lasbredd">
      <Pennstreck id="vad-medgivandet-ska-innehalla">{S['h2-innehall']}</Pennstreck>
      {S['innehall-stycken'].map((t, i) => <p class:list={['m-0 text-brod lg:text-brod-lg', i > 0 && 'mt-4']}>{t}</p>)}
      <Pennstreck niva={3} id="grannehorande">{S['h3-grannehorande']}</Pennstreck>
      {S['grannehorande-stycken'].map((t, i) => <p class:list={['m-0 text-brod lg:text-brod-lg', i > 0 && 'mt-4']}>{t}</p>)}
      <Tabellyta kolumner={3} class="mt-4">
        <table class={TABELL_KLASS}>
          <caption class="sr-only">{TEXT.grannehorande.caption}</caption>
          <thead>
            <tr>
              {TEXT.grannehorande.kolumner.map((k) => <th scope="col">{k}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              TEXT.grannehorande.rader.map(([rubrik, medgivande, horande]) => (
                <tr>
                  <th scope="row">{rubrik}</th>
                  <td>{medgivande}</td>
                  <td>{horande}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </Tabellyta>
    </section>

    <section class="max-w-lasbredd">
      <Pennstreck id="om-grannen-sager-nej">{S['h2-nej']}</Pennstreck>
      {S['nej-stycken'].map((t, i) => <p class:list={['m-0 text-brod lg:text-brod-lg', i > 0 && 'mt-4']}>{t}</p>)}
    </section>

    <section>
      <Pennstreck id="las-vidare">Läs vidare</Pennstreck>
      {lasVidare.length > 0 && <Artikelrutnat kort={lasVidare} visaBeskrivning={false} visaMeta={false} />}
      {lasVidareLankar.length > 0 && (
        <ul class="m-0 mt-4 p-0 list-none max-w-lasbredd">
          {lasVidareLankar.map((l) => (
            <li class="border-t border-linje">
              <a href={l.href} class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
                {l.text}
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>

    <div class="max-w-lasbredd">
      <Faq fragor={S.faq} />
    </div>
  </Fragment>
</Raknarsida>
