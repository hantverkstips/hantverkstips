---
/**
 * U-värdesräknaren: U-värdet ur skikten eller ett känt U-värde, jämförelsen
 * mot Boverkets krav, vad det sparar i kilowattimmar och kronor, och
 * återbetalningstiden för ullen. Formuläret skickas som GET till samma sida och
 * räkningen sker på servern, så sidan fungerar utan ett enda byte klient-JS.
 * Se docs/SPEC-SIDMALLAR.md avsnitt 4.7 och
 * docs/briefer/spec-kalkyl-u-varde-2026-09-24.md.
 *
 * Formeln, konstanterna och all text som modulen äger ligger i
 * src/lib/kalkyl/u-varde.ts. Sidan räknar ingenting själv, den visar svaret och
 * redovisar källan bakom varje rad.
 *
 * Räkningen pekar inte ut någon produkt, så sidan har varken produktkort eller
 * reklamband.
 */
export const prerender = false;

import { ELPRIS_KALLA } from '../../lib/antaganden';
import { artikelUrl, publicerade } from '../../lib/innehall';
import { tillKortArtikel, type KortData } from '../../lib/kort';
import { hittaKalkylator } from '../../lib/kalkyl/register';
import { arPelare } from '../../lib/pelare';
import {
  antagandenFor,
  beskedKontext,
  beskedVarden,
  BOVERKET,
  bytLageQuery,
  delbarQuery,
  endecimal,
  GRADTIMMAR,
  heltal,
  MATERIAL,
  raknaUVarde,
  STANDARD,
  STANDARD_PER_DEL,
  TEXT,
  tolkaQuery,
  treDecimaler,
  uText,
  type GorInteText,
  type KallaRef,
  type Motstand,
  type RegelNyckel,
  type UVardeIndata,
} from '../../lib/kalkyl/u-varde';
import { LANK_KLASS } from '../../lib/kalkyl/stil';
import { verktygsillustration } from '../../lib/verktygsbild';
import UVardeForm from '../../components/kalkyl/UVardeForm.astro';
import Artikelrutnat from '../../components/ui/Artikelrutnat.astro';
import Faq from '../../components/ui/Faq.astro';
import Illustration from '../../components/ui/Illustration.astro';
import Matare from '../../components/ui/Matare.astro';
import Pennstreck from '../../components/ui/Pennstreck.astro';
import Statusrad from '../../components/ui/Statusrad.astro';
import Svarstal from '../../components/ui/Svarstal.astro';
import Tabellyta from '../../components/ui/Tabellyta.astro';
import Raknarsida from '../../components/vyer/Raknarsida.astro';

Astro.locals.sidtyp = 'verktyg';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

/** Slug, namn och beskrivning på ett ställe: brödsmulan, og:image och WebApplication läser samma. */
const SLUG = 'u-varde';
const VERKTYGSNAMN = 'U-värdesräknare';
const BESKRIVNING =
  'Beräkna U-värde skikt för skikt eller skriv in det du vet. Se om väggen, vinden eller golvet klarar Boverkets krav och vad tilläggsisolering sparar per år.';
const titel = 'Beräkna U-värde och vad mer isolering sparar';

/* Sidans egen text. Talen är desamma som i /el/u-varde/ och i konstanterna i modulen. */
const H1 = 'Klarar vinden eller väggen Boverkets krav på U-värde?';
const INGRESS =
  'Du har mätt ullen på vinden, eller du vet ungefär vad väggen består av, och undrar om det lönar sig att lägga på mer. Välj materialen som sitter där, med början närmast rummet, skriv hur tjocka de är och välj sedan det du vill lägga till. Då ser du U-värdet före och efter, om det klarar Boverkets krav och vad tillägget sparar i kilowattimmar och kronor om året. Om det inte räcker får du veta hur många millimeter till som behövs. Ett U-värde du redan känner till, till exempel ett fönsters, skriver du in direkt.';
const SKISS_ALT = 'Ett vindsbjälklag i genomskärning, med ett lager gammal ull och ett tjockare lager ny lösull ovanpå.';
/*
 * Skissen visas bara för vindsbjälklaget, i båda lägena (specen 12.38). Skissens
 * tal är skiktlägets; läget ”Jag vet U-värdet” börjar med Rockwools tal för
 * samma vind, och bildtexten säger det.
 */
const SKISS_BILDTEXT = `Skissen visar vinden som räknaren börjar med, där 300 mm lösull ligger ovanpå 200 mm gammal ull. Längst ner sitter innertaket och uppe i hörnen takstolarna, och de två strecken som stiger ur rummet och slutar under ullen är värmen på väg ut. Pilen går från den nya ullen till U-värdet före och efter, räknat skikt för skikt. Under ”Jag vet U-värdet” börjar formuläret i stället med Rockwools tal för samma vind, ${uText(STANDARD_PER_DEL.tak.uFore, 'tak')} och ${uText(STANDARD_PER_DEL.tak.uEfter, 'tak')}.`;
/**
 * Stegen i ord, en lista per läge och del (specen 12.38). STEG_SKIKT är
 * räkningen skikt för skikt, ett per steg i specen 2.7 steg 1 till 9.
 */
const STEG_SKIKT = [
  'Jag går igenom skikten inifrån och ut. Kommer jag till en ventilerad luftspalt slutar jag räkna där, och för utsidan tar jag samma motstånd som för den stilla luften inne.',
  'Varje skikt får sitt motstånd, tjockleken i meter delat med lambdavärdet. För skiktet med reglar räknar jag också motståndet rakt genom träet.',
  'Utan reglar lägger jag ihop motstånden med luftens motstånd inne och ute och tar 1 delat med summan. Med reglar blir det två räkningar, och jag tar medelvärdet av motstånden.',
  'Det du lägger till tar jag som hela lager utan reglar och gör samma räkning en gång till.',
  'Svaret är det nya U-värdet om du har lagt till något, och annars det du har i dag.',
  'Jag avrundar U-värdet precis som det står i svaret och jämför det sedan med Boverkets krav, så att talet och beskedet aldrig säger olika saker.',
  'Om U-värdet inte klarar kravet lägger jag på tio millimeter i taget av det du valt att lägga till, tills det gör det. Det är de millimetrarna som står överst i svaret.',
  'Skillnaden i U-värde gånger ytan gånger gradtimmarna för din del av landet, delat med 1 000, blir kilowattimmarna du sparar på ett år. Gånger elpriset blir det kronor med direktverkande el, och med värmepump delar jag först med pumpens SCOP.',
  'Återbetalningstiden är vad ullen kostar i butiken delat med kronorna per år. Den får du bara för ett vindsbjälklag med lösull av stenull eller Rockwool Flexibatts. Det är de enda materialen jag har ett daterat butikspris för, och på en vägg eller ett golv kostar panel, läkt och vindskydd mer än ullen.',
];
/** Ett tal ur konstanterna med decimalkomma, för stegen nedan. */
const talIText = (n: number) => String(n).replace('.', ',');
const NYA = BOVERKET['fran-2026-10-01'];
const GAMLA = BOVERKET['till-2026-09-30'];
/** Läget ”Jag vet U-värdet” för vindsbjälklag, yttervägg och golv (specen 12.38). Talen ur BOVERKET och GRADTIMMAR. */
const STEG_KANT_U = [
  'U-värdena före och efter används precis som du har skrivit in dem. Här finns inga skikt att gå igenom.',
  `Talet efter jämförs med Boverkets krav för den del du har valt, som är ${talIText(NYA.tak)} W/m²K för ett vindsbjälklag, ${talIText(NYA.vagg)} för en yttervägg och ${talIText(NYA.golv)} för ett golv.`,
  `Skillnaden mellan talen gånger ytan gånger gradtimmarna blir den värme du sparar på ett år, räknad i wattimmar. I Mellansverige är det ${heltal(GRADTIMMAR.mitt)} gradtimmar om året. Delat med 1 000 blir det kilowattimmar, och gånger elpriset blir det kronor med direktverkande el. För en värmepump delas värmen först med pumpens SCOP.`,
  'Någon återbetalningstid blir det inte, för utan ett material har jag inget pris att dela med kronorna.',
];
/*
 * Fönster och ytterdörr (specen 12.38). Boverket har samma tal för båda i
 * BOVERKET, därför räcker fönstrets i steg 2.
 */
const STEG_FONSTER_DORR = [
  'Uw före och efter tar jag som du har skrivit in dem, från databladet eller offerten.',
  `Uw efter jämförs med två tal från Boverket för fönster och ytterdörrar: ${talIText(GAMLA.fonster)} W/m²K, som är målet i de gamla reglerna, och ${talIText(NYA.fonster)}, som är kravet i de nya.`,
  'Kilowattimmarna räknas som för en vägg: skillnaden i Uw gånger fönstrets eller dörrens yta gånger gradtimmarna för din del av landet, delat med 1 000. Elpriset gör dem till kronor, och med värmepump blir kronorna färre, eftersom jag först delar med pumpens SCOP.',
  'Återbetalningstiden får du genom att dela priset i offerten med kronorna om året. Den räkningen gör du själv, för priser på fönster och dörrar har jag inte.',
];
/** Läs vidare som kort, i den förra listans ordning. Räknaren får etiketten den har på hubben. */
const LAS_VIDARE = ['/el/u-varde/', '/el/tillaggsisolera-vind/', '/rakna/daggpunkt/'];
const FRAGOR = [
  {
    fraga: 'Hur räknar jag med en tegelfasad?',
    svar: 'Med en ventilerad luftspalt bakom teglet väljer du ”Ventilerad luftspalt”, och då räknas varken spalten eller teglet. Ligger teglet direkt mot isoleringen, eller är hela väggen murad, räknar du med de andra skikten och låter teglet vara. Något lambdavärde för tegel som jag kan lita på har jag inte hittat. Utan teglet blir U-värdet något för högt, och hellre för högt än för lågt.',
  },
  {
    fraga: 'Går det att räkna på golvet över en krypgrund?',
    svar: 'Inte så att talet blir rätt. Här räknas golvet som ett bjälklag med uteluft rakt under, och ett golv över en krypgrund eller direkt på mark räknas efter en annan standard, där U-värdet blir lägre. Räkna golvet här bara om det verkligen har uteluft under sig.',
  },
  {
    fraga: 'Varför får jag ett annat U-värde än i tillverkarens tabell?',
    svar: 'Rockwool har en tabell för vindar med takstolar, och den ger ett bättre U-värde än mitt för samma mängd ull. Skillnaden sitter i den gamla ullen, som här får lambdavärdet för mineralull av okänt märke och okänd ålder, den sämre änden av Energimyndighetens spann. På 100 kvadratmeter i Mellansverige blir besparingen 2 801 kr om året med mina tal och 2 271 kr med Rockwools. Har du tillverkarens tal för just din konstruktion är de bättre än mina, och då skriver du in dem under ”Jag vet U-värdet”.',
  },
];

/* Gränssnittstext, ordagrant ur specen och skillen nytt-verktyg. Delatexten står i Delningsrad. */
const STANDARDVARNING = 'Ett av fälten gick inte att läsa, så jag visar standardvärdena tills du rättat det.';

const q = Astro.url.searchParams;
const { indata, bytta } = tolkaQuery(q);
const resultat = raknaUVarde(indata);
const fel = resultat.status === 'ogiltig' ? resultat.fel : {};
// Vid ogiltig indata visas standardvärdenas svar i samma läge, med varningen överst.
const visatIndata: UVardeIndata = resultat.status === 'ogiltig' ? { ...STANDARD, lage: indata.lage } : indata;
const visat = raknaUVarde(visatIndata);
if (visat.status !== 'ok') throw new Error('[u-varde] Standardvärdena ska alltid ge ett svar');

const komma = (n: number) => String(n).replace('.', ',');

/**
 * Fältens värden kommer från adressen som den skrevs, inte från de tolkade
 * talen: "abc" blir NaN i tolkaQuery, och NaN i ett fält som läsaren ska rätta
 * är obrukbart. Ett värde som tolkaQuery bytte mot delens standard (specen
 * 12.27) visas som det nya standardvärdet med komma.
 */
function faltVarde(nyckel: 'yta' | 'uf' | 'ue', tolkat: number): string {
  const ra = q.get(nyckel);
  return bytta[nyckel] || ra === null ? komma(tolkat) : ra;
}

/*
 * Tjocklekarna: råsträngarna ur adressen, eller delens standardskikt när
 * tolkaQuery tog dem därifrån eller bytte dem mot den nya delens (specen 12.30).
 */
type Sex = [string, string, string, string, string, string];
const d: Sex = ['', '', '', '', '', ''];
if (bytta.skikt) {
  for (const s of indata.skikt) if (s.material !== 'luftspalt') d[s.rad - 1] = komma(s.tjocklekMm);
} else {
  for (let n = 1; n <= 6; n++) d[n - 1] = q.get(`d${n}`) ?? '';
}
const td: [string, string] = ['', ''];
if (bytta.tillagg) {
  for (const t of indata.tillagg) td[t.rad - 1] = komma(t.tjocklekMm);
} else {
  for (let n = 1; n <= 2; n++) td[n - 1] = q.get(`td${n}`) ?? '';
}
const varden = {
  yta: faltVarde('yta', indata.ytaM2),
  uf: faltVarde('uf', indata.uFore),
  ue: faltVarde('ue', indata.uEfter),
  d,
  td,
};

/** Lägesväxlingen, byggd i modulen (specen 12.32). */
const bytLageHref = '/rakna/u-varde/?' + bytLageQuery(q, indata).toString();

/** Delbar länk, byggd av de tolkade värdena. */
const delaLank = new URL(`/rakna/u-varde/?${delbarQuery(visatIndata).toString()}`, Astro.site ?? Astro.url).toString();

/**
 * Cellklasserna en gång på <table>, inte per cell (specen 12.1). Samma utseende
 * som CELL_KLASS i stil.ts: ram under varje rad, p-2, align-top, blyerts.
 */
const TABELL_KLASS =
  'w-full border-collapse text-liten tabular-nums [&_th]:p-2 [&_td]:p-2 [&_th]:align-top [&_td]:align-top [&_th]:text-left [&_tbody_th]:[font-weight:inherit] [&_tr]:border-b [&_tr]:border-linje [&_th]:text-blyerts [&_td]:text-blyerts [&_thead_th]:text-etikett [&_thead_th]:uppercase [&_thead_th]:text-blyerts-2';

/** Boverkets krav: en rad när kolumnerna är lika (vägg, vindsbjälklag, golv), annars två (specen 12.15). */
const [kolumnFore, kolumnEfter] = visat.jamforelse;
const jamforRader =
  kolumnFore.grans === kolumnEfter.grans
    ? [{ etikett: TEXT.kolumn.bada, grans: kolumnEfter.grans, klarar: kolumnEfter.klarar }]
    : visat.jamforelse.map((j) => ({ etikett: TEXT.kolumn[j.kolumn], grans: j.grans, klarar: j.klarar }));

/** Rubriken bär talen (specen 12.10). */
const rubrik = TEXT.besked[visat.besked].rubrik(beskedVarden(visat));

/**
 * Antagandetabellen visar bara raderna svaret vilar på, och källorna står en
 * gång under tabellen i den ordning de först förekommer (specen 12.2).
 */
const antaganden = antagandenFor(visat);
const kallor: KallaRef[] = [];
for (const a of antaganden) {
  for (const k of a.kallor) if (!kallor.some((x) => x.url === k.url && x.titel === k.titel)) kallor.push(k);
}

/** Etiketten på varje rad i "Därför blev svaret så". */
type Slag = 'formel' | 'boverket' | 'besparing' | 'begransning';
const SLAG: Record<RegelNyckel, Slag> = {
  formel: 'formel',
  luftspalt: 'formel',
  reglar: 'formel',
  cellulosa: 'formel',
  /* Korrektionen sätts till noll, alltså en förenkling (specen 12.39). */
  'delta-u': 'begransning',
  'boverket-andring': 'boverket',
  'boverket-overgang': 'boverket',
  'boverket-anpassning': 'boverket',
  'boverket-50': 'boverket',
  'fonster-uw': 'boverket',
  gradtimmar: 'besparing',
  elpris: 'besparing',
  scop: 'besparing',
  'aterbetalning-bara-ull': 'besparing',
  'tak-kallvind': 'begransning',
  'golv-uteluft': 'begransning',
  'energi-inte-matare': 'begransning',
};
const SLAG_ETIKETT: Record<Slag, string> = {
  formel: TEXT.darfor['slag-formel'],
  boverket: TEXT.darfor['slag-boverket'],
  besparing: TEXT.darfor['slag-besparing'],
  begransning: TEXT.darfor['slag-begransning'],
};

/** Raderna i skikttabellen. Tomma celler för Rsi, Rse och summorna. */
interface Tabellrad {
  etikett: string;
  tjocklek: string;
  lambda: string;
  r: string;
  summa?: boolean;
}
function summarader(m: Motstand, efter: boolean): Tabellrad[] {
  const rader: Tabellrad[] = [];
  if (m.rOvre !== null && m.rUndre !== null) {
    rader.push({ etikett: TEXT.darfor[efter ? 'rad-ovre-efter' : 'rad-ovre'], tjocklek: '', lambda: '', r: treDecimaler(m.rOvre) });
    rader.push({ etikett: TEXT.darfor[efter ? 'rad-undre-efter' : 'rad-undre'], tjocklek: '', lambda: '', r: treDecimaler(m.rUndre) });
  }
  rader.push({ etikett: TEXT.darfor[efter ? 'rad-rt-efter' : 'rad-rt-fore'], tjocklek: '', lambda: '', r: treDecimaler(m.rTotal), summa: true });
  rader.push({ etikett: TEXT.darfor[efter ? 'rad-u-efter' : 'rad-u-fore-tabell'], tjocklek: '', lambda: '', r: treDecimaler(m.u), summa: true });
  return rader;
}
const tabell: Tabellrad[] = [];
if (visat.detaljer) {
  const { rader, fore, efter } = visat.detaljer;
  tabell.push({ etikett: TEXT.darfor['rad-rsi'], tjocklek: '', lambda: '', r: treDecimaler(fore.rsi) });
  for (const r of rader.filter((x) => x.kalla === 'fore')) {
    let rText = TEXT.darfor['raknas-inte'];
    if (r.raknas && r.r !== null) rText = r.rRegel !== null ? `${treDecimaler(r.r)} / ${treDecimaler(r.rRegel)}` : treDecimaler(r.r);
    tabell.push({
      etikett: MATERIAL[r.material].etikett,
      tjocklek: r.tjocklekMm === null ? '' : komma(r.tjocklekMm),
      lambda: r.lambda === null ? '' : komma(r.lambda),
      r: rText,
    });
  }
  tabell.push({ etikett: TEXT.darfor['rad-rse'], tjocklek: '', lambda: '', r: treDecimaler(fore.rse) });
  tabell.push(...summarader(fore, false));
  if (efter) {
    for (const r of rader.filter((x) => x.kalla === 'tillagg')) {
      tabell.push({
        etikett: TEXT.darfor['rad-tillagg'](MATERIAL[r.material].etikett),
        tjocklek: r.tjocklekMm === null ? '' : komma(r.tjocklekMm),
        lambda: r.lambda === null ? '' : komma(r.lambda),
        r: r.r === null ? '' : treDecimaler(r.r),
      });
    }
    tabell.push(...summarader(efter, true));
  }
}

/** Skissen står i kortet Så räknar jag. Huvudet har ingen bild sedan fas C (DESIGN.md 5.8). */
const illustration = verktygsillustration(SLUG);

/** Stegen under ”Så räknar jag” efter läge och del (specen 12.38). */
const steg =
  visat.del === 'fonster' || visat.del === 'dorr'
    ? STEG_FONSTER_DORR
    : visat.lage === 'skikt'
      ? STEG_SKIKT
      : STEG_KANT_U;

/**
 * Råden under ”Gör inte det här”, delade vid länktexten (specen 12.41). Står
 * länktexten inte i rådet visas länken efter texten, så att den syns tills
 * texten är skriven; testet kräver att den står där exakt en gång.
 */
const gorInte = visat.gorInteDetHar.map((g) => {
  const { text, lank }: GorInteText = TEXT.gorInte[g];
  if (!lank) return { fore: text, lank: null, efter: '' };
  const delar = text.split(lank.text);
  return delar.length === 2
    ? { fore: delar[0], lank, efter: delar[1] }
    : { fore: `${text} `, lank, efter: '' };
});

/*
 * Svarsytan, fas C (spec-designlyft-c-2026-10-02 avsnitt 10). Mätaren visar
 * U-värdet mot kravet i de nya reglerna för den valda delen, ur
 * jämförelsen i formelmodulen; etiketten är delens namn. Statusraderna är
 * jämförelsen med Boverket, en per kolumn som förut. Ny text är
 * hantverkarens. Klartexten har platshållarna {u} (U-värdet i svaret), {del}
 * (delens namn), {krav} (kravet) och {ytan} (m²).
 */
const krav = kolumnEfter;
const uVisat = uText(visat.uSlut, visat.del);
const KLARTEXT = 'U-värdet blir {u} W/m²K, och Boverkets krav för den här delen av huset är {krav} W/m²K vid en ombyggnad, enligt de nya reglerna.'; // u-varde.klartext
const klartext = KLARTEXT.replace('{u}', uVisat)
  .replace('{del}', TEXT.del[visat.del])
  .replace('{krav}', komma(krav.grans))
  .replace('{ytan}', komma(visat.ytaM2));

/** Läs vidare: artiklarna som artikelkort, räknaren med registrets namn som på hubben. */
const artiklar = [...(await publicerade('guider')), ...(await publicerade('kunskap'))];
const lasVidare: KortData[] = LAS_VIDARE.flatMap((href): KortData[] => {
  const e = artiklar.find((a) => artikelUrl(a) === href);
  if (e) {
    const { niva: _niva, ...kort } = tillKortArtikel(e);
    return [kort];
  }
  const k = hittaKalkylator(href.replace(/^\/rakna\/|\/$/g, ''));
  const pelare = k?.pelare?.[0];
  if (!k || !pelare || !arPelare(pelare)) return [];
  return [
    {
      etikett: 'Räkna själv',
      rubrik: k.namn,
      beskrivning: k.rad,
      pelare,
      href,
      // Artikelrutnat läser inte typen; kortet står varken i ett typfilter eller sorteras.
      typ: 'kunskap',
      sorteringsdatum: new Date(0),
    },
  ];
});
---

<Raknarsida
  slug={SLUG}
  namn={VERKTYGSNAMN}
  titel={titel}
  beskrivning={BESKRIVNING}
  rubrik={H1}
  delaUrl={delaLank}
  saRaknarId="sa-raknar-jag"
>
  <p slot="ingress">{INGRESS}</p>

  {/* Formuläret ligger i src/components/kalkyl/UVardeForm.astro, så att
      <Kalkylator namn="u-varde" /> i artikeln visar samma fält. */}
  <UVardeForm slot="formular" indata={indata} varden={varden} fel={fel} bytLageHref={bytLageHref} />

  <Fragment slot="svar">
    {resultat.status === 'ogiltig' && <p class="text-liten text-varning">{STANDARDVARNING}</p>}
    <Svarstal tal={uVisat} enhet="W/m²K" vad={TEXT.spalt['etikett-u']} />
    {
      visat.uEfter !== null && (
        <p class="text-liten text-blyerts-2">{TEXT.spalt['rad-u-fore'](uText(visat.uFore, visat.del))}</p>
      )
    }
    <div class="text-brod">
      <p class="font-bold">{rubrik}</p>
      <p>{TEXT.besked[visat.besked].rad(beskedKontext(visat))}</p>
    </div>
    <Matare
      etikett={TEXT.del[visat.del]}
      varde={visat.uSlut}
      grans={krav.grans}
      gransVisat={komma(krav.grans)}
      enhet="W/m²K"
      visat={`${uVisat} W/m²K`}
    />
    {
      jamforRader.map((j) => (
        <Statusrad
          ton={j.klarar ? 'ok' : 'varning'}
          text={`${j.etikett}: ${komma(j.grans)} W/m²K, ${j.klarar ? TEXT.klarar : TEXT.klararInte}`}
        />
      ))
    }
    {
      visat.besparing && (
        <div>
          <p class="etikett text-blyerts-2">{TEXT.spalt['etikett-sparar']}</p>
          <p class="mt-1! font-serif text-h1 lg:text-h1-lg text-blyerts tabular-nums">
            {heltal(visat.besparing.krPerAr)}&nbsp;kr
          </p>
          <p class="mt-1! text-liten text-blyerts-2">
            {TEXT.spalt['rad-kwh'](heltal(visat.besparing.kwhPerAr), TEXT.region[visat.region], ELPRIS_KALLA.period)}
          </p>
          <ul class="m-0 mt-2 p-0 list-none text-brod tabular-nums">
            {visat.besparing.varmepump.map((v) => (
              <li class="border-t border-linje py-2">
                {TEXT.spalt['rad-vp'](TEXT.vp[v.typ], heltal(v.krMin), heltal(v.krMax))}
              </li>
            ))}
          </ul>
        </div>
      )
    }
    <p class="text-brod">
      {
        visat.aterbetalning
          ? TEXT.spalt['rad-aterbetalning'](endecimal(visat.aterbetalning.ar), heltal(visat.aterbetalning.kostnadKr))
          : visat.aterbetalningSaknas && TEXT.aterbetalningSaknas[visat.aterbetalningSaknas]
      }
    </p>
    <p class="text-liten text-blyerts">{klartext}</p>
  </Fragment>

  <Fragment slot="darfor">
    <Pennstreck id="darfor-blev-svaret-sa" utanLuft>
      Därför blev svaret så
    </Pennstreck>
    {
      tabell.length > 0 && (
        <Tabellyta kolumner={4} class="mt-4 mb-6">
          <table class={TABELL_KLASS}>
            <caption class="sr-only">{TEXT.darfor['tabell-caption']}</caption>
            <thead>
              <tr>
                <th scope="col">{TEXT.darfor['tabell-skikt']}</th>
                <th scope="col">{TEXT.darfor['tabell-tjocklek']}</th>
                <th scope="col">{TEXT.darfor['tabell-lambda']}</th>
                <th scope="col">{TEXT.darfor['tabell-r']}</th>
              </tr>
            </thead>
            <tbody>
              {tabell.map((rad) => (
                <tr class={rad.summa ? 'font-bold' : undefined}>
                  <th scope="row">{rad.etikett}</th>
                  <td>{rad.tjocklek}</td>
                  <td>{rad.lambda}</td>
                  <td>{rad.r}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </Tabellyta>
      )
    }
    <div class="darfor">
      {
        visat.regler.map((nyckel) => {
          const regel: { text: string; kalla: { titel: string; url: string; lank?: false } } = TEXT.regel[nyckel];
          const slag = SLAG[nyckel];
          return (
            <div>
              <span class="block text-etikett lg:text-etikett-lg uppercase text-blyerts-2">{SLAG_ETIKETT[slag]}</span>
              <p>{regel.text}</p>
              <p>
                {regel.kalla.lank === false ? (
                  regel.kalla.titel
                ) : (
                  <a href={regel.kalla.url} rel="nofollow" class={LANK_KLASS}>
                    {regel.kalla.titel}
                  </a>
                )}
              </p>
            </div>
          );
        })
      }
    </div>
  </Fragment>

  {
    gorInte.length > 0 && (
      <Fragment slot="gorInte">
        {/* Flera råd står i samma stycke efter "Gör inte det här.", vart och ett på egen rad. */}
        {gorInte.map((g, i) => (
          <span class:list={[i > 0 && 'mt-3 block']}>
            {/* På en rad, så att inget mellanslag hamnar runt länken. */}
            {g.fore}{g.lank && <a href={g.lank.href} class={LANK_KLASS}>{g.lank.text}</a>}{g.efter}
          </span>
        ))}
      </Fragment>
    )
  }

  <Fragment slot="saRaknarJag">
    {
      illustration && visat.del === 'tak' && (
        <div class="pappersruta">
          <Illustration namn="rakna/u-varde" alt={SKISS_ALT} bildtext={SKISS_BILDTEXT} class="my-0!" />
        </div>
      )
    }
    <ol class="m-0 mt-4 pl-6 list-decimal text-brod">
      {steg.map((s) => <li class="mb-2">{s}</li>)}
    </ol>
  </Fragment>

  <Fragment slot="efter">
    {/* Antagandetabellen i läsbredd, ur kortet Så räknar jag (spec-designlyft-c avsnitt 9). */}
    <section class="max-w-lasbredd">
      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">Vad siffrorna vilar på</h3>
      <Tabellyta kolumner={3} class="mt-4">
        <table class={TABELL_KLASS}>
          <thead>
            <tr>
              <th scope="col">Vad</th>
              <th scope="col">Räknat med</th>
              <th scope="col">Källa eller antagande</th>
            </tr>
          </thead>
          <tbody>
            {
              antaganden.map((a) => (
                <tr>
                  <th scope="row">{TEXT.antagande[a.nyckel]}</th>
                  <td>{a.varde}</td>
                  <td>
                    {a.typ}.{a.kallor.length > 0 && ` ${a.kallor.map((k) => k.titel).join('; ')}`}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </Tabellyta>
      <ul class="m-0 mt-4 pl-6 text-liten">
        {
          kallor.map((k) => (
            <li>
              {/* Kommat på samma rad som </a>, annars blir radbrytningen ett mellanslag före kommat (specen 12.42). */}
              <a href={k.url} rel="nofollow" class={LANK_KLASS}>{k.titel}</a>, {k.last}
            </li>
          ))
        }
      </ul>
    </section>

    {
      lasVidare.length > 0 && (
        <section>
          <Pennstreck id="las-vidare">Läs vidare</Pennstreck>
          <Artikelrutnat kort={lasVidare} visaBeskrivning={false} visaMeta={false} />
        </section>
      )
    }

    <div class="max-w-lasbredd">
      <Faq fragor={FRAGOR} />
    </div>
  </Fragment>
</Raknarsida>
