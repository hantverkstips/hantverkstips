---
/**
 * Köksräknaren: vad köket kostar post för post, före och efter rotavdraget, i
 * fyra vägar (luckor, bänkskiva, båda, nytt kök). Formuläret skickas som GET
 * till samma sida och räkningen sker på servern, så sidan fungerar utan ett
 * enda byte klient-JS. Se docs/SPEC-SIDMALLAR.md avsnitt 4.7 och
 * docs/briefer/spec-kalkyl-kok-kostnad-2026-09-29.md.
 *
 * Formeln, konstanterna och all text som modulen äger ligger i
 * src/lib/kalkyl/renovering.ts, som badrumsräknaren delar. Sidan räknar
 * ingenting själv, den visar svaret och redovisar källan bakom varje rad.
 *
 * Inga produkter och inget reklamband (checklistan 1 och 12).
 *
 * Räknarmallen sedan fas C (spec-designlyft-c-2026-10-02 avsnitt 14).
 */
export const prerender = false;

import { artikelUrl, publicerade } from '../../lib/innehall';
import { tillKortArtikel, type KortData } from '../../lib/kort';
import { hittaKalkylator } from '../../lib/kalkyl/register';
import { arPelare } from '../../lib/pelare';
import {
  KALLOR,
  kokAntagandenFor,
  kokBeskedVarden,
  kokDelbarQuery,
  kokRegelKallor,
  kokRotavdragQuery,
  KOK_STANDARD,
  KOK_TEXT,
  krText,
  kvmText,
  raknaKokKostnad,
  spannDelar,
  tolkaKokQuery,
  type KallaRef,
  type KallKod,
  type KokIndata,
  type KokPostRad,
} from '../../lib/kalkyl/renovering.ts';
import { kallradEfterRegel } from '../../lib/kalkyl/kallrad';
import { LANK_KLASS } from '../../lib/kalkyl/stil';
import { verktygsillustration, verktygsVarumarkesbild } from '../../lib/verktygsbild';
import KokKostnadForm from '../../components/kalkyl/KokKostnadForm.astro';
import Artikelrutnat from '../../components/ui/Artikelrutnat.astro';
import Faq from '../../components/ui/Faq.astro';
import Illustration from '../../components/ui/Illustration.astro';
import Pennstreck from '../../components/ui/Pennstreck.astro';
import Svarstal from '../../components/ui/Svarstal.astro';
import Tabellyta from '../../components/ui/Tabellyta.astro';
import Raknarsida from '../../components/vyer/Raknarsida.astro';

Astro.locals.sidtyp = 'verktyg';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

/** Slug, namn och beskrivning på ett ställe: brödsmulan, og:image och WebApplication läser samma. */
const SLUG = 'kok-kostnad';
/* Utkast: sidan svarar 404 i produktion och noindex i dev tills hantverkarens
   text finns. Sätts till false i publiceringscommiten, samtidigt som
   registerposten och inbäddningen i /kok/byta-koksluckor/ läggs till. */
const UTKAST = false;
const VERKTYGSNAMN = 'Räkna på kostnaden för att renovera köket';
const BESKRIVNING = 'Välj nya luckor, ny bänkskiva eller ett helt nytt kök och få priset för varje del, med arbete och material var för sig, och se vad rotavdraget blir.'; // 120 till 155 tecken, checklistan 4
const titel = 'Renovera kök, kostnad post för post'; // högst 44 tecken, checklistan 3
const H1 = 'Vad kostar din köksrenovering?'; // checklistan 5
const INGRESS =
  'Välj om du byter luckorna, bänkskivan eller båda, eller om hela köket ska bytas. Skriv sedan antalet luckor och skivans längd, och kryssa i det du gör själv. Du får priset för varje del med arbete och material i var sin kolumn, och ser vad som återstår att betala efter rotavdraget.';

/* Rubrikerna till hantverkarens tre H2 (checklistans H2 1 till 3), i den ordningen. */
/* Tre vägar och vad de kostar. */
const H2_VAGAR = 'Hur mycket av köket som ska bytas';
/* Vad du kan göra själv. Bär "renovera kök billigt". */
const H2_SJALV = 'Renovera köket billigt med färg och eget snickeri';
/* Rotavdraget för köket. */
const H2_ROT = 'Rotavdraget räknas bara på en del av kostnaden';

/* Läs vidare: länktexterna skriver hantverkaren. /kok/byta-bankskiva/ står med
   sedan 2026-09-29 (koordinatorn), eftersom sidan och räknaren publiceras i
   samma commit och räknaren är utkast (404 i produktion) till dess. */
const LAS_VIDARE = [
  { href: '/kok/byta-koksluckor/', text: 'Mät och beställ luckor som passar dina gamla skåp' },
  { href: '/kok/mala-koksluckor/', text: 'Grund och färg när du målar om luckorna själv' },
  { href: '/rakna/rotavdrag/', text: 'Fördela rotavdraget mellan två ägare' },
  /* Checklistan kok-4, publiceringen punkt 6. Sidan och räknaren publiceras i samma commit. */
  { href: '/kok/byta-bankskiva/', text: 'Kapa, foga och fäst en ny bänkskiva själv' },
];

/* Tre till fem frågor. */
const FRAGOR = [
  {
    fraga: 'Gäller priserna ett Ikeakök eller vilket kök som helst?',
    svar: 'Ett helt nytt kök räknas med Ikeas billigaste skåp och luckor och med en byggfirmas pris för att montera ett Ikeakök. Ett annat märke eller en dyrare serie kostar mer, och vad ditt kök kostar får du veta när köksbutiken har ritat det och gett dig ett pris. Byter du bara luckorna kommer priserna i stället från Vedums prislista. Har du ett Ikeakök i serien Metod kan du köpa Ikeas egna luckor, och de billigaste av dem kostar mindre än Vedums, så räknarens svar blir då något för högt.',
  },
  {
    fraga: 'Får vi rotavdrag för köket om huset är yngre än fem år?',
    svar: 'I ett så nytt hus ger bara sådant arbete rotavdrag som återställer köket till det skick det hade. Att bygga om med en ny planlösning räknas inte dit, så då blir det inget avdrag alls. Att byta luckorna mot likvärdiga kan räknas dit, men är de nya luckorna av en dyrare sort än de gamla är det inte säkert, och då är det Skatteverket som kan svara.',
  },
  {
    fraga: 'Ingår installationen av vitvarorna?',
    svar: 'Nej. Räknaren tar med vad vitvarorna kostar att köpa men inte vad det kostar att ansluta dem, eftersom ingen av källorna anger vad installationen kostar för ett helt kök. Be firman som monterar köket att skriva installationen på en egen rad i offerten. När installationen görs i samband med en omfattande renovering av köket kan den ge rotavdrag.',
  },
];

/* Gränssnittstext, ordagrant ur skillen nytt-verktyg. */
const STANDARDVARNING = 'Ett av fälten gick inte att läsa, så jag visar standardvärdena tills du rättat det.';

/* Utkastet svarar 404 i produktion. Dev visar sidan med noindex, så att den går att granska. */
if (UTKAST && import.meta.env.PROD) {
  return new Response(null, { status: 404, headers: { 'X-Robots-Tag': 'noindex' } });
}

const T = KOK_TEXT;
const q = Astro.url.searchParams;
const { indata } = tolkaKokQuery(q);
const resultat = raknaKokKostnad(indata);
const fel = resultat.status === 'ogiltig' ? resultat.fel : {};
// Vid ogiltig indata visas standardvärdenas svar, med varningen överst.
const visatIndata: KokIndata = resultat.status === 'ogiltig' ? KOK_STANDARD : indata;
const visat = raknaKokKostnad(visatIndata);
if (visat.status !== 'ok') throw new Error('[kok-kostnad] Standardvärdena ska alltid ge ett svar');

/** Fältens värden som de skrevs i adressen, så att ett felskrivet värde går att rätta. */
const varden = {
  luckor: q.get('luckor') ?? String(KOK_STANDARD.antalLuckor),
  meter: q.get('meter') ?? kvmText(KOK_STANDARD.meter),
  rot: q.get('rot') ?? (KOK_STANDARD.rotKr === 0 ? '' : String(KOK_STANDARD.rotKr)),
};

/** Delbar länk, byggd av de tolkade värdena. */
const delaLank = new URL(`/rakna/${SLUG}/?${kokDelbarQuery(visatIndata).toString()}`, Astro.site ?? Astro.url).toString();

const bv = kokBeskedVarden(visat, visatIndata);
/* Specen K10, tabellen per läge: på bänkskivan (villkor) är priset före
   rotavdrag svaret och avdraget ett villkor på en egen rad. Luckor och nytt kök
   (saker) räknas som förut. Luckor och bänkskiva (delat) visar svaret med
   luckornas avdrag och en rad om skivans villkor. */
const lage = visat.rotLage;
const villkor = lage === 'villkor';
const besked = villkor ? T.beskedVillkor : T.besked[visat.utfall];
/** Det stora talet: före rot vid villkor, annars att betala efter rot. */
const stort = villkor
  ? { lag: visat.foreRotKr, hog: visat.hog.foreRotKr }
  : { lag: visat.attBetalaKr, hog: visat.hog.attBetalaKr };
const stortTal = stort.lag !== stort.hog ? `${krText(stort.lag)} till ${krText(stort.hog)}` : krText(stort.lag);

/**
 * Cellklasserna en gång på <table>, som på badrum-kostnad. Ett spann står som
 * två <span>, det lägre talet och "till" med det högre, och bara de får inte
 * brytas: cellen bryts före "till" och aldrig inne i ett tal.
 */
const TABELL_KLASS =
  'w-full border-collapse text-liten tabular-nums [&_th]:p-2 [&_td]:p-2 [&_th]:align-top [&_td]:align-top [&_th]:text-left [&_tbody_th]:[font-weight:inherit] [&_tr]:border-b [&_tr]:border-linje [&_th]:text-blyerts [&_td]:text-blyerts [&_thead_th]:text-etikett [&_thead_th]:uppercase [&_thead_th]:text-blyerts-2';
const POST_TABELL_KLASS = `${TABELL_KLASS} [&_td]:text-right [&_td_span]:whitespace-nowrap [&_thead_th+th]:text-right [&_tfoot_th]:font-bold [&_tfoot_td]:font-bold`;
/** Länkarnas utseende en gång på föräldern, samma som LANK_KLASS. */
const LANKAR_KLASS = '[&_a]:text-penna [&_a]:underline [&_a]:decoration-1 [&_a]:underline-offset-2 [&_a:hover]:decoration-2';
const STYCKE_KLASS = 'm-0 mt-4 text-brod lg:text-brod-lg';

const kalla = (k: KallKod): KallaRef => KALLOR[k];

/** Arbetscellen: talet som spann, eller ordet när arbetet inte är ett belopp. */
const ARBETE_ORD: Record<Exclude<KokPostRad['arbete'], 'belopp'>, string> = {
  egen: T.postEgen,
  ingar: T.postIngar,
  inget: T.postInget,
};

type Cell = string | ReturnType<typeof spannDelar>;
const postRader: { namn: string; celler: Cell[] }[] = visat.poster.map((p, n) => {
  const h = visat.hog.poster[n] ?? p;
  return {
    namn: T.post[p.nyckel],
    celler: [
      p.arbete === 'belopp' ? spannDelar(p.arbeteKr, h.arbeteKr) : `0 ${ARBETE_ORD[p.arbete]}`,
      spannDelar(p.materialKr, h.materialKr),
    ],
  };
});
const summaRad = [
  spannDelar(visat.arbeteKr, visat.hog.arbeteKr),
  spannDelar(visat.materialKr, visat.hog.materialKr),
];

/** Antagandetabellen, och källorna en gång under den i den ordning de först förekommer. */
const antaganden = kokAntagandenFor(visatIndata);
const kallor: KallaRef[] = [];
/* Brödtexten under H2_SJALV citerar Elsäkerhetsverket, Säker Vatten och Ifs villkor. */
const BRODTEXT_KALLOR: KallKod[] = ['ELSAK-SJALV', 'SV', 'IF'];
for (const k of [...antaganden.flatMap((a) => a.kallor), ...BRODTEXT_KALLOR]) {
  if (!kallor.some((x) => x.kod === k)) kallor.push(kalla(k));
}
/** Något i svaret ger rotavdrag; annars pekar länken till rotavdragsräknaren på ingenting. */
const harArbete = visat.hog.arbeteKr > 0;

/** Skissen står i kortet Så räknar jag. Huvudet har ingen bild sedan fas C (DESIGN.md 5.8). */
const illustration = verktygsillustration(SLUG);
/*
 * Varumärkesbilden står inte längre i huvudet, men villkoret för skissen är
 * låst i scripts/test-kalkyl-kok-kostnad.mjs (granskningen 2026-09-29), och
 * testet ändras inte i fas C.
 */
const varumarke = verktygsVarumarkesbild(SLUG);

/*
 * Klartexten i svarsytan (spec-designlyft-c avsnitt 0 och 14), hantverkarens.
 * Platshållare: {betala} (det stora talet, kr, ett tal eller "lågt till
 * högt": att betala efter rotavdraget, eller före avdraget på bänkskivan),
 * {fore} (före rotavdraget, kr), {rot} (rotavdraget, kr), {luckor} (antalet
 * luckor) och {meter} (bänkskivans längd, m).
 */
const KLARTEXT =
  'Det du har valt kostar {betala} kr efter rotavdraget och {fore} kr före, räknat med tillverkarnas, byggfirmornas och offertförmedlarnas priser.'; // kok-kostnad.klartext
/* Bänkskivan utan rotavdrag (villkor): det stora talet är summan före avdrag. */
const KLARTEXT_VILLKOR =
  'En ny bänkskiva på {meter} m kostar {betala} kr. Jag räknar utan rotavdrag, eftersom Skatteverket inte nämner ett byte av bara skivan.';
const klartext = (villkor ? KLARTEXT_VILLKOR : KLARTEXT).replace('{betala}', stortTal)
  .replace('{fore}', bv.foreRot)
  .replace('{rot}', bv.rot)
  .replace('{luckor}', String(visatIndata.antalLuckor))
  .replace('{meter}', kvmText(visatIndata.meter));

/**
 * Läs vidare: artiklarna som artikelkort, räknarna med registrets namn som på
 * hubben, i den förra listans ordning.
 */
const artiklar = [...(await publicerade('guider')), ...(await publicerade('kunskap'))];
const lasVidare: KortData[] = [];
const lasVidareLankar: { href: string; text: string }[] = [];
for (const l of LAS_VIDARE) {
  const e = artiklar.find((a) => artikelUrl(a) === l.href);
  if (e) {
    const { niva: _niva, ...kort } = tillKortArtikel(e);
    lasVidare.push(kort);
    continue;
  }
  const k = l.href.startsWith('/rakna/') ? hittaKalkylator(l.href.replace(/^\/rakna\/|\/$/g, '')) : undefined;
  const pelare = k?.pelare?.[0];
  if (k && pelare && arPelare(pelare)) {
    lasVidare.push({
      etikett: 'Räkna själv',
      rubrik: k.namn,
      beskrivning: k.rad,
      pelare,
      href: l.href,
      // Artikelrutnat läser inte typen; kortet står varken i ett typfilter eller sorteras.
      typ: 'kunskap',
      sorteringsdatum: new Date(0),
    });
    continue;
  }
  lasVidareLankar.push(l);
}
---

<Raknarsida
  slug={SLUG}
  namn={VERKTYGSNAMN}
  titel={titel}
  beskrivning={BESKRIVNING}
  rubrik={H1}
  delaUrl={delaLank}
  saRaknarId="sa-raknar-jag"
>
  <p slot="ingress">{INGRESS}</p>

  <KokKostnadForm slot="formular" indata={indata} varden={varden} fel={fel} />

  <Fragment slot="svar">
    {resultat.status === 'ogiltig' && <p class="text-liten text-varning">{STANDARDVARNING}</p>}
    <Svarstal tal={stortTal} enhet="kr" vad={villkor ? T.spalt['etikett-villkor'] : T.spalt['etikett-betala']} />
    <div class="text-brod">
      <p class="font-bold">{besked.rubrik(bv)}</p>
      <p class="mt-1!">{besked.rad(bv)}</p>
    </div>
    {/*
      Raderna under beskedet: summan och delningen till posterna (rad-delning
      börjar med "Det är" och står därför direkt efter rad-summa, eller vid
      villkor (K10) ensam, eftersom det stora talet då är summan), villkoret för
      bänkskivan, länken till rotavdragsräknaren och datumet.
    */}
    <div class="text-liten text-blyerts-2 tabular-nums">
      <p>
        {!villkor && <>{T.spalt['rad-summa'](bv.foreRot, bv.rot)}{' '}</>}{T.spalt['rad-delning'](bv.arbete, bv.material)}
      </p>
      {villkor && <p class="mt-2!">{T.spalt['rad-villkor'](bv)}</p>}
      {lage === 'delat' && <p class="mt-2!">{T.spalt['rad-villkor-delat'](bv)}</p>}
      <p class="mt-2!">{T.spalt['rad-kallor'](bv.hamtat)}</p>
    </div>
    {
      harArbete && lage !== 'villkor' && (
        <p>
          <a
            href={`/rakna/rotavdrag/?${kokRotavdragQuery(visat, visatIndata).toString()}`}
            class:list={['inline-flex min-h-11 items-center', LANK_KLASS]}
          >
            {T.spalt['lank-rotavdrag']}
          </a>
        </p>
      )
    }
    <p class="text-liten text-blyerts">{klartext}</p>
  </Fragment>

  <Fragment slot="darfor">
    <Pennstreck id="darfor-blev-svaret-sa" utanLuft>
      Därför blev svaret så
    </Pennstreck>
    <Tabellyta kolumner={3} class="mt-4">
      <table class={POST_TABELL_KLASS}>
        <thead>
          <tr>
            <th scope="col">{T.darfor['tabell-post']}</th>
            <th scope="col">{T.darfor['tabell-arbete']}</th>
            <th scope="col">{T.darfor['tabell-material']}</th>
          </tr>
        </thead>
        <tbody>
          {
            postRader.map((r) => (
              <tr>
                <th scope="row">{r.namn}</th>
                {r.celler.map((c) => (
                  <td>
                    {typeof c === 'string' ? (
                      c
                    ) : (
                      <>
                        <span>{c.lag}</span>
                        {c.hog !== null && (
                          <>
                            {' '}
                            <span>till {c.hog}</span>
                          </>
                        )}
                      </>
                    )}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
        <tfoot>
          <tr>
            <th scope="row">{T.darfor.summa}</th>
            {
              summaRad.map((c) => (
                <td>
                  <span>{c.lag}</span>
                  {c.hog !== null && (
                    <>
                      {' '}
                      <span>till {c.hog}</span>
                    </>
                  )}
                </td>
              ))
            }
          </tr>
        </tfoot>
      </table>
    </Tabellyta>
    <p class="m-0 mt-2 text-liten text-blyerts-2">
      <a href="#vad-siffrorna-vilar-pa" class={LANK_KLASS}>{T.darfor.kallrad}</a>
    </p>
    {
      villkor ? (
        <p class:list={[STYCKE_KLASS, 'tabular-nums']}>{T.darfor['rot-villkor'](bv)}</p>
      ) : (
        <>
          <p class:list={[STYCKE_KLASS, 'tabular-nums']}>
            {lage === 'delat' ? T.darfor['rot-delat'](bv) : T.darfor.rot(bv)}
          </p>
          <p class:list={[STYCKE_KLASS, 'tabular-nums']}>{T.darfor.betala(bv)}</p>
        </>
      )
    }
    <div class:list={['darfor', LANKAR_KLASS]}>
      {
        (() => {
          /* Förmedlarna namnges bara i antagandetabellen (checklistans fälla).
             Hänvisningen dit står högst en gång: under den sista regeln som
             vilar på en förmedlare. */
          const regelkallor = visat.regler.map((nyckel) => kokRegelKallor(nyckel, visatIndata.vag));
          const sistaFormedlare = kallradEfterRegel(regelkallor, false);
          return visat.regler.map((nyckel, r) => {
            const namngivna = regelkallor[r] ?? [];
            return (
              <div>
                <p>{T.regel[nyckel].text(bv)}</p>
                {namngivna.length > 0 ? (
                  <p>
                    {namngivna.map((k, i) => (
                      <>
                        {i > 0 && '; '}
                        <a href={k.url} rel="nofollow">{k.titel}</a>, {k.slag}, <span class="whitespace-nowrap">{k.datum}</span>
                      </>
                    ))}
                  </p>
                ) : (
                  r === sistaFormedlare && (
                    <p>
                      <a href="#vad-siffrorna-vilar-pa">{T.darfor.kallrad}</a>
                    </p>
                  )
                )}
              </div>
            );
          });
        })()
      }
    </div>
  </Fragment>

  {
    visat.gorInteDetHar.length > 0 && (
      <Fragment slot="gorInte">
        {/* Flera råd står i samma stycke efter "Gör inte det här.", vart och ett på egen rad. */}
        {visat.gorInteDetHar.map((g, i) => (
          <span class:list={[i > 0 && 'mt-3 block']}>{T.gorInte[g]}</span>
        ))}
      </Fragment>
    )
  }

  <Fragment slot="saRaknarJag">
    {
      /* Skissen visar luckbytet och 16 898 kr, så den står bara på vägen luckor
         (granskningen 2026-09-29). */
      varumarke && illustration && visatIndata.vag === 'luckor' && (
        <div class="pappersruta">
          <Illustration namn={`rakna/${SLUG}`} alt={T.skissAlt} bildtext={T.skissBildtext} class="my-0!" />
        </div>
      )
    }
    <ol class="m-0 mt-4 pl-6 list-decimal text-brod [&>li]:mb-2">
      {T.steg.map((s) => <li>{s}</li>)}
    </ol>
  </Fragment>

  <Fragment slot="efter">
    {/* Antagandetabellen i läsbredd, ur kortet Så räknar jag (spec-designlyft-c avsnitt 9). */}
    <section class="max-w-lasbredd">
      <h3 id="vad-siffrorna-vilar-pa" class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">
        Vad siffrorna vilar på
      </h3>
      <Tabellyta kolumner={3} class="mt-4">
        <table class={TABELL_KLASS}>
          <thead>
            <tr>
              <th scope="col">Vad</th>
              <th scope="col">Värde</th>
              <th scope="col">Källa eller antagande</th>
            </tr>
          </thead>
          <tbody>
            {
              antaganden.map((a) => (
                <tr>
                  <th scope="row">{T.antagande[a.nyckel]}</th>
                  <td>{a.varde}</td>
                  <td>
                    {a.typ}.{a.kallor.length > 0 && ` ${a.kallor.map((k) => kalla(k).titel).join('; ')}`}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </Tabellyta>
      <ul class:list={['m-0 mt-4 pl-6 text-liten [&_span]:whitespace-nowrap', LANKAR_KLASS]}>
        {
          kallor.map((k) => (
            <li>
              {/* Kommat på samma rad som </a>, annars blir radbrytningen ett mellanslag före kommat. */}
              <a href={k.url} rel="nofollow">{k.titel}</a>, {k.slag}, <span>{k.datum}</span>
            </li>
          ))
        }
      </ul>
    </section>

    {/*
      Hantverkarens brödtext, checklistans H2 1 till 3. Länkarna skrivs som
      vanliga <a> utan klass; utseendet står en gång på <section>.
    */}
    <section class:list={['max-w-lasbredd', LANKAR_KLASS]}>
      {/*
        Tre vägar och vad de kostar: luckor, bänkskiva, nytt kök, och varför el
        och VVS blir den stora överraskningen när planlösningen ändras. Länkar
        till /kok/byta-koksluckor/ och /kok/mala-koksluckor/.
      */}
      <Pennstreck>{H2_VAGAR}</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        Att renovera ett kök kan betyda att du <a href="/kok/mala-koksluckor/">målar om luckorna du har</a>, byter dem mot nya, byter bänkskivan eller river ut allt och börjar om. Nya luckor på de gamla skåpen, som kallas stommar, kostar en bråkdel av ett nytt kök, eftersom stommarna, skivan och vitvarorna får vara kvar. Det kräver att det finns luckor i rätt mått, och <a href="/kok/byta-koksluckor/">vilka luckor som passar skåpen du redan har</a> beror på vem som byggde köket.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        På bänkskivan är det materialet som gör den stora skillnaden i pris. En meter kvartskomposit kostar tre till fyra gånger så mycket som en meter laminat, medan monteringen i räknaren kostar lika mycket per meter för laminat, massivt trä och kvartskomposit, eftersom källan anger ett och samma spann för monteringen oavsett material.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Ett helt nytt kök är mer än skåp och vitvaror. Rivningen av det gamla och monteringen av det nya ingår också, och det är i monteringen som det lägsta och det högsta priset skiljer sig mest.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Den stora överraskningen kommer när planlösningen ändras. Flyttas spisen till en annan vägg kan den behöva en ny elgrupp från elcentralen, och flyttas diskbänken ska vatten och avlopp dras dit. Båda är firmornas arbete och syns inte i priset på skåpen och vitvarorna. Tillsammans lägger de till 10 000 till 35 000 kr före rotavdraget, och i den övre änden är det mer än hela luckbytet kostar.
      </p>
    </section>

    <section class:list={['max-w-lasbredd', LANKAR_KLASS]}>
      {/*
        Vad du kan göra själv. Bär "renovera kök billigt". Montera stommar och
        luckor, måla. El: fast installation av ett registrerat
        elinstallationsföretag; att det gäller hällen är vår slutsats och märks
        så. Vatten: Säker Vatten är branschregler, inget förbud; bara intyget.
        Länk till /kok/mala-koksluckor/.
      */}
      <Pennstreck>{H2_SJALV}</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        Behåll luckorna och måla dem, om det bara är färgen du har tröttnat på. Färgen till ett helt kök kostar mindre än gångjärnen till nya luckor, men arbetet tar tid, och grunden ska väljas efter vad luckorna är gjorda av. Läs därför först <a href="/kok/mala-koksluckor/">hur du slipar, grundar och målar köksluckor</a>.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Ska något bytas kan du göra snickeriet själv, som att hänga luckorna, lägga bänkskivan på plats och skruva ihop och hänga skåpen. Då står arbetet på noll i tabellen. Det du gör själv ger inget rotavdrag. Monterar du luckorna själv sparar du därför 70 procent av snickarens pris, och monterar du bänkskivan själv sparar du hela hans pris.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Elen kan du inte ta på dig. Nya uttag och ledningar i väggen är ändringar i den fasta elinstallationen, och enligt myndigheten Elsäkerhetsverket ska ett registrerat elinstallationsföretag alltid göra dem. Hällen står inte bland myndighetens exempel, men den ansluts fast till elen på samma sätt, så jag räknar den dit och låter elektrikern koppla in den. Ett vanligt uttag eller en strömbrytare som redan sitter på plats får du däremot byta själv, om du kan det.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        För vattnet finns inget förbud. Säker Vatten är branschens egna regler för rör i kök och våtrum, och de säger till exempel att vattenledningen fram till diskbänksskåpet ska dras utan skarvar. Bara ett auktoriserat VVS-företag kan utfärda intyg på att reglerna är följda. Ska diskbänken flyttas är det intyget du vill ha. Försäkringsbolaget If skriver i sina villkor att reglerna ska följas när du bygger om, och har de inte följts kan ersättningen efter en vattenskada sättas ned.
      </p>
    </section>

    <section class:list={['max-w-lasbredd', LANKAR_KLASS]}>
      {/*
        Rotavdraget för köket: två ägare, att material inte ger avdrag. Länk
        till /rakna/rotavdrag/.
      */}
      <Pennstreck>{H2_ROT}</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        På ett luckbyte blir rotavdraget drygt en tiondel av priset, eftersom luckorna och gångjärnen kostar mer än monteringen som avdraget räknas på. Byter du bara bänkskivan räknar jag utan avdrag, eftersom Skatteverket inte nämner det bytet.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Med priserna här kommer du inte upp till gränsen för en person, inte ens med flyttad diskbänk och ny elgrupp, om du inte redan har använt en del av den i år. Äger ni bostaden tillsammans och den ena har använt mycket av sin gräns, till exempel på ett badrum, kan den andra betala en större del av köket. <a href="/rakna/rotavdrag/">Räknaren för rotavdrag</a> visar hur avdraget då delas mellan er.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Låter du en målare måla luckorna hemma hos dig får du rotavdrag på arbetet, men inte om en verkstad lackerar dem i sin egen lokal.
      </p>
    </section>

    {
      (lasVidare.length > 0 || lasVidareLankar.length > 0) && (
        <section>
          <Pennstreck id="las-vidare">Läs vidare</Pennstreck>
          {lasVidare.length > 0 && (
            <Artikelrutnat
              kort={lasVidare}
              kolumner={lasVidare.length === 4 ? 4 : 3}
              visaBeskrivning={false}
              visaMeta={false}
            />
          )}
          {lasVidareLankar.length > 0 && (
            <ul class="m-0 mt-4 p-0 list-none max-w-lasbredd">
              {lasVidareLankar.map((l) => (
                <li class="border-t border-linje">
                  <a href={l.href} class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
                    {l.text}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </section>
      )
    }

    {
      FRAGOR.length > 0 && (
        <div class="max-w-lasbredd">
          <Faq fragor={FRAGOR} />
        </div>
      )
    }
  </Fragment>
</Raknarsida>
