---
/**
 * Självbesiktning av källaren: vad är det för fukt, och vad gör du åt den?
 * Formuläret skickas som GET till samma sida och bedömningen sker på servern,
 * så sidan fungerar utan ett enda byte klient-JS. Kostnaden är en
 * serverfunktion per anrop, och den hålls nere med CDN-cache. Se
 * docs/SPEC-SIDMALLAR.md avsnitt 4.7.
 *
 * Reglerna och alla antaganden ligger i src/lib/kalkyl/kallare.ts, och källan
 * bakom varje konstant står i
 * docs/briefer/underlag-kalkyl-kallare-2026-09-19.md. Sidan bedömer ingenting
 * själv, den visar bara svaret och redovisar källan bakom varje regel.
 *
 * Verktyget pekar inte ut någon produktegenskap, det ger en diagnos, så sidan
 * har varken produktkort eller reklamband. Pekar svaret mot en maskin eller
 * mot en grävning länkar den vidare med <Verktygskort>.
 */
export const prerender = false;

import Bas from '../../layouts/Bas.astro';
import {
  AVFUKTARE_KR,
  bedomKallare,
  DRANERING_KR_PER_LOPMETER,
  FUKTUTREDNING_KR,
  HYGROMETER_DYGN,
  HYGROSTAT_RF,
  KAN_HALLA_AR,
  KONDENS_MANAD_FRAN,
  KONDENS_MANAD_TILL,
  KRITISK_RF,
  kronor,
  REGN_LITER,
  REGN_MM,
  STANDARD,
  SYMPTOM,
  TAK_KVM,
  TEJPTEST_DYGN,
  tolkaQuery,
  type KallareIndata,
  type KallareResultat,
  type Steg,
} from '../../lib/kalkyl/kallare';
import { CELL_KLASS, ETIKETT_KLASS, FALT_KLASS, LANK_KLASS } from '../../lib/kalkyl/stil';
import { verktyg } from '../../lib/strukturdata';
import { verktygsDelningsbild, verktygsillustration, verktygsVarumarkesbild } from '../../lib/verktygsbild';
import KallareForm from '../../components/kalkyl/KallareForm.astro';
import Faktaruta from '../../components/ui/Faktaruta.astro';
import Faq from '../../components/ui/Faq.astro';
import Illustration from '../../components/ui/Illustration.astro';
import Markering from '../../components/ui/Markering.astro';
import Pennstreck from '../../components/ui/Pennstreck.astro';
import StrukturData from '../../components/ui/StrukturData.astro';
import Tabellyta from '../../components/ui/Tabellyta.astro';
import Verktygskort from '../../components/ui/Verktygskort.astro';

Astro.locals.sidtyp = 'verktyg';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

const q = Astro.url.searchParams;
const { indata } = tolkaQuery(q);
const resultat = bedomKallare(indata);

const fel = resultat.status === 'ogiltig' ? resultat.fel : {};
// Vid ogiltig indata visas standardvärdenas svar, med en rad som säger det.
const visat: KallareResultat = resultat.status === 'ogiltig' ? bedomKallare(STANDARD) : resultat;
const visatIndata: KallareIndata = resultat.status === 'ogiltig' ? STANDARD : indata;

/**
 * Fältets värde kommer från adressen som det skrevs, inte från det tolkade
 * talet: "fuktigt" blir NaN i tolkaQuery, och NaN i ett fält som läsaren ska
 * rätta är obrukbart.
 */
const varden = { rf: q.get('rf') ?? '' };

/**
 * Delbar länk. Hela frågan ligger redan i query-strängen, så adressen är
 * svaret. Den byggs av de tolkade värdena, inte av strängen läsaren skrev, och
 * varje val skrivs ut, även de som kom från standardvalet.
 */
const delaQuery = new URLSearchParams();
for (const s of visatIndata.symptom) delaQuery.append('se', s);
delaQuery.set('tejp', visatIndata.tejptest);
delaQuery.set('rf', visatIndata.luftfuktighet === null ? '' : String(visatIndata.luftfuktighet).replace('.', ','));
delaQuery.set('arstid', visatIndata.arstid);
delaQuery.set('bruk', visatIndata.anvandning);
const delaLank = new URL(`/rakna/kallare/?${delaQuery.toString()}`, Astro.site ?? Astro.url).toString();

/** Guidens fyra steg, som också är ordningen reglerna står i. */
const STEG_ETIKETT: Record<Steg, string> = {
  titta: 'Titta',
  tejpa: 'Tejpa',
  mat: 'Mät',
  atgarda: 'Åtgärda',
};

const STEG_RAM: Record<Steg, string> = {
  titta: 'border-linje',
  tejpa: 'border-blyerts-2',
  mat: 'border-blyerts-2',
  atgarda: 'border-blyerts',
};

const titel = 'Fuktig källare, vad ska du göra? Besiktiga själv';

/** Källorna bakom antagandetabellen, samlade så att raderna inte glider isär. */
const GUIDEN = '/fukt/fukt-i-kallaren/';
const BOVERKET_FUKTTILLSTAND =
  'https://www.boverket.se/sv/PBL-kunskapsbanken/regler-om-byggande/boverkets-byggregler/fuktsakerhet/hogsta-tillatna-fukttillstand/';
const BOVERKET_KALLARVAGG =
  'https://www.boverket.se/sv/byggande/forebygg-fel-brister-skador/risker-byggande/risker-fuktskador/fuktrisker-for-grund/fuktrisker-med-kallare/risk-med-fuktintrangning-kallarvagg/';
const POLYGON = 'https://www.polygongroup.com/sv-SE/Nyheter/fukttransport/';
const VILLAAGARNA = 'https://www.villaagarna.se/radgivning-och-tips/utomhus/grund/maste-du-dranera-huset/';
const GDS = 'https://gds.se/hus/inomhusklimat/fukt-i-kallare';
const MALARE =
  'https://malare-gustavsberg.se/blogg/mala-kallarvaggar-av-betong-guide-till-fukt-primer-och-farg/';
const FOLKHALSOMYNDIGHETEN =
  'https://www.folkhalsomyndigheten.se/regler-och-tillsyn/tillsynsvagledning-och-stod/halsoskydd-vagledning-och-tillsyn/tillsynsvagledning-om-fukt-och-mikroorganismer/';
const ANTICIMEX = 'https://www.anticimex.se/fuktskador/grund-kallare/';
const OCAB = 'https://www.ocab.se/fukt-och-vattenskador/fukt-i-kallare/';
const PROFFSMAGASINET =
  'https://www.proffsmagasinet.se/vvs-inomhusklimat/inomhusklimat/avfuktare/avfuktare/woods-sw39fw-i-ecodefrost-avfuktare-med-luftfilter-140-m-4058317';
const STRALSAKERHET =
  'https://www.stralsakerhetsmyndigheten.se/omraden/radon/referensniva-och-gransvarden-for-radon/';

/**
 * Månadsnumren i modulen skrivs ut med namn i tabellen. "Månad 7 till 9" är ett
 * tal läsaren måste slå upp, och cellen ska ändå inte kunna glida från koden.
 */
const MANAD = [
  '',
  'januari',
  'februari',
  'mars',
  'april',
  'maj',
  'juni',
  'juli',
  'augusti',
  'september',
  'oktober',
  'november',
  'december',
];
const kondenssasong = `${MANAD[KONDENS_MANAD_FRAN]} till ${MANAD[KONDENS_MANAD_TILL]}`;

const antaganden: { storhet: string; varde: string; grund: 'Källa' | 'Antagande'; stod: string; url?: string }[] = [
  {
    storhet: 'Symptom och trolig orsak',
    varde: `${SYMPTOM.length} rader`,
    grund: 'Antagande',
    stod: 'Sammanställd av oss i guiden om fukt i källaren. Två rader har egen källa, Villaägarnas salt och Folkhälsomyndighetens lukt. De fyra andra är vår läsning av mekaniken',
    url: GUIDEN,
  },
  {
    storhet: 'Saltutfällning',
    varde: 'Tecken på fukt',
    grund: 'Källa',
    stod: 'Villaägarna, saltutfällningar visar att vägg och källargolv är fuktiga. Salt kommer inte ur luften',
    url: VILLAAGARNA,
  },
  {
    storhet: 'Markfukt skyddas utifrån',
    varde: 'Alltid på utsidan',
    grund: 'Källa',
    stod: 'Boverket, fukttransporten från marken är främst kapillär och väggen ska skyddas på utsidan',
    url: BOVERKET_KALLARVAGG,
  },
  {
    storhet: 'Kapillärsugning',
    varde: 'Vatten i vätskefas',
    grund: 'Källa',
    stod: 'Saneringsföretaget Polygon, vattnet stiger högre i finporösa material än i grova',
    url: POLYGON,
  },
  {
    storhet: 'Tejptestets tid',
    varde: `Minst ${TEJPTEST_DYGN} dygn`,
    grund: 'Antagande',
    stod: 'Tidningen Gör Det Själv säger två veckor. Två dygn är vår undre kant, och en vecka ger ett tydligare svar',
    url: GDS,
  },
  {
    storhet: 'Torr plast',
    varde: 'Fel vägg',
    grund: 'Antagande',
    stod: 'En målerifirma i Gustavsberg nöjer sig med ett till två dygn och nämner inte det torra utfallet. Att torr plast betyder fel vägg och inte frisk källare är vår läsning',
    url: MALARE,
  },
  {
    storhet: 'Kritiskt fukttillstånd',
    varde: `${KRITISK_RF} % relativ luftfuktighet`,
    grund: 'Källa',
    stod: 'Boverket, BBR 6:52, när materialets eget värde inte är väl undersökt. Villaägarna säger samma sak i praktisk form',
    url: BOVERKET_FUKTTILLSTAND,
  },
  {
    storhet: 'Hygrostatens börvärde',
    varde: `${HYGROSTAT_RF} %`,
    grund: 'Antagande',
    stod: 'Marginal ner till Boverkets gräns, så att maskinen inte går i onödan. Ingen källa anger ett börvärde',
  },
  {
    storhet: 'Hygrometerns mättid',
    varde: `${HYGROMETER_DYGN} dygn`,
    grund: 'Antagande',
    stod: 'Symptomtabellen säger en vecka. Ingen källa anger en mättid, och en vecka täcker ett väderomslag',
    url: GUIDEN,
  },
  {
    storhet: 'Kondensens säsong',
    varde: kondenssasong.charAt(0).toUpperCase() + kondenssasong.slice(1),
    grund: 'Antagande',
    stod: 'Vår guide om fukt i källaren. Ingen statistik finns över hur ofta kondens, markfukt och läckage förekommer',
    url: GUIDEN,
  },
  {
    storhet: 'Prioritet mellan indata',
    varde: 'Läckage, plast, ögon, hygrometer',
    grund: 'Antagande',
    stod: 'Ingen källa rangordnar indata mot varandra. Ordningen är vår, och skälet står i stegen ovanför tabellen',
  },
  {
    storhet: 'Dräneringens livslängd',
    varde: `Upp till ${KAN_HALLA_AR} år`,
    grund: 'Källa',
    stod: 'Villaägarna, en gammal dränering kan fungera i femtio år om källaren bara används som källare',
    url: VILLAAGARNA,
  },
  {
    storhet: 'Källaren som bostad',
    varde: 'Andra krav',
    grund: 'Källa',
    stod: 'Folkhälsomyndigheten, fukt i ett rum man vistas i kan vara en olägenhet för människors hälsa',
    url: FOLKHALSOMYNDIGHETEN,
  },
  {
    storhet: 'Mikrobiell lukt',
    varde: 'Indikation på fuktskada',
    grund: 'Källa',
    stod: 'Folkhälsomyndigheten. Samma vägledning säger att inga hälsobaserade riktvärden finns för exponeringen',
    url: FOLKHALSOMYNDIGHETEN,
  },
  {
    storhet: 'Kondens eller sorption',
    varde: '10 grader',
    grund: 'Antagande',
    stod: 'Tillverkaren Dantherm säger 8 grader, Ljungby Fuktkontroll 15. Vi säger 10, och skälet står på vår sida om sorptionsavfuktare',
    url: '/fukt/sorptionsavfuktare/',
  },
  {
    storhet: 'Avfuktare till källaren',
    varde: `${kronor(AVFUKTARE_KR)} kr`,
    grund: 'Källa',
    stod: "Proffsmagasinet, Wood's SW39FW, pris hämtat 16 september 2026",
    url: PROFFSMAGASINET,
  },
  {
    storhet: 'Fuktutredning med mätvärden',
    varde: `${kronor(FUKTUTREDNING_KR)} kr inklusive moms`,
    grund: 'Källa',
    stod: 'Saneringsföretaget Ocab, fuktkontroll av källarutrymme. Konkurrentens eget listpris, som storleksordning',
    url: OCAB,
  },
  {
    storhet: 'Dränering per löpmeter',
    varde: `${kronor(DRANERING_KR_PER_LOPMETER)} kr i arbete`,
    grund: 'Källa',
    stod: 'Villaägarna, och det kan gå upp till det dubbla. Vad just din grund kostar räknar dräneringsverktyget',
    url: VILLAAGARNA,
  },
  {
    storhet: 'Vatten från taket',
    varde: `${kronor(REGN_LITER)} liter`,
    grund: 'Källa',
    stod: `Anticimex, ${REGN_MM} mm regn på ett tak på ${TAK_KVM} kvm. Motiverar stuprör och markfall före allt annat`,
    url: ANTICIMEX,
  },
  {
    storhet: 'Radon',
    varde: '200 becquerel per kubikmeter',
    grund: 'Källa',
    stod: 'Strålsäkerhetsmyndigheten, referensnivå som årsmedelvärde. Verktyget mäter inte radon och ser det inte',
    url: STRALSAKERHET,
  },
];

/** Frågorna sist på sidan. Talen är desamma som i brödtexten och i tabellen. */
const FRAGOR = [
  {
    fraga: 'Vad ska jag göra åt en fuktig källare?',
    svar: 'Ta orsakerna i ordning, från det som är gratis till det som kostar. Titta först: salt och flagnande färg längst ner på väggen pekar mot marken, imma på kallvattenrören mot luften, och rinnmärken efter regn mot ett läckage. Tejpa sedan en bit plastfolie tätt mot den våtaste väggen och läs av efter två dygn. Först när plasten har svarat vet du om du ska köpa en maskin, gräva eller täta en genomföring.',
  },
  {
    fraga: 'Hur vet jag om det är markfukt eller kondens?',
    svar: 'Plasten säger det. Sitter dropparna på plastens utsida, mot rummet, bär luften mer vatten än den kalla väggen tål, och det är kondens. Sitter de på insidan, mot väggen, kommer vattnet genom betongen, och det är markfukt. Skillnaden avgör vad du ska lägga pengarna på: en avfuktare mot markfukt torkar rummet, ökar avdunstningen ur väggen och får betongen att suga efter mer vatten ur marken.',
  },
  {
    fraga: 'Kan jag besiktiga källaren själv?',
    svar: 'Så långt det här verktyget går, ja. Du kan se symptomen, göra tejptestet och läsa av en hygrometer, och det räcker för att skilja markfukt från kondens och läckage. Det du inte kan göra själv är att mäta fukten inne i materialet eller se vad som växer bakom en skiva. Kommer du inte längre, be om en fuktutredning med mätvärden och inte om en offert på en åtgärd.',
  },
];

/** Slug, namn och beskrivning på ett ställe: brödsmulan, og:image och WebApplication läser samma. */
const SLUG = 'kallare';
const VERKTYGSNAMN = 'Självbesiktning av källaren';
const BESKRIVNING =
  'Kryssa i vad du ser, vad tejptestet gav och vad hygrometern visar. Verktyget säger om fukten är markfukt, kondens eller ett läckage, och vad du gör härnäst.';
const illustration = verktygsillustration(SLUG);
/**
 * Varumärkesbilden i sidhuvudet, sedan 2026-09-19 (docs/DESIGN.md avsnitt 7).
 * Finns den står skissen i stället i "Så bedömer vi". Finns den inte visas
 * skissen i sidhuvudet som förut, och saknas båda visas ingen bild alls.
 */
const varumarke = verktygsVarumarkesbild(SLUG);
const huvudbild = varumarke ?? illustration;
---

<Bas
  title={titel}
  description={BESKRIVNING}
  reklam={false}
  brodsmulor={[
    { namn: 'Hantverkstips', href: '/' },
    { namn: 'Räkna själv', href: '/rakna/' },
    { namn: VERKTYGSNAMN },
  ]}
  bred={true}
  ogBild={verktygsDelningsbild(SLUG)}
>
  <StrukturData
    slot="head"
    data={verktyg({ url: `/rakna/${SLUG}/`, namn: VERKTYGSNAMN, beskrivning: BESKRIVNING })}
  />

  <div class="mx-auto w-full max-w-lasbredd">
    {/*
      Sidhuvudet: rubrik och ingress till vänster i 7/12, bilden till höger i
      5/12 på desktop, under ingressen på mobil. Bilden är dekorativ, H1 bär
      betydelsen, därför tom alt. Den är sidans LCP-bild och laddas därför
      eagert med fetchpriority. Varumärkesbilden har transparent bakgrund och
      ligger som heron utan ram; skissen är ett urklipp och får ramen.
    */}
    <section class="grid grid-cols-1 items-center gap-6 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7">
        <h1 class="m-0 font-serif text-h1 lg:text-h1-lg">
          Fuktig källare? Gå igenom den själv och få veta varifrån vattnet kommer
        </h1>
        <p class="m-0 mt-4 text-ingress lg:text-ingress-lg">
          Vattnet kommer genom väggen, ur luften i rummet, eller in genom en otäthet när det regnar. En avfuktare är
          rätt svar på ett av de tre och bortkastade pengar på de andra två. Kryssa i vad du ser, vad tejptestet gav
          och vad hygrometern visar, så får du en trolig orsak, nästa steg och det du inte ska göra.
        </p>
      </div>

      {
        huvudbild && (
          <div class="lg:col-span-5">
            <img
              src={huvudbild.src}
              alt=""
              width={huvudbild.width}
              height={huvudbild.height}
              fetchpriority="high"
              decoding="async"
              class:list={['block h-auto w-full', !varumarke && 'rounded-sm border border-linje']}
            />
          </div>
        )
      }
    </section>

    <Faktaruta variant="kortsvar">
      <p class="m-0 leading-6">Vattnet kommer från <Markering>marken, luften eller ett läckage</Markering>.</p>
      <p class="m-0 leading-6">Salt och flagnande färg på nedersta halvmetern pekar mot marken.</p>
      <p class="m-0 leading-6">Tejpa en bit plastfolie mot den våtaste väggen i två dygn.</p>
      <p class="m-0 leading-6">Vått mot väggen är markfukt, vått mot rummet är kondens.</p>
      <p class="m-0 leading-6">Köp ingenting förrän plasten har svarat.</p>
    </Faktaruta>

    <div class="linjerat mt-8 lg:grid lg:grid-cols-2 lg:gap-8">
      {/* Formuläret ligger i src/components/kalkyl/KallareForm.astro, så att
          <Kalkylator namn="kallare" /> i en artikel visar exakt samma fält. */}
      <KallareForm indata={indata} varden={varden} fel={fel} />

      <div class="mt-8 border-t border-linje pt-6 lg:mt-0 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8">
        {
          visat.status === 'ok' && (
            <>
              {resultat.status === 'ogiltig' && (
                <p class="m-0 mb-2 text-liten text-varning">Visar standardvärden tills indatan är rättad.</p>
              )}
              {/* Spalten bär svaret: beskedet, en rad, nästa steg och länkarna.
                  Motiveringen står som egna avsnitt under verktyget. */}
              <p class="m-0 text-etikett lg:text-etikett-lg uppercase text-blyerts-2">Trolig orsak</p>
              <p class="m-0 mt-1 font-serif text-siffra lg:text-siffra-lg text-blyerts">
                <Markering>{visat.beskedRubrik}</Markering>
              </p>
              <p class="m-0 mt-2 text-brod lg:text-brod-lg">{visat.beskedRad}</p>

              <p class="m-0 mt-6 text-etikett lg:text-etikett-lg uppercase text-blyerts-2">Nästa steg</p>
              <p class="m-0 mt-1 text-brod lg:text-brod-lg">{visat.nastaStegText}</p>
              <p class="m-0 mt-1">
                <a href={visat.nastaStegLank.href} class:list={['inline-flex min-h-11 items-center', LANK_KLASS]}>
                  {visat.nastaStegLank.text}
                </a>
              </p>

              <p class="m-0 mt-4 text-liten text-blyerts-2">
                Varför det blev så, och vad du inte ska göra,{' '}
                <a href="#darfor-blev-svaret-sa" class={LANK_KLASS}>står under verktyget</a>.
              </p>

              <p class="m-0 mt-4">
                <a href="#sa-bedomer-vi" class:list={['inline-flex min-h-11 items-center', LANK_KLASS]}>
                  Så bedömer vi
                </a>
              </p>

              {/* Dela. Svaret står i adressen, så ett skrivskyddat fält räcker:
                  markera och kopiera fungerar utan en rad JavaScript. */}
              <div class="mt-4 border-t border-linje pt-4">
                <label for="dela" class={ETIKETT_KLASS}>
                  Dela svaret
                </label>
                <input id="dela" type="text" readonly value={delaLank} class:list={[FALT_KLASS, 'border-blyerts-2']} />
                <p class="m-0 mt-1 text-liten text-blyerts-2">Adressen innehåller dina svar. Markera och kopiera.</p>
              </div>
            </>
          )
        }
      </div>
    </div>

    {visat.status === 'ok' && visat.visaAvfuktare && <Verktygskort kalkylator="avfuktare" />}
    {visat.status === 'ok' && visat.visaDranering && <Verktygskort kalkylator="dranering" />}

    {
      visat.status === 'ok' && (
        <>
          <section>
            <Pennstreck id="darfor-blev-svaret-sa">Därför blev svaret så</Pennstreck>
            <p class="m-0 mb-4 text-brod lg:text-brod-lg">
              Raderna står i den ordning du går igenom källaren: titta först, tejpa sedan, mät, åtgärda sist.
            </p>
            <ul class="m-0 p-0 list-none text-brod lg:text-brod-lg">
              {visat.regler.map((regel) => (
                <li class:list={['mb-4 border-l-2 pl-4', STEG_RAM[regel.steg]]}>
                  <span class="block text-etikett lg:text-etikett-lg uppercase text-blyerts-2">
                    {STEG_ETIKETT[regel.steg]}
                  </span>
                  <span class="block">{regel.text}</span>
                  <span class="block text-liten text-blyerts-2">{regel.kalla}</span>
                </li>
              ))}
            </ul>
          </section>

          <section>
            <Pennstreck id="gor-inte-det-har">Gör inte det här</Pennstreck>
            {visat.gorInteDetHar.map((rad, i) => (
              <p class:list={['m-0 text-brod lg:text-brod-lg', i > 0 && 'mt-4']}>{rad}</p>
            ))}
          </section>
        </>
      )
    }

    <section>
      <Pennstreck id="tre-orsaker">Tre orsaker till fukt i källaren, och rätt åtgärd för var och en</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        Tre orsaker, tre olika åtgärder, och en maskin som bara är rätt svar på en av dem. Det är därför rådet här är
        att inte köpa något förrän plasten på väggen har svarat.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Markfukten går genom betongen. Myndigheten Boverket beskriver transporten som främst kapillär, alltså vatten i
        vätskefas som sugs genom porerna, ibland som vattenånga rakt genom materialet. Tillförseln är så långsam att
        det kan ta många år innan du märker något. Skyddet mot markfukt hör hemma på utsidan av väggen, och det är
        därför en avfuktare inne i rummet är fel maskin: luften torkar, avdunstningen ur väggen ökar, och betongen
        suger efter mer vatten ur marken.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Av samma skäl ska ytskiktet inne i källaren vara diffusionsöppet, alltså släppa igenom vattenånga. Målar du
        med en tät färg stannar vattnet i betongen och trycker upp färgen i sjok. Det är vad kryssrutan om färg som
        bubblar handlar om.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Kondensen vädrar du in själv. En källarvägg håller gärna 12&nbsp;grader, och luften du släpper in en varm
        eftermiddag i augusti börjar fälla ut vatten redan vid 14,4&nbsp;grader. Det talet gäller luft på
        20&nbsp;grader och 70&nbsp;procent relativ luftfuktighet, alltså inget extremt väder. Väggen blir våt i samma
        stund som du ställer upp fönstret. Det här är det enda av de tre fallen där en avfuktare gör jobbet, och hur
        stor den behöver vara följer av rummets volym och hur fuktig luften är.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Läckaget kommer med regnet. Det tar sig in på ett ställe, det ser ut som rinnmärken eller en pöl snarare än
        som en jämnt fuktig vägg, och det är det enda av de tre som kan bli akut. Följ vattnet uppåt och utåt: en
        rörgenomföring som aldrig tätades, en spricka efter en sättning, en fönsterbrunn full av löv, ett stuprör som
        slutar en halvmeter från grunden.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Att gissa fel kostar mer än några hundralappar. En avfuktare mot markfukt är {kronor(AVFUKTARE_KR)}&nbsp;kr
        som inte gör någon nytta alls. En dränering som inte behövdes är tjugo gånger den summan. Två dygn med en bit
        plast på väggen är det billigaste du kan göra åt den risken. Hela testet, med bild på båda utfallen, står i{' '}
        <a href="/fukt/fukt-i-kallaren/" class={LANK_KLASS}>
          guiden om fukt i källaren
        </a>
        .
      </p>
    </section>

    <section>
      <Pennstreck id="sa-bedomer-vi">Så bedömer vi</Pennstreck>
      {
        varumarke && illustration && (
          <Illustration
            namn="rakna/kallare"
            alt="Skiss av en källare i genomskärning med tre stopp numrerade i ordning. Ett, väggen: en remsa nedtill på den vänstra källarväggen med flagnande färg och saltutfällning. Två, tejpen: en bit plast uppsatt på väggen med en tejpbit över vart och ett av hörnen, inringad med anteckningen markfukt eller kondens. Tre, hygrometern: en mätare på en hylla vid den högra väggen, med det markerade talet över 75 procent relativ luftfuktighet ovanför."
            bildtext="Tre stopp i källaren, i den ordning verktyget frågar: väggen, tejpen och hygrometern. RF på hygrometern i skissen är relativ luftfuktighet."
          />
        )
      }
      <ol class="m-0 mt-4 pl-6 list-decimal text-brod lg:text-brod-lg">
        <li class="mb-2">
          Läckaget först. Har du kryssat i rinnmärken eller en pöl efter regn pekas det ut oavsett vad du svarat i
          övrigt. Det är den enda av de tre orsakerna som kan bli akut, och den enda tejptestet aldrig ser: plasten
          sitter på en vägg, vattnet kommer vid en genomföring.
        </li>
        <li class="mb-2">
          Sedan tejptestet, eftersom det är en mätning och inte ett intryck. Vått mot väggen är markfukt, vått mot
          rummet är kondens, och torrt på båda sidor betyder fel vägg.
        </li>
        <li class="mb-2">
          Sedan det du ser. Varje kryssruta hör till en rad i vår tabell över symptom och trolig orsak, och pekar två
          rader åt olika håll lämnar verktyget frågan öppen i stället för att gissa.
        </li>
        <li class="mb-2">
          Hygrometern sist. Den säger att luften är fuktig, aldrig varifrån vattnet kommer, så den kan aldrig flytta
          svaret från markfukt till kondens. Talet vägs mot Boverkets gräns på {KRITISK_RF} procent relativ
          luftfuktighet.
        </li>
        <li class="mb-2">
          Årstiden och vad källaren används till ändrar inte diagnosen. De lägger till en rad: kondens är ett
          sommarproblem, och Villaägarnas {KAN_HALLA_AR} år för en dränering gäller en källare som används som källare.
        </li>
        <li>
          Sist kommer åtgärden, med källan på raden. Ordningen är vår: det gratis före det billiga, och det billiga
          före grävmaskinen.
        </li>
      </ol>

      <p class="m-0 mt-6 text-brod lg:text-brod-lg">
        Att läckaget går före plasten, plasten före ögonen och ögonen före hygrometern är vårt eget beslut. Ingen
        källa vi hittat rangordnar indata mot varandra, och raden står därför märkt som antagande i tabellen nedan.
      </p>

      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">Vad svaret vilar på</h3>
      <Tabellyta kolumner={3} class="mt-4">
        <table class="w-full border-collapse text-liten tabular-nums">
          <caption class="sr-only">Gränser, priser och antaganden i självbesiktningen av källaren</caption>
          <thead>
            <tr class="border-b border-linje text-left">
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Storhet</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Vi räknar med</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Källa eller antagande</th>
            </tr>
          </thead>
          <tbody>
            {
              antaganden.map((a) => (
                <tr>
                  <th scope="row" class:list={[CELL_KLASS, 'text-left font-normal']}>
                    {a.storhet}
                  </th>
                  <td class={CELL_KLASS}>{a.varde}</td>
                  <td class={CELL_KLASS}>
                    {a.grund}.{' '}
                    {a.url ? (
                      <a href={a.url} rel={a.url.startsWith('/') ? undefined : 'nofollow'} class={LANK_KLASS}>
                        {a.stod}
                      </a>
                    ) : (
                      a.stod
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
          <tfoot>
            <tr>
              <td colspan="3" class="p-2 text-liten text-blyerts-2">
                Priserna är hämtade 16 och 18 september 2026. Ett pris är färskvara och läses om varje halvår. Raderna
                märkta Antagande är våra egna tal och våra egna läsningar av en källa.
              </td>
            </tr>
          </tfoot>
        </table>
      </Tabellyta>

      <p class="m-0 mt-6 text-brod lg:text-brod-lg">
        Tre saker kan verktyget inte se. Det första är fukten inne i materialet, som kräver en givare borrad i
        betongen och inte ett öga i ett rum. Det andra är det som växer bakom en skiva eller en träpanel mot
        ytterväggen, och där är rådet att skruva loss en bit i det hörn som luktar mest innan du köper något. Det
        tredje är radon: samma otäta vägg och samma springa mot golvet som släpper in markfukt släpper in markluft,
        och radon syns inte på plasten och bryr sig inte om din avfuktare.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Verktyget ger en trolig orsak, inte en besiktning. Ett besked härifrån ersätter ingen fuktutredning med
        mätvärden, och det är den du ska be om när du inte kommer längre själv. Metoden bakom våra siffror står på{' '}
        <a href="/om/sa-testar-vi/" class={LANK_KLASS}>Så testar vi</a>.
      </p>
    </section>

    <section>
      <Pennstreck id="las-vidare">Läs vidare</Pennstreck>
      <ul class="m-0 p-0 list-none">
        <li class="border-t border-linje">
          <a href="/fukt/fukt-i-kallaren/" class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
            Fukt i källaren, hela guiden med tejptestet och de tre orsakerna
          </a>
        </li>
        <li class="border-t border-linje">
          <a href="/fukt/luftfuktighet-inomhus/" class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
            Vad hygrometerns tal faktiskt betyder
          </a>
        </li>
        <li class="border-t border-linje">
          <a href="/grund/inreda-kallare/" class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
            Inreda källaren, fuktkraven och byggreglerna i rätt ordning
          </a>
        </li>
        <li class="border-t border-linje">
          <a href="/rakna/dranering/" class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
            Vad kostar det att dränera om huset?
          </a>
        </li>
      </ul>
    </section>

    <Faq fragor={FRAGOR} />
  </div>
</Bas>
