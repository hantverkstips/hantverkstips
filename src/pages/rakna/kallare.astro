---
/**
 * Självbesiktning av källaren: vad är det för fukt, och vad gör du åt den?
 * Formuläret skickas som GET till samma sida och bedömningen sker på servern,
 * så sidan fungerar utan ett enda byte klient-JS. Kostnaden är en
 * serverfunktion per anrop, och den hålls nere med CDN-cache. Se
 * docs/SPEC-SIDMALLAR.md avsnitt 4.7.
 *
 * Reglerna och alla antaganden ligger i src/lib/kalkyl/kallare.ts, och källan
 * bakom varje konstant står i
 * docs/briefer/underlag-kalkyl-kallare-2026-09-19.md. Sidan bedömer ingenting
 * själv, den visar bara svaret och redovisar källan bakom varje regel.
 *
 * Verktyget pekar inte ut någon produktegenskap, det ger en diagnos, så sidan
 * har varken produktkort eller reklamband. Pekar svaret mot en maskin eller
 * mot en grävning länkar den vidare med <Verktygskort>.
 */
export const prerender = false;

import { artikelUrl, publicerade } from '../../lib/innehall';
import { tillKortArtikel, type KortData } from '../../lib/kort';
import { hittaKalkylator } from '../../lib/kalkyl/register';
import { arPelare } from '../../lib/pelare';
import {
  AVFUKTARE_KR,
  bedomKallare,
  DRANERING_KR_PER_LOPMETER,
  FUKTUTREDNING_KR,
  HYGROMETER_DYGN,
  HYGROSTAT_RF,
  KAN_HALLA_AR,
  OMDRANERING_FRAN_AR,
  OMDRANERING_TILL_AR,
  KONDENS_MANAD_FRAN,
  KONDENS_MANAD_TILL,
  KRITISK_RF,
  kronor,
  REGN_LITER,
  REGN_MM,
  STANDARD,
  SYMPTOM,
  TAK_KVM,
  TEJPTEST_DYGN,
  tolkaQuery,
  type KallareIndata,
  type KallareResultat,
  type Steg,
} from '../../lib/kalkyl/kallare';
import { CELL_KLASS, LANK_KLASS } from '../../lib/kalkyl/stil';
import { verktygsillustration } from '../../lib/verktygsbild';
import KallareForm from '../../components/kalkyl/KallareForm.astro';
import Artikelrutnat from '../../components/ui/Artikelrutnat.astro';
import Faq from '../../components/ui/Faq.astro';
import Illustration from '../../components/ui/Illustration.astro';
import Pennstreck from '../../components/ui/Pennstreck.astro';
import Tabellyta from '../../components/ui/Tabellyta.astro';
import Verktygskort from '../../components/ui/Verktygskort.astro';
import Raknarsida from '../../components/vyer/Raknarsida.astro';

Astro.locals.sidtyp = 'verktyg';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

const q = Astro.url.searchParams;
const { indata } = tolkaQuery(q);
const resultat = bedomKallare(indata);

const fel = resultat.status === 'ogiltig' ? resultat.fel : {};
// Vid ogiltig indata visas standardvärdenas svar, med en rad som säger det.
const visat: KallareResultat = resultat.status === 'ogiltig' ? bedomKallare(STANDARD) : resultat;
const visatIndata: KallareIndata = resultat.status === 'ogiltig' ? STANDARD : indata;

/**
 * Fältets värde kommer från adressen som det skrevs, inte från det tolkade
 * talet: "fuktigt" blir NaN i tolkaQuery, och NaN i ett fält som läsaren ska
 * rätta är obrukbart.
 */
const varden = { rf: q.get('rf') ?? '' };

/**
 * Delbar länk. Hela frågan ligger redan i query-strängen, så adressen är
 * svaret. Den byggs av de tolkade värdena, inte av strängen läsaren skrev, och
 * varje val skrivs ut, även de som kom från standardvalet.
 */
const delaQuery = new URLSearchParams();
for (const s of visatIndata.symptom) delaQuery.append('se', s);
delaQuery.set('tejp', visatIndata.tejptest);
delaQuery.set('rf', visatIndata.luftfuktighet === null ? '' : String(visatIndata.luftfuktighet).replace('.', ','));
delaQuery.set('arstid', visatIndata.arstid);
delaQuery.set('bruk', visatIndata.anvandning);
const delaLank = new URL(`/rakna/kallare/?${delaQuery.toString()}`, Astro.site ?? Astro.url).toString();

/** Guidens fyra steg, som också är ordningen reglerna står i. */
const STEG_ETIKETT: Record<Steg, string> = {
  titta: 'Titta',
  tejpa: 'Tejpa',
  mat: 'Mät',
  atgarda: 'Åtgärda',
};

const titel = 'Besiktiga källaren själv och hitta vattnet';

/** Källorna bakom antagandetabellen, samlade så att raderna inte glider isär. */
const GUIDEN = '/fukt/fukt-i-kallaren/';
const BOVERKET_FUKTTILLSTAND =
  'https://www.boverket.se/sv/PBL-kunskapsbanken/regler-om-byggande/hygien-halsa-och-miljo/fuktsakerhet/';
const BOVERKET_KALLARVAGG =
  'https://www.boverket.se/sv/byggande/forebygg-fel-brister-skador/risker-byggande/risker-fuktskador/fuktrisker-for-grund/fuktrisker-med-kallare/risk-med-fuktintrangning-kallarvagg/';
const POLYGON = 'https://www.polygongroup.com/sv-SE/Nyheter/fukttransport/';
const KONSUMENTERNAS_DRANERING = 'https://www.konsumenternas.se/forsakringar/boendeforsakringar/villaforsakringar/skadeforebyggande-tips/';
const VILLAAGARNA = 'https://www.villaagarna.se/radgivning-och-tips/utomhus/grund/maste-du-dranera-huset/';
const GDS = 'https://gds.se/hus/inomhusklimat/fukt-i-kallare';
const MALARE =
  'https://malare-gustavsberg.se/blogg/mala-kallarvaggar-av-betong-guide-till-fukt-primer-och-farg/';
const FOLKHALSOMYNDIGHETEN =
  'https://www.folkhalsomyndigheten.se/regler-och-tillsyn/tillsynsvagledning-och-stod/halsoskydd-vagledning-och-tillsyn/tillsynsvagledning-om-fukt-och-mikroorganismer/';
const ANTICIMEX = 'https://www.anticimex.se/fuktskador/grund-kallare/';
const OCAB = 'https://www.ocab.se/fukt-och-vattenskador/fukt-i-kallare/';
const PROFFSMAGASINET =
  'https://www.proffsmagasinet.se/vvs-inomhusklimat/inomhusklimat/avfuktare/avfuktare/woods-sw39fw-i-ecodefrost-avfuktare-med-luftfilter-140-m-4058317';
const STRALSAKERHET =
  'https://www.stralsakerhetsmyndigheten.se/omraden/radon/referensniva-och-gransvarden-for-radon/';

/**
 * Månadsnumren i modulen skrivs ut med namn i tabellen. "Månad 7 till 9" är ett
 * tal läsaren måste slå upp, och cellen ska ändå inte kunna glida från koden.
 */
const MANAD = [
  '',
  'januari',
  'februari',
  'mars',
  'april',
  'maj',
  'juni',
  'juli',
  'augusti',
  'september',
  'oktober',
  'november',
  'december',
];
const kondenssasong = `${MANAD[KONDENS_MANAD_FRAN]} till ${MANAD[KONDENS_MANAD_TILL]}`;

const antaganden: { storhet: string; varde: string; grund: 'Källa' | 'Antagande'; stod: string; url?: string }[] = [
  {
    storhet: 'Symptom och trolig orsak',
    varde: `${SYMPTOM.length} rader`,
    grund: 'Antagande',
    stod: 'Min egen sammanställning i guiden om fukt i källaren. Två rader har egen källa, Villaägarnas salt och Folkhälsomyndighetens lukt. De fyra andra är min läsning av hur fukten rör sig',
    url: GUIDEN,
  },
  {
    storhet: 'Saltutfällning',
    varde: 'Tecken på fukt',
    grund: 'Källa',
    stod: 'Villaägarna, saltutfällningar visar att vägg och källargolv är fuktiga. Salt kommer inte ur luften',
    url: VILLAAGARNA,
  },
  {
    storhet: 'Markfukt skyddas utifrån',
    varde: 'Alltid på utsidan',
    grund: 'Källa',
    stod: 'Boverket, fukten från marken sugs främst upp genom porerna och väggen ska skyddas på utsidan',
    url: BOVERKET_KALLARVAGG,
  },
  {
    storhet: 'Kapillärsugning',
    varde: 'Vatten i vätskeform',
    grund: 'Källa',
    stod: 'Saneringsföretaget Polygon, vattnet stiger högre i finporösa material än i grova',
    url: POLYGON,
  },
  {
    storhet: 'Tejptestets tid',
    varde: `Minst ${TEJPTEST_DYGN} dygn`,
    grund: 'Antagande',
    stod: 'Tidningen Gör Det Själv säger två veckor. Två dygn är min undre gräns, och en vecka ger ett tydligare svar',
    url: GDS,
  },
  {
    storhet: 'Torr plast',
    varde: 'Fel vägg',
    grund: 'Antagande',
    stod: 'En målerifirma i Gustavsberg nöjer sig med ett till två dygn och nämner inte det torra utfallet. Att torr plast betyder fel vägg och inte frisk källare är min läsning',
    url: MALARE,
  },
  {
    storhet: 'Högsta tillåtna fukttillstånd',
    varde: `${KRITISK_RF} % relativ luftfuktighet`,
    grund: 'Källa',
    stod: 'Boverkets byggregler, BFS 2024:8, 7 kap. 1 §, när materialets eget värde inte är väl undersökt. Villaägarna säger samma sak i praktisk form',
    url: BOVERKET_FUKTTILLSTAND,
  },
  {
    storhet: 'Hygrostatens börvärde',
    varde: `${HYGROSTAT_RF} %`,
    grund: 'Antagande',
    stod: 'Marginal ner till Boverkets gräns, så att maskinen inte går i onödan. Ingen källa anger ett börvärde',
  },
  {
    storhet: 'Hygrometerns mättid',
    varde: `${HYGROMETER_DYGN} dygn`,
    grund: 'Antagande',
    stod: 'Symptomtabellen säger en vecka. Ingen källa anger en mättid, och en vecka täcker ett väderomslag',
    url: GUIDEN,
  },
  {
    storhet: 'Kondensens säsong',
    varde: kondenssasong.charAt(0).toUpperCase() + kondenssasong.slice(1),
    grund: 'Antagande',
    stod: 'Guiden om fukt i källaren. Ingen statistik finns över hur ofta kondens, markfukt och läckage förekommer',
    url: GUIDEN,
  },
  {
    storhet: 'Vad som väger tyngst',
    varde: 'Läckage, plast, ögon, hygrometer',
    grund: 'Antagande',
    stod: 'Ingen källa rangordnar de här mot varandra. Ordningen är min, och skälet står i stegen ovanför tabellen',
  },
  {
    storhet: 'Dräneringens livslängd',
    varde: `${OMDRANERING_FRAN_AR} till ${OMDRANERING_TILL_AR} år`,
    grund: 'Källa',
    stod: 'Konsumenternas, beroende på marken kan en omdränering behövas efter 15 till 40 år',
    url: KONSUMENTERNAS_DRANERING,
  },
  {
    storhet: 'Längst, oinredd källare',
    varde: `${KAN_HALLA_AR} år`,
    grund: 'Källa',
    stod: 'Villaägarna, en gammal dränering kan fungera i femtio år om källaren bara används som källare',
    url: VILLAAGARNA,
  },
  {
    storhet: 'Källaren som bostad',
    varde: 'Andra krav',
    grund: 'Källa',
    stod: 'Folkhälsomyndigheten, fukt i ett rum man vistas i kan vara en olägenhet för människors hälsa',
    url: FOLKHALSOMYNDIGHETEN,
  },
  {
    storhet: 'Mikrobiell lukt',
    varde: 'Tecken på fuktskada',
    grund: 'Källa',
    stod: 'Folkhälsomyndigheten. Samma vägledning säger att inga hälsobaserade riktvärden finns för exponeringen',
    url: FOLKHALSOMYNDIGHETEN,
  },
  {
    storhet: 'Kondens eller sorption',
    varde: '10 grader',
    grund: 'Antagande',
    stod: 'Tillverkaren Dantherm säger 8 grader, Ljungby Fuktkontroll 15. Jag säger 10, och skälet står på sidan om sorptionsavfuktare',
    url: '/fukt/sorptionsavfuktare/',
  },
  {
    storhet: 'Avfuktare till källaren',
    varde: `${kronor(AVFUKTARE_KR)} kr`,
    grund: 'Källa',
    stod: "Proffsmagasinet, Wood's SW39FW, pris hämtat 16 september 2026",
    url: PROFFSMAGASINET,
  },
  {
    storhet: 'Fuktutredning med mätvärden',
    varde: `${kronor(FUKTUTREDNING_KR)} kr inklusive moms`,
    grund: 'Källa',
    stod: 'Saneringsföretaget Ocab, fuktkontroll av källarutrymme. Deras eget listpris, som storleksordning',
    url: OCAB,
  },
  {
    storhet: 'Dränering per löpmeter',
    varde: `${kronor(DRANERING_KR_PER_LOPMETER)} kr i arbete`,
    grund: 'Källa',
    stod: 'Villaägarna, och det kan gå upp till det dubbla. Vad just din grund kostar räknar dräneringsverktyget',
    url: VILLAAGARNA,
  },
  {
    storhet: 'Vatten från taket',
    varde: `${kronor(REGN_LITER)} liter`,
    grund: 'Källa',
    stod: `Anticimex, ${REGN_MM} mm regn på ett tak på ${TAK_KVM} kvm. Det är därför stuprör och markfall kommer före allt annat`,
    url: ANTICIMEX,
  },
  {
    storhet: 'Radon',
    varde: '200 becquerel per kubikmeter',
    grund: 'Källa',
    stod: 'Strålsäkerhetsmyndigheten, referensnivå som årsmedelvärde. Jag mäter inte radon och ser det inte här',
    url: STRALSAKERHET,
  },
];

/** Frågorna sist på sidan. Talen är desamma som i brödtexten och i tabellen. */
const FRAGOR = [
  {
    fraga: 'Vad ska jag göra åt en fuktig källare?',
    svar: `Ta orsakerna i ordning, från det som är gratis till det som kostar. Titta först. Salt och flagnande färg längst ner på väggen pekar mot marken, imma på kallvattenrören mot luften, och rinnmärken efter regn mot ett läckage. Tejpa sedan en bit plastfolie tätt mot den våtaste väggen och läs av efter ${TEJPTEST_DYGN} dygn. Först när plasten har svarat vet du om du ska köpa en maskin, gräva eller täta en genomföring.`,
  },
  {
    fraga: 'Hur vet jag om det är markfukt eller kondens?',
    svar: 'Plasten säger det. Sitter dropparna på plastens utsida, mot rummet, bär luften mer vatten än den kalla väggen tål, och det är kondens. Sitter de på insidan, mot väggen, kommer vattnet genom betongen, och det är markfukt. Skillnaden avgör vad du ska lägga pengarna på. En avfuktare mot markfukt torkar rummet, ökar avdunstningen ur väggen och får betongen att suga efter mer vatten ur marken.',
  },
  {
    fraga: 'Kan jag besiktiga källaren själv?',
    svar: 'Så långt den här genomgången går, ja. Du kan se symptomen, göra tejptestet och läsa av en hygrometer, och det räcker för att skilja markfukt från kondens och läckage. Det du inte kan göra själv är att mäta fukten inne i materialet eller se vad som växer bakom en skiva. Kommer du inte längre, be om en fuktutredning med mätvärden och inte om en offert på en åtgärd.',
  },
];

/** Slug, namn och beskrivning på ett ställe: brödsmulan, og:image och WebApplication läser samma. */
const SLUG = 'kallare';
const VERKTYGSNAMN = 'Självbesiktning av källaren';
const BESKRIVNING =
  'Kryssa i vad du ser i källaren och vad hygrometern visar, så får du veta om det är markfukt, kondens eller ett läckage, och vad du gör härnäst.';
/** Skissen står i kortet Så bedömer jag. Huvudet har ingen bild sedan fas C (DESIGN.md 5.8). */
const illustration = verktygsillustration(SLUG);

/*
 * Svarsytan, fas C (spec-designlyft-c-2026-10-02 avsnitt 10): svaret är en
 * diagnos i ord, inget tal. Ny text är hantverkarens. Klartexten har
 * platshållarna {orsak} (diagnosen som i svarsytan) och {grans} (Boverkets
 * gräns i procent relativ luftfuktighet).
 */
const KLARTEXT =
  'Bedömningen ”{orsak}” bygger på tecknen du kryssat i och på tejptestet, om du har gjort det. Hygrometerns tal jämförs med Boverkets gräns på {grans} procent för fukt i väggar och trä.'; // kallare.klartext
const klartext =
  visat.status === 'ok' ? KLARTEXT.replace('{orsak}', visat.beskedRubrik).replace('{grans}', String(KRITISK_RF)) : '';

/** Läs vidare: artiklarna som artikelkort, räknaren med registrets namn som på hubben. */
const LAS_VIDARE = ['/fukt/fukt-i-kallaren/', '/fukt/luftfuktighet-inomhus/', '/grund/inreda-kallare/', '/rakna/dranering/'];
const artiklar = [...(await publicerade('guider')), ...(await publicerade('kunskap'))];
const lasVidare: KortData[] = LAS_VIDARE.flatMap((href): KortData[] => {
  const e = artiklar.find((a) => artikelUrl(a) === href);
  if (e) {
    const { niva: _niva, ...kort } = tillKortArtikel(e);
    return [kort];
  }
  const k = hittaKalkylator(href.replace(/^\/rakna\/|\/$/g, ''));
  const pelare = k?.pelare?.[0];
  if (!k || !pelare || !arPelare(pelare)) return [];
  return [
    {
      etikett: 'Räkna själv',
      rubrik: k.namn,
      beskrivning: k.rad,
      pelare,
      href,
      // Artikelrutnat läser inte typen; kortet står varken i ett typfilter eller sorteras.
      typ: 'kunskap',
      sorteringsdatum: new Date(0),
    },
  ];
});
---

<Raknarsida
  slug={SLUG}
  namn={VERKTYGSNAMN}
  titel={titel}
  beskrivning={BESKRIVNING}
  rubrik="Gå igenom källaren själv och få veta varifrån vattnet kommer"
  delaUrl={delaLank}
  saRaknarRubrik="Så bedömer jag"
  saRaknarId="sa-bedomer-vi"
>
  <p slot="ingress">
    Vattnet i en källare kommer från ett av tre håll. Markfukt går genom väggen, kondens fälls ut ur luften i
    rummet, och ett läckage tar sig in genom en otäthet när det regnar. En avfuktare löser bara det mittersta,
    och mot de andra två är den bortkastade pengar. Kryssa i vad du ser, vad hygrometern visar och vad
    tejptestet gav. Tejptestet är en bit plastfolie som suttit tätt mot väggen i två dygn. Då får du en trolig
    orsak, nästa steg och det du inte ska göra.
  </p>

  {/* Formuläret ligger i src/components/kalkyl/KallareForm.astro, så att
      <Kalkylator namn="kallare" /> i en artikel visar exakt samma fält. */}
  <KallareForm slot="formular" indata={indata} varden={varden} fel={fel} />

  {
    visat.status === 'ok' && (
      <Fragment slot="svar">
        {resultat.status === 'ogiltig' && (
          <p class="text-liten text-varning">
            Ett av fälten gick inte att läsa, så jag visar standardvärdena tills du rättat det.
          </p>
        )}
        {/* Svaret är en diagnos i ord: den står i Zilla Slab i stället för det stora talet. */}
        <div>
          <p class="text-liten text-blyerts-2">Trolig orsak</p>
          <p class="font-serif text-h2 text-blyerts">{visat.beskedRubrik}</p>
        </div>
        <p class="text-brod">{visat.beskedRad}</p>
        <div class="text-brod">
          <p class="font-bold">Nästa steg</p>
          <p>{visat.nastaStegText}</p>
          <p>
            <a href={visat.nastaStegLank.href} class:list={['inline-flex min-h-11 items-center', LANK_KLASS]}>
              {visat.nastaStegLank.text}
            </a>
          </p>
        </div>
        <p class="text-liten text-blyerts">{klartext}</p>
      </Fragment>
    )
  }

  {
    visat.status === 'ok' && (
      <Fragment slot="darfor">
        <Pennstreck id="darfor-blev-svaret-sa" utanLuft>
          Därför blev svaret så
        </Pennstreck>
        <p class="m-0 mt-4 mb-4">
          Raderna står i den ordning du går igenom källaren. Titta först, tejpa sedan, mät, och åtgärda sist.
        </p>
        <div class="darfor">
          {visat.regler.map((regel) => (
            <div>
              <span class="block text-etikett lg:text-etikett-lg uppercase text-blyerts-2">{STEG_ETIKETT[regel.steg]}</span>
              <p>{regel.text}</p>
              <p>{regel.kalla}</p>
            </div>
          ))}
        </div>
      </Fragment>
    )
  }

  {
    visat.status === 'ok' && visat.gorInteDetHar.length > 0 && (
      <Fragment slot="gorInte">
        {/* Flera råd står i samma stycke efter "Gör inte det här.", vart och ett på egen rad. */}
        {visat.gorInteDetHar.map((rad, i) => (
          <span class:list={[i > 0 && 'mt-3 block']}>{rad}</span>
        ))}
      </Fragment>
    )
  }

  <Fragment slot="saRaknarJag">
    {
      illustration && (
        <div class="pappersruta">
          <Illustration
            namn="rakna/kallare"
            alt="Källare i genomskärning med tre numrerade stopp: flagnande färg på väggen, en tejpad plastbit och en hygrometer på hyllan"
            bildtext="Stopp ett är väggen med salt och flagnande färg nedtill. Stopp två är plasten, tejpad över alla fyra hörnen. Stopp tre är hygrometern, som här visar över 75 procent relativ luftfuktighet. Så fuktig luft för med tiden trä och väggar över Boverkets gräns."
            class="my-0!"
          />
        </div>
      )
    }
    <ol class="m-0 mt-4 pl-6 list-decimal text-brod">
      <li class="mb-2">
        Läckaget väger tyngst. Har du kryssat i rinnmärken eller en pöl efter regn pekas det ut oavsett vad du
        svarat i övrigt. Det är den enda av de tre orsakerna som kan bli bråttom, och den enda tejptestet aldrig
        ser, för plasten sitter på en vägg och vattnet kommer vid en genomföring.
      </li>
      <li class="mb-2">
        Sedan kommer tejptestet, eftersom det är en mätning och inte ett intryck. Vått mot väggen är markfukt, vått
        mot rummet är kondens, och torrt på båda sidor betyder att plasten satt på fel vägg.
      </li>
      <li class="mb-2">
        Sedan det du ser. Varje kryssruta hör till en rad i min tabell över symptom och trolig orsak. Pekar två
        rader åt olika håll lämnar jag frågan öppen i stället för att gissa.
      </li>
      <li class="mb-2">
        Hygrometern kommer sist. Den säger att luften är fuktig, aldrig varifrån vattnet kommer, så den kan aldrig
        flytta svaret från markfukt till kondens. Talet vägs mot {KRITISK_RF} procent relativ luftfuktighet. Den
        gränsen sätter Boverket för trä och väggar, och luften ska ligga under den för att materialen inte ska nå dit.
      </li>
      <li class="mb-2">
        Årstiden och vad källaren används till ändrar inte diagnosen. De lägger till en rad var. Kondens är ett
        sommarproblem, och Villaägarnas {KAN_HALLA_AR} år för en dränering gäller en källare som används som
        källare.
      </li>
      <li>
        Sist kommer åtgärden, med källan på raden. Ordningen är min, och den går från det gratis till det billiga
        och först därefter till grävmaskinen.
      </li>
    </ol>

    <p class="m-0 mt-4 text-brod">
      Att läckaget går före plasten, plasten före ögonen och ögonen före hygrometern har jag bestämt själv. Ingen
      källa jag hittat rangordnar dem mot varandra, så den raden står märkt som antagande i tabellen nedan.
    </p>
  </Fragment>

  <Fragment slot="efter">
    {/* Antagandetabellen i läsbredd, ur kortet Så bedömer jag (spec-designlyft-c avsnitt 9). */}
    <section class="max-w-lasbredd">
      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">Vad siffrorna vilar på</h3>
      <Tabellyta kolumner={3} class="mt-4">
        <table class="w-full border-collapse text-liten tabular-nums">
          <caption class="sr-only">Gränser, priser och antaganden i självbesiktningen av källaren</caption>
          <thead>
            <tr class="border-b border-linje text-left">
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Vad</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Jag räknar med</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Källa eller antagande</th>
            </tr>
          </thead>
          <tbody>
            {
              antaganden.map((a) => (
                <tr>
                  <th scope="row" class:list={[CELL_KLASS, 'text-left font-normal']}>
                    {a.storhet}
                  </th>
                  <td class={CELL_KLASS}>{a.varde}</td>
                  <td class={CELL_KLASS}>
                    {a.grund}.{' '}
                    {a.url ? (
                      <a href={a.url} rel={a.url.startsWith('/') ? undefined : 'nofollow'} class={LANK_KLASS}>
                        {a.stod}
                      </a>
                    ) : (
                      a.stod
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
          <tfoot>
            <tr>
              <td colspan="3" class="p-2 text-liten text-blyerts-2">
                Ett pris är färskvara, så datumet står på raden och priset läses om varje halvår. Raderna märkta
                Antagande är mina egna tal och mina egna läsningar av en källa.
              </td>
            </tr>
          </tfoot>
        </table>
      </Tabellyta>

      <p class="m-0 mt-6 text-brod lg:text-brod-lg">
        Fukten inne i materialet ser jag inte härifrån. Den kräver en givare borrad i betongen, inte ett öga i ett
        rum.
      </p>
      <p class="m-0 mt-2 text-brod lg:text-brod-lg">
        Det som växer bakom en skiva eller en träpanel mot ytterväggen ser jag inte heller. Skruva loss en bit i det
        hörn som luktar mest, så vet du.
      </p>
      <p class="m-0 mt-2 text-brod lg:text-brod-lg">
        Radon syns varken på plasten eller på hygrometern. Samma otäta vägg och samma springa mot golvet som
        släpper in markfukt släpper in markluft, och radon bryr sig inte om din avfuktare.{' '}
        <a href="/fukt/radon/" class={LANK_KLASS}>Hur du mäter radon och vad 200 becquerel per kubikmeter betyder</a>.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Det du får här är en trolig orsak. Den ersätter ingen fuktutredning med mätvärden, och det är en sådan du
        ska be om när du inte kommer längre själv. Var talen kommer ifrån och hur jag kontrollerar dem står på sidan{' '}
        <a href="/om/sa-testar-vi/" class={LANK_KLASS}>Så testar jag</a>.
      </p>
    </section>

    {
      visat.status === 'ok' && (visat.visaAvfuktare || visat.visaDranering) && (
        <div class="max-w-lasbredd">
          {visat.visaAvfuktare && <Verktygskort kalkylator="avfuktare" />}
          {visat.visaDranering && <Verktygskort kalkylator="dranering" />}
        </div>
      )
    }

    <section class="max-w-lasbredd">
      <Pennstreck id="tre-orsaker">Varför bara en av de tre orsakerna löses med en avfuktare</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        Markfukt, kondens och läckage kräver tre olika åtgärder, och maskinen du kan köpa på vägen hem hjälper bara
        mot en av dem. Det är hela skälet till att jag säger vänta med plånboken tills plasten på väggen har svarat.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Markfukten går rakt genom betongen. Boverket beskriver det som att vattnet sugs upp genom porerna, som i en
        sockerbit i kaffet, och ibland vandrar det som ånga tvärs genom materialet. Det går så långsamt att det kan ta
        många år innan du märker något. Skyddet mot markfukt hör hemma på utsidan av väggen, och det är därför en
        avfuktare inne i rummet är fel maskin. Luften torkar, mer vatten dunstar ur väggen, och betongen suger efter
        mer från marken.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Av samma skäl ska ytskiktet inne i källaren släppa igenom vattenånga. Målar du med en tät färg stannar
        vattnet i betongen och trycker upp färgen i sjok. Det är det kryssrutan om färg som bubblar handlar om.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Kondensen vädrar du in själv. En källarvägg håller gärna 12&nbsp;grader, och luften du släpper in en varm
        eftermiddag i augusti börjar fälla ut vatten redan vid 14,4&nbsp;grader. Det talet gäller luft på
        20&nbsp;grader och 70&nbsp;procent relativ luftfuktighet, en helt vanlig sommardag. Väggen blir våt i
        samma stund som du ställer upp fönstret. Det här är det enda av de tre fallen där en avfuktare gör jobbet,
        och hur stor den behöver vara beror på rummets volym och hur fuktig luften är.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Läckaget kommer med regnet. Det tar sig in på ett ställe, ser ut som rinnmärken eller en pöl snarare än en
        jämnt fuktig vägg, och det är det enda av de tre som kan bli bråttom. Följ vattnet uppåt och utåt. Oftast
        hittar du en rörgenomföring som aldrig tätades, en spricka efter en sättning, en fönsterbrunn full av löv
        eller ett stuprör som slutar en halvmeter från grunden.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Att gissa fel kostar mer än några hundralappar. En avfuktare mot markfukt är {kronor(AVFUKTARE_KR)}&nbsp;kr
        som inte gör någon nytta alls, och en dränering som inte behövdes är tjugo gånger den summan. Två dygn med
        en bit plast på väggen skyddar dig mot båda. Hela testet, med bild på båda utfallen,
        står i{' '}
        <a href="/fukt/fukt-i-kallaren/" class={LANK_KLASS}>
          guiden om fukt i källaren
        </a>
        .
      </p>
    </section>

    {
      lasVidare.length > 0 && (
        <section>
          <Pennstreck id="las-vidare">Läs vidare</Pennstreck>
          <Artikelrutnat kort={lasVidare} kolumner={4} visaBeskrivning={false} visaMeta={false} />
        </section>
      )
    }

    <div class="max-w-lasbredd">
      <Faq fragor={FRAGOR} />
    </div>
  </Fragment>
</Raknarsida>
