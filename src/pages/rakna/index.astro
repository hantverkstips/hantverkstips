---
/**
 * Räkna själv-indexet. Statiskt, inga köpknappar, inget reklamband.
 *
 * Sedan designlyftet 2026-10-02 (docs/DESIGN.md 5.8.1, spec fas A avsnitt 8):
 * rubrikbandet med brödsmulor, H1, ingress och chips till grupperna, och till
 * höger daggpunktens inbäddade räknare som "Prova direkt". Sedan en sektion per
 * grupp i src/lib/kalkyl/grupper.ts: fyra räknare eller färre som verktygskort
 * med bild, två i rad från 1024 px; fler som den kompakta listan med namnet och
 * svarets form. Sist stycket om källorna i en färgad yta.
 */
import Bas from '../../layouts/Bas.astro';
import { RAKNEGRUPPER } from '../../lib/kalkyl/grupper';
import { hittaKalkylator, type Kalkylator as Raknare } from '../../lib/kalkyl/register';
import Brodsmulor from '../../components/ui/Brodsmulor.astro';
import Kalkylator from '../../components/ui/Kalkylator.astro';
import Rubrikrad from '../../components/ui/Rubrikrad.astro';
import Verktygskort from '../../components/ui/Verktygskort.astro';

const PROVA_ETIKETT = 'Prova en räknare'; // rakna.prova.etikett

const brodsmulor = [{ namn: 'Hantverkstips', href: '/' }, { namn: 'Räkna själv' }];

const grupper = RAKNEGRUPPER.map((g) => ({
  ...g,
  raknare: g.slugs.map((s) => {
    const k = hittaKalkylator(s);
    if (!k) throw new Error(`[rakna] Okänd räknare "${s}" i grupperna`);
    return k;
  }) as Raknare[],
}));
---

<Bas
  title="Räkna själv"
  description="Räkna ut hur mycket material du behöver, vad jobbet kostar och om du behöver bygglov. Varje tal har en källa, och svaret ligger kvar i länken."
  brodsmulor={brodsmulor}
  galleri
  brodsmulorIVy
>
  <section class="band">
    <div
      class="sidram grid grid-cols-1 items-center gap-8 pt-6 pb-8 lg:items-start lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] lg:gap-12 lg:pt-10 lg:pb-11"
    >
      <div class="flex flex-col gap-4">
        <Brodsmulor lista={brodsmulor} />
        <h1 class="m-0 font-serif text-h1 lg:text-h1-lg">Räkna själv</h1>
        <p class="m-0 text-ingress lg:text-ingress-lg">
          Här räknar du ut talet du behöver innan du köper material eller drar igång maskinen. Du fyller i dina egna
          mått, och verktyget räknar på siffror jag kan peka ut varifrån de kommer. Svaret är ett spann att hålla sig
          inom, för ingen tomt och inget hus är exakt som standardvärdena.
        </p>
        <div class="flex flex-wrap gap-2">
          {
            grupper.map((g) => (
              <a class="chip bg-papper" href={`#${g.id}`}>
                {g.rubrik} · {g.raknare.length}
              </a>
            ))
          }
        </div>
      </div>
      <Kalkylator namn="daggpunkt" etikett={PROVA_ETIKETT} blad visaSvar />
    </div>
  </section>

  {
    grupper.map((g) => (
      <section class="sidram pt-12 lg:pt-14">
        <Rubrikrad id={g.id} rubrik={g.rubrik} rad={g.rad} />
        {g.raknare.length <= 4 ? (
          <div class="grid grid-cols-1 gap-4 lg:grid-cols-2 lg:gap-5">
            {g.raknare.map((k) => (
              <Verktygskort kalkylator={k.slug} variant="bild" iRutnat />
            ))}
          </div>
        ) : (
          <ul class="raknelista">
            {g.raknare.map((k) => (
              <li>
                <a href={`/rakna/${k.slug}/`}>
                  <span>{k.namn}</span>
                  <span>{k.svar}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))
  }

  <section class="sidram py-12 lg:py-16">
    <div class="yta p-6 lg:p-8">
      <p class="m-0 max-w-lasbredd text-brod lg:text-brod-lg">
        Varje verktyg visar var talen kommer ifrån. Under svaret står en tabell med en källa bakom varje tal, ett
        datablad eller en myndighet, eller ordet antagande när jag har valt talet själv. När du har räknat ligger dina
        värden kvar i webbläsarens adressfält, så du kan spara länken eller dela uträkningen med den som ska göra jobbet.
      </p>
    </div>
  </section>
</Bas>
