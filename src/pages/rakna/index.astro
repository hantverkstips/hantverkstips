---
/**
 * Listsida för kalkylatorerna. Statisk, inga köpknappar, inget reklamband.
 */
import Bas from '../../layouts/Bas.astro';
import { KALKYLATORER } from '../../lib/kalkyl/register';
import Pennstreck from '../../components/ui/Pennstreck.astro';
---

<Bas
  title="Räkna själv"
  description="Kalkylatorer med källa på varje tal: om väggen blir våt av kondens, hur stor avfuktare du behöver, och fler när säsongen kräver dem."
  brodsmulor={[{ namn: 'Hantverkstips', href: '/' }, { namn: 'Räkna själv' }]}
>
  <h1 class="m-0 font-serif text-h1 lg:text-h1-lg">Räkna själv</h1>
  <p class="m-0 mt-4 text-ingress lg:text-ingress-lg">
    Kalkylatorerna räknar på riktiga produktdata. Resultatet är en marginal, inte ett exakt svar.
  </p>

  {
    KALKYLATORER.map((k) => (
      <section>
        <Pennstreck id={k.slug}>
          <a href={`/rakna/${k.slug}/`} class="text-blyerts no-underline hover:underline hover:decoration-penna">
            {k.namn}
          </a>
        </Pennstreck>
        <p class="m-0 text-brod lg:text-brod-lg">{k.rad}</p>
      </section>
    ))
  }
</Bas>
