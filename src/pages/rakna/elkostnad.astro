---
/**
 * Elkostnadskalkylatorn. Formuläret skickas som GET till samma sida och
 * beräkningen sker på servern, så sidan fungerar utan ett enda byte klient-JS.
 * Kostnaden är en serverfunktion per anrop, och den hålls nere med CDN-cache.
 * Se docs/SPEC-SIDMALLAR.md avsnitt 4.7.
 *
 * Formeln och alla antaganden ligger i src/lib/kalkyl/elkostnad.ts. Sidan räknar
 * ingenting själv, den visar bara resultatet och redovisar källorna.
 *
 * Query-parametern produkt fyller fälten ur produktens specs. Uppslaget sker
 * här och inte i formeln: src/lib/kalkyl/ är rena moduler utan databas, och
 * produktForval() tar emot specs som ett vanligt objekt.
 *
 * Räkningen pekar inte ut någon produkt, den räknar på den maskin läsaren redan
 * har eller tittar på. Därför har sidan varken produktkort eller reklamband.
 */
export const prerender = false;

import Bas from '../../layouts/Bas.astro';
import { ELPRIS_KALLA, ELPRIS_KR_PER_KWH } from '../../lib/antaganden';
import { formateraPris, formateraTal } from '../../lib/format';
import {
  produktForval,
  produktSlugFranQuery,
  raknaElkostnad,
  standardMedForval,
  tolkaQuery,
  type ElkostnadIndata,
  type ElkostnadResultat,
} from '../../lib/kalkyl/elkostnad';
import { CELL_KLASS, ETIKETT_KLASS, FALT_KLASS, LANK_KLASS } from '../../lib/kalkyl/stil';
import { hamtaProdukt, produktNamn } from '../../lib/produkter';
import { verktyg } from '../../lib/strukturdata';
import { verktygsDelningsbild, verktygsillustration, verktygsVarumarkesbild } from '../../lib/verktygsbild';
import ElkostnadForm from '../../components/kalkyl/ElkostnadForm.astro';
import Faktaruta from '../../components/ui/Faktaruta.astro';
import Faq from '../../components/ui/Faq.astro';
import Markering from '../../components/ui/Markering.astro';
import Pennstreck from '../../components/ui/Pennstreck.astro';
import StrukturData from '../../components/ui/StrukturData.astro';
import Tabellyta from '../../components/ui/Tabellyta.astro';
import Illustration from '../../components/ui/Illustration.astro';

Astro.locals.sidtyp = 'verktyg';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

const q = Astro.url.searchParams;

/* Produkten i adressen, när läsaren kom hit från ett produktkort. */
const produktSlug = produktSlugFranQuery(q);
const produkt = produktSlug ? await hamtaProdukt(produktSlug) : null;
const forval = produktForval(produkt?.specs ?? null);
const standard = standardMedForval(forval);

const { indata } = tolkaQuery(q, forval);
const resultat = raknaElkostnad(indata);

const fel = resultat.status === 'ogiltig' ? resultat.fel : {};
// Vid ogiltig indata visas standardvärdenas resultat, med en rad som säger det.
const visat: ElkostnadResultat = resultat.status === 'ogiltig' ? raknaElkostnad(standard) : resultat;
const visatIndata: ElkostnadIndata = resultat.status === 'ogiltig' ? standard : indata;

const komma = (n: number) => String(n).replace('.', ',');
/** Tal i löptext: heltal utan decimal, annars en. "19 liter", "7,4 liter". */
const talText = (n: number) => formateraTal(n, Number.isInteger(n) ? 0 : 1);
/**
 * Energin och priset per liter. En decimal räcker (beslut i granskningen
 * omgång 3: 1,7 kWh och 4,1 kr), men under en krona säger en decimal inget,
 * och då skrivs två ut.
 */
const perLiter = (n: number) => formateraTal(n, n >= 1 ? 1 : 2);

/**
 * Fältens värden kommer från query-strängen som den skrevs, inte från de tolkade
 * talen: "trehundra" eller "" blir NaN i tolkaQuery, och NaN i ett fält som
 * läsaren ska rätta är obrukbart.
 */
function faltVarde(nyckel: string, standardVarde: number): string {
  const ra = q.get(nyckel);
  if (ra !== null) return ra;
  return komma(standardVarde);
}

/* Dagarna kan stå i fältet dagareget när radioknappen "Eget antal" är vald. */
const raDagar = q.get('dagar');
const dagarVarde =
  raDagar === null ? komma(standard.dagar) : raDagar.trim() === 'eget' ? (q.get('dagareget') ?? '') : raDagar;

/* Literfältet förifylls aldrig ur produkten. Skälet står vid produktForval. */
const literVarde = q.get('liter') ?? '';

const varden = {
  effekt: faltVarde('effekt', standard.effektW),
  timmar: faltVarde('timmar', standard.timmarPerDygn),
  dagar: dagarVarde,
  // Elpriset skrivs med två decimaler i fältet, som på fakturan och i tabellerna.
  elpris: q.get('elpris') ?? formateraTal(standard.elprisKrPerKwh, 2),
  liter: literVarde,
};

/** Raden över formuläret när adressen pekar ut en produkt. */
let produktRad: string | null = null;
if (produktSlug !== null) {
  if (produkt && forval.effektW !== null) {
    const namn = produktNamn(produkt);
    produktRad = `Jag räknar på ${namn}, som drar ${talText(forval.effektW)} W enligt butiken. Har du egna tal, byt ut dem.`;
  } else {
    produktRad =
      'Maskinen i länken finns inte i min produktdatabas, eller så saknar den uppgift om effekt. Fälten står därför på standardvärdena.';
  }
}

/**
 * Delbar länk. Hela tillståndet ligger redan i query-strängen, så adressen är
 * uträkningen. Den byggs av de tolkade värdena, inte av strängen läsaren skrev,
 * och dagarna skrivs alltid som ett tal, aldrig som "eget".
 */
const delaQuery = new URLSearchParams({
  effekt: komma(visatIndata.effektW),
  timmar: komma(visatIndata.timmarPerDygn),
  dagar: komma(visatIndata.dagar),
  elpris: komma(visatIndata.elprisKrPerKwh),
});
if (visatIndata.literPerDygn !== null) delaQuery.set('liter', komma(visatIndata.literPerDygn));
const delaLank = new URL(`/rakna/elkostnad/?${delaQuery.toString()}`, Astro.site ?? Astro.url).toString();

/** Tal ur resultatet, färdigformaterade, så att markupen nedan blir läsbar. */
const tal =
  visat.status === 'ok'
    ? {
        kwhPerDygn: formateraTal(visat.kwhPerDygn, 2),
        kwhPerPeriod: formateraTal(visat.kwhPerPeriod, 1),
        krPerPeriod: formateraPris(visat.krPerPeriod),
        krPerDygn: formateraTal(visat.krPerDygn, 2),
        kwhPerAr: formateraTal(visat.kwhPerAr, 0),
        krPerAr: formateraPris(visat.krPerAr),
        kwhPerLiter: visat.kwhPerLiter === null ? null : perLiter(visat.kwhPerLiter),
        krPerLiter: visat.krPerLiter === null ? null : perLiter(visat.krPerLiter),
        effekt: talText(visatIndata.effektW),
        timmar: talText(visatIndata.timmarPerDygn),
        dagar: talText(visatIndata.dagar),
        elpris: formateraTal(visatIndata.elprisKrPerKwh, 2),
        liter: visatIndata.literPerDygn === null ? null : talText(visatIndata.literPerDygn),
      }
    : null;

const titel = 'Vad kostar maskinen i el per månad och år';

/** Antagandena i tabellen under "Så räknar vi". Samma tal som konstanterna i kalkylen. */
const antaganden: { storhet: string; varde: string; grund: 'Källa' | 'Antagande'; stod: string; url?: string }[] = [
  {
    storhet: 'Elpriset, om du inte skriver ett eget',
    varde: `${formateraTal(standard.elprisKrPerKwh, 2)} kr per kWh`,
    grund: 'Källa',
    stod: `SCB, genomsnitt för ${ELPRIS_KALLA.omfattar}, ${ELPRIS_KALLA.period}`,
    url: ELPRIS_KALLA.url,
  },
  {
    storhet: 'Vad maskinen drar medan den går',
    varde: 'märkeffekten, hela tiden',
    grund: 'Antagande',
    stod: 'Jag räknar med att maskinen drar sin märkeffekt varje minut den är igång. En kompressor pendlar i verkligheten, så talet är en övre gräns',
  },
  {
    storhet: 'Gångtiden per dygn',
    varde: `${formateraTal(standard.timmarPerDygn)} timmar som standard`,
    grund: 'Antagande',
    stod: 'Min gissning för en avfuktare på hygrostat i en källare som inte är genomblöt. Ingen har mätt drifttiden, och det är det tal som påverkar svaret mest',
  },
  {
    storhet: 'Året',
    varde: '365 dagar',
    grund: 'Antagande',
    stod: 'Skottår räknar jag inte med. Skillnaden är under tre promille och drunknar i osäkerheten på gångtiden',
  },
];

/**
 * Frågorna sist på sidan. Svaren använder samma tal som räkneexemplen ovanför,
 * och elpriset kommer ur ELPRIS_KR_PER_KWH som hela sajten räknar med.
 */
const FRAGOR = [
  {
    fraga: 'Hur räknar jag om watt till kWh?',
    svar: 'Dela effekten i watt med 1 000, så har du kilowatt. Multiplicera sedan kilowatten med antalet timmar maskinen faktiskt går, så har du kilowattimmar. En maskin på 1 000 W som går en timme drar alltså en kilowattimme. Det är den enheten elbolaget tar betalt för, så när du har kilowattimmarna är det bara att multiplicera med priset.',
  },
  {
    fraga: 'Drar en avfuktare mycket el?',
    svar: 'En vanlig kondensavfuktare till en källare ligger på 320 W. Styrs den av en hygrometer som stänger av den när luften är torr nog går den kanske åtta timmar per dygn, och då landar månaden på 184 kr. En värmefläkt i garaget kostar mer än så trots kortare gångtid, eftersom effekten är dubbelt så hög. Det som avgör räkningen är alltid effekten gånger timmarna, inte hur stor maskinen ser ut.',
    lank: { text: 'Se elen för fyra avfuktare i guiden om avfuktare till källaren.', href: '/fukt/avfuktare-kallare/' },
  },
  {
    fraga: 'Vad kostar en kWh 2026?',
    svar: `Om du inte skriver något annat räknar verktyget med ${String(ELPRIS_KR_PER_KWH).replace('.', ',')} kr per kWh. Talet är statistikmyndigheten SCB:s genomsnitt för hushåll, ${ELPRIS_KALLA.period}, och det omfattar elhandel, nätavgift, energiskatt och moms. Ditt eget pris står på fakturan och kan ligga en bra bit från genomsnittet. Byt talet i fältet, så räknas allt om.`,
  },
];

/** Slug, namn och beskrivning på ett ställe: brödsmulan, og:image och WebApplication läser samma. */
const SLUG = 'elkostnad';
const VERKTYGSNAMN = 'Elkostnadskalkylator';
const BESKRIVNING =
  'Räkna ut elkostnaden för avfuktaren, värmefläkten eller frysen. Du får kilowattimmar och kronor per månad och år, räknat på SCB:s elpris eller ditt eget.';
const illustration = verktygsillustration(SLUG);
/**
 * Varumärkesbilden i sidhuvudet, sedan 2026-09-19 (docs/DESIGN.md avsnitt 7).
 * Finns den står skissen i stället i "Så räknar vi", där måtten förklarar
 * räkningen. Finns den inte visas skissen i sidhuvudet som förut.
 */
const varumarke = verktygsVarumarkesbild(SLUG);
const huvudbild = varumarke ?? illustration;
---

<Bas
  title={titel}
  description={BESKRIVNING}
  reklam={false}
  brodsmulor={[
    { namn: 'Hantverkstips', href: '/' },
    { namn: 'Räkna själv', href: '/rakna/' },
    { namn: VERKTYGSNAMN },
  ]}
  bred={true}
  ogBild={verktygsDelningsbild(SLUG)}
>
  <StrukturData
    slot="head"
    data={verktyg({ url: `/rakna/${SLUG}/`, namn: VERKTYGSNAMN, beskrivning: BESKRIVNING })}
  />

  <div class="mx-auto w-full max-w-lasbredd">
    {/*
      Sidhuvudet: rubrik och ingress till vänster i 7/12, bilden till höger i
      5/12 på desktop, under ingressen på mobil. Bilden är dekorativ, H1 bär
      betydelsen, därför tom alt. Den är sidans LCP-bild och laddas därför
      eagert med fetchpriority. Varumärkesbilden har transparent bakgrund och
      ligger som heron utan ram; skissen är ett urklipp och får ramen. Saknas
      båda visas ingen bild alls.
    */}
    <section class="grid grid-cols-1 items-center gap-6 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7">
        <h1 class="m-0 font-serif text-h1 lg:text-h1-lg">Vad kostar maskinen i el? Räkna ut kWh och kronor</h1>
        <p class="m-0 mt-4 text-ingress lg:text-ingress-lg">
          Det här är för maskinen som står och går, som avfuktaren i källaren, värmefläkten i garaget eller frysen
          i förrådet. Fyll i effekten i watt, hur många timmar om dygnet den går och vad du betalar för elen, så
          får du kilowattimmar och kronor per månad och år. Svaret är en övre gräns, eftersom de flesta maskiner
          drar mindre än full effekt en del av tiden.
        </p>
      </div>

      {
        huvudbild && (
          <div class="lg:col-span-5">
            <img
              src={huvudbild.src}
              alt=""
              width={huvudbild.width}
              height={huvudbild.height}
              fetchpriority="high"
              decoding="async"
              class:list={['block h-auto w-full', !varumarke && 'rounded-sm border border-linje']}
            />
          </div>
        )
      }
    </section>

    {
      visat.status === 'ok' && tal && (
        <Faktaruta variant="kortsvar">
          <p class="m-0 leading-6">Din maskin drar {tal.kwhPerDygn} kWh el per dygn.</p>
          <p class="m-0 leading-6">
            På {tal.dagar} dagar blir det <Markering>{tal.kwhPerPeriod} kWh</Markering>, och det kostar{' '}
            {tal.krPerPeriod}.
          </p>
          <p class="m-0 leading-6">Låter du den gå så hela året hamnar du på {tal.krPerAr}.</p>
          {tal.krPerLiter && <p class="m-0 leading-6">Varje liter vatten den tar upp kostar {tal.krPerLiter} kr.</p>}
        </Faktaruta>
      )
    }

    <div class="linjerat mt-8 lg:grid lg:grid-cols-2 lg:gap-8">
      <ElkostnadForm
        indata={indata}
        varden={varden}
        fel={fel}
        produktSlug={produktSlug}
        produktRad={produktRad}
      />

      <div class="mt-8 border-t border-linje pt-6 lg:mt-0 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8">
        {
          visat.status === 'ok' && tal && (
            <>
              {resultat.status === 'ogiltig' && (
                <p class="m-0 mb-2 text-liten text-varning">
                  Ett av fälten gick inte att läsa, så jag visar standardvärdena tills du rättat det.
                </p>
              )}
              {/* Beskedet står först. Delposterna och rådet står under verktyget. */}
              <p class="m-0 font-sans text-h3 lg:text-h3-lg font-bold text-blyerts">
                Räkna med {tal.krPerPeriod} för {tal.dagar} dagar, och {tal.krPerAr} om året.
              </p>
              <p class="m-0 mt-1 text-brod">
                Det är en övre gräns, för jag räknar med att maskinen drar full effekt varje minut den går.
              </p>

              <p class="m-0 mt-6 text-etikett lg:text-etikett-lg uppercase text-blyerts-2">På {tal.dagar} dagar</p>
              {/* Enheten står på samma rad som talet, på talets baslinje
                  (DESIGN.md avsnitt 5.8). Radbryter på smal skärm. */}
              <p class="m-0 mt-1 flex flex-wrap items-baseline gap-x-2">
                <span class="font-serif text-siffra lg:text-siffra-lg text-blyerts">
                  <Markering>{tal.kwhPerPeriod}</Markering>
                </span>
                <span class="text-ingress lg:text-ingress-lg">kWh</span>
              </p>
              <p class="m-0 mt-2 flex flex-wrap items-baseline gap-x-2">
                <span class="font-serif text-siffra lg:text-siffra-lg text-blyerts">{tal.krPerPeriod}</span>
                <span class="text-ingress lg:text-ingress-lg">för samma dagar</span>
              </p>
              <p class="m-0 mt-2 text-liten text-blyerts-2">
                Räknat på {tal.effekt} W i {tal.timmar} timmar per dygn och {tal.elpris} kr per kilowattimme.
              </p>

              <p class="m-0 mt-4 text-liten text-blyerts-2">
                Vad det blir per dygn, per liter och på ett år{' '}
                <a href="#darfor-blev-svaret-sa" class={LANK_KLASS}>
                  står under verktyget
                </a>
                .
              </p>

              <p class="m-0 mt-4">
                <a href="#sa-raknar-vi" class:list={['inline-flex min-h-11 items-center', LANK_KLASS]}>
                  Så räknar jag
                </a>
              </p>

              {/* Dela. Uträkningen står i adressen, så ett skrivskyddat fält
                  räcker: markera och kopiera fungerar utan en rad JavaScript. */}
              <div class="mt-4 border-t border-linje pt-4">
                <label for="dela" class={ETIKETT_KLASS}>
                  Dela uträkningen
                </label>
                <input id="dela" type="text" readonly value={delaLank} class:list={[FALT_KLASS, 'border-blyerts-2']} />
                <p class="m-0 mt-1 text-liten text-blyerts-2">
                  Dina värden ligger i adressen. Markera den och kopiera, så får den du skickar till samma svar.
                </p>
              </div>
            </>
          )
        }
      </div>
    </div>

    {
      visat.status === 'ok' && tal && (
        <section>
          <Pennstreck id="darfor-blev-svaret-sa">Därför blev svaret så</Pennstreck>
          <ul class="m-0 p-0 list-none text-brod lg:text-brod-lg">
            <li class="mb-4 border-l-2 border-linje pl-4">
              <span class="block">
                {tal.effekt} W i {tal.timmar} timmar ger {tal.kwhPerDygn} kWh per dygn, och med ditt elpris kostar
                varje dygn {tal.krPerDygn} kr. Låter du maskinen gå lika mycket hela året blir det {tal.kwhPerAr}{' '}
                kWh och {tal.krPerAr}.
              </span>
              <span class="block text-liten text-blyerts-2">
                Watt gånger timmar delat med tusen. Elpriset är SCB:s genomsnitt, {ELPRIS_KALLA.period}, om du inte
                skrev in ett eget.
              </span>
            </li>
            {tal.krPerLiter && tal.kwhPerLiter && (
              <li class="mb-4 border-l-2 border-linje pl-4">
                <span class="block">
                  Delar jag dygnets kilowattimmar med litrarna du fyllde i går det åt {tal.kwhPerLiter} kWh per liter
                  vatten, och varje liter kostar {tal.krPerLiter} kr. Det är det enda tal som går att jämföra rakt
                  av mellan en kondensmaskin och en sorptionsmaskin.
                </span>
                <span class="block text-liten text-blyerts-2">
                  Litertalet är ditt eget. Skrev du lådans siffra ser priset per liter ungefär tre gånger bättre ut än
                  det blir i en källare.
                </span>
              </li>
            )}
            <li class="mb-4 border-l-2 border-linje pl-4">
              <span class="block">
                Det jag inte vet är hur mycket maskinen pendlar. En kompressor på hygrostat drar full effekt i korta
                perioder och ingenting däremellan, så en timme gångtid är sällan en timme full effekt. Räkna med att
                det verkliga talet ligger under svaret här.
              </span>
              <span class="block text-liten text-blyerts-2">
                Mitt antagande är märkeffekt hela gångtiden. Ingen uppmätt drifttid ligger bakom.
              </span>
            </li>
          </ul>
          {visat.gorInteDetHar && (
            <>
              <h3 id="gor-inte-det-har" class="m-0 mt-6 font-sans text-h3 lg:text-h3-lg text-blyerts">
                Gör inte det här
              </h3>
              <p class="m-0 mt-2 text-brod lg:text-brod-lg">{visat.gorInteDetHar}</p>
            </>
          )}
        </section>
      )
    }

    <section>
      <Pennstreck id="watt-till-kwh">Räkna om watt till kilowattimmar själv</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        Effekten står i watt på typskylten, den lilla metallbrickan på maskinens baksida. Dela talet med 1 000, så
        har du kilowatt. Multiplicera kilowatten med antalet timmar maskinen faktiskt går, så har du kilowattimmar, och
        det är kilowattimmen elbolaget tar betalt för. En maskin på 1 000 W som går en timme drar alltså en
        kilowattimme. Sedan är det bara priset kvar. Multiplicera kilowattimmarna med vad du betalar per kilowattimme,
        allt inräknat, så har du kronorna.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Här är det lätt att räkna fel, för märkeffekten är inte förbrukningen. Den säger vad maskinen drar när
        allt går för fullt, och nästan ingen maskin gör det hela tiden. Kompressorn i en avfuktare startar när
        fuktgivaren säger till och stannar när luften är torr nog, och en värmefläkt på termostat gör samma sak med
        värmen. Verktyget här ovanför antar att märkeffekten dras under hela gångtiden du fyller i, så för en
        maskin som pendlar får du en övre gräns. Vill du veta vad den verkligen drar sätter du en energimätare
        mellan maskinen och vägguttaget och läser av efter en vecka. Det är så jag gör själv.
      </p>

      <Pennstreck id="avfuktaren" niva={3}>Avfuktaren i källaren</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        En avfuktare på 320 W som styrs av sin fuktgivare går kanske åtta timmar per dygn. Det blir 2,56 kWh per
        dygn och 76,8 kWh på en månad, och med elpriset i verktyget kostar månaden 184 kr. Det här är den vanligaste
        maskinen folk räknar på, och den enda där priset per liter vatten säger något. Dela kilowattimmarna per
        dygn med antalet liter maskinen tar upp, så har du det.
      </p>

      <Pennstreck id="varmeflakten" niva={3}>Värmefläkten i garaget</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        En värmefläkt på 2 000 W med termostat, i ett garage som ska hållas frostfritt i november. Säg att den går
        fem timmar per dygn. Då drar den 10 kWh per dygn och 300 kWh på en månad, vilket kostar 720 kr. Fläkten
        blir dyrare än avfuktaren fast den står på kortare tid, och det beror på att effekten är mer än
        dubbelt så hög.
      </p>

      <Pennstreck id="byggflakten" niva={3}>Byggfläkten dygnet runt</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        En byggfläkt på 3 000 W som ska torka ett golv går utan uppehåll, och då drar den 72 kWh per dygn. En vecka
        blir 504 kWh och 1 210 kr. Det är i den storleksordningen en uttorkning efter en vattenskada hamnar, så
        räkna på den innan du hyr fläkten.
      </p>
    </section>

    <section>
      <Pennstreck id="sa-raknar-vi">Så räknar jag</Pennstreck>
      {
        varumarke && illustration && (
          <Illustration
            namn="rakna/elkostnad"
            alt="En maskin med sladden dragen till ett vägguttag, och en elmätare ovanför som räknar gångtiden."
            bildtext="Skissen visar det verktyget räknar på: en maskin på 300 watt, sladden till uttaget och elmätaren som räknar vad gångtiden kostar."
          />
        )
      }
      <p class="m-0 text-brod lg:text-brod-lg">
        Elpriset jag räknar med är SCB:s senaste genomsnitt för hushåll, {ELPRIS_KALLA.period}. Det står i tabellen
        här nedanför med länk, och du byter det mot fakturans pris i formuläret när du vill. Själva räkningen är
        den enklaste på hela sajten.
      </p>
      <ol class="m-0 mt-4 pl-6 list-decimal text-brod lg:text-brod-lg">
        <li class="mb-2">Jag delar effekten i watt med 1 000 och får kilowatt.</li>
        <li class="mb-2">Kilowatten multiplicerar jag med gångtiden per dygn och får kilowattimmar per dygn.</li>
        <li class="mb-2">Kilowattimmarna per dygn multiplicerar jag med antalet dagar och får periodens förbrukning.</li>
        <li class="mb-2">Förbrukningen multiplicerar jag med elpriset och får kronor.</li>
        <li class="mb-2">Året är samma räkning med 365 dagar, vid den gångtid du fyllt i.</li>
        <li>
          Har du fyllt i liter vatten per dygn delar jag kilowattimmarna per dygn med det talet, så får du energin
          och kostnaden per liter.
        </li>
      </ol>

      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">Vad siffrorna vilar på</h3>
      <Tabellyta kolumner={3} class="mt-4">
        <table class="w-full border-collapse text-liten tabular-nums">
          <caption class="sr-only">Antaganden och källor i elkostnadskalkylatorn</caption>
          <thead>
            <tr class="border-b border-linje text-left">
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Vad</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Jag räknar med</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Källa eller antagande</th>
            </tr>
          </thead>
          <tbody>
            {
              antaganden.map((a) => (
                <tr>
                  <th scope="row" class:list={[CELL_KLASS, 'text-left font-normal']}>
                    {a.storhet}
                  </th>
                  <td class={CELL_KLASS}>{a.varde}</td>
                  <td class={CELL_KLASS}>
                    {a.grund}.{' '}
                    {a.url ? (
                      <a href={a.url} rel="nofollow" class={LANK_KLASS}>
                        {a.stod}
                      </a>
                    ) : (
                      a.stod
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </Tabellyta>

      <p class="m-0 mt-6 text-brod lg:text-brod-lg">
        Gångtiden är det tal som styr svaret mest, och det är också det enda du måste gissa. En timme för mycket per
        dygn flyttar årssiffran med flera hundralappar. Vill du slippa gissa sätter du en energimätare i uttaget en
        vecka och skriver in vad den visar, så blir den här räknaren onödig för just din maskin. Var talen kommer
        ifrån står på sidan <a href="/om/sa-testar-vi/" class={LANK_KLASS}>Så testar jag</a>.
      </p>
    </section>

    <section>
      <Pennstreck id="las-vidare">Läs vidare</Pennstreck>
      <ul class="m-0 p-0 list-none">
        <li class="border-t border-linje">
          <a href="/fukt/avfuktare-kallare/" class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
            Så väljer du avfuktare till källaren, med elkostnaden för fyra maskiner
          </a>
        </li>
        <li class="border-t border-linje">
          <a href="/fukt/sorptionsavfuktare/" class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
            Vilken avfuktare som drar minst per liter vatten, sorption eller kondens
          </a>
        </li>
        <li class="border-t border-linje">
          <a href="/luftavfuktare/" class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
            Alla luftavfuktare jag granskat, med effekt ur databladen
          </a>
        </li>
      </ul>
    </section>

    <Faq fragor={FRAGOR} />
  </div>
</Bas>
