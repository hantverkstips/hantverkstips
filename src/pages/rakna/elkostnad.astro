---
/**
 * Elkostnadskalkylatorn. Formuläret skickas som GET till samma sida och
 * beräkningen sker på servern, så sidan fungerar utan ett enda byte klient-JS.
 * Kostnaden är en serverfunktion per anrop, och den hålls nere med CDN-cache.
 * Se docs/SPEC-SIDMALLAR.md avsnitt 4.7.
 *
 * Formeln och alla antaganden ligger i src/lib/kalkyl/elkostnad.ts. Sidan räknar
 * ingenting själv, den visar bara resultatet och redovisar källorna.
 *
 * Query-parametern produkt fyller fälten ur produktens specs. Uppslaget sker
 * här och inte i formeln: src/lib/kalkyl/ är rena moduler utan databas, och
 * produktForval() tar emot specs som ett vanligt objekt.
 *
 * Räkningen pekar inte ut någon produkt, den räknar på den maskin läsaren redan
 * har eller tittar på. Därför har sidan varken produktkort eller reklamband.
 */
export const prerender = false;

import { ELPRIS_KALLA, ELPRIS_KR_PER_KWH } from '../../lib/antaganden';
import { antalOrd, formateraPris, formateraTal } from '../../lib/format';
import { artikelUrl, kategoriUrl, publicerade } from '../../lib/innehall';
import { tillKortArtikel, tillKortKategori, type KortData } from '../../lib/kort';
import {
  FORVAL_PER_PLATS,
  gorInteText,
  PLATSER,
  platsFranQuery,
  produktForval,
  produktSlugFranQuery,
  raknaElkostnad,
  STANDARD,
  standardMedForval,
  tolkaQuery,
  tolkaTvatt,
  raknaTvatt,
  TVATT_KWH_PER_KG,
  TVATT_METODER,
  TVATT_STANDARD,
  TVATT_TEST,
  typFranQuery,
  type ElkostnadIndata,
  type ElkostnadResultat,
  type Plats,
  type TvattIndata,
  type TvattMetod,
  type TvattResultat,
} from '../../lib/kalkyl/elkostnad';
import { CELL_KLASS, LANK_KLASS } from '../../lib/kalkyl/stil';
import { hamtaProdukt, produktNamn } from '../../lib/produkter';
import { verktygsillustration } from '../../lib/verktygsbild';
import ElkostnadForm from '../../components/kalkyl/ElkostnadForm.astro';
import Artikelrutnat from '../../components/ui/Artikelrutnat.astro';
import Faq from '../../components/ui/Faq.astro';
import Pennstreck from '../../components/ui/Pennstreck.astro';
import Svarstal from '../../components/ui/Svarstal.astro';
import Tabellyta from '../../components/ui/Tabellyta.astro';
import Illustration from '../../components/ui/Illustration.astro';
import Raknarsida from '../../components/vyer/Raknarsida.astro';

Astro.locals.sidtyp = 'verktyg';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

const q = Astro.url.searchParams;

/* Produkten i adressen, när läsaren kom hit från ett produktkort. */
const produktSlug = produktSlugFranQuery(q);
const produkt = produktSlug ? await hamtaProdukt(produktSlug) : null;
const forval = produktForval(produkt?.specs ?? null);
/* Platsens förval, ?plats=kallare: effekt och gångtid ur FORVAL_PER_PLATS. */
const plats = platsFranQuery(q);
const standard = standardMedForval(forval, plats);

const { indata } = tolkaQuery(q, forval);
/* golvvarme från golvvärmesidans förval: samma räkning, golvvärmens texter. */
const typ = typFranQuery(q);
const resultat = raknaElkostnad(indata);

const fel = resultat.status === 'ogiltig' ? resultat.fel : {};
// Vid ogiltig indata visas standardvärdenas resultat, med en rad som säger det.
const visat: ElkostnadResultat = resultat.status === 'ogiltig' ? raknaElkostnad(standard) : resultat;
const visatIndata: ElkostnadIndata = resultat.status === 'ogiltig' ? standard : indata;
/* Vid golvvärme aldrig avfuktarens text om hygrostaten (gorInteText). */
const gorInte = visat.status === 'ok' ? gorInteText(visat, typ) : null;

/*
 * Tvättläget, ?typ=tvatt (docs/briefer/spec-elkostnad-forval-2026-09-30.md
 * avsnitt 8.3): egen räkning per kg tvätt i stället för maskinens. Ogiltig
 * indata ger standardvarningen och TVATT_STANDARD, som maskinen.
 */
const tvattLage = typ === 'tvatt';
const { indata: tvattIndata } = tolkaTvatt(q);
const tvattResultat = raknaTvatt(tvattIndata);
const tvattFel = tvattResultat.status === 'ogiltig' ? tvattResultat.fel : {};
const tvattVisat: TvattResultat = tvattResultat.status === 'ogiltig' ? raknaTvatt(TVATT_STANDARD) : tvattResultat;
const tvattVisatIndata: TvattIndata = tvattResultat.status === 'ogiltig' ? TVATT_STANDARD : tvattIndata;

const komma = (n: number) => String(n).replace('.', ',');
/** Tal i löptext: heltal utan decimal, annars en. "19 liter", "7,4 liter". */
const talText = (n: number) => formateraTal(n, Number.isInteger(n) ? 0 : 1);
/**
 * Energin och priset per liter. En decimal räcker (beslut i granskningen
 * omgång 3: 1,7 kWh och 4,1 kr), men under en krona säger en decimal inget,
 * och då skrivs två ut.
 */
const perLiter = (n: number) => formateraTal(n, n >= 1 ? 1 : 2);

/**
 * Fältens värden kommer från query-strängen som den skrevs, inte från de tolkade
 * talen: "trehundra" eller "" blir NaN i tolkaQuery, och NaN i ett fält som
 * läsaren ska rätta är obrukbart.
 */
function faltVarde(nyckel: string, standardVarde: number): string {
  const ra = q.get(nyckel);
  if (ra !== null) return ra;
  return komma(standardVarde);
}

/* Dagarna kan stå i fältet dagareget när radioknappen "Eget antal" är vald. */
const raDagar = q.get('dagar');
const dagarVarde =
  raDagar === null ? komma(standard.dagar) : raDagar.trim() === 'eget' ? (q.get('dagareget') ?? '') : raDagar;

/* Literfältet förifylls aldrig ur produkten. Skälet står vid produktForval. */
const literVarde = q.get('liter') ?? '';

const varden = {
  effekt: faltVarde('effekt', standard.effektW),
  timmar: faltVarde('timmar', standard.timmarPerDygn),
  dagar: dagarVarde,
  // Elpriset skrivs med två decimaler i fältet, som på fakturan och i tabellerna.
  elpris: q.get('elpris') ?? formateraTal(standard.elprisKrPerKwh, 2),
  liter: literVarde,
};

/* Tvättlägets fält, som de skrevs i adressen, av samma skäl som faltVarde. */
const tvattFalt = {
  kg: q.get('kg') ?? komma(TVATT_STANDARD.kgPerTorkning),
  torkningar: q.get('torkningar') ?? komma(TVATT_STANDARD.torkningarPerVecka),
  elpris: q.get('elpris') ?? formateraTal(TVATT_STANDARD.elprisKrPerKwh, 2),
};

/** Raden över formuläret när adressen pekar ut en produkt. */
let produktRad: string | null = null;
if (produktSlug !== null) {
  if (produkt && forval.effektW !== null) {
    const namn = produktNamn(produkt);
    produktRad = `Jag räknar på ${namn}, som drar ${talText(forval.effektW)} W enligt tillverkaren. Har du egna tal, skriv in dem i stället.`;
  } else {
    produktRad =
      'Maskinen i länken finns inte i min produktdatabas, eller så saknar den uppgift om effekt. Fälten står därför på standardvärdena.';
  }
}

/** E1: raden över formuläret när adressen har plats men ingen produkt. Texten är hantverkarens. */
function platsRad(maskin: string, effektW: number, villkorTemp: number, villkorRf: number): string {
  return `Jag räknar på ${maskin}, som drar ${talText(effektW)} W när luften håller ${talText(villkorTemp)} grader och ${talText(villkorRf)} procent luftfuktighet. Har du egna tal, skriv in dem i stället.`;
}
if (plats !== null && produktSlug === null) {
  const p = FORVAL_PER_PLATS[plats];
  produktRad = platsRad(p.maskin, p.effektW, p.villkor.tempC, p.villkor.rf);
}
/* Tvättläget räknar inte på någon maskin, så raden står inte där. */
if (tvattLage) produktRad = null;

/**
 * Delbar länk. Hela tillståndet ligger redan i query-strängen, så adressen är
 * uträkningen. Den byggs av de tolkade värdena, inte av strängen läsaren skrev,
 * och dagarna skrivs alltid som ett tal, aldrig som "eget".
 */
const delaQuery = new URLSearchParams({
  /* Platsen först när den finns, före produkten. effekt och timmar står ändå i adressen och vinner. */
  ...(plats !== null ? { plats } : {}),
  /* Produkten därefter, bara när den finns och har effekt; effekt i adressen vinner ändå. */
  ...(produktSlug !== null && produkt && forval.effektW !== null ? { produkt: produktSlug } : {}),
  effekt: komma(visatIndata.effektW),
  timmar: komma(visatIndata.timmarPerDygn),
  dagar: komma(visatIndata.dagar),
  elpris: komma(visatIndata.elprisKrPerKwh),
});
if (visatIndata.literPerDygn !== null) delaQuery.set('liter', komma(visatIndata.literPerDygn));
if (typ === 'golvvarme') delaQuery.set('typ', typ);
/* I tvättläget är länken typ=tvatt&kg=…&torkningar=…&elpris=…, av de tolkade värdena. */
const tvattDelaQuery = new URLSearchParams({
  typ: 'tvatt',
  kg: komma(tvattVisatIndata.kgPerTorkning),
  torkningar: komma(tvattVisatIndata.torkningarPerVecka),
  elpris: komma(tvattVisatIndata.elprisKrPerKwh),
});
const delaLank = new URL(
  `/rakna/elkostnad/?${(tvattLage ? tvattDelaQuery : delaQuery).toString()}`,
  Astro.site ?? Astro.url,
).toString();

/*
 * Tvättlägets tal och texter. Talen kommer ur raknaTvatt; texterna T6 till T18
 * är hantverkarens (docs/briefer/texter-elkostnad-forval-2026-09-30.md avsnitt T)
 * och får talen som parametrar.
 */
const tvattTal =
  tvattVisat.status === 'ok'
    ? {
        kg: talText(tvattVisatIndata.kgPerTorkning),
        torkningar: talText(tvattVisatIndata.torkningarPerVecka),
        kgPerAr: formateraTal(tvattVisat.kgPerAr, 0),
        elpris: formateraTal(tvattVisatIndata.elprisKrPerKwh, 2),
        krAvfuktare: formateraPris(tvattVisat.metoder.avfuktare.krPerAr),
        /* Samma tal utan "kr", för det stora talet där enheten står bredvid. */
        krAvfuktareTal: formateraTal(Math.round(tvattVisat.metoder.avfuktare.krPerAr)),
        krVarmepump: formateraPris(tvattVisat.metoder.varmepumpstumlare.krPerAr),
        krKondens: formateraPris(tvattVisat.metoder.kondenstumlare.krPerAr),
      }
    : null;
/** Tumlarna under det stora talet, en rad per metod utom avfuktaren. */
const TUMLARE: TvattMetod[] = ['varmepumpstumlare', 'kondenstumlare'];

/** T6: beskedet. */
function tvattRubrik(_krAvfuktare: string, _krVarmepump: string): string {
  return 'Ska du köpa nytt för tvättens skull är en tumlare med värmepump billigast att driva.';
}
/** T7: raden under beskedet. */
function tvattRad(kgPerAr: string, _krKondens: string): string {
  return `Står det redan en avfuktare i tvättstugan kan du använda den, men stäng av den när tvätten är torr. Du torkar ${kgPerAr} kg tvätt om året.`;
}
/** T8: etiketten ovanför det stora talet, avfuktarens kr per år. */
const TVATT_TAL_ETIKETT = 'Avfuktaren, kr per år';
/** T9: metodernas namn. */
const TVATT_METODNAMN: Record<TvattMetod, string> = {
  avfuktare: 'Luftavfuktare',
  varmepumpstumlare: 'Torktumlare med värmepump',
  kondenstumlare: 'Kondenstumlare utan värmepump',
};
/** T10: kortsvaret i Faktarutan. */
function tvattKortsvar(
  kg: string,
  torkningar: string,
  krAvfuktare: string,
  krVarmepump: string,
  krKondens: string,
): string {
  const ganger = torkningar === '1' ? 'en gång' : `${torkningar} gånger`;
  return `Torkar du ${kg} kg tvätt ${ganger} i veckan med en luftavfuktare kostar det ${krAvfuktare} om året. En torktumlare med värmepump klarar samma tvätt för ${krVarmepump}, och en kondenstumlare utan värmepump för ${krKondens}. Talen kommer från Energimyndighetens test, där avfuktaren stängdes av när tvätten var torr.`;
}
/** T11: hur talet räknas, kg i veckan gånger testets kWh per kg. */
function TVATT_DARFOR_RAKNING(kgPerVecka: string, kwhPerKgAvfuktare: string, kgPerAr: string): string {
  return `Du torkar ${kgPerVecka.replace(/,0$/, '')} kg tvätt i veckan, och det blir ${kgPerAr} kg på ett år. En luftavfuktare drar ${kwhPerKgAvfuktare} kWh för varje kilo, och kilona gånger det talet gånger ditt elpris ger kronorna. Tumlarna räknas på samma sätt med sina egna tal.`;
}
/** T12: testet anger inte restfukten. */
const TVATT_DARFOR_RESTFUKT =
  'Testet säger inte hur blöt tvätten var när den hängdes upp, och inte heller om tumlarna fick lika blöt tvätt som avfuktarna. Talen jämför metoderna i testet med varandra, och din egen tvätt kan hamna både över och under talen.';
/** T13: källraden under T11 och T12, med datumet 2017-12-11. */
const TVATT_KALLRAD = 'Energimyndighetens test av luftavfuktare för tvätt, 11 december 2017';
/** T14: "Gör inte det här" i tvättläget. */
const TVATT_GOR_INTE =
  'Avfuktaren ska stängas av när tvätten är torr. Står den på ett helt dygn drar den två till tre gånger så mycket el, och då blir den dyrare än båda tumlarna. Ställ in en timer eller stäng av den för hand när du tar in tvätten.';
/** T15: tvättabellens rubrik. */
const TVATTABELL_RUBRIK = 'Torka tvätten med avfuktare eller torktumlare';
/** T16: tvättabellens ingress. */
const TVATTABELL_INGRESS =
  'Energimyndigheten torkade tvätt med de tre metoderna och mätte hur mycket el det gick åt. Tumlaren med värmepump drog minst och luftavfuktaren mest.';
/** T17: källraden under tvättabellen, med datum och adress. */
function tvattabellKallrad(datum: string): string {
  return `Energimyndighetens test av luftavfuktare för tvätt, uppdaterat ${datum}. Kolumnen ${TVATTABELL_KOLUMN_PER_TORKNING} är testets tal per kilo gånger ${TVATT_TEST.kgPerTorkning} kg. Tumlarna i testet var märkta A+ och A++ på den gamla energiskalan, som inte har använts för nya tumlare sedan juli 2025.`;
}
/** T18: länken till tvättläget under eltabellen i maskinläget. */
const TVATT_LANK = 'Jämför avfuktare och torktumlare för tvätten';
/** T19: tvättabellens hörncell, kolumnrubriker och caption. */
const TVATTABELL_HORN = 'Metod';
const TVATTABELL_KOLUMN_PER_KG = 'kWh per kg';
const TVATTABELL_KOLUMN_PER_TORKNING = `kWh per ${TVATT_TEST.kgPerTorkning} kg`;
const TVATTABELL_CAPTION =
  'El per kilo tvätt och per torkning för en luftavfuktare och två sorters torktumlare, ur Energimyndighetens test';

/** Tvättabellen: kWh per kg ur konstanterna och kWh per torkning om testets 7 kg. */
const tvattabell = TVATT_METODER.map((m) => ({
  metod: m,
  perKg: formateraTal(TVATT_KWH_PER_KG[m], 2),
  perTorkning: formateraTal(TVATT_KWH_PER_KG[m] * TVATT_TEST.kgPerTorkning, 2),
}));

/** Tal ur resultatet, färdigformaterade, så att markupen nedan blir läsbar. */
const tal =
  visat.status === 'ok'
    ? {
        kwhPerDygn: formateraTal(visat.kwhPerDygn, 2),
        kwhPerPeriod: formateraTal(visat.kwhPerPeriod, 1),
        krPerPeriod: formateraPris(visat.krPerPeriod),
        /* Samma tal utan "kr", för andra raden i svarsytan där enheten står bredvid. */
        krPerPeriodTal: formateraTal(Math.round(visat.krPerPeriod)),
        krPerDygn: formateraTal(visat.krPerDygn, 2),
        kwhPerAr: formateraTal(visat.kwhPerAr, 0),
        krPerAr: formateraPris(visat.krPerAr),
        kwhPerLiter: visat.kwhPerLiter === null ? null : perLiter(visat.kwhPerLiter),
        krPerLiter: visat.krPerLiter === null ? null : perLiter(visat.krPerLiter),
        effekt: talText(visatIndata.effektW),
        /* Med ordet inräknat, i rätt numerus: "1 timme", "8 timmar" (spec-designlyft-c avsnitt 12). */
        timmar: antalOrd(visatIndata.timmarPerDygn, 'timme', 'timmar'),
        dagar: antalOrd(visatIndata.dagar, 'dag', 'dagar'),
        elpris: formateraTal(visatIndata.elprisKrPerKwh, 2),
        liter: visatIndata.literPerDygn === null ? null : talText(visatIndata.literPerDygn),
      }
    : null;

/* E8: högst 44 tecken med "el" och "avfuktare" (SEO:s checklista raknare-elkostnad-forval.md). */
const titel = 'Vad drar avfuktaren i el per år?';

/*
 * Tabellen "elen per avfuktare": en rad per plats i FORVAL_PER_PLATS, räknad
 * med raknaElkostnad på platsens gångtid, 365 dagar och SCB:s elpris.
 * Texterna E2 till E7 är hantverkarens (docs/briefer/texter-elkostnad-forval-2026-09-30.md).
 */
const ELTABELL_RUBRIK = 'Hur mycket el en avfuktare drar på ett år';
/* E3 med länken till /fukt/sorptionsavfuktare/ och ett eget ankare. */
const ELTABELL_INGRESS = {
  fore: 'Effekten gäller i det klimat tillverkaren provade maskinen i, och klimatet står i kolumnen Provklimat. I en kall källare ger samma watt färre liter vatten, och under tio grader är',
  ankare: 'en sorptionsavfuktare',
  efter: ' rätt maskin.',
};
const PLATS_KORT: Record<Plats, string> = { kallare: 'Källare', krypgrund: 'Krypgrund', vind: 'Kallvind', garage: 'Garage' };
const ELTABELL_HORN = 'Plats och maskin';
const ELTABELL_CAPTION = 'Avfuktarens effekt, provklimat, el per dygn och kostnad per år för varje plats';
/** E7: källorna till effekterna, 8 timmar per dygn och elpriset med perioden. */
function eltabellKallrad(period: string, elpris: string): string {
  return `Effekterna och provklimaten kommer ur tillverkarnas datablad och bruksanvisningar, för Wood's maskiner ur Wood's egen bruksanvisning. Att maskinen går 8 timmar om dygnet är mitt antagande. Elpriset ${elpris} kr per kWh är SCB:s genomsnitt för hushåll, ${period}.`;
}
/** Talen med högst två decimaler och utan nollor på slutet: 2,56, 2,8, 2,2. */
const kortTal = (n: number): string => String(Math.round(n * 100) / 100).replace('.', ',');
const eltabell = PLATSER.map((p) => {
  const f = FORVAL_PER_PLATS[p];
  const r = raknaElkostnad({
    ...STANDARD,
    effektW: f.effektW,
    timmarPerDygn: f.timmarPerDygn,
    dagar: 365,
    elprisKrPerKwh: ELPRIS_KR_PER_KWH,
  });
  return {
    plats: p,
    f,
    kwhPerDygn: r.status === 'ok' ? kortTal(r.kwhPerDygn) : '',
    krPerAr: r.status === 'ok' ? formateraTal(Math.round(r.krPerAr)) : '',
  };
});
/** Klasserna en gång på <table>, som daggpunktens tabell, talen högerställda. */
const ELTABELL_KLASS =
  'w-full border-collapse text-liten tabular-nums [&_th]:px-1 [&_td]:px-1 [&_th]:py-2 [&_td]:py-2 [&_th]:text-left [&_th]:align-top [&_td]:align-top [&_thead_th+th]:text-right [&_td]:text-right [&_tbody_th]:[font-weight:inherit] [&_tr]:border-b [&_tr]:border-linje [&_th]:text-blyerts-2 [&_td]:text-blyerts [&_thead_th]:text-etikett [&_thead_th]:uppercase';

/** Antagandena i tabellen under "Så räknar vi". Samma tal som konstanterna i kalkylen. */
const antaganden: { storhet: string; varde: string; grund: 'Källa' | 'Antagande'; stod: string; url?: string }[] = [
  {
    storhet: 'Elpriset, om du inte skriver ett eget',
    varde: `${formateraTal(standard.elprisKrPerKwh, 2)} kr per kWh`,
    grund: 'Källa',
    stod: `SCB, genomsnitt för ${ELPRIS_KALLA.omfattar}, ${ELPRIS_KALLA.period}`,
    url: ELPRIS_KALLA.url,
  },
  {
    storhet: 'Vad maskinen drar medan den går',
    varde: 'märkeffekten, hela tiden',
    grund: 'Antagande',
    stod: 'Jag räknar med att maskinen drar sin märkeffekt varje minut den är igång. En kompressor pendlar i verkligheten, så talet är en övre gräns',
  },
  {
    storhet: 'Gångtiden per dygn',
    varde: `${antalOrd(standard.timmarPerDygn, 'timme', 'timmar')} som standard`,
    grund: 'Antagande',
    stod: 'Min gissning för en avfuktare på hygrostat i en källare som inte är genomblöt. Ingen har mätt drifttiden, och det är det tal som påverkar svaret mest',
  },
  {
    storhet: 'Året',
    varde: '365 dagar',
    grund: 'Antagande',
    stod: 'Jag bortser från skottår. Skillnaden är under tre promille och drunknar i osäkerheten i gångtiden',
  },
];

/**
 * Frågorna sist på sidan. Svaren använder samma tal som räkneexemplen ovanför,
 * och elpriset kommer ur ELPRIS_KR_PER_KWH som hela sajten räknar med.
 */
const FRAGOR = [
  {
    fraga: 'Hur räknar jag om watt till kWh?',
    svar: 'Dela effekten i watt med 1 000, så har du kilowatt. Multiplicera sedan kilowatten med antalet timmar maskinen faktiskt går, så har du kilowattimmar. En maskin på 1 000 W som går en timme drar alltså en kilowattimme. Det är den enheten elbolaget tar betalt för, så när du har kilowattimmarna är det bara att multiplicera med priset.',
  },
  {
    fraga: 'Drar en avfuktare mycket el?',
    svar: 'En vanlig kondensavfuktare till en källare ligger på 320 W. Styrs den av en hygrometer som stänger av den när luften är torr nog går den kanske åtta timmar per dygn, och då landar månaden på 184 kr. En värmefläkt i garaget kostar mer än så trots kortare gångtid, eftersom effekten är dubbelt så hög. Det som avgör räkningen är alltid effekten gånger timmarna, inte hur stor maskinen ser ut.',
    lank: { text: 'Se elen för fyra avfuktare i guiden om avfuktare till källaren.', href: '/fukt/avfuktare-kallare/' },
  },
  {
    fraga: 'Vad kostar en kWh 2026?',
    svar: `Om du inte skriver något annat räknar verktyget med ${String(ELPRIS_KR_PER_KWH).replace('.', ',')} kr per kWh. Talet är statistikmyndigheten SCB:s genomsnitt för hushåll, ${ELPRIS_KALLA.period}, och det omfattar elhandel, nätavgift, energiskatt och moms. Ditt eget pris står på fakturan och kan ligga en bra bit från genomsnittet. Byt talet i fältet, så räknas allt om.`,
  },
];

/** Slug, namn och beskrivning på ett ställe: brödsmulan, og:image och WebApplication läser samma. */
const SLUG = 'elkostnad';
const VERKTYGSNAMN = 'Elkostnadskalkylator';
/* E9: 120 till 155 tecken (SEO:s checklista raknare-elkostnad-forval.md). */
const BESKRIVNING =
  'Räkna ut vad avfuktaren drar i el och kostar per år med ditt eget elpris. Det finns färdiga tal för källare, krypgrund, vind och garage, och för tvätt.';
/** Skissen står i kortet Så räknar jag. Huvudet har ingen bild sedan fas C (DESIGN.md 5.8). */
const illustration = verktygsillustration(SLUG);

/*
 * Svarsytan, fas C (spec-designlyft-c-2026-10-02 avsnitt 10). Ny text är
 * hantverkarens. Klartexten i maskinläget har platshållarna {kwh} (kWh för
 * perioden), {kr} (kronor för perioden), {dagar}, {effekt} (W), {timmar}
 * (per dygn) och {elpris} (kr per kWh). I tvättläget är klartexten T10, som
 * redan har talen, villkoret och källan. {timmar} och {dagar} fylls i med
 * ordet inräknat ("1 timme", "8 timmar", "1 dag"), så meningen har inget ord
 * efter dem (spec-designlyft-c avsnitt 12).
 */
const KLARTEXT =
  'En maskin på {effekt} W som går {timmar} om dygnet drar {kwh} kWh på {dagar}, och med elpriset {elpris} kr per kWh kostar det {kr}.'; // elkostnad.klartext
/* Utan eget elpris i adressen räknar sidan med SCB:s pris, och då står källan i meningen (SOKORDSANALYS 13). */
const KLARTEXT_SCB = `En maskin på {effekt} W som går {timmar} om dygnet drar {kwh} kWh på {dagar}. Med hushållens snittpris för ${ELPRIS_KALLA.period} enligt SCB, {elpris} kr per kWh, kostar det {kr}.`;
const klartext = tvattLage
  ? tvattTal
    ? tvattKortsvar(tvattTal.kg, tvattTal.torkningar, tvattTal.krAvfuktare, tvattTal.krVarmepump, tvattTal.krKondens)
    : ''
  : tal
    ? (q.has('elpris') ? KLARTEXT : KLARTEXT_SCB).replace('{kwh}', tal.kwhPerPeriod)
        .replace('{kr}', tal.krPerPeriod)
        .replace('{dagar}', tal.dagar)
        .replace('{effekt}', tal.effekt)
        .replace('{timmar}', tal.timmar)
        .replace('{elpris}', tal.elpris)
    : '';

/**
 * Läs vidare som kort: sidorna den förra listan pekade på, i samma ordning.
 * Kategorisidan får kategorikortet, artiklarna artikelkortet.
 */
const LAS_VIDARE = ['/fukt/avfuktare-kallare/', '/fukt/sorptionsavfuktare/', '/luftavfuktare/'];
const artiklar = [...(await publicerade('guider')), ...(await publicerade('kunskap'))];
const kategorier = await publicerade('kategorier');
const lasVidare: KortData[] = [];
for (const href of LAS_VIDARE) {
  const k = kategorier.find((e) => kategoriUrl(e.id) === href);
  if (k) {
    lasVidare.push(await tillKortKategori(k));
    continue;
  }
  const e = artiklar.find((a) => artikelUrl(a) === href);
  if (!e) continue;
  const { niva: _niva, ...kort } = tillKortArtikel(e);
  lasVidare.push(kort);
}
---

<Raknarsida
  slug={SLUG}
  namn={VERKTYGSNAMN}
  titel={titel}
  beskrivning={BESKRIVNING}
  rubrik="Räkna ut vad avfuktaren och andra maskiner drar i el"
  delaUrl={delaLank}
>
  <p slot="ingress">
    Det här är för maskinen som står och går, som avfuktaren i källaren, värmefläkten i garaget eller frysen
    i förrådet. Fyll i effekten i watt, hur många timmar om dygnet den går och vad du betalar för elen, så
    får du kilowattimmar och kronor per månad och år. Svaret är en övre gräns, eftersom de flesta maskiner
    drar mindre än full effekt en del av tiden.
  </p>

  <ElkostnadForm
    slot="formular"
    indata={indata}
    varden={varden}
    fel={fel}
    produktSlug={tvattLage ? null : produktSlug}
    plats={tvattLage ? null : plats}
    produktRad={produktRad}
    typ={typ}
    tvattFalt={tvattFalt}
    tvattFel={tvattFel}
  />

  {
    visat.status === 'ok' && tal && (
      <Fragment slot="svar">
        {(tvattLage ? tvattResultat.status : resultat.status) === 'ogiltig' && (
          <p class="text-liten text-varning">
            Ett av fälten gick inte att läsa, så jag visar standardvärdena tills du rättat det.
          </p>
        )}
        {tvattLage && tvattTal ? (
          <>
            <Svarstal tal={tvattTal.krAvfuktareTal} enhet="kr" vad={TVATT_TAL_ETIKETT} />
            <div class="text-brod">
              <p class="font-bold">{tvattRubrik(tvattTal.krAvfuktare, tvattTal.krVarmepump)}</p>
              <p>{tvattRad(tvattTal.kgPerAr, tvattTal.krKondens)}</p>
            </div>
            {/* En rad per tumlare: namnet till vänster, kronorna till höger. */}
            <ul class="m-0 list-none p-0 text-brod">
              {TUMLARE.map((m) => (
                <li class="flex justify-between gap-4 border-b border-linje py-1">
                  <span>{TVATT_METODNAMN[m]}</span>
                  <span class="tabular-nums">
                    {m === 'varmepumpstumlare' ? tvattTal.krVarmepump : tvattTal.krKondens}
                  </span>
                </li>
              ))}
            </ul>
          </>
        ) : (
          <>
            <Svarstal tal={tal.kwhPerPeriod} enhet="kWh" vad={`På ${tal.dagar}`} />
            {/* Kronorna som andra rad, som förut, på samma baslinje som enheten. */}
            <p class="svarstal">
              <span class="font-serif text-h1">{tal.krPerPeriodTal}</span>
              <span>
                <span class="font-serif text-h2">kr</span>
                <span class="text-liten text-blyerts-2">för samma dagar</span>
              </span>
            </p>
            <div class="text-brod">
              <p class="font-bold">
                Räkna med {tal.krPerPeriod} för {tal.dagar}, och {tal.krPerAr} om året.
              </p>
              <p>Det är en övre gräns, för jag räknar med att maskinen drar full effekt varje minut den går.</p>
            </div>
          </>
        )}
        <p class="text-liten text-blyerts">{klartext}</p>
      </Fragment>
    )
  }

  {
    tvattLage && tvattTal && (
      <Fragment slot="darfor">
        <Pennstreck id="darfor-blev-svaret-sa" utanLuft>
          Därför blev svaret så
        </Pennstreck>
        <div class="darfor">
          <div>
            <p>
              {TVATT_DARFOR_RAKNING(
                formateraTal(tvattVisatIndata.kgPerTorkning * tvattVisatIndata.torkningarPerVecka, 1),
                formateraTal(TVATT_KWH_PER_KG.avfuktare, 2),
                tvattTal.kgPerAr,
              )}
            </p>
            <p>
              <a href={TVATT_TEST.url} rel="nofollow" class={LANK_KLASS}>
                {TVATT_KALLRAD}
              </a>
            </p>
          </div>
          <div>
            <p>{TVATT_DARFOR_RESTFUKT}</p>
            <p>
              <a href={TVATT_TEST.url} rel="nofollow" class={LANK_KLASS}>
                {TVATT_KALLRAD}
              </a>
            </p>
          </div>
        </div>
      </Fragment>
    )
  }

  {
    !tvattLage && visat.status === 'ok' && tal && (
      <Fragment slot="darfor">
        <Pennstreck id="darfor-blev-svaret-sa" utanLuft>
          Därför blev svaret så
        </Pennstreck>
        <div class="darfor">
          {/* Raden under talen i den förra resultatspalten. */}
          <div>
            <p>
              Räknat på {tal.effekt} W i {tal.timmar} per dygn och {tal.elpris} kr per kilowattimme.
            </p>
          </div>
          <div>
            <p>
              {tal.effekt} W i {tal.timmar} ger {tal.kwhPerDygn} kWh per dygn, och med ditt elpris kostar
              det {tal.krPerDygn} kr per dygn. Låter du maskinen gå lika mycket hela året blir det {tal.kwhPerAr}{' '}
              kWh och {tal.krPerAr}.
            </p>
            <p>
              Watt gånger timmar delat med tusen. Elpriset är SCB:s genomsnitt, {ELPRIS_KALLA.period}, om du inte
              skrev in ett eget.
            </p>
          </div>
          {tal.krPerLiter && tal.kwhPerLiter && (
            <div>
              <p>
                Dygnets kilowattimmar delat med antalet liter du fyllde i ger {tal.kwhPerLiter} kWh per liter vatten,
                och varje liter kostar {tal.krPerLiter} kr. Det är det enda tal som går att jämföra rakt
                av mellan en kondensmaskin och en sorptionsmaskin.
              </p>
              <p>
                Litertalet är ditt eget. Skrev du lådans siffra ser priset per liter ungefär tre gånger bättre ut än
                det blir i en källare.
              </p>
            </div>
          )}
          <div>
            <p>
              Det jag inte vet är hur mycket maskinen pendlar. En kompressor på hygrostat drar full effekt i korta
              perioder och ingenting däremellan, så en timme gångtid är sällan en timme full effekt. Räkna med att
              det verkliga talet ligger under svaret här.
            </p>
            <p>Jag antar att maskinen drar märkeffekt hela gångtiden. Ingen uppmätt drifttid ligger bakom.</p>
          </div>
        </div>
      </Fragment>
    )
  }

  {tvattLage && tvattTal && <Fragment slot="gorInte">{TVATT_GOR_INTE}</Fragment>}
  {!tvattLage && gorInte && <Fragment slot="gorInte">{gorInte}</Fragment>}

  <Fragment slot="saRaknarJag">
    {
      illustration && (
        <div class="pappersruta">
          <Illustration
            namn="rakna/elkostnad"
            alt="En maskin med sladden dragen till ett vägguttag, och en elmätare ovanför som räknar gångtiden."
            bildtext="Skissen visar det verktyget räknar på: en maskin på 300 watt, sladden till uttaget och elmätaren som räknar vad gångtiden kostar."
            class="my-0!"
          />
        </div>
      )
    }
    <p class="m-0 mt-4 text-brod">
      Elpriset jag räknar med är SCB:s senaste genomsnitt för hushåll, {ELPRIS_KALLA.period}. Det står i tabellen
      här nedanför med länk, och du byter det mot fakturans pris i formuläret när du vill. Själva räkningen är
      den enklaste på hela sajten.
    </p>
    <ol class="m-0 mt-4 pl-6 list-decimal text-brod">
      <li class="mb-2">Jag delar effekten i watt med 1 000 och får kilowatt.</li>
      <li class="mb-2">Effekten i kilowatt gånger timmarna maskinen går per dygn ger kilowattimmar per dygn.</li>
      <li class="mb-2">För hela perioden tar jag kilowattimmarna per dygn gånger antalet dagar, och det är förbrukningen.</li>
      <li class="mb-2">Förbrukningen gånger ditt elpris blir det du betalar i kronor.</li>
      <li class="mb-2">Året är samma räkning med 365 dagar, vid den gångtid du fyllt i.</li>
      <li>
        Har du fyllt i liter vatten per dygn delar jag kilowattimmarna per dygn med det talet, så får du energin
        och kostnaden per liter.
      </li>
    </ol>
  </Fragment>

  <Fragment slot="efter">
    {/* Antagandetabellen i läsbredd, ur kortet Så räknar jag (spec-designlyft-c avsnitt 9). */}
    <section class="max-w-lasbredd">
      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">Vad siffrorna vilar på</h3>
      <Tabellyta kolumner={3} class="mt-4">
        <table class="w-full border-collapse text-liten tabular-nums">
          <caption class="sr-only">Antaganden och källor i elkostnadskalkylatorn</caption>
          <thead>
            <tr class="border-b border-linje text-left">
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Vad</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Jag räknar med</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Källa eller antagande</th>
            </tr>
          </thead>
          <tbody>
            {
              antaganden.map((a) => (
                <tr>
                  <th scope="row" class:list={[CELL_KLASS, 'text-left font-normal']}>
                    {a.storhet}
                  </th>
                  <td class={CELL_KLASS}>{a.varde}</td>
                  <td class={CELL_KLASS}>
                    {a.grund}.{' '}
                    {a.url ? (
                      <a href={a.url} rel="nofollow" class={LANK_KLASS}>
                        {a.stod}
                      </a>
                    ) : (
                      a.stod
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </Tabellyta>

      <p class="m-0 mt-6 text-brod lg:text-brod-lg">
        Gångtiden är det tal som styr svaret mest, och det är också det enda du måste gissa. En timme för mycket per
        dygn flyttar årssiffran med flera hundralappar. Vill du slippa gissa sätter du en energimätare i uttaget en
        vecka och skriver in vad den visar, så blir den här räknaren onödig för just din maskin. Var talen kommer
        ifrån står på sidan <a href="/om/sa-testar-vi/" class={LANK_KLASS}>Så testar jag</a>.
      </p>
    </section>

    {
      tvattLage && (
        <section class="max-w-lasbredd">
          <Pennstreck id="avfuktare-eller-tumlare">{TVATTABELL_RUBRIK}</Pennstreck>
          <p class="m-0 text-brod lg:text-brod-lg">{TVATTABELL_INGRESS}</p>
          <Tabellyta kolumner={3} class="mt-4">
            <table class={ELTABELL_KLASS}>
              <caption class="sr-only">{TVATTABELL_CAPTION}</caption>
              <thead>
                <tr>
                  <th scope="col">{TVATTABELL_HORN}</th>
                  <th scope="col">{TVATTABELL_KOLUMN_PER_KG}</th>
                  <th scope="col">{TVATTABELL_KOLUMN_PER_TORKNING}</th>
                </tr>
              </thead>
              <tbody>
                {
                  tvattabell.map((r) => (
                    <tr>
                      <th scope="row">{TVATT_METODNAMN[r.metod]}</th>
                      <td>{r.perKg}</td>
                      <td>{r.perTorkning}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </Tabellyta>
          <p class="m-0 mt-2 text-liten text-blyerts-2">
            <a href={TVATT_TEST.url} rel="nofollow" class={LANK_KLASS}>
              {tvattabellKallrad(TVATT_TEST.datum)}
            </a>
          </p>
        </section>
      )
    }

    {
      !tvattLage && (
        <section class="max-w-lasbredd">
          <Pennstreck id="elen-per-avfuktare">{ELTABELL_RUBRIK}</Pennstreck>
          <p class="m-0 text-brod lg:text-brod-lg">
            {ELTABELL_INGRESS.fore}{' '}
            <a href="/fukt/sorptionsavfuktare/" class={LANK_KLASS}>{ELTABELL_INGRESS.ankare}</a>
            {ELTABELL_INGRESS.efter}
          </p>
          <Tabellyta kolumner={5} class="mt-4">
            <table class={ELTABELL_KLASS}>
              <caption class="sr-only">{ELTABELL_CAPTION}</caption>
              <thead>
                <tr>
                  <th scope="col">{ELTABELL_HORN}</th>
                  <th scope="col">Effekt, W</th>
                  <th scope="col">Provklimat</th>
                  <th scope="col">kWh per dygn</th>
                  <th scope="col">Kr per år</th>
                </tr>
              </thead>
              <tbody>
                {
                  eltabell.map((r) => (
                    <tr>
                      <th scope="row">
                        <a href={`/rakna/elkostnad/?plats=${r.plats}`} class={LANK_KLASS}>{PLATS_KORT[r.plats]}</a>
                        <span class="block">{r.f.maskin}, {r.f.typ}</span>
                      </th>
                      <td>{r.f.effektW}</td>
                      {/* Hårda mellanslag som i format.ts, så att "70 %" inte bryts isär. */}
                      <td>{`${r.f.villkor.tempC} °C, ${r.f.villkor.rf} %`}</td>
                      <td>{r.kwhPerDygn}</td>
                      <td>{r.krPerAr}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </Tabellyta>
          <p class="m-0 mt-2 text-liten text-blyerts-2">
            {eltabellKallrad(ELPRIS_KALLA.period, formateraTal(ELPRIS_KR_PER_KWH, 2))}
          </p>
          <p class="m-0 mt-4">
            <a href="/rakna/elkostnad/?typ=tvatt" class:list={['inline-flex min-h-11 items-center', LANK_KLASS]}>
              {TVATT_LANK}
            </a>
          </p>
        </section>
      )
    }

    <section class="max-w-lasbredd">
      <Pennstreck id="watt-till-kwh">Räkna om watt till kilowattimmar själv</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        Effekten står i watt på typskylten, den lilla metallbrickan på maskinens baksida. Dela talet med 1 000, så
        har du kilowatt. Multiplicera kilowatten med antalet timmar maskinen faktiskt går, så har du kilowattimmar, och
        det är kilowattimmen elbolaget tar betalt för. En maskin på 1 000 W som går en timme drar alltså en
        kilowattimme. Sedan är det bara priset kvar. Multiplicera kilowattimmarna med vad du betalar per kilowattimme,
        allt inräknat, så har du kronorna.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Här är det lätt att räkna fel, för märkeffekten är inte förbrukningen. Den säger vad maskinen drar när
        allt går för fullt, och nästan ingen maskin gör det hela tiden. Kompressorn i en avfuktare startar när
        fuktgivaren säger till och stannar när luften är torr nog, och en värmefläkt på termostat gör samma sak med
        värmen. Verktyget här ovanför antar att märkeffekten dras under hela gångtiden du fyller i, så för en
        maskin som pendlar får du en övre gräns. Vill du veta vad den verkligen drar sätter du en energimätare
        mellan maskinen och vägguttaget och läser av efter en vecka.
      </p>

      <Pennstreck id="avfuktaren" niva={3}>Avfuktaren i källaren</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        En avfuktare på 320 W som styrs av sin fuktgivare går kanske åtta timmar per dygn. Det blir 2,56 kWh per
        dygn och 76,8 kWh på en månad, och med elpriset i verktyget kostar månaden 184 kr. Det här är den vanligaste
        maskinen folk räknar på, och den enda där priset per liter vatten säger något. Dela kilowattimmarna per
        dygn med antalet liter maskinen tar upp, så har du det.
      </p>

      <Pennstreck id="varmeflakten" niva={3}>Värmefläkten i garaget</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        En värmefläkt på 2 000 W med termostat, i ett garage som ska hållas frostfritt i november. Säg att den går
        fem timmar per dygn. Då drar den 10 kWh per dygn och 300 kWh på en månad, vilket kostar 720 kr. Fläkten
        blir dyrare än avfuktaren fast den står på kortare tid, och det beror på att effekten är mer än
        dubbelt så hög.
      </p>

      <Pennstreck id="byggflakten" niva={3}>Byggfläkten dygnet runt</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        En byggfläkt på 3 000 W som ska torka ett golv går utan uppehåll, och då drar den 72 kWh per dygn. En vecka
        blir 504 kWh och 1 210 kr. Det är i den storleksordningen en uttorkning efter en vattenskada hamnar, så
        räkna på den innan du hyr fläkten.
      </p>
    </section>

    {
      lasVidare.length > 0 && (
        <section>
          <Pennstreck id="las-vidare">Läs vidare</Pennstreck>
          <Artikelrutnat kort={lasVidare} visaBeskrivning={false} visaMeta={false} />
        </section>
      )
    }

    <div class="max-w-lasbredd">
      <Faq fragor={FRAGOR} />
    </div>
  </Fragment>
</Raknarsida>
