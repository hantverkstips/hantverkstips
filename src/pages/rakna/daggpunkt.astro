---
/**
 * Daggpunktskalkylatorn. Formuläret skickas som GET till samma sida och
 * beräkningen sker på servern, så sidan fungerar utan ett enda byte klient-JS.
 * Kostnaden är en serverfunktion per anrop, och den hålls nere med CDN-cache.
 * Se docs/SPEC-SIDMALLAR.md avsnitt 4.7.
 *
 * Formeln och alla antaganden ligger i src/lib/kalkyl/daggpunkt.ts. Sidan räknar
 * ingenting själv, den visar bara resultatet och redovisar källorna.
 *
 * Ingen produkt i databasen följer av den här räkningen, så sidan har inga
 * produktkort och inget reklamband. Pekar svaret på en avfuktare länkar den till
 * avfuktarkalkylatorn i stället.
 */
export const prerender = false;

import Bas from '../../layouts/Bas.astro';
import { formateraTal } from '../../lib/format';
import {
  ATGARDSTEXT,
  KRITISKT_FUKTTILLSTAND_RF,
  raknaDaggpunkt,
  STANDARD,
  tolkaQuery,
  type DaggpunktResultat,
} from '../../lib/kalkyl/daggpunkt';
import { CELL_KLASS, ETIKETT_KLASS, FALT_KLASS, LANK_KLASS } from '../../lib/kalkyl/stil';
import { verktyg } from '../../lib/strukturdata';
import { verktygsDelningsbild, verktygsillustration, verktygsVarumarkesbild } from '../../lib/verktygsbild';
import DaggpunktForm from '../../components/kalkyl/DaggpunktForm.astro';
import Faktaruta from '../../components/ui/Faktaruta.astro';
import Faq from '../../components/ui/Faq.astro';
import Markering from '../../components/ui/Markering.astro';
import Pennstreck from '../../components/ui/Pennstreck.astro';
import StrukturData from '../../components/ui/StrukturData.astro';
import Tabellyta from '../../components/ui/Tabellyta.astro';
import Illustration from '../../components/ui/Illustration.astro';
import Verktygskort from '../../components/ui/Verktygskort.astro';

Astro.locals.sidtyp = 'verktyg';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

const { indata } = tolkaQuery(Astro.url.searchParams);
const resultat = raknaDaggpunkt(indata);

const fel = resultat.status === 'ogiltig' ? resultat.fel : {};
// Vid ogiltig indata visas standardvärdenas resultat, med en rad som säger det.
const visat: DaggpunktResultat = resultat.status === 'ogiltig' ? raknaDaggpunkt(STANDARD) : resultat;
const visatIndata = resultat.status === 'ogiltig' ? STANDARD : indata;

/**
 * Fältens värden kommer från query-strängen som den skrevs, inte från de tolkade
 * talen: "tjugo" eller "" blir NaN i tolkaQuery, och NaN i ett fält som läsaren
 * ska rätta är obrukbart.
 */
function faltVarde(nyckel: string, standard: number): string {
  const ra = Astro.url.searchParams.get(nyckel);
  if (ra !== null) return ra;
  return String(standard).replace('.', ',');
}
const varden = {
  temp: faltVarde('temp', STANDARD.luftTempC),
  rf: faltVarde('rf', STANDARD.rfProcent),
  ytatemp: faltVarde('ytatemp', STANDARD.ytTempC),
};

/**
 * Delbar länk. Hela tillståndet ligger redan i query-strängen, så adressen är
 * uträkningen. Den byggs av de tolkade värdena, inte av strängen läsaren skrev,
 * så att en delad länk alltid ger samma resultat som skärmen visar.
 */
const delaQuery = new URLSearchParams({
  temp: String(visatIndata.luftTempC).replace('.', ','),
  rf: String(visatIndata.rfProcent).replace('.', ','),
  ytatemp: String(visatIndata.ytTempC).replace('.', ','),
  arstid: visatIndata.arstid,
  rum: visatIndata.rum,
});
const delaLank = new URL(`/rakna/daggpunkt/?${delaQuery.toString()}`, Astro.site ?? Astro.url).toString();

/** Tal ur resultatet, färdigformaterade, så att markupen nedan blir läsbar. */
const tal =
  visat.status === 'ok'
    ? {
        daggpunkt: formateraTal(visat.daggpunktC, 1),
        anghalt: formateraTal(visat.anghaltGPerM3, 1),
        rfYta: formateraTal(visat.rfVidYtanProcent, 0),
        marginal: formateraTal(Math.abs(visat.marginalC), 1),
        rfKrav: formateraTal(visat.rfForGransenProcent, 0),
        ytTempKrav: formateraTal(visat.ytTempForGransenC, 1),
        luftTemp: formateraTal(visatIndata.luftTempC, 0),
        rfInne: formateraTal(visatIndata.rfProcent, 0),
        ytTemp: formateraTal(visatIndata.ytTempC, 0),
      }
    : null;

/** Beskedet överst i resultatspalten: vad som händer med ytan, och vad du ska göra åt det. */
const BESKED_RUBRIK = {
  kondens: 'Ytan blir våt.',
  mogelrisk: 'Ytan blir inte våt, men mögel kan växa där.',
  ingen_risk: 'Ytan håller sig torr.',
} as const;

const BESKED_RAD = {
  vadra: 'Vädra kort med genomdrag ett par gånger om dagen, och gör ytan varmare.',
  avfuktare: 'Stäng fönstret och sätt in en avfuktare.',
  sank_fuktproduktion: 'Få ner fukten du själv skapar inne, och gör ytan varmare.',
  varm_eller_isolera_ytan: 'Gör ytan varmare.',
} as const;

const beskedRad =
  visat.status === 'ok'
    ? visat.bedomning === 'ingen_risk'
      ? 'Du behöver inte göra något åt fukten. Luktar det ändå, mät igen en kall dag.'
      : BESKED_RAD[visat.atgarder[0] ?? 'varm_eller_isolera_ytan']
    : '';

const KORT_SVAR_YTA = {
  kondens: 'Din kallaste yta är kallare än så, och där släpper luften ifrån sig vattnet.',
  mogelrisk: 'Din kallaste yta är varmare än så och blir inte våt, men luften alldeles intill den är för fuktig.',
  ingen_risk: 'Din kallaste yta är varmare än så, så den blir inte våt.',
} as const;

const titel = 'Daggpunkt, räkna ut om väggen blir våt';

/** Antagandena i tabellen under "Så räknar vi". Samma tal som konstanterna i kalkylen. */
const antaganden: { storhet: string; varde: string; grund: 'Källa' | 'Antagande'; stod: string; url?: string }[] = [
  {
    storhet: 'Daggpunkten ur temperaturen och luftfuktigheten',
    varde: 'Magnus-formeln, a = 17,625 och b = 243,04',
    grund: 'Källa',
    stod: 'Lawrence 2005 i tidskriften BAMS 86(2), som anger osäkerheten till 0,35 grader',
    url: 'https://journals.ametsoc.org/view/journals/bams/86/2/bams-86-2-225.xml',
  },
  {
    storhet: 'Gränsen där mögel kan växa på ytan',
    varde: '75 % RF',
    grund: 'Källa',
    stod: 'Boverket, BBR 6:52, kritiskt fukttillstånd när materialets eget värde inte är undersökt',
    url: 'https://www.boverket.se/sv/PBL-kunskapsbanken/regler-om-byggande/boverkets-byggregler/fuktsakerhet/hogsta-tillatna-fukttillstand/',
  },
  {
    storhet: 'Hur många gram vatten luften bär per kubikmeter. Raden är för den som vill räkna efter',
    varde: '216,68 × ångtrycket delat med temperaturen i kelvin',
    grund: 'Källa',
    stod: 'Allmänna gaslagen för vattenånga, samma härledning som Magnus-formeln',
    url: 'https://www.smhi.se/kunskapsbanken/meteorologi/luftfuktighet/olika-matt-pa-luftfuktighet',
  },
  {
    storhet: 'Luftfuktigheten alldeles intill den kalla ytan',
    varde: 'ångtrycket inne delat med mättnadsångtrycket vid ytan',
    grund: 'Antagande',
    stod: 'Jag räknar med att luften intill ytan bär lika mycket vatten som resten av rummet. Står en garderob tätt mot väggen är det verkliga talet högre',
  },
  {
    storhet: 'De typiska yttemperaturerna i hjälptexten',
    varde: '12 till 15, 5 till 10 och 8 till 12 grader',
    grund: 'Antagande',
    stod: 'Min erfarenhet från äldre hus. Din vägg kan ligga flera grader åt endera hållet, så mät med en IR-termometer om du kan',
  },
  {
    storhet: 'Gränsen där jag säger att ytan måste bli varmare',
    varde: '25 % RF inne',
    grund: 'Antagande',
    stod: 'Mitt val. Torrare än så går det inte att hålla en bostad på vintern utan att luften blir obehaglig',
  },
];

/**
 * Frågorna sist på sidan. Alla tre svaras redan av texten ovanför, med samma
 * tal; rutan är till för den som skummar och för Googles frågeblock.
 */
const FRAGOR = [
  {
    fraga: 'Vad är daggpunkt?',
    svar: 'Daggpunkten är temperaturen där luften inte längre orkar hålla kvar sitt vatten som ånga. Allt i rummet som är kallare än den temperaturen blir vått. Det är därför den kallaste ytan alltid är den som drabbas först, och i ett vanligt hus är det fönsterrutan eller ytterväggen bakom en garderob.',
  },
  {
    fraga: 'Vilken luftfuktighet är normal inomhus?',
    svar: 'På vintern ligger de flesta bostäder mellan 30 och 45 procent relativ luftfuktighet. På sommaren blir det högre, eftersom uteluften då bär mer vatten. Tänk på att hygrometern visar luften mitt i rummet. Intill en kall yta är talet alltid högre, och det är där mögel börjar.',
    lank: { text: 'Läs mer om rätt luftfuktighet inomhus, rum för rum.', href: '/fukt/luftfuktighet-inomhus/' },
  },
  {
    fraga: 'Hjälper en avfuktare mot kondens på fönster?',
    svar: 'Ja, om kondensen beror på att luften inne är fuktig. Avfuktaren tar bort vatten ur luften, och då sjunker daggpunkten under rutans temperatur. Men ett gammalt tvåglasfönster kan bli så kallt att luften skulle behöva vara obehagligt torr, och då är det rutan som ska bytas. På vintern gör en kort vädring med genomdrag morgon och kväll ofta samma nytta som maskinen.',
  },
];

/** Slug, namn och beskrivning på ett ställe: brödsmulan, og:image och WebApplication läser samma. */
const SLUG = 'daggpunkt';
const VERKTYGSNAMN = 'Daggpunktskalkylator';
const BESKRIVNING =
  'Räkna ut daggpunkten ur temperaturen inne och vad hygrometern visar, och få besked om den kallaste väggen blir våt, får mögel eller klarar sig.';
const illustration = verktygsillustration(SLUG);
/**
 * Varumärkesbilden i sidhuvudet, sedan 2026-09-19 (docs/DESIGN.md avsnitt 7).
 * Finns den står skissen i stället i "Så räknar vi", där måtten förklarar
 * räkningen. Finns den inte visas skissen i sidhuvudet som förut.
 */
const varumarke = verktygsVarumarkesbild(SLUG);
const huvudbild = varumarke ?? illustration;
---

<Bas
  title={titel}
  description={BESKRIVNING}
  reklam={false}
  brodsmulor={[
    { namn: 'Hantverkstips', href: '/' },
    { namn: 'Räkna själv', href: '/rakna/' },
    { namn: VERKTYGSNAMN },
  ]}
  bred={true}
  ogBild={verktygsDelningsbild(SLUG)}
>
  <StrukturData
    slot="head"
    data={verktyg({ url: `/rakna/${SLUG}/`, namn: VERKTYGSNAMN, beskrivning: BESKRIVNING })}
  />

  <div class="mx-auto w-full max-w-lasbredd">
    {/*
      Sidhuvudet: rubrik och ingress till vänster i 7/12, bilden till höger i
      5/12 på desktop, under ingressen på mobil. Bilden är dekorativ, H1 bär
      betydelsen, därför tom alt. Den är sidans LCP-bild och laddas därför
      eagert med fetchpriority. Varumärkesbilden har transparent bakgrund och
      ligger som heron utan ram; skissen är ett urklipp och får ramen. Saknas
      båda visas ingen bild alls.
    */}
    <section class="grid grid-cols-1 items-center gap-6 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7">
        <h1 class="m-0 font-serif text-h1 lg:text-h1-lg">Blir väggen våt? Räkna ut daggpunkten</h1>
        <p class="m-0 mt-4 text-ingress lg:text-ingress-lg">
          Skriv in hur varmt det är inne, vad hygrometern visar och hur kall den kallaste ytan i rummet är. Då får
          du daggpunkten och ett besked om du får kondens på väggen. Daggpunkten är temperaturen där luften börjar
          släppa ifrån sig vatten. Läs svaret som en bedömning av risken, för formeln är säker men hygrometern och
          din gissning på väggens temperatur är det inte.
        </p>
      </div>

      {
        huvudbild && (
          <div class="lg:col-span-5">
            <img
              src={huvudbild.src}
              alt=""
              width={huvudbild.width}
              height={huvudbild.height}
              fetchpriority="high"
              decoding="async"
              class:list={['block h-auto w-full', !varumarke && 'rounded-sm border border-linje']}
            />
          </div>
        )
      }
    </section>

    {
      visat.status === 'ok' && tal && (
        <Faktaruta variant="kortsvar">
          <p class="m-0 leading-6">Daggpunkten i ditt rum ligger på {tal.daggpunkt} grader.</p>
          <p class="m-0 leading-6">{KORT_SVAR_YTA[visat.bedomning]}</p>
          <p class="m-0 leading-6">
            Luften intill ytan ligger på <Markering>{tal.rfYta} procent luftfuktighet</Markering>,{' '}
            {visat.bedomning === 'ingen_risk' ? 'under' : 'över'} Boverkets gräns för mögel på{' '}
            {KRITISKT_FUKTTILLSTAND_RF} procent.
          </p>
          <p class="m-0 leading-6">
            {visat.bedomning === 'ingen_risk'
              ? 'Du behöver inte göra något, men mät igen om det luktar unket.'
              : visat.atgarder[0] === 'avfuktare'
                ? 'Det här löser du med en avfuktare. Vädring gör det värre.'
                : 'Vädra, skapa mindre fukt inne och gör ytan varmare.'}
          </p>
        </Faktaruta>
      )
    }

    <div class="linjerat mt-8 lg:grid lg:grid-cols-2 lg:gap-8">
      <DaggpunktForm indata={indata} varden={varden} fel={fel} />

      <div class="mt-8 border-t border-linje pt-6 lg:mt-0 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8">
        {
          visat.status === 'ok' && tal && (
            <>
              {resultat.status === 'ogiltig' && (
                <p class="m-0 mb-2 text-liten text-varning">
                  Ett av fälten gick inte att läsa, så jag visar standardvärdena tills du rättat det.
                </p>
              )}
              {/* Beskedet står först: spalten bär svaret och vad du ska göra åt
                  det. Varför det blev så står under verktyget. */}
              <p class="m-0 font-sans text-h3 lg:text-h3-lg font-bold text-blyerts">{BESKED_RUBRIK[visat.bedomning]}</p>
              <p class="m-0 mt-1 text-brod">{beskedRad}</p>

              <p class="m-0 mt-6 text-etikett lg:text-etikett-lg uppercase text-blyerts-2">Daggpunkt</p>
              {/* Enheten står på samma rad som talet, på talets baslinje
                  (DESIGN.md avsnitt 5.8). Radbryter på smal skärm. */}
              <p class="m-0 mt-1 flex flex-wrap items-baseline gap-x-2">
                <span class="font-serif text-siffra lg:text-siffra-lg text-blyerts">
                  <Markering>{tal.daggpunkt}</Markering>
                </span>
                <span class="text-ingress lg:text-ingress-lg">grader</span>
              </p>
              <p class="m-0 mt-2 text-liten text-blyerts-2">
                Räknat på {tal.luftTemp} grader och {tal.rfInne} procent luftfuktighet inne. Formeln kan visa{' '}
                {formateraTal(visat.osakerhetC, 2)} grader för mycket eller för lite.
              </p>
              <p class="m-0 mt-1 text-liten text-blyerts-2">
                Din kallaste yta på {tal.ytTemp} grader ligger {tal.marginal} grader{' '}
                {visat.bedomning === 'kondens' ? 'under' : 'över'} daggpunkten, och luften intill den håller{' '}
                {tal.rfYta} procent.
              </p>

              <p class="m-0 mt-4 text-liten text-blyerts-2">
                Varför det blev så, och vad som är fel sak att göra,{' '}
                <a href="#darfor-blev-svaret-sa" class={LANK_KLASS}>
                  står under verktyget
                </a>
                .
              </p>

              <p class="m-0 mt-4">
                <a href="#sa-raknar-vi" class:list={['inline-flex min-h-11 items-center', LANK_KLASS]}>
                  Så räknar jag
                </a>
              </p>

              {/* Dela. Uträkningen står i adressen, så ett skrivskyddat fält
                  räcker: markera och kopiera fungerar utan en rad JavaScript. */}
              <div class="mt-4 border-t border-linje pt-4">
                <label for="dela" class={ETIKETT_KLASS}>
                  Dela uträkningen
                </label>
                <input id="dela" type="text" readonly value={delaLank} class:list={[FALT_KLASS, 'border-blyerts-2']} />
                <p class="m-0 mt-1 text-liten text-blyerts-2">
                  Dina värden ligger i adressen. Markera den och kopiera, så får den du skickar till samma svar.
                </p>
              </div>
            </>
          )
        }
      </div>
    </div>

    {
      visat.status === 'ok' && tal && (
        <section>
          <Pennstreck id="darfor-blev-svaret-sa">Därför blev svaret så</Pennstreck>
          <ul class="m-0 p-0 list-none text-brod lg:text-brod-lg">
            <li class="mb-4 border-l-2 border-linje pl-4">
              <span class="block">
                {visat.bedomning === 'kondens' ? (
                  <>
                    Din yta ligger {tal.marginal} grader under daggpunkten. Så länge luften inne är så här fuktig
                    fälls det ut vatten på den, och det syns som imma på glas eller som en mörk fläck på en
                    tapetserad vägg. Luften inne bär {tal.anghalt} gram vatten per kubikmeter, och det räcker för att
                    fylla den kalla luften intill ytan helt.
                  </>
                ) : visat.bedomning === 'mogelrisk' ? (
                  <>
                    Din yta klarar sig undan kondensen med {tal.marginal} grader till godo, men luften alldeles
                    intill den ligger på {tal.rfYta} procent, och Boverkets gräns går vid {KRITISKT_FUKTTILLSTAND_RF}.
                    Står det så vecka efter vecka växer mögel på ytan utan att den någonsin varit blöt. Luften inne
                    bär {tal.anghalt} gram vatten per kubikmeter.
                  </>
                ) : (
                  <>
                    Din yta har {tal.marginal} grader till godo mot daggpunkten, och luften intill den håller{' '}
                    {tal.rfYta} procent, vilket är under Boverkets gräns på {KRITISKT_FUKTTILLSTAND_RF}. Luften inne
                    bär {tal.anghalt} gram vatten per kubikmeter. Det är ett rum som mår bra.
                  </>
                )}
              </span>
              <span class="block text-liten text-blyerts-2">
                Gränsen 75 procent är Boverkets, BBR 6:52. Daggpunkten kommer ur Magnus-formeln enligt Lawrence 2005.
              </span>
            </li>

            {visat.bedomning !== 'ingen_risk' && (
              <li class="mb-4 border-l-2 border-linje pl-4">
                <span class="block">
                  {visat.ytanMasteBliVarmare ? (
                    <>
                      Det går inte att vädra sig ur det här. Du skulle behöva ner till {tal.rfKrav} procent
                      luftfuktighet inne, och så torr luft står ingen ut med. Ytan måste i stället upp till{' '}
                      {tal.ytTempKrav} grader, och det gör du med värme eller isolering.
                    </>
                  ) : (
                    <>
                      Det finns två vägar under gränsen, och du behöver bara en av dem. Antingen får du ner
                      luftfuktigheten inne till {tal.rfKrav} procent, eller så får du upp ytan till{' '}
                      {tal.ytTempKrav} grader.
                    </>
                  )}
                </span>
                <span class="block text-liten text-blyerts-2">
                  Båda talen är samma formel räknad baklänges. Gränsen 25 procent inne, där jag slutar föreslå vädring,
                  är mitt eget val.
                </span>
              </li>
            )}

            {visat.atgarder.map((a) => (
              <li class="mb-4 border-l-2 border-linje pl-4">
                <span class="block">{ATGARDSTEXT[a]}</span>
                <span class="block text-liten text-blyerts-2">
                  {a === 'avfuktare'
                    ? 'Mitt råd. Att uteluften i augusti bär mer vatten än en kall källare följer av SMHI:s tal för sommarluft.'
                    : a === 'vadra'
                      ? 'Mitt råd. Att vinterluft bär nästan inget vatten följer av Magnus-formeln vid minusgrader.'
                      : 'Mitt råd, inget krav från någon källa.'}
                </span>
              </li>
            ))}

            <li class="mb-4 border-l-2 border-linje pl-4">
              <span class="block">
                Det svaga ledet är det du matade in. En hygrometer för ett par hundralappar kan visa några
                procentenheter fel, och väggens temperatur är en gissning tills du mätt den med en IR-termometer. Ta
                svaret som ett spann på några grader, och lita mer på det ju bättre du mätt.
              </span>
              <span class="block text-liten text-blyerts-2">Min erfarenhet, ingen publicerad siffra.</span>
            </li>
          </ul>

          {visat.bedomning !== 'ingen_risk' && (
            <>
              {visat.gorInteDetHar && (
                <>
                  <h3 id="gor-inte-det-har" class="m-0 mt-6 font-sans text-h3 lg:text-h3-lg text-blyerts">
                    Gör inte det här
                  </h3>
                  <p class="m-0 mt-2 text-brod lg:text-brod-lg">{visat.gorInteDetHar}</p>
                </>
              )}
            </>
          )}
        </section>
      )
    }

    {
      visat.status === 'ok' && visat.visaAvfuktare && (
        <section>
          <Pennstreck id="avfuktaren">Så stor avfuktare behöver utrymmet</Pennstreck>
          <p class="m-0 text-brod lg:text-brod-lg">
            Köper du en avfuktare som är för liten går den dygnet runt och kommer ändå aldrig ner till 55 procent
            luftfuktighet. Räkna ut hur många liter per dygn maskinen behöver klara innan du går till butiken.
          </p>
          <Verktygskort kalkylator="avfuktare" />
        </section>
      )
    }

    <section>
      <Pennstreck id="vad-daggpunkten-ar">Vad daggpunkten är och varför väggen kan mögla utan att bli våt</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        Luft bär vatten som ånga, och varm luft orkar bära mer än kall. Kyler du luften kommer en punkt där den inte
        orkar mer, och då släpper den vattnet som droppar. Den temperaturen kallas daggpunkten. Allt i rummet som är
        kallare än daggpunkten blir vått, och det är alltid den kallaste ytan som får ta emot först.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Kondens på en vägg ser sällan ut som droppar. Väggen suger i sig vattnet, tapeten mörknar och det börjar
        lukta källare. Och det behöver inte ens bli så blött. Luften alldeles intill en kall vägg är alltid fuktigare
        än luften mitt i rummet, och ligger den på hög luftfuktighet i några veckor räcker det för att mögel ska
        börja växa. Boverket sätter gränsen vid 75 procent relativ luftfuktighet i byggreglerna BBR 6:52, och det
        kallas kritiskt fukttillstånd. Den gränsen gäller när ingen har undersökt vad just det materialet tål. Så
        mögel växer gärna på en yta som ingen skulle kalla våt, och det är det talet som verktyget jämför med.
      </p>

      <Pennstreck id="sovrummet-i-januari" niva={3}>Sovrummet i januari</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        Två personer sover i ett rum på 20 grader, och hygrometern visar 50 procent. Då ligger daggpunkten på 9,3
        grader. Rutan i ett gammalt tvåglasfönster kommer inte ens upp i hälften av det en kall natt, så kondensen
        på insidan av fönstret är given. Nästa kandidat är ytterväggen bakom garderoben, för där står luften stilla
        och väggen är några grader kallare än rummet. Det du ska göra är att vädra kort med genomdrag morgon och
        kväll. Uteluft på några minusgrader bär nästan inget vatten alls, och när den värmts upp inne är den torrare
        än luften den bytte ut. Dra ut garderoben några centimeter från väggen medan du ändå håller på.
      </p>

      <Pennstreck id="kallaren-i-augusti" niva={3}>Källaren i augusti</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        Här vänder allt, och det här är det som förvånar de flesta. Källarluften håller kanske 18 grader och
        väggarna mot marken ligger på 12. Uteluften i augusti är varm och full av vatten, och det vattnet följer
        med in genom det öppna källarfönstret och fälls ut på den kalla väggen. Så ju mer du vädrar, desto blötare
        blir källaren. Stäng fönstret, ställ in en avfuktare och låt den gå på hygrostat, så startar den själv när
        luften blir för fuktig. Kommer fukten upp genom golvet i stället är det dräneringen som är
        problemet, och då hjälper ingen maskin i längden.
      </p>

      <Pennstreck id="garaget" niva={3}>Garaget</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        Ett ouppvärmt garage följer uteluften med ungefär ett dygns fördröjning, och det är fördröjningen som
        ställer till det. En vårdag när vädret slår om från kallt till milt ligger betongplattan kvar på gårdagens
        temperatur. Daggpunkten i den nya, mildare luften hamnar över plattans temperatur, och då står det vatten
        på golvet fast taket är helt. Samma sak händer när du kör in en blöt bil. Ventilera när det är kallare ute
        än inne, aldrig tvärtom, och ha verktygen på en hylla i stället för direkt på betongen.
      </p>
    </section>

    <section>
      <Pennstreck id="sa-raknar-vi">Så räknar jag</Pennstreck>
      {
        varumarke && illustration && (
          <Illustration
            namn="rakna/daggpunkt"
            alt="Ytterhörn i genomskärning med temperaturen ute, temperaturen inne och droppar på den kalla insidan."
            bildtext="Skissen visar det verktyget räknar på: 2 grader ute, 21 grader och 55 procent luftfuktighet inne, och en innervägg i hörnet som bara håller 11 grader. Där fälls vattnet ut."
          />
        )
      }
      <ol class="m-0 mt-4 pl-6 list-decimal text-brod lg:text-brod-lg">
        <li class="mb-2">
          Temperaturen inne säger hur mycket ånga luften orkar bära innan den är full. Det talet kallas
          mättnadsångtryck, och Magnus-formeln räknar fram det.
        </li>
        <li class="mb-2">
          Luftfuktigheten du läser av på hygrometern säger hur stor del av det utrymmet som är använt. Halvfull
          luft vid 20 grader bär 8,6 gram vatten per kubikmeter.
        </li>
        <li class="mb-2">
          Daggpunkten är samma formel baklänges. Jag letar upp den temperatur där just den mängden vatten fyller
          luften helt.
        </li>
        <li class="mb-2">
          Intill den kalla ytan är vattnet detsamma, men den kalla luften orkar bära mindre. Delar jag det ena med
          det andra får jag luftfuktigheten i skiktet närmast väggen, och den är alltid högre än den hygrometern
          visar mitt i rummet.
        </li>
        <li class="mb-2">
          Ligger ytan under daggpunkten blir den våt. Ligger luften intill ytan över 75 procent kan det växa mögel
          där, även utan en enda droppe.
        </li>
        <li>
          Till sist räknar jag baklänges. Först letar jag upp den luftfuktighet inne som ger 75 procent vid ytan.
          Sedan letar jag upp den yttemperatur som ger 75 procent med den luft du har i dag.
        </li>
      </ol>

      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">Vad siffrorna vilar på</h3>
      <Tabellyta kolumner={3} class="mt-4">
        <table class="w-full border-collapse text-liten tabular-nums">
          <caption class="sr-only">Antaganden och källor i daggpunktskalkylatorn</caption>
          <thead>
            <tr class="border-b border-linje text-left">
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Vad</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Jag räknar med</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Källa eller antagande</th>
            </tr>
          </thead>
          <tbody>
            {
              antaganden.map((a) => (
                <tr>
                  <th scope="row" class:list={[CELL_KLASS, 'text-left font-normal']}>
                    {a.storhet}
                  </th>
                  <td class={CELL_KLASS}>{a.varde}</td>
                  <td class={CELL_KLASS}>
                    {a.grund}.{' '}
                    {a.url ? (
                      <a href={a.url} rel="nofollow" class={LANK_KLASS}>
                        {a.stod}
                      </a>
                    ) : (
                      a.stod
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </Tabellyta>

      <p class="m-0 mt-6 text-brod lg:text-brod-lg">
        Själva formeln har jag inte räknat fram själv, den är Lawrence 2005 rakt av, och den osäkerhet på 0,35
        grader som står i spalten är hans. De tre yttemperaturerna i hjälptexten är däremot mina, och de byts mot
        uppmätta tal så snart jag haft IR-termometern på tillräckligt många väggar. Hur jag skiljer på läst och mätt
        står på sidan <a href="/om/sa-testar-vi/" class={LANK_KLASS}>Så testar jag</a>.
      </p>
    </section>

