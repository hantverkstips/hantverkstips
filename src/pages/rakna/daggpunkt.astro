---
/**
 * Daggpunktskalkylatorn. Formuläret skickas som GET till samma sida och
 * beräkningen sker på servern, så sidan fungerar utan ett enda byte klient-JS.
 * Kostnaden är en serverfunktion per anrop, och den hålls nere med CDN-cache.
 * Se docs/SPEC-SIDMALLAR.md avsnitt 4.7.
 *
 * Formeln och alla antaganden ligger i src/lib/kalkyl/daggpunkt.ts. Sidan räknar
 * ingenting själv, den visar bara resultatet och redovisar källorna.
 *
 * Ingen produkt i databasen följer av den här räkningen, så sidan har inga
 * produktkort och inget reklamband. Pekar svaret på en avfuktare länkar den till
 * avfuktarkalkylatorn i stället.
 */
export const prerender = false;

import { formateraTal } from '../../lib/format';
import { artikelUrl, publicerade } from '../../lib/innehall';
import { tillKortArtikel, type KortData } from '../../lib/kort';
import {
  ATGARDSTEXT,
  daggpunktTabell,
  FORVAL_PER_RUM,
  formVarden,
  KRITISKT_FUKTTILLSTAND_RF,
  OSAKERHET_C,
  raknaDaggpunkt,
  RSI_M2K_PER_W,
  RUM_MED_FORVAL,
  STANDARD,
  TABELL_RF,
  TABELL_TEMP,
  TEXT,
  tolkaQuery,
  TYPISKA_U,
  type DaggpunktResultat,
  type NormalKalla,
  type Rum,
} from '../../lib/kalkyl/daggpunkt';
import { LANK_KLASS } from '../../lib/kalkyl/stil';
import { verktygsillustration } from '../../lib/verktygsbild';
import DaggpunktForm from '../../components/kalkyl/DaggpunktForm.astro';
import Artikelrutnat from '../../components/ui/Artikelrutnat.astro';
import Faq from '../../components/ui/Faq.astro';
import Matare from '../../components/ui/Matare.astro';
import Pennstreck from '../../components/ui/Pennstreck.astro';
import Statusrad from '../../components/ui/Statusrad.astro';
import Svarstal from '../../components/ui/Svarstal.astro';
import Tabellyta from '../../components/ui/Tabellyta.astro';
import Illustration from '../../components/ui/Illustration.astro';
import Verktygskort from '../../components/ui/Verktygskort.astro';
import Raknarsida from '../../components/vyer/Raknarsida.astro';

/*
 * Daggpunktstabellen. Texterna är hantverkarens
 * (docs/briefer/texter-daggpunkt-rum-2026-09-30.md, T1 till T5). Talen i
 * cellerna och huvudena räknas och skrivs aldrig för hand.
 */
const TABELL_RUBRIK = 'Daggpunkt i tabell för vanliga temperaturer inne';
const TABELL_INGRESS =
  'Leta upp raden för temperaturen i rummet och kolumnen för det hygrometern visar. Talet där de möts är daggpunkten i grader, och en yta som är kallare än så blir våt.';
const TABELL_CAPTION =
  'Daggpunkten i grader vid olika temperatur och luftfuktighet inne, med temperaturen i raderna och luftfuktigheten i kolumnerna';
const TABELL_HORN = '°C / RF';
const TABELL_KALLRAD = `Räknat av Hantverkstips med Magnus-formeln och de konstanter Mark Lawrence publicerade 2005. Formeln kan visa upp till ${formateraTal(OSAKERHET_C, 2)} grader för mycket eller för lite.`;

Astro.locals.sidtyp = 'verktyg';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

const { indata } = tolkaQuery(Astro.url.searchParams);
const resultat = raknaDaggpunkt(indata);

const fel = resultat.status === 'ogiltig' ? resultat.fel : {};
// Vid ogiltig indata visas standardvärdenas resultat, med en rad som säger det.
const visat: DaggpunktResultat = resultat.status === 'ogiltig' ? raknaDaggpunkt(STANDARD) : resultat;
const visatIndata = resultat.status === 'ogiltig' ? STANDARD : indata;

/**
 * Fältens värden kommer från query-strängen som den skrevs, inte från de tolkade
 * talen: "tjugo" eller "" blir NaN i tolkaQuery, och NaN i ett fält som läsaren
 * ska rätta är obrukbart.
 */
function faltVarde(nyckel: string, tolkat: string): string {
  const ra = Astro.url.searchParams.get(nyckel);
  if (ra !== null) return ra;
  return tolkat;
}
// Ett fält utan nyckel i adressen får rummets förval, eller STANDARD utan rum.
const tolkat = formVarden(indata);
const varden = {
  temp: faltVarde('temp', tolkat.temp),
  rf: faltVarde('rf', tolkat.rf),
  ytatemp: faltVarde('ytatemp', tolkat.ytatemp),
  u: faltVarde('u', tolkat.u),
  ute: faltVarde('ute', tolkat.ute),
};

/**
 * Delbar länk. Hela tillståndet ligger redan i query-strängen, så adressen är
 * uträkningen. Den byggs av de tolkade värdena, inte av strängen läsaren skrev,
 * så att en delad länk alltid ger samma resultat som skärmen visar.
 */
const visatVarden = formVarden(visatIndata);
const arFonster = visatIndata.rum === 'fonster';
// Fönstret delar U-värdet och temperaturen ute, alla andra rum ytans temperatur.
const delaQuery = new URLSearchParams([
  ['temp', visatVarden.temp],
  ['rf', visatVarden.rf],
  ...(arFonster ? [] : [['ytatemp', visatVarden.ytatemp]]),
  ['arstid', visatIndata.arstid],
  ['rum', visatIndata.rum],
  ...(arFonster
    ? [
        ['u', visatVarden.u],
        ['ute', visatVarden.ute],
      ]
    : []),
]);
const delaLank = new URL(`/rakna/daggpunkt/?${delaQuery.toString()}`, Astro.site ?? Astro.url).toString();

/** Tal ur resultatet, färdigformaterade, så att markupen nedan blir läsbar. */
const tal =
  visat.status === 'ok'
    ? {
        daggpunkt: formateraTal(visat.daggpunktC, 1),
        anghalt: formateraTal(visat.anghaltGPerM3, 1),
        rfYta: formateraTal(visat.rfVidYtanProcent, 0),
        marginal: formateraTal(Math.abs(visat.marginalC), 1),
        rfKrav: formateraTal(visat.rfForGransenProcent, 0),
        ytTempKrav: formateraTal(visat.ytTempForGransenC, 1),
        luftTemp: formateraTal(visatIndata.luftTempC, 0),
        rfInne: formateraTal(visatIndata.rfProcent, 0),
        // Glaset räknas fram och visas med en decimal; en inmatad yta som förut.
        ytTemp: formateraTal(visat.ytTempC, arFonster ? 1 : 0),
      }
    : null;

/** Beskedet överst i resultatspalten: vad som händer med ytan, och vad du ska göra åt det. */
const BESKED_RUBRIK = {
  kondens: 'Ytan blir våt.',
  mogelrisk: 'Ytan blir inte våt, men mögel kan växa där.',
  ingen_risk: 'Ytan håller sig torr.',
} as const;

const BESKED_RAD = {
  vadra: 'Vädra kort med genomdrag ett par gånger om dagen, och gör ytan varmare.',
  avfuktare: 'Sätt in en avfuktare, och släpp inte in varm sommarluft genom fönster eller port.',
  sank_fuktproduktion: 'Få ner fukten du själv skapar inne, och gör ytan varmare.',
  varm_eller_isolera_ytan: 'Gör ytan varmare.',
  // Spec avsnitt 15, textlistan V10 och V10b.
  tata_bjalklaget: 'Täta vindsluckan och ställena där rör och kablar går upp genom bjälklaget.',
  ventilera_vinden: 'Håll ventilationen på vinden fri.',
} as const;

const beskedRad =
  visat.status === 'ok'
    ? visat.bedomning === 'ingen_risk'
      ? 'Du behöver inte göra något åt fukten. Luktar det ändå, mät igen en kall dag.'
      : BESKED_RAD[visat.atgarder[0] ?? 'varm_eller_isolera_ytan']
    : '';

const KORT_SVAR_YTA = {
  kondens: 'Din kallaste yta är kallare än daggpunkten, och där släpper luften ifrån sig vattnet.',
  mogelrisk: 'Din kallaste yta är varmare än daggpunkten, men luften alldeles intill den är för fuktig.',
  ingen_risk: 'Din kallaste yta är varmare än daggpunkten och blir inte våt.',
} as const;

/*
 * Svarsytan, fas C (spec-designlyft-c-2026-10-02 avsnitt 3). Ny text är
 * hantverkarens (texter-designlyft-2026-10-02.md, fas C). Klartexten har
 * platshållarna {daggpunkt}, {temp}, {rf} och {kalla} (ytans temperatur).
 */
const SVAR_VAD = 'daggpunkten i ditt rum'; // daggpunkt.svar.vad
const MATARE_ETIKETT = 'Luften intill ytan'; // daggpunkt.matare.etikett
const KLARTEXT =
  'Vid {temp} grader och {rf} procent luftfuktighet är daggpunkten {daggpunkt} grader, räknat med Magnus-formeln. Den kallaste ytan håller {kalla} grader.'; // daggpunkt.klartext

/** Källraden under ett råd i Det här gör du, ordagrant ur listan Därför blev svaret så. */
function atgardKalla(a: string): string {
  return a === 'avfuktare'
    ? 'Mitt råd. Att uteluften i augusti bär mer vatten än en kall källare följer av SMHI:s tal för sommarluft.'
    : a === 'vadra'
      ? 'Mitt råd. Att vinterluft bär nästan inget vatten följer av Magnus-formeln vid minusgrader.'
      : a === 'tata_bjalklaget'
        ? 'Boverket beskriver hur kalla vindar får kondens på undertaket, och i Bygg & teknik 4/06 pekar SP ut inneluft som läcker upp som en av orsakerna.'
        : a === 'ventilera_vinden'
          ? 'Hagentoft på Chalmers visade med mätningar i ett SBUF-projekt att styrd ventilation gav i genomsnitt 7,4 procentenheter lägre luftfuktighet på vinden än vanlig ventilation. LTH:s mätningar visar att vinden följer uteluften och bara är någon grad varmare.'
          : 'Mitt råd, inget krav från någon källa.';
}

/*
 * Förvalen per rum. Texterna är hantverkarens
 * (docs/briefer/texter-daggpunkt-rum-2026-09-30.md, S1 till S5). Talen kommer
 * som parametrar och skrivs aldrig för hand.
 */
const RUMSRAD_RUBRIK = 'Typiska tal för';
const RUMSRAD_ARIA = 'Fyll i typiska tal för ett rum';
/** S2: rummets normala luftfuktighet och var läsarens tal ligger. lagst är null när källan bara ger ett högsta tal. */
function normaltRad(
  rumNamn: string,
  lagst: number | null,
  hogst: number,
  rfInne: string,
  lage: 'under' | 'inom' | 'over',
): string {
  if (lagst === null) {
    const dina = lage === 'over' ? 'gör det' : 'gör det inte';
    return `I ${rumNamn} bör luftfuktigheten helst inte gå över ${hogst} procent, och dina ${rfInne} procent ${dina}.`;
  }
  const dina = lage === 'over' ? 'över det spannet' : lage === 'under' ? 'under det spannet' : 'inom det spannet';
  return `I ${rumNamn} brukar luftfuktigheten ligga på ${lagst} till ${hogst} procent så här års, och dina ${rfInne} procent ligger ${dina}.`;
}
/** S3: hur glasets temperatur kom fram ur U-värdet och temperaturen ute. */
function fonsterRad(u: string, ute: string, glas: string): string {
  return `Ett fönster med U-värdet ${u} håller ${glas} grader mitt på glaset när det är ${ute} grader ute, och det är glasets temperatur jag jämför med daggpunkten. Kanten runt glaset och bågens nederdel är kallare än mitten, så där kommer imman först.`;
}
/** S4: källraden under S3. */
const FONSTER_KALLRAD = `Glasets temperatur är temperaturen inne minus ${formateraTal(RSI_M2K_PER_W, 2)} gånger U-värdet gånger skillnaden mellan inne och ute. Talet ${formateraTal(RSI_M2K_PER_W, 2)} m²K/W är värmemotståndet vid en lodrät yta inomhus i standarden SS-EN ISO 6946, och U-värdena kommer ur Energimyndighetens fönsterguide ET 2025:01.`;
/** S5: meningen före källraden om rummets normala luftfuktighet (källraden är TEXT.normaltKalla). */
function normaltKallaRad(rumNamn: string, kalla: NormalKalla): string {
  switch (kalla) {
    case 'traguiden':
      return `Luftfuktigheten i ${rumNamn} följer årstiden. Den är högst på sommaren och lägst på vintern, när kall uteluft kommer in och blir torr av att värmas upp.`;
    case 'astma-allergi':
      return `Talet för ${rumNamn} är ett råd mot kvalster och gäller vintern. Kvalster trivs sämre i torr luft.`;
    case 'fohm':
      return `För ${rumNamn} finns inget mål att sikta på, bara en gräns där det är dags att ta reda på vad som är fel.`;
    case 'villaagarna':
      return `Gränsen för ${rumNamn} gäller egentligen väggarna och träet. Luften hålls under den så att materialen runt omkring inte blir fuktigare än så med tiden.`;
    case 'olsson-sp':
      return `Gränsen för ${rumNamn} är satt för träet i golvbjälklaget ovanför, där mögel kan börja växa när luftfuktigheten går strax över gränsen.`;
    case 'sbi':
      return `Gränsen för ${rumNamn} gäller rost på det som står där, som verktyg, cyklar och bilen.`;
    case 'lth-vind':
      return `I ${rumNamn} är det vanligt att luftfuktigheten ligger över ${KRITISKT_FUKTTILLSTAND_RF} procent hela vintern. Det är inget tecken på skada i sig, eftersom mögel växer långsamt i kyla.`;
  }
}
/** Rummen som de står mitt i en mening i S2 och S5. */
const RUM_I_TEXT: Record<Rum, string> = {
  bostad: 'ett uppvärmt rum',
  sovrum: 'ett sovrum',
  fonster: 'rummet innanför fönstret',
  kallare: 'en källare',
  krypgrund: 'en krypgrund',
  vind: 'ett kallt vindsutrymme',
  garage: 'ett garage',
};
const rumNamn = (r: Rum): string => RUM_I_TEXT[r];

/** Grader med minustecknet som ord, som i löptexten på sajten. */
const graderOrd = (n: number): string => {
  const t = formateraTal(Math.abs(n), Number.isInteger(n) ? 0 : 1);
  return n < 0 ? `minus ${t}` : t;
};
/**
 * Cellklasserna en gång på <table>, som på badrum-kostnad och fasadyta, så att
 * raderna förvalen lägger till inte bär klasserna var för sig (budgeten).
 */
const TABELL_KLASS =
  'w-full border-collapse text-liten tabular-nums [&_th]:p-2 [&_td]:p-2 [&_th]:align-top [&_td]:align-top [&_th]:text-left [&_tbody_th]:[font-weight:inherit] [&_tr]:border-b [&_tr]:border-linje [&_th]:text-blyerts [&_td]:text-blyerts [&_thead_th]:text-etikett [&_thead_th]:uppercase [&_thead_th]:text-blyerts-2';
/** Daggpunktstabellen: tätare celler än TABELL_KLASS så att sju kolumner ryms på 343 px, talen högerställda. */
const DAGGPUNKT_TABELL_KLASS =
  'w-full border-collapse text-liten tabular-nums [&_th]:px-1 [&_td]:px-1 [&_th]:py-2 [&_td]:py-2 [&_th]:text-left [&_thead_th+th]:text-right [&_td]:text-right [&_tbody_th]:[font-weight:inherit] [&_tr]:border-b [&_tr]:border-linje [&_th]:text-blyerts-2 [&_td]:text-blyerts [&_thead_th]:text-etikett [&_thead_th]:uppercase';
const daggpunktRader = daggpunktTabell();
/** Läsarens cell får markering bara när både temperaturen och luftfuktigheten är en rad och en kolumn. */
const lasarensTemp = (TABELL_TEMP as readonly number[]).includes(visatIndata.luftTempC) ? visatIndata.luftTempC : null;
const lasarensRf = (TABELL_RF as readonly number[]).includes(visatIndata.rfProcent) ? visatIndata.rfProcent : null;
/** En decimal, decimalkomma och ett riktigt minustecken (U+2212). */
const tabellTal = (n: number): string => formateraTal(n, 1).replace(/^-/, '−');
const ET_2025_01 =
  'https://energiochklimatradgivningen.se/download/18.5e9a579b195c021e865e6614/1742900645267/BQ_EPRO011_FO%CC%88NSTER_ET_2025_01_A4_TA.pdf';

/** S6: "Vad" och "Källa eller antagande" för förvalens rader, en per rum. */
const FORVAL_ANTAGANDE: Record<Exclude<Rum, 'bostad'>, { storhet: string; stod: string }> = {
  sovrum: {
    storhet: 'Talen i sovrummet vintertid',
    stod: 'Talen för luften har stöd hos Folkhälsomyndigheten och Astma- och Allergiförbundet. Väggens temperatur ligger i den kallare änden av spannet för ytterväggar i hjälptexten, som är mitt antagande',
  },
  fonster: {
    storhet: 'Talen för fönstret vintertid',
    stod: 'Luften är densamma som i sovrummet. U-värdet är det för ett vanligt tvåglasfönster i Energimyndighetens fönsterguide, och temperaturen ute är den temperatur där Folkhälsomyndigheten säger att mycket kondens på insidan tyder på ett fuktproblem',
  },
  kallare: {
    storhet: 'Talen i källaren på sommaren',
    stod: 'Luften är fuktig sommarluft efter SMHI:s tal för juli. Väggens temperatur ligger i den varmare änden av spannet för källarväggar i hjälptexten, som är mitt antagande',
  },
  krypgrund: {
    storhet: 'Talen i krypgrunden på sommaren',
    stod: 'Luften är densamma som i källaren. Ytans temperatur är den jag räknar med i en krypgrund, och Fuktcentrums mätningar ger en medeltemperatur strax under den',
  },
  vind: {
    storhet: 'Talen på en kallvind vintertid',
    stod: 'Talen för luften kommer från SP:s beräkning för en vind som är två grader varmare än uteluften, när det är 0 grader och 95 procent luftfuktighet ute. För ytan antar jag att råsponten håller uteluftens temperatur, eftersom jag inte hittat något tal för hur mycket kallare den blir en klar natt',
  },
  garage: {
    storhet: 'Talen i ett ouppvärmt garage på sommaren',
    stod: 'Luften är densamma som i källaren. Ytan har samma temperatur som avfuktarkalkylatorn räknar med för ett ouppvärmt garage',
  },
};

/** Raderna förvalen lägger till i antagandetabellen (S6), efter Magnus-raden. */
const antagandenRum: { storhet: string; varde: string; grund: 'Källa' | 'Antagande'; stod: string; url?: string }[] = [
  {
    storhet: 'Värmemotståndet mellan rumsluften och glaset',
    varde: `${formateraTal(RSI_M2K_PER_W, 2)} m²K/W`,
    grund: 'Källa',
    stod: 'Standarden SS-EN ISO 6946, värdet för en lodrät yta inomhus',
  },
  {
    storhet: 'U-värdena för tvåglas, treglas och energifönster i hjälptexten',
    varde: `${TYPISKA_U.map((t) => `${formateraTal(t.spann[0], 1)} till ${formateraTal(t.spann[1], 1)}`)
      .join(', ')
      .replace(/, ([^,]*)$/, ' och $1')} W/m²K`,
    grund: 'Källa',
    stod: 'Energimyndighetens fönsterguide ET 2025:01, tabell 1',
    url: ET_2025_01,
  },
  ...RUM_MED_FORVAL.flatMap((r) => {
    const f = FORVAL_PER_RUM[r];
    if (!f) return [];
    const yta =
      f.ytTempC !== undefined
        ? `ytan ${graderOrd(f.ytTempC)} °C`
        : `U ${formateraTal(f.uVarde ?? STANDARD.uVarde, 1)} W/m²K, ute ${graderOrd(f.uteTempC ?? STANDARD.uteTempC)} °C`;
    return [
      {
        storhet: FORVAL_ANTAGANDE[r].storhet,
        varde: `${formateraTal(f.luftTempC, 0)} °C, ${formateraTal(f.rfProcent, 0)} % RF, ${yta}`,
        // Ytorna 12 och 10 grader är antaganden; fönstrets tal har alla källa (spec avsnitt 1).
        grund: f.ytTempC !== undefined ? ('Antagande' as const) : ('Källa' as const),
        stod: FORVAL_ANTAGANDE[r].stod,
      },
    ];
  }),
];

const titel = 'Daggpunkt, räkna ut om väggen blir våt';

/** Antagandena i tabellen under "Så räknar vi". Samma tal som konstanterna i kalkylen. */
const antaganden: { storhet: string; varde: string; grund: 'Källa' | 'Antagande'; stod: string; url?: string }[] = [
  {
    storhet: 'Daggpunkten ur temperaturen och luftfuktigheten',
    varde: 'Magnus-formeln, a = 17,625 och b = 243,04',
    grund: 'Källa',
    stod: 'Lawrence 2005 i tidskriften BAMS 86(2), som anger osäkerheten till 0,35 grader',
    url: 'https://journals.ametsoc.org/view/journals/bams/86/2/bams-86-2-225.xml',
  },
  ...antagandenRum,
  {
    storhet: 'Högsta tillåtna fukttillstånd, den gräns verktyget jämför luften intill ytan med',
    varde: '75 % RF',
    grund: 'Källa',
    stod: 'Boverkets byggregler, BFS 2024:8, 7 kap. 1 §, högsta tillåtna fukttillstånd när materialets eget värde inte är undersökt',
    url: 'https://www.boverket.se/sv/PBL-kunskapsbanken/regler-om-byggande/hygien-halsa-och-miljo/fuktsakerhet/',
  },
  {
    storhet: 'Gränsen där mögel kan börja växa på trä och träbaserade material',
    varde: '75 till 80 % RF',
    grund: 'Källa',
    stod: 'Svenskt Trä, TräGuiden, sidan om mikroorganismer. Gränsen gäller vid rumstemperatur och när fukten ligger kvar länge',
    url: 'https://www.traguiden.se/om-tra/materialet-tra/traets-egenskaper-och-kvalitet/bestandighet1/mikroorganismer1/',
  },
  {
    storhet: 'Hur många gram vatten luften bär per kubikmeter. Raden är för den som vill räkna efter',
    varde: '216,68 × ångtrycket delat med temperaturen i kelvin',
    grund: 'Källa',
    stod: 'Allmänna gaslagen för vattenånga, samma härledning som Magnus-formeln',
    url: 'https://www.smhi.se/kunskapsbanken/meteorologi/luftfuktighet/olika-matt-pa-luftfuktighet',
  },
  {
    storhet: 'Luftfuktigheten alldeles intill den kalla ytan',
    varde: 'ångtrycket inne delat med mättnadsångtrycket vid ytan',
    grund: 'Antagande',
    stod: 'Jag räknar med att luften intill ytan bär lika mycket vatten som resten av rummet. Står en garderob tätt mot väggen är det verkliga talet högre',
  },
  {
    storhet: 'De typiska yttemperaturerna i hjälptexten',
    varde: '12 till 15, 5 till 10 och 8 till 12 grader',
    grund: 'Antagande',
    stod: 'Mitt antagande, inga mätningar. Din vägg kan ligga flera grader åt endera hållet, så mät med en IR-termometer om du kan',
  },
  {
    storhet: 'Gränsen där jag säger att ytan måste bli varmare',
    varde: '25 % RF inne',
    grund: 'Antagande',
    stod: 'Mitt val. Torrare än så går det inte att hålla en bostad på vintern utan att luften blir obehaglig',
  },
];

/**
 * Frågorna sist på sidan. Alla tre svaras redan av texten ovanför, med samma
 * tal; rutan är till för den som skummar och för Googles frågeblock.
 */
const FRAGOR = [
  {
    fraga: 'Vad är daggpunkt?',
    svar: 'Daggpunkten är temperaturen där luften inte längre orkar hålla kvar sitt vatten som ånga. Allt i rummet som är kallare än den temperaturen blir vått. Det är därför den kallaste ytan alltid är den som drabbas först, och i ett vanligt hus är det fönsterrutan eller ytterväggen bakom en garderob.',
  },
  {
    fraga: 'Vilken luftfuktighet är normal inomhus?',
    svar: 'I ett uppvärmt hus ligger luftfuktigheten på 10 till 25 procent på vintern och på 45 till 60 procent på sommaren, enligt Svenskt Träs handbok TräGuiden. Skillnaden kommer av att uteluften bär mycket mer vatten på sommaren. Tänk på att hygrometern visar luften mitt i rummet. Intill en kall yta är talet alltid högre, och det är där mögel kan börja växa.',
    lank: { text: 'Läs mer om rätt luftfuktighet inomhus, rum för rum.', href: '/fukt/luftfuktighet-inomhus/' },
  },
  {
    fraga: 'Hjälper en avfuktare mot kondens på fönster?',
    svar: 'Sällan på vintern. En avfuktare tar visserligen vatten ur luften och sänker daggpunkten, men uteluften i januari är så torr att några minuters vädring med genomdrag morgon och kväll gör samma sak utan att kosta något. Immar ett gammalt tvåglasfönster ändå, är det glaset som är för kallt, och då hjälper varken maskinen eller vädringen helt. En avfuktare gör nytta där luften är fuktig också på sommaren, som i en källare, och det är bara där räknaren föreslår en.',
  },
];

/** Slug, namn och beskrivning på ett ställe: brödsmulan, og:image och WebApplication läser samma. */
const SLUG = 'daggpunkt';
const VERKTYGSNAMN = 'Daggpunktskalkylator';
const BESKRIVNING =
  'Räkna ut daggpunkten ur temperaturen inne och vad hygrometern visar, och få besked om den kallaste väggen blir våt, får mögel eller klarar sig.';
/** Skissen står i kortet Så räknar jag. Huvudet har ingen bild sedan fas C (DESIGN.md 5.8). */
const illustration = verktygsillustration(SLUG);

/** Klartexten i svarsytan med räknarens aktuella tal. */
const klartext = tal
  ? KLARTEXT.replace('{daggpunkt}', tal.daggpunkt)
      .replace('{temp}', tal.luftTemp)
      .replace('{rf}', tal.rfInne)
      .replace('{kalla}', tal.ytTemp)
  : '';

/**
 * Läs vidare som kort: artiklarna den förra listan pekade på, i samma ordning.
 * Etiketten är bara typen, som i artikelmallen.
 */
const LAS_VIDARE = [
  '/fukt/luftfuktighet-inomhus/',
  '/fukt/fukt-i-kallaren/',
  '/fukt/sorptionsavfuktare/',
  '/grund/isolera-kallarvagg/',
];
const artiklar = [...(await publicerade('guider')), ...(await publicerade('kunskap'))];
const lasVidare: KortData[] = LAS_VIDARE.flatMap((href) => {
  const e = artiklar.find((a) => artikelUrl(a) === href);
  if (!e) return [];
  const { niva: _niva, ...kort } = tillKortArtikel(e);
  return [kort];
});
---

<Raknarsida
  slug={SLUG}
  namn={VERKTYGSNAMN}
  titel={titel}
  beskrivning={BESKRIVNING}
  rubrik="Blir väggen våt? Räkna ut daggpunkten"
  delaUrl={delaLank}
>
  <p slot="ingress">
    Skriv in hur varmt det är inne, vad hygrometern visar och hur kall den kallaste ytan i rummet är. Då får du
    daggpunkten och ett besked om du får kondens på väggen. Daggpunkten är temperaturen där luften börjar släppa ifrån
    sig vatten. Läs svaret som en bedömning av risken, för formeln är säker men hygrometern och din gissning på
    väggens temperatur är det inte.
  </p>

  {/* Förvalen: en länk per rum som öppnar förvalet. Ingen JS. */}
  <nav slot="forval" aria-label={RUMSRAD_ARIA}>
    <p class="etikett text-blyerts-2">{RUMSRAD_RUBRIK}</p>
    <ul class="flex flex-wrap gap-2">
      {
        RUM_MED_FORVAL.map((r) => (
          <li>
            <a class="chip" href={`/rakna/daggpunkt/?rum=${r}#raknaren`} aria-current={indata.rum === r ? 'true' : undefined}>
              {TEXT.rumKort[r]}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <DaggpunktForm slot="formular" indata={indata} varden={varden} fel={fel} />

  {
    visat.status === 'ok' && tal && (
      <Fragment slot="svar">
        {resultat.status === 'ogiltig' && (
          <p class="text-liten text-varning">
            Ett av fälten gick inte att läsa, så jag visar standardvärdena tills du rättat det.
          </p>
        )}
        <Svarstal tal={tal.daggpunkt} enhet="grader" vad={SVAR_VAD} />
        <div class="text-brod">
          <p class="font-bold">{BESKED_RUBRIK[visat.bedomning]}</p>
          <p>{beskedRad}</p>
        </div>
        <Matare
          etikett={MATARE_ETIKETT}
          varde={visat.rfVidYtanProcent}
          grans={KRITISKT_FUKTTILLSTAND_RF}
          enhet="%"
          visat={`${tal.rfYta} %`}
        />
        <Statusrad ton={visat.bedomning === 'ingen_risk' ? 'ok' : 'varning'} text={KORT_SVAR_YTA[visat.bedomning]} />
        <p class="text-liten text-blyerts">{klartext}</p>
      </Fragment>
    )
  }

  {
    visat.status === 'ok' &&
      visat.atgarder.map((a) => (
        <li slot="rad">
          <div>
            <span class="block">{ATGARDSTEXT[a]}</span>
            <span class="block text-liten text-blyerts-2">{atgardKalla(a)}</span>
          </div>
        </li>
      ))
  }

  {
    visat.status === 'ok' && tal && (
      <Fragment slot="darfor">
        <Pennstreck id="darfor-blev-svaret-sa" utanLuft>
          Därför blev svaret så
        </Pennstreck>
        <div class="darfor">
          {/* Raderna under talet i den förra resultatspalten. Spec avsnitt 3 ger dem ingen plats; se leveransen. */}
          <div>
            <p>
              Räknat på {tal.luftTemp} grader och {tal.rfInne} procent luftfuktighet inne. Formeln kan visa{' '}
              {formateraTal(visat.osakerhetC, 2)} grader för mycket eller för lite.
            </p>
          </div>
          <div>
            <p>
              Din kallaste yta på {tal.ytTemp} grader ligger {tal.marginal} grader{' '}
              {visat.bedomning === 'kondens' ? 'under' : 'över'} daggpunkten, och luften intill den håller{' '}
              {tal.rfYta} procent.
            </p>
          </div>
          <div>
            <p>
              {normaltRad(
                rumNamn(visatIndata.rum),
                visat.normalt.lagst,
                visat.normalt.hogst,
                tal.rfInne,
                visat.normalt.lage,
              )}
            </p>
          </div>

          {arFonster && (
            <div>
              <p>
                {fonsterRad(
                  formateraTal(visatIndata.uVarde ?? STANDARD.uVarde, 1),
                  graderOrd(visatIndata.uteTempC ?? STANDARD.uteTempC),
                  tal.ytTemp,
                )}
              </p>
              <p>{FONSTER_KALLRAD}</p>
            </div>
          )}
          <div>
            <p>
              {visat.bedomning === 'kondens' ? (
                <>
                  Din yta ligger {tal.marginal} grader under daggpunkten. Så länge luften inne är så här fuktig fälls
                  det ut vatten på den, och det syns som imma på glas eller som en mörk fläck på en tapetserad vägg.
                  Luften inne bär {tal.anghalt} gram vatten per kubikmeter, och det räcker för att fylla den kalla
                  luften intill ytan helt.
                </>
              ) : visat.bedomning === 'mogelrisk' ? (
                <>
                  Din yta klarar sig undan kondensen med {tal.marginal} grader till godo, men luften alldeles intill
                  den ligger på {tal.rfYta} procent, och redan vid {KRITISKT_FUKTTILLSTAND_RF} procent kan mögel
                  börja växa. Står det så vecka efter vecka växer mögel på ytan utan att den någonsin varit blöt.
                  Luften inne bär {tal.anghalt} gram vatten per kubikmeter.
                </>
              ) : (
                <>
                  Din yta har {tal.marginal} grader till godo mot daggpunkten, och luften intill den håller{' '}
                  {tal.rfYta} procent, vilket är under de {KRITISKT_FUKTTILLSTAND_RF} procent där mögel kan börja
                  växa. Luften inne bär {tal.anghalt} gram vatten per kubikmeter. Det är ett rum som mår bra.
                </>
              )}
            </p>
            <p>
              Gränsen på 75 procent kommer från TräGuiden och står också i Boverkets byggregler. Daggpunkten kommer ur
              Magnus-formeln enligt Lawrence 2005.
            </p>
          </div>

          {/* Vinden har eget råd (spec avsnitt 15): de två vägarna och värme på ytan gäller inte där. */}
          {visat.bedomning !== 'ingen_risk' && visatIndata.rum !== 'vind' && (
            <div>
              <p>
                {visat.ytanMasteBliVarmare ? (
                  <>
                    Det går inte att vädra sig ur det här. Du skulle behöva ner till {tal.rfKrav} procent
                    luftfuktighet inne, och så torr luft står ingen ut med. Ytan måste i stället upp till{' '}
                    {tal.ytTempKrav} grader, och det gör du med värme eller isolering.
                  </>
                ) : (
                  <>
                    Det finns två vägar under gränsen, och du behöver bara en av dem. Antingen får du ner
                    luftfuktigheten inne till {tal.rfKrav} procent, eller så får du upp ytan till{' '}
                    {tal.ytTempKrav} grader.
                  </>
                )}
              </p>
              <p>
                Båda talen är samma formel räknad baklänges. Gränsen 25 procent inne, där jag slutar föreslå vädring, är
                mitt eget val.
              </p>
            </div>
          )}

          <div>
            <p>{normaltKallaRad(rumNamn(visatIndata.rum), visat.normalt.kalla)}</p>
            <p>{TEXT.normaltKalla[visat.normalt.kalla]}</p>
          </div>

          <div>
            <p>
              Det svaga ledet är det du matade in. En hygrometer för ett par hundralappar kan visa några procentenheter
              fel, och väggens temperatur är en gissning tills du mätt den med en IR-termometer. Ta svaret som ett
              spann på några grader, och lita mer på det ju bättre du mätt.
            </p>
            <p>Mitt råd, ingen publicerad siffra.</p>
          </div>
        </div>
      </Fragment>
    )
  }

  {
    visat.status === 'ok' && visat.bedomning !== 'ingen_risk' && visat.gorInteDetHar && (
      <Fragment slot="gorInte">{visat.gorInteDetHar}</Fragment>
    )
  }

  <Fragment slot="saRaknarJag">
    {
      illustration && (
        <div class="pappersruta">
          <Illustration
            namn="rakna/daggpunkt"
            alt="Ytterhörn i genomskärning med temperaturen ute, temperaturen inne och droppar på den kalla insidan."
            bildtext="Skissen visar det verktyget räknar på: 2 grader ute, 21 grader och 55 procent luftfuktighet inne, och en innervägg i hörnet som bara håller 11 grader. Där fälls vattnet ut."
            class="my-0!"
          />
        </div>
      )
    }
    <ol class="m-0 mt-4 pl-6 list-decimal text-brod">
      <li class="mb-2">
        Temperaturen inne säger hur mycket ånga luften orkar bära innan den är full. Det talet kallas
        mättnadsångtryck, och Magnus-formeln räknar fram det.
      </li>
      <li class="mb-2">
        Luftfuktigheten du läser av på hygrometern säger hur stor del av det utrymmet som är använt. Halvfull luft vid
        20 grader bär 8,6 gram vatten per kubikmeter.
      </li>
      <li class="mb-2">
        Daggpunkten är samma formel baklänges. Jag letar upp den temperatur där just den mängden vatten fyller luften
        helt.
      </li>
      <li class="mb-2">
        Intill den kalla ytan är vattnet detsamma, men den kalla luften orkar bära mindre. Delar jag det ena med det
        andra får jag luftfuktigheten i skiktet närmast väggen, och den är alltid högre än den hygrometern visar mitt
        i rummet.
      </li>
      <li class="mb-2">
        Ligger ytan under daggpunkten blir den våt. Ligger luften intill ytan över 75 procent kan det växa mögel där,
        även utan en enda droppe.
      </li>
      <li>
        Till sist räknar jag baklänges. Först letar jag upp den luftfuktighet inne som ger 75 procent vid ytan. Sedan
        letar jag upp den yttemperatur som ger 75 procent med den luft du har i dag.
      </li>
    </ol>

    <p class="m-0 mt-4 text-liten text-blyerts-2">
      Själva formeln har jag inte räknat fram själv. Den är hämtad rakt av från Lawrence 2005, och osäkerheten på 0,35 grader i
      tabellen nedanför är också hans. De tre yttemperaturerna i hjälptexten är däremot mina egna antaganden och inga mätningar,
      så mät din egen vägg med en IR-termometer om du kan. Hur jag skiljer på läst och mätt står på sidan{' '}
      <a href="/om/sa-testar-vi/" class={LANK_KLASS}>Så testar jag</a>.
    </p>
  </Fragment>

  <Fragment slot="efter">
    {/* Antagandetabellen i läsbredd, ur kortet Så räknar jag (spec-designlyft-c avsnitt 9). */}
    <section class="max-w-lasbredd">
      <h3 class="m-0 mt-8 font-sans text-h3 text-blyerts">Vad siffrorna vilar på</h3>
      <Tabellyta kolumner={3} class="mt-4">
        <table class={TABELL_KLASS}>
          <caption class="sr-only">Antaganden och källor i daggpunktskalkylatorn</caption>
          <thead>
            <tr>
              <th scope="col">Vad</th>
              <th scope="col">Jag räknar med</th>
              <th scope="col">Källa eller antagande</th>
            </tr>
          </thead>
          <tbody>
            {
              antaganden.map((a) => (
                <tr>
                  <th scope="row">{a.storhet}</th>
                  <td>{a.varde}</td>
                  <td>
                    {a.grund}.{' '}
                    {a.url ? (
                      <a href={a.url} rel="nofollow" class={LANK_KLASS}>
                        {a.stod}
                      </a>
                    ) : (
                      a.stod
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </Tabellyta>
    </section>

    {
      visat.status === 'ok' && visat.visaAvfuktare && (
        <section class="max-w-lasbredd">
          <Pennstreck id="avfuktaren">Så stor avfuktare behöver utrymmet</Pennstreck>
          <p class="m-0 text-brod lg:text-brod-lg">
            Köper du en avfuktare som är för liten går den dygnet runt och kommer ändå aldrig ner till 55 procent
            luftfuktighet. Räkna ut hur många liter per dygn maskinen behöver klara innan du går till butiken.
          </p>
          <Verktygskort kalkylator="avfuktare" />
        </section>
      )
    }

    <section class="max-w-lasbredd">
      <Pennstreck id="daggpunktstabell">{TABELL_RUBRIK}</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">{TABELL_INGRESS}</p>
      <Tabellyta kolumner={7} class="mt-4">
        <table class={DAGGPUNKT_TABELL_KLASS}>
          <caption class="sr-only">{TABELL_CAPTION}</caption>
          <thead>
            <tr>
              <th scope="col">{TABELL_HORN}</th>
              {TABELL_RF.map((rf) => <th scope="col">{`${rf} %`}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              daggpunktRader.map((rad) => (
                <tr>
                  <th scope="row">{`${rad.tempC} °C`}</th>
                  {rad.celler.map((c) => (
                    <td class:list={[rad.tempC === lasarensTemp && c.rf === lasarensRf && 'bg-tumstock font-bold']}>
                      {tabellTal(c.daggpunktC)}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </Tabellyta>
      <p class="m-0 mt-2 text-liten text-blyerts-2">{TABELL_KALLRAD}</p>
    </section>

    <section class="max-w-lasbredd">
      <Pennstreck id="vad-daggpunkten-ar">Vad daggpunkten är och varför väggen kan mögla utan att bli våt</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        Luft bär vatten som ånga, och varm luft orkar bära mer än kall. Kyler du luften kommer en punkt där den inte
        orkar mer, och då släpper den vattnet som droppar. Den temperaturen kallas daggpunkten. Allt i rummet som är
        kallare än daggpunkten blir vått, och det är alltid den kallaste ytan som får ta emot först.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Kondens på en vägg ser sällan ut som droppar. Väggen suger i sig vattnet, tapeten mörknar och det börjar
        lukta källare. Och det behöver inte ens bli så blött. Luften alldeles intill en kall vägg är alltid fuktigare
        än luften mitt i rummet, och ligger den på hög luftfuktighet i några veckor räcker det för att mögel ska
        börja växa. Gränsen går vid 75 procent relativ fuktighet. Under den kan inget mögel utvecklas, enligt Svenskt
        Träs handbok TräGuiden, och ju högre över den luften ligger, desto fortare växer det. Så mögel växer gärna på en yta som
        ingen skulle kalla våt. Samma tal står i Boverkets byggregler som högsta tillåtna fukttillstånd för material vars eget gränsvärde
        inte är väl undersökt, och det är det talet verktyget jämför med.
      </p>

      <Pennstreck id="sovrummet-i-januari" niva={3}>Sovrummet i januari</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        Två personer sover i ett rum på 20 grader, och hygrometern visar 50 procent. Då ligger daggpunkten på 9,3
        grader. Mitt på glaset i ett gammalt tvåglasfönster är det bara omkring 5 grader en natt med 20
        minusgrader, så kondensen på insidan av fönstret är given. De 5 graderna har jag räknat fram utifrån
        Energimyndighetens U-värde för ett vanligt tvåglasfönster och standardformeln för glasets temperatur, med
        21 grader inne. I sovrummet på 20 grader blir glaset lite kallare än så.
        <a href="/fukt/kondens-pa-fonster/" class={LANK_KLASS}>Tabellen med fler fönster och utetemperaturer</a>
        visar hela uträkningen. Nästa kandidat är ytterväggen bakom garderoben, för där står luften stilla
        och väggen är några grader kallare än rummet. Det du ska göra är att vädra kort med genomdrag morgon och
        kväll. Uteluft på några minusgrader bär nästan inget vatten alls, och när den värmts upp inne är den torrare
        än luften den bytte ut. Dra ut garderoben några centimeter från väggen medan du ändå håller på.
      </p>

      <Pennstreck id="kallaren-i-augusti" niva={3}>Källaren i augusti</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        Här vänder allt, och det här är det som förvånar de flesta. Källarluften håller kanske 18 grader och
        väggarna mot marken ligger på 12. Uteluften i augusti är varm och full av vatten, och det vattnet följer
        med in genom det öppna källarfönstret och fälls ut på den kalla väggen. Så ju mer du vädrar, desto blötare
        blir källaren. Stäng fönstret, ställ in en avfuktare och låt den gå på hygrostat, så startar den själv när
        luften blir för fuktig. Kommer fukten upp genom golvet i stället är det dräneringen som är
        problemet, och då hjälper ingen maskin i längden.
      </p>

      <Pennstreck id="garaget" niva={3}>Garaget</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        Ett ouppvärmt garage följer uteluften med ungefär ett dygns fördröjning, och det är fördröjningen som
        ställer till det. En vårdag när vädret slår om från kallt till milt ligger betongplattan kvar på gårdagens
        temperatur. Daggpunkten i den nya, mildare luften hamnar över plattans temperatur, och då står det vatten
        på golvet fast taket är helt. Samma sak händer när du kör in en blöt bil. Ventilera när det är kallare ute
        än inne, aldrig tvärtom, och ha verktygen på en hylla i stället för direkt på betongen.
      </p>
    </section>

    {
      lasVidare.length > 0 && (
        <section>
          <Pennstreck id="las-vidare">Läs vidare</Pennstreck>
          <Artikelrutnat kort={lasVidare} kolumner={4} visaBeskrivning={false} visaMeta={false} />
        </section>
      )
    }

    <div class="max-w-lasbredd">
      <Faq fragor={FRAGOR} />
    </div>
  </Fragment>
</Raknarsida>
