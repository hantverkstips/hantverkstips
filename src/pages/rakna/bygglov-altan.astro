---
/**
 * Behöver altanen bygglov? Formuläret skickas som GET till samma sida och
 * bedömningen sker på servern, så sidan fungerar utan ett enda byte klient-JS.
 * Kostnaden är en serverfunktion per anrop, och den hålls nere med CDN-cache.
 * Se docs/SPEC-SIDMALLAR.md avsnitt 4.7.
 *
 * Reglerna och alla lagrum ligger i src/lib/kalkyl/bygglov-altan.ts. Sidan
 * bedömer ingenting själv, den visar bara svaret och redovisar paragrafen
 * bakom varje rad.
 *
 * Verktyget pekar inte ut någon produkt, så sidan har varken produktkort eller
 * reklamband. Svaret är vägledning, inte ett myndighetsbeslut.
 */
export const prerender = false;

import { formateraTal } from '../../lib/format';
import { artikelUrl, publicerade } from '../../lib/innehall';
import { tillKortArtikel, type KortData } from '../../lib/kort';
import { hittaKalkylator } from '../../lib/kalkyl/register';
import { arPelare } from '../../lib/pelare';
import {
  GRANS_M,
  HOJD_NARA_BYGGNAD_M,
  LOVFRI_TILLBYGGNAD_KVM,
  NARA_BYGGNAD_M,
  PRISBASBELOPP_KR,
  RAD_KOMMUNEN,
  raknaBygglovAltan,
  REGLERNA_GALLER_FRAN,
  STANDARD,
  tolkaQuery,
  type BygglovAltanIndata,
  type BygglovAltanResultat,
  type Utfall,
} from '../../lib/kalkyl/bygglov-altan';
import { delbarQuery, STANDARD as STANDARD_GM } from '../../lib/kalkyl/grannemedgivande';
import { delbarQuery as kontrollplanQuery, franBygglovAltan } from '../../lib/kalkyl/kontrollplan';
import { CELL_KLASS, LANK_KLASS } from '../../lib/kalkyl/stil';
import { verktygsillustration } from '../../lib/verktygsbild';
import BygglovAltanForm from '../../components/kalkyl/BygglovAltanForm.astro';
import Artikelrutnat from '../../components/ui/Artikelrutnat.astro';
import Faq from '../../components/ui/Faq.astro';
import Pennstreck from '../../components/ui/Pennstreck.astro';
import Statusrad from '../../components/ui/Statusrad.astro';
import Tabellyta from '../../components/ui/Tabellyta.astro';
import Illustration from '../../components/ui/Illustration.astro';
import Raknarsida from '../../components/vyer/Raknarsida.astro';

Astro.locals.sidtyp = 'verktyg';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

const q = Astro.url.searchParams;
const { indata } = tolkaQuery(q);
const resultat = raknaBygglovAltan(indata);

const fel = resultat.status === 'ogiltig' ? resultat.fel : {};
// Vid ogiltig indata visas standardvärdenas svar, med en rad som säger det.
const visat: BygglovAltanResultat = resultat.status === 'ogiltig' ? raknaBygglovAltan(STANDARD) : resultat;
const visatIndata: BygglovAltanIndata = resultat.status === 'ogiltig' ? STANDARD : indata;

const komma = (n: number) => String(n).replace('.', ',');
/** Tal i löptext: heltal utan decimal, annars en. "20 kvm", "0,8 m". */
const talText = (n: number) => formateraTal(n, Number.isInteger(n) ? 0 : 1);

/**
 * Fältens värden kommer från query-strängen som den skrevs, inte från de
 * tolkade talen: "en meter" eller "" blir NaN i tolkaQuery, och NaN i ett fält
 * som läsaren ska rätta är obrukbart.
 */
function faltVarde(nyckel: string, standardVarde: number): string {
  const ra = q.get(nyckel);
  if (ra !== null) return ra;
  return komma(standardVarde);
}

const varden = {
  hojd: faltVarde('hojd', STANDARD.hojdM),
  avstand: faltVarde('avstand', STANDARD.avstandByggnadM),
  grans: faltVarde('grans', STANDARD.avstandGransM),
  yta: faltVarde('yta', STANDARD.ytaKvm),
};

/**
 * Delbar länk. Hela frågan ligger redan i query-strängen, så adressen är
 * svaret. Den byggs av de tolkade värdena, inte av strängen läsaren skrev.
 */
const delaQuery = new URLSearchParams({
  plan: visatIndata.detaljplan,
  hojd: komma(visatIndata.hojdM),
  avstand: komma(visatIndata.avstandByggnadM),
  grans: komma(visatIndata.avstandGransM),
  tak: visatIndata.tak,
  patak: visatIndata.paTak ? 'ja' : 'nej',
  yta: komma(visatIndata.ytaKvm),
  vardefullt: visatIndata.vardefullt,
});
const delaLank = new URL(`/rakna/bygglov-altan/?${delaQuery.toString()}`, Astro.site ?? Astro.url).toString();

/**
 * Länken under regeln med utfallet "granne": altanen med tak är en
 * tillbyggnad, och grannemedgivandet får ytan, avståndet och planen, så att
 * läsaren landar på blanketten med sina mått förtryckta. Vid "vet inte" om
 * detaljplanen utelämnas planen, och grannemedgivandet tar sin standard.
 * Specen: docs/briefer/spec-kalkyl-grannemedgivande-2026-09-28.md avsnitt 11.2.
 */
const grannemedgivandeHref =
  '/rakna/grannemedgivande/?' +
  delbarQuery({
    ...STANDARD_GM,
    atgard: 'tillbyggnad',
    areaKvm: visatIndata.ytaKvm,
    gransM: visatIndata.avstandGransM,
    ...(visatIndata.detaljplan === 'vet-inte' ? {} : { plan: visatIndata.detaljplan }),
  }).toString();

/**
 * Svaret i två delar: ordet i stort format och resten på raden under, som
 * enheten står efter talet på de andra kalkylatorerna.
 */
const [svarOrd, svarRest] = visat.status === 'ok' ? visat.svarRubrik.split(', ') : ['', ''];

/** Etiketten över varje regel, så att raden går att skumma. */
const UTFALL_ETIKETT: Record<Utfall, string> = {
  ja: 'Bygglov',
  nej: 'Klarar sig utan lov',
  kanske: 'Osäkert',
  granne: 'Grannens underskrift',
};

/** Metaraden under svaret, skriven så att noll meter inte står som ett mått. */
const avstandText =
  visatIndata.avstandByggnadM === 0
    ? 'och altanen står mot husväggen'
    : `och den står ${talText(visatIndata.avstandByggnadM)} m från närmaste byggnad`;

/**
 * Metaraden om taket, en hel verbfras efter "och altanen" (specen 12.1).
 * Korrekturen underkände "altanen är med skärmtak".
 */
const TAK_FRAS = {
  vaggar: 'har väggar eller glas runt om',
  skarmtak: 'har skärmtak',
  patak: 'ligger ovanpå en byggnad',
  nej: 'är öppen, utan tak',
};
const takFras =
  visatIndata.tak === 'vaggar'
    ? TAK_FRAS.vaggar
    : visatIndata.tak === 'skarmtak'
      ? TAK_FRAS.skarmtak
      : visatIndata.paTak
        ? TAK_FRAS.patak
        : TAK_FRAS.nej;

/*
 * Beskedsräknare: vid ogiltigt värde visar spalten bara varningen och den
 * delbara adressen, inget svar, ingen avgift och inga regler (specen 12.8).
 * Talräknarna behåller standardvarningen. Varningen är likadan på alla
 * beskedsräknare och säger att svaret kommer när fältet är rättat.
 */
const BESKEDSVARNING = 'Ett av fälten gick inte att läsa. Rätta värdet där felet står, så visar jag svaret.';
const ogiltig = resultat.status === 'ogiltig';

/* Raden i spalten när grannen måste skriva under (specen 12.1): en mening med verb, och länken till blanketten. */
const SPALT_GRANNE = 'Grannen måste skriva under innan du bygger, annars behöver altanen bygglov.';
const SPALT_GRANNE_LANK = 'Skriv ut medgivandet med dina mått';
/*
 * Länken till kontrollplansgeneratorn i spalten (specen för kontrollplanen 16.2
 * K22, SEO B1). Visas bara när det sammanvägda svaret är ja eller kanske, aldrig
 * vid nej. Ska innehålla ordet kontrollplan.
 */
const KONTROLLPLAN_LANK = 'Skriv ut en kontrollplan för altanen till bygglovet';
/*
 * Adressen till kontrollplanen med de värden läsaren redan gett, för de nycklar
 * kontrollplanen har (läsarens retur varv 2, specen för kontrollplanen 16.7):
 * skärmtak blir tak=skarmtak, väggar eller glas gör altanen till en tillbyggnad,
 * vardefullt=ja följer med. Altanen räknas som vid huset bara när den ligger an
 * mot en byggnad, avstånd 0 (plac: visatIndata.avstandByggnadM === 0 ?
 * 'vid-huset' : 'fristaende'); en altan några meter bort är fristående för
 * räckets krav, även om den är nära nog för bygglovsregeln. Mappningen står i
 * franBygglovAltan i kontrollplanens modul och testas där.
 */
const kontrollplanHref = `/rakna/kontrollplan/?${kontrollplanQuery(franBygglovAltan(visatIndata))}`;

const PLANTEXT: Record<BygglovAltanIndata['detaljplan'], string> = {
  ja: 'inom detaljplan',
  nej: 'utanför detaljplan',
  'vet-inte': 'svaret för båda fallen',
};

const titel = 'Behöver altanen bygglov? Svar med lagrum';

/** Reglerna i tabellen under "Så bedömer vi". Samma tal som konstanterna i modulen. */
const antaganden: { storhet: string; varde: string; grund: 'Källa' | 'Antagande'; stod: string; url?: string }[] = [
  {
    storhet: 'Höjd inom 3,6 m från en byggnad',
    varde: 'lov över 1,8 m',
    grund: 'Källa',
    stod: 'Plan- och bygglagen 9 kap. 19 §, i lydelse efter lag 2025:974',
    url: 'https://svenskforfattningssamling.se/doc/2025974.html',
  },
  {
    storhet: 'Höjd längre bort än 3,6 m',
    varde: 'lov över 1,2 m',
    grund: 'Källa',
    stod: 'Plan- och bygglagen 9 kap. 19 §. Lagen säger en byggnad, så garaget räknas också',
    url: 'https://www.riksdagen.se/sv/dokument-och-lagar/dokument/svensk-forfattningssamling/plan-och-bygglag-2010900_sfs-2010-900/',
  },
  {
    storhet: 'Utanför detaljplan',
    varde: 'inga mått alls',
    grund: 'Källa',
    stod: 'Myndigheten Boverket, mur, plank, altan och annat',
    url: 'https://www.boverket.se/sv/byggande/bygglov-rivningslov-marklov-och-anmalan/vad-far-jag-bygga-utan-bygglov/mur-plank-altan-och-annat/',
  },
  {
    storhet: 'Avstånd till tomtgränsen',
    varde: 'utan tak inget krav, med tak grannens skriftliga ja under 4,5 m',
    grund: 'Källa',
    stod: 'Plan- och bygglagen 9 kap. 34 och 35 §§ räknar upp tillbyggnader, murar och plank men inte altaner, och regeringen lämnade altanerna utanför med avsikt, prop. 2024/25:169 s. 162',
    url: 'https://www.riksdagen.se/sv/dokument-och-lagar/dokument/svensk-forfattningssamling/plan-och-bygglag-2010900_sfs-2010-900/',
  },
  {
    storhet: 'Tak, väggar eller inglasning',
    varde: 'lovfri tillbyggnad upp till 30 kvm',
    grund: 'Källa',
    stod: 'Plan- och bygglagen 9 kap. 10 §. Gränsen gäller alla lovfria tillbyggnader på huset tillsammans',
    url: 'https://svenskforfattningssamling.se/doc/2025974.html',
  },
  {
    storhet: 'Altan ovanpå en byggnad',
    varde: 'räkna med bygglov',
    grund: 'Källa',
    stod: 'Mark- och miljööverdomstolen, mål P 5608-13, som såg altanen på taket som en ändring av fasaden',
  },
  {
    storhet: 'Värdefullt hus eller område',
    varde: 'lov även för det som annars är fritt',
    grund: 'Källa',
    stod: 'Plan- och bygglagen 9 kap. 37 och 38 §§',
    url: 'https://lagen.nu/2010:900',
  },
  {
    storhet: 'Byggsanktionsavgift för altan',
    varde: '0,25 prisbasbelopp plus 0,005 per kvm',
    grund: 'Källa',
    stod: 'Plan- och byggförordningen 9 kap. 12 §',
    url: 'https://lagen.nu/2011:338',
  },
  {
    storhet: 'Prisbasbelopp 2026',
    varde: '59 200 kr',
    grund: 'Källa',
    stod: 'Regeringen, prisbasbelopp för 2026 fastställt',
    url: 'https://www.regeringen.se/pressmeddelanden/2025/09/prisbasbelopp-for-2026-faststallt/',
  },
  {
    storhet: 'Nedsättning och bortfall',
    varde: 'hälften, en fjärdedel eller ingen avgift',
    grund: 'Källa',
    stod: 'Plan- och bygglagen 11 kap. 51 till 58 §§. Ingen avgift om du rättar innan nämnden tagit upp ärendet',
    url: 'https://lagen.nu/2010:900',
  },
  {
    storhet: 'Ingen anmälan för altan',
    varde: 'varken anmälan eller startbesked',
    grund: 'Källa',
    stod: 'Plan- och byggförordningen 6 kap. 1 §',
    url: 'https://lagen.nu/2011:338',
  },
  {
    storhet: 'Huset jag räknar på',
    varde: 'en- eller tvåbostadshus',
    grund: 'Antagande',
    stod: 'Villa, parhus eller radhus med egen tomt. Bara vid ett sådant hus får en lovfri tillbyggnad strida mot detaljplanen, till exempel stå på prickmark, enligt 10 kap. 2 a §',
  },
  {
    storhet: 'Räcket ovanpå altanen',
    varde: 'glest räcke räknas inte',
    grund: 'Antagande',
    stod: 'Ett tätt plank räknas in i höjden. Länsstyrelsens handläggarstöd räknar ett räcke som plank över cirka 1,1 m när mindre än hälften är luft',
  },
];

/**
 * Frågorna sist på sidan. Måtten läses ur samma konstanter som bedömningen, så
 * att en lagändring bara behöver rättas på ett ställe.
 */
const FRAGOR = [
  {
    fraga: 'Behöver jag bygglov för altan?',
    svar: `Inom detaljplan slipper du bygglov när golvet ligger högst ${komma(HOJD_NARA_BYGGNAD_M)} meter över marken och altanen står nära en byggnad. Nära betyder inom ${komma(NARA_BYGGNAD_M)} meter, mätt från fasaden till altanens ytterkant. Står den längre bort sjunker gränsen till 1,2 meter. Utanför detaljplan finns inga mått alls, men altanen ska passa in i omgivningen och får inte störa grannarna för mycket. Sätter du tak, väggar eller glas på den är det ingen altan längre i lagens mening utan en tillbyggnad, och då är det ytan som räknas.`,
  },
  {
    fraga: 'Vad ändrades med den nya bygglagen?',
    svar: 'Lag 2025:974 trädde i kraft, och hela bygglovskapitlet i plan- och bygglagen byttes ut. Altanregeln står nu i 9 kap. 19 § och är skriven tvärtom mot den gamla, som en regel om när lov krävs i stället för som ett undantag. Orden friggebod, attefallshus och attefallsaltan är borta ur lagtexten, och med dem försvann kravet på anmälan och startbesked för det som är lovfritt. Måtten är oförändrade, så en altan som var fri förut är fri nu också.',
    lank: { text: 'Hela genomgången står i artikeln om bygglov för altan.', href: '/altan/bygglov-altan/' },
  },
  {
    fraga: 'Måste jag anmäla altanen eller vänta på startbesked?',
    svar: `Nej, inte längre. Före lagändringen skulle en lovfri altan på över 1,2 meter anmälas, och du fick inte börja bygga förrän kommunen gett ett startbesked. Den regeln försvann, så du behöver varken lov, anmälan eller startbesked när måtten håller sig under gränserna. Många sidor på nätet säger fortfarande att du måste anmäla. Titta på datumet innan du litar på dem.`,
  },
  {
    fraga: 'Hur nära tomtgränsen får altanen ligga?',
    svar: `Altanen får ligga närmare än ${komma(GRANS_M)} meter utan grannens medgivande, så länge den är öppen. Höjden spelar in för bygglovet men inte för medgivandet. Lagen räknar upp vad som kräver medgivande nära gränsen, och altaner är inte med. Med skärmtak eller inglasning är altanen en tillbyggnad, och då behöver du grannens skriftliga medgivande eller bygglov. Ett tätt plank som är högre än 1,2 meter över marken kräver också medgivande. Går gränsen mot en gata eller en park skriver kommunen under, eller vägföreningen om det är den som sköter gatan.`,
  },
];

/** Slug, namn och beskrivning på ett ställe: brödsmulan, og:image och WebApplication läser samma. */
const SLUG = 'bygglov-altan';
const VERKTYGSNAMN = 'Bygglov för altan';
const BESKRIVNING =
  'Fyll i höjd, avstånd och detaljplan, så får du veta om altanen behöver bygglov. Varje svar har sin paragraf, och du ser vad ett bygge utan lov kostar.';
/** Skissen står i kortet Så bedömer jag. Huvudet har ingen bild sedan fas C (DESIGN.md 5.8). */
const illustration = verktygsillustration(SLUG);

/*
 * Svarsytan, fas C (spec-designlyft-c-2026-10-02 avsnitt 13). Svaret är ett
 * ord, och statusraden bär sidans befintliga besked: ok när altanen slipper
 * bygglov, varning när lov, kommunens prövning eller grannens underskrift
 * krävs. Beskedet är meningen ur den förra Kort svar-rutan.
 */
const statusText =
  visat.status === 'ok'
    ? visat.svar === 'granne'
      ? SPALT_GRANNE
      : `Måtten som står i formuläret ger svaret ${visat.svarRubrik.toLowerCase()}.`
    : '';

/**
 * Paragrafen bakom svaret: den första regeln vars utfall är det sammanvägda
 * svaret, i den första bedömning som har en sådan.
 */
const avgorande =
  visat.status === 'ok'
    ? (visat.bedomningar.flatMap((b) => b.regler).find((r) => r.utfall === visat.svar) ??
      visat.bedomningar[0]?.regler[0])
    : undefined;

/*
 * Ny text är hantverkarens. Klartexten har platshållarna {svar} (svaret som
 * rubrik, "Nej, du slipper bygglov"), {hojd} (golvets höjd, m), {avstand}
 * (avståndet till närmaste byggnad, m), {plan} ("inom detaljplan",
 * "utanför detaljplan" eller "svaret för båda fallen") och {lagrum}
 * (paragrafen bakom svaret).
 */
const KLARTEXT =
  'Med golvet {hojd} m över marken och {avstand} m till närmaste byggnad blir svaret ”{svar}”, enligt reglerna i plan- och bygglagens nionde kapitel.'; // bygglov-altan.klartext
const klartext =
  visat.status === 'ok'
    ? KLARTEXT.replace('{svar}', visat.svarRubrik)
        .replace('{hojd}', talText(visatIndata.hojdM))
        .replace('{avstand}', talText(visatIndata.avstandByggnadM))
        .replace('{plan}', PLANTEXT[visatIndata.detaljplan])
        .replace('{lagrum}', avgorande?.lagrum ?? '')
    : '';

/**
 * Läs vidare: artiklarna som artikelkort, räknarna med registrets namn som på
 * hubben. En adress som varken är en artikel eller en räknare står kvar som
 * länk under korten, med den förra listans text.
 */
const LAS_VIDARE = [
  { href: '/altan/bygglov-altan/', text: 'Bygglov för altan, måtten som avgör och vad ett svartbygge kostar' },
  { href: '/guider/altan/', text: 'Alla guider om altanbygget, från plint till trall' },
];
const artiklar = [...(await publicerade('guider')), ...(await publicerade('kunskap'))];
const lasVidare: KortData[] = [];
const lasVidareLankar: { href: string; text: string }[] = [];
for (const l of LAS_VIDARE) {
  const e = artiklar.find((a) => artikelUrl(a) === l.href);
  if (e) {
    const { niva: _niva, ...kort } = tillKortArtikel(e);
    lasVidare.push(kort);
    continue;
  }
  const k = hittaKalkylator(l.href.replace(/^\/rakna\/|\/$/g, ''));
  const pelare = k?.pelare?.[0];
  if (k && pelare && arPelare(pelare)) {
    lasVidare.push({
      etikett: 'Räkna själv',
      rubrik: k.namn,
      beskrivning: k.rad,
      pelare,
      href: l.href,
      // Artikelrutnat läser inte typen; kortet står varken i ett typfilter eller sorteras.
      typ: 'kunskap',
      sorteringsdatum: new Date(0),
    });
    continue;
  }
  lasVidareLankar.push(l);
}
---

<Raknarsida
  slug={SLUG}
  namn={VERKTYGSNAMN}
  titel={titel}
  beskrivning={BESKRIVNING}
  rubrik="Behöver din altan bygglov? Fyll i måtten och få svar"
  delaUrl={ogiltig ? undefined : delaLank}
  saRaknarRubrik="Så bedömer jag"
  saRaknarId="sa-bedomer-vi"
>
  <p slot="ingress">
    Två mått avgör om du får bygga altanen utan bygglov: hur högt golvet ligger över marken, med gränsen vid
    1,8 meter, och om altanen står inom 3,6 meter från huset. Fyll i dem, så svarar jag ja, nej eller kanske,
    och skriver ut paragrafen bakom varje rad. Paragrafen är ny, så en hel del av det som står på nätet är fel
    i dag. Svaret här är vägledning, och det är byggnadsnämnden i din kommun
    som fattar beslutet.
  </p>

  {/* Formuläret ligger i src/components/kalkyl/BygglovAltanForm.astro, så att
      <Kalkylator namn="bygglov-altan" /> i artikeln visar exakt samma fält. */}
  <BygglovAltanForm slot="formular" indata={indata} varden={varden} fel={fel} />

  <Fragment slot="svar">
    {/* Beskedsräknare: vid ogiltigt värde står bara varningen, inget svar (specen 12.8). */}
    {ogiltig && <p class="text-liten text-varning">{BESKEDSVARNING}</p>}
    {
      visat.status === 'ok' && !ogiltig && (
        <>
          {/* Svaret är ett ord: det står i Zilla Slab i stället för det stora talet. */}
          <div>
            <p class="text-liten text-blyerts-2">
              Altan på {talText(visatIndata.ytaKvm)} kvm, {PLANTEXT[visatIndata.detaljplan]}
            </p>
            <p class="flex flex-wrap items-baseline gap-x-2 text-blyerts">
              <span class="font-serif text-h2">{svarOrd}</span>
              <span class="text-brod">{svarRest}</span>
            </p>
          </div>
          <div class="text-liten text-blyerts-2">
            <p>Golvet ligger {talText(visatIndata.hojdM)} m över marken, {avstandText}.</p>
            <p>Det är {talText(visatIndata.avstandGransM)} m till tomtgränsen, och altanen {takFras}.</p>
          </div>
          <div class="text-brod">
            <Statusrad ton={visat.svar === 'nej' ? 'ok' : 'varning'} text={statusText} />
            {avgorande && <p class="mt-1! text-liten text-blyerts-2">{avgorande.lagrum}</p>}
          </div>
          {visat.kravGrannmedgivande && (
            <p class="text-brod">
              {visat.svar !== 'granne' && <>{SPALT_GRANNE} </>}
              <a href={grannemedgivandeHref} class:list={['inline-flex min-h-11 items-center', LANK_KLASS]}>
                {SPALT_GRANNE_LANK}
              </a>
            </p>
          )}
          <div class="border-t border-linje pt-4">
            <p class="text-etikett lg:text-etikett-lg uppercase text-blyerts-2">Om lov krävs och du bygger ändå</p>
            <p class="mt-1! flex flex-wrap items-baseline gap-x-2">
              <span class="font-serif text-h3 lg:text-h3-lg text-blyerts tabular-nums">
                {formateraTal(visat.avgiftKr)}
              </span>
              <span class="text-brod">kr i byggsanktionsavgift</span>
            </p>
            <p class="mt-1! text-liten text-blyerts-2">
              Det är {formateraTal(visat.avgiftGrundKr)} kr i grunden plus {formateraTal(visat.avgiftTillaggKr)}{' '}
              kr för ytan, räknat på prisbasbeloppet {formateraTal(PRISBASBELOPP_KR)} kr.
            </p>
          </div>
          {(visat.svar === 'ja' || visat.svar === 'kanske') && (
            <p>
              <a href={kontrollplanHref} class:list={['inline-flex min-h-11 items-center', LANK_KLASS]}>
                {KONTROLLPLAN_LANK}
              </a>
            </p>
          )}
          <p class="text-liten text-blyerts">{klartext}</p>
        </>
      )
    }
  </Fragment>

  {
    visat.status === 'ok' && !ogiltig && (
      <Fragment slot="darfor">
        <Pennstreck id="darfor-blev-svaret-sa" utanLuft>
          Därför blev svaret så
        </Pennstreck>
        {visat.bedomningar.map((b) => (
          <>
            {visat.bedomningar.length > 1 && (
              <p class="m-0 mt-6 font-sans text-h3 lg:text-h3-lg text-blyerts">
                {b.fall}:{' '}
                {b.svar === 'ja'
                  ? 'bygglov'
                  : b.svar === 'nej'
                    ? 'inget bygglov'
                    : b.svar === 'granne'
                      ? 'grannens underskrift eller bygglov'
                      : 'fråga kommunen'}
              </p>
            )}
            <div class="darfor">
              {b.regler.map((regel) => (
                <div>
                  <span class="block text-etikett lg:text-etikett-lg uppercase text-blyerts-2">
                    {UTFALL_ETIKETT[regel.utfall]}
                  </span>
                  <p>{regel.text}</p>
                  <p>{regel.lagrum}</p>
                  {regel.utfall === 'granne' && (
                    <a href={grannemedgivandeHref} class:list={['inline-flex min-h-11 items-center', LANK_KLASS]}>
                      {/* Länken till blanketten med altanens mått förtryckta. */}
                      Skriv ut medgivandet till grannen med dina mått ifyllda
                    </a>
                  )}
                </div>
              ))}
            </div>
          </>
        ))}
        <p class="m-0 mt-4">{RAD_KOMMUNEN}</p>
        <p class="m-0 mt-2 text-liten text-blyerts-2">
          Reglerna gäller sedan den {REGLERNA_GALLER_FRAN}, då lag 2025:974 trädde i kraft.
        </p>
      </Fragment>
    )
  }

  {
    visat.status === 'ok' && !ogiltig && visat.gorInteDetHar.length > 0 && (
      <Fragment slot="gorInte">
        {/* Flera råd står i samma stycke efter "Gör inte det här.", vart och ett på egen rad. */}
        {visat.gorInteDetHar.map((rad, i) => (
          <span class:list={[i > 0 && 'mt-3 block']}>{rad}</span>
        ))}
      </Fragment>
    )
  }

  <Fragment slot="saRaknarJag">
    {
      illustration && (
        <div class="pappersruta">
          <Illustration
            namn="rakna/bygglov-altan"
            alt="Hus i sidovy med en altan på plintar, måttsatt 1,8 m upp från marken, 3,6 m ut från fasaden och 4,5 m till tomtgränsen"
            bildtext="Bygglovet hänger på två mått, höjden över marken och avståndet till huset. Avståndet till tomtgränsen spelar bara in med tak, glas eller ett tätt plank."
            class="my-0!"
          />
        </div>
      )
    }
    <ol class="m-0 mt-4 pl-6 list-decimal text-brod">
      <li class="mb-2">
        Ligger tomten inom detaljplan prövas höjden mot avståndet till närmaste byggnad. Inom{' '}
        {komma(NARA_BYGGNAD_M)}&nbsp;meter gäller den högre gränsen, längre bort den lägre.
      </li>
      <li class="mb-2">
        Ligger tomten utanför detaljplan finns ingen måttregel, och höjden spelar då ingen roll för lovplikten.
      </li>
      <li class="mb-2">
        Vet du inte vilket som gäller kör jag båda fallen och visar svaret för vart och ett.
      </li>
      <li class="mb-2">
        {/* Ska säga att skärmtak, väggar och inglasning alla gör altanen till en tillbyggnad (9 kap. 10 §, öppenarea), och att ytan då prövas mot 30 m² (specen 12.7). */}
        Altanen blir en tillbyggnad oavsett om den får skärmtak, väggar eller inglasning, eftersom ytan under
        taket räknas med. Då prövas ytan mot {LOVFRI_TILLBYGGNAD_KVM}&nbsp;m² i stället för höjden.
      </li>
      <li class="mb-2">
        En altan ovanpå en byggnad får svaret räkna med bygglov, eftersom golvet nästan alltid ligger högt och
        takaltanen har bedömts som en ändring av fasaden.
      </li>
      <li class="mb-2">
        Ett utpekat värdefullt hus eller område kräver lov även för det som annars är fritt, och det lyfter svaret
        oavsett vad måtten säger.
      </li>
      <li class="mb-2">
        {/* Ska säga att avståndet prövas sist av reglerna, och nämna svaret granne (specen 12.7). */}
        Avståndet till tomtgränsen prövar jag efter de andra reglerna. Står en altan med tak närmare gränsen än{' '}
        {komma(GRANS_M)}&nbsp;meter och kräver inget annat lov, blir svaret att grannen ska skriva under, och utan
        underskriften krävs bygglov.
      </li>
      <li>
        Byggsanktionsavgiften räknas sist, ur altanens yta, och visas oavsett vad svaret blev. Den är vad ett bygge
        utan lov kostar om lov skulle ha sökts.
      </li>
    </ol>
  </Fragment>

  <Fragment slot="efter">
    {/* Antagandetabellen i läsbredd, ur kortet Så bedömer jag (spec-designlyft-c avsnitt 9). */}
    <section class="max-w-lasbredd">
      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">Vad siffrorna vilar på</h3>
      <Tabellyta kolumner={3} class="mt-4">
        <table class="w-full border-collapse text-liten tabular-nums">
          <caption class="sr-only">Regler, lagrum och antaganden i bygglovsverktyget för altan</caption>
          <thead>
            <tr class="border-b border-linje text-left">
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Vad</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Jag går på</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Källa eller antagande</th>
            </tr>
          </thead>
          <tbody>
            {
              antaganden.map((a) => (
                <tr>
                  <th scope="row" class:list={[CELL_KLASS, 'text-left font-normal']}>
                    {a.storhet}
                  </th>
                  <td class={CELL_KLASS}>{a.varde}</td>
                  <td class={CELL_KLASS}>
                    {a.grund}.{' '}
                    {a.url ? (
                      <a href={a.url} rel={a.url.startsWith('/') ? undefined : 'nofollow'} class={LANK_KLASS}>
                        {a.stod}
                      </a>
                    ) : (
                      a.stod
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </Tabellyta>

      <p class="m-0 mt-6 text-brod lg:text-brod-lg">
        Jag läser lagen och Boverkets vägledning på de uppgifter du fyller i, och det är vägledning. Din detaljplan,
        dina områdesbestämmelser och ett strandskydd vid vattnet ser jag inte härifrån. Avgiften jag räknar ut är
        byggsanktionsavgiften, och bygglovsavgiften i efterhand tillkommer.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Avgiften är ett kvarts prisbasbelopp i grunden, plus en halv hundradel av prisbasbeloppet per kvadratmeter
        altan. Prisbasbeloppet för 2026 är {formateraTal(PRISBASBELOPP_KR)}&nbsp;kr, och det fastställer regeringen
        om året. Ändras talet till nästa år ändras avgiften med det.
      </p>
      {
        visat.status === 'ok' && !ogiltig && (
          <p class="m-0 mt-4 text-brod lg:text-brod-lg">
            Avgiften kan sättas ned till{' '}
            {formateraTal(visat.avgiftHalvKr)} kr eller {formateraTal(visat.avgiftFjardedelKr)} kr om den är orimlig,
            och den faller bort helt om du river altanen eller rättar felet innan nämnden tagit upp ärendet på ett sammanträde.
            Står altanen kvar får du ändå söka lov i efterhand.
          </p>
        )
      }
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Hur jag jobbar med tal och källor står på sidan{' '}
        <a href="/om/sa-testar-vi/" class={LANK_KLASS}>Så testar jag</a>.
      </p>
    </section>

    <section class="max-w-lasbredd">
      <Pennstreck id="bygglov-altan-2025">Bygglov för altan, de två måtten i plan- och bygglagen 9 kap. 19 § och vad som ändrades 1 december 2025</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        När lag 2025:974 trädde i kraft upphävdes hela bygglovskapitlet i plan- och bygglagen och ersattes av ett
        nytt. Paragrafen som alla hänvisade till förut, 9 kap. 4 f §, finns inte kvar. Altanregeln
        står nu i 9 kap. 19 §, och den är skriven tvärtom mot den gamla. I stället för ett undantag för villor är den
        en regel om när lov krävs inom detaljplan. Orden friggebod, attefallshus och attefallsaltan är borta ur
        lagtexten, och med dem försvann kravet på anmälan och startbesked för det som är lovfritt. En altan på plintar
        rör varken bärande delar, brandskydd eller installationer, så du behöver varken lov, anmälan eller startbesked
        när måtten håller.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Själva måtten är oförändrade, och de är två. Det första är höjden. Ligger altangolvet högst 1,8 meter över
        marken är altanen fri, förutsatt att den står nära en byggnad. Höjden mäter du från marken vid altanens
        yttersida upp till golvets ovansida, och sluttar tomten mäter du på nedsidan. Ett glest räcke räknas inte in,
        men ett tätt plank gör det.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Det andra måttet är avståndet till huset. Nära betyder inom 3,6 meter, mätt från fasaden till altanens
        ytterkant. Står altanen längre bort sjunker gränsen till 1,2 meter. Lagen säger en byggnad och inte
        bostadshuset, så en altan intill garaget eller förrådet räknas som nära den byggnaden.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Avståndet till tomtgränsen är ett tredje mått, men det spelar bara in när altanen får tak, glas eller ett tätt
        plank. Lagen räknar upp vad som kräver grannens medgivande närmare gränsen än 4,5 meter, och altaner saknas i
        listan. Regeringen bedömde att en altan nära gränsen inte påverkar omgivningen så mycket att den borde kräva
        grannens medgivande. Sätter du skärmtak eller glas över altanen blir den en tillbyggnad, och då behöver du
        grannens skriftliga medgivande eller bygglov. Ett tätt plank som är högre än 1,2 meter över marken kräver också
        medgivande, och står det på altanen räknas altanens höjd med. Boverkets sida för privatpersoner säger något
        annat om den öppna altanen, och varför jag går på lagen förklarar jag i{' '}
        <a href="/altan/bygglov-altan/" class={LANK_KLASS}>artikeln om bygglov för altan</a>.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Två saker faller utanför måtten. Sätter du tak, väggar eller glas på altanen är den inte längre en altan i
        lagens mening utan en tillbyggnad, och en tillbyggnad är fri upp till 30 kvadratmeter.
        Den gamla regeln om skärmtak på 15 kvadratmeter är borta. Ligger altanen ovanpå ett garage växer ingen volym,
        men golvet hamnar högt, och domstol har sett en takaltan som en ändring av fasaden. Räkna med lov där.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Vad ett bygge utan lov kostar ser du i spalten ovanför. Byggsanktionsavgiften för en altan är ett kvarts
        prisbasbelopp i grunden plus en halv hundradel av prisbasbeloppet per kvadratmeter, och den tas ut även om
        du inte visste bättre. Hela genomgången, med
        beslutstabellen och avgiften för olika ytor, står i{' '}
        <a href="/altan/bygglov-altan/" class={LANK_KLASS}>
          artikeln om bygglov för altan och måtten som avgör
        </a>
        .
      </p>
    </section>

    {
      (lasVidare.length > 0 || lasVidareLankar.length > 0) && (
        <section>
          <Pennstreck id="las-vidare">Läs vidare</Pennstreck>
          {lasVidare.length > 0 && (
            <Artikelrutnat kort={lasVidare} visaBeskrivning={false} visaMeta={false} />
          )}
          {lasVidareLankar.length > 0 && (
            <ul class="m-0 mt-4 p-0 list-none max-w-lasbredd">
              {lasVidareLankar.map((l) => (
                <li class="border-t border-linje">
                  <a href={l.href} class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
                    {l.text}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </section>
      )
    }

    <div class="max-w-lasbredd">
      <Faq fragor={FRAGOR} />
    </div>
  </Fragment>
</Raknarsida>
