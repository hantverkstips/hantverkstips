---
/**
 * Regel- och skruvräknaren för innervägg. Formuläret skickas som GET till samma
 * sida och beräkningen sker på servern, så sidan fungerar utan ett enda byte
 * klient-JS. Kostnaden är en serverfunktion per anrop, och den hålls nere med
 * CDN-cache. Se docs/SPEC-SIDMALLAR.md avsnitt 4.7.
 *
 * Formeln och alla antaganden ligger i src/lib/kalkyl/innervagg.ts. Sidan räknar
 * ingenting själv, den visar bara resultatet och redovisar källorna.
 *
 * Räkningen pekar ut två produktegenskaper, antalet skruv och skruvlängden, och
 * därför visas två produktkort efter resultatet. Sidan har då reklamband.
 */
export const prerender = false;

import Bas from '../../layouts/Bas.astro';
import { formateraTal } from '../../lib/format';
import {
  raknaInnervagg,
  SKIVA_BREDD_MM,
  SKIVA_HOJD_MM,
  SPILL_SKIVOR,
  SPILL_VIRKE,
  STANDARD,
  tolkaQuery,
  type InnervaggIndata,
  type InnervaggResultat,
} from '../../lib/kalkyl/innervagg';
import { CELL_KLASS, ETIKETT_KLASS, FALT_KLASS, LANK_KLASS } from '../../lib/kalkyl/stil';
import { hamtaButik } from '../../lib/produkter';
import { verktyg } from '../../lib/strukturdata';
import { verktygsDelningsbild, verktygsillustration, verktygsVarumarkesbild } from '../../lib/verktygsbild';
import InnervaggForm from '../../components/kalkyl/InnervaggForm.astro';
import Faktaruta from '../../components/ui/Faktaruta.astro';
import Faq from '../../components/ui/Faq.astro';
import Markering from '../../components/ui/Markering.astro';
import Pennstreck from '../../components/ui/Pennstreck.astro';
import Produktkort from '../../components/ui/Produktkort.astro';
import StrukturData from '../../components/ui/StrukturData.astro';
import Illustration from '../../components/ui/Illustration.astro';

Astro.locals.sidtyp = 'verktyg';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

const q = Astro.url.searchParams;
const { indata } = tolkaQuery(q);
const resultat = raknaInnervagg(indata);

const fel = resultat.status === 'ogiltig' ? resultat.fel : {};
// Vid ogiltig indata visas standardvärdenas resultat, med en rad som säger det.
const visat: InnervaggResultat = resultat.status === 'ogiltig' ? raknaInnervagg(STANDARD) : resultat;
const visatIndata: InnervaggIndata = resultat.status === 'ogiltig' ? STANDARD : indata;

const komma = (n: number) => String(n).replace('.', ',');
/** Tal i löptext: heltal utan decimal, annars en. "28 m", "2,5 m". */
const talText = (n: number) => formateraTal(n, Number.isInteger(n) ? 0 : 1);

/**
 * Fältens värden kommer från query-strängen som den skrevs, inte från de tolkade
 * talen: "fyra" eller "" blir NaN i tolkaQuery, och NaN i ett fält som läsaren
 * ska rätta är obrukbart.
 */
function faltVarde(nyckel: string, standardVarde: number): string {
  const ra = q.get(nyckel);
  if (ra !== null) return ra;
  return komma(standardVarde);
}

const varden = {
  langd: faltVarde('langd', STANDARD.langdM),
  hojd: faltVarde('hojd', STANDARD.hojdM),
  dorrar: faltVarde('dorrar', STANDARD.dorrar),
};

/**
 * Delbar länk. Hela tillståndet ligger redan i query-strängen, så adressen är
 * uträkningen. Den byggs av de tolkade värdena, inte av strängen läsaren skrev,
 * och regelavståndet skrivs alltid ut, även när det kom från standardvalet.
 */
const delaQuery = new URLSearchParams({
  langd: komma(visatIndata.langdM),
  hojd: komma(visatIndata.hojdM),
  regel: visatIndata.regel,
  lag: String(visatIndata.lag),
  cc: String(visatIndata.ccMm),
  dorrar: String(visatIndata.dorrar),
  ull: visatIndata.ull ? 'ja' : 'nej',
});
const delaLank = new URL(`/rakna/innervagg/?${delaQuery.toString()}`, Astro.site ?? Astro.url).toString();

const butik = await hamtaButik();

const regelText = visatIndata.regel === '45x70' ? '45 × 70 mm' : '45 × 95 mm';

/** Räkneord för de små talen, så att en mening kan börja utan siffra. */
const RAKNEORD = ['inget', 'ett', 'två', 'tre', 'fyra', 'fem', 'sex', 'sju', 'åtta', 'nio', 'tio'];
const rakneord = (n: number) => RAKNEORD[n] ?? formateraTal(n);

/** Tal ur resultatet, färdigformaterade, så att markupen nedan blir läsbar. */
const tal =
  visat.status === 'ok'
    ? {
        reglar: formateraTal(visat.antalReglar),
        reglarVagg: formateraTal(visat.antalReglarVagg),
        reglarDorr: formateraTal(visat.antalReglarDorr),
        kapLangd: formateraTal(visat.kapLangdM, 2),
        virke: formateraTal(visat.lopmeterVirke, 1),
        virkeMedSpill: formateraTal(visat.lopmeterVirkeMedSpill, 1),
        syllHammarband: talText(visat.syllHammarbandM),
        avvaxling: formateraTal(visat.avvaxlingM, 1),
        handelslangd: formateraTal(visat.handelslangdM, 1),
        antalLangder: formateraTal(visat.antalLangder),
        spill: formateraTal(visat.spillProcent, 0),
        skivor: formateraTal(visat.antalSkivor),
        skivorMedSpill: formateraTal(visat.antalSkivorMedSpill),
        skivyta: talText(visat.skivytaKvm),
        skruv: formateraTal(visat.antalSkruv),
        skruvAttKopa: formateraTal(visat.skruvAttKopa),
        pack: formateraTal(visat.antalPack),
        packOrd: rakneord(visat.antalPack),
        packRacker: formateraTal(visat.packRackerTillMeter, 0),
        ull: visat.ullKvm === null ? null : talText(visat.ullKvm),
        ullBredd: visat.ullBreddMm === null ? null : formateraTal(visat.ullBreddMm),
        langd: talText(visatIndata.langdM),
        hojd: talText(visatIndata.hojdM),
        cc: formateraTal(visatIndata.ccMm),
      }
    : null;

/** Raden på skruvkortet säger vad just den här räkningen behöver. */
const packRad =
  visat.status === 'ok' && tal
    ? `Räkningen behöver ${tal.packOrd} pack. Ett band räcker till ungefär ${tal.packRacker} löpmeter vägg.`
    : 'Ett band på 1 000 skruv räcker till ungefär 29 löpmeter vägg.';

const titel = 'Regelkalkylator, räkna reglar, gips och skruv till väggen';

/** Antagandena i tabellen under "Så räknar vi". Samma tal som konstanterna i kalkylen. */
const antaganden: { storhet: string; varde: string; grund: 'Källa' | 'Antagande'; stod: string; url?: string }[] = [
  {
    storhet: 'Gipsskivans format',
    varde: `${formateraTal(SKIVA_BREDD_MM)} × ${formateraTal(SKIVA_HOJD_MM)} mm, alltså 3 kvm`,
    grund: 'Källa',
    stod: 'Normalskivan i Norgips och Gyprocs system, 12,5 mm tjock',
    url: 'https://www.norgips.se/kunskapsbank/att-tanka-pa-innan-montering/',
  },
  {
    storhet: 'Regelavstånd vid ett lag gips',
    varde: 'c 400 mm',
    grund: 'Källa',
    stod: 'Svenskt Trä, för skivor som är 1 200 mm breda. Vid två lag med förskjutna skarvar anger de c 600 mm',
    url: 'https://www.byggbeskrivningar.se/renovering/bygga-innervagg/',
  },
  {
    storhet: 'Skruvavstånd, yttersta laget',
    varde: 'c 200 mm i kant, c 300 mm i fält',
    grund: 'Källa',
    stod: 'Norgips, och Svenskt Trä anger samma mått',
    url: 'https://www.norgips.se/kunskapsbank/bygga-vagg-med-stalreglar/',
  },
  {
    storhet: 'Skruvavstånd, innersta laget',
    varde: 'c 750 mm',
    grund: 'Källa',
    stod: 'Norgips, gäller en tvålagersvägg utan brandkrav',
    url: 'https://www.norgips.se/kunskapsbank/bygga-vagg-med-stalreglar/',
  },
  {
    storhet: 'Kapmån på reglarna',
    varde: '15 mm kortare än rumshöjden',
    grund: 'Källa',
    stod: 'Gyproc, för icke bärande träregelvägg',
    url: 'https://www.gyproc.se/gor-det-sjalv/bygga-innervagg-med-trastomme',
  },
  {
    storhet: 'Mineralullens bredd',
    varde: '455 mm vid c 450, 610 mm vid c 600',
    grund: 'Källa',
    stod: 'Norgips. För c 400 anger ingen tillverkare någon bredd, så då får du kapa',
    url: 'https://www.norgips.se/kunskapsbank/bygga-vagg-med-stalreglar/',
  },
  {
    storhet: 'Skruvlängd på träregel',
    varde: '41 mm vid ett lag, 45 eller 51 mm vid två',
    grund: 'Källa',
    stod: 'Vår gipsskruvguide, räknad ur Norgips tumregel om 20 mm ner i träet',
    url: '/inomhus/gipsskruv/',
  },
  {
    storhet: 'Dörröppningen',
    varde: '0,9 m bred',
    grund: 'Antagande',
    stod: 'Den vanligaste innerdörren. Öppningen får en regel på vardera sidan och en avväxling över, vilket Svenskt Trä anger',
  },
  {
    storhet: 'Spill på gipsskivor',
    varde: `${formateraTal(SPILL_SKIVOR * 100)} procent`,
    grund: 'Antagande',
    stod: 'Täcker kapade bitar vid tak, hörn och dörr. Vi drar inte av dörrhålet från skivytan, eftersom bitarna runt en öppning sällan blir hela',
  },
  {
    storhet: 'Spill på virke',
    varde: `${formateraTal(SPILL_VIRKE * 100)} procent`,
    grund: 'Antagande',
    stod: 'Täcker den skeva regeln som alltid ligger i högen. Innerväggsguiden lägger på tio procent, eftersom den räknar per löpmeter i stället för regel för regel',
  },
  {
    storhet: 'Handelslängder på reglar',
    varde: '2,4 till 4,8 m',
    grund: 'Antagande',
    stod: 'De längder byggvaruhusen vanligen lagerför i 45 × 70 och 45 × 95. Ingen publicerad standard',
  },
];

/**
 * Frågorna sist på sidan. Exemplen är desamma som i "Materialåtgång innervägg",
 * och påslagen är de som står i "Så räknar vi".
 */
const FRAGOR = [
  {
    fraga: 'Hur många reglar går det åt till en innervägg?',
    svar: 'Väggens längd delas med c-måttet, alltså avståndet mellan reglarnas mitt, och avrundas uppåt. Sedan läggs en regel till som stänger sista facket. Ta en vägg på fyra meter med reglar på c 600 mm: den får åtta reglar, och den sista står i väggänden. Varje dörröppning lägger till två reglar och en avväxling över öppningen.',
  },
  {
    fraga: 'Ska reglarna sitta på c 400 eller c 600 mm?',
    svar: 'Med två lag gips på varje sida räcker c 600 mm. Står du på ett lag väljer kalkylatorn c 400 mm åt dig, eftersom väggen annars ger efter mellan reglarna när någon lutar sig mot den. Branschorganisationen Svenskt Trä knyter det glesare måttet till dubbla skivlag med förskjutna skarvar, medan skivtillverkarna anger det för sina egna system utan det villkoret. Skillnaden mellan källorna är värd att veta innan du sågar.',
    lank: { text: 'Hela ordningen står i guiden om att bygga innervägg.', href: '/inomhus/bygga-innervagg/' },
  },
  {
    fraga: 'Hur mycket spill ska jag räkna med?',
    svar: 'Virket får ett påslag på fem procent, för den skeva regeln finns alltid i högen. Skivorna får tio procent, eftersom bitarna vid tak, hörn och dörr sällan blir hela. Därför drar kalkylatorn inte heller av dörrhålet från skivytan. Den föreslår dessutom den handelslängd som spiller minst när reglarna kapas, och det är ofta inte den längsta i hyllan.',
  },
];

/** Slug, namn och beskrivning på ett ställe: brödsmulan, og:image och WebApplication läser samma. */
const SLUG = 'innervagg';
const VERKTYGSNAMN = 'Regelkalkylator';
const BESKRIVNING =
  'Räkna reglar, gipsskivor, skruv och mineralull till innerväggen ur längd, höjd och regelavstånd. Materialåtgång med källa bakom varje tal.';
const illustration = verktygsillustration(SLUG);
/**
 * Varumärkesbilden i sidhuvudet, sedan 2026-09-19 (docs/DESIGN.md avsnitt 7).
 * Finns den står skissen i stället i "Så räknar vi", där måtten förklarar
 * räkningen. Finns den inte visas skissen i sidhuvudet som förut.
 */
const varumarke = verktygsVarumarkesbild(SLUG);
const huvudbild = varumarke ?? illustration;
---

<Bas
  title={titel}
  description={BESKRIVNING}
  reklam={true}
  butikNamn={butik?.namn}
  brodsmulor={[
    { namn: 'Hantverkstips', href: '/' },
    { namn: 'Räkna själv', href: '/rakna/' },
    { namn: VERKTYGSNAMN },
  ]}
  bred={true}
  ogBild={verktygsDelningsbild(SLUG)}
>
  <StrukturData
    slot="head"
    data={verktyg({ url: `/rakna/${SLUG}/`, namn: VERKTYGSNAMN, beskrivning: BESKRIVNING })}
  />

  <div class="mx-auto w-full max-w-lasbredd">
    {/*
      Sidhuvudet: rubrik och ingress till vänster i 7/12, bilden till höger i
      5/12 på desktop, under ingressen på mobil. Bilden är dekorativ, H1 bär
      betydelsen, därför tom alt. Den är sidans LCP-bild och laddas därför
      eagert med fetchpriority. Varumärkesbilden har transparent bakgrund och
      ligger som heron utan ram; skissen är ett urklipp och får ramen. Saknas
      båda visas ingen bild alls.
    */}
    <section class="grid grid-cols-1 items-center gap-6 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7">
        <h1 class="m-0 font-serif text-h1 lg:text-h1-lg">Räkna ut reglar, gipsskivor och skruv till innerväggen</h1>
        <p class="m-0 mt-4 text-ingress lg:text-ingress-lg">
          Fyll i väggens längd, rumshöjden och regelavståndet, så får du materialåtgång för hela innerväggen. Här kan
          du räkna reglar, se hur många gipsskivor som går åt och få antalet skruv innan du åker till byggvaruhuset.
          Varje tal har en källa eller ett antagande under sig.
        </p>
      </div>

      {
        huvudbild && (
          <div class="lg:col-span-5">
            <img
              src={huvudbild.src}
              alt=""
              width={huvudbild.width}
              height={huvudbild.height}
              fetchpriority="high"
              decoding="async"
              class:list={['block h-auto w-full', !varumarke && 'rounded-sm border border-linje']}
            />
          </div>
        )
      }
    </section>

    {
      visat.status === 'ok' && tal && (
        <Faktaruta variant="kortsvar">
          <p class="m-0 leading-6">Väggen behöver {tal.reglar} lodräta reglar.</p>
          <p class="m-0 leading-6">
            Virket går på <Markering>{tal.virke} löpmeter</Markering>, syll och hammarband inräknade.
          </p>
          <p class="m-0 leading-6">Det går åt {tal.skivor} gipsskivor.</p>
          <p class="m-0 leading-6">Köp {tal.skruvAttKopa} gipsskruv.</p>
          {tal.ull && <p class="m-0 leading-6">Isoleringen är {tal.ull} kvm mineralull.</p>}
        </Faktaruta>
      )
    }

    <div class="linjerat mt-8 lg:grid lg:grid-cols-2 lg:gap-8">
      {/* Formuläret ligger i src/components/kalkyl/InnervaggForm.astro, så att
          <Kalkylator namn="innervagg" /> i en artikel visar exakt samma fält. */}
      <InnervaggForm indata={indata} varden={varden} fel={fel} />

      <div class="mt-8 border-t border-linje pt-6 lg:mt-0 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8">
        {
          visat.status === 'ok' && tal && (
            <>
              {resultat.status === 'ogiltig' && (
                <p class="m-0 mb-2 text-liten text-varning">Visar standardvärden tills indatan är rättad.</p>
              )}
              <p class="m-0 text-etikett lg:text-etikett-lg uppercase text-blyerts-2">
                Vägg på {tal.langd} m, {regelText} på c {tal.cc} mm
              </p>
              {/* Enheten står på samma rad som talet, på talets baslinje
                  (DESIGN.md avsnitt 5.8). Radbryter på smal skärm. */}
              <p class="m-0 mt-1 flex flex-wrap items-baseline gap-x-2">
                <span class="font-serif text-siffra lg:text-siffra-lg text-blyerts">
                  <Markering>{tal.reglar}</Markering>
                </span>
                <span class="text-ingress lg:text-ingress-lg">reglar</span>
              </p>
              <p class="m-0 mt-2 flex flex-wrap items-baseline gap-x-2">
                <span class="font-serif text-siffra lg:text-siffra-lg text-blyerts">{tal.skivor}</span>
                <span class="text-ingress lg:text-ingress-lg">gipsskivor</span>
              </p>
              <p class="m-0 mt-2 text-liten text-blyerts-2">
                reglarna kapas till {tal.kapLangd} m, skivorna är {formateraTal(SKIVA_BREDD_MM)} ×{' '}
                {formateraTal(SKIVA_HOJD_MM)} mm
              </p>

              <ul class="m-0 mt-4 p-0 list-none text-brod tabular-nums">
                <li class="border-t border-linje py-2">
                  {tal.virke} löpmeter virke, alltså {tal.syllHammarband} m syll och hammarband plus reglarna
                  {visat.avvaxlingM > 0 && <> och {tal.avvaxling} m avväxling</>}
                </li>
                <li class="border-t border-linje py-2">
                  {tal.virkeMedSpill} löpmeter med spillet inräknat
                </li>
                <li class="border-t border-linje py-2">
                  {tal.antalLangder} reglar à {tal.handelslangd} m ger minst spill, {tal.spill} procent
                </li>
                <li class="border-t border-linje py-2">
                  {tal.skivorMedSpill} skivor med spillet inräknat, {tal.skivyta} kvm skivyta
                </li>
                <li class="border-t border-linje py-2">
                  {tal.skruv} gipsskruv räknat, köp {tal.skruvAttKopa}
                </li>
                <li class="border-t border-linje py-2">{packRad}</li>
                <li class="border-t border-linje py-2">Skruven är {visat.skruvLangdText}</li>
                {tal.ull && (
                  <li class="border-t border-linje py-2">
                    {tal.ull} kvm mineralull 45 mm
                    {tal.ullBredd ? <>, i {tal.ullBredd} mm bredd</> : <>, som du får kapa själv</>}
                  </li>
                )}
                {visat.antalReglarDorr > 0 && (
                  <li class="border-t border-linje py-2">
                    {tal.reglarDorr} av reglarna står vid dörröppningarna
                  </li>
                )}
              </ul>

              {visat.gorInteDetHar.length > 0 && (
                <>
                  <p class="m-0 mt-4 text-etikett lg:text-etikett-lg uppercase text-blyerts-2">Gör inte det här</p>
                  {visat.gorInteDetHar.map((rad) => (
                    <p class="m-0 mt-1 text-brod">{rad}</p>
                  ))}
                </>
              )}

              <p class="m-0 mt-4">
                <a href="#sa-raknar-vi" class:list={['inline-flex min-h-11 items-center', LANK_KLASS]}>
                  Så räknar vi
                </a>
              </p>

              {/* Dela. Uträkningen står i adressen, så ett skrivskyddat fält
                  räcker: markera och kopiera fungerar utan en rad JavaScript. */}
              <div class="mt-4 border-t border-linje pt-4">
                <label for="dela" class={ETIKETT_KLASS}>
                  Dela uträkningen
                </label>
                <input id="dela" type="text" readonly value={delaLank} class:list={[FALT_KLASS, 'border-blyerts-2']} />
                <p class="m-0 mt-1 text-liten text-blyerts-2">Adressen innehåller dina värden. Markera och kopiera.</p>
              </div>
            </>
          )
        }
      </div>
    </div>

    <section>
      <Pennstreck id="skruven-och-maskinen">Skruven och maskinen som räkningen pekar på</Pennstreck>
      <p class="m-0 mb-4 text-brod lg:text-brod-lg">
        Skruvlängden följer antalet skivlag, och antalet skruv avgör om det lönar sig att mata dem ur ett band.
      </p>
      <div class="grid gap-4 lg:grid-cols-2">
        <Produktkort produkt="essve-fzb-39x41" variant="kompakt" modul="kalkylator" forVem={packRad} />
        <Produktkort
          produkt="makita-dfr550zx1"
          variant="kompakt"
          modul="kalkylator"
          forVem="Från ungefär 300 skruv lönar sig en automat."
        />
      </div>
      <p class="m-0 mt-4 text-liten text-blyerts-2">
        Bandet är gjort för träregel. Står du framför en stålstomme ligger det kvar i väskan och du skruvar för hand.
      </p>
    </section>

    <section>
      <Pennstreck id="materialatgang-innervagg">Materialåtgång innervägg, så räknar regelkalkylatorn</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        Grundtanken är att en vägg är samma sak om och om igen. Därför räknas allt per löpmeter vägg, och sedan
        multipliceras det med din längd. Syllen mot golvet och hammarbandet mot taket ger två meter virke per
        löpmeter, innan en enda lodrät regel är kapad. De lodräta reglarna är väggens längd delad med c-måttet, alltså
        avståndet mellan reglarnas mitt. Sedan läggs en regel till som stänger det sista facket. Ta en vägg som är
        fyra meter lång. Med reglar på c&nbsp;600&nbsp;mm blir det sju fack. Då går det åtta reglar, och den sista
        står i väggänden.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Skivorna räknas på yta, och väggen har två sidor. En löpmeter vägg med 2,5&nbsp;m i tak ger fem kvadratmeter
        skiva. En hel skiva på 1&nbsp;200&nbsp;×&nbsp;2&nbsp;500&nbsp;mm är tre kvadratmeter. Det blir 1,7 skivor per
        löpmeter vägg. Skruven räknas ur skruvavstånden. Kantraderna sitter på c&nbsp;200&nbsp;mm och fältraderna på
        c&nbsp;300&nbsp;mm. Hur ofta en regel är skivkant beror på c-måttet. På c&nbsp;600&nbsp;mm är varannan regel
        en kant. Det ger ungefär sju skruv per kvadratmeter skivyta. Ullen räknas en gång, eftersom den ligger i
        facket mellan reglarna och inte på båda sidorna.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Varför c&nbsp;400&nbsp;mm under ett lag gips? Branschorganisationen Svenskt Trä knyter det glesare måttet till
        dubbla skivlag med förskjutna skarvar. Sitter det bara ett lag på en stomme med c&nbsp;600&nbsp;mm ger väggen
        efter mellan reglarna när någon lutar sig mot den. Den håller, men den känns billig, och skarvarna jobbar mer
        än de borde. Tillverkarna anger det glesare måttet för sina egna system utan det villkoret, och skillnaden
        mellan källorna är värd att veta innan du sågar. Kalkylatorn väljer därför c&nbsp;400&nbsp;mm åt dig så länge
        du står på ett lag.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Spillet är det sista steget, och det är också det mest gissade. Virket får ett påslag på fem procent, för den
        skeva regeln finns alltid i högen. Skivorna får tio procent, eftersom bitarna vid tak, hörn och dörr sällan
        blir hela. Vi drar därför inte heller av dörrhålet från skivytan. Kalkylatorn föreslår dessutom den
        handelslängd som spiller minst när reglarna kapas, vilket ofta är den som ligger strax över rumshöjden i
        stället för den längsta i hyllan.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Hela ordningen från syll till sista skivan står i{' '}
        <a href="/inomhus/bygga-innervagg/" class={LANK_KLASS}>
          guiden om att bygga innervägg med reglar och gips
        </a>
        , och vilken längd och gänga skruven ska ha står i{' '}
        <a href="/inomhus/gipsskruv/" class={LANK_KLASS}>
          guiden om rätt gipsskruv för regeln och skivan
        </a>
        .
      </p>
    </section>

    <section>
      <Pennstreck id="sa-raknar-vi">Så räknar vi</Pennstreck>
      {
        varumarke && illustration && (
          <Illustration
            namn="rakna/innervagg"
            alt="Regelvägg framifrån med syll, hammarband och fem reglar, en gipsskiva över de två högra och en måttbygel märkt c 450 mellan två regelmitter."
            bildtext="Det verktyget räknar på: väggens längd, regelavståndet och skruven var tjugonde centimeter."
          />
        )
      }
      <ol class="m-0 mt-4 pl-6 list-decimal text-brod lg:text-brod-lg">
        <li class="mb-2">
          Väggens längd delas med c-måttet och avrundas uppåt. En regel läggs till för den sista väggänden.
        </li>
        <li class="mb-2">Varje dörröppning lägger till två reglar och en avväxling över öppningen.</li>
        <li class="mb-2">
          Virket är syll och hammarband, alltså väggens längd två gånger, plus reglarna kapade till rumshöjden minus
          kapmånen.
        </li>
        <li class="mb-2">
          Varje handelslängd prövas mot kaplängden, och den som lämnar minst spill föreslås. Vid lika spill vinner den
          kortaste.
        </li>
        <li class="mb-2">
          Väggytan gånger två sidor gånger antalet lag ger skivytan, som delas med skivans tre kvadratmeter.
        </li>
        <li class="mb-2">
          Skivytan gånger skruvtätheten ger antalet skruv, och talet avrundas uppåt till hela hundratal.
        </li>
        <li>Väggytan en gång ger kvadratmetrarna mineralull, eftersom ullen ligger i facket mellan reglarna.</li>
      </ol>

      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">Vad siffrorna vilar på</h3>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full border-collapse text-liten tabular-nums">
          <caption class="sr-only">Antaganden och källor i regelkalkylatorn</caption>
          <thead>
            <tr class="border-b border-linje text-left">
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Storhet</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Vi räknar med</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Källa eller antagande</th>
            </tr>
          </thead>
          <tbody>
            {
              antaganden.map((a) => (
                <tr>
                  <th scope="row" class:list={[CELL_KLASS, 'text-left font-normal']}>
                    {a.storhet}
                  </th>
                  <td class={CELL_KLASS}>{a.varde}</td>
                  <td class={CELL_KLASS}>
                    {a.grund}.{' '}
                    {a.url ? (
                      <a
                        href={a.url}
                        rel={a.url.startsWith('/') ? undefined : 'nofollow'}
                        class={LANK_KLASS}
                      >
                        {a.stod}
                      </a>
                    ) : (
                      a.stod
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="m-0 mt-6 text-brod lg:text-brod-lg">
        Materiallistan i innerväggsguiden räknar per löpmeter vägg och landar på 6,2 löpmeter virke per meter. Talet är
        en täthet, och den rymmer inte regeln i den sista väggänden. Kalkylatorn räknar reglarna en och en och hamnar
        därför någon regel högre på en kort vägg. Köp efter kalkylatorns tal, för en regel för mycket går alltid att
        kapa till kortlingar.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Metoden bakom våra siffror står på <a href="/om/sa-testar-vi/" class={LANK_KLASS}>Så testar vi</a>.
      </p>
    </section>

    <section>
      <Pennstreck id="las-vidare">Läs vidare</Pennstreck>
      <ul class="m-0 p-0 list-none">
        <li class="border-t border-linje">
          <a href="/inomhus/bygga-innervagg/" class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
            Bygga innervägg med reglar och gips, hela ordningen med måtten
          </a>
        </li>
        <li class="border-t border-linje">
          <a href="/inomhus/gipsskruv/" class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
            Rätt gipsskruv för regeln och skivan, längd och gänga
          </a>
        </li>
      </ul>
    </section>

    <Faq fragor={FRAGOR} />
  </div>
</Bas>
