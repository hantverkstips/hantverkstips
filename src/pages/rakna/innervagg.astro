---
/**
 * Regel- och skruvräknaren för innervägg. Formuläret skickas som GET till samma
 * sida och beräkningen sker på servern, så sidan fungerar utan ett enda byte
 * klient-JS. Kostnaden är en serverfunktion per anrop, och den hålls nere med
 * CDN-cache. Se docs/SPEC-SIDMALLAR.md avsnitt 4.7.
 *
 * Formeln och alla antaganden ligger i src/lib/kalkyl/innervagg.ts. Sidan räknar
 * ingenting själv, den visar bara resultatet och redovisar källorna.
 *
 * Räkningen pekar ut två produktegenskaper, antalet skruv och skruvlängden, och
 * därför visas produktkort efter resultatet, aldrig före. Sidan har då
 * reklamband. Skruvkortet visas bara när svaret är den bandade längd vi har
 * pris på, se visaBandadSkruv nedan.
 */
export const prerender = false;

import { formateraTal } from '../../lib/format';
import { artikelUrl, publicerade } from '../../lib/innehall';
import { tillKortArtikel, type KortData } from '../../lib/kort';
import {
  raknaInnervagg,
  SKIVA_BREDD_MM,
  SKIVA_HOJD_MM,
  SPILL_SKIVOR,
  SPILL_VIRKE,
  STANDARD,
  tolkaQuery,
  type InnervaggIndata,
  type InnervaggResultat,
} from '../../lib/kalkyl/innervagg';
import { hittaKalkylator } from '../../lib/kalkyl/register';
import { CELL_KLASS, LANK_KLASS } from '../../lib/kalkyl/stil';
import { arPelare } from '../../lib/pelare';
import { hamtaButik } from '../../lib/produkter';
import { verktygsillustration } from '../../lib/verktygsbild';
import InnervaggForm from '../../components/kalkyl/InnervaggForm.astro';
import Artikelrutnat from '../../components/ui/Artikelrutnat.astro';
import Faq from '../../components/ui/Faq.astro';
import Pennstreck from '../../components/ui/Pennstreck.astro';
import Produktkort from '../../components/ui/Produktkort.astro';
import Svarstal from '../../components/ui/Svarstal.astro';
import Tabellyta from '../../components/ui/Tabellyta.astro';
import Illustration from '../../components/ui/Illustration.astro';
import Raknarsida from '../../components/vyer/Raknarsida.astro';

Astro.locals.sidtyp = 'verktyg';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

const q = Astro.url.searchParams;
const { indata } = tolkaQuery(q);
const resultat = raknaInnervagg(indata);

const fel = resultat.status === 'ogiltig' ? resultat.fel : {};
// Vid ogiltig indata visas standardvärdenas resultat, med en rad som säger det.
const visat: InnervaggResultat = resultat.status === 'ogiltig' ? raknaInnervagg(STANDARD) : resultat;
const visatIndata: InnervaggIndata = resultat.status === 'ogiltig' ? STANDARD : indata;

const komma = (n: number) => String(n).replace('.', ',');
/** Tal i löptext: heltal utan decimal, annars en. "28 m", "2,5 m". */
const talText = (n: number) => formateraTal(n, Number.isInteger(n) ? 0 : 1);

/**
 * Fältens värden kommer från query-strängen som den skrevs, inte från de tolkade
 * talen: "fyra" eller "" blir NaN i tolkaQuery, och NaN i ett fält som läsaren
 * ska rätta är obrukbart.
 */
function faltVarde(nyckel: string, standardVarde: number): string {
  const ra = q.get(nyckel);
  if (ra !== null) return ra;
  return komma(standardVarde);
}

const varden = {
  langd: faltVarde('langd', STANDARD.langdM),
  hojd: faltVarde('hojd', STANDARD.hojdM),
  dorrar: faltVarde('dorrar', STANDARD.dorrar),
};

/**
 * Delbar länk. Hela tillståndet ligger redan i query-strängen, så adressen är
 * uträkningen. Den byggs av de tolkade värdena, inte av strängen läsaren skrev,
 * och regelavståndet skrivs alltid ut, även när det kom från standardvalet.
 */
const delaQuery = new URLSearchParams({
  langd: komma(visatIndata.langdM),
  hojd: komma(visatIndata.hojdM),
  regel: visatIndata.regel,
  lag: String(visatIndata.lag),
  cc: String(visatIndata.ccMm),
  dorrar: String(visatIndata.dorrar),
  ull: visatIndata.ull ? 'ja' : 'nej',
});
const delaLank = new URL(`/rakna/innervagg/?${delaQuery.toString()}`, Astro.site ?? Astro.url).toString();

const butik = await hamtaButik();

const regelText = visatIndata.regel === '45x70' ? '45 × 70 mm' : '45 × 95 mm';

/** Räkneord för de små talen, så att en mening kan börja utan siffra. */
const RAKNEORD = ['inget', 'ett', 'två', 'tre', 'fyra', 'fem', 'sex', 'sju', 'åtta', 'nio', 'tio'];
const rakneord = (n: number) => RAKNEORD[n] ?? formateraTal(n);

/** Tal ur resultatet, färdigformaterade, så att markupen nedan blir läsbar. */
const tal =
  visat.status === 'ok'
    ? {
        reglar: formateraTal(visat.antalReglar),
        reglarVagg: formateraTal(visat.antalReglarVagg),
        reglarDorr: formateraTal(visat.antalReglarDorr),
        kapLangd: formateraTal(visat.kapLangdM, 2),
        virke: formateraTal(visat.lopmeterVirke, 1),
        virkeMedSpill: formateraTal(visat.lopmeterVirkeMedSpill, 1),
        syllHammarband: talText(visat.syllHammarbandM),
        avvaxling: formateraTal(visat.avvaxlingM, 1),
        handelslangd: formateraTal(visat.handelslangdM, 1),
        antalLangder: formateraTal(visat.antalLangder),
        spill: formateraTal(visat.spillProcent, 0),
        skivor: formateraTal(visat.antalSkivor),
        skivorMedSpill: formateraTal(visat.antalSkivorMedSpill),
        skivyta: talText(visat.skivytaKvm),
        skruv: formateraTal(visat.antalSkruv),
        skruvAttKopa: formateraTal(visat.skruvAttKopa),
        pack: formateraTal(visat.antalPack),
        packOrd: rakneord(visat.antalPack),
        packRacker: formateraTal(visat.packRackerTillMeter, 0),
        ull: visat.ullKvm === null ? null : talText(visat.ullKvm),
        ullBredd: visat.ullBreddMm === null ? null : formateraTal(visat.ullBreddMm),
        langd: talText(visatIndata.langdM),
        hojd: talText(visatIndata.hojdM),
        cc: formateraTal(visatIndata.ccMm),
      }
    : null;

/** Raden på skruvkortet säger vad just den här räkningen behöver. */
const packRad =
  visat.status === 'ok' && tal
    ? `Din vägg behöver ${tal.packOrd} band om 1 000 skruv. Ett band räcker till ungefär ${tal.packRacker} löpmeter vägg.`
    : 'Ett band om 1 000 skruv räcker till ungefär 29 löpmeter vägg.';

/**
 * Bandet i databasen är 3,9 × 41 mm, alltså skruven för ett lag gips på
 * träregel. Med två lag blir svaret 45 eller 51 mm, och då visas inte kortet:
 * en kalkylator får aldrig peka på en produkt som inte klarar det uträknade
 * värdet (docs/AFFILIATE.md avsnitt 1). Samma villkor som visaBandadSkruv i
 * /rakna/gipsskruv/. Skruvautomaten tar 25 till 55 mm och klarar båda fallen.
 */
const visaBandadSkruv = visatIndata.lag === 1;

const titel = 'Räkna reglar och gips till innerväggen';

/** Antagandena i tabellen under "Så räknar vi". Samma tal som konstanterna i kalkylen. */
const antaganden: { storhet: string; varde: string; grund: 'Källa' | 'Antagande'; stod: string; url?: string }[] = [
  {
    storhet: 'Gipsskivans format',
    varde: `${formateraTal(SKIVA_BREDD_MM)} × ${formateraTal(SKIVA_HOJD_MM)} mm, det är 3 kvm`,
    grund: 'Källa',
    stod: 'Normalskivan i Norgips och Gyprocs system, 12,5 mm tjock',
    url: 'https://www.norgips.se/kunskapsbank/att-tanka-pa-innan-montering/',
  },
  {
    storhet: 'Regelavståndet under ett lag gips',
    varde: 'c 400 mm',
    grund: 'Källa',
    stod: 'Svenskt Trä, för skivor som är 1 200 mm breda. Vid två lag med förskjutna skarvar anger de c 600 mm',
    url: 'https://www.byggbeskrivningar.se/renovering/bygga-innervagg/',
  },
  {
    storhet: 'Skruvavståndet i det yttersta laget',
    varde: 'c 200 mm i kant, c 300 mm i fält',
    grund: 'Källa',
    stod: 'Norgips, och Svenskt Trä anger samma mått',
    url: 'https://www.norgips.se/kunskapsbank/bygga-vagg-med-stalreglar/',
  },
  {
    storhet: 'Skruvavståndet i det innersta laget',
    varde: 'c 750 mm',
    grund: 'Källa',
    stod: 'Norgips, gäller en tvålagersvägg utan brandkrav',
    url: 'https://www.norgips.se/kunskapsbank/bygga-vagg-med-stalreglar/',
  },
  {
    storhet: 'Hur mycket kortare reglarna kapas',
    varde: '15 mm kortare än rumshöjden',
    grund: 'Källa',
    stod: 'Gyproc, för icke bärande träregelvägg',
    url: 'https://www.gyproc.se/gor-det-sjalv/bygga-innervagg-med-trastomme',
  },
  {
    storhet: 'Mineralullens bredd',
    varde: '455 mm vid c 450, 610 mm vid c 600',
    grund: 'Källa',
    stod: 'Norgips. För c 400 anger ingen tillverkare någon bredd, så då får du kapa',
    url: 'https://www.norgips.se/kunskapsbank/bygga-vagg-med-stalreglar/',
  },
  {
    storhet: 'Skruvlängden på träregel',
    varde: '41 mm vid ett lag, 45 eller 51 mm vid två',
    grund: 'Källa',
    stod: 'Min guide om gipsskruv, räknad ur Norgips tumregel om 20 mm ner i träet',
    url: '/inomhus/gipsskruv/',
  },
  {
    storhet: 'Dörröppningen',
    varde: '0,9 m bred',
    grund: 'Antagande',
    stod: 'Den vanligaste innerdörren. Öppningen får en regel på vardera sidan och en avväxling över, som Svenskt Trä anger',
  },
  {
    storhet: 'Spill på gipsskivor',
    varde: `${formateraTal(SPILL_SKIVOR * 100)} procent`,
    grund: 'Antagande',
    stod: 'Täcker kapade bitar vid tak, hörn och dörr. Jag drar inte av dörrhålet från skivytan, eftersom bitarna runt en öppning sällan blir hela',
  },
  {
    storhet: 'Spill på virke',
    varde: `${formateraTal(SPILL_VIRKE * 100)} procent`,
    grund: 'Antagande',
    stod: 'Täcker den skeva regeln som alltid ligger i högen. Guiden om innerväggen lägger på tio procent, eftersom den räknar per löpmeter i stället för regel för regel',
  },
  {
    storhet: 'Handelslängderna på reglar',
    varde: '2,4 till 4,8 m',
    grund: 'Antagande',
    stod: 'De längder byggvaruhusen vanligen lagerför i 45 × 70 och 45 × 95. Ingen publicerad standard',
  },
];

/**
 * Frågorna sist på sidan. Exemplen är desamma som i "Materialåtgång innervägg",
 * och påslagen är de som står i "Så räknar vi".
 */
const FRAGOR = [
  {
    fraga: 'Hur många reglar går det åt till en innervägg?',
    svar: 'Dela väggens längd med c-måttet och avrunda uppåt. C-måttet är avståndet från mitten av en regel till mitten av nästa. Lägg sedan till en regel som stänger det sista facket. En vägg på fyra meter med reglar på c 600 mm får åtta reglar, och den sista står i väggänden. Varje dörröppning lägger till två reglar och en avväxling över öppningen.',
  },
  {
    fraga: 'Ska reglarna sitta på c 400 eller c 600 mm?',
    svar: 'Med två lag gips på varje sida räcker c 600 mm. Bygger du med ett lag väljer verktyget c 400 mm åt dig, för annars ger väggen efter mellan reglarna när någon lutar sig mot den. Mellanvalet c 450 mm finns med eftersom mineralullen säljs i 455 mm bredd som passar det måttet, enligt Norgips. Branschorganisationen Svenskt Trä knyter det glesare måttet till dubbla skivlag med förskjutna skarvar, medan skivtillverkarna anger det för sina egna system utan det villkoret. Jag går på Svenskt Trä, och det är bra att veta att källorna skiljer sig innan du sågar.',
    lank: { text: 'Hela ordningen står i guiden om att bygga innervägg.', href: '/inomhus/bygga-innervagg/' },
  },
  {
    fraga: 'Hur mycket spill ska jag räkna med?',
    svar: 'Virket får ett påslag på fem procent, för den skeva regeln ligger alltid i högen. Skivorna får tio procent, eftersom bitarna vid tak, hörn och dörr sällan blir hela. Av samma skäl drar jag inte av dörrhålet från skivytan. Verktyget föreslår dessutom den handelslängd som spiller minst när reglarna kapas, och det är ofta inte den längsta i hyllan.',
  },
];

/** Slug, namn och beskrivning på ett ställe: brödsmulan, og:image och WebApplication läser samma. */
const SLUG = 'innervagg';
const VERKTYGSNAMN = 'Regelkalkylator';
const BESKRIVNING =
  'Fyll i väggens längd, höjd och regelavstånd, så får du materialåtgången för innerväggen med reglar, gipsskivor, skruv och mineralull, spillet inräknat.';
/** Skissen står i kortet Så räknar jag. Huvudet har ingen bild sedan fas C (DESIGN.md 5.8). */
const illustration = verktygsillustration(SLUG);

/*
 * Svarsytan, fas C (spec-designlyft-c-2026-10-02 avsnitt 12). Ny text är
 * hantverkarens. Klartexten har platshållarna {reglar} (stående reglar),
 * {skivor} (gipsskivor utan spill), {langd} och {hojd} (m), {regel} (regelns
 * mått, "45 × 70 mm") och {cc} (mm).
 */
const KLARTEXT =
  'En vägg på {langd} × {hojd} m med reglar {regel} på c {cc} mm behöver {reglar} stående reglar och {skivor} gipsskivor utan spill, räknat med Gyprocs och Norgips mått.'; // innervagg.klartext
const klartext = tal
  ? KLARTEXT.replace('{reglar}', tal.reglar)
      .replace('{skivor}', tal.skivor)
      .replace('{langd}', tal.langd)
      .replace('{hojd}', tal.hojd)
      .replace('{regel}', regelText)
      .replace('{cc}', tal.cc)
  : '';

/** Läs vidare som kort, i den förra listans ordning. Räknaren får registrets namn som på hubben. */
const LAS_VIDARE = ['/inomhus/bygga-innervagg/', '/inomhus/gipsskruv/', '/rakna/gipsskruv/'];
const artiklar = [...(await publicerade('guider')), ...(await publicerade('kunskap'))];
const lasVidare: KortData[] = LAS_VIDARE.flatMap((href): KortData[] => {
  const e = artiklar.find((a) => artikelUrl(a) === href);
  if (e) {
    const { niva: _niva, ...kort } = tillKortArtikel(e);
    return [kort];
  }
  const k = hittaKalkylator(href.replace(/^\/rakna\/|\/$/g, ''));
  const pelare = k?.pelare?.[0];
  if (!k || !pelare || !arPelare(pelare)) return [];
  return [
    {
      etikett: 'Räkna själv',
      rubrik: k.namn,
      beskrivning: k.rad,
      pelare,
      href,
      // Artikelrutnat läser inte typen; kortet står varken i ett typfilter eller sorteras.
      typ: 'kunskap',
      sorteringsdatum: new Date(0),
    },
  ];
});
---

<Raknarsida
  slug={SLUG}
  namn={VERKTYGSNAMN}
  titel={titel}
  beskrivning={BESKRIVNING}
  rubrik="Så mycket reglar, gips och skruv går åt till din innervägg"
  reklam={true}
  butikNamn={butik?.namn}
  delaUrl={delaLank}
>
  <p slot="ingress">
    Hur lång väggen ska bli, hur högt det är till taket och hur tätt reglarna ska sitta är allt jag behöver
    för att ge dig en lista att ta med till bygghandeln. Den säger hur många reglar, gipsskivor och skruv som går åt per
    löpmeter vägg, och hur mycket mineralull du behöver i facken. Spillet ligger redan på, och varje tal har en
    källa eller ett antagande som du kan läsa längre ner.
  </p>

  {/* Formuläret ligger i src/components/kalkyl/InnervaggForm.astro, så att
      <Kalkylator namn="innervagg" /> i en artikel visar exakt samma fält. */}
  <InnervaggForm slot="formular" indata={indata} varden={varden} fel={fel} />

  {
    visat.status === 'ok' && tal && (
      <Fragment slot="svar">
        {resultat.status === 'ogiltig' && (
          <p class="text-liten text-varning">
            Ett av fälten gick inte att läsa, så jag visar standardvärdena tills du rättat det.
          </p>
        )}
        <Svarstal
          tal={tal.reglar}
          enhet="reglar"
          vad={`Vägg på ${tal.langd} m, ${regelText}, ${tal.cc} mm från regelmitt till regelmitt`}
        />
        {/* Skivorna som andra rad, som förut, på samma baslinje som enheten. */}
        <p class="svarstal">
          <span class="font-serif text-h1">{tal.skivor}</span>
          <span>
            <span class="font-serif text-h2">gipsskivor</span>
          </span>
        </p>
        <p class="text-liten text-blyerts-2">
          Reglarna kapar du till {tal.kapLangd} m, och skivorna är {formateraTal(SKIVA_BREDD_MM)} ×{' '}
          {formateraTal(SKIVA_HOJD_MM)} mm.
        </p>
        <div class="text-brod">
          <p class="font-bold">
            Köp {tal.antalLangder} reglar om {tal.handelslangd} m, {tal.skivorMedSpill} gipsskivor och{' '}
            {tal.skruvAttKopa} gipsskruv.
          </p>
          <p>
            Det ger {tal.reglar} stående reglar när du kapat dem, och spillet på virke och skivor är inräknat.
            {tal.ull && <> Ta med {tal.ull} kvm mineralull till facken.</>}
          </p>
        </div>
        <p class="text-liten text-blyerts">{klartext}</p>
      </Fragment>
    )
  }

  {
    visat.status === 'ok' && tal && (
      <Fragment slot="darfor">
        <Pennstreck id="darfor-blev-svaret-sa" utanLuft>
          Därför blev svaret så
        </Pennstreck>
        <div class="darfor tabular-nums">
          <div>
            <p>
              Virket är {tal.virke} löpmeter. {tal.syllHammarband} m av det är syll och hammarband, resten är
              reglarna
              {visat.avvaxlingM > 0 && <> och {tal.avvaxling} m avväxling över dörren</>}. Med spillet inräknat
              blir det {tal.virkeMedSpill} löpmeter.
              {visat.antalReglarDorr > 0 && <> {tal.reglarDorr} av reglarna står vid dörröppningarna.</>}
            </p>
            <p>Reglarna kapas 15 mm kortare än rumshöjden enligt Gyproc. Spillet på fem procent är mitt.</p>
          </div>
          <div>
            <p>
              {tal.antalLangder} reglar om {tal.handelslangd} m är den handelslängd som spiller minst, {tal.spill}{' '}
              procent.
            </p>
            <p>Längderna 2,4 till 4,8 m är de byggvaruhusen brukar lagerföra. Ingen publicerad standard.</p>
          </div>
          <div>
            <p>Skivorna täcker {tal.skivyta} kvm, och med spillet blir det {tal.skivorMedSpill} skivor.</p>
            <p>Skivan på 1 200 × 2 500 mm är normalskivan hos Norgips och Gyproc. Spillet på tio procent är mitt.</p>
          </div>
          <div>
            <p>
              Räknat går det åt {tal.skruv} gipsskruv, och jag rundar upp till {tal.skruvAttKopa}. {packRad} Skruven
              ska vara {visat.skruvLangdText}.
            </p>
            <p>
              Skruvavstånden c 200 mm i kant och c 300 mm i fält är Norgips och Svenskt Träs. Längden kommer ur
              Norgips tumregel om 20 mm ner i träet.
            </p>
          </div>
          {tal.ull && (
            <div>
              <p>
                Ullen är {tal.ull} kvm mineralull i 45 mm tjocklek
                {tal.ullBredd ? <>, och den finns i {tal.ullBredd} mm bredd</> : <>, och den får du kapa själv</>}.
              </p>
              <p>Bredderna 455 och 610 mm anger Norgips. För c 400 mm anger ingen tillverkare någon bredd.</p>
            </div>
          )}
        </div>
      </Fragment>
    )
  }

  {
    visat.status === 'ok' && visat.gorInteDetHar.length > 0 && (
      <Fragment slot="gorInte">
        {/* Flera råd står i samma stycke efter "Gör inte det här.", vart och ett på egen rad. */}
        {visat.gorInteDetHar.map((rad, i) => (
          <span class:list={[i > 0 && 'mt-3 block']}>{rad}</span>
        ))}
      </Fragment>
    )
  }

  <Fragment slot="saRaknarJag">
    {
      illustration && (
        <div class="pappersruta">
          <Illustration
            namn="rakna/innervagg"
            alt="Regelvägg framifrån med syll, hammarband, fem reglar, en gipsskiva och en måttbygel märkt c 450."
            bildtext="Skissen visar det verktyget räknar på: väggens längd, regelavståndet mätt från mitt till mitt, och skruven var tjugonde centimeter i skivkanten."
            class="my-0!"
          />
        </div>
      )
    }
    <ol class="m-0 mt-4 pl-6 list-decimal text-brod">
      <li class="mb-2">
        Väggens längd delar jag med c-måttet och avrundar uppåt. Sedan lägger jag till en regel för den sista
        väggänden.
      </li>
      <li class="mb-2">Varje dörröppning lägger till två reglar och en avväxling över öppningen.</li>
      <li class="mb-2">
        Virket är syll och hammarband (väggens längd två gånger) plus reglarna kapade till rumshöjden minus
        15 mm.
      </li>
      <li class="mb-2">
        Varje handelslängd prövar jag mot kaplängden, och den som lämnar minst spill får du som förslag. Vid lika
        spill vinner den kortaste.
      </li>
      <li class="mb-2">
        Väggytan gånger två sidor gånger antalet lag ger skivytan, och den delar jag med skivans tre kvadratmeter.
      </li>
      <li class="mb-2">
        Skivytan gånger skruvtätheten ger antalet skruv, och det talet rundar jag upp till hela hundratal.
      </li>
      <li>Väggytan en gång ger kvadratmetrarna mineralull, eftersom ullen ligger i facket mellan reglarna.</li>
    </ol>
  </Fragment>

  <Fragment slot="efter">
    {/* Antagandetabellen i läsbredd, ur kortet Så räknar jag (spec-designlyft-c avsnitt 9). */}
    <section class="max-w-lasbredd">
      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">Vad siffrorna vilar på</h3>
      <Tabellyta kolumner={3} class="mt-4">
        <table class="w-full border-collapse text-liten tabular-nums">
          <caption class="sr-only">Antaganden och källor i regelkalkylatorn</caption>
          <thead>
            <tr class="border-b border-linje text-left">
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Vad</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Jag räknar med</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Källa eller antagande</th>
            </tr>
          </thead>
          <tbody>
            {
              antaganden.map((a) => (
                <tr>
                  <th scope="row" class:list={[CELL_KLASS, 'text-left font-normal']}>
                    {a.storhet}
                  </th>
                  <td class={CELL_KLASS}>{a.varde}</td>
                  <td class={CELL_KLASS}>
                    {a.grund}.{' '}
                    {a.url ? (
                      <a href={a.url} rel={a.url.startsWith('/') ? undefined : 'nofollow'} class={LANK_KLASS}>
                        {a.stod}
                      </a>
                    ) : (
                      a.stod
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </Tabellyta>

      <p class="m-0 mt-6 text-brod lg:text-brod-lg">
        Jämför du med materiallistan i guiden om innerväggen ser du att den landar på 6,2 löpmeter virke per meter
        vägg, vilket är lite mindre än här. Guidens tal är en täthet, och den rymmer inte regeln i den sista
        väggänden. Verktyget räknar reglarna en och en och hamnar därför någon regel högre på en kort vägg. Köp
        efter verktygets tal. En regel för mycket kapar du alltid till kortlingar. Vill du veta hur jag läser
        tillverkarnas tal finns det på sidan <a href="/om/sa-testar-vi/" class={LANK_KLASS}>Så testar jag</a>.
      </p>
    </section>

    <section class="max-w-lasbredd">
      <Pennstreck id="skruven-och-maskinen">Skruven och maskinen som räkningen pekar på</Pennstreck>
      <p class="m-0 mb-4 text-brod lg:text-brod-lg">
        {
          visaBandadSkruv
            ? 'Skruvlängden följer antalet skivlag, och antalet skruv avgör om det lönar sig att mata dem ur ett band i stället för att plocka en i taget.'
            : 'Två lag gips vill ha 45 eller 51 mm, och bandet jag har pris på är 41 mm. Den skruven köper du därför lös eller i ett band i rätt längd. Maskinen matar hela spannet.'
        }
      </p>
      <div class="grid gap-4 lg:grid-cols-2">
        {
          visaBandadSkruv && (
            <Produktkort produkt="essve-fzb-39x41" variant="kompakt" modul="kalkylator" forVem={packRad} />
          )
        }
        <Produktkort
          produkt="makita-dfr550zx1"
          variant="kompakt"
          modul="kalkylator"
          forVem="Från ungefär 300 skruv lönar sig en automat."
        />
      </div>
      <p class="m-0 mt-4 text-liten text-blyerts-2">
        Bandet är gjort för träregel. Bygger du på en stålstomme får bandet ligga kvar i väskan, och du skruvar för
        hand.
      </p>
    </section>

    <section class="max-w-lasbredd">
      <Pennstreck id="materialatgang-innervagg">Materialåtgången till en innervägg, regel för regel</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        Grundtanken är att en vägg är samma sak om och om igen. Därför räknar jag allt per löpmeter vägg och multiplicerar
        sedan med din längd. Syllen mot golvet och hammarbandet mot taket ger två meter virke per löpmeter, innan en
        enda stående regel är kapad. Hur många reglar det går åt får du genom att dela väggens längd med c-måttet.
        Det måttet är avståndet från mitten av en regel till mitten av nästa, och det skrivs c&nbsp;400&nbsp;mm,
        c&nbsp;450&nbsp;mm eller c&nbsp;600&nbsp;mm. Sedan lägger du till en regel som stänger det sista facket.
        Säg att väggen är fyra meter lång. Med reglar på c&nbsp;600&nbsp;mm blir det sju fack och åtta reglar, och
        den sista står i väggänden.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Skivorna räknar jag på ytan, och väggen har två sidor. En löpmeter vägg med 2,5&nbsp;m i tak ger fem
        kvadratmeter skiva. En hel skiva på 1&nbsp;200&nbsp;×&nbsp;2&nbsp;500&nbsp;mm är tre kvadratmeter, så det
        blir 1,7 skivor per löpmeter vägg. Skruven räknar jag ur skruvavstånden. Kantraderna sitter på
        c&nbsp;200&nbsp;mm och fältraderna på c&nbsp;300&nbsp;mm, och hur ofta en regel är skivkant beror på
        c-måttet. På c&nbsp;600&nbsp;mm är varannan regel en kant, och det ger ungefär sju skruv per kvadratmeter
        skivyta. Ullen räknar jag en gång, för den ligger i facket mellan reglarna och inte på båda sidorna.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Så varför c&nbsp;400&nbsp;mm under ett lag gips, när c&nbsp;450 eller c&nbsp;600 skulle spara reglar? Här
        säger källorna olika. Branschorganisationen Svenskt Trä knyter det glesare måttet till dubbla skivlag med
        förskjutna skarvar. Skivtillverkarna anger det glesare måttet för sina egna system utan det villkoret. Jag
        går på Svenskt Trä, för jag har känt hur en vägg med ett lag på c&nbsp;600&nbsp;mm ger efter mellan
        reglarna när någon lutar sig mot den. Den håller, men den känns billig, och skarvarna jobbar mer än de borde.
        Verktyget väljer därför c&nbsp;400&nbsp;mm åt dig så länge du bygger med ett lag.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Spillet är det sista steget, och det mest gissade. Virket får ett påslag på fem procent, för den skeva
        regeln ligger alltid i högen. Skivorna får tio procent, eftersom bitarna vid tak, hörn och dörr sällan blir
        hela, och av samma skäl drar jag inte av dörrhålet från skivytan. Verktyget föreslår också den handelslängd
        som spiller minst när reglarna kapas. Ofta är det längden strax över rumshöjden, medan den längsta i hyllan
        spiller mest.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Hela ordningen från syll till sista skivan står i{' '}
        <a href="/inomhus/bygga-innervagg/" class={LANK_KLASS}>
          guiden om att bygga innervägg med reglar och gips
        </a>
        , och vilken längd och gänga skruven ska ha står i{' '}
        <a href="/inomhus/gipsskruv/" class={LANK_KLASS}>
          guiden om gipsskruv
        </a>
        .
      </p>
    </section>

    {
      lasVidare.length > 0 && (
        <section>
          <Pennstreck id="las-vidare">Läs vidare</Pennstreck>
          <Artikelrutnat kort={lasVidare} visaBeskrivning={false} visaMeta={false} />
        </section>
      )
    }

    <div class="max-w-lasbredd">
      <Faq fragor={FRAGOR} />
    </div>
  </Fragment>
</Raknarsida>
