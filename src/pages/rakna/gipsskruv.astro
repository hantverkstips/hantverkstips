---
/**
 * Vilken gipsskruv? Formuläret skickas som GET till samma sida och svaret räknas
 * fram på servern, så sidan fungerar utan ett enda byte klient-JS. Kostnaden är
 * en serverfunktion per anrop, och den hålls nere med CDN-cache.
 * Se docs/SPEC-SIDMALLAR.md avsnitt 4.7.
 *
 * Tumregeln, längdtabellen och alla tillverkarvärden ligger i
 * src/lib/kalkyl/gipsskruv.ts. Sidan räknar ingenting själv, den visar svaret
 * och redovisar källan bakom varje tal.
 *
 * Räkningen pekar ut skruvens längd och gänga, alltså en produktegenskap, och
 * sidan har därför reklamband och produktkort. Den bandade skruven visas bara
 * när svaret faktiskt är den skruven; skruvautomaten står alltid under, som på
 * innerväggsräknaren.
 */
export const prerender = false;

import {
  BORRSPETS_PLAT_MM,
  FOGTATNING_MM,
  LAG_TEXT,
  MILJO_TEXT,
  mm,
  NALSPETS_PLAT_MM,
  PLAT_GRANS_MM,
  raknaGipsskruv,
  REGEL_TEXT,
  SKIVA_TEXT,
  STAL_GENOM_MM,
  STANDARD,
  tolkaQuery,
  TRA_IN_I_REGEL_MM,
  type GipsskruvIndata,
  type GipsskruvResultat,
} from '../../lib/kalkyl/gipsskruv';
import { artikelUrl, publicerade } from '../../lib/innehall';
import { tillKortArtikel, type KortData } from '../../lib/kort';
import { hittaKalkylator } from '../../lib/kalkyl/register';
import { CELL_KLASS, LANK_KLASS } from '../../lib/kalkyl/stil';
import { arPelare } from '../../lib/pelare';
import { hamtaButik } from '../../lib/produkter';
import { verktygsillustration } from '../../lib/verktygsbild';
import GipsskruvForm from '../../components/kalkyl/GipsskruvForm.astro';
import Artikelrutnat from '../../components/ui/Artikelrutnat.astro';
import Faq from '../../components/ui/Faq.astro';
import Pennstreck from '../../components/ui/Pennstreck.astro';
import Produktkort from '../../components/ui/Produktkort.astro';
import Svarstal from '../../components/ui/Svarstal.astro';
import Tabellyta from '../../components/ui/Tabellyta.astro';
import Illustration from '../../components/ui/Illustration.astro';
import Raknarsida from '../../components/vyer/Raknarsida.astro';

Astro.locals.sidtyp = 'verktyg';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

const q = Astro.url.searchParams;
const { indata } = tolkaQuery(q);
const resultat = raknaGipsskruv(indata);

const fel = resultat.status === 'ogiltig' ? resultat.fel : {};
// Vid ogiltig indata visas standardvärdenas svar, med en rad som säger det.
const visat: GipsskruvResultat = resultat.status === 'ogiltig' ? raknaGipsskruv(STANDARD) : resultat;
const visatIndata: GipsskruvIndata = resultat.status === 'ogiltig' ? STANDARD : indata;

/**
 * Delbar länk. Hela frågan ligger redan i query-strängen, så adressen är svaret.
 * Den byggs av de tolkade värdena, och varje fält skrivs ut även när det kom
 * från standardvalet, så att en delad adress är entydig.
 */
const delaQuery = new URLSearchParams({
  skiva: visatIndata.skiva,
  lag: String(visatIndata.lag),
  regel: visatIndata.regel,
  fog: visatIndata.fogtatning ? 'ja' : 'nej',
  miljo: visatIndata.miljo,
});
const delaLank = new URL(`/rakna/gipsskruv/?${delaQuery.toString()}`, Astro.site ?? Astro.url).toString();

const butik = await hamtaButik();

const titel = 'Vilken gipsskruv passar din vägg?';

/**
 * Första bokstaven i gemen när ordet står mitt i en mening. Beteckningar som
 * S-spets, C4 och A2 ska stå som på förpackningen, så bara ett inledande
 * vanligt ord sänks.
 */
const iMening = (s: string) => (/^[A-ZÅÄÖ][a-zåäö]/.test(s) ? s.charAt(0).toLowerCase() + s.slice(1) : s);

/** Beskedet överst i spalten: köp den här skruven. */
const beskedRubrik =
  visat.status === 'ok'
    ? `Köp ${visat.langdText} gipsskruv med ${iMening(visat.gangaText)} och ${iMening(visat.spetsText)}.`
    : '';
const beskedRad = visat.status === 'ok' ? `Ytbehandlingen ska vara ${iMening(visat.ytbehandling.kort)}.` : '';

/** Källorna, en gång var, så att tabellen nedan blir läsbar. */
const NORGIPS = 'https://www.norgips.se/kunskapsbank/att-tanka-pa-innan-montering/';
const NORGIPS_VATRUM = 'https://www.norgips.se/kunskapsbank/montera-skivor-for-vatrum/';
const GYPROC_QS = 'https://www.gyproc.se/produkter/skruvar/skruv-mot-barverk-av-stal-och-tra-i-invandig-miljo/gyproc-qs-quick';
const SVENSKT_TRA = 'https://www.byggbeskrivningar.se/renovering/bygga-innervagg/';
const ESSVE_BORRSPETS =
  'https://essve.com/sv/produkter/skivskruv/gipsskruv/gipsskruv-med-borrspets-for-stalregel/gipsskruv-med-borrspets-for-stalregel-fosfaterad';
const ESSVE_GU =
  'https://essve.com/en/products/board-screws/collated-drywall-screws/drywall-gu-outdoor-with-drilltip-for-steel-joist/drywall-screw-gu-outside-with-drillpoint-for-steel-joists-corrseal';
const BEIJER = 'https://www.beijerbygg.se/privat/sv/skruvarnas-namn-ytbehandling-korrosivitetsklass';
const GDS = 'https://gds.se/material/spik-och-skruv/gipsskruv-sa-har-valjer-du-ratt-gipsskruv';
const PROFFS_522224 =
  'https://www.proffsmagasinet.se/bygg-interior/infastning/skruv/skivskruv/essve-522224-gipsskruv-for-stalregel-o35-mm-ph2-fzb-25-mm-3000-pack-3066147';

/** Varje tal i verktyget med sin källa eller sitt antagande. */
const antaganden: { storhet: string; varde: string; grund: 'Källa' | 'Antagande'; stod: string; url?: string }[] = [
  {
    storhet: 'Längden i en träregel',
    varde: 'skivan plus 20 mm',
    grund: 'Källa',
    stod: 'Gipstillverkaren Norgips, att tänka på innan montering',
    url: NORGIPS,
  },
  {
    storhet: 'Längden genom en stålregel',
    varde: 'skivan plus 10 mm',
    grund: 'Källa',
    stod: 'Norgips, samma sida. Skruven ska gå igenom plåten, inte bara fram till den',
    url: NORGIPS,
  },
  {
    storhet: 'Torr fogtätning',
    varde: 'cirka 7 mm till',
    grund: 'Källa',
    stod: 'Norgips, samma sida. Då tar du närmaste längd över den raden annars anger',
    url: NORGIPS,
  },
  {
    storhet: 'Handelslängderna',
    varde: '25 till 75 mm',
    grund: 'Källa',
    stod: 'Skruvtillverkaren Essve har gipsskruv i hela det spannet som standardvara',
    url: ESSVE_BORRSPETS,
  },
  {
    storhet: 'Stegen över 55 mm',
    varde: '60, 65, 70 och 75 mm',
    grund: 'Antagande',
    stod: 'Min indelning av Essves spann. De behövs bara för två lag 15 mm gips på trä med fogtätning bakom',
  },
  {
    storhet: 'Längdtabellen',
    varde: 'handelslängd per skivkombination',
    grund: 'Källa',
    stod: 'Min egen tabell i guiden om gipsskruv, räknad ur Norgips tumregel och Essves längder',
    url: '/inomhus/gipsskruv/',
  },
  {
    storhet: 'Ett lag 12,5 mm på trä',
    varde: '41 mm, inte 35',
    grund: 'Antagande',
    stod: 'Mitt val. Tumregeln stannar på 32,5 mm, och 35 mm räcker, men marginalen kostar ingenting och i tak tar jag aldrig något kortare',
    url: '/inomhus/gipsskruv/',
  },
  {
    storhet: 'Ett lag 15 mm på stål',
    varde: '30 mm, inte 25',
    grund: 'Antagande',
    stod: 'Mitt val. Minsta längd är 25 mm, precis på gränsen, och 30 mm ger marginal',
    url: '/inomhus/gipsskruv/',
  },
  {
    storhet: 'Den tunna skivan',
    varde: '9,5 mm, kallas 9',
    grund: 'Antagande',
    stod: 'Mina rader. Den skivan står inte i tabellen i guiden, och längden är räknad ur tumregeln på samma sätt som resten',
  },
  {
    storhet: 'Svenskt Trä om längden',
    varde: '30 mm på ett lag',
    grund: 'Källa',
    stod: 'Branschorganisationen Svenskt Trä. Den skruven går 17,5 mm ner i regeln, under de 20 mm Norgips vill ha, och jag följer Norgips',
    url: SVENSKT_TRA,
  },
  {
    storhet: 'Gängan',
    varde: 'grov i trä, fin i stål',
    grund: 'Källa',
    stod: 'Tidningen Gör Det Själv, så väljer du rätt gipsskruv',
    url: GDS,
  },
  {
    storhet: 'Spetsen i trä',
    varde: 'S-spets eller nålspets',
    grund: 'Källa',
    stod: 'Gör Det Själv, samma sida. Båda går rakt in i virket',
    url: GDS,
  },
  {
    storhet: 'Gränsen i plåt',
    varde: '0,9 mm godstjocklek',
    grund: 'Källa',
    stod: 'Gipstillverkaren Gyproc anger högst 0,9 mm för sin skruv QS Quick mot stålprofiler',
    url: GYPROC_QS,
  },
  {
    storhet: 'Nålspets',
    varde: 'plåt 0,4 till 0,9 mm',
    grund: 'Källa',
    stod: 'Essves skruv 522224 i 3,5 × 25 mm, enligt butiken Proffsmagasinet',
    url: PROFFS_522224,
  },
  {
    storhet: 'Borrspets',
    varde: 'plåt 0,7 till 2,0 mm',
    grund: 'Källa',
    stod: 'Essve, gipsskruv med borrspets för stålregel',
    url: ESSVE_BORRSPETS,
  },
  {
    storhet: 'Ytbehandling inomhus',
    varde: 'korrosivitetsklass C1',
    grund: 'Källa',
    stod: 'Fosfaterad och blankförzinkad skruv ligger i C1, klassen för torra inomhusmiljöer, enligt Essve',
    url: ESSVE_BORRSPETS,
  },
  {
    storhet: 'Ytbehandling utomhus',
    varde: 'korrosivitetsklass C4',
    grund: 'Källa',
    stod: 'Essve GU Corrseal är gjord för utegips och ligger i C4',
    url: ESSVE_GU,
  },
  {
    storhet: 'Rostfri A2',
    varde: 'motsvarar C4',
    grund: 'Källa',
    stod: 'Byggvaruhuset Beijer, skruvarnas ytbehandling och korrosivitetsklass',
    url: BEIJER,
  },
  {
    storhet: 'Ytbehandling i våtrum',
    varde: 'C4 eller rostfri A2',
    grund: 'Antagande',
    stod: 'Min hållning. Norgips och Essve kräver inte mer än C1 bakom ett färdigt tätskikt, och jag tar ändå ett steg upp',
    url: NORGIPS_VATRUM,
  },
  {
    storhet: 'Skruvavståndet',
    varde: 'c 200 i kant, c 300 i fält',
    grund: 'Källa',
    stod: 'Norgips och Svenskt Trä, väggens yttersta lag. Antalet skruv räknar du ut i regelkalkylatorn',
    url: NORGIPS,
  },
];

/** Frågorna sist på sidan. Måtten läses ur samma konstanter som svaret. */
const FRAGOR = [
  {
    fraga: 'Hur lång ska gipsskruven vara?',
    svar: `Ta skivans tjocklek och lägg till ${TRA_IN_I_REGEL_MM} millimeter om den ska in i en träregel, eller ${STAL_GENOM_MM} millimeter om den ska igenom en stålregel. Det är tumregeln från gipstillverkaren Norgips, och den ger ett tal som sällan finns i hyllan. Ett lag på 12,5 millimeter landar på 32,5 millimeter i trä, så du tar närmaste längd över. På den raden skriver jag 41 millimeter, för marginalens skull, och i tak går jag aldrig kortare än så.`,
    lank: { text: 'Hela längdtabellen står i guiden om gipsskruv.', href: '/inomhus/gipsskruv/' },
  },
  {
    fraga: 'Vilken gipsskruv ska jag ha till stålregel?',
    svar: `En skruv med fin gänga, alltid. Grov gänga är gjord för virke och snurrar bara runt i plåten utan att ta. Spetsen väljer du efter hur tjock plåten är. Upp till ${String(PLAT_GRANS_MM).replace('.', ',')} millimeter tar en nålspets hål själv, och över det behöver du borrspets. Längden är däremot densamma i tunn och tjock plåt, för det är spetsen som byts och inte skruven.`,
  },
  {
    fraga: 'Behöver jag rostfri gipsskruv i badrummet?',
    svar: 'Bakom ett färdigt tätskikt säger ingen av källorna det. En fosfaterad skruv räcker där enligt både Norgips och Essve. Jag skriver ändå upp ett steg i våtrum, till korrosionsklass C4 eller rostfri A2, eftersom skivan står fuktig i veckor innan tätskiktet är på plats. Utomhus finns det inget att välja på. En fosfaterad skruv ligger i klassen för torra rum och rostar i en fasadvägg.',
  },
];

/** Slug, namn och beskrivning på ett ställe: brödsmulan, og:image och WebApplication läser samma. */
const SLUG = 'gipsskruv';
const VERKTYGSNAMN = 'Vilken gipsskruv';
const BESKRIVNING =
  'Fyll i skivans tjocklek, antal lag och vad regeln är gjord av, så får du gipsskruvens längd som en längd du kan köpa, med rätt gänga för trä eller stål.';
/** Skissen står i kortet Så räknar jag. Huvudet har ingen bild sedan fas C (DESIGN.md 5.8). */
const illustration = verktygsillustration(SLUG);

/*
 * Svarsytan, fas C (spec-designlyft-c-2026-10-02 avsnitt 12). Ny text är
 * hantverkarens. Klartexten har platshållarna {langd} (skruvlängden, "41 mm"),
 * {skiva} (SKIVA_TEXT), {lag} (LAG_TEXT), {regel} (REGEL_TEXT) och {iRegeln}
 * (hur långt skruven går in i regeln, "28,5 mm").
 */
const KLARTEXT =
  'Till {skiva} gips i {lag} på en {regel} behöver du {langd} gipsskruv, och den går {iRegeln} in i regeln. Längden följer Norgips tumregel, gipsets tjocklek plus 20 mm in i trä eller 10 mm genom stål.'; // gipsskruv.klartext
const klartext =
  visat.status === 'ok'
    ? KLARTEXT.replace('{langd}', visat.langdText)
        .replace('{skiva}', SKIVA_TEXT[visatIndata.skiva])
        .replace('{lag}', LAG_TEXT[visatIndata.lag])
        .replace('{regel}', REGEL_TEXT[visatIndata.regel])
        .replace('{iRegeln}', mm(visat.iRegelnMm))
    : '';

/** Läs vidare som kort, i den förra listans ordning. Räknaren får registrets namn som på hubben. */
const LAS_VIDARE = ['/inomhus/gipsskruv/', '/rakna/innervagg/', '/inomhus/bygga-innervagg/'];
const artiklar = [...(await publicerade('guider')), ...(await publicerade('kunskap'))];
const lasVidare: KortData[] = LAS_VIDARE.flatMap((href): KortData[] => {
  const e = artiklar.find((a) => artikelUrl(a) === href);
  if (e) {
    const { niva: _niva, ...kort } = tillKortArtikel(e);
    return [kort];
  }
  const k = hittaKalkylator(href.replace(/^\/rakna\/|\/$/g, ''));
  const pelare = k?.pelare?.[0];
  if (!k || !pelare || !arPelare(pelare)) return [];
  return [
    {
      etikett: 'Räkna själv',
      rubrik: k.namn,
      beskrivning: k.rad,
      pelare,
      href,
      // Artikelrutnat läser inte typen; kortet står varken i ett typfilter eller sorteras.
      typ: 'kunskap',
      sorteringsdatum: new Date(0),
    },
  ];
});
---

<Raknarsida
  slug={SLUG}
  namn={VERKTYGSNAMN}
  titel={titel}
  beskrivning={BESKRIVNING}
  rubrik="Vilken gipsskruv ska du ha? Räkna ut längd och gänga"
  reklam={true}
  butikNamn={butik?.namn}
  delaUrl={delaLank}
>
  <p slot="ingress">
    Det är regeln bakom skivan som bestämmer vilken gipsskruv du ska ha, inte gipset framför den. Fyll i hur
    tjock skivan är, hur många lag du sätter och om regeln är av trä eller stål, så får du en längd som
    faktiskt finns att köpa, rätt gänga och rätt spets. Tumregeln bakom talet är skivans tjocklek plus{' '}
    {mm(TRA_IN_I_REGEL_MM)} in i en träregel. Skruven till en stålregel är en annan skruv, med fin gänga och
    nålspets bara i tunn plåt.
  </p>

  {/* Formuläret ligger i src/components/kalkyl/GipsskruvForm.astro, så att
      <Kalkylator namn="gipsskruv" /> i artikeln visar exakt samma fält. */}
  <GipsskruvForm slot="formular" indata={indata} fel={fel} />

  {
    visat.status === 'ok' && (
      <Fragment slot="svar">
        {resultat.status === 'ogiltig' && (
          <p class="text-liten text-varning">
            Ett av valen gick inte att läsa, så jag visar standardvalen tills du rättat det.
          </p>
        )}
        <Svarstal
          tal={String(visat.langdMm)}
          enhet="mm gipsskruv"
          vad={`${SKIVA_TEXT[visatIndata.skiva]}, ${LAG_TEXT[visatIndata.lag]}, ${REGEL_TEXT[visatIndata.regel]}`}
        />
        <p class="text-liten text-blyerts-2">
          Räknat för {MILJO_TEXT[visatIndata.miljo]}
          {visatIndata.fogtatning ? ' med torr fogtätning bakom skivan' : ''}. Skruven går{' '}
          {mm(visat.iRegelnMm)} in i regeln.
        </p>
        <div class="text-brod">
          <p class="font-bold">{beskedRubrik}</p>
          <p>{beskedRad}</p>
        </div>
        {/* Gänga, spets och ytbehandling. Tre korta rader; skälen står i Därför blev svaret så. */}
        <div class="border-t border-linje">
          <div class="border-b border-linje py-3">
            <p class="text-etikett uppercase text-blyerts-2">Gänga</p>
            <p class="font-bold text-blyerts">{visat.gangaText}</p>
          </div>
          <div class="border-b border-linje py-3">
            <p class="text-etikett uppercase text-blyerts-2">Spets</p>
            <p class="font-bold text-blyerts">{visat.spetsText}</p>
          </div>
          <div class="border-b border-linje py-3">
            <p class="text-etikett uppercase text-blyerts-2">Ytbehandling</p>
            <p class="font-bold text-blyerts">{visat.ytbehandling.kort}</p>
          </div>
        </div>
        <p class="text-liten text-blyerts">{klartext}</p>
      </Fragment>
    )
  }

  {
    visat.status === 'ok' && (
      <Fragment slot="darfor">
        <Pennstreck id="darfor-blev-svaret-sa" utanLuft>
          Därför blev svaret så
        </Pennstreck>
        <div class="darfor">
          <div>
            <p>
              Minsta längd enligt tumregeln är {mm(visat.minstaLangdMm)}, och den närmaste längd som går att köpa är{' '}
              {mm(visat.narmastOverMm)}. Med {visat.langdText} går skruven {mm(visat.iRegelnMm)} in i regeln.
              {visat.alternativMm !== null && (
                <> Den andra längden som också går enligt längdtabellen i guiden är {mm(visat.alternativMm)}.</>
              )}
            </p>
            <p>
              Tumregeln är Norgips, skivan plus 20 mm i trä eller 10 mm genom stål. Handelslängderna är Essves.
              Längdtabellen är min egen i guiden om gipsskruv.
            </p>
          </div>
          {(visat.anm || visat.fogtatningText || !visat.iTabellen) && (
            <div>
              <p>
                {visat.anm}
                {visat.anm && visat.fogtatningText ? ' ' : ''}
                {visat.fogtatningText}
                {!visat.iTabellen && (
                  <>
                    {visat.anm || visat.fogtatningText ? ' ' : ''}
                    Den tunna skivan står inte i längdtabellen i guiden. Raden här är räknad ur tumregeln på samma
                    sätt som de andra.
                  </>
                )}
              </p>
              <p>
                {visat.fogtatningText
                  ? 'Påslaget för torr fogtätning, cirka 7 mm, är Norgips.'
                  : 'Avvikelsen från närmaste längd är mitt val, för marginalens skull.'}
              </p>
            </div>
          )}
          <div>
            <p>
              {visat.gangaSkal} {visat.spetsSkal}
              {visat.spets === 's-eller-nal' && (
                <> S-spets och nålspets är två sorters vass spets, och i virke spelar det ingen roll vilken du tar.</>
              )}
            </p>
            <p>
              Gängan enligt tidningen Gör Det Själv. Gränsen 0,9 mm plåt är Gyprocs, spannen för nål- och
              borrspets är Essves.
            </p>
          </div>
          <div>
            <p>{visat.ytbehandling.text}</p>
            <p>
              Korrosivitetsklasserna är Essves, och att rostfri A2 motsvarar C4 säger byggvaruhuset Beijer. Steget
              upp i våtrum är mitt.
            </p>
          </div>
          <div>
            <p>
              {visat.skruvavstandText} Hur många skruv väggen drar beror på ytan, och det räknar{' '}
              <a href="/rakna/innervagg/" class={LANK_KLASS}>
                regelkalkylatorn
              </a>{' '}
              ut åt dig, med besked om ett band räcker.
            </p>
            <p>Skruvavstånden är Norgips och Svenskt Träs.</p>
          </div>
          <div>
            <p>
              Det jag inte vet är hur din vägg ser ut. Regeln kan vara skev, skivan kan redan sitta uppe, och ska
              väggen brandklassas har den tätare skruvning i alla lag. Står det något annat på förpackningen du
              håller i handen går förpackningen före, för det är den skruven du har.
            </p>
            <p>Ingen källa, bara sunt förnuft.</p>
          </div>
        </div>
      </Fragment>
    )
  }

  {
    visat.status === 'ok' && visat.gorInteDetHar.length > 0 && (
      <Fragment slot="gorInte">
        {/* Flera råd står i samma stycke efter "Gör inte det här.", vart och ett på egen rad. */}
        {visat.gorInteDetHar.map((rad, i) => (
          <span class:list={[i > 0 && 'mt-3 block']}>{rad}</span>
        ))}
      </Fragment>
    )
  }

  <Fragment slot="saRaknarJag">
    {
      illustration && (
        <div class="pappersruta">
          <Illustration
            namn="rakna/gipsskruv"
            alt="Genomskärning av en vägg med träregel och gipsskiva, där skruven går genom skivan och in i regeln."
            bildtext="Skissen visar det verktyget räknar på: en skiva på 12,5 millimeter och sträckan skruven ska gå in i regeln, som är måttsatt."
            class="my-0!"
          />
        </div>
      )
    }
    <ol class="m-0 mt-4 pl-6 list-decimal text-brod">
      <li class="mb-2">Först lägger jag ihop skivorna. Ett lag på 12,5 mm är 12,5, två lag är 25.</li>
      <li class="mb-2">
        Sedan lägger jag på regelns krav, {mm(TRA_IN_I_REGEL_MM)} in i trä eller {mm(STAL_GENOM_MM)} genom stål.
        Det är Norgips tumregel, och summan är minsta längd.
      </li>
      <li class="mb-2">
        Har du torr fogtätning bakom skivan lägger jag till {mm(FOGTATNING_MM)}, och svaret flyttas ett steg upp i
        längdlistan.
      </li>
      <li class="mb-2">
        Minsta längd finns sällan att köpa, så jag tar en handelslängd. Längden per skivkombination kommer från
        tabellen i min guide om gipsskruv, som i sin tur är räknad ur tumregeln och Essves längder.
      </li>
      <li class="mb-2">
        Två rader i tabellen skiljer sig medvetet från närmaste längd, och det står vid raden. Ett lag 12,5 mm på
        trä får 41 mm i stället för 35, och ett lag 15 mm på stål får 30 mm i stället för 25. Båda handlar om
        marginal.
      </li>
      <li class="mb-2">
        Gängan följer regeln, grov i trä och fin i stål. Spetsen följer underlaget, och i plåt går gränsen vid{' '}
        {mm(PLAT_GRANS_MM)} godstjocklek.
      </li>
      <li>
        Ytbehandlingen följer miljön. Ett torrt rum ger korrosivitetsklass C1, utomhus ger C4, och i våtrum säger
        jag C4 fastän källorna nöjer sig med C1 bakom ett färdigt tätskikt.
      </li>
    </ol>
  </Fragment>

  <Fragment slot="efter">
    {/* Antagandetabellen i läsbredd, ur kortet Så räknar jag (spec-designlyft-c avsnitt 9). */}
    <section class="max-w-lasbredd">
      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">Vad siffrorna vilar på</h3>
      <Tabellyta kolumner={3} class="mt-4">
        <table class="w-full border-collapse text-liten tabular-nums">
          <caption class="sr-only">Tumregler, tillverkarvärden, källor och antaganden i skruvväljaren</caption>
          <thead>
            <tr class="border-b border-linje text-left">
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Mått eller regel</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Jag räknar med</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Källa eller antagande</th>
            </tr>
          </thead>
          <tbody>
            {
              antaganden.map((a) => (
                <tr>
                  <th scope="row" class:list={[CELL_KLASS, 'text-left font-normal']}>
                    {a.storhet}
                  </th>
                  <td class={CELL_KLASS}>{a.varde}</td>
                  <td class={CELL_KLASS}>
                    {a.grund}.{' '}
                    {a.url ? (
                      <a href={a.url} rel={a.url.startsWith('/') ? undefined : 'nofollow'} class={LANK_KLASS}>
                        {a.stod}
                      </a>
                    ) : (
                      a.stod
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </Tabellyta>

      <p class="m-0 mt-6 text-brod lg:text-brod-lg">
        Ingenting på den här sidan är mätt av mig. Talen kommer från tillverkarnas egna webbsidor, från Svenskt Trä
        och från Essve, och de står länkade rad för rad, så du kan gå till källan och läsa själv. Vilka källor jag
        litar på och varför står på sidan <a href="/om/sa-testar-vi/" class={LANK_KLASS}>Så testar jag</a>.
      </p>
    </section>

    <section class="max-w-lasbredd">
      <Pennstreck id="skruven-och-maskinen">Skruven och maskinen som svaret pekar på</Pennstreck>
      <p class="m-0 mb-4 text-brod lg:text-brod-lg">
        {
          visat.status === 'ok' && visat.visaBandadSkruv
            ? 'Svaret är en skruv som finns i band, och band är hela poängen när en vägg ska klä sig själv på en förmiddag.'
            : 'Den här längden köper du lös i påse. Bandet i butiken är 41 mm för träregel, inte den skruv du fick, men maskinen matar hela spannet.'
        }
      </p>
      <div class="grid gap-4 lg:grid-cols-2">
        {
          visat.status === 'ok' && visat.visaBandadSkruv && (
            <Produktkort
              produkt="essve-fzb-39x41"
              variant="kompakt"
              modul="kalkylator"
              forVem="Det är den här skruven: 3,9 × 41 mm med grov gänga, rakbandad för träregel inomhus."
            />
          )
        }
        <Produktkort
          produkt="makita-dfr550zx1"
          variant="kompakt"
          modul="kalkylator"
          forVem="Från ungefär 300 skruv lönar sig en automat."
        />
      </div>
      <p class="m-0 mt-4 text-liten text-blyerts-2">
        Bandet passar bara träregel. Har du en stålstomme skruvar du för hand, och bandet får vänta till nästa bygge.
      </p>
    </section>

    <section class="max-w-lasbredd">
      <Pennstreck id="gipsskruv-langd">Så lång ska gipsskruven vara i en träregel</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        Gipset håller ingenting. Skivan hänger i skruvarna, och skruvarna sitter i regeln bakom. Regeln är den
        stående trä- eller stålbiten som skivan skruvas fast i. Därför är det regeln som bestämmer både längden och
        gängan, och därför frågar formuläret om regeln och inte bara om skivan.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Längden räknar du rakt fram. Gipstillverkaren Norgips vill att skruven går {mm(TRA_IN_I_REGEL_MM)} in i en
        träregel, och de millimetrarna lägger du till skivans tjocklek. Ett lag på 12,5 mm hamnar då på 32,5 mm, och
        den längden finns inte i hyllan. Du tar närmaste handelslängd över, 35 mm, och ändå skriver jag 41 mm
        på den raden. Skillnaden kostar ingenting och köper marginal för en regel som är skev.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Två lag ändrar allt. Nu är det 25 mm gips att ta sig igenom innan skruven ens når virket, och då är 45 mm den
        första längden som räcker. Det är hela förklaringen till att en vägg med dubbla skivor kräver en annan
        skruv. Det är också där den vanligaste besvikelsen sitter, för bandet i väskan är kvar från förra bygget.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Har du torr fogtätning bakom skivan lägger Norgips på cirka {mm(FOGTATNING_MM)}. Torr fogtätning är remsor
        som tätar mot ljud och drag i stället för fogmassa. Då flyttas hela raden ett steg upp, och det vill du veta
        innan du bär hem tusen skruvar.
      </p>

      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">
        Gipsskruv till stålregel, gränsen går vid 0,9 mm plåt
      </h3>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        I stål blir skruven kortare. Norgips vill bara att den går {mm(STAL_GENOM_MM)} genom plåten, för det finns
        inget virke att gänga sig fast i, så ett lag på 12,5 mm landar på 25 mm. Samtidigt byter du gänga. Grov
        gänga är gjord för trä och snurrar runt i en stålprofil utan att ta, och tidningen Gör Det Själv skriver rakt
        ut att stål ska ha fin gänga.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Sedan kommer spetsen, och där finns bara ett tal att hålla reda på. Gyproc anger högst {mm(PLAT_GRANS_MM)}{' '}
        godstjocklek för sin skruv mot stålprofiler. Godstjockleken är hur tjock själva plåten är. Under den gränsen
        tar en nålspets hål själv, och Essve anger sin nålspetsskruv för plåt från {mm(NALSPETS_PLAT_MM[0])} till{' '}
        {mm(NALSPETS_PLAT_MM[1])}. Över gränsen tar nålen inte hål hur hårt du än trycker, och då gäller borrspets,
        som Essve anger för {mm(BORRSPETS_PLAT_MM[0])} till {mm(BORRSPETS_PLAT_MM[1])}. Längden ändras däremot inte
        av plåtens tjocklek, för det är bara spetsen som byts.
      </p>
    </section>

    {
      lasVidare.length > 0 && (
        <section>
          <Pennstreck id="las-vidare">Läs vidare</Pennstreck>
          <Artikelrutnat kort={lasVidare} visaBeskrivning={false} visaMeta={false} />
        </section>
      )
    }

    <div class="max-w-lasbredd">
      <Faq fragor={FRAGOR} />
    </div>
  </Fragment>
</Raknarsida>
