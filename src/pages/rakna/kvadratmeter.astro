---
/**
 * Kvadratmeter- och åtgångsräknaren. Formuläret skickas som GET till samma sida
 * och beräkningen sker på servern, så sidan fungerar utan ett enda byte
 * klient-JS. Kostnaden är en serverfunktion per anrop, och den hålls nere med
 * CDN-cache. Se docs/SPEC-SIDMALLAR.md avsnitt 4.7.
 *
 * Formeln och alla antaganden ligger i src/lib/kalkyl/kvadratmeter.ts, och
 * källan bakom varje konstant står i
 * docs/briefer/underlag-kalkyl-kvadratmeter-2026-09-17.md. Sidan räknar
 * ingenting själv, den visar bara resultatet och redovisar källorna.
 *
 * Varken färg, tapet eller golv finns i produktdatabasen, så sidan har varken
 * produktkort eller reklamband.
 */
export const prerender = false;

import { formateraTal } from '../../lib/format';
import {
  BURKAR_LITER,
  DORR_BREDD_M,
  DORR_HOJD_M,
  FARG_KVM_PER_LITER,
  FONSTER_BREDD_M,
  FONSTER_HOJD_M,
  GRUNDFARG_KVM_PER_LITER,
  OVERSKOTT_GRANS,
  raknaKvadratmeter,
  SPILL_GOLV,
  SPILL_KLINKER,
  STANDARD,
  TAKFARG_KVM_PER_LITER,
  TAPET_PASLAG_M,
  TAPET_RAPPORT_M,
  TAPETRULLE_BREDD_M,
  TAPETRULLE_LANGD_M,
  tolkaQuery,
  type Burk,
  type KvadratmeterIndata,
  type KvadratmeterResultat,
} from '../../lib/kalkyl/kvadratmeter';
import { artikelUrl, publicerade } from '../../lib/innehall';
import { tillKortArtikel, type KortData } from '../../lib/kort';
import { hittaKalkylator } from '../../lib/kalkyl/register';
import { CELL_KLASS, LANK_KLASS } from '../../lib/kalkyl/stil';
import { arPelare } from '../../lib/pelare';
import { verktygsillustration } from '../../lib/verktygsbild';
import KvadratmeterForm from '../../components/kalkyl/KvadratmeterForm.astro';
import Artikelrutnat from '../../components/ui/Artikelrutnat.astro';
import Faq from '../../components/ui/Faq.astro';
import Pennstreck from '../../components/ui/Pennstreck.astro';
import Svarstal from '../../components/ui/Svarstal.astro';
import Tabellyta from '../../components/ui/Tabellyta.astro';
import Illustration from '../../components/ui/Illustration.astro';
import Raknarsida from '../../components/vyer/Raknarsida.astro';

Astro.locals.sidtyp = 'verktyg';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

const q = Astro.url.searchParams;
const { indata } = tolkaQuery(q);
const resultat = raknaKvadratmeter(indata);

const fel = resultat.status === 'ogiltig' ? resultat.fel : {};
// Vid ogiltig indata visas standardvärdenas resultat, med en rad som säger det.
const visat: KvadratmeterResultat = resultat.status === 'ogiltig' ? raknaKvadratmeter(STANDARD) : resultat;
const visatIndata: KvadratmeterIndata = resultat.status === 'ogiltig' ? STANDARD : indata;

const komma = (n: number) => String(n).replace('.', ',');

/** Tal i löptext: hela tal utan decimal, annars en eller två. "12", "2,6", "31,67". */
function talText(n: number): string {
  const rundat = Math.round(n * 100) / 100;
  if (Number.isInteger(rundat)) return formateraTal(rundat);
  if (Math.abs(Math.round(rundat * 10) / 10 - rundat) < 1e-9) return formateraTal(rundat, 1);
  return formateraTal(rundat, 2);
}

/**
 * Fältens värden kommer från query-strängen som den skrevs, inte från de tolkade
 * talen: "fyra" eller "" blir NaN i tolkaQuery, och NaN i ett fält som läsaren
 * ska rätta är obrukbart.
 */
function faltVarde(nyckel: string, standardVarde: number): string {
  const ra = q.get(nyckel);
  if (ra !== null) return ra;
  return komma(standardVarde);
}

const varden = {
  langd: faltVarde('langd', STANDARD.langdM),
  bredd: faltVarde('bredd', STANDARD.breddM),
  takhojd: faltVarde('takhojd', STANDARD.takhojdM),
  dorrar: faltVarde('dorrar', STANDARD.dorrar),
  dorrbredd: faltVarde('dorrbredd', STANDARD.dorrBreddM),
  dorrhojd: faltVarde('dorrhojd', STANDARD.dorrHojdM),
  fonster: faltVarde('fonster', STANDARD.fonster),
  fonsterbredd: faltVarde('fonsterbredd', STANDARD.fonsterBreddM),
  fonsterhojd: faltVarde('fonsterhojd', STANDARD.fonsterHojdM),
  strykningar: faltVarde('strykningar', STANDARD.strykningar),
  paket: q.get('paket') ?? '',
};

/**
 * Delbar länk. Hela tillståndet ligger redan i query-strängen, så adressen är
 * uträkningen. Den byggs av de tolkade värdena, inte av strängen läsaren skrev,
 * och varje val skrivs ut, även de som kom från standardvalet.
 */
const delaQuery = new URLSearchParams({
  langd: komma(visatIndata.langdM),
  bredd: komma(visatIndata.breddM),
  takhojd: komma(visatIndata.takhojdM),
  dorrar: String(visatIndata.dorrar),
  dorrbredd: komma(visatIndata.dorrBreddM),
  dorrhojd: komma(visatIndata.dorrHojdM),
  fonster: String(visatIndata.fonster),
  fonsterbredd: komma(visatIndata.fonsterBreddM),
  fonsterhojd: komma(visatIndata.fonsterHojdM),
  raknar: visatIndata.raknar,
  material: visatIndata.material,
  strykningar: String(visatIndata.strykningar),
  laggning: visatIndata.laggning,
});
if (visatIndata.paketKvm !== null) delaQuery.set('paket', komma(visatIndata.paketKvm));
const delaLank = new URL(`/rakna/kvadratmeter/?${delaQuery.toString()}`, Astro.site ?? Astro.url).toString();

/** Räkneord för de små talen, så att "1 burkar" aldrig kan uppstå. */
const RAKNEORD = ['ingen', 'en', 'två', 'tre', 'fyra', 'fem', 'sex', 'sju', 'åtta', 'nio', 'tio'];

/** "tre burkar om 2,5 liter och en om 1 liter". */
function burkRad(burkar: Burk[]): string {
  const delar = burkar.map((b, index) => {
    const ord = RAKNEORD[b.antal] ?? formateraTal(b.antal);
    const ordet = b.antal === 1 ? 'burk' : 'burkar';
    return index === 0
      ? `${ord} ${ordet} om ${talText(b.literPerBurk)} liter`
      : `${ord} om ${talText(b.literPerBurk)} liter`;
  });
  if (delar.length <= 1) return delar[0] ?? '';
  return `${delar.slice(0, -1).join(', ')} och ${delar[delar.length - 1]}`;
}

/**
 * "En dörr räknad som 0,9 × 2,1 m", "två dörrar räknade som ...". Raden står
 * bredvid avdraget, och ett tal i fel numerus läser sämre än ett tal i ord.
 */
function avdragRad(
  antal: number,
  ord: { noll: string; ental: string; flertal: string },
  breddM: number,
  hojdM: number,
): string {
  const mattet = `${talText(breddM)} × ${talText(hojdM)} m`;
  if (antal === 0) return ord.noll;
  const raknat = RAKNEORD[antal] ?? formateraTal(antal);
  const inledning =
    antal === 1 ? ord.ental : `${raknat.charAt(0).toUpperCase()}${raknat.slice(1)} ${ord.flertal}`;
  return `${inledning} som ${mattet} drar bort`;
}

const MATERIALTEXT: Record<KvadratmeterIndata['material'], string> = {
  inget: 'inget material valt',
  vaggfarg: 'väggfärg',
  takfarg: 'takfärg',
  tapet: 'tapet',
  parkett: 'parkett eller laminat',
  klinker: 'klinker eller kakel',
};

/** Tal ur resultatet, färdigformaterade, så att markupen nedan blir läsbar. */
const tal =
  visat.status === 'ok'
    ? {
        golv: talText(visat.golvKvm),
        tak: talText(visat.takKvm),
        omkrets: talText(visat.omkretsM),
        brutto: talText(visat.vaggarBruttoKvm),
        avdragDorr: talText(visat.avdragDorrKvm),
        avdragFonster: talText(visat.avdragFonsterKvm),
        avdrag: talText(visat.avdragKvm),
        netto: talText(visat.vaggarNettoKvm),
        vald: talText(visat.valdKvm),
        langd: talText(visatIndata.langdM),
        bredd: talText(visatIndata.breddM),
        takhojd: talText(visatIndata.takhojdM),
        dorrar: formateraTal(visatIndata.dorrar),
        fonster: formateraTal(visatIndata.fonster),
        strykningar: formateraTal(visatIndata.strykningar),
      }
    : null;

/** Beskedet överst i spalten: vad du ska köpa, och en rad om vad det bygger på. */
const besked = (() => {
  if (visat.status !== 'ok' || !tal) return { rubrik: '', rad: '' };
  if (visat.farg) {
    return {
      rubrik: `Köp ${talText(visat.farg.literAttKopa)} liter färg, ${burkRad(visat.farg.burkar)}.`,
      rad: `Det räcker till ${tal.strykningar} strykningar på ${talText(visat.farg.ytaKvm)} kvm, det vill säga ${visat.farg.ytaNamn}.`,
    };
  }
  if (visat.tapet) {
    return {
      rubrik: `Köp ${formateraTal(visat.tapet.rullar)} tapetrullar, eller ${formateraTal(visat.tapet.rullarMonster)} om mönstret ska passas.`,
      rad: `Det blir ${formateraTal(visat.tapet.antalVader)} våder på de ${talText(visat.tapet.vaderBreddM)} meter vägg som ska tapetseras.`,
    };
  }
  if (visat.golv) {
    const paket =
      visat.golv.antalPaket !== null ? `, och det är ${formateraTal(visat.golv.antalPaket)} paket` : '';
    return {
      rubrik: `Köp ${talText(visat.golv.kvmAttKopa)} kvm golv${paket}.`,
      rad: `Det är golvets ${talText(visat.golv.ytaKvm)} kvm med ${formateraTal(visat.golv.spillProcent)} procent spill pålagt.`,
    };
  }
  return {
    rubrik: `Rummet har ${tal.golv} kvm golv, ${tal.netto} kvm vägg efter avdrag och ${tal.tak} kvm tak.`,
    rad: 'Välj vad ytan ska täckas med, så säger jag hur mycket du ska köpa.',
  };
})();

const titel = 'Räkna ut kvadratmeter, färg, tapet och golv';

/** Antagandena i tabellen under "Så räknar vi". Samma tal som konstanterna i kalkylen. */
const BECKERS_VAGG = 'https://beckers.se/produkter/scotte-7';
const BECKERS_TAK = 'https://beckers.se/produkter/scotte-r2-takfarg';
const BECKERS_GRUND = 'https://beckers.se/produkter/scotte-grund';
const ALCRO =
  'https://www.alcrostudio.se/sv-SE/pro/product/Milltex%207%20Matt%20T%C3%A4ckf%C3%A4rg/221002ASE20133';
const NORDSJO = 'https://www.nordsjoprofessional.se/sv/produkter/nordsj%C3%B6-ambiance-smooth-silk';
const BORASTAPETER = 'https://www.borastapeter.com/guider-sjalvhjalp/tapetkalkylator';
const KAHRS = 'https://www.kahrs.com/se/b2b/fragor-och-svar/fragor-om-golv';
const PERGO =
  'https://www.pergogolv.se/sv-se/vanliga-fragor/laminatgolv/lagga/hur-mycket-golv-behover-jag-till-mitt-rum';
const HOGANAS = 'https://www.hoganaskakel.se/faq-renovering-montering/';
const SWEDOOR = 'https://www.swedoor.se/tips-och-rad/mattabeller-innerdorrar';

const antaganden: { storhet: string; varde: string; grund: 'Källa' | 'Antagande'; stod: string; url?: string }[] = [
  {
    storhet: 'Hur långt väggfärgen räcker',
    varde: `${formateraTal(FARG_KVM_PER_LITER)} kvm per liter och strykning`,
    grund: 'Källa',
    stod: 'Färgtillverkaren Beckers anger 8 till 10 kvm per liter för Scotte 7. Jag räknar med den nedre kanten',
    url: BECKERS_VAGG,
  },
  {
    storhet: 'Samma tal hos en tillverkare till',
    varde: '8 till 10 kvm per liter',
    grund: 'Källa',
    stod: 'Färgtillverkaren Alcro anger 8 kvm per liter för Milltex 7 Matt Täckfärg',
    url: ALCRO,
  },
  {
    storhet: 'Och hos den tredje',
    varde: '8 till 10 kvm per liter',
    grund: 'Källa',
    stod: 'Färgtillverkaren Nordsjö anger 8 till 10 kvm per liter för Ambiance Smooth Silk',
    url: NORDSJO,
  },
  {
    storhet: 'Hur långt takfärgen räcker',
    varde: `${formateraTal(TAKFARG_KVM_PER_LITER)} kvm per liter och strykning`,
    grund: 'Källa',
    stod: 'Beckers Scotte R2 Takfärg anger 8 kvm per liter, och Alcros Milltex 2 RF samma tal',
    url: BECKERS_TAK,
  },
  {
    storhet: 'Hur långt grundfärgen räcker',
    varde: `${formateraTal(GRUNDFARG_KVM_PER_LITER)} kvm per liter`,
    grund: 'Källa',
    stod: 'Beckers Scotte Grund anger 6 till 8 kvm per liter, mindre än täckfärgen. Jag räknar med mitten',
    url: BECKERS_GRUND,
  },
  {
    storhet: 'Burkstorlekarna',
    varde: `${BURKAR_LITER.map((b) => talText(b)).join(', ')} liter`,
    grund: 'Antagande',
    stod: 'De storlekar inomhusfärg säljs i hos de svenska kedjorna. Vissa serier har också 3 och 5 liter',
  },
  {
    storhet: 'Hur burkarna väljs',
    varde: `Högst ${formateraTal(OVERSKOTT_GRANS * 100)} procent över`,
    grund: 'Antagande',
    stod: 'Bland de kombinationer som lämnar högst så mycket över tar jag den med minst antal burkar, och vid lika antal den som lämnar minst över',
  },
  {
    storhet: 'Tapetrullens mått',
    varde: `${talText(TAPETRULLE_BREDD_M)} × ${talText(TAPETRULLE_LANGD_M)} m`,
    grund: 'Källa',
    stod: 'Tapettillverkaren Boråstapeter anger 53 cm bredd och 10,05 m längd som det normala måttet',
    url: BORASTAPETER,
  },
  {
    storhet: 'Mönsterrapporten',
    varde: `${formateraTal(TAPET_RAPPORT_M * 100)} cm`,
    grund: 'Antagande',
    stod: 'Boråstapeters kollektioner ligger mellan 17,67 och 64 cm. Läs av rapporten på din egen rulle',
    url: BORASTAPETER,
  },
  {
    storhet: 'Påslaget per våd',
    varde: `${formateraTal(TAPET_PASLAG_M * 100)} cm`,
    grund: 'Antagande',
    stod: 'Fem centimeter i topp och botten för kap. Talet ger fyra våder per rulle vid 2,4 m takhöjd',
  },
  {
    storhet: 'Vad tapeten drar av',
    varde: 'Dörren, inte fönstret',
    grund: 'Antagande',
    stod: 'En dörr tar bort hela våder. Tapeten ska ändå upp ovanför och ner under ett fönster',
  },
  {
    storhet: 'Spill på parkett och laminat',
    varde: `${formateraTal(SPILL_GOLV.rak * 100)} procent rakt lagt`,
    grund: 'Källa',
    stod: 'Golvtillverkaren Kährs anger cirka 5 procent, och 7 till 10 procent vid komplexa mönster',
    url: KAHRS,
  },
  {
    storhet: 'Samma tal för laminat',
    varde: `${formateraTal(SPILL_GOLV.diagonal * 100)} procent diagonalt`,
    grund: 'Källa',
    stod: 'Golvtillverkaren Pergo anger 5 procent i ett vanligt rum och 10 procent i ett rum med svåra ytor',
    url: PERGO,
  },
  {
    storhet: 'Spill på kakel och klinker',
    varde: `${formateraTal(SPILL_KLINKER.rak * 100)} och ${formateraTal(SPILL_KLINKER.diagonal * 100)} procent`,
    grund: 'Källa',
    stod: 'Plattillverkaren Höganäs anger 10 till 15 procent spill. Det övre talet tar jag när plattorna läggs diagonalt, för då kapas varje rad i båda ändar',
    url: HOGANAS,
  },
  {
    storhet: 'Dörröppningens mått',
    varde: `${talText(DORR_BREDD_M)} × ${talText(DORR_HOJD_M)} m`,
    grund: 'Källa',
    stod: 'Dörrtillverkaren Swedoor anger 910 × 2110 mm som öppningsmått för den vanligaste innerdörren',
    url: SWEDOOR,
  },
  {
    storhet: 'Fönstrets mått',
    varde: `${talText(FONSTER_BREDD_M)} × ${talText(FONSTER_HOJD_M)} m`,
    grund: 'Antagande',
    stod: 'Modulsystemet är en standard, men vilket mått som är vanligast i svenska bostäder är min gissning',
  },
  {
    storhet: 'Rummets form',
    varde: 'En rektangel',
    grund: 'Antagande',
    stod: 'Ett vinklat rum delar du upp i två rektanglar, räknar en åt gången och lägger ihop talen',
  },
];

/** Frågorna sist på sidan. Talen är desamma som i brödtexten och i tabellen. */
const FRAGOR = [
  {
    fraga: 'Hur räknar jag ut kvadratmeter på en vägg?',
    svar: 'Ta rummets omkrets gånger takhöjden, och dra sedan av dörrar och fönster. Ett rum på fyra gånger tre meter har omkretsen fjorton meter, och med takhöjden 2,5 m blir väggarna 35 kvm före avdrag. En innerdörr tar bort 1,89 kvm och ett fönster på 1,2 gånger 1,2 m tar bort 1,44 kvm. Kvar blir knappt 32 kvm, och det är den ytan färgen ska räcka till.',
  },
  {
    fraga: 'Hur mycket färg går det åt per kvadratmeter?',
    svar: 'En liter räcker till mellan åtta och tio kvadratmeter per strykning. Beckers och Nordsjö anger båda det spannet för sina väggfärger, och Alcro anger åtta. Räkna med åtta kvadratmeter per liter, så räcker färgen även på en spacklad vägg som suger. Ska väggen målas två gånger dubblar du talet, och en grundstrykning på obehandlat underlag drar ännu mer.',
  },
  {
    fraga: 'Hur många tapetrullar behöver jag till ett rum?',
    svar: 'Räkna våder, inte kvadratmeter. En rulle är 53 cm bred och 10,05 m lång enligt tapettillverkaren Boråstapeter, och varje våd är takhöjden plus tio centimeter för kap. Vid 2,5 m takhöjd får du tre våder ur en rulle. Har tapeten ett mönster som ska passas kapar du våden vid en hel rapport, och då kan en rulle tappa en hel våd.',
  },
];

/** Slug, namn och beskrivning på ett ställe: brödsmulan, og:image och WebApplication läser samma. */
const SLUG = 'kvadratmeter';
const VERKTYGSNAMN = 'Kvadratmeterräknare';
const BESKRIVNING =
  'Räkna ut kvadratmeter på golv, väggar och tak med dörren och fönstret avdragna, och se hur många liter färg, tapetrullar eller kvm golv du ska köpa.';
/** Skissen står i kortet Så räknar jag. Huvudet har ingen bild sedan fas C (DESIGN.md 5.8). */
const illustration = verktygsillustration(SLUG);

/*
 * Svarsytan, fas C (spec-designlyft-c-2026-10-02 avsnitt 12): golvytan är det
 * första talet, och de andra ytorna och mängderna står som rader under
 * beskedet. Ny text är hantverkarens. Klartexten har platshållarna {golv}
 * (kvm), {langd}, {bredd} och {takhojd} (m), {vaggar} (kvm vägg efter
 * avdrag) och {tak} (kvm).
 */
const SVAR_VAD = 'golvytan i rummet'; // kvadratmeter.svar.vad
const KLARTEXT =
  'Ett rum på {langd} × {bredd} m med {takhojd} m i takhöjd har {golv} kvm golv och lika mycket tak. Dörr och fönster tar bort {avdrag} kvm, så väggarna blir {vaggar} kvm.'; // kvadratmeter.klartext
const klartext = tal
  ? KLARTEXT.replace('{golv}', tal.golv)
      .replace('{langd}', tal.langd)
      .replace('{bredd}', tal.bredd)
      .replace('{takhojd}', tal.takhojd)
      .replace('{vaggar}', tal.netto)
      .replace('{avdrag}', tal.avdrag)
      .replace('{tak}', tal.tak)
  : '';

/** Läs vidare som kort, i den förra listans ordning. Räknarna får registrets namn som på hubben. */
const LAS_VIDARE = ['/rakna/fasadyta/', '/inomhus/bygga-innervagg/', '/kok/slipa-bankskiva/', '/rakna/innervagg/'];
const artiklar = [...(await publicerade('guider')), ...(await publicerade('kunskap'))];
const lasVidare: KortData[] = LAS_VIDARE.flatMap((href): KortData[] => {
  const e = artiklar.find((a) => artikelUrl(a) === href);
  if (e) {
    const { niva: _niva, ...kort } = tillKortArtikel(e);
    return [kort];
  }
  const k = hittaKalkylator(href.replace(/^\/rakna\/|\/$/g, ''));
  const pelare = k?.pelare?.[0];
  if (!k || !pelare || !arPelare(pelare)) return [];
  return [
    {
      etikett: 'Räkna själv',
      rubrik: k.namn,
      beskrivning: k.rad,
      pelare,
      href,
      // Artikelrutnat läser inte typen; kortet står varken i ett typfilter eller sorteras.
      typ: 'kunskap',
      sorteringsdatum: new Date(0),
    },
  ];
});
---

<Raknarsida
  slug={SLUG}
  namn={VERKTYGSNAMN}
  titel={titel}
  beskrivning={BESKRIVNING}
  rubrik="Räkna ut kvadratmeter så att färgen, tapeten eller golvet räcker"
  delaUrl={delaLank}
>
  <p slot="ingress">
    Mät rummets längd, bredd och takhöjd och skriv in dem här, så får du golvet, väggarna och taket i
    kvadratmeter. Dörren och fönstret drar jag av, för de ska inte målas. Väljer du sedan vad ytan ska täckas
    med får du också hur många liter färg, hur många tapetrullar eller hur mycket golv du ska köpa, med spill
    inräknat. Åtgången kommer från färg- och golvtillverkarnas egna uppgifter.
  </p>

  {/* Formuläret ligger i src/components/kalkyl/KvadratmeterForm.astro, så att
      <Kalkylator namn="kvadratmeter" /> i en artikel visar exakt samma fält. */}
  <KvadratmeterForm slot="formular" indata={indata} varden={varden} fel={fel} />

  {
    visat.status === 'ok' && tal && (
      <Fragment slot="svar">
        {resultat.status === 'ogiltig' && (
          <p class="text-liten text-varning">
            Ett av fälten gick inte att läsa, så jag visar standardvärdena tills du rättat det.
          </p>
        )}
        <Svarstal tal={tal.golv} enhet="kvm" vad={SVAR_VAD} />
        <div class="text-brod">
          <p class="font-bold">{besked.rubrik}</p>
          <p>{besked.rad}</p>
        </div>
        {/* De andra ytorna och mängderna, en rad var med talet först, som förut. */}
        <div class="flex flex-col gap-1 tabular-nums">
          <p class="text-liten text-blyerts-2">
            Rum på {tal.langd} × {tal.bredd} m, takhöjd {tal.takhojd} m, {MATERIALTEXT[visatIndata.material]}
          </p>
          <p>
            <span class="font-serif text-h2 text-blyerts">{tal.vald}</span>{' '}kvm {visat.valdNamn}
          </p>
          {visat.farg && (
            <p>
              <span class="font-serif text-h2 text-blyerts">{talText(visat.farg.literAttKopa)}</span>{' '}liter färg att köpa
            </p>
          )}
          {visat.tapet && (
            <p>
              <span class="font-serif text-h2 text-blyerts">{formateraTal(visat.tapet.rullar)}</span>{' '}tapetrullar
            </p>
          )}
          {visat.golv && (
            <p>
              <span class="font-serif text-h2 text-blyerts">{talText(visat.golv.kvmAttKopa)}</span>{' '}kvm golv att köpa
            </p>
          )}
        </div>
        <p class="text-liten text-blyerts">{klartext}</p>
      </Fragment>
    )
  }

  {
    visat.status === 'ok' && tal && (
      <Fragment slot="darfor">
        <Pennstreck id="darfor-blev-svaret-sa" utanLuft>
          Därför blev svaret så
        </Pennstreck>
        <div class="darfor tabular-nums">
          <div>
            <p>
              Golvet mäter {tal.golv} kvm, och taket är lika stort. Omkretsen är {tal.omkrets} m, och gånger
              takhöjden ger det {tal.brutto} kvm vägg före avdrag.
            </p>
            <p>Bara dina tre mått, multiplicerade med varandra.</p>
          </div>
          <div>
            <p>
              {avdragRad(
                visatIndata.dorrar,
                { noll: 'Du har inte fyllt i någon dörr, så där blir det inget avdrag', ental: 'En dörr räknad', flertal: 'dörrar räknade' },
                visatIndata.dorrBreddM,
                visatIndata.dorrHojdM,
              ) +
                (visatIndata.dorrar > 0 ? ` ${tal.avdragDorr} kvm` : '') +
                '. ' +
                avdragRad(
                  visatIndata.fonster,
                  {
                    noll: 'Du har inte fyllt i något fönster, så där blir det inget avdrag',
                    ental: 'Ett fönster räknat',
                    flertal: 'fönster räknade',
                  },
                  visatIndata.fonsterBreddM,
                  visatIndata.fonsterHojdM,
                ) +
                (visatIndata.fonster > 0 ? ` ${tal.avdragFonster} kvm` : '') +
                `. Väggarna efter avdrag blir ${tal.netto} kvm.`}
            </p>
            <p>
              Dörrmåttet är Swedoors öppningsmått för den vanligaste innerdörren, avrundat. Fönstermåttet är min
              gissning tills du skriver in ditt eget.
            </p>
          </div>

          {visat.farg && (
            <>
              <div>
                <p>
                  Färgen ska täcka {talText(visat.farg.ytaKvm)} kvm, {visat.farg.ytaNamn}. {tal.strykningar}{' '}
                  strykningar ger {talText(visat.farg.literRaknat)} liter räknat, och det blir{' '}
                  {burkRad(visat.farg.burkar)} att köpa.
                </p>
                <p>
                  8 kvm per liter och strykning enligt Beckers, Alcro och Nordsjö. Valet av burkar är min regel om
                  högst 30 procent över.
                </p>
              </div>
              <div>
                <p>
                  Är underlaget obehandlat går det {talText(visat.farg.grundLiterRaknat)} liter grundfärg till, och
                  det blir {burkRad(visat.farg.grundBurkar)}.
                </p>
                <p>7 kvm per liter, mitten av Beckers 6 till 8.</p>
              </div>
            </>
          )}

          {visat.tapet && (
            <>
              <div>
                <p>
                  {formateraTal(visat.tapet.antalVader)} våder täcker de {talText(visat.tapet.vaderBreddM)} m vägg
                  som ska tapetseras (omkretsen utan dörröppningarna). Varje våd blir{' '}
                  {talText(visat.tapet.vadLangdM)} m lång, så det går {formateraTal(visat.tapet.vaderPerRulle)}{' '}
                  våder ur en rulle.
                </p>
                <p>Rullen är 0,53 × 10,05 m enligt Boråstapeter. Påslaget 10 cm per våd är mitt.</p>
              </div>
              <div>
                <p>
                  Ska mönstret passas blir våden {talText(visat.tapet.vadLangdMonsterM)} m, och då behöver du{' '}
                  {formateraTal(visat.tapet.rullarMonster)} rullar.
                </p>
                <p>Rapporten 53 cm är min gissning. Läs av din egen på rullen.</p>
              </div>
            </>
          )}

          {visat.golv && (
            <div>
              <p>
                Jag lägger på {formateraTal(visat.golv.spillProcent)} procent spill på golvets{' '}
                {talText(visat.golv.ytaKvm)} kvm.{' '}
                {visat.golv.antalPaket !== null && visat.golv.paketKvm !== null ? (
                  <>
                    Med paket om {talText(visat.golv.paketKvm)} kvm blir det {formateraTal(visat.golv.antalPaket)}{' '}
                    paket, och {talText(visat.golv.kvmIPaketen ?? 0)} kvm hem.
                  </>
                ) : (
                  <>Fyll i hur många kvadratmeter det är i ett paket, så räknar jag om talet till antal paket.</>
                )}
              </p>
              <p>
                {visatIndata.material === 'klinker'
                  ? 'Höganäs anger 10 till 15 procent spill, och jag tar 10 rakt och 15 diagonalt.'
                  : 'Spillet är Kährs och Pergos, cirka 5 procent rakt och upp till 10 diagonalt.'}
              </p>
            </div>
          )}
        </div>
      </Fragment>
    )
  }

  {
    visat.status === 'ok' && visat.gorInteDetHar.length > 0 && (
      <Fragment slot="gorInte">
        {/* Flera råd står i samma stycke efter "Gör inte det här.", vart och ett på egen rad. */}
        {visat.gorInteDetHar.map((rad, i) => (
          <span class:list={[i > 0 && 'mt-3 block']}>{rad}</span>
        ))}
      </Fragment>
    )
  }

  <Fragment slot="saRaknarJag">
    {
      illustration && (
        <div class="pappersruta">
          <Illustration
            namn="rakna/kvadratmeter"
            alt="Ett rum sett uppifrån med två måttbyglar, kvadratmetertalet mitt på golvet och en dörr och ett fönster i väggen."
            bildtext="Skissen visar det verktyget räknar på: ett rum på fyra gånger tre meter ger tolv kvadratmeter golv, och dörren och fönstret dras av från väggarna."
            class="my-0!"
          />
        </div>
      )
    }
    <ol class="m-0 mt-4 pl-6 list-decimal text-brod">
      <li class="mb-2">Längden gånger bredden ger golvet, och taket får samma tal.</li>
      <li class="mb-2">Längden plus bredden gånger två ger omkretsen, och omkretsen gånger takhöjden ger väggarna.</li>
      <li class="mb-2">
        Varje dörr och varje fönster drar jag av med sin egen yta, och du kan skriva in egna mått i stället för
        mina.
      </li>
      <li class="mb-2">
        Färgen räknar jag på ytan gånger antalet strykningar, delat med tillverkarnas åtgång per liter.
      </li>
      <li class="mb-2">
        Litertalet rundar jag upp till burkar. Minsta antalet burkar vinner, men bara bland dem som lämnar högst
        30 procent över.
      </li>
      <li class="mb-2">
        Tapeten räknar jag i våder. Omkretsen minus dörrarnas bredd delar jag med rullens bredd och avrundar
        uppåt.
      </li>
      <li class="mb-2">
        Vådens längd är takhöjden plus påslaget, och med mönsterpassning rundar jag upp den till en hel rapport.
      </li>
      <li>Golvet får sitt spillpåslag efter material och läggning, och sedan rundar jag upp till hela paket.</li>
    </ol>
  </Fragment>

  <Fragment slot="efter">
    {/* Antagandetabellen i läsbredd, ur kortet Så räknar jag (spec-designlyft-c avsnitt 9). */}
    <section class="max-w-lasbredd">
      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">Vad siffrorna vilar på</h3>
      <Tabellyta kolumner={3} class="mt-4">
        <table class="w-full border-collapse text-liten tabular-nums">
          <caption class="sr-only">Antaganden och källor i kvadratmeterräknaren</caption>
          <thead>
            <tr class="border-b border-linje text-left">
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Vad</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Jag räknar med</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Källa eller antagande</th>
            </tr>
          </thead>
          <tbody>
            {
              antaganden.map((a) => (
                <tr>
                  <th scope="row" class:list={[CELL_KLASS, 'text-left font-normal']}>
                    {a.storhet}
                  </th>
                  <td class={CELL_KLASS}>{a.varde}</td>
                  <td class={CELL_KLASS}>
                    {a.grund}.{' '}
                    {a.url ? (
                      <a href={a.url} rel={a.url.startsWith('/') ? undefined : 'nofollow'} class={LANK_KLASS}>
                        {a.stod}
                      </a>
                    ) : (
                      a.stod
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </Tabellyta>

      <p class="m-0 mt-6 text-brod lg:text-brod-lg">
        Allt i tabellen som är märkt Antagande går att skriva över i formuläret utom burkstorlekarna. Fönstret har
        egna fält, och mönsterrapporten läser du av på rullen innan du bestämmer dig. Modulsystemet för fönster är
        en standard hos alla svenska tillverkare, men ingen publicerar vilket mått som sitter i flest bostäder, så
        1,2 × 1,2 m är en gissning jag gärna får rättad av dig. När du är nöjd med svaret ligger hela uträkningen i
        adressfältet, så du kan skicka länken till den som ska handla. Hur jag hämtar tal från tillverkarna står på
        sidan <a href="/om/sa-testar-vi/" class={LANK_KLASS}>Så testar jag</a>.
      </p>
    </section>

    <section class="max-w-lasbredd">
      <Pennstreck id="rakna-ut-kvadratmeter">Räkna ut kvadratmeter på ett rum med dörr och fönster</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        Rummet i exemplet är fyra gånger tre meter med takhöjden 2,5&nbsp;m, en dörr och ett fönster. Golvet är det
        enkla. Längden gånger bredden ger 12&nbsp;kvm, och taket är lika stort. Väggarna kräver ett steg till.
        Omkretsen är två gånger längden plus två gånger bredden, 14&nbsp;m, och omkretsen gånger takhöjden ger
        35&nbsp;kvm.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Sedan kommer avdragen, och det är dem folk glömmer. En innerdörr sitter i ett hål i väggen på ungefär
        0,9&nbsp;×&nbsp;2,1&nbsp;m, eller 1,89&nbsp;kvm. Ett fönster på 1,2&nbsp;×&nbsp;1,2&nbsp;m tar bort
        1,44&nbsp;kvm till. Väggarna landar på 31,67&nbsp;kvm. Drygt tre kvadratmeter låter inte mycket, men det är
        en tiondel av färgen, och det är en burk du slipper bära hem.
      </p>
      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">
        Hur mycket färg går det åt per kvadratmeter?
      </h3>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Färgtillverkarna anger hur långt en liter räcker per strykning. Beckers och Nordsjö skriver båda 8 till
        10&nbsp;kvm per liter för sina väggfärger, och Alcro skriver 8. Jag räknar med det lägsta talet, för en
        spacklad vägg suger mer än en som redan är målad, och det är bättre att ha en halv liter över än att stå
        med en torr rulle. Två strykningar på 31,67&nbsp;kvm blir knappt åtta liter, och då är en burk om tio liter
        svaret. Verktyget tar minsta antalet burkar av dem som lämnar högst 30&nbsp;procent över, eftersom små burkar
        kostar mer per liter. Taket drar bara tre liter, och där blir svaret i stället en burk om 2,5&nbsp;liter
        plus en literburk. Är väggen obehandlad ska den grundas först, och grundfärg drar mer. Beckers anger 6 till
        8&nbsp;kvm per liter för sin grundfärg.
      </p>
      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">
        Hur många tapetrullar går det åt i samma rum?
      </h3>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Tapet räknar du i våder, inte i kvadratmeter, och det är därför kvadratmetertalet inte räcker som svar.
        Rullen är 0,53&nbsp;m bred och 10,05&nbsp;m lång enligt tapettillverkaren Boråstapeter. Dörrens bredd går
        bort ur omkretsen, men inte fönstrets, för tapeten ska ändå upp ovanför och ner under det. Kvar blir
        13,1&nbsp;m att tapetsera, och det är 25 våder. Varje våd är takhöjden plus tio centimeter för kap, och tre
        sådana går ur en rulle. Det blir nio rullar. Har tapeten ett mönster som ska passas kapar du våden vid en
        hel mönsterrapport i stället, och då kan en rulle tappa en våd.
      </p>
      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">
        Hur mycket spill räknar du med när du lägger golv?
      </h3>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Golvytan vet du redan, 12&nbsp;kvm, men beställ aldrig exakt det talet. Golvtillverkaren Kährs anger cirka
        fem procent spill vid rak läggning, och sju till tio procent när golvet läggs i mönster eller diagonalt.
        För klinker anger plattillverkaren Höganäs tio till femton procent. Jag tar femton när plattorna läggs
        diagonalt, för då kapas varje rad i båda ändar. Tolv kvadratmeter parkett blir alltså 12,6 att köpa, och tolv kvadratmeter
        klinker blir 13,2. Fyller du i paketstorleken avrundar jag uppåt till hela paket, och det är det talet som
        stämmer med kvittot. Bänkskivans yta räknar du för sig, det står i{' '}
        <a href="/kok/slipa-bankskiva/" class={LANK_KLASS}>
          guiden om att slipa och olja bänkskivan
        </a>
        , och virket till en ny vägg räknar du i{' '}
        <a href="/inomhus/bygga-innervagg/" class={LANK_KLASS}>
          guiden om att bygga innervägg
        </a>
        .
      </p>
    </section>

    {
      lasVidare.length > 0 && (
        <section>
          <Pennstreck id="las-vidare">Läs vidare</Pennstreck>
          <Artikelrutnat kort={lasVidare} kolumner={4} visaBeskrivning={false} visaMeta={false} />
        </section>
      )
    }

    <div class="max-w-lasbredd">
      <Faq fragor={FRAGOR} />
    </div>
  </Fragment>
</Raknarsida>
