  },
  {
    storhet: 'Sprängning, täckning',
    varde: `${kr(SPRANGNING_TACKNING_KR)}${HART}kr`,
    grund: 'Källa',
    stod: 'HelpHero, att täcka husen omkring så att stenen stannar på tomten. Ligger också utanför meterpriset',
