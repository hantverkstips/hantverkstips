  },
  {
    storhet: 'Material per löpmeter',
    varde: '300 till 900 kr',
    grund: 'Antagande',
    stod: 'Summan är min, posterna nedan är hyllpriser hämtade 18 september 2026',
  },
  {
    storhet: 'Dräneringsslang 90 mm',
    varde: `56${HART}kr per meter`,
    grund: 'Källa',
    stod: 'Bauhaus, slang med geotextil på rulle om 50 m, pris hämtat 18 september 2026',
    url: BAUHAUS_ROR,
  },
  {
    storhet: 'Noppmatta mot väggen',
    varde: `80${HART}kr per kvm`,
    grund: 'Källa',
    stod: 'Bauhaus, Isola Platon Xtra, pris hämtat 18 september 2026',
    url: BAUHAUS_MATTA,
  },
  {
    storhet: 'Grundmursskiva 100 mm',
    varde: `320${HART}kr per kvm`,
    grund: 'Källa',
    stod: 'Markgrossen, Isodrän 60 kPa, pris hämtat 18 september 2026. Ligger i den övre kanten av materialposten',
    url: MARKGROSSEN,
  },
  {
    storhet: 'Makadam',
    varde: `100${HART}kr per ton`,
    grund: 'Källa',
    stod: 'Mark och Anläggning, riktvärde exklusive moms. Sidan anger två olika datum och duger bara som grovt riktvärde',
    url: ANLAGGNING,
  },
  {
    storhet: 'Fiberduk',
    varde: `5${HART}kr per kvm`,
    grund: 'Källa',
    stod: 'Mark och Anläggning, riktvärde exklusive moms. Den minsta posten i materialet',
    url: ANLAGGNING,
  },
  {
    storhet: 'Schaktbredd',
    varde: `Cirka 1${HART}m`,
    grund: 'Källa',
    stod: 'Försäkringsbolaget GarBo, schakten grävs cirka en meter bred längs väggarna',
    url: GARBO,
  },
  {
    storhet: 'Återställning, gräs',
    varde: `${ATERSTALLNING.gras.lagKrPerM} till ${ATERSTALLNING.gras.hogKrPerM}${HART}kr per meter`,
    grund: 'Källa',
    stod: 'Upplands Gräsmattor, rullgräs 36 till 51 kr per kvm inklusive moms utan läggning. Matjord och arbete är mitt påslag',
    url: RULLGRAS,
  },
  {
    storhet: 'Återställning, hårdgjort',
    varde: `${ATERSTALLNING.asfalt.lagKrPerM} till ${ATERSTALLNING.plattgang.hogKrPerM}${HART}kr per meter`,
    grund: 'Källa',
    stod: 'BraByggare, asfalt 250 till 500 kr per kvm och marksten 500 till 900 kr per kvm inklusive arbete',
    url: BRABYGGARE,
  },
  {
    storhet: 'Återställning, rabatt',
    varde: `${ATERSTALLNING.rabatt.lagKrPerM} till ${ATERSTALLNING.rabatt.hogKrPerM}${HART}kr per meter`,
    grund: 'Antagande',
    stod: 'Ingen källa jag hittat prissätter en rabatt. Jag lägger den mellan gräsmattan och en hårdgjord yta',
  },
  {
    storhet: 'Återställning, altan',
    varde: `${ATERSTALLNING.altan.lagKrPerM} till ${ATERSTALLNING.altan.hogKrPerM}${HART}kr per meter`,
    grund: 'Antagande',
    stod: 'Ingen källa prissätter den heller. Altanen ska skruvas loss, virket sparas och däcket byggas upp igen',
  },
  {
    storhet: 'Rotavdrag',
    varde: `${Math.round(ROT_ANDEL * 100)}${HART}% av arbetet`,
    grund: 'Källa',
    stod: 'Skatteverket. Att dränera husgrunder står i listan över arbete som ger rätt till avdrag',
    url: SKATTEVERKET_LISTA,
  },
  {
    storhet: 'Rotavdragets gräns',
    varde: `${kr(ROT_TAK_KR)}${HART}kr per person`,
    grund: 'Källa',
    stod: 'Skatteverket, högsta avdrag per person och år. Nivån var tillfälligt högre under 2025 och är tillbaka på trettio procent',
    url: SKATTEVERKET,
  },
  {
    storhet: 'Del av arbetet som ger rotavdrag',
    varde: 'Tre femtedelar',
    grund: 'Antagande',
    stod: 'Skatteverket undantar maskinell utrustning, alltså grävmaskinen. Hur stor del av notan den är får du räkna själv, och tre femtedelar är min uppskattning',
    url: SKATTEVERKET,
  },
  {
    storhet: 'Dräneringens livslängd',
    varde: `Upp till ${KAN_HALLA_AR}${HART}år`,
    grund: 'Källa',
    stod: 'Villaägarna, en gammal dränering kan fungera i femtio år om källaren bara används som källare',
    url: VILLAAGARNA,
  },
  {
    storhet: 'Gräns för gammal dränering',
    varde: `${TROLIGT_SLUT_AR}${HART}år`,
    grund: 'Källa',
    stod: 'Husgrunder, en dränering äldre än 25 till 30 år bör utvärderas. Att gränsen går vid just 30 är mitt val',
    url: HUSGRUNDER,
  },
  {
    storhet: 'Avfuktare till källaren',
    varde: `${kr(AVFUKTARE_KR)}${HART}kr`,
    grund: 'Källa',
    stod: "Proffsmagasinet, Wood's SW39FW, pris hämtat 16 september 2026",
    url: PROFFSMAGASINET,
  },
  {
    storhet: 'Fuktutredning med mätvärden',
    varde: `${kr(FUKTUTREDNING_KR)}${HART}kr inklusive moms`,
    grund: 'Källa',
    stod: 'Saneringsföretaget Ocab, fuktkontroll av källarutrymme upp till 75 kvm. Branschkollegan Polygon tar 6 230 kr för samma sak',
    url: OCAB,
  },
  {
    storhet: 'Provtagning för mögel',
    varde: `3 190${HART}kr inklusive moms`,
    grund: 'Källa',
    stod: 'Ocab och Polygon tar samma pris per provtagning och analys, utöver kontrollen',
    url: POLYGON,
  },
  {
    storhet: 'Vatten från taket',
    varde: `${kr(REGN_LITER)} liter`,
    grund: 'Källa',
    stod: `Anticimex, ${REGN_MM} mm regn på ett tak på ${TAK_KVM} kvm. Det är därför stuprör och markfall kommer före grävningen`,
    url: ANTICIMEX,
  },
  {
    storhet: 'Markfukt skyddas utifrån',
    varde: 'Alltid på utsidan',
    grund: 'Källa',
    stod: 'Boverket, fukten från marken sugs främst upp genom porerna och väggen ska skyddas på utsidan',
    url: BOVERKET,
  },
  {
    storhet: 'Tejptestet',
    varde: 'Minst två dygn',
    grund: 'Källa',
    stod: 'Tidningen Gör Det Själv. Guiden om fukt i källaren beskriver hela testet',
    url: GDS,
  },
];

/** Frågorna sist på sidan. Talen är desamma som i brödtexten och i tabellen. */
const FRAGOR = [
  {
    fraga: 'Vad kostar det att dränera om ett hus?',
    svar: 'Villaägarna sätter arbetet till 3 000 kr per löpmeter husgrund och skriver att det kan gå upp till det dubbla. Ett vanligt hus har 40 löpmeter runt grunden. Är tomten lätt landar arbetet då på 120 000 kr, och är den svår på 240 000 kr. Till det kommer materialet, ungefär 300 till 900 kr per meter, och att lägga tillbaka gräset, gången eller asfalten ovanpå schakten.',
  },
  {
    fraga: 'Hur länge håller en dränering?',
    svar: 'Villaägarna säger att en gammal dränering kan fungera i femtio år, särskilt om källaren bara används som källare och inte som bostad. Branschens egna tal är kortare, oftast trettio till femtio år, och försäkringsbolaget GarBo anger tjugo år som teknisk livslängd. Åldern ensam är ändå inget skäl att gräva. Det är fukten i källaren som är skälet, och åldern säger bara hur troligt det är att dräneringen är orsaken.',
  },
  {
    fraga: 'Räcker en avfuktare i stället för dränering?',
    svar: 'Bara om vattnet kommer ur luften. Tejpa en bit plastfolie tätt mot källarväggen och vänta två dygn. Blir plasten våt på rumssidan är det kondens, och då gör en avfuktare jobbet för ungefär sex tusen kronor. Blir den våt på väggsidan kommer vattnet genom betongen, och då hjälper ingen maskin. Avfuktaren får tvärtom mer vatten att dunsta ur väggen, som suger efter mer ur marken.',
  },
];

/** Slug, namn och beskrivning på ett ställe: brödsmulan, og:image och WebApplication läser samma. */
const SLUG = 'dranering';
const VERKTYGSNAMN = 'Dränering';
const BESKRIVNING =
  'Räkna ut vad en dränering kostar per löpmeter och för hela grunden. Verktyget säger också om du behöver gräva alls, eller om en avfuktare räcker.';
const illustration = verktygsillustration(SLUG);
/**
 * Varumärkesbilden i sidhuvudet, sedan 2026-09-19 (docs/DESIGN.md avsnitt 7).
 * Finns den står skissen i stället i "Så räknar vi", där måtten förklarar
 * räkningen. Finns den inte visas skissen i sidhuvudet som förut.
 */
const varumarke = verktygsVarumarkesbild(SLUG);
const huvudbild = varumarke ?? illustration;
---

<Bas
  title={titel}
  description={BESKRIVNING}
  reklam={false}
  brodsmulor={[
    { namn: 'Hantverkstips', href: '/' },
    { namn: 'Räkna själv', href: '/rakna/' },
    { namn: VERKTYGSNAMN },
  ]}
  bred={true}
  ogBild={verktygsDelningsbild(SLUG)}
>
  <StrukturData
    slot="head"
    data={verktyg({ url: `/rakna/${SLUG}/`, namn: VERKTYGSNAMN, beskrivning: BESKRIVNING })}
  />

  <div class="mx-auto w-full max-w-lasbredd">
    {/*
      Sidhuvudet: rubrik och ingress till vänster i 7/12, bilden till höger i
      5/12 på desktop, under ingressen på mobil. Bilden är dekorativ, H1 bär
      betydelsen, därför tom alt. Den är sidans LCP-bild och laddas därför
      eagert med fetchpriority. Varumärkesbilden har transparent bakgrund och
      ligger som heron utan ram; skissen är ett urklipp och får ramen. Saknas
      båda visas ingen bild alls.
    */}
    <section class="grid grid-cols-1 items-center gap-6 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7">
        <h1 class="m-0 font-serif text-h1 lg:text-h1-lg">
          Vad kostar dränering? Räkna per löpmeter, och se om du behöver gräva
        </h1>
        <p class="m-0 mt-4 text-ingress lg:text-ingress-lg">
          En omdränering kostar som en begagnad bil, och en hel del av dem som söker på priset behöver aldrig gräva.
          Fyll i husets två mått, hur djupt schakten går och vad som ligger ovanpå, så får du arbetet per löpmeter och
          en summa för hela grunden. Sedan får du svar på det prislistorna hoppar över, alltså om du ska gräva alls
          eller om en avfuktare räcker.
        </p>
      </div>

      {
        huvudbild && (
          <div class="lg:col-span-5">
            <img
              src={huvudbild.src}
              alt=""
              width={huvudbild.width}
              height={huvudbild.height}
              fetchpriority="high"
              decoding="async"
              class:list={['block h-auto w-full', !varumarke && 'rounded-sm border border-linje']}
            />
          </div>
        )
      }
    </section>

    {
      visat.status === 'ok' && (
        <Faktaruta variant="kortsvar">
          <p class="m-0 leading-6">
            Räkna med <Markering>3 000 kr per löpmeter</Markering> husgrund i arbete, och det dubbla om tomten är svår.
          </p>
          <p class="m-0 leading-6">Ett vanligt hus har 40 löpmeter runt grunden, så arbetet börjar på 120 000 kr.</p>
          <p class="m-0 leading-6">
            Tejpa en bit plast på källarväggen innan du beställer något, för det är plasten som säger om du ska gräva
            eller köpa en avfuktare.
          </p>
        </Faktaruta>
      )
    }

    <div class="linjerat mt-8 lg:grid lg:grid-cols-2 lg:gap-8">
      {/* Formuläret ligger i src/components/kalkyl/DraneringForm.astro, så att
          <Kalkylator namn="dranering" /> i en artikel visar exakt samma fält. */}
      <DraneringForm indata={indata} varden={varden} fel={fel} />

      <div class="mt-8 border-t border-linje pt-6 lg:mt-0 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8">
        {
          visat.status === 'ok' && (
            <>
              {resultat.status === 'ogiltig' && (
                <p class="m-0 mb-2 text-liten text-varning">Ett av fälten gick inte att läsa, så jag visar standardvärdena tills du rättat det.</p>
              )}
              {/* Beskedet står först: spalten bär svaret, och svaret är om du
                  behöver gräva alls. Motiveringen står under verktyget. */}
              <p class="m-0 font-sans text-h3 lg:text-h3-lg font-bold text-blyerts">{visat.beskedRubrik}</p>
              <p class="m-0 mt-1 text-brod">{visat.beskedRad}</p>

              <p class="m-0 mt-6 text-etikett lg:text-etikett-lg uppercase text-blyerts-2">
                Arbetet, {formateraTal(visat.omkretsM, Number.isInteger(visat.omkretsM) ? 0 : 1)} löpmeter runt huset
              </p>
              {/* Det stora talet är arbetets undre kant, med resten av svaret på
                  samma baslinje där enheten står på de andra kalkylatorerna. */}
              <p class="m-0 mt-1 flex flex-wrap items-baseline gap-x-2">
                <span class="font-serif text-siffra lg:text-siffra-lg text-blyerts">
                  <Markering>{kr(visat.arbeteLagKr)}</Markering>
                </span>
                <span class="text-ingress lg:text-ingress-lg">
                  till {kr(visat.arbeteHogKr)}&nbsp;kr för arbetet
                </span>
              </p>
              <p class="m-0 mt-2 text-liten text-blyerts-2">
                Det är {kr(visat.arbeteLagKrPerM)} till {kr(visat.arbeteHogKrPerM)}&nbsp;kr per löpmeter, räknat på{' '}
                {meterText(visatIndata.schaktDjupM)}&nbsp;m schaktdjup och {TEJP_TEXT[visatIndata.tejptest]}.
              </p>

              <table class="mt-4 w-full border-collapse text-brod tabular-nums">
                <caption class="sr-only">Vad de tre posterna kostar för din grund</caption>
                <thead>
                  <tr class="border-b border-linje text-left">
                    <th scope="col" class="py-2 text-etikett uppercase text-blyerts-2">Post</th>
                    <th scope="col" class="py-2 text-etikett uppercase text-blyerts-2">Kr per meter</th>
                    <th scope="col" class="py-2 text-right text-etikett uppercase text-blyerts-2">Kronor</th>
                  </tr>
                </thead>
                <tbody>
                  {visat.poster.map((p) => (
                    <tr class="border-b border-linje">
                      <th scope="row" class="py-2 text-left font-normal">
                        {p.namn}
                      </th>
                      <td class="py-2">
                        {kr(p.lagKrPerM)} till {kr(p.hogKrPerM)}
                      </td>
                      <td class="py-2 text-right">
                        {kr(p.lagKr)} till {kr(p.hogKr)}
                      </td>
                    </tr>
                  ))}
                  <tr class="border-b border-linje font-bold">
                    <th scope="row" class="py-2 text-left">
                      Allt
                    </th>
                    <td class="py-2">
                      {kr(visat.summaLagKrPerM)} till {kr(visat.summaHogKrPerM)}
                    </td>
                    <td class="py-2 text-right">
                      {kr(visat.summaLagKr)} till {kr(visat.summaHogKr)}
                    </td>
                  </tr>
                </tbody>
              </table>

              <ul class="m-0 mt-4 p-0 list-none text-brod tabular-nums">
                <li class="border-t border-linje py-2">
                  Rotavdraget blir {kr(visat.rotavdragKr)}&nbsp;kr på den undre kanten, räknat utan maskinhyran.
                </li>
                <li class="border-t border-linje py-2">
                  Du får kvar {kr(visat.efterRotLagKr)} till {kr(visat.efterRotHogKr)}&nbsp;kr att betala, om du inte
                  använt rotavdraget till något annat i år.
                </li>
                <li class="border-t border-linje py-2">
                  En avfuktare kostar {kr(AVFUKTARE_KR)}&nbsp;kr, och grävningen kostar {visat.faktorMotAvfuktare}{' '}
                  gånger mer.
                </li>
                <li class="border-t border-linje py-2">
                  En fuktutredning kostar {kr(FUKTUTREDNING_KR)}&nbsp;kr, och grävningen kostar{' '}
                  {visat.faktorMotUtredning} gånger mer.
                </li>
              </ul>

              {/* Reglerna med källa och "Gör inte det här" står som egna H2
                  under verktyget. Spalten pekar dit med en rad. */}
              <p class="m-0 mt-4 text-liten text-blyerts-2">
                Varför just det beskedet, och det du inte ska göra,{' '}
                <a href="#darfor-blev-svaret-sa" class={LANK_KLASS}>står under verktyget</a>.
              </p>

              <p class="m-0 mt-4">
                <a href="#sa-raknar-vi" class:list={['inline-flex min-h-11 items-center', LANK_KLASS]}>
                  Så räknar jag
                </a>
              </p>

              {/* Dela. Svaret står i adressen, så ett skrivskyddat fält räcker:
                  markera och kopiera fungerar utan en rad JavaScript. */}
              <div class="mt-4 border-t border-linje pt-4">
                <label for="dela" class={ETIKETT_KLASS}>
                  Dela svaret
                </label>
                <input id="dela" type="text" readonly value={delaLank} class:list={[FALT_KLASS, 'border-blyerts-2']} />
                <p class="m-0 mt-1 text-liten text-blyerts-2">Dina värden ligger i adressen. Markera den och kopiera, så får den du skickar till samma svar.</p>
              </div>
            </>
          )
        }
      </div>
    </div>

    {visat.status === 'ok' && visat.visaAvfuktare && <Verktygskort kalkylator="avfuktare" />}

    {
      visat.status === 'ok' && (
        <>
          <section>
            <Pennstreck id="darfor-blev-svaret-sa">Därför blev svaret så</Pennstreck>
            <ul class="m-0 p-0 list-none text-brod lg:text-brod-lg">
              {visat.regler.map((regel) => (
                <li
                  class:list={[
                    'mb-4 border-l-2 pl-4',
                    regel.utfall === 'grav'
                      ? 'border-varning'
                      : regel.utfall === 'ok'
                        ? 'border-linje'
                        : 'border-blyerts-2',
                  ]}
                >
                  <span class="block text-etikett lg:text-etikett-lg uppercase text-blyerts-2">
                    {UTFALL_ETIKETT[regel.utfall]}
                  </span>
                  <span class="block">{regel.text}</span>
                  <span class="block text-liten text-blyerts-2">{regel.kalla}</span>
                </li>
              ))}
            </ul>
          </section>

          <section>
            <Pennstreck id="gor-inte-det-har">Gör inte det här</Pennstreck>
            {visat.gorInteDetHar.map((rad, i) => (
              <p class:list={['m-0 text-brod lg:text-brod-lg', i > 0 && 'mt-4']}>{rad}</p>
            ))}
          </section>
        </>
      )
    }

    <section>
      <Pennstreck id="dranering-kostnad">Vad en dränering kostar per löpmeter och hur du vet om du behöver den</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        Villaägarna sätter arbetet till cirka 3 000&nbsp;kr per löpmeter husgrund och skriver att det kan gå upp till
        det dubbla. Löpmetern är hela varvet runt huset, så ett hus på 12 gånger 8&nbsp;meter har 40 löpmeter och
        landar på 120 000&nbsp;kr när tomten är lätt. Så långt är svaret detsamma i vilken prislista som helst. Det du
        inte hittar där är svaret på om grävningen behövs.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Gör det billiga först. Stuprören ska leda bort vattnet, marken ska luta från huset, och dagvattenbrunnen ska
        vara rensad. Besiktningsföretaget Anticimex sätter siffror på varför. Ett tak på 150&nbsp;kvm är en stor
        tratt, och ett regn på 20&nbsp;mm ger 3 000 liter vatten som ska ta vägen någonstans. Rinner det ner längs
        grundmuren spelar det ingen roll hur ny dräneringen är.
      </p>
      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">Hur länge håller en dränering?</h3>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Villaägarnas rådgivare är ovanligt raka här. En gammal dränering kan fungera i femtio år, särskilt om källaren
        bara används som källare, och de tycker att det finns roligare saker att lägga pengarna på än att gräva för
        säkerhets skull. Branschen själv säger kortare. Trettio till femtio år är det vanligaste talet, och
        försäkringsbolaget GarBo anger tjugo år som teknisk livslängd.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Jag sätter gränsen vid trettio år, men bara tillsammans med markfukt på plasten. En dränering från sjuttiotalet
        i ett hus utan fuktproblem ska ligga kvar i marken. Villkoret i Villaägarnas mening är värt att läsa en gång
        till, för femtio år gäller en källare som används som källare. Ska du inreda den till sovrum är kraven andra,
        och då hör dräneringen till ombyggnaden.
      </p>
      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">Vad som gör priset dubbelt så högt</h3>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Villaägarna namnger tre saker bakom fördubblingen: grävdjup, bergsprängning och markförhållanden. Ingen av dem
        får en siffra. Talen kommer därför från byggsajten BraByggares prislista, som är den enda svenska källa jag
        hittat med en trappa för djupet. Varje extra halvmeter lägger på 25 till 50 procent, och en trång tomt med
        under tre meter mellan hus och gräns ger 10 till 25 procent i merarbete. Vilket djup entreprenören egentligen
        menar, och mot vilken punkt det mäts, går jag igenom i{' '}
        <a href="/grund/dranera-hus/" class:list={[LANK_KLASS]}>guiden om att dränera huset</a>, tillsammans med resten
        av det som ska stå i offerten.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Verktyget räknar med den nedre kanten på djupet och den övre på den trånga tomten, för den som kryssar i den
        rutan har ett verkligt problem och inte ett gränsfall. Berget är mitt eget tal. Sprängningens fasta kostnader
        ligger utanför meterpriset, eftersom de inte blir billigare för att huset är litet. Be entreprenören
        prissätta etablering och täckning för sig, så ser du vad själva metern kostar.
      </p>
      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">Rotavdraget, och fällan i det</h3>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Att dränera husgrunder står i Skatteverkets lista över arbete som ger rätt till rotavdrag, alltså 30 procent av
        arbetskostnaden och högst 50 000&nbsp;kr per person och år. Två rader längre ner i samma lista står det som är
        lätt att missa: avdrag ges inte för maskinell utrustning, och Skatteverket nämner grävmaskiner och borraggregat
        med namn. En dränering är till stor del grävmaskin och lass med massor. Avdraget träffar alltså en mindre del
        av notan än du tror, om du räknar 30 procent på hela arbetsposten.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Verktyget räknar med att tre femtedelar av arbetet ger avdrag, och det talet är mitt. Be om en faktura där
        maskinhyran står på egen rad, så vet du i stället för att gissa. Äger ni huset tillsammans har ni en gräns var,
        och då går det att dra av dubbelt så mycket. Hela regelverket, med gränserna och betalningsdatumet, räknar du
        på i{' '}
        <a href="/rakna/rotavdrag/" class={LANK_KLASS}>rotavdragsräknaren</a>.
      </p>
      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">Avfuktare i stället för att gräva</h3>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Skillnaden mellan rätt och fel diagnos är minst en faktor tjugo, så här är testet som avgör. Tejpa en bit
        plastfolie på 50 gånger 50&nbsp;cm tätt mot källarväggen där den ser våtast ut och vänta minst två dygn.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Sitter dropparna på plastens rumssida bär luften mer vatten än den kalla väggen tål. Det är kondens, och då är
        en avfuktare rätt maskin. Sitter de på väggsidan kommer vattnet genom betongen i stället. Boverket beskriver
        det som att vattnet sugs upp genom porerna, ibland vandrar det som ånga rakt genom materialet, och de är
        tydliga med att skyddet mot markfukt hör hemma på utsidan av väggen.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        En avfuktare mot markfukt är samma tankefel i elektrisk form. Luften i rummet torkar, mer vatten dunstar ur
        väggen, och väggen suger efter mer ur marken. Hela testet står i{' '}
        <a href="/fukt/fukt-i-kallaren/" class={LANK_KLASS}>
          guiden om fukt i källaren
        </a>
        , och vilken maskin kondensen kräver räknar du ut i{' '}
        <a href="/rakna/avfuktare/" class={LANK_KLASS}>
          avfuktarräknaren
        </a>
        .
      </p>
    </section>

    <section>
      <Pennstreck id="sa-raknar-vi">Så räknar jag</Pennstreck>
      {
        varumarke && illustration && (
          <Illustration
            namn="rakna/dranering"
            alt="Grundmur i genomskärning med schakten längs väggen, dräneringsröret i botten och markfukt som trycker in genom väggen"
            bildtext="Det verktyget räknar på är djupet ner till röret, varvet runt huset och var vattnet kommer in."
          />
        )
      }
      <ol class="m-0 mt-4 pl-6 list-decimal text-brod lg:text-brod-lg">
        <li class="mb-2">
          Löpmetern är husets omkrets, alltså två gånger längden plus bredden. Du mäter två sidor, och verktyget
          räknar varvet.
        </li>
        <li class="mb-2">
          Arbetet är Villaägarnas {kr(ARBETE_KR_PER_LOPMETER)} kr per löpmeter i undre kanten och det dubbla i den
          övre.
        </li>
        <li class="mb-2">
          Schaktdjupet flyttar hela spannet. Varje meter över eller under de {meterText(SCHAKTDJUP_REFERENS_M)} meter
          som räknas som normalt djup ändrar arbetet med {Math.round(DJUP_PASLAG_PER_M * 100)} procent. Ändringen
          håller sig inom fasta gränser, så att en riktigt djup schakt inte får priset att skena.
        </li>
        <li class="mb-2">
          Åtkomsten flyttar spannet en gång till, med ett påslag för trång tomt och ett större för berg. Sprängningens
          fasta kostnader står som en egen rad och räknas aldrig per meter.
        </li>
        <li class="mb-2">
          Påslaget slår igenom helt på den undre kanten och halvt på den övre. Fördubblingen är redan motiverad med
          djup och berg, så att räkna påslaget fullt ut i båda ändarna vore att ta samma svårighet två gånger.
        </li>
        <li class="mb-2">
          Materialet läggs på med 300 till 900 kr per löpmeter vid normalt djup. Det följer djupet rakt av, för
          dubbelt så djup schakt kräver dubbelt så hög skiva mot väggen.
        </li>
        <li class="mb-2">
          Återställningen beror på vad som ligger ovanpå schakten, från gräs till altan. Schakten är ungefär en meter
          bred, så kronor per meter är också kronor per kvadratmeter.
        </li>
        <li class="mb-2">
          Rotavdraget dras från arbetet, men bara från den del som inte är maskinhyra, och det stannar vid gränsen
          per person och år.
        </li>
        <li>
          Beskedet kommer sist. Markfukt på plasten och en dränering över trettio år ger dränera om. Kondens ger mät
          först. Allt annat ger gör det billiga först.
        </li>
      </ol>

      <h3 class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">Vad svaret vilar på</h3>
      <Tabellyta kolumner={3} class="mt-4">
        <table class="w-full border-collapse text-liten tabular-nums">
          <caption class="sr-only">Priser, gränser och antaganden i dräneringskalkylatorn</caption>
          <thead>
            <tr class="border-b border-linje text-left">
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Vad</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Verktyget räknar med</th>
              <th scope="col" class="p-2 text-etikett uppercase text-blyerts-2">Källa eller antagande</th>
            </tr>
          </thead>
          <tbody>
            {
              antaganden.map((a) => (
                <tr>
                  <th scope="row" class:list={[CELL_KLASS, 'text-left font-normal']}>
                    {a.storhet}
                  </th>
                  <td class={CELL_KLASS}>{a.varde}</td>
                  <td class={CELL_KLASS}>
                    {a.grund}.{' '}
                    {a.url ? (
                      <a href={a.url} rel={a.url.startsWith('/') ? undefined : 'nofollow'} class={LANK_KLASS}>
                        {a.stod}
                      </a>
                    ) : (
                      a.stod
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
          <tfoot>
            <tr>
              <td colspan="3" class="p-2 text-liten text-blyerts-2">
                Ett materialpris är färskvara, så datumet står på raden och priset läses om varje halvår. Raderna
                märkta Antagande är mina egna tal.
              </td>
            </tr>
          </tfoot>
        </table>
      </Tabellyta>

      <p class="m-0 mt-6 text-brod lg:text-brod-lg">
        Raderna märkta Antagande är mina egna tal, inte hämtade någonstans ifrån. Två av dem styr svaret mer än de
        andra. Det ena är gränsen vid trettio år, vald ur Husgrunders spann på 25 till 30. Det andra är att tre
        femtedelar av arbetet ger rotavdrag. Båda ligger åt det försiktiga hållet. Verktyget säger hellre mät en gång
        till än gräv i onödan, och det lovar hellre ett för litet rotavdrag än ett för stort.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Jämför gärna med offerten du får. För grunden du fyllt i landar hela jobbet på{' '}
        {visat.status === 'ok' ? `${kr(visat.summaLagKrPerM)} till ${kr(visat.summaHogKrPerM)}` : '3 400 till 7 200'}
        &nbsp;kr per löpmeter med material och återställning inräknade. Ligger offerten långt utanför det spannet ska
        entreprenören kunna säga varför, rad för rad.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Två saker kan verktyget inte se. Det första är vad som ligger i marken, alltså gamla ledningar, fyllning av
        byggavfall eller en grundmur som visar sig vara otät när den blottas. Det andra är krypgrunden. Har huset
        krypgrund under en del av bottenvåningen är det en annan byggnadsdel med egna regler, och den räknas inte
        här. Hur jag jobbar med tal och källor står på sidan{' '}
        <a href="/om/sa-testar-vi/" class={LANK_KLASS}>Så testar jag</a>.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Talen här är storleksordningar att jämföra åtgärder med, och ingen offert. Vad ett markarbete kostar avgörs av
        vad som ligger i marken, och det syns först när schakten är öppen.
      </p>
    </section>

    <section>
      <Pennstreck id="las-vidare">Läs vidare</Pennstreck>
      <ul class="m-0 p-0 list-none">
        <li class="border-t border-linje">
          <a href="/grund/dranera-hus/" class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
            Så dränerar du huset, steg för steg, och hur långt du kommer själv
          </a>
        </li>
        <li class="border-t border-linje">
          <a href="/fukt/fukt-i-kallaren/" class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
            Hitta orsaken till fukten i källaren innan du köper något
          </a>
        </li>
        <li class="border-t border-linje">
          <a href="/fukt/avfuktare-kallare/" class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
            Avfuktare till källaren, vad den klarar och vad den kostar i drift
          </a>
        </li>
        <li class="border-t border-linje">
          <a href="/rakna/daggpunkt/" class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
            Räkna ut daggpunkten och se om källarväggen blir våt
          </a>
        </li>
      </ul>
    </section>

    <Faq fragor={FRAGOR} />
  </div>
</Bas>
