---
/**
 * Takbytet: vad ett nytt tak kostar före och efter rotavdraget, med takarean
 * längs lutningen och antalet takstolar. Formuläret skickas som GET till samma
 * sida och räkningen sker på servern, så sidan fungerar utan klient-JS.
 * Se docs/SPEC-SIDMALLAR.md avsnitt 4.7 och
 * docs/briefer/spec-kalkyl-tak-2026-09-29.md avsnitt 4.
 *
 * Formeln, konstanterna och all text som modulen äger ligger i
 * src/lib/kalkyl/takbyte.ts, geometrin i tak.ts. Sidan räknar ingenting själv.
 *
 * Inga produkter och inget reklamband (checklistan 1).
 *
 * Räknarmallen sedan fas C (spec-designlyft-c-2026-10-02 avsnitt 14).
 */
export const prerender = false;

import { artikelUrl, publicerade } from '../../lib/innehall';
import { tillKortArtikel, type KortData } from '../../lib/kort';
import { hittaKalkylator } from '../../lib/kalkyl/register';
import { arPelare } from '../../lib/pelare';
import {
  antagandenFor,
  avvattningQuery,
  beskedVarden,
  delbarQuery,
  harBelopp,
  KALLOR,
  kallradRegel,
  kortsvarVarden,
  kronor,
  m2Text,
  meterText,
  paslagstabell,
  procentText,
  raknaTakbyte,
  regelKallor,
  rotavdragQuery,
  STANDARD,
  stegVarden,
  TEXT,
  tolkaQuery,
  type Kallkod,
  type KallaRef,
  type TakbyteIndata,
} from '../../lib/kalkyl/takbyte.ts';
import { LANK_KLASS } from '../../lib/kalkyl/stil';
import { verktygsillustration } from '../../lib/verktygsbild';
import TakbyteForm from '../../components/kalkyl/TakbyteForm.astro';
import Artikelrutnat from '../../components/ui/Artikelrutnat.astro';
import Faq from '../../components/ui/Faq.astro';
import Illustration from '../../components/ui/Illustration.astro';
import Pennstreck from '../../components/ui/Pennstreck.astro';
import Svarstal from '../../components/ui/Svarstal.astro';
import Tabellyta from '../../components/ui/Tabellyta.astro';
import Raknarsida from '../../components/vyer/Raknarsida.astro';

Astro.locals.sidtyp = 'verktyg';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

const SLUG = 'takbyte';
/* Utkast: sidan svarar 404 i produktion och har noindex i dev tills värdartikeln
   /tak/plattak/ publiceras och hantverkarens text finns. Sätts till false i
   publiceringscommiten, samtidigt som registerposten läggs till. */
const UTKAST = false;
const VERKTYGSNAMN = 'Kostnaden för att byta tak';
const BESKRIVNING =
  'Räknaren tar fram takytan ur husets mått och takvinkel och visar vad ett nytt tak kostar i fem material, med rotavdraget för en eller två ägare.'; // 120 till 155 tecken, checklistan 4
const titel = 'Byta tak, kostnad räknad från husets mått'; // högst 44 tecken, börjar med "Byta tak, kostnad" eller "Vad kostar det att byta tak", checklistan 3
const H1 = 'Vad kostar ett nytt tak på ditt hus?'; // läsarens fråga, delar inte de tre första orden med titeln
const INGRESS =
  'Här räknar du fram takytan ur husets längd, bredd, utsprång och lutning och ser vad ett nytt tak kostar i det material du väljer. Priset delas upp i arbete och material, rotavdraget räknas för en eller två ägare, och på köpet får du veta ungefär hur många takstolar som ryms.';

/* Rubrikerna till hantverkarens tre H2 (checklistans H2 1 till 3), i den ordningen. */
/* Takarean ur husets mått. Bär "beräkna takarea" och "takvinkel". */
const H2_TAKAREA = 'Beräkna takarea ur husets mått och takvinkel';
/* Vad som ingår i priset. */
const H2_PRISET = 'Arbetet och materialet i ett takbyte';
/* Rotavdraget på takbytet. */
const H2_ROT = 'Rotavdraget på ett nytt tak';

/* Läs vidare: länktexterna skriver hantverkaren. */
const LAS_VIDARE = [
  { href: '/tak/plattak/', text: 'Vilken plåt som passar ditt tak och vad den kostar' },
  { href: '/tak/papptak/', text: 'Hur länge ett papptak håller och när du kan lägga det själv' },
  { href: '/tak/taklackage/', text: 'Var taket läcker och vad försäkringen betalar' },
  { href: '/rakna/takavvattning/', text: 'Hängrännor och stuprör för samma takyta' },
  { href: '/rakna/rotavdrag/', text: 'Hur mycket rotavdrag som finns kvar i år' },
  { href: '/rakna/fasadyta/', text: 'Färgen till fasaden och gavelspetsarna' },
];

/* Exemplen ur den gamla Kort svar-rutan, räknade med STANDARD (SOKORDSANALYS 13). */
const exempel = kortsvarVarden();

/* Tre till fem frågor. */
const FRAGOR = [
  {
    fraga: 'Vad kostar tegel och plåt jämfört med betongpannor?',
    svar: `På ett hus med ${exempel.bottenyta} m² bottenyta och ${exempel.takarea} m² tak betalar du ${exempel.betong.attBetala} kr efter rotavdraget med betongpannor för ${exempel.betong.prisKvm} kr per kvadratmeter. Tegelpannor för ${exempel.tegel.prisKvm} kr per kvadratmeter ger ${exempel.tegel.attBetala} kr, och bandtäckt plåt för ${exempel.bandplat.prisKvm} kr per kvadratmeter landar på ${exempel.bandplat.attBetala} kr. Pannpriserna kommer från Takexperter och plåtpriset från Hantverkskollen och Totalbyggarna, alla hämtade 2026.`,
  },
  {
    fraga: 'Går det att räkna på ett valmat tak?',
    svar: 'Inte här. Priserna jag har gäller sadeltak, och två av källorna skriver att ett valmat tak eller ett mansardtak blir dyrare, men inte hur mycket. Ytan går att räkna ut på samma sätt om alla takfall lutar lika mycket, men beloppet skulle bli för lågt, så för ett valmat tak är en offert det enda som ger ett riktigt tal.',
  },
  {
    fraga: 'Måste takstolarna bytas när taket byts?',
    svar: 'Räknaren utgår från att de står kvar, och det är takmaterialet som byts. Byter du takstolarna rör du husets bärande delar, och påverkas de väsentligt kräver Boverket en anmälan till kommunen och ett startbesked innan arbetet börjar. Går du från ett lätt tak till tunga pannor skulle jag låta en konstruktör eller takstolsleverantören titta på om stolarna bär den nya vikten.',
  },
  {
    fraga: 'Varför får jag inget svar om snölasten?',
    svar: 'Snölasten används när takstolarna dimensioneras, och det gör takstolsleverantören eller en konstruktör efter Boverkets regler om bärförmåga. Den här räknaren dimensionerar inga takstolar. Den räknar bara ut ungefär hur många som får plats längs huset.',
  },
];

/* Gränssnittstext, ordagrant ur skillen nytt-verktyg. */
const STANDARDVARNING = 'Ett av fälten gick inte att läsa, så jag visar standardvärdena tills du rättat det.';

if (UTKAST && import.meta.env.PROD) {
  return new Response(null, { status: 404, headers: { 'X-Robots-Tag': 'noindex' } });
}

const q = Astro.url.searchParams;
const { indata } = tolkaQuery(q);
const resultat = raknaTakbyte(indata);
const fel = resultat.status === 'ogiltig' ? resultat.fel : {};
// Vid ogiltig indata visas standardvärdenas svar, med varningen överst.
const visatIndata: TakbyteIndata = resultat.status === 'ogiltig' ? STANDARD : indata;
const visat = raknaTakbyte(visatIndata);
if (visat.status !== 'ok') throw new Error('[takbyte] Standardvärdena ska alltid ge ett svar');

const komma = (n: number): string => String(n).replace('.', ',');
/** Fältens värden som de skrevs i adressen, så att ett felskrivet värde går att rätta. */
const varden = {
  langd: q.get('langd') ?? komma(STANDARD.langdM),
  bredd: q.get('bredd') ?? komma(STANDARD.breddM),
  utsprang: q.get('utsprang') ?? komma(STANDARD.utsprangM),
  gavel: q.get('gavel') ?? komma(STANDARD.gavelM),
  vinkel: q.get('vinkel') ?? komma(STANDARD.vinkelGrader),
  nock: q.get('nock') ?? komma(STANDARD.nockM),
  rot: q.get('rot') ?? (STANDARD.rotKr === 0 ? '' : String(STANDARD.rotKr)),
};

const delaLank = new URL(
  `/rakna/${SLUG}/?${delbarQuery(visatIndata, visat.geometri).toString()}`,
  Astro.site ?? Astro.url,
).toString();

const bv = beskedVarden(visat, visatIndata);
const besked = TEXT.besked[visat.utfall];

/** Hårda mellanslag i talen, så att Svarstal bara bryter före "till". */
const hart = (s: string): string => s.replace(/ /g, ' ');

/* Påslagstabellen: raden närmast läsarens vinkel i fetstil, bara den. */
const paslag = paslagstabell();
const narmast = paslag.reduce((b, r) =>
  Math.abs(r.grader - visat.geometri.vinkelGrader) < Math.abs(b.grader - visat.geometri.vinkelGrader) ? r : b,
);

/** Cellklasserna en gång på <table>, som på badrum-kostnad. */
const TABELL_KLASS =
  'w-full border-collapse text-liten tabular-nums [&_th]:p-2 [&_td]:p-2 [&_th]:align-top [&_td]:align-top [&_th]:text-left [&_tbody_th]:[font-weight:inherit] [&_tr]:border-b [&_tr]:border-linje [&_th]:text-blyerts [&_td]:text-blyerts [&_thead_th]:text-etikett [&_thead_th]:uppercase [&_thead_th]:text-blyerts-2';
const TAL_TABELL_KLASS = `${TABELL_KLASS} [&_td]:text-right [&_td]:whitespace-nowrap [&_thead_th+th]:text-right`;
const ANDE_TABELL_KLASS = `${TAL_TABELL_KLASS} [&_tr:last-child>*]:font-bold`;
const LANKAR_KLASS = '[&_a]:text-penna [&_a]:underline [&_a]:decoration-1 [&_a]:underline-offset-2 [&_a:hover]:decoration-2';
const STYCKE_KLASS = 'm-0 mt-4 text-brod lg:text-brod-lg';
const SPALTRAD_KLASS = 'text-liten text-blyerts-2 tabular-nums';
const SPALTLANK_KLASS = ['inline-flex min-h-11 items-center', LANK_KLASS];

const kalla = (k: Kallkod): KallaRef => KALLOR[k];

const antaganden = antagandenFor(visat, visatIndata);
const kallor: KallaRef[] = [];
for (const a of antaganden) {
  for (const k of a.kallor) if (!kallor.some((x) => x.kod === k)) kallor.push(kalla(k));
}

/** Skissen står i kortet Så räknar jag. Huvudet har ingen bild sedan fas C (DESIGN.md 5.8). */
const illustration = verktygsillustration(SLUG);

/*
 * Klartexten i svarsytan (spec-designlyft-c avsnitt 0 och 14), hantverkarens.
 * Platshållare: {pris} (att betala efter rotavdraget, kr, ett tal eller "lågt
 * till högt"), {takarea} (m² längs lutningen), {langd} och {bredd} (husets
 * mått, m) och {vinkel} (grader).
 * Utan belopp (utanför eller för flack lutning) är {pris} tom.
 */
const KLARTEXT =
  'Ett hus på {langd} × {bredd} m med {vinkel} graders taklutning har {takarea} m² tak, och ett nytt tak kostar {pris} kr efter rotavdraget, räknat med bland annat Takexperters priser för 2026.'; // takbyte.klartext
/* Utan belopp (utanför eller för flack lutning) står bara takarean. */
const KLARTEXT_UTAN_PRIS =
  'Ett hus på {langd} × {bredd} m med {vinkel} graders taklutning har {takarea} m² tak längs lutningen, räknat från husets mått och takutsprången.';
const klartext = (harBelopp(visat) ? KLARTEXT : KLARTEXT_UTAN_PRIS).replace(
  '{pris}',
  harBelopp(visat)
    ? visat.ettTal
      ? kronor(visat.lag.attBetalaKr)
      : `${kronor(visat.lag.attBetalaKr)} till ${kronor(visat.hog.attBetalaKr)}`
    : '',
)
  .replace('{takarea}', m2Text(visat.geometri.takareaM2))
  .replace('{langd}', komma(visatIndata.langdM))
  .replace('{bredd}', komma(visatIndata.breddM))
  .replace('{vinkel}', bv.vinkel);

/**
 * Läs vidare: artiklarna som artikelkort, räknarna med registrets namn som på
 * hubben, i den förra listans ordning.
 */
const artiklar = [...(await publicerade('guider')), ...(await publicerade('kunskap'))];
const lasVidare: KortData[] = [];
const lasVidareLankar: { href: string; text: string }[] = [];
for (const l of LAS_VIDARE) {
  const e = artiklar.find((a) => artikelUrl(a) === l.href);
  if (e) {
    const { niva: _niva, ...kort } = tillKortArtikel(e);
    lasVidare.push(kort);
    continue;
  }
  const k = l.href.startsWith('/rakna/') ? hittaKalkylator(l.href.replace(/^\/rakna\/|\/$/g, '')) : undefined;
  const pelare = k?.pelare?.[0];
  if (k && pelare && arPelare(pelare)) {
    lasVidare.push({
      etikett: 'Räkna själv',
      rubrik: k.namn,
      beskrivning: k.rad,
      pelare,
      href: l.href,
      // Artikelrutnat läser inte typen; kortet står varken i ett typfilter eller sorteras.
      typ: 'kunskap',
      sorteringsdatum: new Date(0),
    });
    continue;
  }
  lasVidareLankar.push(l);
}
---

<Raknarsida
  slug={SLUG}
  namn={VERKTYGSNAMN}
  titel={titel}
  beskrivning={BESKRIVNING}
  rubrik={H1}
  delaUrl={delaLank}
  saRaknarId="sa-raknar-jag"
>
  <p slot="ingress">{INGRESS}</p>

  <TakbyteForm slot="formular" indata={indata} varden={varden} fel={fel} />

  <Fragment slot="svar">
    {resultat.status === 'ogiltig' && <p class="text-liten text-varning">{STANDARDVARNING}</p>}
    {
      harBelopp(visat) ? (
        <Svarstal
          tal={
            visat.ettTal
              ? hart(kronor(visat.lag.attBetalaKr))
              : `${hart(kronor(visat.lag.attBetalaKr))} till ${hart(kronor(visat.hog.attBetalaKr))}`
          }
          enhet="kr"
          vad={TEXT.spalt['etikett-betala']}
        />
      ) : (
        <Svarstal
          tal={m2Text(visat.geometri.takareaM2)}
          enhet={TEXT.spalt['enhet-takarea']}
          vad={TEXT.spalt['etikett-takarea']}
        />
      )
    }
    <div class="text-brod">
      <p class="font-bold">{besked.rubrik(bv)}</p>
      <p class="mt-1!">{besked.rad(bv)}</p>
    </div>
    <div class={LANKAR_KLASS}>
      {
        harBelopp(visat) && (
          <>
            <p class={SPALTRAD_KLASS}>{TEXT.spalt['rad-takarea'](bv)}</p>
            <p class:list={[SPALTRAD_KLASS, 'mt-1!']}>{TEXT.spalt['rad-delning'](bv)}</p>
            <p class:list={[SPALTRAD_KLASS, 'mt-1!']}>{TEXT.spalt['rad-rot'](bv)}</p>
          </>
        )
      }
      <p class:list={[SPALTRAD_KLASS, harBelopp(visat) && 'mt-1!']}>
        {TEXT.spalt['rad-geometri'](bv)}{' '}<a href="/tak/takstolar/">{TEXT.spalt['lank-takstolar']}</a>
      </p>
    </div>
    <div>
      {
        harBelopp(visat) && (
          <p>
            <a href={`/rakna/rotavdrag/?${rotavdragQuery(visat, visatIndata).toString()}`} class:list={SPALTLANK_KLASS}>
              {TEXT.spalt['lank-rotavdrag']}
            </a>
          </p>
        )
      }
      <p>
        <a
          href={`/rakna/takavvattning/?${avvattningQuery(visatIndata, visat.geometri).toString()}`}
          class:list={SPALTLANK_KLASS}
        >
          {TEXT.spalt['lank-takavvattning']}
        </a>
      </p>
    </div>
    <p class="text-liten text-blyerts">{klartext}</p>
  </Fragment>

  <Fragment slot="darfor">
    <Pennstreck id="darfor-blev-svaret-sa" utanLuft>
      Därför blev svaret så
    </Pennstreck>
    {
      harBelopp(visat) ? (
        <>
          {visat.ettTal ? (
            <p class:list={[STYCKE_KLASS, 'tabular-nums']}>{TEXT.darfor['ett-tal'](bv)}</p>
          ) : (
            <Tabellyta kolumner={3} class="mt-4">
              <table class={ANDE_TABELL_KLASS}>
                <thead>
                  <tr>
                    <th scope="col">{TEXT.darfor['tabell-ande']}</th>
                    <th scope="col">{TEXT.darfor['tabell-lag']}</th>
                    <th scope="col">{TEXT.darfor['tabell-hog']}</th>
                  </tr>
                </thead>
                <tbody>
                  {(
                    [
                      ['rad-pris', 'prisKvm'],
                      ['rad-kostnad', 'kostnadKr'],
                      ['rad-arbete', 'arbeteKr'],
                      ['rad-material', 'materialKr'],
                      ['rad-rot', 'rotKr'],
                      ['rad-betala', 'attBetalaKr'],
                    ] as const
                  ).map(([rubrik, falt]) => (
                    <tr>
                      <th scope="row">{TEXT.darfor[rubrik]}</th>
                      <td>{kronor(visat.lag[falt])}</td>
                      <td>{kronor(visat.hog[falt])}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </Tabellyta>
          )}
          <p class:list={[STYCKE_KLASS, 'tabular-nums']}>{TEXT.darfor.tillagg(bv)}</p>
          <p class="m-0 mt-2 text-liten text-blyerts-2">
            <a href="#vad-siffrorna-vilar-pa" class={LANK_KLASS}>{TEXT.darfor.kallrad}</a>
          </p>
        </>
      ) : (
        <p class={STYCKE_KLASS}>{visat.utfall === 'lutning' ? TEXT.darfor.lutning(bv) : TEXT.darfor.utanfor(bv)}</p>
      )
    }
    <div class:list={['darfor', LANKAR_KLASS]}>
      {
        (() => {
          /* Förmedlarna namnges bara i antagandetabellen (checklistans fälla).
             Hänvisningen dit står högst en gång på sidan: i stycket ovanför när svaret
             har belopp, annars under den sista regeln som vilar på en förmedlare. */
          const regelkallor = visat.regler.map((nyckel) => regelKallor(nyckel, visatIndata));
          const sistaFormedlare = kallradRegel(visat, visatIndata);
          return visat.regler.map((nyckel, i) => {
            const namngivna = regelkallor[i] ?? [];
            return (
              <div>
                <p>{TEXT.regel[nyckel].text(bv)}</p>
                {namngivna.length > 0 ? (
                  <p>
                    {namngivna.map((k, n) => (
                      <>
                        {n > 0 && '; '}
                        <a href={k.url} rel="nofollow">{k.titel}</a>, {k.slag}, {k.datum}
                      </>
                    ))}
                  </p>
                ) : (
                  i === sistaFormedlare && (
                    <p>
                      <a href="#vad-siffrorna-vilar-pa">{TEXT.darfor.kallrad}</a>
                    </p>
                  )
                )}
              </div>
            );
          });
        })()
      }
    </div>
  </Fragment>

  {
    visat.gorInteDetHar.length > 0 && (
      <Fragment slot="gorInte">
        {/* Flera råd står i samma stycke efter "Gör inte det här.", vart och ett på egen rad. */}
        {visat.gorInteDetHar.map((g, n) => (
          <span class:list={[n > 0 && 'mt-3 block']}>{TEXT.gorInte[g]}</span>
        ))}
      </Fragment>
    )
  }

  <Fragment slot="saRaknarJag">
    {
      illustration && (
        <div class="pappersruta">
          <Illustration namn={`rakna/${SLUG}`} alt={TEXT.skissAlt} bildtext={TEXT.skissBildtext} class="my-0!" />
        </div>
      )
    }
    <ol class="m-0 mt-4 pl-6 list-decimal text-brod [&>li]:mb-2">
      {TEXT.steg(stegVarden()).map((s) => <li>{s}</li>)}
    </ol>
  </Fragment>

  <Fragment slot="efter">
    {/* Antagandetabellen i läsbredd, ur kortet Så räknar jag (spec-designlyft-c avsnitt 9). */}
    <section class="max-w-lasbredd">
      <h3 id="vad-siffrorna-vilar-pa" class="m-0 mt-8 font-sans text-h3 lg:text-h3-lg text-blyerts">
        Vad siffrorna vilar på
      </h3>
      <Tabellyta kolumner={3} class="mt-4">
        <table class={TABELL_KLASS}>
          <thead>
            <tr>
              <th scope="col">Vad</th>
              <th scope="col">Värde</th>
              <th scope="col">Källa eller antagande</th>
            </tr>
          </thead>
          <tbody>
            {
              antaganden.map((a) => (
                <tr>
                  <th scope="row">{TEXT.antagande[a.nyckel]}</th>
                  <td>{a.varde}</td>
                  <td>
                    {a.typ}.{a.kallor.length > 0 && ` ${a.kallor.map((k) => kalla(k).titel).join('; ')}`}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </Tabellyta>
      <ul class:list={['m-0 mt-4 pl-6 text-liten', LANKAR_KLASS]}>
        {
          kallor.map((k) => (
            <li>
              <a href={k.url} rel="nofollow">{k.titel}</a>, {k.slag}, {k.datum}
            </li>
          ))
        }
      </ul>
    </section>

    {/* Hantverkarens brödtext, checklistans H2 1 till 3. Länkarnas utseende står en gång på <section>. */}
    <section class:list={['max-w-lasbredd', LANKAR_KLASS]}>
      {/*
        Takarean ur husets mått. Bär "beräkna takarea" och "takvinkel". Formeln i
        klartext, takutsprånget och påslagstabellen nedan.
      */}
      <Pennstreck>{H2_TAKAREA}</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        Takfirmorna sätter sitt pris per kvadratmeter takyta, och den ytan är alltid större än husets bottenyta. Taket sticker ut över väggarna, och eftersom det lutar är varje takfall längre än det vågräta avståndet från takets kant in till nocken.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Du kan räkna ut takarean själv med en miniräknare. Lägg gavelutsprånget två gånger till husets längd och takutsprånget två gånger till bredden, och multiplicera de två talen. Då har du ytan som taket täcker sett uppifrån. Dela den med cosinus för takvinkeln, så får du ytan längs lutningen, och det är den som ska stå i offerten.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Utsprången är lätta att glömma, men på ett långt hus blir de många kvadratmeter. Vet du inte takvinkeln kan du mäta nockhöjden i stället, från takfoten vid väggen upp till nocken, så räknar jag fram vinkeln ur den och gavelns bredd. I tabellen ser du hur mycket lutningen lägger till och hur högt nocken står för varje meter av halva bredden.
      </p>
      <Tabellyta kolumner={3} class="mt-4">
        <table class={TAL_TABELL_KLASS}>
          <thead>
            <tr>
              <th scope="col">{TEXT.paslag['rubrik-lutning']}</th>
              <th scope="col">{TEXT.paslag['rubrik-procent']}</th>
              <th scope="col">{TEXT.paslag['rubrik-nock']}</th>
            </tr>
          </thead>
          <tbody>
            {
              paslag.map((r) => (
                <tr class:list={[r === narmast && 'font-bold']}>
                  <th scope="row">{r.grader}</th>
                  <td>{procentText(r.procent)}</td>
                  <td>{meterText(r.nockPerMeter)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </Tabellyta>
      <p class="m-0 mt-2 text-liten text-blyerts-2">{TEXT.paslag.rad}</p>
    </section>

    <section class:list={['max-w-lasbredd', LANKAR_KLASS]}>
      {/*
        Vad som ingår i priset: rivning, underlag, läkt, material, plåtdetaljer,
        ställning och container. Arbete och material för sig. Länk till /tak/plattak/.
      */}
      <Pennstreck>{H2_PRISET}</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        Ett takbyte är mer än nya pannor. Firman river det gamla taket, lagar eller byter underlaget, lägger ny underlagspapp och läkt och sedan pannorna eller plåten. Till det kommer plåtdetaljerna vid nocken, skorstenen och takfoten, en ställning runt huset och en container för det som rivs.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Allt det där ingår i priserna per kvadratmeter som räknaren använder, också ställningen och containern. Står de som egna rader i en offert är det samma kostnad, bara uppdelad. Resor och etablering ligger i plåtpriserna, men källan till pannpriserna tar betalt för resor och etablering utöver kvadratmeterpriset, och därför läggs de till som en egen summa när du väljer pannor eller papp. Arbetet och materialet är uppdelade som källorna själva delar dem.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        I källan som har både betong- och tegelpannor kostar de lika mycket att lägga, och hela skillnaden sitter i pannorna. Med plåt är det arbetet som skiljer. Takpanneplåt är billig både att köpa och att lägga, medan arbetet med en falsad bandtäckning kostar flera gånger mer per kvadratmeter. Vilken plåt som fungerar beror på hur brant taket är, och i <a href="/tak/plattak/">texten om plåttak</a> ser du vilka sorter som klarar din lutning.
      </p>
    </section>

    <section class:list={['max-w-lasbredd', LANKAR_KLASS]}>
      {/* Rotavdraget på takbytet: två ägare och vad som räknas som arbete. Länk till /rakna/rotavdrag/. */}
      <Pennstreck>{H2_ROT}</Pennstreck>
      <p class="m-0 text-brod lg:text-brod-lg">
        Hur stort rotavdraget blir beror på hur mycket av fakturan som är arbete, och det skiljer sig mellan materialen. På betongpannor är arbetet drygt hälften av kostnaden i källan, och på takpanneplåt knappt en fjärdedel, så samma takyta ger väldigt olika avdrag.
      </p>
      <p class="m-0 mt-4 text-brod lg:text-brod-lg">
        Ett dyrt material på ett stort tak kan göra slut på avdraget, och därför frågar formuläret hur många ni är som äger huset och hur mycket rotavdrag som redan är använt i år. Har någon av er också köpt städning eller trädgårdshjälp med rutavdrag räcker gränsen inte lika långt, och det räknar <a href="/rakna/rotavdrag/">räknaren för rotavdrag</a> ut. Länken i svaret fyller i arbetet och materialet åt dig, vid det högsta priset när det finns ett spann.
      </p>
    </section>

    {
      (lasVidare.length > 0 || lasVidareLankar.length > 0) && (
        <section>
          <Pennstreck id="las-vidare">Läs vidare</Pennstreck>
          {lasVidare.length > 0 && (
            <Artikelrutnat
              kort={lasVidare}
              kolumner={lasVidare.length === 4 ? 4 : 3}
              visaBeskrivning={false}
              visaMeta={false}
            />
          )}
          {lasVidareLankar.length > 0 && (
            <ul class="m-0 mt-4 p-0 list-none max-w-lasbredd">
              {lasVidareLankar.map((l) => (
                <li class="border-t border-linje">
                  <a href={l.href} class:list={['flex min-h-11 items-center py-2', LANK_KLASS]}>
                    {l.text}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </section>
      )
    }

    {
      FRAGOR.length > 0 && (
        <div class="max-w-lasbredd">
          <Faq fragor={FRAGOR} />
        </div>
      )
    }
  </Fragment>
</Raknarsida>
