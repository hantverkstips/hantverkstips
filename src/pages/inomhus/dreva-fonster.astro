---
/**
 * Permanent omdirigering. Sidan flyttade till pelaren fasad 2026-09-17 när
 * pelarstrukturen gjordes om. En serverrutt i stället för `redirects` i
 * astro.config: adaptern skriver den regeln utan avslutande snedstreck, och
 * med trailingSlash 'always' matchar den då aldrig den adress som faktiskt
 * anropas. Rutten ligger i en statisk mapp och vinner över [rot]/[slug].
 */
export const prerender = false;
return Astro.redirect('/fasad/dreva-fonster/', 301);
