---
/**
 * Baslayout: sidhuvud, reklamband, brödsmulor, innehåll, sidfot.
 * Ingen klient-JavaScript. Mobilmenyn är ett <details>.
 *
 * sidtyp sätts inte här utan av rutten, överst i dess frontmatter, eftersom
 * slot-innehåll renderas före layoutens frontmatter.
 */
import '../styles/global.css';
import ikoner from '../assets/brand/riktning-1/ikoner.svg?raw';
import ordmarke from '../assets/brand/riktning-1/ordmarke-inline.svg?raw';
import { kategoriUrl, pelareUrl, publicerade, type Brodsmula } from '../lib/innehall';
import { KALKYLATORER } from '../lib/kalkyl/register';
import { MAX_HUBBAR_I_MENY, PELARE } from '../lib/pelare';
import { brodsmulor as brodsmulorData } from '../lib/strukturdata';
import Brodsmulor from '../components/ui/Brodsmulor.astro';
import Ikon, { type IkonNamn } from '../components/ui/Ikon.astro';
import Reklamband from '../components/ui/Reklamband.astro';
import StrukturData from '../components/ui/StrukturData.astro';

interface Props {
  title: string;
  description: string;
  /** Visar Reklamband. Sätts av rutten efter sidtyp och innehåll. */
  reklam?: boolean;
  butikNamn?: string;
  /** Utelämnas på startsidan. */
  brodsmulor?: Brodsmula[];
  /**
   * Vyn renderar <Brodsmulor> själv, i sin egen spalt, så att brödsmulorna får
   * samma vänsterkant som rubriken och innehållet. Layouten skriver ändå ut
   * BreadcrumbList. Används av alla vyer med tvåspaltsmallen.
   */
  brodsmulorIVy?: boolean;
  /** main får sidbredd i stället för läsbredd. Kategori, jämförelse, kalkylator. */
  bred?: boolean;
  noindex?: boolean;
  /**
   * Delningsbild (og:image). Sökväg i bygget eller absolut adress. Utelämnad,
   * eller inlinead som data-URI av Vite, används sajtens standardbild.
   * Facebook, LinkedIn och Slack hämtar ingen SVG, därför en PNG.
   */
  ogBild?: string;
  /** article på artiklar och tester, website på hubbar, kategorier och verktyg. */
  ogTyp?: 'website' | 'article';
  /**
   * Paginerad lista: adresserna till föregående och nästa sida, som rel-länkar i
   * <head>. Sida 1 är kanonisk för filtret, sida 2 och uppåt är indexerbara och
   * länkas bara från varandra. Används av /guider/.
   */
  paginering?: { foregaende?: string; nasta?: string };
}

const {
  title,
  description,
  reklam = false,
  butikNamn,
  brodsmulor,
  brodsmulorIVy = false,
  bred = false,
  noindex = false,
  ogBild,
  ogTyp = 'website',
  paginering,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);

/**
 * En liten SVG inlineas av Vite som data-URI, och en data-URI duger inte som
 * delningsbild. Då, och när sidan saknar egen bild, används den sajtgemensamma
 * bilden i 1200 × 630 (scripts/generera-delningsbilder.mjs).
 */
const OG_STANDARD = '/og-standard.png';
const ogBildUrl = new URL(ogBild && !ogBild.startsWith('data:') ? ogBild : OG_STANDARD, Astro.site);

const hubbar = await publicerade('pelare');
const kategorier = await publicerade('kategorier');

const publiceradeHubbar = PELARE.flatMap((p) => {
  const entry = hubbar.find((h) => h.id === p.slug);
  return entry ? [{ slug: p.slug, namn: p.namn, kort: p.kort, ikon: p.ikon }] : [];
});

/**
 * Huvudmenyn byggs av de publicerade hubbarna i PELARE-ordning, högst
 * MAX_HUBBAR_I_MENY stycken, följda av Ämnen, Guider, Räkna själv och Så testar
 * vi. En pelare kommer alltså in i menyn genom att dess hub får utkast: false,
 * inte genom en ändring här; pelare utanför de tre finns under Ämnen.
 * Se docs/INNEHALLSARKITEKTUR.md avsnitt 4 och docs/DESIGN.md avsnitt 5.
 */
interface Menypost {
  namn: string;
  href: string;
  ikon: IkonNamn | null;
}
const MENYHUBBAR: Menypost[] = publiceradeHubbar
  .slice(0, MAX_HUBBAR_I_MENY)
  .map((p) => ({ namn: p.kort, href: pelareUrl(p.slug), ikon: p.ikon }));

const HUVUDMENY: Menypost[] = [
  ...MENYHUBBAR,
  { namn: 'Ämnen', href: '/amnen/', ikon: null },
  { namn: 'Guider', href: '/guider/', ikon: null },
  { namn: 'Räkna själv', href: '/rakna/', ikon: 'kalkylator' },
  { namn: 'Så testar vi', href: '/om/sa-testar-vi/', ikon: null },
];

/** Mobilmenyn har längre namn än desktopmenyn, som ska få plats i en rad. */
const MOBIL_AMNEN: Menypost[] = [...MENYHUBBAR, { namn: 'Alla ämnen', href: '/amnen/', ikon: null }];
const MOBIL_VERKTYG: Menypost[] = [
  { namn: 'Guider och tester', href: '/guider/', ikon: null },
  { namn: 'Räkna själv', href: '/rakna/', ikon: 'kalkylator' },
];
const MOBIL_OM: Menypost[] = [
  { namn: 'Så testar vi', href: '/om/sa-testar-vi/', ikon: null },
  { namn: 'Om Hantverkstips', href: '/om/', ikon: null },
];

const OM_SAJTEN = [
  { namn: 'Om oss', href: '/om/' },
  { namn: 'Så testar vi', href: '/om/sa-testar-vi/' },
  { namn: 'Så tjänar vi pengar', href: '/om/sa-tjanar-vi-pengar/' },
  { namn: 'Författare', href: '/forfattare/redaktionen/' },
  { namn: 'Kontakt', href: '/om/kontakt/' },
  { namn: 'Integritet', href: '/om/integritet/' },
];

const menyKategorier = kategorier.slice(0, 4);
const ar = new Date().getFullYear();
const sidfotLank = 'text-papper underline decoration-1 underline-offset-2 hover:decoration-2';
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {paginering?.foregaende && <link rel="prev" href={new URL(paginering.foregaende, Astro.site)} />}
    {paginering?.nasta && <link rel="next" href={new URL(paginering.nasta, Astro.site)} />}

    {/* Delning i Facebook, LinkedIn, Slack och Messenger. Samma text som title
        och description: två sanningar om samma sida håller inte i längden. */}
    <meta property="og:type" content={ogTyp} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogBildUrl} />
    <meta property="og:site_name" content="Hantverkstips" />
    <meta property="og:locale" content="sv_SE" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/zilla-slab-latin-600.woff2" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/atkinson-hyperlegible-latin-400.woff2"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/atkinson-hyperlegible-latin-700.woff2"
    />
    {brodsmulor && brodsmulor.length > 0 && <StrukturData data={brodsmulorData(brodsmulor)} />}
    <slot name="head" />
  </head>

  <body class="min-h-dvh flex flex-col bg-papper text-blyerts text-brod lg:text-brod-lg">
    <a href="#innehall" class="hoppa">Hoppa till innehåll</a>

    <Fragment set:html={ikoner} />

    <header class="relative border-b border-linje">
      <div class="mx-auto max-w-sidbredd px-4 sm:px-6 lg:px-8 h-14 lg:h-16 flex items-center justify-between">
        <a href="/" class="ordmarke" aria-label="Hantverkstips, till startsidan">
          <Fragment set:html={ordmarke} />
        </a>

        <nav aria-label="Huvudmeny" class="huvudmeny hidden lg:flex items-center gap-6">
          {
            HUVUDMENY.map((m) => (
              <a href={m.href} class="text-blyerts no-underline hover:underline hover:decoration-penna">
                {m.namn}
              </a>
            ))
          }
        </nav>

        <details class="meny lg:hidden">
          <summary class="flex min-h-11 items-center gap-2 px-2 font-bold text-blyerts">
            <Ikon namn="meny" storlek={24} />
            Meny
          </summary>
          <div
            class="absolute left-0 right-0 top-full z-50 border-b border-linje bg-papper shadow-lyft px-4 sm:px-6"
          >
            <ul class="m-0 p-0 list-none">
              {
                MOBIL_AMNEN.map((m) => (
                  <li class="border-b border-linje">
                    <a href={m.href} class="flex h-12 items-center gap-3 text-blyerts no-underline">
                      {m.ikon && <Ikon namn={m.ikon} storlek={24} />}
                      {m.namn}
                    </a>
                  </li>
                ))
              }
            </ul>

            <ul class="m-0 p-0 list-none">
              {
                MOBIL_VERKTYG.map((m) => (
                  <li class="border-b border-linje">
                    <a href={m.href} class="flex h-12 items-center gap-3 text-blyerts no-underline">
                      {m.ikon && <Ikon namn={m.ikon} storlek={24} />}
                      {m.namn}
                    </a>
                  </li>
                ))
              }
            </ul>

            {
              menyKategorier.length > 0 && (
                <>
                  <p class="m-0 pt-3 text-etikett uppercase text-blyerts-2">Bäst i test</p>
                  <ul class="m-0 p-0 list-none">
                    {menyKategorier.map((k) => (
                      <li class="border-b border-linje">
                        <a href={kategoriUrl(k.id)} class="flex h-12 items-center text-blyerts no-underline">
                          {k.data.namn}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              )
            }

            <ul class="m-0 p-0 pb-2 list-none">
              {
                MOBIL_OM.map((m) => (
                  <li>
                    <a href={m.href} class="flex h-12 items-center text-blyerts no-underline">
                      {m.namn}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </details>
      </div>
    </header>

    {reklam && <Reklamband butikNamn={butikNamn} />}

    <main
      id="innehall"
      tabindex="-1"
      class:list={[
        'flex-1 w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12',
        bred ? 'max-w-sidbredd' : 'max-w-lasbredd',
      ]}
    >
      {brodsmulor && brodsmulor.length > 0 && !brodsmulorIVy && (
        <div class="mb-6">
          <Brodsmulor lista={brodsmulor} />
        </div>
      )}
      <slot />
    </main>

    <footer class="mt-12 lg:mt-24 bg-blyerts text-papper text-liten">
      <div class="mx-auto max-w-sidbredd px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
        <div class="ordmarke" style="--color-blyerts: var(--color-papper)">
          <Fragment set:html={ordmarke} />
        </div>

        <div class="mt-8 grid gap-8 lg:grid-cols-4">
          <div>
            <p class="m-0 mb-2 text-etikett uppercase">Ämnen</p>
            <ul class="m-0 p-0 list-none">
              {
                publiceradeHubbar.map((p) => (
                  <li class="mb-2">
                    <a href={pelareUrl(p.slug)} class={sidfotLank}>
                      {p.namn}
                    </a>
                  </li>
                ))
              }
              <li class="mb-2">
                <a href="/amnen/" class={sidfotLank}>Alla ämnen</a>
              </li>
              <li class="mb-2">
                <a href="/guider/" class={sidfotLank}>Alla guider och tester</a>
              </li>
            </ul>
          </div>

          <div>
            <p class="m-0 mb-2 text-etikett uppercase">Bäst i test</p>
            <ul class="m-0 p-0 list-none">
              {
                kategorier.map((k) => (
                  <li class="mb-2">
                    <a href={kategoriUrl(k.id)} class={sidfotLank}>
                      {k.data.namn}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <p class="m-0 mb-2 text-etikett uppercase">Räkna själv</p>
            <ul class="m-0 p-0 list-none">
              {
                KALKYLATORER.map((k) => (
                  <li class="mb-2">
                    <a href={`/rakna/${k.slug}/`} class={sidfotLank}>
                      {k.namn}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <p class="m-0 mb-2 text-etikett uppercase">Om sajten</p>
            <ul class="m-0 p-0 list-none">
              {
                OM_SAJTEN.map((o) => (
                  <li class="mb-2">
                    <a href={o.href} class={sidfotLank}>
                      {o.namn}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <p class="m-0 mt-8">© {ar} Hantverkstips</p>
      </div>
    </footer>
  </body>
</html>
