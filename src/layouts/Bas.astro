---
/**
 * Baslayout: sidhuvud, reklamband, brödsmulor, innehåll, sidfot.
 * Ingen klient-JavaScript. Mobilmenyn är ett <details>.
 *
 * sidtyp sätts inte här utan av rutten, överst i dess frontmatter, eftersom
 * slot-innehåll renderas före layoutens frontmatter.
 */
import '../styles/global.css';
import ordmarke from '../assets/brand/riktning-1/ordmarke-inline.svg?raw';
import { pelareUrl, publicerade, type Brodsmula } from '../lib/innehall';
import { inlankar } from '../lib/kalkyl/inlankar';
import { KALKYLATORER } from '../lib/kalkyl/register';
import { PELARE, PELAREGRUPPER } from '../lib/pelare';
import { byggmanad, iSasong } from '../lib/sasong';
import { brodsmulor as brodsmulorData } from '../lib/strukturdata';
import Brodsmulor from '../components/ui/Brodsmulor.astro';
import Ikon, { type IkonNamn } from '../components/ui/Ikon.astro';
import Reklamband from '../components/ui/Reklamband.astro';
import StrukturData from '../components/ui/StrukturData.astro';

interface Props {
  /** Sidans titel utan varumärke. Layouten lägger på " · Hantverkstips" när den får plats. */
  title: string;
  description: string;
  /** Visar Reklamband. Sätts av rutten efter sidtyp och innehåll. */
  reklam?: boolean;
  butikNamn?: string;
  /** Utelämnas på startsidan. */
  brodsmulor?: Brodsmula[];
  /**
   * Vyn renderar <Brodsmulor> själv, i sin egen spalt, så att brödsmulorna får
   * samma vänsterkant som rubriken och innehållet. Layouten skriver ändå ut
   * BreadcrumbList. Används av alla vyer med tvåspaltsmallen.
   */
  brodsmulorIVy?: boolean;
  /** main får sidbredd i stället för läsbredd. Kategori, jämförelse, kalkylator. */
  bred?: boolean;
  /**
   * Galleri­sida (startsidan, pelarhubben, räkna-indexet): main utan bredd,
   * marginal och luft, eftersom sidan bygger sina sektioner och band själv med
   * .sidram och .band, och sidfoten utan luft ovanför. Spec fas A avsnitt 3.
   */
  galleri?: boolean;
  noindex?: boolean;
  /**
   * Delningsbild (og:image). Sökväg i bygget eller absolut adress. Utelämnad,
   * eller inlinead som data-URI av Vite, används sajtens standardbild.
   * Facebook, LinkedIn och Slack hämtar ingen SVG, därför en PNG.
   */
  ogBild?: string;
  /** article på artiklar och tester, website på hubbar, kategorier och verktyg. */
  ogTyp?: 'website' | 'article';
  /**
   * Paginerad lista: adresserna till föregående och nästa sida, som rel-länkar i
   * <head>. Sida 1 är kanonisk för filtret, sida 2 och uppåt är indexerbara och
   * länkas bara från varandra. Används av /guider/.
   */
  paginering?: { foregaende?: string; nasta?: string };
}

const {
  title,
  description,
  reklam = false,
  butikNamn,
  brodsmulor,
  brodsmulorIVy = false,
  bred = false,
  galleri = false,
  noindex = false,
  ogBild,
  ogTyp = 'website',
  paginering,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);

/**
 * Varumärket sist i titeln, men bara när hela titeln ryms i sökresultatet.
 * Google klipper vid ungefär 60 tecken, och en seoTitle på 58 tecken plus
 * suffixet blir 74 och klipps mitt i löftet (granskningen 2026-09-16 punkt 5.9).
 * Står Hantverkstips redan i titeln, som på startsidan, läggs inget på.
 */
const SUFFIX = ' · Hantverkstips';
const MAX_TITEL = 60;
const medSuffix = `${title}${SUFFIX}`;
const sidtitel =
  title.includes('Hantverkstips') || medSuffix.length > MAX_TITEL ? title : medSuffix;

/**
 * En liten SVG inlineas av Vite som data-URI, och en data-URI duger inte som
 * delningsbild. Då, och när sidan saknar egen bild, används den sajtgemensamma
 * bilden i 1200 × 630 (scripts/generera-delningsbilder.mjs).
 *
 * Vyerna skickar sedan 2026-09-17 sidans egen PNG ur public/og/, hämtad med
 * delningsbild() i src/lib/delningsbild.ts, i stället för frontmatterns SVG.
 */
const OG_STANDARD = '/og-standard.png';
const ogBildUrl = new URL(ogBild && !ogBild.startsWith('data:') ? ogBild : OG_STANDARD, Astro.site);

/**
 * max-image-preview:large ber Google visa sidans bild i full bredd i sökresultat
 * och i Discover; utan direktivet får en svensk sajt en miniatyr. Taggen står på
 * varje sida, och på en noindex-sida står båda värdena i samma tagg: två
 * robots-taggar med olika innehåll är odefinierat och Google tar den strängaste.
 */
const robots = noindex ? 'noindex, max-image-preview:large' : 'max-image-preview:large';

const hubbar = await publicerade('pelare');

const publiceradeHubbar = PELARE.flatMap((p) => {
  const entry = hubbar.find((h) => h.id === p.slug);
  return entry ? [{ slug: p.slug, namn: p.namn, kort: p.kort, ikon: p.ikon }] : [];
});

/**
 * Sidhuvudet, omgjort 2026-09-17 efter Christians krav: bättre kategorier,
 * Om oss och Kontakt. Två rader. Övre raden bär ordmärket och sajtens
 * fasta sidor: Guider, Räkna själv, Om oss, Kontakt. Undre raden är
 * ämnesraden: alla publicerade pelare i PELARE-ordning (tak till grund, ute
 * före inne, sedan hela huset) med ikon, och sist Alla ämnen. En pelare kommer
 * in i raden genom att dess hub får utkast: false, aldrig genom en ändring här.
 * Mobilen har allt i en meny bakom Meny-knappen, grupperat som ämnesraden.
 */
interface Menypost {
  namn: string;
  href: string;
  ikon: IkonNamn | null;
}
const FASTA: Menypost[] = [
  { namn: 'Guider', href: '/guider/', ikon: null },
  { namn: 'Räkna själv', href: '/rakna/', ikon: 'kalkylator' },
  { namn: 'Om mig', href: '/om/', ikon: null },
  { namn: 'Kontakt', href: '/om/kontakt/', ikon: null },
];
const AMNESRAD: Menypost[] = publiceradeHubbar.map((p) => ({ namn: p.kort, href: pelareUrl(p.slug), ikon: p.ikon }));
/**
 * Den aktuella pelaren i ämnesraden: första segmentet i adressen lika med en
 * publicerad hub. Hubben själv får aria-current="page", en sida under den "true",
 * och CSS ger chipen ytan tumstock (docs/DESIGN.md avsnitt 5, Ämnesraden).
 */
const segment = Astro.url.pathname.split('/').filter(Boolean);
const aktuellPelare = publiceradeHubbar.find((p) => p.slug === segment[0])?.slug;
const aktuell = (href: string): 'page' | 'true' | undefined =>
  aktuellPelare && href === pelareUrl(aktuellPelare) ? (segment.length === 1 ? 'page' : 'true') : undefined;
/** Raden under ordmärket i sidfoten. */
const SIDFOT_RAD = 'Jag skriver om att bygga, laga och sköta ett hus.'; // sidfot.rad
/** Mobilmenyn grupperar ämnena som ämnesraden på startsidan. */
const MOBIL_GRUPPER = PELAREGRUPPER.map((g) => ({
  namn: g.namn,
  poster: publiceradeHubbar
    .filter((p) => PELARE.find((x) => x.slug === p.slug)?.grupp === g.slug)
    .map((p) => ({ namn: p.namn, href: pelareUrl(p.slug), ikon: p.ikon }) as Menypost),
})).filter((g) => g.poster.length > 0);

/**
 * Sidfoten, kortad 2026-10-02 (spec-designlyft-a-2026-10-02 avsnitt 12.3,
 * SEO-beslut i docs/SOKORDSANALYS.md avsnitt 13 punkt 1). Fyra spalter:
 * varumärket, Ämnen, Räkna själv, Om sajten. Ingen Bäst i test-spalt.
 */
const SIDFOT_AMNEN = ['fukt', 'badrum', 'kok', 'tak'];
const sidfotAmnen = SIDFOT_AMNEN.flatMap((slug) => publiceradeHubbar.filter((p) => p.slug === slug));

/**
 * Tre räknare i säsong för byggmånaden, i registerordning. Är färre än tre i
 * säsong fylls listan på med rotavdrag och sedan i registerordning, utan dubbletter.
 * En räknare som färre än två innehållsfiler länkar till väljs aldrig (avsnitt 12.7).
 */
const manad = byggmanad();
const raknarInlankar = inlankar();
const sidfotRaknare = [
  ...KALKYLATORER.filter((k) => iSasong(k.sasong, manad)),
  ...KALKYLATORER.filter((k) => k.slug === 'rotavdrag'),
  ...KALKYLATORER,
]
  .filter((k) => (raknarInlankar.get(k.slug) ?? 0) >= 2)
  .filter((k, i, lista) => lista.indexOf(k) === i)
  .slice(0, 3);

const OM_SAJTEN = [
  { namn: 'Så testar jag', href: '/om/sa-testar-vi/' },
  { namn: 'Så tjänar jag pengar', href: '/om/sa-tjanar-vi-pengar/' },
  { namn: 'Kontakt', href: '/om/kontakt/' },
  { namn: 'Integritet', href: '/om/integritet/' },
];

/**
 * Källfilens kommentar och indrag skalas bort här i bygget, inte i filen
 * (docs/briefer/spec-skal-budget-2026-09-28.md steg 2).
 */
const ordmarkeRen = ordmarke.replace(/<!--[\s\S]*?-->/g, '').replace(/>\s+</g, '><').trim();

/**
 * Sedan 2026-09-29 står ordmärket inline bara i sidhuvudet, med innehållet i
 * <g id="ordmarke">. Sidfoten ritar samma grupp med <use>. Gruppen ligger kvar i
 * dokumentet, så Zilla Slab och omfärgningen med --color-blyerts ärvs in i
 * skuggträdet som förut (docs/briefer/spec-skal-budget-2-2026-09-29.md punkt 1).
 */
const ordmarkeDelar = /^(<svg[^>]*>)([\s\S]*)<\/svg>$/.exec(ordmarkeRen);
if (!ordmarkeDelar) throw new Error('ordmarke-inline.svg: rotelementet hittas inte');
const [, ordmarkeRot, ordmarkeInnehall] = ordmarkeDelar;
const ordmarkeHuvud = `${ordmarkeRot}<g id="ordmarke">${ordmarkeInnehall}</g></svg>`;
const ordmarkeFot = `${ordmarkeRot}<use href="#ordmarke"/></svg>`;

const ar = new Date().getFullYear();
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{sidtitel}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    {paginering?.foregaende && <link rel="prev" href={new URL(paginering.foregaende, Astro.site)} />}
    {paginering?.nasta && <link rel="next" href={new URL(paginering.nasta, Astro.site)} />}

    {/* Delning i Facebook, LinkedIn, Slack och Messenger. Samma text som title
        och description: två sanningar om samma sida håller inte i längden. */}
    <meta property="og:type" content={ogTyp} />
    <meta property="og:title" content={sidtitel} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogBildUrl} />
    <meta property="og:site_name" content="Hantverkstips" />
    <meta property="og:locale" content="sv_SE" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/zilla-slab-latin-600.woff2" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/atkinson-hyperlegible-latin-400.woff2"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/atkinson-hyperlegible-latin-700.woff2"
    />
    {brodsmulor && brodsmulor.length > 0 && <StrukturData data={brodsmulorData(brodsmulor)} />}
    <slot name="head" />
  </head>

  <body class="min-h-dvh flex flex-col bg-papper text-blyerts text-brod lg:text-brod-lg">
    <a href="#innehall" class="hoppa print:hidden">Hoppa till innehåll</a>

    <header class="relative border-b border-linje print:hidden">
      <div class="mx-auto max-w-sidbredd px-4 sm:px-6 lg:px-8 h-14 lg:h-16 flex items-center justify-between">
        <a href="/" class="ordmarke" aria-label="Hantverkstips, till startsidan">
          <Fragment set:html={ordmarkeHuvud} />
        </a>

        <nav
          aria-label="Sajtens sidor"
          class="huvudmeny sajtmeny hidden lg:flex items-center gap-6"
        >
          {
            FASTA.map((m) => (
              <a href={m.href}>{m.namn}</a>
            ))
          }
        </nav>

        <details class="meny lg:hidden">
          <summary class="flex min-h-11 items-center gap-2 px-2 font-bold text-blyerts">
            <Ikon namn="meny" storlek={24} />
            Meny
          </summary>
          <div
            class="menypanel absolute left-0 right-0 top-full z-50 border-b border-linje bg-papper shadow-lyft px-4 sm:px-6 pb-2"
          >
            {
              MOBIL_GRUPPER.map((g) => (
                <>
                  <p class="m-0 pt-3 text-etikett uppercase text-blyerts-2">{g.namn}</p>
                  <ul class="m-0 p-0 list-none">
                    {g.poster.map((m) => (
                      <li>
                        <a href={m.href}>
                          {m.ikon && <Ikon namn={m.ikon} storlek={null} />}
                          {m.namn}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ))
            }
            <ul class="m-0 p-0 list-none">
              <li>
                <a href="/amnen/" class="font-bold">
                  Alla ämnen
                </a>
              </li>
              {
                FASTA.map((m) => (
                  <li class="last:border-b-0">
                    <a href={m.href}>
                      {m.ikon && <Ikon namn={m.ikon} storlek={null} />}
                      {m.namn}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </details>
      </div>

      {/* Ämnesraden. Bara på desktop; mobilen har ämnena i menyn. Raden bryts när hubbarna inte ryms, aldrig sidledsrullning. */}
      <nav aria-label="Ämnen" class="amnesrad hidden lg:block border-t border-linje bg-papper-2">
        <ul
          class="mx-auto max-w-sidbredd px-8 m-0 py-1 list-none flex items-center gap-2 flex-wrap"
        >
          {
            AMNESRAD.map((m) => (
              <li>
                <a href={m.href} aria-current={aktuell(m.href)}>
                  {m.ikon && <Ikon namn={m.ikon} storlek={null} />}
                  {m.namn}
                </a>
              </li>
            ))
          }
          <li class="ml-auto">
            <a
              href="/amnen/"
              class="flex h-11 items-center whitespace-nowrap px-3 text-liten lank"
            >
              Alla ämnen
            </a>
          </li>
        </ul>
      </nav>
    </header>

    {reklam && <Reklamband butikNamn={butikNamn} />}

    <main
      id="innehall"
      tabindex="-1"
      class:list={
        galleri
          ? 'flex-1 w-full'
          : ['flex-1 w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12', bred ? 'max-w-sidbredd' : 'max-w-lasbredd']
      }
    >
      {brodsmulor && brodsmulor.length > 0 && !brodsmulorIVy && (
        <div class="mb-6 print:hidden">
          <Brodsmulor lista={brodsmulor} />
        </div>
      )}
      <slot />
    </main>

    <footer class:list={[galleri ? 'mt-0' : 'mt-12 lg:mt-24', 'bg-blyerts text-papper text-liten print:hidden']}>
      <div
        class="sidfot mx-auto max-w-sidbredd px-4 sm:px-6 lg:px-8 py-8 lg:py-12"
      >
        <div class="grid gap-8 lg:grid-cols-4">
          <div>
            <div class="ordmarke" style="--color-blyerts: var(--color-papper)">
              <Fragment set:html={ordmarkeFot} />
            </div>
            <p class="m-0 mt-3 text-linje">{SIDFOT_RAD}</p>
            <p class="m-0 mt-2 text-finstilt text-linje">© {ar} Hantverkstips</p>
          </div>

          <div>
            <p class="m-0 mb-2 text-etikett uppercase text-linje">Ämnen</p>
            <ul class="m-0 p-0 list-none">
              {
                sidfotAmnen.map((p) => (
                  <li>
                    <a href={pelareUrl(p.slug)}>
                      {p.namn}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <p class="m-0 mb-2 text-etikett uppercase text-linje">Räkna själv</p>
            <ul class="m-0 p-0 list-none">
              {
                sidfotRaknare.map((k) => (
                  <li>
                    <a href={`/rakna/${k.slug}/`}>
                      {k.namn}
                    </a>
                  </li>
                ))
              }
              <li>
                <a href="/rakna/">Alla räknare</a>
              </li>
            </ul>
          </div>

          <div>
            <p class="m-0 mb-2 text-etikett uppercase text-linje">Om sajten</p>
            <ul class="m-0 p-0 list-none">
              {
                OM_SAJTEN.map((o) => (
                  <li>
                    <a href={o.href}>
                      {o.namn}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
