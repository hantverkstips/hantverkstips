---
/**
 * Formuläret till daggpunktskalkylatorn. Ett ställe: sidan /rakna/daggpunkt/
 * renderar det i fullt format, och <Kalkylator namn="daggpunkt" /> i en artikel
 * renderar samma fält i kompakt format med action till verktygssidan.
 *
 * Ingen klient-JavaScript. Formuläret skickas som GET, och verktygssidan räknar.
 *
 * Alla props är valfria, eftersom det inbäddade formuläret inte har någon
 * uträkning att visa värden ur; då står standardvärdena i fälten.
 */
import {
  ARSTIDER,
  formVarden,
  RUMSVAL,
  STANDARD,
  TYPISKA_U,
  TYPISKA_YTOR,
  type DaggpunktIndata,
} from '../../lib/kalkyl/daggpunkt';
import { formateraTal } from '../../lib/format';
import { ETIKETT_KLASS, FALT_KLASS, FEL_KLASS, HJALP_KLASS, KNAPP_KLASS, ramKlass, VAL_KLASS } from '../../lib/kalkyl/stil';

interface Props {
  /** Valen som ska vara ikryssade. Standardvärdena när propen utelämnas. */
  indata?: DaggpunktIndata;
  /** Talen som de skrevs i adressen, så att ett felskrivet värde går att rätta. */
  varden?: { temp: string; rf: string; ytatemp: string; u: string; ute: string };
  fel?: Partial<Record<keyof DaggpunktIndata, string>>;
  /** Inbäddad i en artikel: tätare fält, inga hjälprader. */
  kompakt?: boolean;
  /** Prefix på id-attributen, så att två formulär på samma sida inte krockar. */
  idPrefix?: string;
  knappText?: string;
  /**
   * 'luften': bara temperaturen och luftfuktigheten inne, två i bredd från 640 px,
   * inga andra fält och inga dolda fält; räknarsidan tar standardvärdena för
   * resten via tolkaQuery. Räkna-indexets Prova direkt
   * (spec-designlyft-a-2026-10-02 12.1). Standard 'alla'.
   */
  faltUrval?: 'alla' | 'luften';
}

const {
  indata = STANDARD,
  varden = formVarden(STANDARD),
  fel = {},
  kompakt = false,
  idPrefix = '',
  knappText = 'Räkna ut',
  faltUrval = 'alla',
} = Astro.props;

const allaFalt = faltUrval === 'alla';
/*
 * Slotten fore-knapp står mellan fälten och knappen, med knappens luft under sig.
 * Renderas först, eftersom ett villkor som blir false i slotten ändå räknas som en slot.
 */
const foreKnapp = Astro.slots.has('fore-knapp') ? (await Astro.slots.render('fore-knapp')).trim() : '';

const id = (namn: string) => `${idPrefix}${namn}`;
const radioKlass = kompakt ? 'flex flex-wrap gap-x-4' : '';

const talfalt = [
  {
    namn: 'temp',
    etikett: 'Temperaturen inne',
    enhet: '°C',
    varde: varden.temp,
    fel: fel.luftTempC,
    hjalp: null,
  },
  {
    namn: 'rf',
    etikett: 'Luftfuktigheten inne',
    enhet: '%',
    varde: varden.rf,
    fel: fel.rfProcent,
    hjalp: 'Det tal hygrometern visar mitt i rummet.',
  },
] as const;

/*
 * Fönstret: den kallaste ytan är glaset, och det räknas fram ur U-värdet och
 * temperaturen ute, så fältet för ytans temperatur byts mot två fält. Texterna
 * är hantverkarens (docs/briefer/texter-daggpunkt-rum-2026-09-30.md, F1 till F4).
 */
const fonster = indata.rum === 'fonster';
const fonsterfalt = [
  {
    namn: 'u',
    etikett: 'Fönstrets U-värde',
    enhet: 'W/m²K',
    varde: varden.u,
    fel: fel.uVarde,
    hjalp: 'Vet du inte fönstrets U-värde, ta talet för den sorts fönster du har.',
    lista: true,
  },
  {
    namn: 'ute',
    etikett: 'Temperaturen ute',
    enhet: '°C',
    varde: varden.ute,
    fel: fel.uteTempC,
    hjalp: 'Ju kallare det är ute, desto kallare blir glaset på insidan.',
    lista: false,
  },
] as const;
const uSpann = (s: readonly [number, number]) => `${formateraTal(s[0], 1)} till ${formateraTal(s[1], 1)}`;
---

<form method="get" action="/rakna/daggpunkt/">
  <div class:list={[(kompakt || !allaFalt) && 'sm:grid sm:grid-cols-2 sm:gap-4']}>
    {
      talfalt.map((f) => (
        <div class="mb-4">
          <label for={id(f.namn)} class={ETIKETT_KLASS}>
            {f.etikett}
          </label>
          <div class="flex items-center gap-2">
            <input
              id={id(f.namn)}
              name={f.namn}
              type="text"
              inputmode="decimal"
              value={f.varde}
              aria-describedby={f.fel ? id(`${f.namn}-fel`) : undefined}
              class:list={[FALT_KLASS, ramKlass(Boolean(f.fel))]}
            />
            <span class="text-brod text-blyerts-2">{f.enhet}</span>
          </div>
          {f.fel ? (
            <p id={id(`${f.namn}-fel`)} class={FEL_KLASS}>
              {f.fel}
            </p>
          ) : (
            !kompakt && f.hjalp && <p class={HJALP_KLASS}>{f.hjalp}</p>
          )}
        </div>
      ))
    }
  </div>

  {allaFalt && (
    fonster ? (
      fonsterfalt.map((f) => (
        <div class="mb-4">
          <label for={id(f.namn)} class={ETIKETT_KLASS}>
            {f.etikett}
          </label>
          <div class="flex items-center gap-2">
            <input
              id={id(f.namn)}
              name={f.namn}
              type="text"
              inputmode="decimal"
              value={f.varde}
              aria-describedby={f.fel ? id(`${f.namn}-fel`) : f.lista ? id(`${f.namn}-hjalp`) : undefined}
              class:list={[FALT_KLASS, ramKlass(Boolean(f.fel))]}
            />
            <span class="text-brod text-blyerts-2">{f.enhet}</span>
          </div>
          {f.fel && (
            <p id={id(`${f.namn}-fel`)} class={FEL_KLASS}>
              {f.fel}
            </p>
          )}
          {f.lista ? (
            <div id={id(`${f.namn}-hjalp`)} class={HJALP_KLASS}>
              <p class="m-0">{f.hjalp}</p>
              <ul class="m-0 mt-1 list-none p-0">
                {TYPISKA_U.map((t) => (
                  <li>
                    {t.typ}, {uSpann(t.spann)}
                  </li>
                ))}
              </ul>
            </div>
          ) : (
            !f.fel && !kompakt && <p class={HJALP_KLASS}>{f.hjalp}</p>
          )}
        </div>
      ))
    ) : (
  <div class="mb-4">
    <label for={id('ytatemp')} class={ETIKETT_KLASS}>Den kallaste ytans temperatur</label>
    <div class="flex items-center gap-2">
      <input
        id={id('ytatemp')}
        name="ytatemp"
        type="text"
        inputmode="decimal"
        value={varden.ytatemp}
        aria-describedby={fel.ytTempC ? id('ytatemp-fel') : id('ytatemp-hjalp')}
        class:list={[FALT_KLASS, ramKlass(Boolean(fel.ytTempC))]}
      />
      <span class="text-brod text-blyerts-2">°C</span>
    </div>
    {fel.ytTempC && <p id={id('ytatemp-fel')} class={FEL_KLASS}>{fel.ytTempC}</p>}
    <div id={id('ytatemp-hjalp')} class={HJALP_KLASS}>
      <p class="m-0">Har du inte mätt, gissa med hjälp av listan.</p>
      <ul class="m-0 mt-1 list-none p-0">
        {
          TYPISKA_YTOR.map((t) => (
            <li>
              {t.yta}, {t.spann}
            </li>
          ))
        }
      </ul>
      {
        !kompakt && (
          <p class="m-0 mt-1">
            Talen är mina antaganden och ingen publicerad tabell. Vill du ha ditt eget värde mäter du
            väggen med en IR-termometer.
          </p>
        )
      }
    </div>
  </div>
    )
  )}

  {allaFalt && (
  <>
  <fieldset class="m-0 mb-4 p-0 border-0">
    <legend class:list={[ETIKETT_KLASS, 'p-0']}>Årstid</legend>
    <div class={radioKlass}>
      {
        ARSTIDER.map((a) => (
          <label class={VAL_KLASS}>
            <input type="radio" name="arstid" value={a.varde} checked={indata.arstid === a.varde} />
            {a.etikett}
          </label>
        ))
      }
    </div>
  </fieldset>

  <fieldset class="m-0 mb-6 p-0 border-0">
    <legend class:list={[ETIKETT_KLASS, 'p-0']}>Utrymme eller fönster</legend>
    <div class={radioKlass}>
      {
        RUMSVAL.map((r) => (
          <label class={VAL_KLASS}>
            <input type="radio" name="rum" value={r.varde} checked={indata.rum === r.varde} />
            {r.etikett}
          </label>
        ))
      }
    </div>
  </fieldset>
  </>
  )}

  {foreKnapp !== '' && (
    <div class="mb-6">
      <Fragment set:html={foreKnapp} />
    </div>
  )}

  <button type="submit" class={KNAPP_KLASS}>{knappText}</button>
</form>
