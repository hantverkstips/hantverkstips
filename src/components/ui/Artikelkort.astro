---
/**
 * Artikelkortet: ett kort med bilden i en pappersruta, etikett, rubrik,
 * beskrivning och metarad. Samma kort bär artiklar, tester, jämförelser och
 * kategorisidor; det som skiljer är vad som skickas in. Se docs/DESIGN.md
 * avsnitt 6, Artikelkort, och spec-designlyft-a-2026-10-02 avsnitt 4.1.
 *
 * Hela kortet är klickbart, men länken är rubriken (regeln "rubriken är länken").
 * Tekniken är .kortlank::after i global.css, inte en <a> runt allt: skärmläsaren
 * ska få en länk per kort med rubriken som namn.
 *
 * Bilden är alltid en egen skiss eller ett eget foto. Kategorikortet har ingen
 * bild alls: det visar det blanka bladet med vårt val och antalet granskade.
 * Typografin står i .artikelkort-text i global.css; det stora kortet lägger sina
 * tillägg som verktyg, som vinner över komponentlagret.
 */
import { Image } from 'astro:assets';
import { formateraDatumKortMedAr } from '../../lib/format';
import { nivaEtikett, type Niva } from '../../lib/niva';
import { hittaPelare, type PelareSlug } from '../../lib/pelare';
import Ikon from './Ikon.astro';

interface Props {
  etikett: string;
  niva?: Niva;
  rubrik: string;
  beskrivning?: string;
  illustration?: ImageMetadata;
  /** Standard tom: bilden är dekorativ på ett kort, rubriken bär betydelsen. */
  bildAlt?: string;
  pelare: PelareSlug;
  datum?: Date;
  /** Fri text i metaraden i stället för datum: "9 granskade". */
  meta?: string;
  href: string;
  variant?: 'standard' | 'stor';
  /** Det stora kortets bild: halva bredden (startsidan) eller 1/2,4 (hubben). */
  storBild?: 'halv' | 'smal';
  /** Under 640 px pappersrutan som en ruta på 120 px till vänster, ingen beskrivning. */
  kompaktPaMobil?: boolean;
  /** Metaraden utan pelarnamn. Används på hubben, där alla kort har samma pelare. */
  visaPelare?: boolean;
  /** Standard true. Startsidans fyra kort har ingen beskrivning. */
  visaBeskrivning?: boolean;
  /** Standard true. Hubbens grupper har ingen metarad. */
  visaMeta?: boolean;
  rubrikniva?: 2 | 3;
  /** Kortets bild är sidans LCP-bild och laddas inte lazy. */
  prioriterad?: boolean;
  /** Kategorikortets bildyta: vårt val och antalet granskade på det blanka bladet. */
  bladfakta?: { val?: string; antal?: number };
}

const {
  etikett,
  niva,
  rubrik,
  beskrivning,
  illustration,
  bildAlt = '',
  pelare,
  datum,
  meta,
  href,
  variant = 'standard',
  storBild = 'halv',
  kompaktPaMobil = false,
  visaPelare = true,
  visaBeskrivning = true,
  visaMeta = true,
  rubrikniva = 3,
  prioriterad = false,
  bladfakta,
} = Astro.props;

const Rubrik = rubrikniva === 2 ? 'h2' : 'h3';
const p = hittaPelare(pelare);
const stor = variant === 'stor';
const kompakt = kompaktPaMobil && !stor;

const metadelar = [
  ...(visaPelare && p ? [p.kort] : []),
  ...(meta ? [meta] : datum ? [formateraDatumKortMedAr(datum)] : []),
];

// SVG kan inte skalas av bildtjänsten: med widths genereras bara kopior av samma
// fil. Skisserna renderas därför som vanliga <img> med width och height.
const svg = illustration?.format === 'svg';
const laddning = prioriterad ? ('eager' as const) : ('lazy' as const);
---

<article
  class:list={[
    'artikelkort kort',
    kompakt && 'artikelkort-kompakt',
    stor && 'lg:grid',
    stor && (storBild === 'smal' ? 'lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)]' : 'lg:grid-cols-2'),
  ]}
>
  <div class:list={['pappersruta', stor && 'p-5 lg:flex lg:items-center lg:border-b-0 lg:border-r lg:border-linje']}>
    {
      illustration ? (
        svg ? (
          <img
            src={illustration.src}
            alt={bildAlt}
            width={illustration.width}
            height={illustration.height}
            loading={laddning}
            {...(prioriterad ? { fetchpriority: 'high' as const } : {})}
            decoding="async"
          />
        ) : (
          <Image
            src={illustration}
            alt={bildAlt}
            widths={[375, 560, 760]}
            sizes="(min-width: 1024px) 380px, 100vw"
            loading={laddning}
            decoding="async"
          />
        )
      ) : (
        <div class:list={['plats-blad', stor && 'w-full']}>
          {bladfakta && (bladfakta.val || bladfakta.antal) ? (
            <div>
              {bladfakta.val && (
                <>
                  <p class="m-0 text-etikett uppercase text-blyerts">Mitt val</p>
                  <p class="m-0 mt-1 font-serif text-kortrubrik lg:text-kortrubrik-lg text-blyerts">
                    {bladfakta.val}
                  </p>
                </>
              )}
              {bladfakta.antal && (
                <p class="m-0 mt-2 font-serif text-h1 lg:text-h1-lg text-blyerts">
                  {bladfakta.antal}
                  <span class="ml-2 font-sans text-liten text-blyerts-2">granskade</span>
                </p>
              )}
            </div>
          ) : (
            p && <Ikon namn={p.ikon} storlek={kompakt ? 24 : 40} class="text-blyerts-2 sm:size-10" />
          )}
        </div>
      )
    }
  </div>

  <div class:list={['artikelkort-text', stor && 'lg:p-9 lg:justify-center']}>
    <p class:list={[stor && 'text-penna']}>
      {etikett}{niva && ` · ${nivaEtikett(niva)}`}
    </p>

    <Rubrik class:list={[stor && 'text-h2 lg:text-kortrubrik-xl']}>
      <a href={href} class="kortlank">{rubrik}</a>
    </Rubrik>

    {
      visaBeskrivning && beskrivning && (
        <p class:list={['artikelkort-beskr', stor && 'lg:text-ingress-lg line-clamp-none']}>{beskrivning}</p>
      )
    }

    {visaMeta && metadelar.length > 0 && <p class="artikelkort-meta">{metadelar.join(' · ')}</p>}
  </div>
</article>
