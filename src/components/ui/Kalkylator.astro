---
/**
 * Kalkylatorn inbäddad i en artikel. Skribenten skriver <Kalkylator namn="daggpunkt" />
 * i MDX och får verktygets riktiga formulär på plats, inte en länk att klicka på.
 *
 * Formuläret skickas som GET till verktygssidan, som räknar och visar resultatet.
 * Ingen klient-JavaScript, ingen dubblerad formel och inget eget formulär:
 * fälten kommer från samma komponent som verktygssidan använder.
 *
 * Ett nytt verktyg läggs till på två rader här, i registret och som en egen sida.
 * Okänd slug, eller en slug utan formulärkomponent, ger byggfel som i Verktygskort.
 *
 * Rubriken är ett <p> i H3-stil, inte en H3: komponenten kan stå var som helst i
 * en artikel och en riktig H3 skulle kunna ge fel rubrikordning.
 */
import { forvalFranAdress as daggpunktForval } from '../../lib/kalkyl/daggpunkt';
import {
  forvalFranAdress as elkostnadForval,
  produktForval,
  produktSlugFranQuery,
  type ProduktForval,
} from '../../lib/kalkyl/elkostnad';
import { hamtaProdukt } from '../../lib/produkter';
import { tolkaQuery as tolkaGrannemedgivande } from '../../lib/kalkyl/grannemedgivande';
import { korttal } from '../../lib/kalkyl/korttal';
import { hittaKalkylator } from '../../lib/kalkyl/register';
import AltanForm from '../kalkyl/AltanForm.astro';
import AvfuktareForm from '../kalkyl/AvfuktareForm.astro';
import BygglovAltanForm from '../kalkyl/BygglovAltanForm.astro';
import DaggpunktForm from '../kalkyl/DaggpunktForm.astro';
import DraneringForm from '../kalkyl/DraneringForm.astro';
import FasadytaForm from '../kalkyl/FasadytaForm.astro';
import ElkostnadForm from '../kalkyl/ElkostnadForm.astro';
import GipspluggForm from '../kalkyl/GipspluggForm.astro';
import GrannemedgivandeForm from '../kalkyl/GrannemedgivandeForm.astro';
import GipsskruvForm from '../kalkyl/GipsskruvForm.astro';
import InnervaggForm from '../kalkyl/InnervaggForm.astro';
import KallareForm from '../kalkyl/KallareForm.astro';
import KokKostnadForm from '../kalkyl/KokKostnadForm.astro';
import KvadratmeterForm from '../kalkyl/KvadratmeterForm.astro';
import MalaUteForm from '../kalkyl/MalaUteForm.astro';
import RotavdragForm from '../kalkyl/RotavdragForm.astro';
import TrappaForm from '../kalkyl/TrappaForm.astro';
import UVardeForm from '../kalkyl/UVardeForm.astro';
import KontrollplanForm from '../kalkyl/KontrollplanForm.astro';
import TakbyteForm from '../kalkyl/TakbyteForm.astro';
import TakavvattningForm from '../kalkyl/TakavvattningForm.astro';
import { ATGARD_ORDNING, type Atgard } from '../../lib/kalkyl/kontrollplan';
import Ikon from './Ikon.astro';

interface Props {
  /** Kalkylatorns slug i src/lib/kalkyl/register.ts. */
  namn: string;
  /**
   * Förval som en querysträng, till exempel "atgard=altan". Finns för
   * grannemedgivandet (docs/briefer/spec-kalkyl-grannemedgivande-2026-09-28.md
   * 12.6), elkostnaden, med samma nycklar som verktygets delbara adress
   * plus typ=golvvarme och produkt=[slug] (forvalFranAdress i
   * src/lib/kalkyl/elkostnad.ts). produkt hämtar maskinens effekt ur
   * databasen och följer med som dolt fält; en effekt i samma förval vinner,
   * och en produkt som saknas eller inte har effekt_w ger byggfel
   * (docs/briefer/spec-elkostnad-forval-2026-09-30.md avsnitt 1).
   * plats=kallare, krypgrund eller garage fyller effekten och gångtiden ur
   * FORVAL_PER_PLATS och följer med som dolt fält, utan rad i det kompakta
   * formuläret; en okänd plats ger byggfel (samma spec, avsnitt 7.4).
   * typ=tvatt, med kg och torkningar, ger det kompakta tvättformuläret
   * (avsnitt 8.4). Och
   * daggpunkten, med rummet och talen i verktygets adress, till exempel
   * "rum=fonster" (forvalFranAdress i src/lib/kalkyl/daggpunkt.ts,
   * docs/briefer/spec-daggpunkt-rum-2026-09-30.md avsnitt 7).
   * Talen och deras källor är artikelns: golvvärmesidan skriver golvets hela
   * effekt i watt, tillverkarens W/m² gånger den fria ytan.
   * En annan slug med förval, en okänd nyckel eller ett värde som räknaren
   * inte godtar ger byggfel, så att ingen tror att det fungerar tyst. Skrivs
   * efter namn, eftersom kontrollen i scripts/kontrollera-innehall.ts kräver
   * att namn står först.
   */
  forval?: string;
  /**
   * Åtgärder som står först i kontrollplanens kompakta formulär, utan förval,
   * separerade med mellanslag, till exempel "barande ventilation va" i
   * källarguiden. Finns bara för kontrollplanen; en annan slug, eller ett ord
   * som inte är en åtgärd, ger byggfel. Skrivs efter namn.
   */
  forst?: string;
  /**
   * Texten i etikettraden. Standard "Räkna själv". Räkna-indexets "Prova direkt"
   * (spec-designlyft-a-2026-10-02 4.8).
   */
  etikett?: string;
  /**
   * Roten som block (.blad) i stället för linjerat papper, och etiketten i penna
   * utan ikon. Räkna-indexets rubrikband i fas A; standard överallt i fas B.
   */
  blad?: boolean;
  /**
   * Prova direkt på räkna-indexet: bara temperaturen och luftfuktigheten, och
   * svaret vid standardvärdena (korttal) mellan fälten och knappen. Registrets
   * rad och fotraden visas inte. Bara för daggpunkten; en annan slug ger byggfel
   * (spec-designlyft-a-2026-10-02 12.1).
   */
  visaSvar?: boolean;
}

/** Kalkylatorer som har ett formulär att bädda in. */
const MED_FORMULAR = [
  'avfuktare',
  'daggpunkt',
  'elkostnad',
  'innervagg',
  'bygglov-altan',
  'altan',
  'gipsplugg',
  'gipsskruv',
  'kvadratmeter',
  'mala-ute',
  'dranering',
  'kallare',
  'rotavdrag',
  'trappa',
  'u-varde',
  'fasadyta',
  'grannemedgivande',
  'kontrollplan',
  'takbyte',
  'takavvattning',
  'kok-kostnad',
];

const { namn, forval, forst, etikett = 'Räkna själv', blad = false, visaSvar = false } = Astro.props;
const k = hittaKalkylator(namn);
if (!k) {
  throw new Error(`[Kalkylator] Okänd kalkylator "${namn}". Lägg till den i src/lib/kalkyl/register.ts`);
}
if (!MED_FORMULAR.includes(namn)) {
  throw new Error(
    `[Kalkylator] Kalkylatorn "${namn}" har inget formulär att bädda in. Lägg till komponenten i src/components/kalkyl/ och slugen i MED_FORMULAR.`,
  );
}

if (visaSvar && namn !== 'daggpunkt') {
  throw new Error(`[Kalkylator] visaSvar finns bara för daggpunkten, inte för "${namn}".`);
}
/** Talet räknas i bygget med räknarens standardvärden, samma som räknarsidan utan adress. */
const svarTal = visaSvar ? korttal('daggpunkt')?.tal : undefined;
if (visaSvar && svarTal === undefined) {
  throw new Error('[Kalkylator] Daggpunkten saknar korttal i src/lib/kalkyl/korttal.ts.');
}
const SVAR_RAD = 'En yta som är kallare än så blir våt. Fyll i ditt eget rum och räkna om.'; // rakna.prova.rad

if (forval !== undefined && namn !== 'grannemedgivande' && namn !== 'elkostnad' && namn !== 'daggpunkt') {
  throw new Error(`[Kalkylator] Förval finns bara för grannemedgivandet, elkostnaden och daggpunkten, inte för "${namn}".`);
}
/** Daggpunktens förval, tolkat och prövat som adressen på verktygssidan. */
const dpForval = namn === 'daggpunkt' && forval !== undefined ? daggpunktForval(forval) : undefined;
if (dpForval?.status === 'fel') {
  throw new Error(`[Kalkylator] Förvalet "${forval}" till daggpunkten går inte att räkna: ${dpForval.fel}`);
}
const dpIndata = dpForval?.status === 'ok' ? dpForval.indata : undefined;
const dpVarden = dpForval?.status === 'ok' ? dpForval.varden : undefined;
/*
 * Elkostnadens förval, tolkat och prövat som adressen på verktygssidan. Med
 * produkt=[slug] hämtas maskinen här och bara effekten skickas till den rena
 * formelmodulen (docs/briefer/spec-elkostnad-forval-2026-09-30.md avsnitt 1).
 */
const elForvalQuery = namn === 'elkostnad' && forval !== undefined ? new URLSearchParams(forval) : undefined;
let elProduktForval: ProduktForval = { effektW: null };
if (elForvalQuery?.has('produkt')) {
  const slug = produktSlugFranQuery(elForvalQuery);
  const produkt = slug ? await hamtaProdukt(slug) : null;
  elProduktForval = produktForval(produkt?.specs ?? null);
  if (elProduktForval.effektW === null) {
    const visadSlug = elForvalQuery.get('produkt');
    throw new Error(
      `[Kalkylator] Förvalet "${forval}" till elkostnaden: produkten ${visadSlug} finns inte eller saknar effekt_w`,
    );
  }
}
const elForval =
  namn === 'elkostnad' && forval !== undefined
    ? elProduktForval.effektW === null
      ? elkostnadForval(forval)
      : elkostnadForval(forval, elProduktForval)
    : undefined;
if (elForval?.status === 'fel') {
  throw new Error(`[Kalkylator] Förvalet "${forval}" till elkostnaden går inte att räkna: ${elForval.fel}`);
}
const elIndata = elForval?.status === 'ok' ? elForval.indata : undefined;
const elVarden = elForval?.status === 'ok' ? elForval.varden : undefined;
const elTyp = elForval?.status === 'ok' ? elForval.typ : undefined;
/* Slugen följer med som dolt fält till verktygssidan; raden "Jag räknar på" visas bara där. */
const elProduktSlug = elForval?.status === 'ok' ? elForval.produktSlug : undefined;
const elPlats = elForval?.status === 'ok' ? elForval.plats : undefined;
/* typ=tvatt ger det kompakta tvättformuläret med förvalets kg och torkningar (spec avsnitt 8.4). */
const elTvattFalt = elForval?.status === 'ok' ? elForval.tvatt?.varden : undefined;
/** Grannemedgivandets förval, tolkat som adressen på verktygssidan. */
if (forst !== undefined && namn !== 'kontrollplan') {
  throw new Error(`[Kalkylator] forst finns bara för kontrollplanen, inte för "${namn}".`);
}
const forstAtgarder: Atgard[] = (forst ?? '').split(/\s+/).filter((o) => o !== '').map((o) => {
  const a = ATGARD_ORDNING.find((x) => x === o);
  if (!a) throw new Error(`[Kalkylator] "${o}" i forst är ingen åtgärd i kontrollplanen.`);
  return a;
});
const forvalIndata =
  forval && namn === 'grannemedgivande' ? tolkaGrannemedgivande(new URLSearchParams(forval)).indata : undefined;

/*
 * Fotraden under varje inbäddat verktyg. Ska vara sann för alla inbäddade
 * verktyg, också generatorerna som inte ger något tal, inte nämna tal och
 * säga räknaren (docs/briefer/spec-kalkyl-grannemedgivande-2026-09-28.md 12.6).
 */
const FOTRAD = 'Knappen tar dig till räknaren med dina värden ifyllda. Där får du hela svaret och ser vad det bygger på.';

const href = `/rakna/${k.slug}/`;
const prefix = `${k.slug}-inbaddad-`;
---

<div class={blad ? 'blad p-5 lg:p-6' : 'linjerat my-8'}>
  <p class:list={['m-0 flex items-center gap-2 text-etikett lg:text-etikett-lg uppercase', blad ? 'text-penna' : 'text-blyerts']}>
    {!blad && <Ikon namn="kalkylator" storlek={24} />}
    {etikett}
  </p>
  <p class:list={['m-0 mt-2 font-sans text-h3 lg:text-h3-lg font-bold', visaSvar ? 'mb-6' : 'mb-2']}>
    <a href={href} class="lank text-blyerts">{k.namn}</a>
  </p>
  {!visaSvar && <p class="m-0 mb-6 text-brod lg:text-brod-lg text-blyerts-2">{k.rad}</p>}

  {namn === 'daggpunkt' && (
    <DaggpunktForm kompakt={true} indata={dpIndata} varden={dpVarden} idPrefix={prefix} knappText="Räkna ut" faltUrval={visaSvar ? 'luften' : 'alla'}>
      {visaSvar && (
        <div slot="fore-knapp" class="yta flex flex-col items-start gap-2 px-4.5 py-3.5 sm:flex-row sm:items-center sm:gap-5">
          <p class="m-0 font-serif text-siffra">{svarTal}</p>
          <p class="m-0 text-liten text-blyerts-2">{SVAR_RAD}</p>
        </div>
      )}
    </DaggpunktForm>
  )}
  {namn === 'avfuktare' && <AvfuktareForm kompakt={true} idPrefix={prefix} knappText="Räkna ut" />}
  {namn === 'elkostnad' && <ElkostnadForm kompakt={true} indata={elIndata} varden={elVarden} typ={elTyp} produktSlug={elProduktSlug} plats={elPlats} tvattFalt={elTvattFalt} idPrefix={prefix} knappText="Räkna ut" />}
  {namn === 'innervagg' && <InnervaggForm kompakt={true} idPrefix={prefix} knappText="Räkna ut" />}
  {namn === 'bygglov-altan' && <BygglovAltanForm kompakt={true} idPrefix={prefix} knappText="Ge mig svaret" />}
  {namn === 'altan' && <AltanForm kompakt={true} idPrefix={prefix} knappText="Räkna ut" />}
  {namn === 'gipsplugg' && <GipspluggForm kompakt={true} idPrefix={prefix} knappText="Ge mig svaret" />}
  {namn === 'gipsskruv' && <GipsskruvForm kompakt={true} idPrefix={prefix} knappText="Ge mig skruven" />}
  {namn === 'kvadratmeter' && <KvadratmeterForm kompakt={true} idPrefix={prefix} knappText="Räkna ut" />}
  {namn === 'mala-ute' && <MalaUteForm kompakt={true} idPrefix={prefix} knappText="Ge mig svaret" />}
  {namn === 'dranering' && <DraneringForm kompakt={true} idPrefix={prefix} knappText="Räkna ut" />}
  {namn === 'kallare' && <KallareForm kompakt={true} idPrefix={prefix} knappText="Ge mig svaret" />}
  {namn === 'rotavdrag' && <RotavdragForm kompakt={true} idPrefix={prefix} knappText="Räkna ut" />}
  {namn === 'trappa' && <TrappaForm kompakt={true} idPrefix={prefix} knappText="Räkna ut" />}
  {namn === 'u-varde' && <UVardeForm kompakt={true} idPrefix={prefix} knappText="Räkna ut" />}
  {namn === 'fasadyta' && <FasadytaForm kompakt={true} idPrefix={prefix} knappText="Räkna ut ytan och färgen" />}
  {namn === 'grannemedgivande' && <GrannemedgivandeForm kompakt={true} indata={forvalIndata} idPrefix={prefix} knappText="Se om grannen ska skriva under" />}
  {namn === 'kontrollplan' && <KontrollplanForm kompakt={true} forst={forstAtgarder} idPrefix={prefix} knappText="Visa kontrollplanen" />}
  {namn === 'takbyte' && <TakbyteForm kompakt={true} idPrefix={prefix} knappText="Räkna ut" />}
  {namn === 'takavvattning' && <TakavvattningForm kompakt={true} idPrefix={prefix} knappText="Räkna ut" />}
  {namn === 'kok-kostnad' && <KokKostnadForm kompakt={true} idPrefix={prefix} knappText="Räkna ut" />}

  {
    !visaSvar && (
      <p class="m-0 mt-4 text-liten text-blyerts-2">
        {FOTRAD}
      </p>
    )
  }
</div>
