---
/**
 * Kalkylatorn inbäddad i en artikel. Skribenten skriver <Kalkylator namn="daggpunkt" />
 * i MDX och får verktygets riktiga formulär på plats, inte en länk att klicka på.
 *
 * Formuläret skickas som GET till verktygssidan, som räknar och visar resultatet.
 * Ingen klient-JavaScript, ingen dubblerad formel och inget eget formulär:
 * fälten kommer från samma komponent som verktygssidan använder.
 *
 * Ett nytt verktyg läggs till på två rader här, i registret och som en egen sida.
 * Okänd slug, eller en slug utan formulärkomponent, ger byggfel som i Verktygskort.
 *
 * Rubriken är ett <p> i H3-stil, inte en H3: komponenten kan stå var som helst i
 * en artikel och en riktig H3 skulle kunna ge fel rubrikordning.
 */
import { tolkaQuery as tolkaGrannemedgivande } from '../../lib/kalkyl/grannemedgivande';
import { hittaKalkylator } from '../../lib/kalkyl/register';
import AltanForm from '../kalkyl/AltanForm.astro';
import AvfuktareForm from '../kalkyl/AvfuktareForm.astro';
import BygglovAltanForm from '../kalkyl/BygglovAltanForm.astro';
import DaggpunktForm from '../kalkyl/DaggpunktForm.astro';
import DraneringForm from '../kalkyl/DraneringForm.astro';
import FasadytaForm from '../kalkyl/FasadytaForm.astro';
import ElkostnadForm from '../kalkyl/ElkostnadForm.astro';
import GipspluggForm from '../kalkyl/GipspluggForm.astro';
import GrannemedgivandeForm from '../kalkyl/GrannemedgivandeForm.astro';
import GipsskruvForm from '../kalkyl/GipsskruvForm.astro';
import InnervaggForm from '../kalkyl/InnervaggForm.astro';
import KallareForm from '../kalkyl/KallareForm.astro';
import KvadratmeterForm from '../kalkyl/KvadratmeterForm.astro';
import MalaUteForm from '../kalkyl/MalaUteForm.astro';
import RotavdragForm from '../kalkyl/RotavdragForm.astro';
import TrappaForm from '../kalkyl/TrappaForm.astro';
import UVardeForm from '../kalkyl/UVardeForm.astro';
import KontrollplanForm from '../kalkyl/KontrollplanForm.astro';
import { ATGARD_ORDNING, type Atgard } from '../../lib/kalkyl/kontrollplan';
import Ikon from './Ikon.astro';

interface Props {
  /** Kalkylatorns slug i src/lib/kalkyl/register.ts. */
  namn: string;
  /**
   * Förval som en querysträng, till exempel "atgard=altan". Finns bara för
   * grannemedgivandet (docs/briefer/spec-kalkyl-grannemedgivande-2026-09-28.md
   * 12.6); en annan slug med förval ger byggfel, så att ingen tror att det
   * fungerar tyst. Skrivs efter namn, eftersom kontrollen i
   * scripts/kontrollera-innehall.ts kräver att namn står först.
   */
  forval?: string;
  /**
   * Åtgärder som står först i kontrollplanens kompakta formulär, utan förval,
   * separerade med mellanslag, till exempel "barande ventilation va" i
   * källarguiden. Finns bara för kontrollplanen; en annan slug, eller ett ord
   * som inte är en åtgärd, ger byggfel. Skrivs efter namn.
   */
  forst?: string;
}

/** Kalkylatorer som har ett formulär att bädda in. */
const MED_FORMULAR = [
  'avfuktare',
  'daggpunkt',
  'elkostnad',
  'innervagg',
  'bygglov-altan',
  'altan',
  'gipsplugg',
  'gipsskruv',
  'kvadratmeter',
  'mala-ute',
  'dranering',
  'kallare',
  'rotavdrag',
  'trappa',
  'u-varde',
  'fasadyta',
  'grannemedgivande',
  'kontrollplan',
];

const { namn, forval, forst } = Astro.props;
const k = hittaKalkylator(namn);
if (!k) {
  throw new Error(`[Kalkylator] Okänd kalkylator "${namn}". Lägg till den i src/lib/kalkyl/register.ts`);
}
if (!MED_FORMULAR.includes(namn)) {
  throw new Error(
    `[Kalkylator] Kalkylatorn "${namn}" har inget formulär att bädda in. Lägg till komponenten i src/components/kalkyl/ och slugen i MED_FORMULAR.`,
  );
}

if (forval !== undefined && namn !== 'grannemedgivande') {
  throw new Error(`[Kalkylator] Förval finns bara för grannemedgivandet, inte för "${namn}".`);
}
/** Grannemedgivandets förval, tolkat som adressen på verktygssidan. */
if (forst !== undefined && namn !== 'kontrollplan') {
  throw new Error(`[Kalkylator] forst finns bara för kontrollplanen, inte för "${namn}".`);
}
const forstAtgarder: Atgard[] = (forst ?? '').split(/\s+/).filter((o) => o !== '').map((o) => {
  const a = ATGARD_ORDNING.find((x) => x === o);
  if (!a) throw new Error(`[Kalkylator] "${o}" i forst är ingen åtgärd i kontrollplanen.`);
  return a;
});
const forvalIndata = forval ? tolkaGrannemedgivande(new URLSearchParams(forval)).indata : undefined;

/*
 * Fotraden under varje inbäddat verktyg. Ska vara sann för alla inbäddade
 * verktyg, också generatorerna som inte ger något tal, inte nämna tal och
 * säga räknaren (docs/briefer/spec-kalkyl-grannemedgivande-2026-09-28.md 12.6).
 */
const FOTRAD = 'Knappen tar dig till räknaren med dina värden ifyllda. Där får du hela svaret och ser vad det bygger på.';

const href = `/rakna/${k.slug}/`;
const prefix = `${k.slug}-inbaddad-`;
---

<div class="linjerat my-8">
  <p class="m-0 flex items-center gap-2 text-etikett lg:text-etikett-lg uppercase text-blyerts">
    <Ikon namn="kalkylator" storlek={24} />
    Räkna själv
  </p>
  <p class="m-0 mt-2 mb-2 font-sans text-h3 lg:text-h3-lg font-bold">
    <a href={href} class="text-blyerts underline decoration-1 underline-offset-2 hover:decoration-2">{k.namn}</a>
  </p>
  <p class="m-0 mb-6 text-brod lg:text-brod-lg text-blyerts-2">{k.rad}</p>

  {namn === 'daggpunkt' && <DaggpunktForm kompakt={true} idPrefix={prefix} knappText="Räkna ut" />}
  {namn === 'avfuktare' && <AvfuktareForm kompakt={true} idPrefix={prefix} knappText="Räkna ut" />}
  {namn === 'elkostnad' && <ElkostnadForm kompakt={true} idPrefix={prefix} knappText="Räkna ut" />}
  {namn === 'innervagg' && <InnervaggForm kompakt={true} idPrefix={prefix} knappText="Räkna ut" />}
  {namn === 'bygglov-altan' && <BygglovAltanForm kompakt={true} idPrefix={prefix} knappText="Ge mig svaret" />}
  {namn === 'altan' && <AltanForm kompakt={true} idPrefix={prefix} knappText="Räkna ut" />}
  {namn === 'gipsplugg' && <GipspluggForm kompakt={true} idPrefix={prefix} knappText="Ge mig svaret" />}
  {namn === 'gipsskruv' && <GipsskruvForm kompakt={true} idPrefix={prefix} knappText="Ge mig skruven" />}
  {namn === 'kvadratmeter' && <KvadratmeterForm kompakt={true} idPrefix={prefix} knappText="Räkna ut" />}
  {namn === 'mala-ute' && <MalaUteForm kompakt={true} idPrefix={prefix} knappText="Ge mig svaret" />}
  {namn === 'dranering' && <DraneringForm kompakt={true} idPrefix={prefix} knappText="Räkna ut" />}
  {namn === 'kallare' && <KallareForm kompakt={true} idPrefix={prefix} knappText="Ge mig svaret" />}
  {namn === 'rotavdrag' && <RotavdragForm kompakt={true} idPrefix={prefix} knappText="Räkna ut" />}
  {namn === 'trappa' && <TrappaForm kompakt={true} idPrefix={prefix} knappText="Räkna ut" />}
  {namn === 'u-varde' && <UVardeForm kompakt={true} idPrefix={prefix} knappText="Räkna ut" />}
  {namn === 'fasadyta' && <FasadytaForm kompakt={true} idPrefix={prefix} knappText="Räkna ut ytan och färgen" />}
  {namn === 'grannemedgivande' && <GrannemedgivandeForm kompakt={true} indata={forvalIndata} idPrefix={prefix} knappText="Se om grannen ska skriva under" />}
  {namn === 'kontrollplan' && <KontrollplanForm kompakt={true} forst={forstAtgarder} idPrefix={prefix} knappText="Visa kontrollplanen" />}

  <p class="m-0 mt-4 text-liten text-blyerts-2">
    {FOTRAD}
  </p>
</div>
