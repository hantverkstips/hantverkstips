---
/**
 * Projektguidens lista sist på sidan. Verktygen har köpknapp, materialet har
 * inte (butiken säljer inte virke). Rader med linje emellan, inga kort, ingen
 * tabell. Se docs/DESIGN.md avsnitt 6 och SPEC-SIDMALLAR avsnitt 2.11.
 */
import { formateraPris } from '../../lib/format';
import {
  arSlut,
  billigasteErbjudande,
  hamtaProdukter,
  lagerlage,
  produktNamn,
  varnaSaknadProdukt,
} from '../../lib/produkter';
import Kopknapp from './Kopknapp.astro';
import Pennstreck from './Pennstreck.astro';

interface Props {
  /** namn används bara när produkten saknas i databasen; annars visas databasens namn. */
  verktyg: { produkt: string; namn?: string; varfor: string }[];
  material: { namn: string; varfor: string }[];
}

const { verktyg, material } = Astro.props;

const produkter = await hamtaProdukter(verktyg.map((v) => v.produkt));
const karta = new Map(produkter.map((p) => [p.slug, p]));

// Saknas produkten i databasen renderas raden ändå, med namnet från frontmatter
// (eller slugen) och utan köpknapp, och bygget varnar en gång per slug. Bygget
// stoppar inte: en verktygslista får peka på en produkt som importeras senare.
const verktygsrader = verktyg.map((v) => {
  const p = karta.get(v.produkt) ?? null;
  if (!p) varnaSaknadProdukt(v.produkt, `${Astro.url.pathname}, Det här behöver du`);
  const e = p ? billigasteErbjudande(p) : null;
  return { slug: v.produkt, namn: p ? produktNamn(p) : (v.namn ?? v.produkt), varfor: v.varfor, produkt: p, erbjudande: e };
});

const visa = verktyg.length > 0 || material.length > 0;
---

{
  visa && (
    <section>
      <Pennstreck id="det-har-behover-du">Det här behöver du</Pennstreck>

      {verktygsrader.length > 0 && (
        <>
          <h3 class="mt-8 mb-2 font-sans text-h3 lg:text-h3-lg">Verktyg</h3>
          <ul class="m-0 p-0 list-none">
            {verktygsrader.map((r, i) => (
              <li
                class:list={[
                  'py-4 lg:flex lg:items-center lg:gap-6',
                  i > 0 && 'border-t border-linje',
                ]}
              >
                <div class="lg:w-2/3">
                  <p class="m-0 font-bold text-brod lg:text-brod-lg text-blyerts">{r.namn}</p>
                  <p class="m-0 mt-1 text-brod text-blyerts-2">{r.varfor}</p>
                </div>
                {r.produkt && (
                  /* Mobil: priset till vänster, knappen fyller resten av raden.
                     Därför renderas priset här och inte inuti Kopknapp. */
                  <div class="mt-3 lg:mt-0 lg:w-1/3 flex items-start gap-4">
                    {typeof r.erbjudande?.pris === 'number' && r.erbjudande.pris > 0 && (
                      <p class="m-0 shrink-0 font-bold tabular-nums text-brod text-blyerts">
                        {arSlut(r.erbjudande) && <span class="font-normal text-blyerts-2">senast </span>}
                        {formateraPris(r.erbjudande.pris)}
                      </p>
                    )}
                    <Kopknapp
                      class="flex-1 min-w-0"
                      produkt={r.produkt.slug}
                      modul="behovslista"
                      bredd="full"
                      visaPris={false}
                      pris={r.erbjudande?.pris ?? null}
                      prisDatum={r.erbjudande?.uppdaterad ?? null}
                      butikNamn={r.erbjudande?.butikNamn}
                      lager={lagerlage(r.erbjudande)}
                    />
                  </div>
                )}
              </li>
            ))}
          </ul>
        </>
      )}

      {material.length > 0 && (
        <>
          <h3 class="mt-8 mb-2 font-sans text-h3 lg:text-h3-lg">Material</h3>
          <ul class="m-0 p-0 list-none">
            {material.map((m, i) => (
              <li class:list={['py-4', i > 0 && 'border-t border-linje']}>
                <p class="m-0 font-bold text-brod lg:text-brod-lg text-blyerts">{m.namn}</p>
                <p class="m-0 mt-1 text-brod text-blyerts-2">{m.varfor}</p>
              </li>
            ))}
          </ul>
        </>
      )}
    </section>
  )
}
