---
/**
 * Innehållsförteckning byggd på H2. Två varianter, en per plats, så att listan
 * aldrig hamnar två gånger i HTML:en, båda i ett kort:
 *  - hopfallbar: <details> på mobil, stängd som standard, dold från lg
 *  - sidospalt:  alltid öppen lista, dold under lg, överst i sidospalten
 * Listan har en linje till vänster och inga siffror (.innehall i global.css).
 * Färre än tre poster: renderar ingenting. Ingen JavaScript, ingen aktiv rad.
 * Spec: docs/briefer/spec-designlyft-b-2026-10-02.md 1.7.
 */
interface Props {
  rubriker: { slug: string; text: string }[];
  variant?: 'hopfallbar' | 'sidospalt';
}

const { rubriker, variant = 'hopfallbar' } = Astro.props;
const visa = rubriker.length >= 3;
---

{
  visa &&
    (variant === 'hopfallbar' ? (
      <details class="kort innehall mt-7 lg:hidden">
        <summary class="flex min-h-11 items-center px-4 font-bold text-blyerts cursor-pointer">
          Innehåll, {rubriker.length} avsnitt
        </summary>
        <ol class="mx-4 mb-3">
          {rubriker.map((r) => (
            <li>
              <a href={`#${r.slug}`}>{r.text}</a>
            </li>
          ))}
        </ol>
      </details>
    ) : (
      <nav class="kort innehall px-5.5 py-4.5 hidden lg:block" aria-label="Innehåll">
        <p class="etikett mb-2 text-blyerts-2">Innehåll, {rubriker.length} avsnitt</p>
        <ol>
          {rubriker.map((r) => (
            <li>
              <a href={`#${r.slug}`}>{r.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    ))
}
