---
/**
 * Innehållsförteckning byggd på H2. Två varianter, en per plats, så att listan
 * aldrig hamnar två gånger i HTML:en:
 *  - hopfallbar: <details> på mobil, stängd som standard, dold från lg
 *  - sidospalt:  alltid öppen lista, dold under lg, anroparen gör den sticky
 * Färre än tre poster: renderar ingenting. Ingen JavaScript.
 */
interface Props {
  rubriker: { slug: string; text: string }[];
  variant?: 'hopfallbar' | 'sidospalt';
}

const { rubriker, variant = 'hopfallbar' } = Astro.props;
const visa = rubriker.length >= 3;
---

{
  visa &&
    (variant === 'hopfallbar' ? (
      <details class="lg:hidden my-6 border border-linje rounded-sm">
        <summary class="flex min-h-11 items-center px-4 py-3 font-bold text-blyerts cursor-pointer">
          Innehåll, {rubriker.length} avsnitt
        </summary>
        <ol class="m-0 px-4 pb-2 pt-0 list-decimal list-inside text-blyerts-2">
          {rubriker.map((r) => (
            <li class="border-t border-linje">
              <a
                href={`#${r.slug}`}
                class="inline-flex min-h-11 items-center text-blyerts underline decoration-1 underline-offset-2 hover:decoration-2"
              >
                {r.text}
              </a>
            </li>
          ))}
        </ol>
      </details>
    ) : (
      <nav class="hidden lg:block" aria-label="Innehåll">
        <p class="m-0 mb-2 text-etikett-lg uppercase text-blyerts">Innehåll</p>
        <ol class="m-0 p-0 list-none text-liten text-blyerts-2">
          {rubriker.map((r) => (
            <li class="mb-2">
              <a href={`#${r.slug}`} class="text-blyerts-2 underline decoration-1 underline-offset-2 hover:decoration-2">
                {r.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    ))
}
