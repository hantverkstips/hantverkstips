---
/**
 * "Kort svar" som färgad yta: etiketten, första stycket i 19 px, följande i
 * 17 px, och i en köpguide valen som gula chips sist ("Kallt garage: Acetec
 * EvoDry 6H 2.0"), utan köpknapp. Spec: docs/briefer/spec-designlyft-b-2026-10-02.md
 * 1.9, docs/DESIGN.md avsnitt 6 (Faktaruta och Kort svar).
 *
 * Frontmatter är en ren sträng, men nyckeltalet ska vara överstruket. Därför den
 * enda markeringen som tolkas i frontmatter: **så här** blir <Markering>.
 *
 * Ingen markdown i övrigt. Skribenten skriver
 *   kortSvar: En källare på 40 kvm behöver minst **12 liter per dygn**.
 * och får ett gult streck bakom talet. Fler än en markering varnar vid bygget:
 * överstrykningen ska peka ut ett nyckeltal, inte måla halva stycket.
 *
 * Står komponenten i en <Faktaruta variant="kortsvar"> (jämförelsesidan) ser
 * Faktaruta att ytan redan är ritad och lägger ingen andra runt den.
 */
import Markering from './Markering.astro';

interface Props {
  text: string;
  /** Var texten står, används i byggvarningen. */
  plats?: string;
  /** Köpguidens val som gula chips sist: "{etikett}: {namn}". */
  val?: { etikett: string; namn: string }[];
}

const { text, plats, val = [] } = Astro.props;

/*
 * Stycken skiljs med blankrad i frontmatter (blockstil `|`, inte `>-`, som
 * viker ihop radbrytningarna till mellanslag). Tillagt 2026-09-20 efter
 * Christians påpekande att kortsvaret på pappret saknade styckeindelning.
 */
const stycken = text
  .split(/\n[ \t]*\n/)
  .map((s) => s.replace(/\s+/g, ' ').trim())
  .filter(Boolean);

// Delar varje stycke på **...** och behåller avgränsarna, så att varannan del är markerad.
const styckenMedDelar = stycken.map((s) => s.split(/\*\*(.+?)\*\*/s));
const antalMarkeringar = styckenMedDelar.reduce((n, delar) => n + Math.floor(delar.length / 2), 0);

if (antalMarkeringar > 1) {
  console.warn(
    `[Kortsvarstext] ${antalMarkeringar} markeringar i kort svar${plats ? ` på ${plats}` : ''}. Markera ett nyckeltal, inte flera.`,
  );
}
---

<div class="yta kortsvar">
  <p>Kort svar</p>
  {
    styckenMedDelar.map((delar) => (
      <p>{delar.map((del, i) => (i % 2 === 1 ? <Markering>{del}</Markering> : del))}</p>
    ))
  }
  {
    val.length > 0 && (
      <div class="flex flex-wrap gap-2.5 mt-1.5">
        {val.map((v) => (
          <span class="chip-gul">
            {v.etikett}: {v.namn}
          </span>
        ))}
      </div>
    )
  }
</div>
