---
/**
 * Ämnesraden på startsidan: alla pelare i PELARE-ordning som ämneskort, under
 * startsidans rubrikrad "Var sitter problemet?", som också bär länken Alla
 * ämnen. Fyra kolumner från 1024 px, tre från 640, två under. Pelaren med flest
 * publicerade sidor (den första i PELARE-ordning vid lika) tar två kolumner
 * och har ytan ruta, så att elva kort blir tolv celler och raderna går jämnt
 * ut i alla tre bredder. Kortets etikett säger vilken grupp ämnet hör till
 * (Utsidan, Insidan, Hela huset) och hur många sidor som finns.
 *
 * En pelare vars hub är publicerad blir ett klickbart kort med den runda
 * symbolen. Övriga står kvar dämpade utan länk med ordet Kommer: kartan visar
 * hela sajten, och en död länk till en hub som är utkast byggs aldrig.
 * Utseendet står i .amneskort i global.css (docs/DESIGN.md avsnitt 6, Ämneskort).
 */
import { hubPublicerad, pelareUrl, publicerade } from '../../lib/innehall';
import { hittaGrupp, PELARE } from '../../lib/pelare';
import Ikon from './Ikon.astro';

const KOMMER = 'Kommer';
const STORST = 'störst än så länge'; // start.amnen.storst

const artiklar = [...(await publicerade('guider')), ...(await publicerade('kunskap'))];

const kort = await Promise.all(
  PELARE.map(async (pelare) => {
    const antal = artiklar.filter((e) => e.data.pelare === pelare.slug).length;
    const grupp = hittaGrupp(pelare.grupp).namn;
    return {
      pelare,
      grupp,
      antal,
      publicerad: await hubPublicerad(pelare.slug),
      etikett: antal === 0 ? grupp : `${grupp} · ${antal === 1 ? '1 sida' : `${antal} sidor`}`,
    };
  }),
);

/** Den största: flest sidor, den första i PELARE-ordning vid lika. */
const storst = kort.reduce((b, k) => (k.antal > b.antal ? k : b), kort[0]!);
---

<nav aria-label="Ämnen">
  <ul class="m-0 grid list-none grid-cols-2 gap-3 p-0 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5">
    {
      kort.map((k) => {
        const stor = k === storst;
        return (
          <li class:list={[stor && 'col-span-2']}>
            {k.publicerad ? (
              <div class:list={['kort artikelkort amneskort', stor && 'amneskort-stor']}>
                <span class="symbol">
                  <Ikon namn={k.pelare.ikon} storlek={26} />
                </span>
                <div>
                  <p>{stor ? `${k.etikett} · ${STORST}` : k.etikett}</p>
                  <p>
                    <a href={pelareUrl(k.pelare.slug)} class="kortlank">
                      {k.pelare.namn}
                    </a>
                  </p>
                  <p>{k.pelare.rad}</p>
                </div>
              </div>
            ) : (
              <div class:list={['amneskort amneskort-kommer', stor && 'amneskort-stor']}>
                <span class="symbol">
                  <Ikon namn={k.pelare.ikon} storlek={26} />
                </span>
                <div>
                  <p>
                    {k.grupp} · {KOMMER}
                  </p>
                  <p>{k.pelare.namn}</p>
                  <p>{k.pelare.rad}</p>
                </div>
              </div>
            )}
          </li>
        );
      })
    }
  </ul>
</nav>
