---
/**
 * Ämnesraden på startsidan. Alla pelare i PELARE-ordning som kort, direkt
 * under öppningen, i sidbredd. Fem kolumner från 1024 px, två under: tio
 * ämnen blir två rader på desktop och fem på mobil. Sedan 2026-09-17 täcker
 * pelarna huset från tak till grund, ute och inne, och kortets etikett säger
 * vilken grupp ämnet hör till (Utsidan, Insidan, Hela huset) och hur många
 * sidor som finns.
 *
 * En pelare vars hub är publicerad blir ett klickbart kort med artikelkortets
 * ram, hover och fokus. Övriga står kvar som dämpade kort utan länk med ordet
 * Kommer: kartan visar hela sajten, inte bara det som hunnit publiceras, och en
 * död länk till en hub som är utkast byggs aldrig.
 */
import { hubPublicerad, pelareUrl, publicerade } from '../../lib/innehall';
import { hittaGrupp, PELARE } from '../../lib/pelare';
import Ikon from './Ikon.astro';

const KOMMER = 'Kommer';

const artiklar = [...(await publicerade('guider')), ...(await publicerade('kunskap'))];

const kort = await Promise.all(
  PELARE.map(async (pelare) => {
    const antal = artiklar.filter((e) => e.data.pelare === pelare.slug).length;
    const grupp = hittaGrupp(pelare.grupp).namn;
    return {
      pelare,
      grupp,
      publicerad: await hubPublicerad(pelare.slug),
      etikett: antal === 0 ? grupp : `${grupp} · ${antal === 1 ? '1 sida' : `${antal} sidor`}`,
    };
  }),
);
---

<nav aria-label="Ämnen" class="mt-8 lg:mt-12">
  <ul class="m-0 grid list-none grid-cols-2 gap-3 p-0 sm:grid-cols-3 lg:grid-cols-5 lg:gap-5">
    {
      kort.map((k) =>
        k.publicerad ? (
          <li>
            <div class="artikelkort h-full rounded-sm border border-linje bg-papper p-4">
              <Ikon namn={k.pelare.ikon} storlek={36} class="text-blyerts" />
              <p class="m-0 mt-2 text-etikett uppercase text-blyerts-2">{k.etikett}</p>
              <p class="m-0 mt-1 font-serif text-kortrubrik lg:text-kortrubrik-lg">
                <a href={pelareUrl(k.pelare.slug)} class="kortlank">
                  {k.pelare.kort}
                </a>
              </p>
              <p class="m-0 mt-1 text-liten text-blyerts-2">{k.pelare.rad}</p>
            </div>
          </li>
        ) : (
          <li>
            <div class="flex h-full flex-col rounded-sm border border-linje bg-papper-2 p-4">
              <Ikon namn={k.pelare.ikon} storlek={36} class="text-blyerts-2" />
              <p class="m-0 mt-2 text-etikett uppercase text-blyerts-2">
                {k.grupp} · {KOMMER}
              </p>
              <p class="m-0 mt-1 font-serif text-kortrubrik lg:text-kortrubrik-lg text-blyerts-2">{k.pelare.kort}</p>
              <p class="m-0 mt-1 text-liten text-blyerts-2">{k.pelare.rad}</p>
            </div>
          </li>
        ),
      )
    }
  </ul>

  <p class="m-0 flex justify-end">
    <a
      href="/amnen/"
      class="huvudmeny inline-flex min-h-11 items-center text-penna underline decoration-1 underline-offset-2 hover:decoration-2"
    >
      Alla ämnen
    </a>
  </p>
</nav>
