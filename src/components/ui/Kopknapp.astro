---
/**
 * Enda tillåtna sättet att länka till en butik. Går alltid via /go/.
 * Innehållsfiler skriver: <Kopknapp produkt="woods-mrd20" />
 * Sidmallar anger modul; sidtyp och position kommer från Astro.locals om de utelämnas.
 * Full anatomi (pris, tillstånd, utseende) i docs/SPEC-SIDMALLAR.md avsnitt 2.2
 * och docs/DESIGN.md avsnitt 6.
 */
import { goLank, type KlickModul, type Sidtyp } from '../../lib/affiliate';
import { formateraDatumKort, formateraPris } from '../../lib/format';
import type { Lagerlage } from '../../lib/produkter';

interface Props {
  produkt: string;
  butik?: string;
  text?: string;
  /** Var på sidan knappen sitter. Standard avslut (sist på sidan). */
  modul?: KlickModul;
  /** Sätts normalt av sidmallen via Astro.locals.sidtyp. */
  sidtyp?: Sidtyp;
  /** Löpnummer på sidan. Räknas upp automatiskt om den utelämnas. */
  position?: number;
  /** Pris i kronor från erbjudanden.pris. Saknas: "Se pris hos ..." */
  pris?: number | null;
  /** erbjudanden.uppdaterad. Visas som "pris 12 sep". */
  prisDatum?: Date | string | null;
  /** Butikens namn från databasen. */
  butikNamn?: string;
  /** Sekundär stil utan länk när lagerstatus är negativ. */
  slut?: boolean;
  /**
   * Vilket negativt läge det är. Styr texten: slut i lager är tillfälligt,
   * ej beställningsbar betyder att butiken inte tar hem varan igen. Utelämnas
   * den härleds läget ur slut. Se lagerlage() i src/lib/produkter.ts.
   */
  lager?: Lagerlage;
  /** full gör knappen block och full bredd på mobil, auto från sm. Standard auto. */
  bredd?: 'auto' | 'full';
  /** Prisraden ovanför knappen. Sätt false när anroparen placerar priset själv. */
  visaPris?: boolean;
  class?: string;
}

const {
  produkt,
  butik,
  modul = 'avslut',
  pris = null,
  prisDatum = null,
  butikNamn = 'Proffsmagasinet',
  slut = false,
  bredd = 'auto',
  visaPris = true,
  class: klass,
} = Astro.props;

const lager: Lagerlage = Astro.props.lager ?? (slut ? 'slut' : 'kopbar');
const ejKopbar = lager !== 'kopbar';

const sidtyp = Astro.props.sidtyp ?? Astro.locals.sidtyp;
/**
 * Positionsräknaren går bara upp för knappar som faktiskt blir annonslänkar.
 * En ej köpbar produkt får ingen /go/-länk, och då ska den inte heller ta en
 * position i klickstatistiken.
 */
const position = ejKopbar
  ? null
  : (Astro.props.position ?? (Astro.locals.kopknappPosition = (Astro.locals.kopknappPosition ?? 0) + 1));

const href = ejKopbar ? null : goLank(produkt, { butik, modul, sidtyp, position: position ?? undefined });
const datum = prisDatum ? new Date(prisDatum) : null;
const harPris = typeof pris === 'number' && pris > 0;

const text =
  Astro.props.text ??
  (lager === 'ej_bestallningsbar'
    ? `Ej beställningsbar hos ${butikNamn}`
    : lager === 'slut'
      ? `Slut i lager hos ${butikNamn}`
      : harPris
        ? `Till ${butikNamn}`
        : `Se pris hos ${butikNamn}`);

/**
 * Sekundär stil: ram i stället för fylld knapp. Ett <span> renderas i stället
 * för <a> när varan inte går att köpa, så att ingen läsare skickas via /go/
 * till en produkt butiken inte säljer. Då är raden under inte heller en
 * annonslänk, bara prisdatumet.
 */
const knappKlass = [
  'min-h-11 items-center justify-center rounded-md px-5 py-3 font-bold no-underline text-center',
  bredd === 'full' ? 'flex w-full sm:inline-flex sm:w-auto' : 'inline-flex',
  ejKopbar ? 'border-2 border-blyerts text-blyerts-2' : 'bg-penna text-papper hover:bg-blyerts hover:text-papper',
];
const prisrad = datum && harPris ? `pris ${formateraDatumKort(datum)}` : '';
---

<div class:list={['kopknapp', klass]}>
  {
    visaPris && harPris && (
      <p class="m-0 mb-2 font-bold tabular-nums text-brod text-blyerts">
        {ejKopbar && <span class="font-normal text-blyerts-2">senast </span>}
        {formateraPris(pris)}
      </p>
    )
  }
  {
    ejKopbar ? (
      <span class:list={knappKlass}>{text}</span>
    ) : (
      <a href={href} rel="sponsored nofollow" class:list={knappKlass}>
        {text}
      </a>
    )
  }
  {
    (!ejKopbar || prisrad) && (
      <p class="m-0 mt-2 text-finstilt text-blyerts-2">
        {ejKopbar ? prisrad : `Annonslänk${prisrad ? ` · ${prisrad}` : ''}`}
      </p>
    )
  }
</div>
