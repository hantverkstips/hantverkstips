---
/**
 * Enda tillåtna sättet att länka till en butik. Går alltid via /go/.
 * Innehållsfiler skriver: <Kopknapp produkt="woods-mrd20" />
 * Sidmallar anger modul; sidtyp och position kommer från Astro.locals om de utelämnas.
 * Full anatomi (pris, tillstånd, utseende) i docs/SPEC-SIDMALLAR.md avsnitt 2.2
 * och docs/DESIGN.md avsnitt 6.
 */
import {
  goLank,
  kopknappHamtarSjalv,
  kopknappModul,
  kopknappText,
  type KlickModul,
  type Sidtyp,
} from '../../lib/affiliate';
import { formateraDatumKort, formateraPris } from '../../lib/format';
import {
  billigasteErbjudande,
  hamtaProdukt,
  lagerlage,
  varnaSaknadProdukt,
  type Lagerlage,
} from '../../lib/produkter';

interface Props {
  produkt: string;
  butik?: string;
  text?: string;
  /** Var på sidan knappen sitter. Standard avslut, eller kort_kompakt när knappen hämtar erbjudandet själv. */
  modul?: KlickModul;
  /** Sätts normalt av sidmallen via Astro.locals.sidtyp. */
  sidtyp?: Sidtyp;
  /** Löpnummer på sidan. Räknas upp automatiskt om den utelämnas. */
  position?: number;
  /** Pris i kronor från erbjudanden.pris. Saknas: "Se pris hos ..." */
  pris?: number | null;
  /** erbjudanden.uppdaterad. Visas som "pris 12 sep". */
  prisDatum?: Date | string | null;
  /** Butikens namn från databasen. */
  butikNamn?: string;
  /** Sekundär stil utan länk när lagerstatus är negativ. */
  slut?: boolean;
  /**
   * Vilket läge det är. Styr texten: slut i lager är tillfälligt, ej
   * beställningsbar betyder att butiken inte tar hem varan igen, och
   * restnoterad går att beställa med längre leveranstid (en vanlig
   * annonslänk, läget i raden under). Utelämnas den härleds läget ur slut.
   * Se src/lib/lagerlage.ts.
   */
  lager?: Lagerlage;
  /** full gör knappen block och full bredd på mobil, auto från sm. Standard auto. */
  bredd?: 'auto' | 'full';
  /** Prisraden ovanför knappen. Sätt false när anroparen placerar priset själv. */
  visaPris?: boolean;
  class?: string;
}

const { produkt, butik, slut = false, bredd = 'auto', visaPris = true, class: klass } = Astro.props;

/**
 * Innehållsfiler skickar bara produkt (och kanske modul och text). Då hämtar
 * knappen erbjudandet själv med samma regler som korten, så att priset alltid
 * får sitt datum (SPEC-SIDMALLAR.md avsnitt 2.2, ändrat 2026-09-30).
 */
const hamtarSjalv = kopknappHamtarSjalv(Astro.props);
const hamtad = hamtarSjalv ? await hamtaProdukt(produkt) : null;
if (hamtarSjalv && !hamtad) varnaSaknadProdukt(produkt, Astro.url.pathname);
const erbjudande = hamtad ? billigasteErbjudande(hamtad) : null;

const modul = kopknappModul(Astro.props.modul, hamtarSjalv);
const pris = hamtarSjalv ? (erbjudande?.pris ?? null) : (Astro.props.pris ?? null);
const prisDatum = hamtarSjalv ? (erbjudande?.uppdaterad ?? null) : (Astro.props.prisDatum ?? null);
const butikNamn = hamtarSjalv ? erbjudande?.butikNamn : Astro.props.butikNamn;

const lager: Lagerlage = hamtarSjalv
  ? lagerlage(erbjudande)
  : (Astro.props.lager ?? (slut ? 'slut' : 'kopbar'));
const ejKopbar = lager === 'slut' || lager === 'ej_bestallningsbar';
/** Negativ lagerstatus som ändå går att köpa: visas i raden under knappen. */
const restnoterad = lager === 'restnoterad';

const sidtyp = Astro.props.sidtyp ?? Astro.locals.sidtyp;
/**
 * Positionsräknaren går bara upp för knappar som faktiskt blir annonslänkar.
 * En ej köpbar produkt får ingen /go/-länk, och då ska den inte heller ta en
 * position i klickstatistiken.
 */
const position = ejKopbar
  ? null
  : (Astro.props.position ?? (Astro.locals.kopknappPosition = (Astro.locals.kopknappPosition ?? 0) + 1));

const href = ejKopbar ? null : goLank(produkt, { butik, modul, sidtyp, position: position ?? undefined });
const datum = prisDatum ? new Date(prisDatum) : null;
const harPris = typeof pris === 'number' && pris > 0;

const text = Astro.props.text ?? kopknappText(lager, harPris, butikNamn);

/**
 * Sekundär stil: ram i stället för fylld knapp. Ett <span> renderas i stället
 * för <a> när varan inte går att köpa, så att ingen läsare skickas via /go/
 * till en produkt butiken inte säljer. Då är raden under inte heller en
 * annonslänk, bara prisdatumet.
 */
const knappKlass = [
  // Det gemensamma står i .kopknapp i global.css (spec-skal-budget-2026-09-28 steg 4).
  'kopknapp',
  // Full bredd och det köpbara läget är modifierare i global.css (spec-skal-budget-2026-09-28 avsnitt 14.3).
  bredd === 'full' ? 'kopknapp-full' : 'inline-flex',
  ejKopbar ? 'border-2 border-blyerts text-blyerts-2' : 'kopknapp-aktiv',
];
const prisrad = datum && harPris ? `pris ${formateraDatumKort(datum)}` : '';
---

<div class:list={[klass]}>
  {
    visaPris && harPris && (
      <p class="kopknapp-pris">
        {ejKopbar && <span class="font-normal text-blyerts-2">senast </span>}
        {formateraPris(pris)}
      </p>
    )
  }
  {
    ejKopbar ? (
      <span class:list={knappKlass}>{text}</span>
    ) : (
      <a href={href} rel="sponsored nofollow" class:list={knappKlass}>
        {text}
      </a>
    )
  }
  {
    (!ejKopbar || prisrad) && (
      <p class="kopknapp-annons">
        {ejKopbar ? prisrad : `Annonslänk${prisrad ? ` · ${prisrad}` : ''}${restnoterad ? ' · restnoterad' : ''}`}
      </p>
    )
  }
</div>
