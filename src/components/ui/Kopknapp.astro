---
/**
 * Enda tillåtna sättet att länka till en butik. Går alltid via /go/.
 * Innehållsfiler skriver: <Kopknapp produkt="woods-mrd20" />
 * Sidmallar anger modul; sidtyp kommer från Astro.locals om den utelämnas, och
 * position fylls i av src/middleware.ts i den färdiga HTML:en.
 * Full anatomi (pris, tillstånd, utseende) i docs/SPEC-SIDMALLAR.md avsnitt 2.2
 * och docs/DESIGN.md avsnitt 6.
 */
import {
  goLank,
  kopknappHamtarSjalv,
  kopknappModul,
  kopknappText,
  type KlickModul,
  type Sidtyp,
} from '../../lib/affiliate';
import { formateraDatumKort, formateraPris } from '../../lib/format';
import {
  billigasteErbjudande,
  hamtaProdukt,
  lagerlage,
  varnaSaknadProdukt,
  type Lagerlage,
} from '../../lib/produkter';

interface Props {
  produkt: string;
  butik?: string;
  text?: string;
  /** Var på sidan knappen sitter. Standard avslut, eller kort_kompakt när knappen hämtar erbjudandet själv. */
  modul?: KlickModul;
  /** Sätts normalt av sidmallen via Astro.locals.sidtyp. */
  sidtyp?: Sidtyp;
  /** Löpnummer på sidan. Utelämnas den numrerar src/middleware.ts knapparna i sidans ordning. */
  position?: number;
  /** Pris i kronor från erbjudanden.pris. Saknas: "Se pris hos ..." */
  pris?: number | null;
  /** erbjudanden.uppdaterad. Visas som "pris 12 sep". */
  prisDatum?: Date | string | null;
  /** Butikens namn från databasen. */
  butikNamn?: string;
  /** Sekundär stil utan länk när lagerstatus är negativ. */
  slut?: boolean;
  /**
   * Vilket läge det är. Styr texten: slut i lager är tillfälligt, ej
   * beställningsbar betyder att butiken inte tar hem varan igen, och
   * restnoterad går att beställa med längre leveranstid (en vanlig
   * annonslänk, läget i raden under). Utelämnas den härleds läget ur slut.
   * Se src/lib/lagerlage.ts.
   */
  lager?: Lagerlage;
  /** Utan verkan sedan fas B: knappen är alltid full bredd på mobil. Står kvar för anroparna. */
  bredd?: 'auto' | 'full';
  /**
   * Priset bredvid knappen. Sätt false när anroparen placerar priset själv;
   * då står bara raden "Annonslänk · pris …" kvar, under knappen.
   */
  visaPris?: boolean;
  class?: string;
}

const { produkt, butik, slut = false, visaPris = true, class: klass } = Astro.props;

/**
 * Innehållsfiler skickar bara produkt (och kanske modul och text). Då hämtar
 * knappen erbjudandet själv med samma regler som korten, så att priset alltid
 * får sitt datum (SPEC-SIDMALLAR.md avsnitt 2.2, ändrat 2026-09-30).
 */
const hamtarSjalv = kopknappHamtarSjalv(Astro.props);
const hamtad = hamtarSjalv ? await hamtaProdukt(produkt) : null;
if (hamtarSjalv && !hamtad) varnaSaknadProdukt(produkt, Astro.url.pathname);
const erbjudande = hamtad ? billigasteErbjudande(hamtad) : null;

const modul = kopknappModul(Astro.props.modul, hamtarSjalv);
const pris = hamtarSjalv ? (erbjudande?.pris ?? null) : (Astro.props.pris ?? null);
const prisDatum = hamtarSjalv ? (erbjudande?.uppdaterad ?? null) : (Astro.props.prisDatum ?? null);
const butikNamn = hamtarSjalv ? erbjudande?.butikNamn : Astro.props.butikNamn;

const lager: Lagerlage = hamtarSjalv
  ? lagerlage(erbjudande)
  : (Astro.props.lager ?? (slut ? 'slut' : 'kopbar'));
const ejKopbar = lager === 'slut' || lager === 'ej_bestallningsbar';
/** Negativ lagerstatus som ändå går att köpa: visas i raden under priset. */
const restnoterad = lager === 'restnoterad';

const sidtyp = Astro.props.sidtyp ?? Astro.locals.sidtyp;
/**
 * Utan position skrivs platshållaren, och src/middleware.ts numrerar länkarna i
 * den ordning de står i HTML:en. En ej köpbar produkt får ingen /go/-länk och
 * tar därför ingen position i klickstatistiken.
 */
const href = ejKopbar
  ? null
  : goLank(produkt, { butik, modul, sidtyp, position: Astro.props.position ?? 'auto' });
const datum = prisDatum ? new Date(prisDatum) : null;
const harPris = typeof pris === 'number' && pris > 0;

/**
 * "Se pris hos {butik}" i alla köpbara lägen, med och utan pris
 * (spec-designlyft-b avsnitt 2). kopknappText ger just den texten när den får
 * veta att priset saknas, och "Slut i lager hos …" och "Ej beställningsbar hos …"
 * som förut; priset står ju nu bredvid knappen.
 */
const text = Astro.props.text ?? kopknappText(lager, false, butikNamn);

/**
 * Ej köpbar: konturknapp och ett <span> i stället för <a>, så att ingen läsare
 * skickas via /go/ till en produkt butiken inte säljer. Då är raden under inte
 * heller en annonslänk, bara prisdatumet.
 */
const prisrad = datum && harPris ? `pris ${formateraDatumKort(datum)}` : '';
const annons = ejKopbar ? prisrad : `Annonslänk${prisrad ? ` · ${prisrad}` : ''}${restnoterad ? ' · restnoterad' : ''}`;
const belopp = visaPris && typeof pris === 'number' && pris > 0 ? formateraPris(pris) : null;
---

<div class:list={['kopknapp-rad', !visaPris && 'kopknapp-stapel', klass]}>
  {
    ejKopbar ? (
      <span class="knapp kopknapp">{text}</span>
    ) : (
      <a href={href} rel="sponsored nofollow" class="knapp knapp-fylld kopknapp">
        {text}
      </a>
    )
  }
  {
    (belopp || annons) && (
      <p class="kopknapp-pris">
        {belopp && ejKopbar && <span>senast </span>}
        {belopp}
        {annons && <span class="kopknapp-annons">{annons}</span>}
      </p>
    )
  }
</div>
