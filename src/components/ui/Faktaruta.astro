---
/**
 * Faktaruta på linjerat papper. Enligt docs/DESIGN.md avsnitt 6 ligger alla tre
 * varianterna på .linjerat: "Kort svar" är den färgade ytan från Magasinet i
 * Anteckningsbokens hand. Innehåller aldrig köpknappar eller produktkort.
 */
interface Props {
  variant?: 'kortsvar' | 'fakta' | 'kopom';
  rubrik?: string;
  /** Bara kopom. */
  kopOm?: string;
  /** Bara kopom. */
  kopInteOm?: string;
}

const { variant = 'fakta', kopOm, kopInteOm } = Astro.props;
const rubrik = Astro.props.rubrik ?? (variant === 'kortsvar' ? 'Kort svar' : undefined);
---

<div class="linjerat my-8 text-brod lg:text-brod-lg">
  {rubrik && <h3 class="m-0 mb-2 font-sans text-h3 lg:text-h3-lg text-blyerts">{rubrik}</h3>}

  {
    variant === 'kopom' ? (
      <div class="grid gap-4 lg:grid-cols-2">
        <div>
          <p class="m-0 mb-1 text-etikett lg:text-etikett-lg uppercase text-blyerts">Köp om</p>
          <p class="m-0">{kopOm}</p>
        </div>
        <div>
          <p class="m-0 mb-1 text-etikett lg:text-etikett-lg uppercase text-blyerts">Köp inte om</p>
          <p class="m-0">{kopInteOm}</p>
        </div>
      </div>
    ) : (
      <div class="prosa">
        <slot />
      </div>
    )
  }
</div>
