---
/**
 * Faktaruta i tre varianter (docs/DESIGN.md avsnitt 6, Faktaruta och Kort svar;
 * spec-designlyft-b-2026-10-02 1.9):
 *  - kortsvar: färgad yta (.yta .kortsvar) med etiketten "Kort svar"
 *  - fakta:    ett block (.blad) med valfri rubrik i H3-stil
 *  - kopom:    färgad yta med Köp om och Köp inte om, i två spalter från lg
 * Innehåller aldrig köpknappar eller produktkort.
 *
 * Kortsvarets rubrik renderas som <p>: rutan ligger före sidans första H2, och
 * en riktig H3 där ger fel rubrikordning. Står en <Kortsvarstext> i slotten har
 * den redan ritat ytan och etiketten, och då renderas den som den är.
 */
interface Props {
  variant?: 'kortsvar' | 'fakta' | 'kopom';
  rubrik?: string;
  /** Bara kopom. */
  kopOm?: string;
  /** Bara kopom. */
  kopInteOm?: string;
}

const { variant = 'fakta', kopOm, kopInteOm } = Astro.props;
const rubrik = Astro.props.rubrik ?? (variant === 'kortsvar' ? 'Kort svar' : undefined);
const slot = variant === 'kortsvar' ? await Astro.slots.render('default') : '';
const fardigKortsvar = /^\s*<div\b[^>]*class="yta kortsvar"/.test(slot);
---

{
  variant === 'kortsvar' ? (
    fardigKortsvar ? (
      <div class="my-8">
        <Fragment set:html={slot} />
      </div>
    ) : (
      <div class="yta kortsvar my-8">
        <p>{rubrik}</p>
        <Fragment set:html={slot} />
      </div>
    )
  ) : variant === 'kopom' ? (
    <div class="yta my-8 p-4 lg:p-6 grid gap-6 lg:grid-cols-2 text-brod lg:text-brod-lg">
      <div>
        <p class="etikett text-blyerts">Köp om</p>
        <p class="m-0 mt-1">{kopOm}</p>
      </div>
      <div>
        <p class="etikett text-blyerts">Köp inte om</p>
        <p class="m-0 mt-1">{kopInteOm}</p>
      </div>
    </div>
  ) : (
    <div class="blad my-8 p-4 lg:p-6 text-brod lg:text-brod-lg">
      {rubrik && <h3 class="m-0 mb-3 font-sans text-h3 lg:text-h3-lg text-blyerts">{rubrik}</h3>}
      <div class="prosa">
        <slot />
      </div>
    </div>
  )
}
