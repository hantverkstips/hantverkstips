---
/**
 * Behållaren runt en handskriven tabell i en .astro-sida: ledtexten
 * "Dra i sidled för att se hela tabellen" på mobil, sidledsscroll inuti
 * behållaren (aldrig i sidan) och den tonade högerkanten som visar att det
 * finns mer. Samma yta och samma klasser som brödtabellerna i MDX får av
 * hast-pluginet i astro.config.mjs och som Jamforelsetabell använder.
 *
 * Ledtexten och kanten syns bara när tabellen är bredare än ytan. Det avgör
 * CSS:en i global.css med en scroll-tidslinje på behållaren, utan JavaScript
 * (docs/briefer/spec-tabellyta-overflod-2026-09-29.md). Klasserna tabell-block
 * och tabell-dra bär det.
 *
 * I webbläsare utan scroll-tidslinjer gäller reserven: ledtexten under lg från
 * tre kolumner, kanten alltid under lg. Kolumnerna är därför en prop, eftersom
 * anroparen vet dem och villkoret fungerar också utan :has().
 */
interface Props {
  /** Antal kolumner i tabellen. Ledtexten renderas från tre. */
  kolumner: number;
  /** Klasser på blocket, för marginalen runt tabellen. */
  class?: string;
}

const { kolumner, class: klass } = Astro.props;
const visaLedtext = kolumner >= 3;
---

<div class:list={['tabell-block', klass]}>
  {
    visaLedtext && (
      <p class="tabell-dra">Dra i sidled för att se hela tabellen</p>
    )
  }
  <div class="tabell-yta">
    <div class="tabell-behallare">
      <slot />
    </div>
  </div>
</div>
