---
/**
 * Ikon ur spriten, som serveras som egen fil ur /_astro/ med hash och årslång
 * cache (docs/briefer/spec-skal-budget-2026-09-28.md). Alltid dekorativ: texten
 * bredvid bär betydelsen. Färgen kommer från currentColor, som ärvs genom <use>
 * också från en extern fil. Se docs/DESIGN.md avsnitt 6.
 */
import sprite from '../../assets/brand/riktning-1/ikoner.svg?url';
export type IkonNamn =
  | 'fukt'
  | 'inomhus'
  | 'fasad'
  | 'golv'
  | 'kok'
  | 'badrum'
  | 'altan'
  | 'tak'
  | 'grund'
  | 'isolering'
  | 'verktyg'
  | 'el'
  | 'kalkylator'
  | 'meny'
  | 'stang'
  | 'sok'
  | 'pil-hoger'
  | 'extern-lank'
  | 'varning'
  | 'info'
  | 'check';

interface Props {
  namn: IkonNamn;
  /**
   * Px. Standard 24. null skriver inga width och height: storleken kommer då
   * från förälderns komponentklass (.amnesrad och .menypanel i global.css), så
   * att skalet inte bär samma två attribut på varje menypost
   * (docs/briefer/spec-skal-budget-2-2026-09-29.md punkt 3).
   */
  storlek?: number | null;
  class?: string;
}

const { namn, storlek = 24, class: klass } = Astro.props;
const matt = storlek ?? undefined;
---

<svg width={matt} height={matt} aria-hidden="true" class:list={[klass]}>
  <use href={`${sprite}#ikon-${namn}`} />
</svg>
