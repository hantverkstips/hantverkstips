---
/**
 * Räknarens svar som bild: det stora talet och enheten i en stapel bredvid,
 * med vad talet är under enheten. Ingen markering; ytan och storleken är
 * markeringen. docs/DESIGN.md 5.8, spec-designlyft-c-2026-10-02 avsnitt 2.
 */
interface Props {
  /** Färdigformaterat, med decimalkomma. */
  tal: string;
  enhet: string;
  /** Vad talet är, i 14 px blyerts-2 under enheten. */
  vad?: string;
}

const { tal, enhet, vad } = Astro.props;
---

<p class="svarstal">
  <span class="font-serif text-siffra-lg lg:text-siffra-xl">{tal}</span>
  <span>
    <span class="font-serif text-h2">{enhet}</span>
    {vad && <span class="text-liten text-blyerts-2">{vad}</span>}
  </span>
</p>
