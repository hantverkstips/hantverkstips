---
/**
 * Egen illustration inne i en artikel. Läser SVG-filen från
 * src/assets/illustrationer/[pelare]/[namn].svg.
 *
 * En skiss som är ritad i färdiga färger serveras som <img> från /_astro/, så
 * att den cachas ett år och laddas efter texten i stället för att ligga i
 * HTML:en. Bara en fil som behöver sidans färger (currentColor eller en token)
 * inlineas; läget väljs på filens innehåll, inte med en prop. Huvudbilden på en
 * sida går fortfarande via frontmatter `bild` och <Image>; den här är för
 * skisser i löptexten.
 *
 * I MDX: <Illustration namn="fukt/daggpunkt" alt="Daggpunkten vid 20 grader och 60 procent." />
 *
 * Reglerna för skisserna står i docs/DESIGN.md avsnitt 7. Okänt namn ger byggfel.
 * Bredd och höjd tas från viewBox och skrivs som attribut, så att sidan inte
 * hoppar (CLS) medan bilden hämtas.
 */
import { inlineMarkup, lasViewBox, valjLage } from '../../lib/illustration';
import { slugify } from '../../lib/innehall';

interface Props {
  /** Sökväg utan ändelse, relativt src/assets/illustrationer/: "fukt/daggpunkt". */
  namn: string;
  /** Vad bilden visar, för den som inte ser den. Krävs. */
  alt: string;
  /** Bildtext under illustrationen. Valfri. */
  bildtext?: string;
  class?: string;
}

const { namn, alt, bildtext, class: klass } = Astro.props;

// Eager import.meta.glob gör att alla illustrationer läses vid bygget och att
// Vite kan felsöka en saknad fil. Nyckeln är sökvägen relativt den här filen.
// Råfilen avgör läget; tillgångsversionen ger src, width och height med hash i
// filnamnet, som src/lib/verktygsbild.ts redan gör för räknarnas bilder.
const filer = import.meta.glob<string>('../../assets/illustrationer/**/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const bilder = import.meta.glob<ImageMetadata>('../../assets/illustrationer/**/*.svg', {
  import: 'default',
  eager: true,
});

// Handskriften är banor, inte text (scripts/konvertera-handskrift.mjs), och banor väger
// mer än <text>. Gränsen är därför 40 kB för en konverterad skiss, inte 24.
const MAX_BYTE = 40 * 1024;

const nyckel = `../../assets/illustrationer/${namn}.svg`;
const ra = filer[nyckel];
if (ra === undefined) {
  const finns = Object.keys(filer)
    .map((k) => k.replace('../../assets/illustrationer/', '').replace(/\.svg$/, ''))
    .sort()
    .join(', ');
  throw new Error(
    `[Illustration] "${namn}" finns inte. Väntade src/assets/illustrationer/${namn}.svg. Finns: ${finns || 'inga'}`,
  );
}
if (!alt) throw new Error(`[Illustration] "${namn}" saknar alt. Skriv vad bilden visar.`);

if (ra.length > MAX_BYTE) {
  console.warn(
    `[Illustration] ${namn}.svg är ${Math.round(ra.length / 1024)} kB. Gränsen för en skiss är 40 kB (DESIGN.md avsnitt 7); förenkla den.`,
  );
}
if (/<text[\s>]/.test(ra)) {
  console.warn(
    `[Illustration] ${namn}.svg innehåller <text>. Handskriften ska vara banor innan publicering (DESIGN.md avsnitt 7). Redigera källan i src/assets/illustrationer-kallor/${namn}.svg och kör npm run illustrationer.`,
  );
}

/** Felen från src/lib/illustration.ts får filnamnet på sig här. */
function medFilnamn<T>(arbete: () => T): T {
  try {
    return arbete();
  } catch (fel) {
    throw new Error(`[Illustration] ${namn}.svg ${fel instanceof Error ? fel.message : String(fel)}`);
  }
}

// viewBox ger måtten; width och height i filen ignoreras i inline-läget och
// kontrolleras mot viewBox i img-läget.
const matt = medFilnamn(() => lasViewBox(ra));

let bild: ImageMetadata | undefined;
let svg = '';

if (valjLage(ra) === 'inline') {
  svg = medFilnamn(() => inlineMarkup(ra, alt, slugify(namn)));
} else {
  bild = bilder[nyckel];
  if (!bild) {
    throw new Error(
      `[Illustration] ${namn}.svg gick inte att importera som bild. Filen finns som råtext men saknas i tillgångsglobben.`,
    );
  }
  if (bild.src.startsWith('data:')) {
    throw new Error(
      `[Illustration] ${namn}.svg blev en data-URI i stället för en fil under /_astro/. Skissen ska ligga som egen fil för att kunna cachas.`,
    );
  }
  if (bild.width !== matt.bredd || bild.height !== matt.hojd) {
    throw new Error(
      `[Illustration] ${namn}.svg har width och height ${bild.width} × ${bild.height} men en viewBox på ${matt.bredd} × ${matt.hojd}. Då reserverar sidan fel yta och hoppar; rätta rotelementet i källan och kör npm run illustrationer.`,
    );
  }
}
---

{/*
  Skisserna ritas i en 600 enheter bred viewBox och etiketterna sätts i den
  skalan. Får figuren hela läsbredden (704 px) blir en viewBox-enhet 1,17 px
  och axeltexten större än brödtexten. Max 600 px på desktop gör en enhet till
  en bildpunkt; på mobil fyller bilden bredden som förut.
  Se docs/DESIGN.md avsnitt 7 och designgranskningen 2026-09-16 punkt 12.
*/}
<figure class:list={['m-0 my-8 max-w-[600px]', klass]}>
  {
    bild ? (
      <img
        src={bild.src}
        alt={alt}
        width={bild.width}
        height={bild.height}
        loading="lazy"
        decoding="async"
        class="block w-full h-auto rounded-sm border border-linje"
      />
    ) : (
      <Fragment set:html={svg} />
    )
  }
  {bildtext && <figcaption class="mt-2 text-liten text-blyerts-2">{bildtext}</figcaption>}
</figure>
