---
/**
 * Rutnätet av artikelkort. Tre eller fyra kolumner från 1024 px, två från 640,
 * en under. Rutnätet använder sidbredden, inte läsbredden: det är formen som gör
 * sidan till en tidningssida i stället för en lodrät ström. Se docs/DESIGN.md
 * avsnitt 6. Det stora kortet renderar anroparen själv (startsidans justNu,
 * hubbens Börja här), och luften ovanför sätter rubrikraden.
 *
 * kompaktPaMobil gör korten kompakta på mobil, så att startsidan inte blir
 * 2 400 px lång.
 */
import type { KortData } from '../../lib/kort';
import Artikelkort from './Artikelkort.astro';

interface Props {
  kort: KortData[];
  /** Kolumner från 1024 px. Standard 3. */
  kolumner?: 3 | 4;
  kompaktPaMobil?: boolean;
  /** Metaraden utan pelarnamn. Hubben, där alla kort har samma pelare. */
  visaPelare?: boolean;
  visaBeskrivning?: boolean;
  visaMeta?: boolean;
}

const {
  kort,
  kolumner = 3,
  kompaktPaMobil = false,
  visaPelare = true,
  visaBeskrivning = true,
  visaMeta = true,
} = Astro.props;
---

{
  kort.length > 0 && (
    <ul
      class:list={[
        'm-0 grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2 lg:gap-5',
        kolumner === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3',
      ]}
    >
      {kort.map((k) => (
        <li>
          <Artikelkort
            etikett={k.etikett}
            niva={k.niva}
            rubrik={k.rubrik}
            beskrivning={k.beskrivning}
            illustration={k.illustration}
            pelare={k.pelare}
            datum={k.datum}
            meta={k.meta}
            href={k.href}
            bladfakta={k.bladfakta}
            kompaktPaMobil={kompaktPaMobil}
            visaPelare={visaPelare}
            visaBeskrivning={visaBeskrivning}
            visaMeta={visaMeta}
          />
        </li>
      ))}
    </ul>
  )
}
