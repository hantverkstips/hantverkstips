---
/**
 * Alla produkter i en kategori mot samma mått, från databasen. Kolumner är
 * produkter, rader är egenskaper ur kategorifilen. Enheter står i radrubriken,
 * bästa värdet är både fetstil och ok-färg. Se docs/SPEC-SIDMALLAR.md avsnitt 2.4.
 */
import { getEntry } from 'astro:content';
import type { KlickModul } from '../../lib/affiliate';
import { formateraPris, formateraSpecVarde } from '../../lib/format';
import {
  billigasteErbjudande,
  hamtaProdukter,
  lagerlage,
  lokalBild,
  produktNamn,
  varnaSaknadProdukt,
  type Produkt,
} from '../../lib/produkter';
import Kopknapp from './Kopknapp.astro';

interface Props {
  /** Slugs i kolumnordning. */
  produkter: string[];
  /** Kategorislug, ger specs och enheter. */
  kategori: string;
  kopknappar?: boolean;
  etiketter?: Record<string, string>;
  rekommenderade?: string[];
  modul?: KlickModul;
}

const {
  produkter: slugs,
  kategori: kategoriSlug,
  kopknappar = true,
  etiketter = {},
  rekommenderade = [],
  modul = 'tabell',
} = Astro.props;

const produkter = await hamtaProdukter(slugs);
for (const slug of slugs) {
  if (!produkter.some((p) => p.slug === slug)) varnaSaknadProdukt(slug, Astro.url.pathname);
}

const kategori = await getEntry('kategorier', kategoriSlug);
const specs = kategori?.data.specs ?? [];

if (produkter.length < 2) {
  console.warn(`[Jamforelsetabell] färre än två produkter på ${Astro.url.pathname}`);
}

const erbjudanden = new Map(produkter.map((p) => [p.slug, billigasteErbjudande(p)]));
const harNagotPris = produkter.some((p) => {
  const e = erbjudanden.get(p.slug);
  return typeof e?.pris === 'number' && e.pris > 0;
});
const harEtiketter = produkter.some((p) => Boolean(etiketter[p.slug]));

/** Bästa numeriska värdet i raden. NaN räknas inte. */
function bastaSlugs(nyckel: string, bast: 'hogst' | 'lagst' | undefined): Set<string> {
  if (!bast) return new Set();
  const tal = produkter
    .map((p) => ({ slug: p.slug, v: Number(p.specs[nyckel]) }))
    .filter((x) => Number.isFinite(x.v));
  if (tal.length === 0) return new Set();
  const basta = tal.reduce((a, b) => (bast === 'hogst' ? (b.v > a.v ? b : a) : b.v < a.v ? b : a));
  return new Set(tal.filter((x) => x.v === basta.v).map((x) => x.slug));
}

function varde(p: Produkt, nyckel: string): string | null {
  const v = p.specs[nyckel];
  if (v === undefined || v === null || v === '') return null;
  return formateraSpecVarde(v);
}

function kolumnKlass(slug: string): string {
  return rekommenderade.includes(slug) ? 'bg-papper-2' : '';
}
---

{
  produkter.length >= 2 && (
    <div class="tabell-block my-8">
      <p class="tabell-dra">Dra i sidled för att se alla</p>
      <div class="tabell-yta">
        <div class="tabell-behallare border border-linje rounded-sm">
          {/*
            Cellernas klasser står en gång här som varianter, inte på varje cell
            (spec-skal-budget-2026-09-28 avsnitt 13.1, 5.3). Kolumnhuvudet och
            produktnamnet i det likaså (spec-kategorisida-budget-2026-09-28 2.1). Hörncellen är första
            td i sin rad och undantas; alla andra td har en th före sig.
            text-blyerts på tabellen ärvs av cellerna; bästa värdet sätter
            font-bold text-ok på sin egen cell.
          */}
          <table
            class="w-full border-collapse text-liten tabular-nums text-blyerts [&_td:not(:first-child)]:min-w-[150px] [&_td:not(:first-child)]:p-3 [&_td:not(:first-child)]:align-top [&_th[scope=row]]:sticky [&_th[scope=row]]:left-0 [&_th[scope=row]]:bg-papper-2 [&_th[scope=row]]:border-r [&_th[scope=row]]:border-linje [&_th[scope=row]]:p-3 [&_th[scope=row]]:text-left [&_th[scope=row]]:align-top [&_th[scope=row]]:font-normal [&_th[scope=row]]:text-blyerts-2 [&_th[scope=col]]:min-w-[150px] [&_th[scope=col]]:p-3 [&_th[scope=col]]:text-left [&_th[scope=col]]:align-top [&_th[scope=col]>span]:mt-2 [&_th[scope=col]>span]:block [&_th[scope=col]>span]:font-sans [&_th[scope=col]>span]:text-h3 [&_th[scope=col]>span]:font-bold [&_th[scope=col]>span]:text-blyerts"
          >
            <caption class="sr-only">Jämförelse av {kategori?.data.namn ?? kategoriSlug}</caption>
          <tbody>
            {/* En huvudrad med bild och namn. Hörncellen är tom: "Bild" och
                "Produkt" som radrubriker säger inget läsaren inte redan ser. */}
            <tr class="border-b border-linje">
              <td class="sticky left-0 bg-papper-2 border-r border-linje p-3" />
              {produkter.map((p) => (
                <th scope="col" class:list={[kolumnKlass(p.slug)]}>
                  {lokalBild(p) ? (
                    <div class="bg-vit border border-linje rounded-sm p-1 w-20">
                      <img
                        src={lokalBild(p)!}
                        alt=""
                        width="80"
                        height="60"
                        loading="lazy"
                        decoding="async"
                        class="block w-full h-15 object-contain"
                      />
                    </div>
                  ) : (
                    <div class="produktkort-bild produktkort-bild-liten">
                      <span>{p.marke ?? p.namn}</span>
                    </div>
                  )}
                  <span>{produktNamn(p)}</span>
                </th>
              ))}
            </tr>

            {harEtiketter && (
              <tr class="border-b border-linje">
                <th scope="row">
                  Mitt val
                </th>
                {/* Tom cell för produkter som inte är bland valen
                    (spec-rester-2026-10-04 A.1). */}
                {produkter.map((p) => (
                  <td class:list={[kolumnKlass(p.slug)]}>
                    {etiketter[p.slug] && (
                      <span class="text-etikett uppercase text-penna">{etiketter[p.slug]}</span>
                    )}
                  </td>
                ))}
              </tr>
            )}

            {specs.map((s) => {
              const basta = bastaSlugs(s.nyckel, s.bast);
              return (
                <tr class="border-b border-linje">
                  <th scope="row">
                    {s.etikett}
                    {s.enhet ? `, ${s.enhet}` : ''}
                  </th>
                  {produkter.map((p) => {
                    const v = varde(p, s.nyckel);
                    return (
                      <td
                        class:list={[kolumnKlass(p.slug), basta.has(p.slug) && 'font-bold text-ok']}
                      >
                        {v ?? <span class="text-blyerts-2">ej angivet</span>}
                      </td>
                    );
                  })}
                </tr>
              );
            })}

            {harNagotPris && (
              <tr>
                <th scope="row">
                  Pris
                </th>
                {produkter.map((p) => {
                  const e = erbjudanden.get(p.slug) ?? null;
                  return (
                    <td class:list={[kolumnKlass(p.slug)]}>
                      {kopknappar ? (
                        <Kopknapp
                          produkt={p.slug}
                          modul={modul}
                          bredd="full"
                          pris={e?.pris ?? null}
                          prisDatum={e?.uppdaterad ?? null}
                          butikNamn={e?.butikNamn}
                          lager={lagerlage(e)}
                        />
                      ) : typeof e?.pris === 'number' ? (
                        <span class="font-bold text-blyerts">{formateraPris(e.pris)}</span>
                      ) : (
                        <span class="text-blyerts-2">ej angivet</span>
                      )}
                    </td>
                  );
                })}
              </tr>
            )}
          </tbody>
          </table>
        </div>
      </div>
    </div>
  )
}
