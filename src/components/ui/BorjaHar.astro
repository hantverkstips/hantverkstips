---
/**
 * Sajtens karta på startsidan. En rad per publicerad pelarhub, aldrig tre
 * ikonkolumner. Från 1024 px ligger raderna i två spalter med 1 px linje mellan
 * raderna, så att sidan behåller sin höjd när fler pelare publiceras.
 * Härifrån får hubbarna sin interna länkkraft.
 */
import { publicerade, pelareUrl } from '../../lib/innehall';
import { PELARE } from '../../lib/pelare';
import Ikon from './Ikon.astro';
import Pennstreck from './Pennstreck.astro';

const hubbar = await publicerade('pelare');
const rader = PELARE.flatMap((pelare) => {
  const entry = hubbar.find((h) => h.id === pelare.slug);
  return entry ? [{ pelare, entry }] : [];
});

// Två spalter från lg. Raderna fylls i läsordning, vänster till höger, så att
// en udda pelare hamnar i vänsterspalten på sista raden och cellen bredvid står
// tom tills nästa hub publiceras.
---

{
  rader.length > 0 && (
    <section>
      <div class="flex flex-wrap items-baseline justify-between gap-x-6">
        <Pennstreck id="borja-har">Börja här</Pennstreck>
        <a
          href="/amnen/"
          class="huvudmeny inline-flex min-h-11 items-center text-penna underline decoration-1 underline-offset-2 hover:decoration-2"
        >
          Alla ämnen
        </a>
      </div>

      <ul class="m-0 grid list-none grid-cols-1 gap-x-12 p-0 lg:grid-cols-2">
        {rader.map((r) => (
          <li class="border-t border-linje py-6">
                <div class="flex items-center gap-3">
                  <Ikon namn={r.pelare.ikon} storlek={24} class="text-blyerts" />
                  <h3 class="m-0 font-sans text-h3 lg:text-h3-lg">
                    <a
                      href={pelareUrl(r.pelare.slug)}
                      class="text-blyerts underline decoration-1 underline-offset-2 hover:decoration-2"
                    >
                      {r.pelare.kort}
                    </a>
                  </h3>
                </div>
                <p class="m-0 mt-2 text-brod lg:text-brod-lg">{r.entry.data.ingress}</p>
                {r.entry.data.viktiga.length > 0 && (
                  <ul class="m-0 mt-2 list-none p-0">
                    {r.entry.data.viktiga.map((v) => (
                      <li>
                        <a
                          href={v.href}
                          class="inline-flex min-h-11 items-center text-penna underline decoration-1 underline-offset-2 hover:decoration-2"
                        >
                          {v.titel}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
          </li>
        ))}
      </ul>
    </section>
  )
}
