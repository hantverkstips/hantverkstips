---
/**
 * En av pelarhubbens kortgrupper, en ren renderare. Urvalet görs en gång för
 * hela hubben av hubGrupper() i src/lib/kort.ts, och PelarHub skickar varje
 * grupps kort hit. Spec: docs/briefer/spec-designlyft-a-2026-10-02.md 4.5.
 *
 *   rakna          Verktygskort i variant bild, två i rad från 1024 px
 *   övriga         Artikelrutnat utan metarad, fyra kolumner när gruppen har
 *                  fyra kort eller fler, annars tre
 *
 * En tom grupp renderar ingenting; hubGrupper lämnar inga tomma grupper.
 */
import type { Grupp, KortData } from '../../lib/kort';
import Artikelrutnat from './Artikelrutnat.astro';
import Verktygskort from './Verktygskort.astro';

interface Props {
  grupp: Grupp;
  kort: KortData[];
  kalkylatorer: string[];
}

const { grupp, kort, kalkylatorer } = Astro.props;
---

{
  grupp === 'rakna' ? (
    kalkylatorer.length > 0 && (
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-2 lg:gap-5">
        {kalkylatorer.map((slug) => (
          <Verktygskort kalkylator={slug} variant="bild" iRutnat />
        ))}
      </div>
    )
  ) : (
    <Artikelrutnat kort={kort} kolumner={kort.length >= 4 ? 4 : 3} visaPelare={false} visaMeta={false} />
  )
}
