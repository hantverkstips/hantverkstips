---
/**
 * Produktkort. Ett kort med bildrutan till vänster, redaktörens etikett som gul
 * chip, namnet, tre fakta ur produktfakta.ts, svagheten och köpknappen med pris
 * och datum. Utseendet står i .produktkort* och .fakta i global.css.
 * Se docs/SPEC-SIDMALLAR.md 2.3, docs/DESIGN.md avsnitt 6 (Produktkort) och
 * docs/briefer/spec-designlyft-b-2026-10-02.md avsnitt 3. Kortets inre
 * (.produktkort-inre) byter till två spalter efter kortets egen bredd, så att
 * kortet håller både i textspalten och i räknarsidornas rutnät.
 *
 * Ankaret produkt-{slug} sätts bara på kortet i artikelns lista "Produkterna jag
 * nämner" (modul avslut), som sidospaltens produktlista pekar på. Samma produkt
 * kan stå som kort även i texten eller bland valen, och två element med samma
 * id på en sida är fel.
 */
import { getCollection } from 'astro:content';
import type { KlickModul } from '../../lib/affiliate';
import { ELKOSTNAD_KATEGORIER, produktForval } from '../../lib/kalkyl/elkostnad';
import { publicerade, testUrl } from '../../lib/innehall';
import { treFakta } from '../../lib/produktfakta';
import {
  billigasteErbjudande,
  hamtaProdukt,
  lagerlage,
  lokalBild,
  produktNamn,
  varnaSaknadProdukt,
} from '../../lib/produkter';
import Kopknapp from './Kopknapp.astro';

interface Props {
  /** Produktens slug i databasen. */
  produkt: string;
  /** Utan verkan sedan fas B; står kvar för filerna som skickar den. */
  variant?: 'kompakt' | 'full';
  /** Redaktörens etikett, till exempel "Kallt enkelgarage". En gul chip. */
  etikett?: string | undefined;
  forVem?: string | undefined;
  /** En mening om det som talar emot produkten. Utan den visas inget stycke. */
  svaghet?: string | undefined;
  modul?: KlickModul;
  /** Bland valen: ytan ruta. */
  rekommenderad?: boolean;
  visaTestlank?: boolean;
}

const { produkt: slug, etikett, forVem, rekommenderad = false, visaTestlank = true } = Astro.props;
const modul: KlickModul = Astro.props.modul ?? 'kort_kompakt';

const produkt = await hamtaProdukt(slug);
if (!produkt) varnaSaknadProdukt(slug, Astro.url.pathname);

/**
 * Kategorin slås upp i samlingen, inte med getEntry: databasen har kategorier
 * utan kategorisida (färgborttagare, högtryckstvättar), och getEntry varnar i
 * bygget för varje sådan produkt. Utan fil blir det inga fakta.
 * Spec: docs/briefer/spec-bilder-fasad-2026-09-28.md avsnitt 7.5.
 */
const kategori = produkt?.kategoriSlug
  ? (await getCollection('kategorier')).find((k) => k.id === produkt.kategoriSlug)
  : undefined;
const fakta = produkt ? treFakta(produkt.kategoriSlug, kategori?.data.specs ?? [], produkt.specs) : [];

const tester = await publicerade('tester');
const test = produkt ? tester.find((t) => t.data.produkt === produkt.slug) : undefined;

const erbjudande = produkt ? billigasteErbjudande(produkt) : null;
const namn = produkt ? produktNamn(produkt) : slug;
const bild = produkt ? lokalBild(produkt) : null;

/**
 * Bara svagheten. Att produkten är granskad på datablad står en gång per sida,
 * i sidospaltens Så jobbar jag (spec-rester-2026-10-04 A.2).
 */
const svaghet = Astro.props.svaghet;

/**
 * Utan effekt i databladet finns inget att räkna på, och länken utgår. Den
 * visas bara i kategorier som räknaren är gjord för (ELKOSTNAD_KATEGORIER).
 */
const harEffekt =
  produkt !== null &&
  produkt.kategoriSlug !== null &&
  ELKOSTNAD_KATEGORIER.includes(produkt.kategoriSlug) &&
  produktForval(produkt.specs).effektW !== null;
const id = modul === 'avslut' ? `produkt-${slug}` : undefined;
const kortKlass = ['kort produktkort', rekommenderad && 'bg-ruta'];
---

{
  !produkt ? (
    <div class:list={kortKlass} id={id}>
      <p class="etikett text-blyerts">Produkt: {slug}</p>
      <p class="m-0 mt-2 text-liten text-blyerts-2">Produktdata saknas i bygget</p>
    </div>
  ) : (
    <div class:list={kortKlass} id={id}>
      <div class="produktkort-inre">
      <div class="produktkort-topp">
        <div class="produktkort-bild">
          {bild ? (
            <img src={bild} alt={namn} width="150" height="150" loading="lazy" decoding="async" />
          ) : (
            <span>{produkt.marke ?? produkt.namn}</span>
          )}
        </div>
        <div class="produktkort-namn">
          {etikett && <span class="chip-gul">{etikett}</span>}
          <h3>{namn}</h3>
        </div>
      </div>

      <div class="produktkort-text">
        {forVem && <p>{forVem}</p>}
        {fakta.length > 0 && (
          <dl class="fakta">
            {fakta.map((f) => (
              <div>
                <dt>{f.etikett}</dt>
                <dd>{f.varde}</dd>
              </div>
            ))}
          </dl>
        )}
        {svaghet && <p>{svaghet}</p>}
        <Kopknapp
          produkt={produkt.slug}
          modul={modul}
          pris={erbjudande?.pris ?? null}
          prisDatum={erbjudande?.uppdaterad ?? null}
          butikNamn={erbjudande?.butikNamn}
          lager={lagerlage(erbjudande)}
        />
        {/* Har maskinen en effekt i databladet går den att räkna på. Länken tar
            med slugen, så att elkostnadsräknaren fyller i effekten åt läsaren. */}
        {harEffekt && (
          <a href={`/rakna/elkostnad/?produkt=${produkt.slug}`} class="lank inline-flex min-h-11 items-center">
            Räkna elkostnaden
          </a>
        )}
        {visaTestlank && test && (
          <a href={testUrl(test)} class="lank inline-flex min-h-11 items-center">
            {test.data.etikett === 'granskning' ? 'Läs granskningen' : 'Läs testet'}
          </a>
        )}
      </div>
      </div>
    </div>
  )
}
