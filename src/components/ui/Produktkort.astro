---
/**
 * Produktkort. Ser ut som ett inklistrat urklipp: ram i linje, 2 px radie,
 * ingen skugga. Nyckelvärdena kommer från kategorifilens specs, inte från
 * databasen direkt, så att samma fyra värden visas för alla produkter i en
 * kategori. Se docs/SPEC-SIDMALLAR.md avsnitt 2.3.
 */
import { getEntry } from 'astro:content';
import type { KlickModul } from '../../lib/affiliate';
import { produktForval } from '../../lib/kalkyl/elkostnad';
import { publicerade, testUrl } from '../../lib/innehall';
import {
  billigasteErbjudande,
  hamtaProdukt,
  lagerlage,
  lokalBild,
  produktNamn,
  varnaSaknadProdukt,
} from '../../lib/produkter';
import Kopknapp from './Kopknapp.astro';

interface Props {
  /** Produktens slug i databasen. */
  produkt: string;
  variant?: 'kompakt' | 'full';
  /** Redaktörens etikett, till exempel "Bäst till krypgrund". */
  etikett?: string;
  forVem?: string;
  modul?: KlickModul;
  rekommenderad?: boolean;
  visaTestlank?: boolean;
}

const {
  produkt: slug,
  variant = 'kompakt',
  etikett,
  forVem,
  rekommenderad = false,
  visaTestlank = true,
} = Astro.props;
const modul: KlickModul = Astro.props.modul ?? (variant === 'full' ? 'kort_full' : 'kort_kompakt');

const produkt = await hamtaProdukt(slug);
if (!produkt) varnaSaknadProdukt(slug, Astro.url.pathname);

const kategori = produkt?.kategoriSlug ? await getEntry('kategorier', produkt.kategoriSlug) : undefined;
const specs = (kategori?.data.specs ?? [])
  .filter((s) => {
    const v = produkt?.specs[s.nyckel];
    return v !== undefined && v !== null && v !== '';
  })
  .slice(0, 4);

const tester = await publicerade('tester');
const test = produkt ? tester.find((t) => t.data.produkt === produkt.slug) : undefined;

const erbjudande = produkt ? billigasteErbjudande(produkt) : null;
const namn = produkt ? produktNamn(produkt) : slug;
const bild = produkt ? lokalBild(produkt) : null;

const kortKlass = [
  'border border-linje rounded-sm p-4 lg:p-6',
  rekommenderad ? 'bg-papper-2' : 'bg-papper',
];
const harBild = bild !== null;
/** Utan effekt i databladet finns inget att räkna på, och länken utgår. */
const harEffekt = produkt ? produktForval(produkt.specs).effektW !== null : false;
const bildBredd = variant === 'kompakt' ? 96 : 400;
const bildHojd = variant === 'kompakt' ? 72 : 300;
---

{
  !produkt ? (
    <div class:list={kortKlass}>
      <p class="m-0 text-etikett lg:text-etikett-lg uppercase text-blyerts">Produkt: {slug}</p>
      <p class="m-0 mt-2 text-liten text-blyerts-2">Produktdata saknas i bygget</p>
    </div>
  ) : (
    <div class:list={kortKlass}>
      <div class:list={['flex gap-4', harBild && variant === 'full' ? 'flex-col lg:flex-row lg:gap-6' : 'flex-row']}>
        <div class:list={[harBild && variant === 'full' ? 'lg:w-2/5 shrink-0' : 'shrink-0']}>
          {bild ? (
            <div class="bg-vit border border-linje rounded-sm p-2">
              <img
                src={bild}
                alt={namn}
                width={bildBredd}
                height={bildHojd}
                loading="lazy"
                decoding="async"
                class:list={[
                  'block object-contain',
                  variant === 'kompakt' ? 'w-24 h-18' : 'w-full aspect-4/3 h-auto',
                ]}
              />
            </div>
          ) : (
            /* Utan bild blir rutan alltid kompakt, aldrig en tom 4:3-yta i full bredd. */
            <div class="bg-papper-2 border border-linje rounded-sm flex items-center justify-center text-center p-2 w-24 h-18">
              <span class="text-etikett uppercase text-blyerts-2">{produkt.marke ?? produkt.namn}</span>
            </div>
          )}
        </div>

        <div class="min-w-0 flex-1">
          {etikett && <p class="m-0 mb-1 text-etikett lg:text-etikett-lg uppercase text-penna">{etikett}</p>}
          <h3 class="m-0 font-sans text-h3 lg:text-h3-lg text-blyerts">{namn}</h3>
          {forVem && <p class="m-0 mt-1 text-brod text-blyerts-2">{forVem}</p>}

          {/* Nyckelvärdena: etiketten tar bara den bredd den behöver, värdet
              resten, och minmax(0,1fr) hindrar att ett långt värde spränger
              spalten. Med två lika breda kolumner skrev etikett och värde över
              varandra i ett smalt kort (designgranskningen 2026-09-16 punkt 3).
              Under 640 px ligger värdet i stället på egen rad under etiketten:
              i ett kompakt kort bredvid bilden blir värdekolumnen annars så smal
              att "ej angivet, sannolikt 30 °C/80 % RF" bryts på fem rader
              (granskningen 2026-09-16 punkt 5.5). Marginalen under värdet
              skiljer paren åt när de är staplade. */}
          {specs.length > 0 && (
            <dl class="m-0 mt-3 grid grid-cols-1 sm:grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-1 text-liten">
              {specs.map((s) => (
                <div class="contents">
                  <dt class="m-0 text-blyerts-2">{s.etikett}</dt>
                  <dd class="m-0 mb-2 sm:mb-0 tabular-nums text-blyerts">
                    {String(produkt.specs[s.nyckel])}
                    {s.enhet ? ` ${s.enhet}` : ''}
                  </dd>
                </div>
              ))}
            </dl>
          )}

          {/* Har maskinen en effekt i databladet går den att räkna på. Länken
              tar med slugen, så att elkostnadskalkylatorn kan fylla i effekten
              och kapaciteten åt läsaren. Diskret textlänk, samma stil som
              "Läs testet" nedan. */}
          {harEffekt && (
            <p class="m-0 mt-3">
              <a
                href={`/rakna/elkostnad/?produkt=${produkt.slug}`}
                class="inline-flex min-h-11 items-center text-penna underline decoration-1 underline-offset-2 hover:decoration-2"
              >
                Räkna elkostnaden
              </a>
            </p>
          )}
        </div>
      </div>

      {/* Köpknappen ligger under bild och text, full bredd på mobil, så att
          knapptexten aldrig bryts av den 96 px breda bilden bredvid. */}
      <div class="mt-4">
        <Kopknapp
          produkt={produkt.slug}
          modul={modul}
          bredd="full"
          pris={erbjudande?.pris ?? null}
          prisDatum={erbjudande?.uppdaterad ?? null}
          butikNamn={erbjudande?.butikNamn}
          lager={lagerlage(erbjudande)}
        />
      </div>

      {visaTestlank && test && (
        <p class="m-0 mt-3">
          <a
            href={testUrl(test)}
            class="inline-flex min-h-11 items-center text-penna underline decoration-1 underline-offset-2 hover:decoration-2"
          >
            Läs testet
          </a>
        </p>
      )}
    </div>
  )
}
