---
/**
 * Rubrik med signaturstrecket. Strecket, typografin och luften ovanför står i
 * klassen .pennstreck i global.css (mask i token penna), så komponenten bygger
 * ingen egen variant och varje H2 bär bara en klass.
 * Skickas som h2 i components till <Content> så att alla H2 i innehållet får det.
 * Astro skickar id som prop, och den måste vidarebefordras för att
 * innehållsförteckningen ska hitta rubriken.
 *
 * utanLuft tar bort marginalen ovanför med klassen pennstreck-tat. Anroparen
 * kan lägga egna verktygsklasser i class; de vinner över .pennstreck.
 *
 * niva 3 renderar en H3 utan streck: DESIGN.md förbjuder pennstreck under H3.
 */
interface Props {
  id?: string;
  niva?: 2 | 3;
  utanLuft?: boolean;
  class?: string;
}

const { id, niva = 2, utanLuft = false, class: klass } = Astro.props;
---

{
  niva === 3 ? (
    <h3 id={id} class:list={['font-sans text-h3 lg:text-h3-lg mb-2 text-blyerts', !utanLuft && 'mt-8', klass]}>
      <slot />
    </h3>
  ) : (
    <h2
      id={id}
      class:list={['pennstreck', utanLuft && 'pennstreck-tat', klass]}
    >
      <slot />
    </h2>
  )
}
