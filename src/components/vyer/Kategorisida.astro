---
/**
 * Bäst i test. Sidan som tjänar pengar, så första skärmen på 375 x 667 ska
 * innehålla rubrik, ingress och första rekommendationen med köpknapp.
 * Se docs/SPEC-SIDMALLAR.md avsnitt 4.2 och docs/DESIGN.md avsnitt 5.6.
 */
import { getEntry, render, type CollectionEntry } from 'astro:content';
import Bas from '../../layouts/Bas.astro';
import { formateraDatum, isoDatum } from '../../lib/format';
import {
  artikelUrl,
  jamforelseUrl,
  kategoriUrl,
  publicerade,
  slugify,
  testUrl,
  typEtikett,
} from '../../lib/innehall';
import { arSlut, billigasteErbjudande, hamtaButik, produktNamn, produkterIKategori } from '../../lib/produkter';
import { lista as listaData } from '../../lib/strukturdata';
import Brodsmulor from '../ui/Brodsmulor.astro';
import Faktaruta from '../ui/Faktaruta.astro';
import Forfattarruta from '../ui/Forfattarruta.astro';
import Innehallsforteckning from '../ui/Innehallsforteckning.astro';
import Jamforelsetabell from '../ui/Jamforelsetabell.astro';
import Kopknapp from '../ui/Kopknapp.astro';
import Markering from '../ui/Markering.astro';
import Pennstreck from '../ui/Pennstreck.astro';
import Produktkort from '../ui/Produktkort.astro';
import StrukturData from '../ui/StrukturData.astro';
import Varning from '../ui/Varning.astro';
import Verktygskort from '../ui/Verktygskort.astro';

interface Props {
  entry: CollectionEntry<'kategorier'>;
}

const { entry } = Astro.props;
const d = entry.data;

const { Content, headings } = await render(entry);

const produkter = await produkterIKategori(entry.id);
const butik = await hamtaButik();

const tester = (await publicerade('tester')).filter((t) => t.data.kategori === entry.id);
const testPerProdukt = new Map(tester.map((t) => [t.data.produkt, t]));

const relaterade = [
  ...(await publicerade('guider')).filter((e) => e.data.kategori === entry.id),
  ...(await publicerade('kunskap')).filter((e) => e.data.kategori === entry.id),
].map((e) => ({ etikett: typEtikett(e.data.typ), namn: e.data.title, href: artikelUrl(e) }));

const jamforelser = (await publicerade('jamforelser'))
  .filter((e) => e.data.kategori === entry.id)
  .map((e) => ({ etikett: 'Jämförelse', namn: e.data.title, href: jamforelseUrl(e) }));

const allaRelaterade = [...relaterade, ...jamforelser];

const forfattare = await getEntry('forfattare', d.forfattare);
const forfattareNamn = forfattare?.data.namn ?? 'Redaktionen';

const valSlugs = d.val.map((v) => v.produkt);
const etiketter: Record<string, string> = Object.fromEntries(d.val.map((v) => [v.produkt, v.etikett]));

const rubriker = [
  { slug: slugify('Jämförelse'), text: 'Jämförelse' },
  ...produkter.map((p) => ({ slug: slugify(produktNamn(p)), text: produktNamn(p) })),
  ...headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text })),
];

const strukturdata = listaData({
  url: kategoriUrl(entry.id),
  namn: d.namn,
  poster: produkter.map((p) => {
    const t = testPerProdukt.get(p.slug);
    return {
      namn: produktNamn(p),
      url: t ? testUrl(t) : `${kategoriUrl(entry.id)}#${slugify(produktNamn(p))}`,
    };
  }),
});
---

<Bas
  title={`${d.title} · Hantverkstips`}
  description={d.description}
  reklam={true}
  butikNamn={butik?.namn}
  brodsmulor={[{ namn: 'Hantverkstips', href: '/' }, { namn: d.namn }]}
  brodsmulorIVy={true}
  bred={true}
>
  <StrukturData slot="head" data={strukturdata} />

  <div class="tvaspalt">
    <div class="min-w-0 lg:max-w-lasbredd">
      <Brodsmulor lista={[{ namn: 'Hantverkstips', href: '/' }, { namn: d.namn }]} />

      <h1 class="m-0 mt-6 font-serif text-h1 lg:text-h1-lg">{d.title}</h1>
      <p class="m-0 mt-4 text-ingress lg:text-ingress-lg">{d.ingress}</p>
      <p class="m-0 mt-3 text-liten text-blyerts-2">
        {
          d.uppdaterad && (
            <>
              Uppdaterad <time datetime={isoDatum(d.uppdaterad)}>{formateraDatum(d.uppdaterad)}</time> ·{' '}
            </>
          )
        }Av {forfattareNamn} · {produkter.length} produkter jämförda
      </p>
    </div>

    {
      d.val.length > 0 && produkter.length > 0 && (
        <section class="mt-8 -mx-4 sm:-mx-6 lg:mx-0 bg-papper-2 px-4 sm:px-6 lg:px-8 py-6">
          <Pennstreck id="vara-val" utanLuft={true}>
            Våra val
          </Pennstreck>
          {/* Korten är urklipp på papper-2-blocket och har därför papper som
              bakgrund, inte rekommenderad-varianten. */}
          <div class="grid gap-3 lg:grid-cols-3">
            {d.val.map((v) => (
              <Produktkort
                produkt={v.produkt}
                variant="kompakt"
                etikett={v.etikett}
                forVem={v.forVem}
                modul="varaval"
              />
            ))}
          </div>
        </section>
      )
    }

    <Innehallsforteckning rubriker={rubriker} variant="hopfallbar" />

    <section>
      <Pennstreck id={slugify('Jämförelse')}>Jämförelse</Pennstreck>
      <Jamforelsetabell
        produkter={produkter.map((p) => p.slug)}
        kategori={entry.id}
        rekommenderade={valSlugs}
        etiketter={etiketter}
      />
    </section>

    <div class="tvaspalt-rad">
      <div class="min-w-0">
      {
        produkter.map((p, i) => {
          const test = testPerProdukt.get(p.slug);
          const e = billigasteErbjudande(p);
          return (
            <section class:list={['pt-12 lg:pt-16', i > 0 && 'border-t border-linje']}>
              <Pennstreck id={slugify(produktNamn(p))} utanLuft={true}>
                {produktNamn(p)}
              </Pennstreck>
              {test && (
                <p class="m-0 mb-4 text-etikett lg:text-etikett-lg uppercase text-blyerts">
                  {typEtikett('test', test.data.etikett)}
                </p>
              )}
              <Produktkort
                produkt={p.slug}
                variant="full"
                rekommenderad={valSlugs.includes(p.slug)}
                etikett={etiketter[p.slug]}
                modul="kort_full"
              />
              {test ? (
                <>
                  <p class="mt-6 text-brod lg:text-brod-lg">{test.data.omdome}</p>
                  <Faktaruta variant="kopom" kopOm={test.data.kopOm} kopInteOm={test.data.kopInteOm} />
                  <p class="m-0">
                    <a
                      href={testUrl(test)}
                      class="inline-flex min-h-11 items-center text-penna underline decoration-1 underline-offset-2 hover:decoration-2"
                    >
                      Läs hela testet
                    </a>
                  </p>
                  <div class="mt-4">
                    <Kopknapp
                      produkt={p.slug}
                      modul="avslut"
                      pris={e?.pris ?? null}
                      prisDatum={e?.uppdaterad ?? null}
                      butikNamn={e?.butikNamn}
                      slut={arSlut(e)}
                    />
                  </div>
                </>
              ) : (
                <p class="mt-6 text-brod text-blyerts-2">Granskas. Vi har inte haft maskinen.</p>
              )}
            </section>
          );
        })
      }

      <div class="prosa mt-12">
        <Content components={{ h2: Pennstreck, Faktaruta, Varning, Markering }} />
      </div>

      {d.kalkylator && <Verktygskort kalkylator={d.kalkylator} />}

      {
        allaRelaterade.length > 0 && (
          <section>
            <Pennstreck id={slugify(`Fler guider och tester om ${d.namn}`)}>
              Fler guider och tester om {d.namn}
            </Pennstreck>
            <ul class="m-0 p-0 list-none">
              {allaRelaterade.map((r) => (
                <li class="border-t border-linje py-3">
                  <p class="m-0 text-etikett uppercase text-blyerts">{r.etikett}</p>
                  <a
                    href={r.href}
                    class="inline-flex min-h-11 items-center text-penna underline decoration-1 underline-offset-2 hover:decoration-2"
                  >
                    {r.namn}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

        <Forfattarruta forfattare={d.forfattare} uppdaterad={d.uppdaterad} />
      </div>

      <aside class="hidden lg:block">
        <div class="sticky top-20">
          <Innehallsforteckning rubriker={rubriker} variant="sidospalt" />
        </div>
      </aside>
    </div>
  </div>
</Bas>
