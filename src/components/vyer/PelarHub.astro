---
/**
 * Pelarhub, sedan 2026-09-17 ett galleri utan handskriven text. Rubrik och
 * ingress kommer från hubfilen, allt annat bygger mallen av artiklarnas
 * frontmatter i fyra fasta grupper: Hitta felet, Välj rätt, Gör det själv och
 * Räkna. Varje grupp har en generell rad som säger vad som listas, aldrig
 * specifik information om ett enskilt ämne; den hör hemma i artiklarna.
 *
 * Skälet (Christian 2026-09-17): hubben ska stödja hur vi fyller på framåt,
 * inte spegla de tre sidor som råkar finnas i dag. En grupp utan sidor visas
 * inte alls. Inga köpknappar, inget reklamband.
 */
import type { CollectionEntry } from 'astro:content';
import Bas from '../../layouts/Bas.astro';
import { delningsbild } from '../../lib/delningsbild';
import { pelareUrl, publicerade } from '../../lib/innehall';
import { KALKYLATORER } from '../../lib/kalkyl/register';
import { pelareForKategori } from '../../lib/kort';
import { hittaGrupp, hittaPelare, type PelareSlug } from '../../lib/pelare';
import { artikel as artikelData } from '../../lib/strukturdata';
import Ikon from '../ui/Ikon.astro';
import Kortgrupp from '../ui/Kortgrupp.astro';
import Pennstreck from '../ui/Pennstreck.astro';
import StrukturData from '../ui/StrukturData.astro';

interface Props {
  entry: CollectionEntry<'pelare'>;
}

const { entry } = Astro.props;
const d = entry.data;
const slug = entry.id as PelareSlug;
const pelare = hittaPelare(slug);
const kort = pelare?.kort ?? d.title;
const grupp = pelare ? hittaGrupp(pelare.grupp) : undefined;

// Kortgrupp läser pelaren härifrån.
Astro.locals.pelare = slug;

/**
 * Grupperna och deras generella rader. Raden får nämna ämnet (kort) men aldrig
 * en enskild sida, en produkt eller ett tal.
 */
const artiklar = [...(await publicerade('guider')), ...(await publicerade('kunskap'))].filter(
  (e) => e.data.pelare === slug,
);
const kategorier = (await publicerade('kategorier')).filter((k) =>
  (k.data.pelare as readonly string[]).includes(slug),
);
const jamforelser = (
  await Promise.all(
    (await publicerade('jamforelser')).map(async (e) => ({ e, p: await pelareForKategori(e.data.kategori) })),
  )
).filter((j) => j.p === slug);
// Samma tvåledade filter som Kortgrupp.astro: pelarleden först, sedan kategorileden.
// Rättat 2026-09-20; tidigare räknades bara kategorileden, så Räkna-gruppen doldes
// på varje pelare utan kategorisida trots att kalkylatorer hörde dit.
const kalkylatorer = KALKYLATORER.filter(
  (k) => k.pelare?.includes(slug) || (k.kategori !== undefined && kategorier.some((x) => x.id === k.kategori)),
);

const antal = {
  'hitta-felet': artiklar.filter((e) => e.data.typ === 'problemguide' || e.data.typ === 'kunskap').length,
  'valj-ratt': artiklar.filter((e) => e.data.typ === 'kopguide').length + kategorier.length + jamforelser.length,
  'gor-det-sjalv': artiklar.filter((e) => e.data.typ === 'projektguide').length,
  rakna: kalkylatorer.length,
} as const;

const GRUPPER = [
  {
    id: 'hitta-felet',
    rubrik: 'Hitta felet',
    rad: `Här listar vi guiderna som hjälper dig hitta orsaken innan du lagar eller köper något inom ${(pelare?.namn ?? kort).toLowerCase()}.`,
  },
  {
    id: 'valj-ratt',
    rubrik: 'Välj rätt',
    rad: 'Här samlar vi köpguider, jämförelser och bäst i test, alltid med nackdelarna utskrivna.',
  },
  {
    id: 'gor-det-sjalv',
    rubrik: 'Gör det själv',
    rad: 'Här ligger projektguiderna, steg för steg, med måtten du behöver innan du börjar.',
  },
  {
    id: 'rakna',
    rubrik: 'Räkna',
    rad: 'Här finns kalkylatorerna som gör räkningen åt dig, med antagandena utskrivna.',
  },
] as const;

const synliga = GRUPPER.filter((g) => antal[g.id] > 0);
const totalt = artiklar.length + jamforelser.length;

/**
 * Delningsbilden i 1200 × 630 (scripts/generera-delningsbilder.mjs). Hubben har
 * ingen egen bild, så den får titeln i större grad och tumstocken till höger.
 * Samma fil går ut som og:image och som image i Article.
 */
const ogBild = delningsbild('pelare', entry.id);

const strukturdata = artikelData({
  url: pelareUrl(slug),
  titel: d.title,
  beskrivning: d.description,
  uppdaterad: d.uppdaterad,
  forfattareSlug: 'redaktionen',
  forfattareNamn: 'Redaktionen',
  bildUrl: ogBild,
});
---

<Bas
  title={d.seoTitle ?? d.title}
  description={d.description}
  brodsmulor={[{ namn: 'Hantverkstips', href: '/' }, { namn: kort }]}
  bred={true}
  ogBild={ogBild}
>
  <StrukturData slot="head" data={strukturdata} />

  <div class="max-w-lasbredd">
    {grupp && <p class="m-0 text-etikett lg:text-etikett-lg uppercase text-blyerts-2">{grupp.namn}</p>}
    <div class="mt-2 flex items-start gap-3">
      {pelare && <Ikon namn={pelare.ikon} storlek={32} class="mt-1 text-blyerts" />}
      <h1 class="m-0 font-serif text-h1 lg:text-h1-lg">{d.title}</h1>
    </div>
    <p class="m-0 mt-4 text-ingress lg:text-ingress-lg text-blyerts-2">{d.ingress}</p>
    {
      totalt > 0 && (
        <p class="m-0 mt-3 text-liten text-blyerts-2">
          {totalt === 1 ? '1 sida' : `${totalt} sidor`} ·{' '}
          <a href={`/guider/${slug}/`} class="text-penna underline decoration-1 underline-offset-2 hover:decoration-2">
            Alla guider om {(pelare?.namn ?? kort).toLowerCase()}
          </a>
        </p>
      )
    }
  </div>

  {
    synliga.length === 0 && (
      <p class="mt-8 max-w-lasbredd text-brod lg:text-brod-lg text-blyerts-2">
        Här finns inga guider än. De första kommer inom kort, och tills dess hittar du allt vi publicerat under{' '}
        <a href="/guider/" class="text-penna underline decoration-1 underline-offset-2 hover:decoration-2">
          alla guider och tester
        </a>
        .
      </p>
    )
  }

  {
    synliga.map((g) => (
      <section class="mt-10 lg:mt-14">
        <div class="max-w-lasbredd">
          <Pennstreck id={g.id}>{g.rubrik}</Pennstreck>
          <p class="m-0 text-brod lg:text-brod-lg text-blyerts-2">{g.rad}</p>
        </div>
        <Kortgrupp grupp={g.id} />
      </section>
    ))
  }
</Bas>
