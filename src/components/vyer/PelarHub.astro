---
/**
 * Pelarhub. Diagnosstart och länknav: chefredaktörens text är kartans
 * förklaring, korten är kartan. Inga köpknappar, inget reklamband.
 *
 * Grupperna kommer från innehållsfilen, som skriver sin mening under varje H2
 * och sedan <Kortgrupp grupp="hitta-felet" />. Komponenten läser pelaren från
 * Astro.locals.pelare, som rutten sätter och som vyn sätter igen här för att
 * hubben ska fungera även om den renderas från en annan rutt.
 *
 * Listan "Alla sidor i ..." ligger kvar sist som säkerheten mot föräldralösa
 * sidor, i tre spalter grupperade på nivå. Det är hubbens filter utan
 * JavaScript: tre listor i HTML, inget dragspel, inga flikar.
 */
import { render, type CollectionEntry } from 'astro:content';
import Bas from '../../layouts/Bas.astro';
import { artikelUrl, pelareUrl, publicerade, typEtikett } from '../../lib/innehall';
import { NIVAER, nivaEtikett } from '../../lib/niva';
import { hittaPelare, type PelareSlug } from '../../lib/pelare';
import { artikel as artikelData } from '../../lib/strukturdata';
import Faktaruta from '../ui/Faktaruta.astro';
import Ikon from '../ui/Ikon.astro';
import Illustration from '../ui/Illustration.astro';
import Kortgrupp from '../ui/Kortgrupp.astro';
import Markering from '../ui/Markering.astro';
import Pennstreck from '../ui/Pennstreck.astro';
import StrukturData from '../ui/StrukturData.astro';
import Varning from '../ui/Varning.astro';
import Verktygskort from '../ui/Verktygskort.astro';

interface Props {
  entry: CollectionEntry<'pelare'>;
}

const { entry } = Astro.props;
const d = entry.data;
const pelare = hittaPelare(entry.id);
const kort = pelare?.kort ?? d.title;

// Kortgrupp står i innehållsfilen och kan inte få pelaren som prop därifrån.
Astro.locals.pelare = entry.id as PelareSlug;

const { Content } = await render(entry);

const sidor = [...(await publicerade('guider')), ...(await publicerade('kunskap'))]
  .filter((e) => e.data.pelare === entry.id)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'sv'));

const grupper = NIVAER.map((niva) => ({
  niva,
  etikett: nivaEtikett(niva),
  sidor: sidor.filter((s) => s.data.niva === niva),
})).filter((g) => g.sidor.length > 0);

// Huben har inget publiceringsdatum i frontmatter. Byggtidpunkten får inte bli
// datum, den ändras vid varje bygge, så fältet utelämnas hellre.
const strukturdata = artikelData({
  url: pelareUrl(entry.id),
  titel: d.title,
  beskrivning: d.description,
  uppdaterad: d.uppdaterad,
  forfattareSlug: 'redaktionen',
  forfattareNamn: 'Redaktionen',
});
---

<Bas
  title={d.seoTitle ?? d.title}
  description={d.description}
  brodsmulor={[{ namn: 'Hantverkstips', href: '/' }, { namn: kort }]}
  bred={true}
>
  <StrukturData slot="head" data={strukturdata} />

  {/* Rubrikblocket och den handskrivna inledningen hålls i läsbredd, rutnäten
      går ut i sidbredd. */}
  <div class="max-w-lasbredd">
    <div class="flex items-start gap-3">
      {pelare && <Ikon namn={pelare.ikon} storlek={32} class="mt-1 text-blyerts" />}
      <h1 class="m-0 font-serif text-h1 lg:text-h1-lg">{d.title}</h1>
    </div>
    <p class="m-0 mt-4 text-ingress lg:text-ingress-lg text-blyerts-2">{d.ingress}</p>
  </div>

  {/* Brödtexten är läsbredd, men Kortgrupp bryter ut till sidbredd själv genom
      att stå i en behållare utan maxbredd. Därför sätts maxbredden på styckena
      i .prosa i stället för på hela blocket. */}
  <div class="prosa hub-prosa mt-8">
    <Content
      components={{ h2: Pennstreck, Faktaruta, Varning, Verktygskort, Markering, Illustration, Kortgrupp }}
    />
  </div>

  {
    grupper.length > 0 && (
      <section>
        <div class="flex flex-wrap items-baseline justify-between gap-x-6">
          <Pennstreck id="alla-sidor">Alla sidor i {kort}</Pennstreck>
          <a
            href={`/guider/${entry.id}/`}
            class="huvudmeny inline-flex min-h-11 items-center text-penna underline decoration-1 underline-offset-2 hover:decoration-2"
          >
            Alla guider i {kort}
          </a>
        </div>
        <div class="grid grid-cols-1 gap-x-12 lg:grid-cols-3">
          {grupper.map((g) => (
            <div>
              <Pennstreck niva={3} id={`niva-${g.niva}`}>
                {g.etikett}
              </Pennstreck>
              <ul class="m-0 list-none p-0">
                {g.sidor.map((s) => (
                  <li class="border-t border-linje py-2">
                    <p class="m-0 text-etikett uppercase text-blyerts">
                      {typEtikett(s.data.typ)} · {g.etikett}
                    </p>
                    <a
                      href={artikelUrl(s)}
                      class="inline-flex min-h-11 items-center text-penna underline decoration-1 underline-offset-2 hover:decoration-2"
                    >
                      {s.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )
  }
</Bas>

<style>
  /* Chefredaktörens text är en läsyta, korten är en karta. Texten hålls därför
     till 44 rem även när sidan är i sidbredd, medan rutnäten fyller bredden. */
  .hub-prosa :global(> p),
  .hub-prosa :global(> ul),
  .hub-prosa :global(> ol),
  .hub-prosa :global(> h2),
  .hub-prosa :global(> h3),
  .hub-prosa :global(> blockquote) {
    max-width: var(--container-lasbredd);
  }
  /* Kortgruppernas rutnät är en <ul> men ingen lista i löptext: den fyller
     sidbredden. */
  .hub-prosa :global(> ul.kortrutnat) {
    max-width: none;
  }
</style>
