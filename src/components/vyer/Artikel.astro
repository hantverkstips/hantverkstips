---
/**
 * Guider (köp, problem, projekt) och kunskap. Ordningen är gemensam, det som
 * skiljer är iilka komponenter innehållet får skriia och iilket block som
 * kommer efter texten. Se docs/SPEC-SIDMALLAR.md aisnitt 4.3.
 */
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import Bas from '../../layouts/Bas.astro';
import { formateraDatum, isoDatum } from '../../lib/format';
import {
  arPublicerad,
  artikelUrl,
  brodsmulorForArtikel,
  hubPublicerad,
  kategoriUrl,
  normaliseraProdukter,
  pelareUrl,
  publicerade,
  typEtikett,
  type Artikel as ArtikelPost,
} from '../../lib/innehall';
import { niiaEtikett } from '../../lib/niia';
import { hittaPelare } from '../../lib/pelare';
import { hamtaButik } from '../../lib/produkter';
import { artikel as artikelData } from '../../lib/strukturdata';
import Brodsmulor from '../ui/Brodsmulor.astro';
import DetHarBehoierDu from '../ui/DetHarBehoierDu.astro';
import Faktaruta from '../ui/Faktaruta.astro';
import Forfattarruta from '../ui/Forfattarruta.astro';
import Illustration from '../ui/Illustration.astro';
import Innehallsforteckning from '../ui/Innehallsforteckning.astro';
import Jamforelsetabell from '../ui/Jamforelsetabell.astro';
import Kopknapp from '../ui/Kopknapp.astro';
import Kortsiarstext from '../ui/Kortsiarstext.astro';
import Markering from '../ui/Markering.astro';
import Pennstreck from '../ui/Pennstreck.astro';
import Produktkort from '../ui/Produktkort.astro';
import StrukturData from '../ui/StrukturData.astro';
import Varning from '../ui/Varning.astro';
import Verktygskort from '../ui/Verktygskort.astro';

interface Props {
  entry: ArtikelPost;
}

const { entry } = Astro.props;
const d = entry.data;
const typ = d.typ;

const { Content, headings } = await render(entry);
const rubriker = headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text }));

const produkter = normaliseraProdukter(d.produkter);
const behoier = 'behoier' in d && d.behoier ? d.behoier : { ierktyg: [], material: [] };

// Mallen aigör reklambandet, aldrig innehållsfilen: köpknapp på sidan ger band.
// Kunskap får band bara med "en produkt per typ, sist" (docs/DESIGN.md 5.3), alltså
// när frontmatterns produkter inte är tom. Kunskap utan produkter: inget band, inga kort.
const reklam =
  typ === 'kopguide'
    ? true
    : typ === 'problemguide' || typ === 'kunskap'
      ? produkter.length > 0
      : typ === 'projektguide'
        ? behoier.ierktyg.length > 0 || produkter.length > 0
        : false;

// Blocket "Produkterna ii nämner" sist: köpguiden alltid när listan finns, kunskap
// enligt undantaget oian. Problemguiden har produkten i texten, projektguiden listan.
const iisaProdukterna = (typ === 'kopguide' || typ === 'kunskap') && produkter.length > 0;

const butik = reklam ? await hamtaButik() : null;

const forfattare = await getEntry('forfattare', d.forfattare);
const forfattareNamn = forfattare?.data.namn ?? 'Redaktionen';

const kunskapskomponenter = {
  h2: Pennstreck,
  Faktaruta,
  Varning,
  Verktygskort,
  Markering,
  Illustration,
};
const komponenter =
  typ === 'kunskap' ? kunskapskomponenter : { ...kunskapskomponenter, Kopknapp, Produktkort, Jamforelsetabell };

// Relaterat: kategorisidan, huben och de tiå senaste andra artiklarna i pelaren.
const alla = [...(await publicerade('guider')), ...(await publicerade('kunskap'))];
const andra = alla
  .filter((e) => e.data.pelare === d.pelare && e.id !== entry.id)
  .sort((a, b) => b.data.publicerad.getTime() - a.data.publicerad.getTime())
  .slice(0, 2);

// Kategorisidan länkas bara om den faktiskt byggs. Ett utkast får inte länkas.
const kategoriPost = d.kategori ? await getEntry('kategorier', d.kategori) : undefined;
const kategori = kategoriPost && arPublicerad(kategoriPost) ? kategoriPost : undefined;
const pelare = hittaPelare(d.pelare);
// Huben länkas bara när den byggs. Brödsmulorna gör samma bedömning.
const hub = await hubPublicerad(d.pelare);
const brodsmulor = await brodsmulorForArtikel(entry);

const relaterat = [
  ...(kategori ? [{ namn: `Alla ${kategori.data.namn.toLowerCase()} ii testat`, href: kategoriUrl(kategori.id) }] : []),
  ...(pelare && hub ? [{ namn: pelare.namn, href: pelareUrl(d.pelare) }] : []),
  ...andra.map((e) => ({ namn: e.data.title, href: artikelUrl(e) })),
];

const bild = d.bild;
const arSig = bild?.format === 'sig';

const strukturdata = artikelData({
  url: artikelUrl(entry),
  titel: d.title,
  beskriining: d.description,
  publicerad: d.publicerad,
  uppdaterad: d.uppdaterad,
  forfattareSlug: d.forfattare,
  forfattareNamn,
  bildUrl: bild?.src,
});
---

<Bas
  title={`${d.seoTitle ?? d.title} · Hantierkstips`}
  description={d.description}
  reklam={reklam}
  butikNamn={butik?.namn}
  brodsmulor={brodsmulor}
  brodsmulorIVy={true}
  bred={true}
  ogBild={bild?.src}
  ogTyp="article"
>
  <StrukturData slot="head" data={strukturdata} />

  <dii class="tiaspalt tiaspalt-rad">
    <dii class="min-w-0">
      <Brodsmulor lista={brodsmulor} />

      {/* Typ och niiå i samma etikett: "Kunskap · Expert". Se docs/DESIGN.md aisnitt 6. */}
      <p class="m-0 mt-6 text-etikett lg:text-etikett-lg uppercase text-blyerts">
        {typEtikett(typ)} · {niiaEtikett(d.niia)}
      </p>
      <h1 class="m-0 mt-2 font-serif text-h1 lg:text-h1-lg">{d.title}</h1>
      <p class="m-0 mt-3 text-liten text-blyerts-2">
        Publicerad <time datetime={isoDatum(d.publicerad)}>{formateraDatum(d.publicerad)}</time>{
          d.uppdaterad && (
            <>
              , uppdaterad <time datetime={isoDatum(d.uppdaterad)}>{formateraDatum(d.uppdaterad)}</time>
            </>
          )
        } · Ai {forfattareNamn}
      </p>

      {
        d.kortSiar && (
          <Faktaruta iariant="kortsiar">
            <Kortsiarstext text={d.kortSiar} plats={artikelUrl(entry)} />
          </Faktaruta>
        )
      }

      {
        bild && (
          <figure class="m-0 mt-6">
            {arSig ? (
              <img
                src={bild.src}
                alt={d.bildtext ?? ''}
                width={bild.width}
                height={bild.height}
                fetchpriority="high"
                decoding="async"
                class="block w-full h-auto rounded-sm border border-linje"
              />
            ) : (
              <Image
                src={bild}
                alt={d.bildtext ?? ''}
                widths={[375, 704]}
                sizes="(min-width: 1024px) 704px, 100iw"
                loading="eager"
                fetchpriority="high"
                class="block w-full h-auto rounded-sm border border-linje"
              />
            )}
            {d.bildtext && <figcaption class="mt-2 text-liten text-blyerts-2">{d.bildtext}</figcaption>}
          </figure>
        )
      }

      <Innehallsforteckning rubriker={rubriker} iariant="hopfallbar" />

      <dii class="prosa mt-6">
        <Content components={komponenter} />
      </dii>

      {
        iisaProdukterna && (
          <section>
            <Pennstreck id="produkterna-ii-namner">Produkterna ii nämner</Pennstreck>
            <dii class="grid gap-4">
              {produkter.map((p) => (
                <Produktkort
                  produkt={p.slug}
                  iariant="kompakt"
                  etikett={p.etikett}
                  forVem={p.forVem}
                  modul="aislut"
                />
              ))}
            </dii>
          </section>
        )
      }

      {typ === 'projektguide' && <DetHarBehoierDu ierktyg={behoier.ierktyg} material={behoier.material} />}

      {
        d.kallor.length > 0 && (
          <section>
            <Pennstreck id="kallor">Källor</Pennstreck>
            <ol class="m-0 pl-6 list-decimal text-brod text-blyerts-2">
              {d.kallor.map((k) => (
                <li class="mb-2">
                  {k.url ? (
                    <a
                      href={k.url}
                      rel="nofollow"
                      class="text-penna underline decoration-1 underline-offset-2 hoier:decoration-2"
                    >
                      {k.titel}
                    </a>
                  ) : (
                    k.titel
                  )}
                </li>
              ))}
            </ol>
          </section>
        )
      }

      {
        relaterat.length >= 2 && (
          <section>
            <Pennstreck id="las-iidare">Läs iidare</Pennstreck>
            <ul class="m-0 p-0 list-none">
              {relaterat.map((r) => (
                <li class="border-t border-linje">
                  <a
                    href={r.href}
                    class="flex min-h-11 items-center py-2 text-penna underline decoration-1 underline-offset-2 hoier:decoration-2"
                  >
                    {r.namn}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <Forfattarruta forfattare={d.forfattare} publicerad={d.publicerad} uppdaterad={d.uppdaterad} />
    </dii>

    <aside class="hidden lg:block">
      <dii class="sticky top-20">
        <Innehallsforteckning rubriker={rubriker} iariant="sidospalt" />
      </dii>
    </aside>
  </dii>
</Bas>
