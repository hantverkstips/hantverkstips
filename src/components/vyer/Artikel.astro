---
/**
 * Guider (köp, problem, projekt) och kunskap. Ordningen är gemensam, det som
 * skiljer är vilka komponenter innehållet får skriva och vilket block som
 * kommer efter texten. Se docs/SPEC-SIDMALLAR.md avsnitt 4.3, docs/DESIGN.md
 * 5.3 och docs/briefer/spec-designlyft-b-2026-10-02.md avsnitt 4.
 */
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import Bas from '../../layouts/Bas.astro';
import { delningsbild } from '../../lib/delningsbild';
import {
  arPublicerad,
  artikelUrl,
  brodsmulorForArtikel,
  lasminuter,
  normaliseraProdukter,
  publicerade,
  typEtikett,
  type Artikel as ArtikelPost,
} from '../../lib/innehall';
import { tillKortArtikel, tillKortKategori, type KortData } from '../../lib/kort';
import { nivaEtikett } from '../../lib/niva';
import { hittaPelare } from '../../lib/pelare';
import { hamtaButik, hamtaProdukt, produktNamn } from '../../lib/produkter';
import { artikel as artikelData } from '../../lib/strukturdata';
import Artikelrutnat from '../ui/Artikelrutnat.astro';
import Brodsmulor from '../ui/Brodsmulor.astro';
import Byline from '../ui/Byline.astro';
import DetHarBehoverDu from '../ui/DetHarBehoverDu.astro';
import Faktaruta from '../ui/Faktaruta.astro';
import Faq from '../ui/Faq.astro';
import Illustration from '../ui/Illustration.astro';
import Innehallsforteckning from '../ui/Innehallsforteckning.astro';
import Jamforelsetabell from '../ui/Jamforelsetabell.astro';
import Kalkylator from '../ui/Kalkylator.astro';
import Kallor from '../ui/Kallor.astro';
import Kopknapp from '../ui/Kopknapp.astro';
import Kortsvarstext from '../ui/Kortsvarstext.astro';
import Markering from '../ui/Markering.astro';
import Pennstreck from '../ui/Pennstreck.astro';
import Produktkort from '../ui/Produktkort.astro';
import Rubrikrad from '../ui/Rubrikrad.astro';
import Sidospalt from '../ui/Sidospalt.astro';
import StrukturData from '../ui/StrukturData.astro';
import Varning from '../ui/Varning.astro';
import Verktygskort from '../ui/Verktygskort.astro';

interface Props {
  entry: ArtikelPost;
}

const { entry } = Astro.props;
const d = entry.data;
const typ = d.typ;

const { Content, headings } = await render(entry);
const rubriker = headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text }));

const produkter = normaliseraProdukter(d.produkter);
const behover = 'behover' in d && d.behover ? d.behover : { verktyg: [], material: [] };

// Mallen avgör reklambandet, aldrig innehållsfilen: köpknapp på sidan ger band.
// Kunskap får band bara med "en produkt per typ, sist" (docs/DESIGN.md 5.3), alltså
// när frontmatterns produkter inte är tom. Kunskap utan produkter: inget band, inga kort.
// Projektguiden: DetHarBehoverDu ger knapp bara på verktygsrader med produkt, så en
// lista med enbart textrader ger noll annonslänkar och därmed inget band
// (granskningen 2026-09-16 punkt 5.1).
const reklam =
  typ === 'kopguide'
    ? true
    : typ === 'problemguide' || typ === 'kunskap'
      ? produkter.length > 0
      : typ === 'projektguide'
        ? behover.verktyg.some((v) => v.produkt) || produkter.length > 0
        : false;

// Blocket "Produkterna jag nämner" sist: köpguiden alltid när listan finns, kunskap
// enligt undantaget ovan. Problemguiden har produkten i texten, projektguiden listan.
const visaProdukterna = (typ === 'kopguide' || typ === 'kunskap') && produkter.length > 0;

const butik = reklam ? await hamtaButik() : null;

const forfattare = await getEntry('forfattare', d.forfattare);
const forfattareNamn = forfattare?.data.namn ?? 'Christian';

const kunskapskomponenter = {
  h2: Pennstreck,
  Faktaruta,
  Varning,
  Verktygskort,
  Kalkylator,
  Markering,
  Illustration,
  Faq,
};
const komponenter =
  typ === 'kunskap' ? kunskapskomponenter : { ...kunskapskomponenter, Kopknapp, Produktkort, Jamforelsetabell };

// Kategorisidan länkas bara om den faktiskt byggs. Ett utkast får inte länkas.
const kategoriPost = d.kategori ? await getEntry('kategorier', d.kategori) : undefined;
const kategori = kategoriPost && arPublicerad(kategoriPost) ? kategoriPost : undefined;
const pelare = hittaPelare(d.pelare);
const brodsmulor = await brodsmulorForArtikel(entry);

/**
 * Köpguidens val som chips i Kort svar: etiketten och produktens namn. Poster
 * utan produkt i databasen hoppas över. Sidospaltens produktlista bor i
 * Sidospalt.astro.
 */
const val =
  typ === 'kopguide'
    ? (
        await Promise.all(
          produkter.map(async (p) => {
            if (!p.etikett) return [];
            const produkt = await hamtaProdukt(p.slug);
            return produkt ? [{ etikett: p.etikett, namn: produktNamn(produkt) }] : [];
          }),
        )
      ).flat()
    : [];

/**
 * Verktygskortet i spalten: kategorins räknare, när den inte redan står
 * inbäddad eller som kort i brödtexten. En sida har aldrig två.
 */
const kropp = entry.body ?? '';
const raknare = kategori?.data.kalkylator;
const visaRaknare =
  raknare !== undefined &&
  !kropp.includes(`<Kalkylator namn="${raknare}"`) &&
  !kropp.includes(`<Verktygskort kalkylator="${raknare}"`);

// Läs vidare: kategorisidan om den byggs, sedan de senaste andra artiklarna i
// pelaren, tre totalt. Etiketten är bara typen.
const andra = [...(await publicerade('guider')), ...(await publicerade('kunskap'))]
  .filter((e) => e.data.pelare === d.pelare && e.id !== entry.id)
  .sort((a, b) => b.data.publicerad.getTime() - a.data.publicerad.getTime())
  .slice(0, kategori ? 2 : 3);
const utanNiva = ({ niva: _niva, ...k }: KortData): KortData => k;
const lasVidare: KortData[] = [
  ...(kategori ? [utanNiva(await tillKortKategori(kategori))] : []),
  ...andra.map((e) => utanNiva(tillKortArtikel(e))),
];
const visaLasVidare = lasVidare.length >= 2;

const bild = d.bild;
const arSvg = bild?.format === 'svg';

/**
 * Delning och Article-bild är samma PNG i 1200 × 630, ritad av
 * scripts/generera-delningsbilder.mjs ur titeln och sidans illustration.
 * Frontmatterns `bild` duger till ingetdera: den är en SVG, och Vite inlinear
 * den dessutom gärna som data-URI. Saknas PNG:en utelämnas image, och Bas
 * faller tillbaka på sajtens standardbild.
 */
const ogBild = delningsbild(entry.collection, entry.id);

const strukturdata = artikelData({
  url: artikelUrl(entry),
  titel: d.title,
  beskrivning: d.description,
  publicerad: d.publicerad,
  uppdaterad: d.uppdaterad,
  forfattareSlug: d.forfattare,
  forfattareNamn,
  bildUrl: ogBild,
});
---

<Bas
  title={d.seoTitle ?? d.title}
  description={d.description}
  reklam={reklam}
  butikNamn={butik?.namn}
  brodsmulor={brodsmulor}
  brodsmulorIVy={true}
  galleri={true}
  ogBild={ogBild}
  ogTyp="article"
>
  <StrukturData slot="head" data={strukturdata} />

  <div class:list={['sidram pt-8', !visaLasVidare && 'pb-16 lg:pb-24']}>
    <div class="tvaspalt">
      <Brodsmulor lista={brodsmulor} />

      {/* Typ, nivå och pelare i samma etikett: "Köpguide · Mellan · Fukt". docs/DESIGN.md 5.3. */}
      <p class="etikett mt-6 text-penna">
        {typEtikett(typ)} · {nivaEtikett(d.niva)}{pelare && ` · ${pelare.kort}`}
      </p>
      <h1 class="m-0 mt-3.5 max-w-3xl font-serif text-h1 lg:text-h1-lg">{d.title}</h1>
      <div class="mt-3.5">
        <Byline
          forfattare={d.forfattare}
          publicerad={d.publicerad}
          uppdaterad={d.uppdaterad}
          minuter={lasminuter(kropp)}
        />
      </div>

      <div class="tvaspalt-rad mt-7">
        <div class="min-w-0">
          {
            (bild || d.kortSvar) && (
              <div class="flex flex-col gap-7">
                {bild && (
                  <figure class="kort m-0 overflow-hidden order-2 lg:order-1">
                    <div class="pappersruta p-5">
                      {arSvg ? (
                        <img
                          src={bild.src}
                          alt={d.bildAlt ?? d.bildtext ?? ''}
                          width={bild.width}
                          height={bild.height}
                          fetchpriority="high"
                          decoding="async"
                        />
                      ) : (
                        <Image
                          src={bild}
                          alt={d.bildAlt ?? d.bildtext ?? ''}
                          widths={[375, 704]}
                          sizes="(min-width: 1024px) 704px, 100vw"
                          loading="eager"
                          fetchpriority="high"
                        />
                      )}
                    </div>
                    {d.bildtext && <figcaption class="px-4.5 py-3 text-liten text-blyerts-2">{d.bildtext}</figcaption>}
                  </figure>
                )}
                {d.kortSvar && (
                  <div class="order-1 lg:order-2">
                    <Kortsvarstext text={d.kortSvar} plats={artikelUrl(entry)} val={val} />
                  </div>
                )}
              </div>
            )
          }

          <Innehallsforteckning rubriker={rubriker} variant="hopfallbar" />

          <div class="prosa mt-7">
            <Content components={komponenter} />
          </div>

          {
            visaProdukterna && (
              <section>
                <Pennstreck id="produkterna-jag-namner">Produkterna jag nämner</Pennstreck>
                <div class="grid gap-4">
                  {produkter.map((p) => (
                    <Produktkort
                      produkt={p.slug}
                      etikett={p.etikett}
                      forVem={p.forVem}
                      svaghet={p.svaghet}
                      modul="avslut"
                    />
                  ))}
                </div>
              </section>
            )
          }

          {typ === 'projektguide' && <DetHarBehoverDu verktyg={behover.verktyg} material={behover.material} />}

          <Kallor kallor={d.kallor} />
        </div>

        <Sidospalt
          rubriker={rubriker}
          produkter={produkter.map((p) => ({ slug: p.slug, etikett: p.etikett, forVem: p.forVem, ankare: visaProdukterna }))}
          kalkylator={visaRaknare ? raknare : undefined}
        />
      </div>
    </div>
  </div>

  {
    visaLasVidare && (
      <section class="band mt-14">
        <div class="sidram py-12 lg:py-14">
          <Rubrikrad id="las-vidare" rubrik="Läs vidare" />
          <Artikelrutnat kort={lasVidare} visaBeskrivning={false} visaMeta={false} />
        </div>
      </section>
    )
  }
</Bas>
